    "svSE": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">HORDENS &amp; ALLIANSENS MILITÄRA GRADER</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka!  I den här</P>\n<P align=\"right\">boken hittar du</P>\n<P align=\"right\">många förteckningar över</P>\n<P align=\"right\">de militära graderna</P>\n<P align=\"right\">i Horden och</P>\n<P align=\"right\">den ynkliga Alliansen.</P>\n<P align=\"right\">Först kommer</P>\n<P align=\"right\">Horden, sedan Alliansen,</P>\n<P align=\"right\">vardera med förteckningar över officers- och manskapsgrader.  Som sig bör står de starkaste överst och de svagare under dem.</P>\n</BODY>\n</HTML>",
