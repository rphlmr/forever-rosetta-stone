    },
    "plPL": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">RANGI WOJSKOWE HORDY &amp; PRZYMIERZA</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka! W tej</P>\n<P align=\"right\">książce znajdziesz</P>\n<P align=\"right\">wiele wykazów</P>\n<P align=\"right\">rang wojskowych</P>\n<P align=\"right\">Hordy i</P>\n<P align=\"right\">mizernego Przymierza.</P>\n<P align=\"right\">Najpierw przyjdzie</P>\n<P align=\"right\">Horda, potem Przymierze,</P>\n<P align=\"right\">każde z wykazami oficerów i rang szeregowych. Jak przystało, najsilniejsi są wymienieni na górze, a słabsi poniżej nich.</P>\n</BODY>\n</HTML>",
