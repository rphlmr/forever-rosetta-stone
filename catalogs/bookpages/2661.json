    "daDK": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">HORDENS &amp; ALLIANCENS MILITÆRE RANGER</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka!  I denne</P>\n<P align=\"right\">bog finder du</P>\n<P align=\"right\">mange oversigter over</P>\n<P align=\"right\">de militære ranger</P>\n<P align=\"right\">i Horden og</P>\n<P align=\"right\">den sølle Alliance.</P>\n<P align=\"right\">Først kommer</P>\n<P align=\"right\">Horden, så Alliancen,</P>\n<P align=\"right\">begge med oversigter over officers- og menige grader.  Som det sig hør og bør, står de stærkeste øverst og de svagere under dem.</P>\n</BODY>\n</HTML>",
