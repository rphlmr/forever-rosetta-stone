    "csCZ": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">VOJENSKÉ HODNOSTI HORDY &amp; ALIANCE</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka! V této</P>\n<P align=\"right\">knize najdeš</P>\n<P align=\"right\">podrobný přehled</P>\n<P align=\"right\">vojenských hodností</P>\n<P align=\"right\">Hordy i té</P>\n<P align=\"right\">ubohaté Aliance.</P>\n<P align=\"right\">Nejprve přijde na řadu</P>\n<P align=\"right\">Horda, poté Aliance,</P>\n<P align=\"right\">obě se seznamy důstojníků a mužstva. Jak se sluší a patří, ti nejsilnější jsou uvedeni nahoře a ti slabší pod nimi.</P>\n</BODY>\n</HTML>",
