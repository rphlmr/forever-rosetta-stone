            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">GRADI MILITARI DELL'ORDA &amp; DELL'ALLEANZA</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka!  In questo</P>\n<P align=\"right\">libro troverai</P>\n<P align=\"right\">numerosi elenchi dei</P>\n<P align=\"right\">gradi militari</P>\n<P align=\"right\">dell'Orda e</P>\n<P align=\"right\">della gracile Alleanza.</P>\n<P align=\"right\">Prima verrà</P>\n<P align=\"right\">l'Orda, poi l'Alleanza,</P>\n<P align=\"right\">ciascuna con gli elenchi dei gradi degli ufficiali e della truppa.  Come si conviene, i più forti sono elencati in cima, con i più deboli sotto di loro.</P>\n</BODY>\n</HTML>",
      "translationMetadata": {
        "fields": {
