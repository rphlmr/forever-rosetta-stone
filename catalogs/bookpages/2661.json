    "zhCN": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">军衔概述</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\"> Loktar Ogar!</P>\n<P align=\"right\">本书中列出了</P>\n<P align=\"right\">部落的军衔，</P>\n<P align=\"right\">以及弱小的联盟。</P><BR/>\n<P align=\"right\">首先是部落的，</P>\n<P align=\"right\">然后是联盟的。</P>\n<P align=\"right\">囊括军官和军阶列表，</P>\n<P align=\"right\">按等级高低排列。</P>\n<P align=\"right\">等级最高的排在首位，</P>\n<P align=\"right\">等级低的列于下位。</P>\n</BODY>\n</HTML>",
