    "esMX": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">RANGOS MILITARES DE LA HORDA &amp; LA ALIANZA</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">¡Throm'ka!  En este</P>\n<P align=\"right\">libro encontrarás</P>\n<P align=\"right\">numerosas listas de</P>\n<P align=\"right\">los rangos militares</P>\n<P align=\"right\">de la Horda y de</P>\n<P align=\"right\">la enclenque Alianza.</P>\n<P align=\"right\">Primero aparecerá la</P>\n<P align=\"right\">Horda, luego la Alianza,</P>\n<P align=\"right\">cada una con listas de rangos de oficiales y de tropa.  Como corresponde, los más fuertes figuran arriba y los más débiles debajo de ellos.</P>\n</BODY>\n</HTML>",
