    "ptBR": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">PATENTES MILITARES DA HORDA &amp; DA ALIANÇA</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka!  Neste</P>\n<P align=\"right\">livro você encontrará</P>\n<P align=\"right\">várias listas das</P>\n<P align=\"right\">patentes militares</P>\n<P align=\"right\">da Horda e da</P>\n<P align=\"right\">insignificante Aliança.</P>\n<P align=\"right\">Primeiro vem a</P>\n<P align=\"right\">Horda, depois a Aliança,</P>\n<P align=\"right\">cada uma com listas de patentes de oficiais e de praças.  Como convém, os mais fortes aparecem no topo, com os mais fracos abaixo deles.</P>\n</BODY>\n</HTML>",
