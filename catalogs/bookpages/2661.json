    "esES": {
      "description": "<HTML><BODY><H1 align=\"center\">RANGOS MILITARES DE LA HORDA Y DE LA ALIANZA</H1><BR/><BR/><IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/><BR/><P align=\"right\">¡Throm'ka! En este</P><P align=\"right\">libro encontrarás</P><P align=\"right\">muchas listas de</P><P align=\"right\">rangos militares</P><P align=\"right\">de la Horda y</P><P align=\"right\">de la insignificante Alianza.</P><P align=\"right\">Primero aparecen los rangos de la</P><P align=\"right\">Horda y luego de la Alianza,</P><P align=\"right\">cada una con listados de rangos de oficiales y de soldados. Está ordenada de tal manera que los más poderosos aparecen al principio y los más débiles al final.</P></BODY></HTML>",
