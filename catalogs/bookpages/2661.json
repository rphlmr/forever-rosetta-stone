    "hrHR": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">VOJNI ČINOVI HORDE &amp; SAVEZA</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankHorde\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Throm'ka!  U ovoj</P>\n<P align=\"right\">knjizi pronaći ćeš</P>\n<P align=\"right\">brojne popise</P>\n<P align=\"right\">vojnih činova</P>\n<P align=\"right\">Horde i</P>\n<P align=\"right\">bijednog Saveza.</P>\n<P align=\"right\">Prvo dolazi</P>\n<P align=\"right\">Horda, a zatim Savez,</P>\n<P align=\"right\">svaki s popisom časničkih i vojničkih činova.  Kako i priliči, najjači su navedeni na vrhu, a slabiji ispod njih.</P>\n</BODY>\n</HTML>",
