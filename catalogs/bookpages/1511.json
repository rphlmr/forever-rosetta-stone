    "plPL": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">\nRozdział 1: PÓŁNOCNY PYLON\n</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\Pictures\\11482_crystals_mini_north\" align=\"left\"/>\n<P align=\"right\">Północny<BR/>\nPylon akceptuje<BR/>\nżółte, czerwone<BR/>\ni zielone<BR/>\nkryształy.</P>\n<BR/>\n<BR/>\n<BR/>\n<BR/>\n<P align=\"left\">Pylon skupia się na energii, którą można utworzyć, używając żółtych kryształów jako głównego źródła mocy.</P>\n</BODY>\n</HTML>",
