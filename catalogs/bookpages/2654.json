    "frFR": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">TRAITE DES GRADES MILITAIRES</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankAlliance\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Vous trouverez ici les</P>\n<P align=\"right\">grades militaires de</P>\n<P align=\"right\">l'Alliance, suivies par les</P>\n<P align=\"right\">informations équivalentes</P>\n<P align=\"right\">dont nous disposons</P>\n<P align=\"right\">concernant les races</P>\n<P align=\"right\">de la Horde. Chaque</P>\n<P align=\"right\">liste comporte deux</P>\n<P align=\"right\">sections, officiers et hommes de troupe. Les grades sont cités du plus élevé au moins élevé. Longue vie à l'Alliance !</P>\n</BODY>\n</HTML>",
