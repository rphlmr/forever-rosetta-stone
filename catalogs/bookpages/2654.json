    "csCZ": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">POJEDNÁNÍ O VOJENSKÝCH HODNOSTECH</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankAlliance\" align=\"left\"/>\n<BR/>\n<P align=\"right\">Následuje přehled</P>\n<P align=\"right\">vojenských hodností</P>\n<P align=\"right\">Aliance, po nichž</P>\n<P align=\"right\">následují informace,</P>\n<P align=\"right\">které jsou známé</P>\n<P align=\"right\">o rasách Hordy.</P>\n<P align=\"right\">Každá strana je</P>\n<P align=\"right\">rozdělena do dvou</P>\n<P align=\"right\">oddílů: důstojníci a mužstvo. Hodnosti jsou řazeny sestupně od nejvyšší po nejnižší. Nechť žije Aliance!</P>\n</BODY>\n</HTML>",
