    "zhCN": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">军衔概述</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankAlliance\" align=\"left\"/>\n<BR/>\n <P align=\"right\">以下是</P>\n <P align=\"right\">联盟的军衔概述，</P>\n <P align=\"right\">同时包括部落种族</P>\n <P align=\"right\">的军衔信息。</P><BR/>\n <P align=\"right\">每一个阵营都</P>\n <P align=\"right\">包含两个章节。</P>\n <P align=\"right\">军官和士兵的军阶，</P>\n <P align=\"right\">按照由高到低的顺序排列。</P><BR/>\n <P align=\"right\">联盟万岁!</P>\n</BODY>\n</HTML>",
