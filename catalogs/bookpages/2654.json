    "plPL": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">TRAKTAT O RANGACH WOJSKOWYCH</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\PvPRankBadges\\PvPRankAlliance\" align=\"left\"/>\n<BR/>\n<P align=\"right\">To, co następuje, to</P>\n<P align=\"right\">rangi wojskowe</P>\n<P align=\"right\">Przymierza,</P>\n<P align=\"right\">poprzedzone takimi</P>\n<P align=\"right\">informacjami, jakie</P>\n<P align=\"right\">są znane o rasach</P>\n<P align=\"right\">Hordy. Każda</P>\n<P align=\"right\">z nich przedstawiona jest w dwóch</P>\n<P align=\"right\">sekcjach, oficerowie i potem szeregowi, a rangi każdej wymienione są w malejącej kolejności od najwyższej do najniższej. Niech żyje Przymierze!</P>\n</BODY>\n</HTML>",
