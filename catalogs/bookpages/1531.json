    "trTR": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">\nBölüm 3: BATI PYLON'U\n</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\Pictures\\11482_crystals_mini_west\" align=\"left\"/>\n<P align=\"right\">Batı Pylon'u<BR/>\nkırmızı, yeşil<BR/>\nve mavi<BR/>\nkristalleri<BR/>\nkabul eder.</P>\n<BR/>\n<BR/>\n<BR/>\n<BR/>\n<P align=\"left\">Pylon, ana güç kaynağı olarak kırmızı kristaller kullanılarak oluşturulabilen enerjiye odaklanır.</P>\n</BODY>\n</HTML>",
