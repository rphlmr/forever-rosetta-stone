    "plPL": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">\nRozdział 3: PYLON ZACHODNI\n</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\Pictures\\11482_crystals_mini_west\" align=\"left\"/>\n<P align=\"right\">Pylon Zachodni<BR/>\nprzyjmuje<BR/>\nczerwone, zielone<BR/>\ni niebieskie<BR/>\nkryształy.</P>\n<BR/>\n<BR/>\n<BR/>\n<BR/>\n<P align=\"left\">Pylon skupia się na energii, którą można wytworzyć, używając czerwonych kryształów jako głównego źródła zasilania.</P>\n</BODY>\n</HTML>",
