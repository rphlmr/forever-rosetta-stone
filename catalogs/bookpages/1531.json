    "frFR": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">\nChapitre 3 : LE PYLONE OUEST\n</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\Pictures\\11482_crystals_mini_west\"/>\n<P align=\"right\">Le Pylône<BR/>\nouest accepte<BR/>\nles cristaux<BR/>\nrouges, verts<BR/>\net bleus.</P>\n<BR/>\n<BR/>\n<BR/>\n<BR/>\n<P align=\"left\">Le Pylône se focalise sur l'énergie qui peut être créée en utilisant des cristaux rouges comme source de puissance principale.</P>\n</BODY>\n</HTML>",
