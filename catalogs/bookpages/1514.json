    "plPL": {
      "description": "<HTML>\n<BODY>\n<H1 align=\"center\">\nRozdział 2: PYLON WSCHODNI\n</H1>\n<BR/>\n<BR/>\n<IMG src=\"Interface\\Pictures\\11482_crystals_mini_east\" align=\"left\"/>\n<P align=\"right\">Pylon Wschodni<BR/>\nprzyjmuje<BR/>\nniebieskie, żółte<BR/>\ni zielone<BR/>\nkryształy.</P>\n<BR/>\n<BR/>\n<BR/>\n<BR/>\n<P align=\"left\">Pylon skupia się na energii, którą można wytworzyć, używając niebieskich kryształów jako głównego źródła zasilania.</P>\n</BODY>\n</HTML>",
