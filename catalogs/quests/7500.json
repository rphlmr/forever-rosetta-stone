    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "a1ea2ac228c6a7107b29": "Excellent work, $r. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes.",
        "bc9f7ad19efef6545fd9": "You have recovered a tome!"
      },
      "summary": "Return the book to its rightful owners.",
      "title": "The Arcanist's Cookbook",
