  "locales": {
    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "a1ea2ac228c6a7107b29": "Výborná práce, $r. Najdeš-li další svazky, neváhej nám je přinést.$B$BPostupem času odměny za vrácení ztracených svazků měníme a dokonce přidáváme nové.",
        "bc9f7ad19efef6545fd9": "Našel jsi svazek!"
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Kuchařka arkanisty",
