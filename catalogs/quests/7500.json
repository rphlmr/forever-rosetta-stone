    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "a1ea2ac228c6a7107b29": "Fremragende arbejde, $r. Finder du flere bøger, så tøv ikke med at bringe dem til os.$B$BMed tiden ændrer vi belønningerne for de manglende bøger og tilføjer endda nye.",
        "bc9f7ad19efef6545fd9": "Du har fundet en bog!"
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
      "title": "Arkanistens kogebog",
