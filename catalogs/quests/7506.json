    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "3ff2889cbe942c18a33d": "You have recovered a tome!",
        "c8e00f546f5b44efbdfc": "Excellent work, $R. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes."
      },
      "summary": "Return the book to its rightful owners.",
      "title": "The Emerald Dream...",
