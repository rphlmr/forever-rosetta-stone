  "locales": {
    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "3ff2889cbe942c18a33d": "Našel jsi svazek!",
        "c8e00f546f5b44efbdfc": "Výborná práce, $R. Najdeš-li další svazky, neváhej nám je přinést.$B$BPostupem času odměny za navrácení chybějících svazků měníme a přidáváme nové."
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Smaragdový sen...",
