    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "3ff2889cbe942c18a33d": "Du har fundet et bind!",
        "c8e00f546f5b44efbdfc": "Godt arbejde, $R. Hvis du finder flere bind, så tøv ikke med at bringe dem tilbage til os.$B$BMed tiden ændrer vi belønningerne for de savnede bind og tilføjer nye."
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
      "title": "Smaragddrømmen...",
