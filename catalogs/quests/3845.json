  "locales": {
    "csCZ": {
      "description": "Uchopíš vak a vytáhneš ho zpátky na břeh. Možná když prozkoumáš věci uvnitř, zjistíš víc o tom, komu patří.\n\nV Marshal's Refuge je pár bloudících poutníků. Možná se tam dozvíš víc.",
      "dialogue": {
        "8d6420cc91f3243eb5d5": "Ahoj. Už jsem tě někde viděl... že?",
        "fbdf8ecfa421de8e92ee": "Ach... Ano, ty věci mi připadají povědomé... tak trochu..."
      },
      "summary": "Prozkoumej předměty uvnitř batohu a dones je jejich majiteli.",
      "title": "To je tajemství pro všechny",
      "translationMetadata": {
