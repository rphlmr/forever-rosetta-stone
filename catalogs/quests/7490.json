    "enUS": {
      "description": "You have accomplished the impossible. The brood mother of the Black Dragonflight lies dead at your feet. Take her head and present it to your Warchief.",
      "dialogue": {
        "54b7b4bc87c94b147edf": "This is a great victory for the Horde, $N. So many times you have honored your Warchief. It is time for the Warchief to honor you."
      },
      "summary": "Take the Head of Onyxia to Thrall in Orgrimmar.",
      "title": "Victory for the Horde",
