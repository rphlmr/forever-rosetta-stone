  "locales": {
    "csCZ": {
      "description": "Podařilo se ti nemožné. Matka rodu Black Dragonflight leží mrtvá u tvých nohou. Vezmi její hlavu a předlož ji svému Válečnému náčelníkovi.",
      "dialogue": {
        "54b7b4bc87c94b147edf": "Toto je velké vítězství Hordy, $N. Tolikrát jsi vzdal čest svému náčelníkovi. Nyní je čas, aby náčelník vzdal čest tobě."
      },
      "summary": "Dones Head of Onyxia Thrallovi do Orgrimmaru.",
      "title": "Vítězství pro Hordu",
