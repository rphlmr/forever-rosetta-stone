    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "405d1ae1f292465f19af": "Har du bragt noget til vores samling?",
        "4d93c4c5e5ddf963a42e": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kunne gavne biblioteket, så bring dem til mig.",
        "54edd9e04aa7a2ef95f0": "Har du bragt noget til vores samling?",
        "caec60dc51680e67a6ed": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kan gavne biblioteket, så bring dem til mig."
      },
      "summary": "Har du bragt noget til vores samling?",
