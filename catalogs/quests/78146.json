  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "405d1ae1f292465f19af": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
        "4d93c4c5e5ddf963a42e": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "54edd9e04aa7a2ef95f0": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
        "caec60dc51680e67a6ed": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím."
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
