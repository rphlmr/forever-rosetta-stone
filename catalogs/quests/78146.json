    "hrHR": {
      "description": "Jesi li donio nešto što možemo dodati našoj zbirci?",
      "dialogue": {
        "405d1ae1f292465f19af": "Jesi li donio nešto što možemo dodati našoj zbirci?",
        "4d93c4c5e5ddf963a42e": "Hvala ti, $N. Zahvaljujući tvom trudu naše znanje raste.\n\nAko pronađeš još čarobnih djela koja bi mogla koristiti knjižnici, donesi mi ih.",
        "54edd9e04aa7a2ef95f0": "Jesi li donio nešto što možemo dodati našoj zbirci?",
        "caec60dc51680e67a6ed": "Hvala ti, $N. Zahvaljujući tvom trudu naše se znanje širi.\n\nAko pronađeš još magičnih djela koja bi mogla koristiti knjižnici, molim te donesi mi ih."
      },
      "summary": "Jesi li donio nešto što možemo dodati našoj zbirci?",
