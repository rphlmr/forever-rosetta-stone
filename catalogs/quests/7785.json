    "enUS": {
      "description": "Examine the vessel of his rebirth, mortal. It is from this that the Windseeker shall be reborn!",
      "dialogue": {
        "541dfad60e9451702fdd": "May you be protected in your crusade. May the Master bless your efforts.",
        "c14e3e0d139b92f4dd08": "Will you release him from his eternal prison?"
      },
      "summary": "Examine the Vessel of Rebirth and return it to Highlord Demitrian.",
      "title": "Examine the Vessel",
