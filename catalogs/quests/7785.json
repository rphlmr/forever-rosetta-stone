  "locales": {
    "csCZ": {
      "description": "Prohlédni si schránku jeho znovuzrození, smrtelná bytosti. Právě z ní se Hledač větru znovu zrodí!",
      "dialogue": {
        "541dfad60e9451702fdd": "Ať jsi na své křížové výpravě v bezpečí. Ať Mistr požehná tvému úsilí.",
        "c14e3e0d139b92f4dd08": "Vysvobodíš ho z jeho věčného vězení?"
      },
      "summary": "Prozkoumej Vessel of Rebirth a vrať ji vrchnímu lordovi Demitrianovi.",
      "title": "Prozkoumej nádobu",
