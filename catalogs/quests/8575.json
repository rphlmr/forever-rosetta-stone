    "esES": {
      "description": "No entiendes ni una palabra de este libro de contabilidad. ¡Ni siquiera sabes en qué idioma está escrito!",
      "dialogue": {
        "0b3fa5607fa43102cbba": "\n ¡Excelente, $R!  ¿Qué es?  No puedo leer ni una pizca de Draconic.",
        "da12ee819c68d67b8441": "¡Ooooh!  ¡Cosita mágica pulsante!  ¿Para mí?"
      },
