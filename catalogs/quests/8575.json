  "locales": {
    "csCZ": {
      "description": "Nerozumíš ani jednomu slovu v této účetní knize. Ani nevíš, v jakém jazyce je napsána!",
      "dialogue": {
        "0b3fa5607fa43102cbba": "<Narain dychtivě zkoumá dopis.>$B$BVýborně, $R! Co se tam píše? Dračí písmo vůbec neumím číst.",
        "da12ee819c68d67b8441": "Jééé! Magická pulzující věcička! Pro mě?"
      },
      "summary": "Doruč Azuregos's Magical Ledger Narainu Soothfancymu do Tanarisu.",
      "title": "Azuregosova magická účetní kniha",
