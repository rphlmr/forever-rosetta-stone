    "csCZ": {
      "description": "Ty žiješ! To je vskutku dobrá zpráva. Předpokládám, že jsi zpět pro další scorpokový vzorek?\n\nVýborně, {name}, zpátky do pustiny a nevracej se, dokud neshromáždíš tři klepeta scorpoka, dva supí žaludky a jednu plíci zpustošeného kance.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Klepeto Scorpok",
          "type": "item"
        },
        {
          "index": 2,
          "text": "{current}/{required} Supí žaludek",
          "type": "item"
        },
        {
          "index": 3,
          "text": "{current}/{required} Roztrhaná kančí plíce",
          "type": "item"
        }
      ],
      "summary": "Přines 3× Scorpok Pincers, 2× Vulture Gizzards a 1× Blasted Boar Lung krvavému mágovi Drazialovi.",
