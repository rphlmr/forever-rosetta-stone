  "locales": {
    "csCZ": {
      "description": "Když si seržant všimne tvé láhve hromové jablečné pálenky, rozzáří se mu oči...",
      "dialogue": {
        "0c586fa9e2a46ca9d13c": "Neklamou mě oči? Už celé měsíce jsem neviděl ani kapku Hromové jablkovice!\nTohle vykouzlí vojákům úsměv na tváři. Děkuji ti, $c!",
        "a8ab83f5277c166c79db": "Seržantovi se rozzáří oči, když si všimne tvé lahve Hromové jablkovice..."
      },
      "summary": "Když si seržant všimne tvé láhve hromové jablečné pálenky, rozzáří se mu oči...",
