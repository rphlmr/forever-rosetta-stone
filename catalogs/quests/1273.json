      "objectiveLines": [
        {
          "index": 1,
          "text": "Vyslechni Reetheho spolu s Ogronem",
          "type": "event"
        }
      ],
      "summary": "Jdi s Ogronem promluvit s Reethem a pak se vrať ke Krogu do Brackenwall Village.",
