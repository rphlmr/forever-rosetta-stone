    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "85db775e5578fd6a1e9f": "Har du bragt noget til vores samling?",
        "9f29ec7ce17af2b2a2a4": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kunne gavne biblioteket, så bring dem til mig.",
        "ae116b2dfa1f20920d10": "Har du bragt noget til vores samling?",
        "aeadc3cd5b662ce53a9c": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kan gavne biblioteket, så bring dem venligst til mig."
      },
      "summary": "Har du bragt noget til vores samling?",
