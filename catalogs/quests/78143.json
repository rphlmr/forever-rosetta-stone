  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "85db775e5578fd6a1e9f": "Přinášíš něco do naší sbírky?",
        "9f29ec7ce17af2b2a2a4": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "ae116b2dfa1f20920d10": "Přinesl jsi něco do naší sbírky?",
        "aeadc3cd5b662ce53a9c": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by knihovně mohla prospět, přines mi je prosím."
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
