    "enUS": {
      "description": "Danitha Morr has ordered you to report back to Bandarion Keep to receive additional training. Please make your way back to the keep as quickly as you are able.",
      "dialogue": {
        "99cf483332d6f44730da": "Glad you made it, $N. You've seen much and traveled far, and you are now ready for the next step on your journey as a $c."
