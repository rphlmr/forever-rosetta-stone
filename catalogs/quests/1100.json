  "locales": {
    "csCZ": {
      "description": "Pomalu otevíráš ošoupaný deník Henriga Lonebrowa...",
      "dialogue": {
        "023927d6f7f7a0c80c52": "Podle tvého ustaraného výrazu poznávám, že něco není v pořádku...",
        "66e5fa6763e688f98331": "Říkáš, že jsi ten deník našel u mrtvého trpaslíka? Dej mi chvilku, abych si prohlédl jeho stránky..."
      },
      "summary": "Přečti si Henrig Lonebrow's Journal.",
      "title": "Lonebrowův deník",
