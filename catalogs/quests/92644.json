    "enUS": {
      "description": "<You reach beneath the still-warm body of the turncoat cultist and recover a small, glowing blue crystal. It appears to be damaged, but it may still be important. High Elder Shadowsong may be interested in this.>",
      "dialogue": {
        "1725cf14f0fcd0d4f66b": "You are back? And... alone?"
      },
      "summary": "Deliver the glowing crystal to Talanaanis Shadowsong in Valanaar.",
      "title": "Unfortunate News",
