  "locales": {
    "csCZ": {
      "description": "<Sáhneš pod ještě teplé tělo kultisty přeběhlíka a vytáhneš malý, modře zářící krystal. Zdá se poškozený, ale i tak může být důležitý. Vrchního stařešinu Shadowsonga by mohl zajímat.>",
      "dialogue": {
        "1725cf14f0fcd0d4f66b": "Už jsi zpátky? A... bez doprovodu?"
      },
      "summary": "Doruč zářící krystal Talanaanisovi Shadowsongovi do Valanaaru.",
      "title": "Nemilé zprávy",
