  "locales": {
    "csCZ": {
      "description": "<Když vytrhneš z Twilight Tome jedinou stránku, zaplaví tvou mysl nezvaný, zlověstný hlas.>\n\nSelhali.\n\nUpadneš v zapomnění.\n\nPřijdou o oko, které získali.",
      "dialogue": {
        "a9df4db2ce4b0162556d": "Vypadáš ustaraně. Poslouchám."
      },
      "summary": "Získej Peerless Eye od Twilight Disciple nebo Thug u Master's Glaive v Darkshore a najdi v Auberdine někoho, kdo je ochotný ho převzít.",
      "title": "Všechno je legrace, dokud...",
