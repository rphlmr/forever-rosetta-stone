  "locales": {
    "csCZ": {
      "description": "Kde se touláš, {name}? Hulfdan tě hledá po celém kraji. Mysleli jsme, že tě král nechal vsadit do želez.\n\nZamiř co nejdřív do Ironforge a promluv si s Hulfdanem!",
      "dialogue": {
        "68fcfcadf644929f82b2": "Mluv tiše, $N, stráže tě mohou slyšet.",
        "926aa2f7b38f0633798f": "Kde jsi byl, $N? Hulfdan tě všude hledal. Mysleli jsme, že tě král nechal spoutat.$B$BVydej se co nejrychleji do Ironforge a promluv si s Hulfdanem!"
      },
      "summary": "Vydej se do Ironforge a promluv si s Hulfdanem Blackbeardem.",
      "title": "K Hulfdanovi!",
