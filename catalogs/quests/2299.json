    "daDK": {
      "description": "Hvor har du været, {name}? Hulfdan har ledt efter dig overalt. Vi troede, at kongen måske havde lagt dig i jern.\n\nTag til Ironforge så hurtigt som muligt og tal med Hulfdan!",
      "dialogue": {
        "68fcfcadf644929f82b2": "Tal lavt, $N, vagterne kan høre dig.",
        "926aa2f7b38f0633798f": "Hvor har du været, $N? Hulfdan har ledt efter dig overalt. Vi troede, kongen havde lagt dig i lænker.$B$BTag til Ironforge så hurtigt som muligt og tal med Hulfdan!"
      },
      "summary": "Rejs til Ironforge, og tal med Hulfdan Blackbeard.",
      "title": "Til Hulfdan!",
      "translationMetadata": {
