  "locales": {
    "csCZ": {
      "description": "<Vybledlým inkoustem psaný přípis žádá 1× Blue Glittering Axe a uvádí místo doručení i platbu. Dole stojí, že je přípis převoditelný.>",
      "dialogue": {
        "3150a209fd19b0681718": "Zdravím, $c."
      },
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Blue Glittering Axe",
