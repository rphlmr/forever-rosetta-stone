    "daDK": {
      "description": "Du har arbejdet hårdt, ven. Hvil dine trætte knogler og lad mig præsentere mig ordentligt.\r\n",
      "dialogue": {
        "5021ab35286a7387bc99": "Du har arbejdet hårdt, ven. Hvil dine trætte knogler og lad mig præsentere mig ordentligt.\r\n",
        "da054b7f436e94c4d073": "Fordrings forløsning bliver en vanskelig opgave. Er du klar?",
        "e8c41d211f098b2a8916": "Sæt dig ned og hør min fortælling, ven."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Tirions fortælling",
          "type": "event"
        }
      ],
      "summary": "Lyt til, hvad Tirion Fordring har at sige.",
