  "locales": {
    "csCZ": {
      "description": "Máš za sebou tvrdou práci, přátelská duše. Odpočiň si unavené kosti a dovol mi, abych se ti pořádně představil.",
      "dialogue": {
        "5021ab35286a7387bc99": "Máš za sebou tvrdou práci, přátelská duše. Odpočiň si unavené kosti a dovol mi, abych se ti pořádně představil.",
        "da054b7f436e94c4d073": "Vykoupení Fordringa bude obtížný úkol. Cítíš se na něj?",
        "e8c41d211f098b2a8916": "Prosím, příteli, posaď se a vyslechni můj příběh."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Tirionův příběh",
          "type": "event"
        }
      ],
      "summary": "Vyslechni si, co má Tirion Fordring na srdci.",
      "title": "Vykoupení",
