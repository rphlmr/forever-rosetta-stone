    "hrHR": {
      "description": "Marljivo si radio, prijatelju. Odmori svoje umorne kosti i dopusti da se pravilno predstavim.\r\n",
      "dialogue": {
        "5021ab35286a7387bc99": "Marljivo si radio, prijatelju. Odmori svoje umorne kosti i dopusti da se pravilno predstavim.\r\n",
        "da054b7f436e94c4d073": "Fordringovo iskupljenje bit će težak zadatak. Osjećaš li se spremno?",
        "e8c41d211f098b2a8916": "Molim te, prijatelju, sjedni i poslušaj moju priču."
      },
      "objectiveLines": [
