  "locales": {
    "csCZ": {
      "description": "Znáš to, děcko. Za jeden Valor Token dostaneš Craftsman's Writ.",
      "dialogue": {
        "05c8eabcbed86e1336cb": "Víš, jak to chodí, kluku. Za jeden žeton udatnosti dostaneš řemeslnický příkaz.",
        "e8e45a2e162845bd65ca": "Tohle sis zasloužil, zelenáči. A teď si na své příkazy nestěžuj. Splň je, nebo je znič.\n"
      },
      "summary": "Víš, jak to chodí, mladej. Jeden žeton udatnosti ti zajistí řemeslnický výnos.",
      "title": "Přípis řemeslníka",
