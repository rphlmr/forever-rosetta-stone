    "daDK": {
      "description": "Hmf! Der er al den sprut hernede, men jeg har strenge ordrer om ikke at røre den. Hvis jeg bare kunne få en smagsprøve på vores Thunder Ale... det ville skærpe min forstand, jeg lyver ikke!",
      "dialogue": {
        "3802b87ca1136240ab35": "Til mig? Du er en sand helt, $N!",
        "93cbfc63c49ccab2e456": "Hmpf! Der er al den sprut hernede, men jeg har streng ordre til ikke at røre den. Hvis bare jeg kunne smage vores Tordenøl... så ville tankerne stå skarpere, det er ikke løgn!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Tordenøl",
          "type": "item"
        }
      ],
      "summary": "Hmf! Der er al den sprut hernede, men jeg har strenge ordrer om ikke at røre den. Hvis jeg bare kunne få en smagsprøve på vores Thunder Ale... det ville skærpe min forstand, jeg lyver ikke!",
