  "locales": {
    "csCZ": {
      "description": "Hm! Tady dole je tolik chlastu, ale mám přísný rozkaz se ho ani nedotknout. Kéž bych mohl ochutnat trochu našeho hromového piva... to by mi zbystřilo rozum, vážně!",
      "dialogue": {
        "3802b87ca1136240ab35": "Pro mě? Jsi skutečný hrdina, $N!",
        "93cbfc63c49ccab2e456": "Hmpf! Je tu tolik chlastu, ale mám přísný rozkaz se ho nedotýkat. Kdybych tak mohl ochutnat naše Hromové pivo... to by mi zbystřilo rozum, nelžu!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Hromové pivo",
          "type": "item"
        }
      ],
      "summary": "Hm! Tady dole je tolik chlastu, ale mám přísný rozkaz se ho ani nedotknout. Kéž bych mohl ochutnat trochu našeho hromového piva... to by mi zbystřilo rozum, vážně!",
