  "locales": {
    "csCZ": {
      "description": "Na těle padlého přízraku najdeš krystal, který slabě vyzařuje nekrotickou energii.",
      "dialogue": {
        "6718d7838dcd868f89bd": "Říkáš, že jsi to získal od nemrtvého, který útočil na město?$b$bDostali jsme zprávy o základnách nekropolí, které Pohroma vyvolává. Mám podezření, že se jednu pokoušeli vytvořit v Undercity. Musíme být v budoucnu ostražití.",
        "c738890716dc7b0d9b32": "Mohu ti nějak pomoci?"
      },
      "summary": "Dones Faint Necrotic Crystal poručíkovi Rukagovi na nádvoří Undercity.",
      "title": "Slabý Necrotic Crystal",
