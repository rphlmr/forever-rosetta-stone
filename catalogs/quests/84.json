    "svSE": {
      "description": "Här har du. Och när du ger den här pajen till Billy, så säg att jag hoppas han sätter den i halsen!",
      "dialogue": {
        "7d88a6700e3f38156881": "Här har du. Och när du ger den här pajen till Billy, så säg att jag hoppas han sätter den i halsen!",
