    "trTR": {
      "description": "Al bakalım. Bu turtayı şu Billy'ye verirken, umarım boğazına takılır dediğimi söyle!",
      "dialogue": {
        "7d88a6700e3f38156881": "Al bakalım. Bu turtayı şu Billy'ye verirken, umarım boğazına takılır dediğimi söyle!",
