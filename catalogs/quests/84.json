  "locales": {
    "csCZ": {
      "description": "Tady to máš. A až dáš ten koláč tomu Billymu, řekni mu, že doufám, že se jím udusí!",
      "dialogue": {
        "7d88a6700e3f38156881": "Tady to máš. A až dáš ten koláč tomu Billymu, řekni mu, že doufám, že se jím udusí!",
        "c01497789ffceda52e96": "Ach... umírám hlady! Máš pro mě ten koláč, $N?",
        "e46f35ae12d6eed2e6d1": "Mňam, dobrota! Tenhle koláč je nejlepší!$B$BMyslím, že se mi vrací paměť..."
      },
      "summary": "Dones Pork Belly Pie Billymu Maclurovi do Maclure Vineyards.",
      "title": "Zpátky k Billymu",
