  "locales": {
    "csCZ": {
      "description": "K útoku na Hive'Zora byly povolány posily. Padla na tebe volba: zaměř se na úlové sestry Hive'Zora. Po splnění úkolu se hlas u velitele Mar'alitha.",
      "dialogue": {
        "29bd2f91d6e90e1394a5": "Chceš mi něco říct, $C?",
        "dbb9c8015542375d3f45": "Výborná práce, $N. Jsi skvělý spojenec."
      },
      "summary": "Zabij 30× Hive'Zora Hive Sisters a hlas se u velitele Mar'alitha v Cenarion Hold v Silithusu. K dokončení tohoto úkolu musíš také přinést Combat Task Briefing V.",
      "title": "Cíl: Hive'Zora Hive Sisters",
