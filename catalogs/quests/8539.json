    "enUS": {
      "description": "Reinforcements have been called on to join the assault on Hive'Zora.  You have been selected to target Hive'Zora hive sisters.  Report back to Commander Mar'alith after completing your task.",
      "dialogue": {
        "29bd2f91d6e90e1394a5": "You have something to tell me, $C?",
        "dbb9c8015542375d3f45": "Excellent work, $N. You're a worthy ally."
      },
      "summary": "Slay 30 Hive'Zora Hive Sisters and report back to Commander Mar'alith at Cenarion Hold in Silithus. You must also bring Combat Task Briefing V in order to complete this quest.",
      "title": "Target: Hive'Zora Hive Sisters",
