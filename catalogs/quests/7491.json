  "locales": {
    "csCZ": {
      "description": "Vládce Runthak očekává tvůj příchod ve Valley of Strength.\n\n<Thrall ti zasalutuje.>\n\nNenech své obecenstvo čekat, hrdinná duše.",
      "dialogue": {
        "06ecaf094bef6028012a": "Vladař Runthak čeká na tvůj příchod v Údolí síly.$B$B<Thrall ti zasalutuje.>$B$BNenechávej svůj lid čekat, hrdino.",
        "733fde63062b6d13f5a5": "Vyber si odměnu a oslava tvého slavného vítězství může začít."
      },
      "summary": "Vyhledej vládce Runthaka ve Valley of Strength.",
      "title": "Ať všichni vidí",
