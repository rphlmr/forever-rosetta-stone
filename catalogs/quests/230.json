  "locales": {
    "csCZ": {
      "description": "Při přehrabování hromady najdeš malou, hlínou zašpiněnou knížku.\n\nKniha nemá název, ale... obsahuje informace, které by Sven rád znal.",
      "dialogue": {
        "05bb1e0a2782480fe2c4": "Cože jsi našel?? Prosím, ukaž mi to...",
        "8fa0e0d21ebba3417139": "<Sven pročte stránky knihy a pak ji s bouchnutím zavře.>$B$BTa stinná postava, kterou jsem viděl, byla svědkem smrti mé rodiny! Rád bych tomu muži položil pár otázek... jen kdybych věděl, kdo to byl!"
      },
      "summary": "Dones knihu ze Sven's Farm Svenovi.",
      "title": "Svenův tábor",
