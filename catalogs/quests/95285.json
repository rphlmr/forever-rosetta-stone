    "enUS": {
      "description": "<Sergeant Ulka struggles to sit up to speak with you. You offer your hand in aid, but she merely swats it away.>\r\n\r\nAlright recruit... let's get you caught up.",
      "dialogue": {
        "64be6d7b4fe563bb8f91": "The rest of our mission details are need to know, and that's all you need to know. So, are you ready to do your duty to your warchief?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Speak with Sergeant Ulka",
          "type": "monster"
        }
      ],
      "summary": "Speak with Sergeant Ulka to learn more about the situation on Alcaz Isle.",
      "title": "Right Place, Wrong Time",
