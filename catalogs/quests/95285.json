  "locales": {
    "csCZ": {
      "description": "<Seržantka Ulka se s námahou posadí, aby s tebou mohla mluvit. Nabídneš jí ruku, ale ona ji jen odstrčí.>\n\nTak jo, nováčku... uvedu tě do obrazu.",
      "dialogue": {
        "64be6d7b4fe563bb8f91": "O zbytku mise vědí jen ti, kdo to potřebují, a to je vše, co potřebuješ vědět ty. Tak co, jsi připraven sloužit svému náčelníkovi?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Promluv si se seržantkou Ulkou",
          "type": "monster"
        }
      ],
      "summary": "Promluv si se seržantem Ulkou a zjisti víc o situaci na Alcaz Isle.",
      "title": "Správné místo, špatný čas",
