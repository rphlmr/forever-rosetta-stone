    "daDK": {
      "description": "<Sergent Ulka kæmper for at sætte sig op og tale med dig. Du tilbyder hende en hånd, men hun slår den blot væk.>\r\n\r\nGodt, rekrut ... lad os få dig ajour.",
      "dialogue": {
        "64be6d7b4fe563bb8f91": "Resten af missionens detaljer er kun for dem, der behøver at kende dem, og det er alt, du behøver at vide. Er du klar til at gøre din pligt over for din krigshøvding?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Tal med Sergeant Ulka",
          "type": "monster"
        }
      ],
      "summary": "Tal med Sergeant Ulka for at lære mere om situationen på Alcaz Isle.",
      "title": "Det rette sted, den forkerte tid",
