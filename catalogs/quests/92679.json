    "enUS": {
      "description": "H--Hello, stranger. You have the look of a capable adventurer about you. I...\r\n\r\n<The Skyborne man winces, clearly suffering terrible pain>\r\n\r\n...I was wondering if you were seeking employment? I came here to Valanaar to recruit fighters to help save my farm. If you are interested, please go find my wife Aamelia Windfield at our orchard to the west of Valanaar, in the lowlands.",
      "dialogue": {
        "fb947c2b66f9a0bac967": "What? Alvarion is alive?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Find Aamelia Windfield",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Listen to Alvarion Windfield's Story (Optional)",
          "type": "monster"
        }
      ],
      "summary": "Listen to what Alvarion Windfield has to say and find Aamelia Windfield at the Windfield Orchard.",
      "title": "Blood Tithe",
