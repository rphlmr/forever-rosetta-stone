  "locales": {
    "csCZ": {
      "description": "Z-zdravím. Ještě se neznáme. Vypadáš, že si na dobrodružných cestách umíš poradit. Já...\n\n<Skyborne muž sebou trhne, očividně trpí strašlivou bolestí.>\n\n...napadlo mě, jestli nehledáš práci? Přišel jsem sem do Valanaaru, abych najal bojovníky, kteří by mi pomohli zachránit mou farmu. Jestli máš zájem, najdi prosím mou ženu Aamelii Windfield v našem sadu na západ od Valanaaru, v nížinách.",
      "dialogue": {
        "fb947c2b66f9a0bac967": "Cože? Alvarion žije?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Najdi Aamelii Windfield",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Vyslechni si příběh Alvariona Windfielda (volitelné)",
          "type": "monster"
        }
      ],
      "summary": "Poslechni si, co chce říct Alvarion Windfield, a najdi Aamelii Windfield ve Windfield Orchard.",
      "title": "Krvavý desátek",
      "translationMetadata": {
