  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "276ea3d96fd8cd60dc0e": "Děkuji, $N. Díky tvému úsilí se naše znalosti rozšiřují.\n\nPokud objevíš další magická díla, která by knihovně prospěla, přines mi je prosím.",
        "acdfb64d3c02092319c7": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "d9a2947ea748e82f05f0": "Přinášíš něco do naší sbírky?",
        "ed0e018fc46767b0a7a1": "Přinášíš něco do naší sbírky?"
      },
