    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "276ea3d96fd8cd60dc0e": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som biblioteket kunne have gavn af, så bring dem til mig.",
        "acdfb64d3c02092319c7": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kunne gavne biblioteket, så bring dem til mig.",
        "d9a2947ea748e82f05f0": "Har du bragt noget til vores samling?",
        "ed0e018fc46767b0a7a1": "Har du noget med til vores samling?"
      },
