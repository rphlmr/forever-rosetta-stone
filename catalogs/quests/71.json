  "locales": {
    "csCZ": {
      "description": "Teď, když máš oba medailony, doruč je strážnému Thomasovi u mostu, aby se dozvěděl osud svých zavražděných strážných.",
      "dialogue": {
        "882bf465ec3d0d976044": "Potvrdil jsi mé obavy, $N. Murloci jsou hrozbou, kterou nemůžeme ignorovat.",
        "daaec23e3aed3b7c367f": "Zdravím, $N. Zjistil jsi, co se stalo Rolfovi a Malakaiovi?"
      },
      "summary": "Doruč medailony Rolfa a Malakaie strážnému Thomasovi u východního mostu v Elwynnu.",
      "title": "Hlášení Thomasovi",
