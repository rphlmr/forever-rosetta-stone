  "locales": {
    "csCZ": {
      "description": "Díky tobě a Omarionovi (ať odpočívá v pokoji) mohu nyní vyrobit Polar bracers. Stačí mi jen přinést materiály a zaplatit malý výrobní poplatek.",
      "dialogue": {
        "504352a4c5a563e3bc48": "Tady je tvá objednávka, $N. Dodána, jak jsem slíbil!",
        "7f040d3cae8e6f84ed04": "Díky tobě a Omarionovi (ať odpočívá v pokoji) mohu nyní vyrobit Polar bracers. Stačí mi jen přinést materiály a zaplatit malý výrobní poplatek.",
        "cec7cf2847bcd9706edb": "Máš materiály?"
      },
      "summary": "Řemeslník Wilhelm v Light's Hope Chapel v Eastern Plaguelands chce 4× Frozen Runes, 12× Enchanted Leather, 3× Essence of Water, 3× Cured Rugged Hides a 200 zlatých.",
      "title": "Nátepníky Polar",
