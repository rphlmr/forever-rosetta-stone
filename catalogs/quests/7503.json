    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "714cb340b2d611945c97": "Excellent work, $R. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes.",
        "ed3eccc83f7b5157e043": "You have recovered a tome!"
      },
      "summary": "Return the book to its rightful owners.",
      "title": "The Greatest Race of Hunters",
