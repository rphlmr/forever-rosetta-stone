    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "714cb340b2d611945c97": "Fremragende arbejde, $R. Finder du flere bind, så tøv ikke med at bringe dem tilbage til os.$B$BMed tiden ændrer vi belønningerne for de savnede bind og tilføjer endda nye.",
        "ed3eccc83f7b5157e043": "Du har fundet et bind!"
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
      "title": "Det største kapløb blandt jægere",
