    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "714cb340b2d611945c97": "Výborná práce, $R. Najdeš-li další svazky, neváhej nám je přinést.$B$BPostupem času odměny za navrácení ztracených svazků obměňujeme a přidáváme nové.",
        "ed3eccc83f7b5157e043": "Získal jsi svazek!"
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Největší rasa lovců",
