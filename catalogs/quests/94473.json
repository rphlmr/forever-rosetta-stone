  "locales": {
    "csCZ": {
      "description": "Pokud tě zjevení v boji porazilo, promluv se mnou a dám ti další saptu, s níž spatříš duchy ve svatyni nahoře.",
      "dialogue": {
        "203048b130b326a98485": "Ať ve tvém srdci hoří oheň, Ukko.\n\nŽivly na tebe čekají."
      },
      "summary": "Promluv si s Braldirem Ashmantlem kvůli další Fire Sapta.",
      "title": "Ohňová sapta",
