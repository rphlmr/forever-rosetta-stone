  "locales": {
    "csCZ": {
      "description": "Musíme určit zdroj a povahu jedu, který tuto zemi hubí. Začněme podzemní vodou pod farmami v této oblasti.\n\nVydej se k usedlosti Jansen Stead na severu a na Molsenovu farmu severozápadně odtud a odeber vzorky z tamních studní.",
      "dialogue": {
        "248c3f9650bffaa54e38": "Musíme určit zdroj a povahu jedu, který tuto zemi hubí. Začněme podzemní vodou pod farmami v této oblasti.\n\nVydej se k usedlosti Jansen Stead na severu a na Molsenovu farmu severozápadně odtud a odeber vzorky z tamních studní.",
        "9dc110597ebafb36a34e": "Máš vzorky?",
        "d76a2e8d6344617e9a10": "Děkuji. Podívám se..."
      },
      "summary": "Použij Well Water Sample Kit k odebrání vzorků ze studní u Jansen Stead a Molsen Farm.",
      "title": "Testování studní",
