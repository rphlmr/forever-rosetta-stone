  "locales": {
    "csCZ": {
      "description": "<Tahle špinavá stará kniha nalezená nedaleko Shen'dralas už většinu svého vědění neuchovává.\n\nV textu, který zbyl, se jednotlivá písmena dají jen těžko odlišit od slov. Zpočátku může být čtení náročné, ale jedno ze slov vypadá jako příjmení.\n\nMožná se její autor, „Evenshade“, nachází někde poblíž.>",
      "dialogue": {
        "7628cc3c600034ef0542": "Potřebujete něco?"
      },
      "summary": "Podle textu by autor tohoto deníku mohl být někde v Shen'dralas.",
      "title": "Potrhaný deník",
      "translationMetadata": {
        "fields": {
