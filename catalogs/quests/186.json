    "enUS": {
      "description": "You are learning, {class}.  Let us test your skills with the mature cats now. Kill 10 Stranglethorn Tigers this time out.",
      "dialogue": {
        "261671230632902830ed": "You are learning, $c.  Let us test your skills with the mature cats now. Kill 10 Stranglethorn Tigers this time out.",
        "85985a9240cbee88041d": "If you strive for greater challenges you must first prove yourself with the task at hand.  Return to me after you've killed 10 Stranglethorn Tigers.",
        "fc9c6d7a428ceef13dae": "I am impressed, $c.  You are progressing quite well."
      },
      "summary": "Ajeck Rouack of Nesingwary's Expedition wants you to kill 10 Stranglethorn Tigers.",
