  "locales": {
    "csCZ": {
      "description": "Učíš se, {class}. Teď vyzkoušíme tvé schopnosti na dospělých kočkách. Tentokrát zabij 10 tygrů ze Stranglethornu.",
      "dialogue": {
        "261671230632902830ed": "Učíš se, $c. Teď vyzkoušíme tvé schopnosti na dospělých kočkách. Tentokrát zabij 10 tygrů ze Stranglethornu.",
        "85985a9240cbee88041d": "Pokud toužíš po větších výzvách, musíš se nejprve osvědčit v tomto úkolu. Vrať se, až zabiješ 10 tygrů ze Stranglethornu.",
        "fc9c6d7a428ceef13dae": "Jsem ohromen, $c. Děláš velké pokroky."
      },
      "summary": "Ajeck Rouack z Nesingwaryho výpravy chce, abys zabil 10 stranglethornských tygrů.",
      "title": "Mistrovství v lovu tygrů",
