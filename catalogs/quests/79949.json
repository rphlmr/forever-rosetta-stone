  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "3adab6c55cfd0176d70c": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
        "5c385b5a85f5b56437bb": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozrůstají.\n\nPokud objevíš další magická díla, která by knihovně prospěla, přines mi je prosím.",
        "a4b2212b8d39e6a26eb4": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "e4df7e5e8850fd25b3de": "Přinášíš něco, co bychom mohli přidat do naší sbírky?"
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
