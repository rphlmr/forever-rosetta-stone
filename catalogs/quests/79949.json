    "hrHR": {
      "description": "Jesi li donio nešto što možemo dodati našoj zbirci?",
      "dialogue": {
        "3adab6c55cfd0176d70c": "Jesi li donio nešto što možemo dodati našoj zbirci?",
        "5c385b5a85f5b56437bb": "Hvala ti, $N. Zahvaljujući tvom trudu naše se znanje širi.\n\nAko otkriješ još čarobnih djela koja bi koristila knjižnici, molim te da mi ih doneseš.",
        "a4b2212b8d39e6a26eb4": "Hvala ti, $N. Zahvaljujući tvom trudu naše znanje raste.\n\nAko pronađeš još čarobnih djela koja bi mogla koristiti knjižnici, donesi mi ih.",
        "e4df7e5e8850fd25b3de": "Jesi li donio nešto što možemo dodati našoj zbirci?"
      },
      "summary": "Jesi li donio nešto što možemo dodati našoj zbirci?",
