    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "3adab6c55cfd0176d70c": "Har du bragt noget til vores samling?",
        "5c385b5a85f5b56437bb": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kan gavne biblioteket, så bring dem til mig.",
        "a4b2212b8d39e6a26eb4": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kunne gavne biblioteket, så bring dem til mig.",
        "e4df7e5e8850fd25b3de": "Har du bragt noget til vores samling?"
      },
      "summary": "Har du bragt noget til vores samling?",
