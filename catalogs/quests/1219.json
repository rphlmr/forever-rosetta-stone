  "locales": {
    "csCZ": {
      "description": "Při prohrabávání kypré hlíny se najde useknutá ruka orka. A v ruce je sevřená trubice vyřezaná z kosti. A v trubici je zašpiněný pergamen.\n\nPergamen je psaný orkštinou... a vypadá důležitě.",
      "dialogue": {
        "4cd248a0753e77e39e56": "Máš pro mě hlášení?",
        "a41fb23d2673bc90858a": "Hm... orčtinu moc dobře nečtu, ale tohle vypadá jako hlášení... napsané orčím špehem!",
        "b1d8e4984495b4eedc5c": "Hm... orčtinu moc dobře nečtu, ale tohle vypadá jako hlášení... napsané orčím špehem!",
        "f5ac280d9a9eb950366f": "Máš pro mě hlášení?"
      },
      "summary": "Dones Spy's Report theramorskému poručíkovi.",
      "title": "Zpráva o orcích",
      "translationMetadata": {
