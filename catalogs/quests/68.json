  "locales": {
    "csCZ": {
      "description": "Ve staré truhle najdeš zaprášený neodeslaný dopis.",
      "dialogue": {
        "44e7835b96d070d871c9": "Zajímavé. Takže ten chlapík přece jen nějakou dobu v Moonbrooku pobýval. Je zvláštní, že dopis nebyl nikdy doručen. Každopádně doplním záznam v rejstříku.",
        "97763728436bbf957a19": "Ach, pamatuji si tě. Ty ses ptal na toho Stalvana. Našel jsi nakonec, co jsi hledal?"
      },
      "summary": "Dones Dusty Unsent Letter písaři Daltrymu.",
      "title": "Legenda o Stalvanovi",
