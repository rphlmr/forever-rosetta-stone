    "csCZ": {
      "description": "Rád tě zase vidím, {name}. Četl jsem poznámky od tebe a mluvil o tom s Onkuem, naším nejstarším věštcem.\n\nNedávno se mu dostalo vidění, které nás možná dovede k draenethyst sphere. Rádi bychom se s tebou o jeho zjevení podělili, pokud se k nám na chvíli přidáš.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "Sleduj s Magtoorem Onkuovu vizi",
          "type": "event"
        }
      ],
      "summary": "Sleduj s Magtoorem Onkuovo vidění.",
      "title": "Vidiny někoho jiného",
