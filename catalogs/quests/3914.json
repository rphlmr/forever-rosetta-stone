  "locales": {
    "csCZ": {
      "description": "Po silném záblesku světla můžeš meč znovu zvednout. Byl proměněn!",
      "dialogue": {
        "3285dbabe29970375cb4": "Můj meč... Je hotový!$B$BTeď si jen vzpomenout, proč jsem ho potřeboval...$B$BTady, aspoň ti za práci zaplatím.",
        "920f9a78dda0da522823": "Ach! Pamatuji si tě! Ty jsi... Ne, neříkej mi to!"
      },
      "summary": "Doruč Linken's Superior Sword Linkenovi do Un'Goro Crater.",
      "title": "Linkenův meč",
