    "enUS": {
      "description": "After a strong flash of light, you are able to pick up the sword again. It has been transformed!",
      "dialogue": {
        "3285dbabe29970375cb4": "My sword... It's finished!$B$BNow, if only I could remember why I needed this...$B$BHere, let me at least pay you for your work.",
        "920f9a78dda0da522823": "Oh! I remember you! You are... No, don't tell me!"
      },
      "summary": "Deliver Linken's Superior Sword to Linken in Un'Goro Crater.",
