    "enUS": {
      "description": "My warriors are eager to attack!  All I need are the assault orders...",
      "dialogue": {
        "02a3ee72ecdbb7c39b76": "My troops are supplied and ready to assault.  We just need orders from Frostwolf Quartermaster and I'll send them into the fray!",
        "032c052e141818b4d34c": "It's about time! Now we can show the Alliance their folly in coming to Alterac Valley!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Frostwolf Assault Orders",
          "type": "item"
