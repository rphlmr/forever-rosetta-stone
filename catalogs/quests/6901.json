    "daDK": {
      "description": "Mine krigere er ivrige efter at angribe! Alt, jeg behøver, er angrebsordrerne ...",
      "dialogue": {
        "02a3ee72ecdbb7c39b76": "Mine tropper er forsynet og klar til angreb. Vi mangler blot ordrer fra Frostwolfs forsyningsofficer, så sender jeg dem i kamp!",
        "032c052e141818b4d34c": "Det var også på tide! Nu kan vi vise Alliancen, hvor tåbeligt det var at komme til Alteracdalen!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Frostwolf-angrebsordrer",
          "type": "item"
        }
      ],
      "title": "Sæt angrebet ind!",
