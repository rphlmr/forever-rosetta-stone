  "locales": {
    "csCZ": {
      "description": "Mí bojovníci se nemohou dočkat útoku! Potřebuji už jen rozkazy k útoku...",
      "dialogue": {
        "02a3ee72ecdbb7c39b76": "Moji vojáci jsou zásobeni a připraveni k útoku. Potřebujeme jen rozkaz od proviantního důstojníka Frostwolfů a pošlu je do boje!",
        "032c052e141818b4d34c": "Už bylo načase! Teď můžeme Alianci ukázat, jakou hloupost udělala, když přišla do Alterackého údolí!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Útočné rozkazy Frostwolf",
          "type": "item"
        }
      ],
      "title": "Vyrazte do útoku!",
