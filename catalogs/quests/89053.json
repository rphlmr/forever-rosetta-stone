    "csCZ": {
      "description": "Vím, že původním účelem tvého vyslání sem byl průzkum, {name}, ale pro archeologii od tebe přišla velká pomoc.\n\nPo vší té námaze jistě chceš vědět, jaké ovoce mé studium přinese.\n\nProto bych ti chtěla něco ukázat, než se vrátíš do tábora. Vyhovíš mi?",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Podívej se, co ti chce Saria ukázat",
          "type": "monster"
        }
      ],
