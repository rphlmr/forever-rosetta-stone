  "locales": {
    "csCZ": {
      "description": "Tenhle murlok nepochybně už nějakou dobu terorizoval místní cesty. Tušíš, že strážní z nedaleké hlídky budou chtít vědět o jeho smrti.",
      "dialogue": {
        "110006b8f92bcc6512ad": "Minulý týden jsme kvůli murlokům přišli o dva členy hlídky, $c. Snad je teď, když je jejich vůdce mrtev, začneme vytlačovat z Elwynnského lesa.",
        "89197041db5b825feb90": "Ano?"
      },
      "summary": "Doruč Croaky's Head Merellu Rossovi do Ridgepoint Tower.",
      "title": "Croakyho hlava",
