  "locales": {
    "csCZ": {
      "description": "Syn našeho nejmocnějšího gryfa je pryč! Dědic Swiftwinga, Sharpbeak, se před pár dny ztratil při lovu s rodiči a věříme, že ho unesli trolové.\n\nMusíš nám pomoct! Prohledej klece v obou trolích vesnicích kmene Witherbark a zjisti, jestli tam Sharpbeak není.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Zkontroluj první klec",
          "type": "object"
        },
        {
          "index": 2,
          "text": "{current}/{required} Zkontroluj druhou klec",
          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Zkontroluj třetí klec",
          "type": "object"
        }
      ],
      "summary": "Zkontroluj klece ve dvou vesnicích kmene Witherbark a pak se vrať k mistrovi gryfů Talonaxovi.",
      "title": "Klece Witherbark",
