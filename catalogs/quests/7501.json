  "locales": {
    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "04029b502d7d91e802f1": "Získal jsi svazek!",
        "b290b01d626502921c9a": "Výborná práce, $R. Najdeš-li další svazky, neváhej nám je přinést.$B$BPostupem času odměny za navrácení ztracených svazků obměňujeme a přidáváme nové."
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Světlo a jak se s ním ohánět",
