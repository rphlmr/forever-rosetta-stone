    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "04029b502d7d91e802f1": "You have recovered a tome!",
        "b290b01d626502921c9a": "Excellent work, $R. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes."
      },
      "summary": "Return the book to its rightful owners.",
      "title": "The Light and How To Swing It",
