    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "04029b502d7d91e802f1": "Du har fundet et bind!",
        "b290b01d626502921c9a": "Fremragende arbejde, $R. Finder du flere bind, så tøv ikke med at bringe dem tilbage til os.$B$BMed tiden ændrer vi belønningerne for de savnede bind og tilføjer endda nye."
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
      "title": "Lyset og hvordan man svinger det",
