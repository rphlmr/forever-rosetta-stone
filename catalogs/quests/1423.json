  "locales": {
    "csCZ": {
      "description": "Tento sud je malý, ale pevný. Jeho švy jsou utěsněny žlutým, štiplavým voskem. Na dně sudu jsou vyražena slova:\n\nIntendant Lungertz\n\nPevnost Nethergarde",
      "dialogue": {
        "35670805e29f8562584b": "Máte pro mě něco?",
        "ee0321a2acd321786a0d": "Ach, děkuji, $N! Cestou z Darkshiru sem se ztratí tolik zásob. Je dobře, že se alespoň některé podařilo získat zpět."
      },
      "summary": "Přines Lost Supplies proviantnímu Lungertzovi.",
      "title": "Ztracené zásoby",
