    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "8dc18f93851201dddcf3": "You have recovered a tome!",
        "95ff582b96e40900f6ef": "Excellent work, $R. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes."
      },
      "summary": "Return the book to its rightful owners.",
      "title": "Harnessing Shadows",
