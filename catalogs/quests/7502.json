    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "8dc18f93851201dddcf3": "Du har fundet et bind!",
        "95ff582b96e40900f6ef": "Fremragende arbejde, $R. Finder du flere bind, så tøv ikke med at bringe dem tilbage til os.$B$BMed tiden ændrer vi belønningerne for de savnede bind og tilføjer endda nye."
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
      "title": "Tæmning af skygger",
