  "locales": {
    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "8dc18f93851201dddcf3": "Získal jsi svazek!",
        "95ff582b96e40900f6ef": "Výborná práce, $R. Najdeš-li další svazky, neváhej nám je přinést.$B$BPostupem času odměny za navrácení ztracených svazků obměňujeme a přidáváme nové."
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Krocení stínů",
