    "hrHR": {
      "description": "Evo je, {name}. Molim te, čuvaj moju knjigu.\n\nSada požuri. Sigurna sam da Troyas željno iščekuje tvoj povratak.",
      "dialogue": {
        "a45e85774b8c5b6e59e3": "Evo je, $N. Molim te, čuvaj moju knjigu.$B$BA sada požuri. Siguran sam da Troyas željno čeka tvoj povratak.",
        "b2b5f2dca293145c6b3f": "Donio si knjigu. Izvrsno!",
        "e121d220b2db11a15f71": "Pozdrav, $N. Jesi li bio u Darnassusu?"
      },
      "summary": "Dostavi knjigu Troyasu Moonbreezeu u Feathermoon Stronghold.",
