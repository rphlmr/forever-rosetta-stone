    "ptBR": {
      "description": "Aqui, {name}. Cuide bem do meu livro.\n\nVá, ande logo. Troyas deve estar ansioso pelo seu regresso.",
      "dialogue": {
        "a45e85774b8c5b6e59e3": "Aqui, $N. Cuide bem do meu livro.\n\nVá, ande logo. Troyas deve estar ansioso pelo seu regresso.",
        "b2b5f2dca293145c6b3f": "Você trouxe um livro. Excelente!",
        "e121d220b2db11a15f71": "Oi, $N. Você já esteve em Darnassus?"
      },
      "summary": "Leve o livro para Troyas Brisaluna no Domínio de Plumaluna.",
      "title": "O retorno a Troyas",
