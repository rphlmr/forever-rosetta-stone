  "locales": {
    "csCZ": {
      "description": "Tady je, {name}. Prosím, dej na mou knihu pozor.\n\nTak si pospěš. Jsem si jistá, že se Troyas už těší, až se vrátíš.",
      "dialogue": {
        "a45e85774b8c5b6e59e3": "Tady je, $N. Prosím, opatruj mou knihu.$B$BA teď pospěš. Jsem si jistý, že Troyas netrpělivě čeká na tvůj návrat.",
        "b2b5f2dca293145c6b3f": "Přinesl jsi knihu. Výborně!",
        "e121d220b2db11a15f71": "Zdravím, $N. Byl jsi v Darnassu?"
      },
      "summary": "Doruč knihu Troyasovi Moonbreezeovi do Feathermoon Stronghold.",
      "title": "Návrat k Troyasovi",
      "translationMetadata": {
        "fields": {
