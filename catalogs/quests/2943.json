    "ltLT": {
      "description": "Štai ji, {name}. Prašau, saugok mano knygą.\n\nO dabar skubėk. Esu tikras, kad Troyas nekantriai laukia tavęs grįžtant.",
      "dialogue": {
        "a45e85774b8c5b6e59e3": "Štai ji, $N. Prašau, saugok mano knygą.$B$BO dabar skubėk. Esu tikras, kad Troyas nekantriai laukia tavęs grįžtant.",
        "b2b5f2dca293145c6b3f": "Atnešei knygą. Puiku!",
        "e121d220b2db11a15f71": "Sveiki, $N. Ar buvai Darnassus?"
      },
      "summary": "Nunešk knygą Troyas Moonbreeze į Feathermoon tvirtovę.",
      "title": "Grįžimas pas Troyas",
