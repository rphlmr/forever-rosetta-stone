    "enUS": {
      "description": "Here it is, {name}. Please, take care of my book.\n\nNow, hurry along. I'm sure Troyas is eager for your return.",
      "dialogue": {
        "a45e85774b8c5b6e59e3": "Here it is, $N. Please, take care of my book.$B$BNow, hurry along. I'm sure Troyas is eager for your return.",
        "b2b5f2dca293145c6b3f": "You have brought a book along. Excellent!",
        "e121d220b2db11a15f71": "Hello, $N. Have you been to Darnassus?"
      },
      "summary": "Deliver the book to Troyas Moonbreeze in Feathermoon Stronghold.",
      "title": "Return to Troyas",
