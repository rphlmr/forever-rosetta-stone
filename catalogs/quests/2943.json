    "svSE": {
      "description": "Här är den, {name}. Ta väl hand om min bok.\n\nSkynda dig nu. Troyas väntar säkert ivrigt på din återkomst.",
      "dialogue": {
        "a45e85774b8c5b6e59e3": "Här är den, $N. Var rädd om min bok.$B$BSkynda dig nu. Jag är säker på att Troyas väntar ivrigt på din återkomst.",
        "b2b5f2dca293145c6b3f": "Du har tagit med en bok. Utmärkt!",
        "e121d220b2db11a15f71": "Hej, $N. Har du varit i Darnassus?"
      },
      "summary": "Leverera boken till Troyas Moonbreeze i Feathermoon Stronghold.",
