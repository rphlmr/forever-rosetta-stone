  "locales": {
    "csCZ": {
      "description": "Z těla poraženého plaza vytáhneš cosi, co vypadá jako důležitý vzkaz: dopis od jeho nadřízeného, generála Drakkisatha, týkající se protokolu.\n\nInstinkt ti napovídá, že ho máš donést maršálu Maxwellovi.",
      "dialogue": {
        "87bf26487faefefb7fdd": "Co to tam máš, $N?",
        "b29d7e6133dc4db0d222": "Zápletka se zamotává..."
      },
      "summary": "Dones General Drakkisath's Command maršálu Maxwellovi do Burning Steppes.",
      "title": "Rozkaz generála Drakkisatha",
