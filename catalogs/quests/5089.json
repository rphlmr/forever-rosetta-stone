    "ltLT": {
      "description": "Ant nugalėto žalčio kūno aptinki, regis, svarbų raštelį: jo viršininko generolo Drakkisath laišką apie veiksmų tvarką.\n\nNuojauta tau kužda, kad turėtum nunešti jį maršalui Maxwell.",
      "dialogue": {
        "87bf26487faefefb7fdd": "Ką ten turi, $N?",
        "b29d7e6133dc4db0d222": "Reikalai darosi vis painesni..."
