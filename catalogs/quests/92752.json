    "csCZ": {
      "description": "A je to – bomba je připravena k akci! A teď opatrně s tím odpalovačem.",
      "dialogue": {
        "0a07586788e7b1e0ba8e": "Bylo tvé úsilí ve Stormwindu úspěšné?",
        "b7adaa346c3000c57501": "Jsem rád, že ses vrátil, $n.",
        "c369c7e7a2d42174242c": "A je to – bomba je připravená! S tou rozbuškou opatrně."
      },
      "summary": "Vrať se k Albě Fairmoon do Westfallu.",
      "title": "Výbušná konzultace",
