    "hrHR": {
      "description": "<Illaya ti se toplo osmjehne.>\r\n\r\nDrago mi je da si se vratio razgovarati sa mnom, dijete vjetrova. Znala sam od prvog trenutka kad si došao preda me da je u tebi snažan nebeski vid. Iznenađuje li te to? Čak i oni koji nisu obučeni kao šamani mogu posjedovati taj dar.\r\n\r\nDođi, razgovarajmo o zadaći Windshapera, prirodi naših borbi na Zephrasu i nevolji našeg naroda.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Poslušaj Illayu",
          "type": "monster"
