  "locales": {
    "csCZ": {
      "description": "{name}, bitva o Arathi Basin je bojem o suroviny a území. Klíčové body v oblasti musíme udržet a provozovat, abychom zásobovali naše síly tolik potřebnými surovinami a proviantem. Pověřuji tě útokem na body nejvzdálenější od naší základny v kotlině.\n\nZaútoč na farmu, důl, pilu a kovárnu, jakmile je ovládne nepřítel. Najdi nepřátelskou korouhev a strhni ji ze stožáru!\n\nAž tak učiníš u všech čtyř bodů, vrať se ke mně.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Útok na důl proveden",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Útok na pilu proveden",
          "type": "monster"
        },
        {
          "index": 3,
          "text": "{current}/{required} Útok na kovárnu proveden",
          "type": "monster"
        },
        {
          "index": 4,
          "text": "{current}/{required} Útok na farmu proveden",
          "type": "monster"
        }
      ],
      "summary": "Zaútoč na důl, pilu, kovárnu a farmu, pak se vrať k polnímu maršálovi Oslightovi do Refuge Pointe.",
      "title": "Bitva o Arathi Basin!",
