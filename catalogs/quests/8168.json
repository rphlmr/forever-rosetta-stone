    "enUS": {
      "description": "{name}, the battle for Arathi Basin is a battle for resources and territory.  Key points in the area must be held and operated in order to supply our forces with much needed raw materials and supplies.  I charge you to assault the points farthest from our Arathi Basin base.\n\nAssault the farm, the mine, the lumber mill and the blacksmith when they are controlled by the enemy.  Find the enemy's banner and rip it from its flag post!\n\nWhen you have done this to all four points, return to me.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Mine Assaulted",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Lumber Mill Assaulted",
          "type": "monster"
        },
        {
          "index": 3,
          "text": "{current}/{required} Blacksmith Assaulted",
          "type": "monster"
        },
        {
          "index": 4,
          "text": "{current}/{required} Farm Assaulted",
          "type": "monster"
        }
      ],
      "summary": "Assault the mine, the lumber mill, the blacksmith and the farm, then return to Field Marshal Oslight in Refuge Pointe.",
      "title": "The Battle for Arathi Basin!",
