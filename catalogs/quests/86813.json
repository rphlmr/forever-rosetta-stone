  "locales": {
    "csCZ": {
      "description": "Musím říct, {class}, že už dlouho jsem se necítila tak optimisticky. Tato tinktura by mohla být všelékem, který nás zachrání před stále se rozšiřující satyrskou nákazou. I kdybychom v těchto táborech zůstali do konce života, budeme stát pevně a bez zkaženosti.\n\nJdi za Furzem a dej mu tento všelék. Trpěl už dost dlouho. Vrať se ke mně a ohlas vše, co zjistíš.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Všelék podán",
          "type": "monster"
        }
      ],
      "summary": "Podej Bramblesnap's Panacea Furzeovi.",
      "title": "Možný všelék",
