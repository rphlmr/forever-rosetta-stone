  "locales": {
    "csCZ": {
      "description": "Už jsi zpátky, {name}? Jestli máš dalších pět měchů vody Wastewander, pak tu na tebe čeká balíček zásob přímo se tvým jménem!",
      "dialogue": {
        "0bec7ac22d70d4aaa68d": "Výborně! Čím víc měchů s vodou získáme zpět, tím dál budeme od pohromy! Jen je nos dál a za každých pět tě odměním.",
        "909d45e4471ca716dd08": "Zase zpátky, $n? Jestli máš dalších pět měchů s vodou od Pustinářů, mám pro tebe balíček pomoci!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Váček na vodu Wastewander",
          "type": "item"
        }
      ],
      "summary": "Už jsi zase tady, {name}? Pokud máš dalších pět měchů na vodu Wastewander, mám pro tebe připravený balíček zásob!",
      "title": "Odměna za vaky s vodou",
