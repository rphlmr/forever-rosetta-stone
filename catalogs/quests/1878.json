    "daDK": {
      "description": "Tilbage igen, {name}? Hvis du har fem Wastewander-vandposer mere, har jeg en forsyningspakke med dit navn på!",
      "dialogue": {
        "0bec7ac22d70d4aaa68d": "Fremragende! Jo flere vandposer vi får tilbage, desto længere kommer vi fra katastrofen! Bliv ved med at bringe dem, så belønner jeg dig for hver femte.",
        "909d45e4471ca716dd08": "Tilbage igen, $n? Hvis du har fem vandposer mere fra Wastewander, har jeg en forsyningspakke til dig!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Wastewander-vandpose",
          "type": "item"
        }
      ],
      "summary": "Tilbage igen, {name}? Hvis du har fem Wastewander-vandposer mere, har jeg en forsyningspakke med dit navn på!",
      "title": "Dusør for vandposer",
