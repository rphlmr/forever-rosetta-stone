  "locales": {
    "csCZ": {
      "description": "Když zvedneš ten zašpiněný svitek, všimneš si, že na něm je zřejmě vyobrazeno nějaké setkání nebo obřad. Rok Orhan by o ten svitek jevila zájem, i o to, co by mohl pro Gordunni znamenat.",
      "dialogue": {
        "1f6652cf8eca7d953e2c": "Co je to?",
        "5c31fa2001f8114fc30c": "Tenhle svitek... Našel jsi ho na základně Gordunni? "
      },
      "summary": "Dones Gordunni Scroll Rok Orhan do Camp Mojache.",
      "title": "Svitek Gordunni",
