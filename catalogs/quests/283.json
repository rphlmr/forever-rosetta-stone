  "locales": {
    "csCZ": {
      "description": "Soudek lehce zašumí.",
      "dialogue": {
        "8fdf3b2daa201884a936": "Moc ti děkuji, $N!! Zachránil jsi přehradu Stonewrought! Bez tvé pomoci by ji teroristé z kmene Dark Iron jistě zničili. Království i Aliance jsou na tebe hrdé, statečný $C.$b$bPřehrada je opět v bezpečí... alespoň prozatím..."
      },
      "summary": "Zdá se, že Disarming Mixture zafungovala. Vrať se k vrchnímu inženýru Hinderweirovi a oznam mu dobrou zprávu.",
      "title": "Blíží se temná hrozba",
