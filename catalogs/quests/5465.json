    "hrHR": {
      "description": "Vrati se Mardukeu s uspomenom, {name}. On će ti objasniti kako je koristiti.",
      "dialogue": {
        "4b6d01848e17778fdec6": "Bio sam siguran da ćeš mi se pridružiti kao još jedan nesretni duh.",
