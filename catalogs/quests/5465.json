  "locales": {
    "csCZ": {
      "description": "Vrať se s tou památkou k Mardukovi, {name}. Poučí tě, jak ji použít.",
      "dialogue": {
        "4b6d01848e17778fdec6": "Byl jsem si jistý, že se ke mně připojíš jako další nešťastný duch.",
        "a8479ee88e6b5dab2aca": "Vrať se s památkou k Mardukovi, $N. Vysvětlí ti, jak ji použít.",
        "d9a8fe85a2715c83bca7": "Dokázal jsi nemožné?"
      },
      "summary": "Vrať se k magistrátu Mardukovi do Caer Darrow. Ukaž mu Soulbound Keepsake.",
      "title": "Upomínka spoutaná s duší",
