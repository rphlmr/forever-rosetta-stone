    "enUS": {
      "description": "<Penned in faded ink, the note is requesting oa Heavy Quiver, along with information about delivery location and payment. At the bottom appears text denoting this writ is transferable.>",
      "dialogue": {
        "e4eb33f5c9492db42b67": "Need some work?"
      },
      "summary": "Acquire the items requested by the customer and deliver them to the location marked on your map. This writ must be in your possession to complete the transaction.",
