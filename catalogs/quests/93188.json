  "locales": {
    "csCZ": {
      "description": "Na frontě už máš dost práce za sebou. Zvládneme to sami.\n\nŘekni Orgrulovi, že je tvůj úkol splněný. Fronta Magramů je teď silnější a tábor vyhnanců máme v hledáčku jako další osadu, až se do boje zapojí další oddíl bojovníků.\n\nNo? Tak běž!",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{standing} / Ctěná pověst u kentaurů klanu Magram",
          "type": "reputation"
        }
      ],
      "summary": "Udrž si reputaci u klanu Magram a ohlas se u Orgrula poblíž severního vstupu do Valley of Bones.",
      "title": "Návrat k Orgrulovi",
