  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "2f286479bdf1841eeaf2": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "a3618b28b0de67e62e2e": "Děkuji, $N. Díky tvému úsilí se naše znalosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "c71081c70852e43c63d7": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
        "e815181f328ee1a3ed4f": "Přinášíš něco, co bychom mohli přidat do naší sbírky?"
      },
