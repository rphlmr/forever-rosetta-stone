    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "2f286479bdf1841eeaf2": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kunne gavne biblioteket, så bring dem til mig.",
        "a3618b28b0de67e62e2e": "Tak, $N. Din indsats udvider vores viden.\n\nHvis du finder flere magiske værker, som biblioteket kan have gavn af, så bring dem venligst til mig.",
        "c71081c70852e43c63d7": "Har du bragt noget til vores samling?",
        "e815181f328ee1a3ed4f": "Har du bragt noget til vores samling?"
      },
