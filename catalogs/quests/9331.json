    "enUS": {
      "description": "This flame, stolen from the heart of Ironforge itself, floods you with warmth. This raw power is foreign to you, but the Talespinner might know more...",
      "dialogue": {
        "25c49c3f5a3844e88a27": "You're practically glowing, $R. What do you have there?",
        "fb54c4e151a2c0eefdef": "This hearty flame must be from the halls of Ironforge; it's as stalwart as the dwarves themselves. A fine catch, $N. If I had the fires of the other cities... ah, but never mind. Here is your payment."
      },
      "summary": "Return the Flame of Ironforge to the Festival Talespinner.",
      "title": "Stealing Ironforge's Flame",
