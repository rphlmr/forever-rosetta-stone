  "locales": {
    "csCZ": {
      "description": "Mé jednotky mají zásoby a jsou připravené k útoku. Potřebujeme už jen rozkazy od Norega Stormpika a pošlu je do vřavy!",
      "dialogue": {
        "2a841c677b2c9ecb4c1f": "Ach, rozkazy! Mám zaútočit podle vlastního uvážení, a já říkám... teď!",
        "75bebc2c9ae14cdff3c0": "Moji vojáci mají zásoby a jsou připraveni zaútočit. Potřebujeme jen rozkazy od Norega Stormpika a pošlu je do boje!"
      },
      "objectiveLines": [
