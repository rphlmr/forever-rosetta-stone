    "daDK": {
      "description": "Landbrug er tørstigt arbejde, og jeg er altid på udkig efter forfriskende kildevand.\n\nHvis du har noget, vil jeg gerne bytte.",
      "dialogue": {
        "54503b07dce64d529b0e": "Landbrugsarbejde gør én tørstig, og jeg leder altid efter forfriskende kildevand.$B$BHvis du har noget, vil jeg gerne bytte.",
        "a0277e129fe230a6492c": "Tak, $N! Kom tilbage, hvis du vil bytte igen."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Forfriskende kildevand",
          "type": "item"
        }
      ],
      "summary": "Landbrug er tørstigt arbejde, og jeg er altid på udkig efter forfriskende kildevand.\n\nHvis du har noget, vil jeg gerne bytte.",
      "title": "Giv Gerard noget at drikke",
