    "enUS": {
      "description": "Farming is thirsty work, and I'm always looking for refreshing spring water.\n\nIf you have any, then I'm willing to make a trade.",
      "dialogue": {
        "54503b07dce64d529b0e": "Farming is thirsty work, and I'm always looking for refreshing spring water.$B$BIf you have any, then I'm willing to make a trade.",
        "a0277e129fe230a6492c": "Thanks, $N!  And come back if you want to trade again."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Refreshing Spring Water",
          "type": "item"
        }
      ],
      "summary": "Farming is thirsty work, and I'm always looking for refreshing spring water.\n\nIf you have any, then I'm willing to make a trade.",
