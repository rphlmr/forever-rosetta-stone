  "locales": {
    "csCZ": {
      "description": "Při práci na farmě pořádně vyschne v krku a já vždycky sháním osvěžující pramenitou vodu.\n\nPokud nějakou máš, rád s tebou něco vyměním.",
      "dialogue": {
        "54503b07dce64d529b0e": "Práce na poli vyvolává žízeň a já stále sháním osvěžující pramenitou vodu.$B$BJestli nějakou máš, rád ji vyměním.",
        "a0277e129fe230a6492c": "Díky, $N! A vrať se, jestli budeš chtít znovu obchodovat."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Osvěžující pramenitá voda",
          "type": "item"
        }
      ],
      "summary": "Při práci na farmě pořádně vyschne v krku a já vždycky sháním osvěžující pramenitou vodu.\n\nPokud nějakou máš, rád s tebou něco vyměním.",
      "title": "Dej Gerardovi napít",
