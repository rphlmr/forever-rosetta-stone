    "esES": {
      "description": "El trabajo en la granja es agotador, por eso intento siempre tener una buena reserva de agua de manantial que ayude a soportarlo.\n\nSi tienes algo de agua, podríamos hacer un intercambio.",
      "dialogue": {
        "54503b07dce64d529b0e": "El trabajo en la granja es agotador, por eso intento siempre tener una buena reserva de agua de manantial que ayude a soportarlo.\n\nSi tienes algo de agua, podríamos hacer un intercambio.",
        "a0277e129fe230a6492c": "¡Gracias, $N! Y vuelve si quieres hacer otro intercambio."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Agua de manantial refrescante: {current}/{required}",
          "type": "item"
        }
      ],
