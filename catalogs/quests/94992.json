  "locales": {
    "csCZ": {
      "description": "<Kůň k tobě skloní hlavu a pak ti strčí nos do podpaží. Kamkoli půjdeš, možná tě bude následovat.>",
      "dialogue": {
        "c9d424ced8942ae7aa4d": "Díky, žes zachránil mou Biscuit! Jsi opravdový přítel, $N.\n\nJe to hořkosladký pocit vědět, že bude nějakou dobu sama, ale snad brzy najdeme pár jejích druhů ze stáje.\n\nAž příště uvidíš starého Demara, řekni mu, že Wheelerův statek zase funguje!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Doprovoď ztraceného koně na Wheeler's Grange.",
          "type": "event"
        }
      ],
      "summary": "Odveď ztraceného koně zpátky do Wheeler's Grange.",
      "title": "Záchranný odchyt",
