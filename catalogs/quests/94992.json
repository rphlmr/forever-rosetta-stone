    "enUS": {
      "description": "<The horse bows its head in your direction then nudges its nose into your underarm. Wherever you go, it may follow.>",
      "dialogue": {
        "c9d424ced8942ae7aa4d": "Thanks for savin' my Biscuit! You're a real friend, $N.\n\nIt's bittersweet knowin' she'll be all alone for awhile, but hopefully we'll find a few of her stable-mates before long.\n\nNext time you see ol' Demar, let him know Wheeler's Grange is back in business!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Escort the lost horse to Wheeler's Grange.",
          "type": "event"
        }
      ],
      "summary": "Bring the lost horse back to Wheeler's Grange.",
