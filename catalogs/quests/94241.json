  "locales": {
    "csCZ": {
      "description": "<Vzkaz psaný vybledlým inkoustem žádá jeden kus Dark Leather Tunic a uvádí místo doručení a výši platby. Dole stojí poznámka, že tento přípis lze předat dál.>",
      "dialogue": {
        "60b09100765d07b646b3": "COŽE???"
      },
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Dark Leather Tunic",
