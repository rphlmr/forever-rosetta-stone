  "locales": {
    "csCZ": {
      "description": "Teď, {name}, lov se prohlubuje. Teď musíš porazit svou kořist a pak najít cestu k jejímu doupěti.\n\nLov sluneční raptory na jihu. Zabij je a sundej jim peří, které nosí. Peří polož na hnízda kosodrápů jihozápadně od Stagnant Oasis. Ukaž jejich bratrům, že se jich nebojíš!",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Navštiv modré hnízdo raptorů",
          "type": "object"
        },
        {
          "index": 2,
          "text": "{current}/{required} Navštiv žluté hnízdo raptorů",
          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Navštiv červené hnízdo raptorů",
          "type": "object"
        }
      ],
      "summary": "Zabíjej raptory druhu Sunscale a sbírej jejich pera. Použij peří na 3 hnízda Scytheclaw. Vrať se k Sergře Darkthorn do Crossroads.",
      "title": "Rozzuření kosodrápové",
