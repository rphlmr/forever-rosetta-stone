    "daDK": {
      "description": "Nu, {name}, bliver jagten dybere. Nu må du besejre dit bytte og derefter finde vej til dets hule.\n\nJag sunscale-raptorerne mod syd. Dræb dem og fjern de fjer, de bærer. Læg fjerene på scytheclaw-rederne sydvest for Stagnant Oasis. Vis deres artsfæller, at du ikke frygter dem!",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Besøg den blå raptor-rede",
          "type": "object"
        },
        {
          "index": 2,
          "text": "{current}/{required} Besøg den gule raptor-rede",
          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Besøg den røde raptor-rede",
          "type": "object"
        }
      ],
      "summary": "Dræb Sunscale-rovøgler, og saml deres fjer. Brug fjerene på de 3 Scytheclaw-reder. Vend tilbage til Sergra Darkthorn i Crossroads.",
      "title": "De vrede Scytheclaws",
