          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Visit Red Raptor Nest",
          "type": "object"
        }
      ],
      "summary": "Kill Sunscale raptors and collect their feathers. Use the feathers on the 3 Scytheclaw nests. Return to Sergra Darkthorn in the Crossroads.",
      "title": "The Angry Scytheclaws",
