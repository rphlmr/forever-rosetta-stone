  "locales": {
    "csCZ": {
      "description": "Zdravím! Vidím, že dnes je opravdu velký den: dnes sesynchronizuješ své biometrické údaje s protokolem rozpoznávání jezdce svého prvního mechanostridera! Díky tomuto protokolu tě strider odliší od ostatních možných jezdců.\n\nČeká tě tedy důležitá volba. Ty a tvůj strider spolu projdete celý svět, tak vybírej moudře! Neboj se, ať zvolíš kteréhokoli, bude to ta správná volba.\n\nJdi si mechanostridery prohlédnout a vrať se ke mně, až si vybereš.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Nenabarvený mechanický pštros",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Zelený mechanický pštros",
          "type": "monster"
        },
        {
          "index": 3,
          "text": "{current}/{required} Modrý mechanický pštros",
          "type": "monster"
        },
        {
          "index": 4,
          "text": "{current}/{required} Červený mechanický pštros",
          "type": "monster"
        }
      ],
      "summary": "Prohlédni si jezdecké mechanopštrosy a vyber si své první jezdecké zvíře.",
      "title": "Tvůj první mechanopštros",
