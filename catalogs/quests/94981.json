  "locales": {
    "csCZ": {
      "description": "Forma je dost hrubá, ale se správným materiálem podle ní možná dokážeme vyrobit klíč.\n\nBudu udržovat uhlíky rozžhavené, zatímco ty obstaráš potřebné součásti.",
      "dialogue": {
        "234eedaa026205a630d7": "Přesně to jsme potřebovali.",
        "c88f0040d52055a09749": "Shromáždili jste materiály?"
      },
      "objectiveLines": [
