  "locales": {
    "csCZ": {
      "description": "Staré pocity se vracejí. Vítané záchvěvy vítězství se rozléhají celou tvou bytostí. Před tebou leží monumentální hlava Nefariana, poznamenaná bitvou. Vrať ji svému vrchnímu lordovi, šampionská duše.",
      "dialogue": {
        "54904fdec27042ba99a8": "Nepředstavitelné!",
        "780673d4eed1404a2383": "Nemusím ti vysvětlovat význam toho, co jsi vykonal, $N. Tento den bude zapsán v letopisech dějin. Takové vítězství Aliance nezažila celé roky, pokud vůbec někdy!"
      },
      "summary": "Vrať Head of Nefarian vrchnímu lordovi Bolvaru Fordragonovi do Stormwindu.",
      "title": "Pán Blackrocku",
      "translationMetadata": {
        "fields": {
