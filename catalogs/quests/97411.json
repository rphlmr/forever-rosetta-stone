  "locales": {
    "csCZ": {
      "description": "Buď zdráv, {class}! Z tvého vystupování poznám, že už máš v tomhle světě hodně za sebou. Přesto bych se vsadil, že takový kus zbroje ještě neznáš.\n\nUdělej pro mě malou laskavost a rád ti ho vyměním za obyčejné nátepníky.\n\nPotřebuji pořádný vzorek jedu z pavouků a štírů žijících v Silithusu. Přines mi ho spolu s několika zlatými mincemi a výměnu provedu.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Vzorek jedu ze Silithusu",
          "type": "item"
        },
        {
          "index": 2,
          "text": "{current}/{required} náramky světelné kovárny",
          "type": "item"
        }
      ],
      "summary": "Získej 15× Silithus Venom Samples a 20 zlatých a přines je spolu s Lightforge Bracers Mokvarovi do Orgrimmaru.",
      "title": "Upřímný návrh",
