  "locales": {
    "csCZ": {
      "description": "Vítej, mon. Přines mi ty živly a pak si pokecáme.",
      "dialogue": {
        "0d3d747ba52f20b70654": "Kde jsou ty živly, mon?",
        "41030e1f5b842c8ee6c0": "Tohle jsou živly, které potřebuji. Teď si promluvíme.",
        "fe4cd9919cfd823e7591": "Vítej, mon. Přines mi ty živly a pak si pokecáme."
      },
      "summary": "Dones živly země, vzduchu, ohně a vody Bath'rahovi the Windwatcher.",
