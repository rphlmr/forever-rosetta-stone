    "ltLT": {
      "description": "Sveikas, bičiuli. Atnešk man stichijas, tada pasikalbėsim.",
      "dialogue": {
        "0d3d747ba52f20b70654": "Kur stichijos, bičiuli?",
        "41030e1f5b842c8ee6c0": "Šitų stichijų man ir reikia. Dabar galim pasikalbėti.",
        "fe4cd9919cfd823e7591": "Sveikas, bičiuli. Atnešk man stichijas, tada pasikalbėsim."
