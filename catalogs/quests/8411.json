    "daDK": {
      "description": "Velkommen, ven. Du bringer mig elementerne, og så taler vi sammen.",
      "dialogue": {
        "0d3d747ba52f20b70654": "Hvor er elementerne, ven?",
        "41030e1f5b842c8ee6c0": "Det er de elementer, jeg har brug for. Nu taler vi.",
        "fe4cd9919cfd823e7591": "Velkommen, ven. Du bringer mig elementerne, og så taler vi sammen."
      },
      "summary": "Bring elementerne jord, luft, ild og vand til Bath'rah the Windwatcher.",
      "title": "Beherskelse af elementerne",
