  "locales": {
    "csCZ": {
      "description": "Díky tobě a Omarionovi (ať odpočívá v pokoji) mohu nyní vyrobit Polar gloves. Stačí mi jen přinést materiály a zaplatit malý výrobní poplatek.",
      "dialogue": {
        "07570b2ee8a5f92cc2f5": "Přinesl jsi materiály?",
        "c5e353c129e1cd03b5cd": "Díky tobě a Omarionovi (ať odpočívá v pokoji) mohu nyní vyrobit Polar gloves. Stačí mi jen přinést materiály a zaplatit malý výrobní poplatek.",
        "e8cb133ec6ae4f003945": "Tady je tvá objednávka, $N. Dodána, jak jsem slíbil!"
      },
      "summary": "Řemeslník Wilhelm v Light's Hope Chapel v Eastern Plaguelands chce 5× Frozen Runes, 12× Enchanted Leather, 3× Essence of Water, 3× Cured Rugged Hides a 200 zlatých.",
      "title": "Rukavice Polar",
