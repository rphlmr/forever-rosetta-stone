  "locales": {
    "csCZ": {
      "description": "Musíme tu zlepšit obranu, ale nemáme dost prostředků na stavbu opevnění. Máme však všechny dary přírody.\n\nProhledej les, najdi trnité keře a přines mi jejich semena. Silou přírody si vlastní obranu vypěstujeme.",
      "dialogue": {
        "a6b6db6928fec4733f0c": "Bodnutí trnů je malá cena za budoucí bezpečí.",
        "aeec57a8f66d30040ae0": "Díky těmto semenům si teď můžeme vypěstovat silnější obranu."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Trnové semeno",
          "type": "item"
        }
      ],
      "summary": "Najdi v lesích na vrcholu Mount Hyjal trnová semena a přines je Tiale Whitemane.",
      "title": "Trn v tlapě",
