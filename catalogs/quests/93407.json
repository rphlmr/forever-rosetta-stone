    "enUS": {
      "description": "We need to improve our defenses here, and we lack the resources to construct fortifications. We do, however, have all of the bounty of nature.\r\n\r\nSearch the forest for thorn bushes and bring their seeds back to me. With the power of nature, we will grow our own defenses.",
      "dialogue": {
        "a6b6db6928fec4733f0c": "The sting of the thorns is a small price to pay now, so that we may assure our future security.",
        "aeec57a8f66d30040ae0": "Now, with these seeds, we can grow a stronger defense for us."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Thorn Seed",
          "type": "item"
        }
      ],
      "summary": "Find thorn seeds in the forests at the summit of Mount Hyjal and bring them back to Tiala Whitemane.",
      "title": "A Thorn in the Paw",
