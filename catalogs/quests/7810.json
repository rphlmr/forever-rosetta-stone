  "locales": {
    "csCZ": {
      "description": "Být mistrem arény musí obnášet víc než tohle! Možná to bude vědět pirát, který vede událost v Gurubashi!",
      "dialogue": {
        "be2e25865b16395f4896": "Arr, kamaráde! Jeden talisman nestačí, aby ses stal mistrem arény! Teď nastal čas skutečně prokázat svou odvahu.\n"
      },
      "summary": "Promluv si se Short John Mithrilem ve Stranglethorn Arena.",
      "title": "Mistr arény",
