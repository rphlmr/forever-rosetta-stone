  "locales": {
    "csCZ": {
      "description": "Jeden z dopisů na tomto stole je zašifrovaný a nerozluštitelný.",
      "dialogue": {
        "259092da272dfc386aca": "Ano, $gpane:paní;? Máte se mnou nějakou záležitost?",
        "6e4d99062790c1a84b59": "Co je to? Počkej chvíli... podívám se blíž.$B$B...$B$BHm, tento způsob šifrování jsem ještě nikdy neviděl, ale musím přiznat, že mé znalosti v této oblasti nejsou zdaleka úplné.",
        "869a58790447351df7eb": "Ano, $gpane:paní;? Máte se mnou nějakou záležitost?"
      },
      "summary": "Dones Encrypted Letter kronikáři Dibbsovi do Southshore.",
      "title": "Zašifrovaný dopis",
