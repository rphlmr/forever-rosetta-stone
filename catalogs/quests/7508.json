  "locales": {
    "csCZ": {
      "description": "Pokud se tohoto úkolu chceš ujmout, předlož Lydrosovi tupou čepel.",
      "dialogue": {
        "9f67240cd3299d53ba05": "Výborně, začněme...",
        "bdc47b966b238af5d337": "Pokud se ti podaří vstoupit do dračího doupěte, rozehřát čepel v jejím ohnivém dechu a nakonec ji zakalit v její krvi, připravím ji pro tebe k použití."
      },
      "summary": "Předej Dull and Flat Elven Blade strážci vědění Lydrosovi.",
      "title": "Kování Quel'Serraru",
