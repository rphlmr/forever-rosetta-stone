  "locales": {
    "csCZ": {
      "description": "<Obnošený znak zobrazující znamení Lordaeronu. Po pádu království zbylo tak málo relikvií, že by o něj někdo v Undercity měl velký zájem.>",
      "dialogue": {
        "d6d709d559447c8d0215": "Copak to tam máš, $c? Nějaké chutné sousto?"
      },
      "summary": "Dones Crest of Lordaeron Oranu Snakewritheovi do Undercity.",
      "title": "Znak Lordaeronu",
