  "locales": {
    "csCZ": {
      "description": "Quel'Danil Lodge je komunikačním centrem vysokých elfů z Hinterlands. Jejich velvyslanci usilují o navázání vztahů s ostatními rasami, jimž předávají své poznatky o trolech z kmene Witherbark, kteří obývají jižní část Hinterlands. Všechny dokumenty týkající se té komunikace jsou uloženy v Quel'Danil Lodge.\n\nNepotřebujeme, aby vysocí elfové z Highvale budovali spojenectví s ostatními, {name}.\n\nZnič dokumenty Highvale. Musíme spálit jejich komunikační linky... doslova.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Spal záznamy Highvale",
          "type": "object"
        },
        {
          "index": 2,
          "text": "{current}/{required} Spal poznámky Highvale",
          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Spal hlášení Highvale",
          "type": "object"
        }
      ],
      "summary": "Oran Snakewrithe v Undercity chce, abys odcestoval do Hinterlands a spálil záznamy Highvale, hlášení Highvale a poznámky Highvale.",
      "title": "Spojovací linie",
