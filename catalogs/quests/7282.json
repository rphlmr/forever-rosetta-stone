    "csCZ": {
      "description": "Musí být zbaven trápení, bojovná duše! Neví, co činí. Stal se bezduchým služebníkem obávané Královny banshee.\n\nVydej se přes Field of Strife do hlubin území klanu Frostwolf. Najdi mého bratra a znič ho. Jeho utrpení musí skončit.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Velitel Louis Philips",
          "type": "monster"
        }
      ],
      "summary": "Vydej se na území Frostwolf a zabij velitele Louise Philipse. Jakmile úkol splníš, vrať se k veliteli Karlu Philipsovi.",
