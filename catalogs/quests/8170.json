  "locales": {
    "csCZ": {
      "description": "Jak jistě víš z doslechu, League of Arathor vysílá do kotliny Arathi Basin početné oddíly. Tito alianční hlupáci lační po jídle a zásobách a mají v úmyslu zabrat a ovládnout tamní bohaté zdroje. Musíme jim ukázat, že Arathi už nikdy nebude domovem pro lidi!\n\nJdi do Arathi Basin a zaútoč na důl, pilu, kovárnu a stáje. Strhni nepřátelské korouhve a prohlas tato území za majetek Hordy.\n\nJdi, {name}. Hlas se u mě, až bude tento úkol splněn.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Útok na důl proveden",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Útok na pilu proveden",
          "type": "monster"
        },
        {
          "index": 3,
          "text": "{current}/{required} Útok na kovárnu proveden",
          "type": "monster"
        },
        {
          "index": 4,
          "text": "{current}/{required} Útok na stáje proveden",
          "type": "monster"
        }
      ],
      "summary": "Zaútoč na důl, pilu, kovárnu a stáje v Arathi Basin a pak se vrať k Deathmaster Dwire do Hammerfall.",
      "title": "Bitva o Arathi Basin!",
