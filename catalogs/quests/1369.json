  "locales": {
    "csCZ": {
      "description": "Gelkisové si myslí, že naše kentaurská matka Theradras nás chrání. Jsou hloupí. Nikdo kentaury nechrání. Magramové ochranu nepotřebují! Jsme nejsilnější!\n\nUkaž Gelkisům, že jsou hloupí. Jdi do jeskyně v jejich vesnici. V té jeskyni schraňují krystaly, slzy Theradras. Rozbij slzy a přines mi střepy!",
      "objectiveLines": [
        {
          "index": 2,
          "text": "{standing} / Přátelský: Kentaur klanu Magram",
          "type": "reputation"
        }
      ],
