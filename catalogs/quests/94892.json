  "locales": {
    "csCZ": {
      "description": "Na mě je pozdě, cizinče. Z tohohle už se nedostanu. Odnes můj erb rytířskému veliteli. Varuj ho...\n\n<Ryanovy oči se začnou kalit a mumlá si pro sebe.>\n\nPromiň. Měl jsem se vrátit domů. Abigail...",
      "dialogue": {
        "1979ba0ebdc749d263ca": "Až do konce věrný své povinnosti. Děkuji, že jsi mi to přinesl, $c.",
        "de8ba1d9326bebd0e1c5": "Našel jsi maršála?"
      },
      "summary": "Vrať erb maršála Ryana rytíři veliteli Demarovi Brantovi do Farholde Keep.",
      "title": "Přání umírajícího",
      "translationMetadata": {
