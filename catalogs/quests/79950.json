    "hrHR": {
      "description": "Jesi li donio nešto što možemo dodati našoj zbirci?",
      "dialogue": {
        "84038cf9ceace50e88cb": "Jesi li donio nešto za našu zbirku?",
        "a4ab230b027756ecaa4b": "Hvala ti, $N. Zahvaljujući tvom trudu naše znanje raste.\n\nAko pronađeš još magičnih djela koja bi mogla koristiti knjižnici, molim te donesi mi ih.",
        "ad47411e66a261b3350c": "Hvala ti, $N. Zahvaljujući tvom trudu naše se znanje širi.\n\nAko otkriješ još magičnih djela koja bi mogla koristiti knjižnici, molim te donesi mi ih.",
        "cdc9f5c160d2e51802d9": "Jesi li donio nešto za našu zbirku?"
      },
      "summary": "Jesi li donio nešto što možemo dodati našoj zbirci?",
