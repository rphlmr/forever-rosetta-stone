    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "84038cf9ceace50e88cb": "Har du medbragt noget til vores samling?",
        "a4ab230b027756ecaa4b": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som biblioteket kunne have gavn af, så bring dem venligst til mig.",
        "ad47411e66a261b3350c": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kan gavne biblioteket, så bring dem til mig.",
        "cdc9f5c160d2e51802d9": "Har du medbragt noget til vores samling?"
      },
      "summary": "Har du bragt noget til vores samling?",
