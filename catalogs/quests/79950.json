    "deDE": {
      "description": "Habt Ihr einen Neuzugang für unsere Sammlung mitgebracht?",
      "dialogue": {
        "84038cf9ceace50e88cb": "Habt Ihr einen Neuzugang für unsere Sammlung mitgebracht?",
        "a4ab230b027756ecaa4b": "Danke, $N. Dank Eurer Bemühungen wächst unser Wissen.\n\nSolltet Ihr weitere magische Werke entdecken, die für die Bibliothek von Nutzen sein könnten, bringt sie mir bitte.",
        "ad47411e66a261b3350c": "Danke, $N. Durch Eure Bemühungen wächst unser Wissen.\n\nSolltet Ihr weitere magische Werke entdecken, die für die Bibliothek von Nutzen sein könnten, bringt sie bitte zu mir.",
        "cdc9f5c160d2e51802d9": "Habt Ihr einen Neuzugang für unsere Sammlung mitgebracht?"
      },
      "summary": "Habt Ihr einen Neuzugang für unsere Sammlung mitgebracht?",
