  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "84038cf9ceace50e88cb": "Přinesl jsi něco do naší sbírky?",
        "a4ab230b027756ecaa4b": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "ad47411e66a261b3350c": "Děkuji ti, $N. Díky tvému úsilí se naše znalosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je, prosím.",
        "cdc9f5c160d2e51802d9": "Přinesl jsi něco, co bychom mohli přidat do naší sbírky?"
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
