  "locales": {
    "csCZ": {
      "description": "Říká se, že štít drakobijce drží orkský válečník v pohoří Redridge. Ukradl ho při nájezdu na lidskou osadu.",
      "dialogue": {
        "33f7198a56d6cab12815": "Skvělá práce, $N! Díky tomu jsem zase o krok blíž ke slávě."
      },
      "title": "Štít drakobijce",
