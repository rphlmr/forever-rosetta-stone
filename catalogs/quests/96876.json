  "locales": {
    "csCZ": {
      "description": "Na chlopni batohu je hrubě vyšité jméno „Ukor“.",
      "dialogue": {
        "b3a0838f06edecbcf08c": "Můj vak! Když jsem ho zahodil, abych utekl před tím obřím pavoukem, myslel jsem, že už ho nikdy neuvidím. Opravdu jsi hrdina!",
        "e95502008259916fd9a1": "Je třeba něco udělat?"
      },
      "summary": "Vrať batoh Ukorovi v jižním Durotaru.",
      "title": "Ukorova ztracená mošna",
