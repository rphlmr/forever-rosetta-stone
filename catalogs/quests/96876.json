    "hrHR": {
      "description": "Na preklopu torbe grubo je izvezeno ime \"Ukor\".",
      "dialogue": {
        "b3a0838f06edecbcf08c": "Moja torba! Kad sam je bacio da pobjegnem od onog golemog pauka, mislio sam da je više nikada neću vidjeti. Ti si zaista junak!",
        "e95502008259916fd9a1": "Treba li što obaviti?"
      },
      "summary": "Vrati torbu Ukoru u južnom Durotaru.",
      "title": "Ukorov izgubljeni zavežljaj",
