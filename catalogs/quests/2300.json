  "locales": {
    "csCZ": {
      "description": "Renzik tě hledal, zelenáči.\n\nBýt tebou, nenechávala bych Mathiasova zástupce čekat.",
      "dialogue": {
        "07ba920bf4587238f1ae": "Renzik tě hledal, nováčku.$B$BBýt tebou, nenechával bych Mathiasovu pravou ruku čekat.\n",
        "82d494c19729a6c8e79b": "Jsi připraven pustit se do práce, nebo si před začátkem potřebuješ zdřímnout?"
      },
      "summary": "Vydej se do Stormwindu a vyhledej Renzika „The Shiv“.",
