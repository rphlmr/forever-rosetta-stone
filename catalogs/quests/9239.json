  "locales": {
    "csCZ": {
      "description": "Díky tobě a Omarionovi, ať odpočívá v pokoji, mohu nyní vyrobit Glacial gloves. Stačí mi jen přinést materiály a zaplatit malý výrobní poplatek.",
      "dialogue": {
        "09a284783af8d0464aca": "Tady je tvá objednávka, $N. Dodáno, jak jsem slíbil!",
        "11fb6a3caa60ece1b4e0": "Díky tobě a Omarionovi, ať odpočívá v pokoji, mohu nyní vyrobit Glacial gloves. Stačí mi jen přinést materiály a zaplatit malý výrobní poplatek.",
        "420477449908bd57b76f": "Přinesl jsi materiály?"
      },
      "summary": "Řemeslník Wilhelm v Light's Hope Chapel v Eastern Plaguelands chce 5× Frozen Runes, 4× Bolts of Runecloth, 4× Essences of Water, 2× Ironweb Spider Silks a 200 zlatých.",
      "title": "Rukavice Glacial",
