  "locales": {
    "csCZ": {
      "description": "Když nejsme ve válce, lovíme maso. Maso nám dává sílu a plné břicho bojuje tvrději než prázdné.\n\nStejné je to u Magramů. Ukládají si maso navíc, aby mohli bojovat déle mezi lovy. Pokud přepadneš jejich vesnici na východě a vezmeš jejich zásoby masa, jejich síla selže.",
      "objectiveLines": [
        {
          "index": 2,
          "text": "{standing} / Přátelský: Kentaur klanu Gelkis",
          "type": "reputation"
        }
      ],
      "summary": "Přines 6× pytel Crudely Dried Meat Uthek the Wise do Gelkis Village.",
