  "locales": {
    "csCZ": {
      "description": "Strážci míru se mobilizují a všichni se chystáme vyrazit. Udělej všechny přípravy, které potřebuješ, a sejdi se s námi na východní cestě vedoucí ze města na sever. Než vyrazíme, ještě se naposledy všichni sejdeme.",
      "dialogue": {
        "2fa7c164417a0b109ed1": "Strážci míru se mobilizují a všichni se chystáme vyrazit. Udělej všechny přípravy, které potřebuješ, a sejdi se s námi na východní cestě vedoucí ze města na sever. Než vyrazíme, ještě se naposledy všichni sejdeme.",
        "5c2a9a91d601416a258d": "Jsme připraveni, jak nejlépe můžeme."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Najdi Valennii na cestě",
          "type": "monster"
        }
      ],
      "summary": "Promluv si s Valennií Stormfist v Gustberry Lowlands.",
      "title": "Příprava na bitvu",
