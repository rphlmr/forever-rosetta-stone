  "locales": {
    "csCZ": {
      "description": "Válka proti Hordě rychle vyčerpává naše zásoby, {name}. Musíme udržet Arathi Basin pod kontrolou, aby přísun zdrojů nepřestal! Už ses v Arathi zapojil do boje?",
      "dialogue": {
        "b91a0441c2fae88458fd": "Dobrá práce, vojáku! Jen tak dál a Horda bude utíkat až do Orgrimmaru.",
        "c4a345b8028cbae325eb": "Válka proti Hordě rychle vyčerpává naše zásoby, $n. Je životně důležité udržet kontrolu nad Arathijskou pánví, aby nepřestal proudit materiál! Pomohl jsi už v Arathi?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Odznak cti Arathijské pánve",
          "type": "item"
        }
      ],
      "summary": "Dones 3× Arathi Basin Marks of Honor k Alliance Brigadier General před bojišti.",
      "title": "Získání Arathi Basin",
