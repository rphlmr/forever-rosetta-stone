    "daDK": {
      "description": "Krigen mod Horden udtømmer hurtigt vores forsyninger, {name}. Det er afgørende at bevare kontrollen over Arathi Basin for at holde ressourcestrømmen i gang! Har du givet en hånd med i Arathi endnu?",
      "dialogue": {
        "b91a0441c2fae88458fd": "Godt arbejde, soldat! Fortsæt sådan, så får vi Horden til at flygte hele vejen tilbage til Orgrimmar.",
        "c4a345b8028cbae325eb": "Krigen mod Horden tærer hurtigt på vores forsyninger, $n. Det er afgørende at bevare kontrollen over Arathi Basin, så ressourcerne fortsat strømmer ind! Har du hjulpet til i Arathi endnu?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Arathi-bassinets ærestegn",
          "type": "item"
        }
      ],
      "summary": "Bring 3 Arathi Basin Marks of Honor til en Alliance Brigadier General uden for slagmarkerne.",
      "title": "Gør krav på Arathi Basin",
