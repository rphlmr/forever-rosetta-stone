  "locales": {
    "csCZ": {
      "description": "Odnes tento éterický drahokam mému starému druhovi Bethorovi. Umožní nám komunikovat... a mám mu mnoho co říct.",
      "dialogue": {
        "58f1f01548fe5696ba28": "Přesvědčil jsi ho, aby se k nám přidal! Pro Opuštěné jsi vykonal velký čin, $N. Temná paní bude informována.",
        "95d9f6430c388fe98675": "Odnes tento éterický drahokam mému starému druhovi Bethorovi. Umožní nám komunikovat... a mám mu mnoho co říct.",
        "97a427353eccbfad8c30": "Vrátil jsi Guntherovu knihu? Odpověděl ti?"
      },
      "summary": "Dones Nether Gem Bethoru Iceshardovi do Undercity.",
      "title": "Marnotratný lich se vrací",
