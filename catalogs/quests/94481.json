  "locales": {
    "csCZ": {
      "description": "Tenhle sytý guláš udrží naše cvičence najedené, a to natolik, že se nám nepřátelé drží od těla.\n\nVezmi ho a nakrm naše cvičence na západě. Neposlouchej žádné stížnosti. Když je teď tak těžké bránit naše zásobovací trasy, můžou být rádi, že je nekrmíme hlínou.",
      "dialogue": {
        "da40b5f40e0558b8fbdd": "Jestli mají další stížnosti, mohou mi je říct přímo.\n\nJsem ti vděčný za to, že jsi toto jídlo získal, a naši bojovníci také, ať říkají cokoli."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Učeň z Rog'mar nakrmen",
          "type": "monster"
        }
      ],
      "summary": "Nakrm na cvičišti 8× Rog'mar Trainees.",
      "title": "Porce síly",
