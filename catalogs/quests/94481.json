    "daDK": {
      "description": "Denne nærende gryderet holder vores rekrutter mætte, så vores fjender holder sig på afstand.\r\n\r\nTag den med og giv vores rekrutter mod vest mad. Lyt ikke til klager. Med hvor svært det er blevet at forsvare vores forsyningslinjer, burde de være heldige, at vi ikke fodrer dem med jord.",
      "dialogue": {
        "da40b5f40e0558b8fbdd": "Hvis de har flere klager, kan de komme direkte til mig med dem.\n\nJeg er taknemmelig for, at du skaffede maden, og det er vores krigere også, uanset hvad de siger."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Rog'mar Trainee fodret",
          "type": "monster"
        }
      ],
      "summary": "Giv 8 Rog'mar Trainees mad på træningspladsen.",
      "title": "En portion styrke",
