    "enUS": {
      "description": "Every year the druids of Moonglade hold a celebration of our city's great triumph over an ancient evil.\n\nWe celebrate the wisdom of our elders, share in magnificent feasts and of course... shoot fireworks!\n\nFor a small donation you can purchase colorful rockets from our vendor.  Try using some of the launchers around here, {name}.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Lunar Fireworks Fired",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Lunar Fireworks Cluster Fired",
          "type": "monster"
        }
      ],
      "summary": "Launch 8 Lunar Fireworks and 2 Cluster Fireworks and return to a Lunar Festival Harbinger at any capital city.",
