        {
          "index": 4,
          "text": "{current}/{required} Sort skelethest",
          "type": "monster"
        }
      ],
      "summary": "Undersøg de udøde rideheste for at vælge dit første ridedyr.",
      "title": "En ganger i døden som i livet",
