  "locales": {
    "csCZ": {
      "description": "Úředně vypadající svitek je pevně převázaný stříbřitou stuhou. Víš jistě, že by o něj měl někdo zájem, ale kdo?\n\nBlízko hranice Ashenvale na severu je základna, a pokud se informace na svitku týkají nočních elfů, bylo by to ono místo, kam ho odnést.",
      "dialogue": {
        "216da6a87c0f9ec58b0f": "Copak máš?",
        "cefe413b94d0e5bdec25": "No tedy... Kde jsi to našel?"
      },
      "summary": "Dones Runed Scroll do severní strážní věže v The Barrens.",
      "title": "Popsaný svitek",
