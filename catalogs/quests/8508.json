  "locales": {
    "csCZ": {
      "description": "Předpokládám, že chceš ty papíry podepsat, mladej?",
      "dialogue": {
        "127417291addc09d632c": "Předpokládám, že chceš ty papíry podepsat, $Gchlapče:děvče;?",
        "6bbec7f4fd76fc6dac52": "Ano, předpokládám, že tahle malá potyčka se dnes počítá jako služba v poli. Vezmi je zpátky do Cenarion Hold, určitě pro tebe budou mít připravenou pohodlnou práci.$B$BA teď běž!",
        "a166af036b46852531c7": "Předpokládám, že chceš ty papíry podepsat, $Gchlapče:děvče;?"
      },
      "summary": "Předpokládám, že chceš ty papíry podepsat, mladej?",
      "title": "Doklady služby v poli",
