  "locales": {
    "csCZ": {
      "description": "<Když tvor padá, odpadne mu hlava. Zdá se, že byla několikrát znovu připojena a spojení je s každým připojením slabší.\n\nNěkdo v Undercity by o tomto jedinečném hnusu věděl víc.>",
      "dialogue": {
        "d4fec1235dadb7277549": "Copak to tu máme?",
        "fb59edb287a4d4623c23": "Oho! Myslím, že tuhle hlavu znám. Krutý žert naší Temné paní. A velice lahodný.\n\nMyslím, že pro ni najdu využití."
      },
      "summary": "Doruč Abominable Head vrchnímu apatykáři Faranellovi do Undercity.",
      "title": "Nekonečné trýznění",
      "translationMetadata": {
