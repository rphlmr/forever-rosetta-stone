    "enUS": {
      "description": "<The ancient glyphs resolve into words before your eyes.>\r\n\r\nWhen Zul'Kunda's fountain runs with the waters of the holy spring, the gods grant their blessing.",
      "dialogue": {
        "047a51bf2f44f86cfe28": "A magic fountain hidden in the jungle? What a story, $N!\n\nThat gives me an idea for another chapter in my book! Let's see, where did I put that manuscript..."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Solve the riddle",
          "type": "spell"
