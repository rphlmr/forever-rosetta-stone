  "locales": {
    "csCZ": {
      "description": "<Prastaré glyfy se ti před očima skládají ve slova.>\n\nAž fontánou Zul'Kunda poteče voda ze svatého pramene, bohové udělí své požehnání.",
      "dialogue": {
        "047a51bf2f44f86cfe28": "Kouzelná fontána ukrytá v džungli? To je ale příběh, $N!\n\nTo mi vnuklo nápad na další kapitolu mé knihy! Jen se podívejme, kam jsem dal ten rukopis..."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Vyřeš hádanku",
          "type": "spell"
        }
      ],
      "summary": "Rozlušti hádanku svitku. Až to zvládneš, Hemet Nesingwary si ten příběh možná rád poslechne.",
      "title": "Trolí svitek",
