  "locales": {
    "csCZ": {
      "description": "Chtěl po tobě poručík Doren hlášení s těmi informacemi o hlídkách?",
      "dialogue": {
        "569008bc5a48957b5735": "Chtěl po tobě poručík Doren hlášení s těmi informacemi o hlídkách?",
        "76383def4cd714bf910f": "Bolí mě, když zjišťuji, že nás zradil Merle. Vždycky byl statečným vojákem a myslel jsem, že má věrné srdce. Je však velkou úlevou, že jsme ho odhalili. Se špehem, jako je on, mezi námi... bychom proti plukovníku Kurzenovi dlouho nevydrželi."
      },
      "summary": "Promluv si s poručíkem Dorenem.",
      "title": "Hlášení Dorenovi",
