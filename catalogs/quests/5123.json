  "locales": {
    "csCZ": {
      "description": "Tebou nalezený záznam od vrchního náčelníka vypadá rozsáhle, ale když projdeš pár stránek, zjistíš, že text nedokážeš přečíst. Značky jsou tak hrubé a špatně utvářené, že nevíš jistě, jestli by je vůbec někdo dokázal přečíst.\n\nAle možná ti Donova dokáže říct, co v něm stojí...",
      "dialogue": {
        "a1fcb71858c420e26426": "Co to všechno znamená... Nedokážu z toho nic rozluštit...",
        "ab1bcf4bf19f862087bb": "Tak copak to je, $N?"
      },
      "summary": "Přines Crudely-written Log Donově Snowden do Winterspringu.",
      "title": "Poslední dílek",
