    "hrHR": {
      "description": "Jesi li donio nešto što možemo dodati našoj zbirci?",
      "dialogue": {
        "a1604197dea888cd180e": "Hvala ti, $N. Zahvaljujući tvom trudu naše znanje raste.\n\nAko pronađeš još čarobnih djela koja bi mogla koristiti knjižnici, donesi mi ih.",
        "c6dae827c515d8242dcc": "Jesi li donio nešto za našu zbirku?",
        "ea7bdea5da4618c8bf62": "Hvala ti, $N. Zahvaljujući tvom trudu naše se znanje širi.\n\nAko otkriješ još čarobnih djela koja bi mogla koristiti knjižnici, molim te donesi mi ih.",
        "f155dfdeac67badeeb3e": "Jesi li donio nešto za našu zbirku?"
      },
      "summary": "Jesi li donio nešto što možemo dodati našoj zbirci?",
