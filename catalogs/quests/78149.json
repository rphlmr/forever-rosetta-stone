  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "a1604197dea888cd180e": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "c6dae827c515d8242dcc": "Přinesl jsi něco do naší sbírky?",
        "ea7bdea5da4618c8bf62": "Děkuji, $N. Díky tvému úsilí se naše znalosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím.",
        "f155dfdeac67badeeb3e": "Přinášíš něco do naší sbírky?"
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
