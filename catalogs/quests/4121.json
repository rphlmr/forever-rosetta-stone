  "locales": {
    "csCZ": {
      "description": "Opravdu věříš, že se mnou jako zajatcem dorazíš na místo schůzky? Skutečně očekáváš, že vtrhneš do silně opevněné pevnosti Blackrocku, uneseš jejich cenný klenot a na svou přítomnost přitom nikoho ani nic neupozorníš?\n\nČeká tě zkáza!",
      "eventObjectiveLabel": "Převoz vězně",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Thoriová pouta",
          "type": "item"
        },
        {
          "index": 2,
          "text": "Přeprava vězně",
          "type": "event"
        }
      ],
      "summary": "Doprovoď svého vězně, Grarka Lorkruba, přes Burning Steppes a Blackrock Mountain do Searing Gorge.\n\nVzpomínáš si, že Lexlort zmiňoval, že jeho muži budou čekat na druhé straně, aby Grarka převzali do vazby.\n\nBudeš také muset odevzdat své Thorium Shackles Lexlortovi.",
      "title": "Ošemetná situace",
