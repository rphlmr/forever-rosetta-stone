  "locales": {
    "csCZ": {
      "description": "Přilba drakobijce kdysi patřila velkému veliteli, který padl v bitvě. Říká se, že jeho trýzněná duše dodnes straší v pevnosti Shadowfang.",
      "dialogue": {
        "b2e26d65424880d52a89": "Skvělá práce, $N! Díky tomu jsem zase o krok blíž ke slávě."
      },
      "title": "Přilba drakobijce",
