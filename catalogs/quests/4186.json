    "csCZ": {
      "description": "Uděluji ti pravomoc jednat v zastoupení Stormwindu, {name}.\n\nVrať se k soudci Solomonovi do Lakeshire a doruč mu tento výnos.",
      "dialogue": {
        "b47fcc4906efd620be65": "Nějaké zprávy od Bolvara?",
