  "locales": {
    "csCZ": {
      "description": "Brigáda Ironforge podala neobvyklou žádost o vysoce... výbušné... součástky. Shromáždi je a přines je panu Nozzlespringovi z Brigády Ironforge.",
      "dialogue": {
        "ab5e4625ee978c3caf09": "Ach, ano! Ty se budou hodit! Mnohokrát děkuji, $N!",
        "c8ebdb271d82ceeedb26": "Máš pro mě něco, $N?"
      },
      "summary": "Dones 6× Oils of Immolation, 5× Goblin Rocket Fuel a 10× Dense Blasting Powder arkanistovi Nozzlespringovi poblíž Hive'Zora v Silithusu. K dokončení tohoto úkolu musíš také přinést Logistics Task Briefing IV.",
      "title": "Brigáda Ironforge potřebuje výbušniny!",
