  "locales": {
    "csCZ": {
      "description": "Aura arkánní energie, která tě obklopuje, je silná, i když za sebou nemáš zasvěcení do řad mágů. Jsem si zcela jistý, že si při dobrodružstvích povedeš zdatně, a tvé spojení s naší prastarou magií ti bude vždy jen ku prospěchu, i kdyby ti při sesílání kouzel nikdy nevyšlo z úst jediné slovo moci.\n\nPojď, posaďme se a promluvme si o mém řádu, o povaze arkánní magie tady na Zephrasu a o strastech našeho lidu.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Vyslechni Rathirila Sunlance",
          "type": "monster"
        }
      ],
      "summary": "Posaď se a promluv si s Rathirilem Sunlancem.",
      "title": "High Order",
