  "locales": {
    "csCZ": {
      "description": "Vypadá to, že ubohý Starý Rustlocke narazil na přepadení Dark Iron. Všimneš si pergamenu vedle jeho zaťaté pěsti.\n\nOznam ponurou zprávu Rhagu Garmasonovi a ukaž mu svůj nález.",
      "dialogue": {
        "ada5d8ccb252c4ee75ea": "Ach ne, to jsou vážné zprávy...",
        "f078fa7579657534cfe4": "Nějaká stopa po starém Rustlockovi, $n?"
      },
      "summary": "Vrať se k Rhagu Garmasonovi s hlášením a ukaž mu pergamen, který jsi našel na Rustlockově těle.",
      "title": "Most Thandol Span",
