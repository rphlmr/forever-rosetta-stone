  "locales": {
    "csCZ": {
      "description": "Neměj obavy, {name}, neposílám tě za Syurnou. Erion si žádá tvou přítomnost v Cenarion Enclave. Pospěš si!",
      "dialogue": {
        "25417e82843f07f0090d": "Neboj se, $N, neposílám tě za Syurnou. Erion tě potřebuje v Cenarionské enklávě. Pospěš si!",
        "db42c67ea143aacc832d": "Je čas vydat se dál, $R. Svět čeká."
      },
