  "locales": {
    "csCZ": {
      "description": "Po vyzvednutí jediného ingotu Lightforge z promočené truhly je jasné, že zbytek ukradli murlokové. Pobíjej murločí nájezdníky u vraku lodi Flying Osprey a hledej ztracené železo Lightforge.",
      "dialogue": {
        "085f2bce0ed9b1ca4832": "Našel jsi potřebné světlotavné železo?",
        "9dcc6eb9fd7a33ed49da": "Ach, našel jsi je! Teď z toho světlotavného železa vykováme něco užitečného, co říkáš?"
      },
      "summary": "Nasbírej 5× Lightforge Ingots a pak se vrať ke Glorinu Steelbrowovi do Wetlands.",
      "title": "Ztracené ingoty",
