  "locales": {
    "csCZ": {
      "description": "Boj na Darkspear Islands pokračuje, {name}. Tvé další úsilí nám pomůže vyhnat Theramore Expeditionary Force!",
      "dialogue": {
        "47c43701c92a64c4034d": "Boj na ostrovech Darkspear pokračuje, $N. Tvé další úsilí nám pomůže zahnat expediční síly Theramoru!",
        "fd2cd6663ed15ee17e07": "Dobrá práce, $c! Pomohl jsi Hordě získat kontrolu nad ostrovy Darkspear!"
      },
      "objectiveLines": [
