  "locales": {
    "csCZ": {
      "description": "Tady je fialový prášek, {name}. Zanes ho Marinovi a řekni mu, že mi dluží laskavost!",
      "dialogue": {
        "6e96d1ddd5b7b300f9cc": "Tady je Violet Powder, $N. Odnes ho Marinovi a vyřiď mu, že mi dluží laskavost!",
        "7230759607cb7b6c5678": "Ach, $N, konečně jsi zpět. Co jsi přinesl?",
        "d026b09ebbfe0cab852b": "Violet Powder, říkáš? Zkusme to, horší už to určitě být nemůže!"
      },
      "summary": "Sprinkle chce, abys odnesl fialový prášek Marinu Noggenfoggerovi do Gadgetzanu.",
      "title": "Zásilka pro Marina",
