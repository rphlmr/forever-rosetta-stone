    "plPL": {
      "description": "Oto fioletowy proszek, {name}. Zanieś go Marinowi i powiedz, że jest mi winien przysługę!",
      "dialogue": {
        "6e96d1ddd5b7b300f9cc": "Oto Violet Powder, $N. Zanieś go Marinowi i powiedz, że jest mi winien przysługę!",
        "7230759607cb7b6c5678": "Och, $N, wreszcie wracasz. Co przynosisz?",
        "d026b09ebbfe0cab852b": "Violet Powder, tak? Spróbujmy, przecież gorzej już być nie może!"
      },
      "summary": "Sprinkle chce, by zanieść fioletowy proszek Marinowi Noggenfoggerowi w Gadgetzan.",
      "title": "Dostawa dla Marina",
      "translationMetadata": {
        "fields": {
          "description": {
