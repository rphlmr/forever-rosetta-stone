    "daDK": {
      "description": "Her er Violet Powder, {name}. Tag det med til Marin og fortæl ham, at han skylder mig en tjeneste!",
      "dialogue": {
        "6e96d1ddd5b7b300f9cc": "Her er Violet Powder, $N. Tag det med til Marin og sig, at han skylder mig en tjeneste!",
        "7230759607cb7b6c5678": "Åh, $N, du er endelig tilbage. Hvad har du med?",
        "d026b09ebbfe0cab852b": "Violet Powder, hva'? Lad os prøve det, det kan i hvert fald ikke gøre det værre!"
      },
      "summary": "Sprinkle vil have dig til at tage Violet Powder med til Marin Noggenfogger i Gadgetzan.",
      "title": "Levering til Marin",
