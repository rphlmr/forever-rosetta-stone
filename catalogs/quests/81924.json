{
  "locales": {
    "csCZ": {
      "description": "Ať hledáš jakékoli znalosti kaldorei, mezi těmito ruinami je nenajdeš, {class}. Už ne.\n\nPřestože to hmotné leží v troskách, duchovní přetrvává.\n\nVyhledej strážné duchy Azshary, Hinterlands a Feralasu. Poznáš je podle svatyní. Prokaž jim svou hodnotu a naslouchej jejich slovům. Jejich moudrost přejde na tebe, aby nebyla ztracena v čase jako tolik věcí tady.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Strážce Feralasu",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Strážce Hinterlands",
          "type": "monster"
        },
        {
          "index": 3,
          "text": "{current}/{required} Strážce Azshary",
          "type": "monster"
        }
      ],
      "summary": "Prokaž se před strážnými duchy Feralasu, Azshary a Hinterlands a pak se vrať k Tyrisiovi do Feralasu.",
      "title": "Moudrost strážců",
