    "csCZ": {
      "description": "<Orokai zavře oči a zcela znehybní při rozmlouvání s větví. Na kůži cítíš štiplavé brnění magie.>\n\nAch, malý smrtelníku. Jaké příběhy tato větev vypráví...\n\nPojď, ukážu ti to.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Události pozorovány",
          "type": "monster"
        }
      ],
      "summary": "Promluv si s Orokaiem, až budeš chtít vidět, co se dozvěděl z Faintly Glowing Branch.",
