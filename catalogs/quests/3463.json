          "type": "object"
        },
        {
          "index": 4,
          "text": "{current}/{required} Northern Tower Ablaze",
          "type": "object"
        }
      ],
      "summary": "Set the North, South, East, and West Sentry Towers on fire by using the Torch of Retribution inside each of the buildings. \n",
      "title": "Set Them Ablaze!",
