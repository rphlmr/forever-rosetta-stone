        {
          "index": 1,
          "text": "{current}/{required} Váček černé tlamy",
          "type": "item"
        }
      ],
      "summary": "Vstup do Blackmaw Hold a získej $1oa váčků Blackmaw pro Ekkala v Ruins of Eldarath v Azshaře.",
