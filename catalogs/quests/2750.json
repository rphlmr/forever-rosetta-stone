  "locales": {
    "csCZ": {
      "description": "Tato vejce už nelze zachránit. Nikdy se nevylíhnou.",
      "dialogue": {
        "5c2a8de84d5d4046b9b4": "Obávám se, že pro tebe mám špatné zprávy, $N. Tohle vejce už nelze zachránit. Mohu si ho od tebe vzít, abych ho řádně zlikvidoval.$B$BProsím, neztrácej odvahu; nemůžeme zachránit všechna. Pokud se znovu ocitneš ve Feralasu, zkus to prosím znovu. Přines další vejce pro Super Egg-O-Matic!",
        "b66d03ac695377242fad": "Tato vejce už nelze zachránit. Nikdy se nevylíhnou."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Zkažené vejce",
          "type": "item"
        }
      ],
      "summary": "Tato vejce už nelze zachránit. Nikdy se nevylíhnou.",
