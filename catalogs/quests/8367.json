  "locales": {
    "csCZ": {
      "description": "Sloužit Hordě v jedné z velkých bitev proti Alianci je zdrojem nesmírné cti! Těch několik málo, kteří sloužili Hordě na VŠECH našich aktivních bojištích, jsou však našimi skutečně velkými bojovníky. Své protivníky neporazíme bojem v izolovaných šarvátkách, ale vedením dobře zkoordinované války.\n\nVyraz a rozdrť Alianci v Arathi Basin, Alterac Valley a Warsong Gulch! Za čest! Za Hordu!",
      "objectiveLines": [
        {
          "index": 1,
          "text": "Odznak cti Rokle válečné písně: {current}/{required}",
          "type": "item"
        },
        {
          "index": 2,
          "text": "Odznak cti Arathijské pánve: {current}/{required}",
          "type": "item"
        },
        {
          "index": 4,
          "text": "Znamení cti ostrovů Darkspear: {current}/{required}",
          "type": "item"
        }
      ],
      "summary": "Přines 3 odznaky cti z Alterackého údolí, 3 z Arathské pánve, 3 z Warsongské rokle a 3 z Ostrovů Darkspear válečnému poslovi Hordy před bojišti.",
      "title": "Za velkou čest",
