  "locales": {
    "csCZ": {
      "description": "Uvidíme, jestli udržíme ten dav ve varu.\n\nTenhle další soupeř není žádná legrace.\n\nHodně štěstí! Uvidíme se brzo. Snad.",
      "dialogue": {
        "6b0e6b4649df575ce419": "Uvidíme, jestli udržíme ten dav ve varu.\n\nTenhle další soupeř není žádná legrace.\n\nHodně štěstí! Uvidíme se brzo. Snad.",
        "a53dfea42ccecbf9dcb2": "Tak jo, hvězdo. Odkud že jsi to vlastně říkal, že jsi?\n\nZačínáš mě tu zastiňovat."
      },
