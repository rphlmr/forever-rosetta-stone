  "locales": {
    "csCZ": {
      "description": "Tohle je smlouva o zavraždění soudce Henryho Maleba. Byla zapečetěna a orazítkována červeným voskem pomocí výrazného pečetního prstenu.",
      "dialogue": {
        "34faa45bf82b6094e431": "Vypadáš zadýchaně! Máš něco na hlášení?",
        "d1ee8c874e6ee5c1add9": "<Maleb prohlíží smlouvu.>$B$BTo vysvětluje poslední útok na Southshore. Syndikát musí jít po mně, stejně jako šel po minulém magistrátovi!"
      },
      "summary": "Dones Assassin's Contract magistrátu Malebovi do Southshore.",
      "title": "Vrahova smlouva",
