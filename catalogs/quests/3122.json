  "locales": {
    "csCZ": {
      "description": "Tady jsou ty byliny, {name}. Odnes je felčarovi Uzer'imu.\n\nProsím, vyřiď mu, že jsem se scvrklou hlavou spokojený.",
      "dialogue": {
        "6118474f539b23253adc": "Přesně to potřebuji k přípravě nádoby muisek, $N. Brzy uvidíme, zda jsou má nejnovější zaříkadla tak mocná, jak jsem doufal.$B$BProsím, chvilku. Musím provést rituál a použít byliny.",
        "b8c4bd8e416dfbe95c3d": "Mluvil jsi s Neeru?",
        "eea8dc722ba28d4c9cb9": "Tady jsou ty byliny, $N. Odnes je šamanovi Uzer’imu.$B$BProsím vyřiď mu, že jsem se zmenšenou hlavou spokojen."
      },
      "summary": "Doruč Neeru's Herb Pouch felčarovi Uzer'imu do Feralasu.",
      "title": "Návrat k felčarovi Uzer'imu",
