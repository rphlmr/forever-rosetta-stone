  "locales": {
    "csCZ": {
      "description": "Ale může tu být víc kentaurů, než jsem myslel. Prosím tě, {name}, bojuj se mnou proti těm odporným vrahům.",
      "dialogue": {
        "18fc3991889e268aaa4f": "Děkuji ti za pomoc, $n. Bez tebe bych je nezadržel.",
        "c5a599cc8eae8f65bba0": "Může tu ale být víc kentaurů, než jsem myslel. Prosím tě, $n, bojuj se mnou proti těm odporným vrahům."
      },
