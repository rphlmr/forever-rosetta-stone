    "daDK": {
      "description": "Slaget i Warsong Gulch raser videre, {name}. Gør din del for at drive Silverwing Sentinels ud af vores land!",
      "dialogue": {
        "5010a979e1cccdbb00bf": "Slaget i Warsong Gulch raser videre, $N. Gør din del for at drive Silverwing Sentinels ud af vores land!",
        "902e5a0804206b2934d1": "Fremragende! Du har bevist dit værd ved at forsvare vores operationer i Warsong Gulch! Må rygtet om din ære sprede sig over hele vores land."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Krigssangkløftens ærestegn",
          "type": "item"
        }
      ],
      "summary": "Slaget i Warsong Gulch raser stadig, {name}. Gør din del for at drive Silverwing Sentinels ud af vores lande!",
