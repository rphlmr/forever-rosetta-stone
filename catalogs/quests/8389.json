    "enUS": {
      "description": "The battle in Warsong Gulch rages on, {name}.  Do your part to drive the Silverwing Sentinels out of our lands!",
      "dialogue": {
        "5010a979e1cccdbb00bf": "The battle in Warsong Gulch rages on, $N.  Do your part to drive the Silverwing Sentinels out of our lands!",
        "902e5a0804206b2934d1": "Excellent! You've shown your worth by defending our operations in Warsong Gulch! May word of your honor spread far and wide across our lands."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Warsong Gulch Mark of Honor",
          "type": "item"
