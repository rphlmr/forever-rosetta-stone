  "locales": {
    "csCZ": {
      "description": "Bitva ve Warsong Gulch dál zuří, {name}. Přispěj svým dílem k vyhnání Silverwing Sentinels z naší země!",
      "dialogue": {
        "5010a979e1cccdbb00bf": "Bitva ve Warsong Gulch zuří dál, $N. Přispěj k vyhnání Silverwing Sentinels z našich zemí!",
        "902e5a0804206b2934d1": "Výborně! Obránil jsi naše operace ve Warsong Gulch a prokázal svou cenu! Ať se zpráva o tvé cti rozšíří po celé naší zemi."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Odznak cti Rokle válečné písně",
          "type": "item"
        }
      ],
