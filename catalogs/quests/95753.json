  "locales": {
    "csCZ": {
      "description": "<Totem pulzuje divokou magií. V mysli se ti zjeví přízračný vlk a vábí tě k sobě.\n\nZdá se, že ti nabízí výzvu.\n\nV dálce, kousek za velkou sluncem vybělenou kostrou nedaleko, se objeví další totem – dvojče toho, na kterém teď spočívá tvá ruka.>",
      "objectiveLines": [
        {
          "index": 1,
          "text": "Dojdi ke starému totemu",
          "type": "event"
        }
      ],
      "summary": "Dostaň se k druhému Odd Totem na konci obří kostry, než vyprší čas.",
      "title": "Výzva pouštního vlka",
