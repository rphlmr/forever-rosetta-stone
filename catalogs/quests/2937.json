  "locales": {
    "csCZ": {
      "description": "Vezmi tenhle pergamen a přečti ho na oltáři Shadra'Alor, hluboko v říši trolů z kmene Witherbark v Hinterlands. Tím přivoláš Shadru, pavoučí bohyni.",
      "dialogue": {
        "0d4c2f05fc4b5452c646": "Skvělé, máš ho!",
        "2bc1190c968af15e96dc": "Vezmi tenhle pergamen a přečti ho na oltáři Shadra'Alor, hluboko v říši trolů z kmene Witherbark v Hinterlands. Tím přivoláš Shadru, pavoučí bohyni.",
        "d6d9dac0a65b009eae8f": "Získal jsi ten jed?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Shadra: jed",
          "type": "item"
        }
      ],
      "summary": "Poraz Shadru u oltáře v Shadra'Alor a dones její jed apatykáři Lydonovi do Tarren Mill.",
      "title": "Vyvolání Shadry",
