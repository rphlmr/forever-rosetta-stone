    "enUS": {
      "description": "Take his parchment, and read it at the altar of Shadra'Alor, deep within the witherbark realm in the Hinterlands.  This will summon Shadra the spider god.",
      "dialogue": {
        "0d4c2f05fc4b5452c646": "Sweet, you got it!",
        "2bc1190c968af15e96dc": "Take his parchment, and read it at the altar of Shadra'Alor, deep within the witherbark realm in the Hinterlands.  This will summon Shadra the spider god.",
        "d6d9dac0a65b009eae8f": "Did you get the venom?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Shadra's Venom",
          "type": "item"
        }
      ],
      "summary": "Defeat Shadra at the altar of Shadra'Alor, then bring her venom to Apothecary Lydon in Tarren Mill.",
      "title": "Summoning Shadra",
