    "daDK": {
      "description": "Tag hans pergament, og læs det ved Shadra'Alors alter dybt inde i Witherbark-området i Hinterlands. Det vil hidkalde edderkoppeguden Shadra.",
      "dialogue": {
        "0d4c2f05fc4b5452c646": "Fedt, du fik fat i den!",
        "2bc1190c968af15e96dc": "Tag hans pergament, og læs det ved Shadra'Alors alter dybt inde i Witherbark-området i Hinterlands. Det vil hidkalde edderkoppeguden Shadra.",
        "d6d9dac0a65b009eae8f": "Fik du fat i giften?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Shadra: gift",
          "type": "item"
        }
      ],
      "summary": "Besejr Shadra ved Shadra'Alors alter, og bring derefter hendes gift til apoteker Lydon i Tarren Mill.",
      "title": "Hidkaldelse af Shadra",
