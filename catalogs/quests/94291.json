  "locales": {
    "csCZ": {
      "description": "<Vybledlým inkoustem psaný přípis žádá 1× Dark Iron Bomb a uvádí místo doručení i platbu. Dole stojí, že je přípis převoditelný.>",
      "dialogue": {
        "b59d46c0c81aa25cbbc8": "Hm? Cože?"
      },
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Dark Iron Bomb",
