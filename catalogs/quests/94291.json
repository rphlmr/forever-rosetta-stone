    "enUS": {
      "description": "<Penned in faded ink, the note is requesting oa Dark Iron Bomb, along with information about delivery location and payment. At the bottom appears text denoting this writ is transferable.>",
      "dialogue": {
        "b59d46c0c81aa25cbbc8": "Huh? What?"
      },
      "summary": "Acquire the items requested by the customer and deliver them to the location marked on your map. This writ must be in your possession to complete the transaction.",
      "title": "Craftsman's Writ: Dark Iron Bomb",
