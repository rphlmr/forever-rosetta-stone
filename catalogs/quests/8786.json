  "locales": {
    "csCZ": {
      "description": "Legie Orgrimmaru požádala o další zbraně, které jsme jim v tuto chvíli nebyli schopni dodat. Obstarej zbraně, o něž žádají, a doruč je Meroku Longstrideovi před Hive'Regal.",
      "dialogue": {
        "37066849d3197d666c75": "Neseš mi něco, $N?",
        "49395f3e286e341b4185": "Výborná práce. Měli jsme jich nedostatek, $N."
      },
      "summary": "Dones 3× Massive Iron Axes Meroku Longstrideovi do tábora Orgrimmar Legion před Hive'Regal. K dokončení tohoto úkolu musíš také přinést Logistics Task Briefing VI.",
      "title": "Zbraně pro polní použití",
