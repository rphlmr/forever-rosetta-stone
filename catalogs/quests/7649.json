    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "2710e7e7ef9f32fbca6c": "Výborně, chlapče.$B$B<Strážce vědění Lydros vytrhne z knihy stránku.>$B$BJsem si jistý, že tento recept dokážeš využít.",
        "db95dc7dbff59aa1876f": "Získal jsi svazek!"
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Očarovaná thoriová plátová zbroj: Svazek I",
