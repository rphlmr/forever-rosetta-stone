  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "a9db6890206eaa591c81": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
        "ae984d5e4f69f80f60c2": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím."
      },
