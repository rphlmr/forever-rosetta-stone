  "locales": {
    "csCZ": {
      "description": "Ten recept se bude určitě hodit. Měla bych se pustit do práce, abych měla na dnešek připravené uzené pouštní knedlíčky. Pomocná ruka by se mi při přípravě hodila, štědře se ti za to odměním.",
      "dialogue": {
        "2efa23ff4635c0f3f956": "Ten recept se bude určitě hodit. Měla bych se pustit do práce, abych měla na dnešek připravené uzené pouštní knedlíčky. Pomocná ruka by se mi při přípravě hodila, štědře se ti za to odměním.",
        "7e6c51faaf4f75fc4142": "Jak pokračují ty knedlíčky? ",
        "c49a42fae4f3f116cc6c": "Výborně! Zachránil jsi mě. Ty knedlíčky jsou opravdu dobré. Od Twilight's Hammer jsem takovou chuť nečekal."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Uzené pouštní knedlíčky",
          "type": "item"
        }
      ],
      "summary": "Calandrath v Cenarion Hold potřebuje várku 10× Smoked Desert Dumplings.",
      "title": "Pomoc v kuchyni",
