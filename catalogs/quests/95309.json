    "csCZ": {
      "description": "Rozkazy jsou jednoduché: jdi do žalářů pod pevností a najdi velitele Folkara. Pokud žije, osvoboď ho a zjisti, co se tu ve jménu Twisting Nether děje.\n\nDole tě čeká armáda a bez pomoci nepřežiješ. Doufám, že máš spojence... nejlépe silné.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Najdi velitele Folkara",
          "type": "monster"
        }
      ],
      "summary": "Vstup do Alcaz Prison a najdi velitele Folkara.",
      "title": "Žádného orka nenecháme pozadu",
