  "locales": {
    "csCZ": {
      "description": "Poslouchej. Teď vyjdu těma dveřma za tebou. Ty počkáš, dokud nebudu dočista pryč, a pak se se mnou sejdeš za hřbitovem za městem. Dej bacha, ať tě nikdo nesleduje.",
      "dialogue": {
        "0e7292b5086ab37077fe": "Tak takhle se věci mají, $c. Potřebuju, abys proklouzl/a do té věže a zjistil/a, co půjde. Co ty na to?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Promluv si se Sullym",
          "type": "monster"
        }
      ],
      "summary": "Sejdi se se Sullym McClearym v Dustwallow Marsh a zjisti víc o své misi.",
      "title": "Hlídej si záda",
