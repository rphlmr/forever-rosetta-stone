    "daDK": {
      "description": "Hør her. Jeg går ud ad døren bag dig. Du venter, til jeg er godt og grundigt væk, og møder mig så bag kirkegården uden for byen. Sørg for, at ingen følger efter dig.",
      "dialogue": {
        "0e7292b5086ab37077fe": "Sådan ligger landet, $c. Jeg har brug for, at du sniger dig ind i tårnet og finder ud af, hvad du kan. Hvad siger du?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Tal med Sully",
          "type": "monster"
        }
      ],
      "summary": "Mød Sully McCleary i Dustwallow Marsh, og lær mere om din mission.",
