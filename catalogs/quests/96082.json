  "locales": {
    "csCZ": {
      "description": "Z látky od tebe nadělám obvazy. Mezitím si prosím vezmi tyhle, které už mám hotové, a ošetři rány vojákům, kteří to potřebují. Měla by to být základní první pomoc.\n\nTvoje pomoc je tu nezbytná a velice si jí cením. Prostě nemůžu být všude najednou.",
      "dialogue": {
        "fb38ea87a27e0f6ec9b5": "Jak se vojákům daří?"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Zraněný voják ošetřen",
          "type": "monster"
        }
      ],
      "summary": "Obvaž pro bratra Lowleyho 3× Wounded Soldiers.",
