  "locales": {
    "csCZ": {
      "description": "<Vzkaz psaný vybledlým inkoustem žádá dvě stě kusů Crafted Solid Shot a uvádí místo doručení a výši platby. Dole stojí poznámka, že tento přípis lze předat dál.>",
      "dialogue": {
        "7944f628852d4137ac3f": "Přišli jste nakupovat, nebo prodávat?"
      },
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Crafted Solid Shot",
