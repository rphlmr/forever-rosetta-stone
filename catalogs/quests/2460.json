  "locales": {
    "csCZ": {
      "description": "V řadách zlodějů Shattered Hand se bezpodmínečně musíš naučit pozdrav Shattered Salute. Je to jediný způsob, jak spolehlivě poznat dalšího z nás.\n\nDívej se, uč se, opakuj.",
      "dialogue": {
        "073aea8779c1424669a9": "Dobrá práce, $N. Nyní můžeš pokračovat.",
        "8d287b7df964b35a7dc5": "Jako lapka ze Shattered Hand se musíš naučit Shattered Salute. Je to jediný způsob, jak bezpečně poznat jiného člena Ruky.$B$BSleduj, uč se, opakuj.",
        "bd60d2ce5dbd1c7d83dc": "Cvič!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Pozdrav Roztříštěné ruky proveden",
          "type": "event"
        }
      ],
      "summary": "Proveď na Shenthulovi Shattered Salute.",
      "title": "Pozdrav Shattered Hand",
