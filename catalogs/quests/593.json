  "locales": {
    "csCZ": {
      "description": "Yenniku před tebou stojí omráčený, jeho mysl je někde jinde...",
      "dialogue": {
        "55e60faa0d7000fcad6d": "Yenniku před tebou omámeně stojí, jeho mysl je někde jinde...",
        "f81badedccc51345745f": "Položíš mu na čelo drahokam duše. Zachvěje se, když je jeho duše vtažena dovnitř a zanechá po sobě tělo, prázdnou schránku bez mysli."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Drahokam duše",
          "type": "item"
        }
      ],
      "summary": "Yenniku před tebou stojí omráčený, jeho mysl je někde jinde...",
      "title": "Naplnění kamene duší",
