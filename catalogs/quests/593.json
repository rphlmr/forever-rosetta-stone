    "daDK": {
      "description": "Yenniku står bedøvet foran dig, hans sind er et andet sted...",
      "dialogue": {
        "55e60faa0d7000fcad6d": "Yenniku står bedøvet foran dig, hans sind er et andet sted...",
        "f81badedccc51345745f": "Du lægger sjælestenen på hans pande. Han skælver, da hans sjæl suges ind og efterlader hans krop som en viljeløs skal."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Sjælejuvel",
          "type": "item"
        }
      ],
      "summary": "Yenniku står bedøvet foran dig, hans sind er et andet sted...",
      "title": "Fyld sjælestenen",
