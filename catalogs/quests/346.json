    "enUS": {
      "description": "Now that I've finished copying the book, here's the original Stresses of Iron.  Thank you for your patience, and if you see Milton please tell him I'm sorry for the long delay.",
      "dialogue": {
        "0926120bfef9df97a218": "That's the one!  Thank you, $N.  May the Light shine brightly upon both your body and spirit!",
        "2043d92294ccd415157e": "Now that I've finished copying the book, here's the original Stresses of Iron.  Thank you for your patience, and if you see Milton please tell him I'm sorry for the long delay.",
        "4d8642cb3063e4b78cd5": "Were you able to find the book?"
      },
      "summary": "Return to Brother Kristoff in the Cathedral Square. Give him the book The Stresses of Iron.",
      "title": "Return to Kristoff",
