  "locales": {
    "csCZ": {
      "description": "Teď, když jsem dokončil opis knihy, tady je originál Napětí železa. Děkuji ti za trpělivost, a pokud uvidíš Miltona, prosím, řekni mu, že se omlouvám za to dlouhé zdržení.",
      "dialogue": {
        "0926120bfef9df97a218": "To je ona! Děkuji ti, $N. Kéž Světlo jasně září na tvé tělo i ducha!",
        "2043d92294ccd415157e": "Teď, když jsem dokončil opis knihy, tady je originál Napětí železa. Děkuji ti za trpělivost, a pokud uvidíš Miltona, prosím, řekni mu, že se omlouvám za to dlouhé zdržení.",
        "4d8642cb3063e4b78cd5": "Podařilo se ti tu knihu najít?"
      },
      "summary": "Vrať se k bratru Kristoffovi do Cathedral Square. Předej mu knihu The Stresses of Iron.",
      "title": "Návrat ke Kristoffovi",
      "translationMetadata": {
