    "hrHR": {
      "description": "Jesi li donio nešto što možemo dodati našoj zbirci?",
      "dialogue": {
        "754244241135485337c8": "Hvala ti, $N. Tvojim trudom naše se znanje širi.\n\nAko pronađeš još čarobnih djela koja bi koristila knjižnici, molim te donesi mi ih.",
        "9de4b349c5817e242618": "Jesi li donio nešto za našu zbirku?",
        "e9dec05be4f37e9b4f3e": "Jesi li donio nešto za našu zbirku?",
        "f1937ab6f9170a81d855": "Hvala ti, $N. Zahvaljujući tvom trudu naše znanje raste.\n\nAko pronađeš još čarobnih djela koja bi mogla koristiti knjižnici, donesi mi ih."
      },
      "summary": "Jesi li donio nešto što možemo dodati našoj zbirci?",
