    "daDK": {
      "description": "Har du bragt noget til vores samling?",
      "dialogue": {
        "754244241135485337c8": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, der kan gavne biblioteket, så bring dem til mig.",
        "9de4b349c5817e242618": "Har du bragt noget til vores samling?",
        "e9dec05be4f37e9b4f3e": "Har du noget med til vores samling?",
        "f1937ab6f9170a81d855": "Tak, $N. Vores viden vokser takket være din indsats.\n\nHvis du finder flere magiske værker, som kunne gavne biblioteket, så bring dem til mig."
      },
      "summary": "Har du bragt noget til vores samling?",
