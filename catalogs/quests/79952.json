  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "754244241135485337c8": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by knihovně prospěla, přines mi je prosím.",
        "9de4b349c5817e242618": "Přinášíš něco do naší sbírky?",
        "e9dec05be4f37e9b4f3e": "Přinášíš něco do naší sbírky?",
        "f1937ab6f9170a81d855": "Děkuji, $N. Díky tvému úsilí se naše vědomosti rozšiřují.\n\nPokud objevíš další magická díla, která by mohla knihovně prospět, přines mi je prosím."
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
