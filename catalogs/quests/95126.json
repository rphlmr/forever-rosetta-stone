  "locales": {
    "csCZ": {
      "description": "Zde je ta čepel. Podle tvých slov tě poslal paladin jménem Trevan? Až ho příště uvidíš, vyřiď mu prosím mé díky za tuto příležitost. Jdi se ctí, spřízněná duše.",
      "dialogue": {
        "181f622907472de8a3aa": "Zde je ta čepel. Podle tvých slov tě poslal paladin jménem Trevan? Až ho příště uvidíš, vyřiď mu prosím mé díky za tuto příležitost. Jdi se ctí, příteli.",
        "e69b6fd098710423d5fb": "Podařilo se Ottovi zakázku splnit?"
      },
      "summary": "Dones Ott's Masterwork Trevanu Rolovi do Silverpine Forest.",
      "title": "Čepel z měsíčního stříbra",
