    "deDE": {
      "description": "Schön, Euch wiederzusehen, {name}. Der Wind führt Kunde aus den östlichen Königreichen mit sich.\n\nSetzt Euch und lauscht.",
      "dialogue": {
        "06826b2055a13c989999": "Schön, Euch wiederzusehen, $n. Der Wind führt Kunde aus den Östlichen Königreichen mit sich.\n\nSetzt Euch und lauscht.",
        "0fe3d3b934ec7df3ea61": "Seid Ihr bereit, diese Aufgabe anzunehmen?",
        "e96e850e225cb9f50001": "Geduld, $N. Passt gut auf!"
      },
      "eventObjectiveLabel": "Thrall's Tale",
      "summary": "Hört Thrall zu.",
      "title": "Was der Wind erzählt",
