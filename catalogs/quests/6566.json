    "hrHR": {
      "description": "Drago mi je ponovno te vidjeti, {name}. Vjetar nosi vijesti iz Istočnog kraljevstva.\n\nSjedni, slušaj. \r\n",
      "dialogue": {
        "06826b2055a13c989999": "Drago mi je što te opet vidim, $N. Vjetar donosi vijesti iz Istočnih kraljevstava.$B$BSjedni i slušaj. \n",
        "0fe3d3b934ec7df3ea61": "Jesi li spreman prihvatiti ovaj zadatak?\n",
        "e96e850e225cb9f50001": "Strpljenja, $N. Obrati pozornost!"
      },
      "eventObjectiveLabel": "Thrallova priča",
      "summary": "Poslušaj Thralla.",
