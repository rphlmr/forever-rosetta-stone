    "daDK": {
      "description": "Det er godt at se dig igen, {name}. Vinden bærer nyheder fra Eastern Kingdom med sig.\n\nSæt dig, lyt. \r\n",
      "dialogue": {
        "06826b2055a13c989999": "Det er godt at se dig igen, $N. Vinden bringer nyt fra Østrigerne.$B$BSæt dig og lyt. \n",
        "0fe3d3b934ec7df3ea61": "Er du klar til at påtage dig denne opgave?\n",
        "e96e850e225cb9f50001": "Tålmodighed, $N. Hør efter!"
      },
      "eventObjectiveLabel": "Thralls fortælling",
      "summary": "Lyt til Thrall.",
      "title": "Hvad vinden bærer",
