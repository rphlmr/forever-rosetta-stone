  "locales": {
    "csCZ": {
      "description": "Rád tě zase vidím, {name}. Vítr s sebou přináší zprávy z Východních království.\n\nPosaď se a poslouchej.",
      "dialogue": {
        "06826b2055a13c989999": "Rád tě zase vidím, $N. Vítr přináší zprávy z Východních království.$B$BPosaď se a poslouchej. \n",
        "0fe3d3b934ec7df3ea61": "Jsi připraven na tento úkol?\n",
        "e96e850e225cb9f50001": "Trpělivost, $N. Dávej pozor!"
      },
      "eventObjectiveLabel": "Thrallův příběh",
      "summary": "Vyslechni si Thralla.",
      "title": "Co vítr přináší",
