  "locales": {
    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "191ec2776685dc0080d8": "Našel jsi svazek!",
        "32c2eaae360c1ccd6d31": "Výborná práce, $r. Pokud najdeš další svazky, neváhej nám je přinést.$B$BPostupem času odměny za vrácené svazky obměňujeme a přidáváme nové."
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Frost Shock a ty",
