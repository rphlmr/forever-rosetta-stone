    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "191ec2776685dc0080d8": "Du har fundet et bind!",
        "32c2eaae360c1ccd6d31": "Godt arbejde, $r. Finder du flere bøger, så tøv ikke med at bringe dem til os.$B$BMed tiden ændrer vi belønningerne og tilføjer nye for de manglende bøger."
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
      "title": "Frostchok og dig",
