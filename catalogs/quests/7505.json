    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "191ec2776685dc0080d8": "You have recovered a tome!",
        "32c2eaae360c1ccd6d31": "Excellent work, $r. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes."
      },
      "summary": "Return the book to its rightful owners.",
      "title": "Frost Shock and You",
