  "locales": {
    "csCZ": {
      "description": "<Vybledlým inkoustem psaný přípis žádá 1× Mageweave Bag a uvádí místo doručení i platbu. Dole stojí, že je přípis převoditelný.>",
      "dialogue": {
        "e71c9a229089d63dc30a": "Hej, jak se máš?"
      },
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Mageweave Bag",
