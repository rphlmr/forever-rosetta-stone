    "enUS": {
      "description": "<Penned in faded ink, the note is requesting oa Mageweave Bag, along with information about delivery location and payment. At the bottom appears text denoting this writ is transferable.>",
      "dialogue": {
        "e71c9a229089d63dc30a": "Hey, how're ya doing?"
      },
      "summary": "Acquire the items requested by the customer and deliver them to the location marked on your map. This writ must be in your possession to complete the transaction.",
      "title": "Craftsman's Writ: Mageweave Bag",
