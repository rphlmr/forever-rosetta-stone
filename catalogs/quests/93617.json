    "csCZ": {
      "description": "Hierarchie Divokých bohů je pokřivená. Teď je všechno v pohybu a podstata světa je poddajná jako hlína!\n\nMoji příbuzní už nebudou trpět pod tesáky dravců, protože teď budeme lovit my všechny, kdo nás požírali!\n\nTřes se, křehké stvoření, nemáš sílu ani rychlost, která by nás odradila!",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Dravý jelen z Hyjalu",
          "type": "monster"
        }
      ],
      "summary": "Odraď jeleny od toho, aby se chovali jako predátoři.",
