    "hrHR": {
      "description": "Sada ću ti sastaviti halju. Trebat će samo nekoliko trenutaka. Ne idi daleko.",
      "dialogue": {
        "7edf100ea8a34a2d1566": "Gotovo je, $N. Izvoli. Nosi je s ponosom.$B$BMarljivo si radio i vidim velike stvari u tvojoj budućnosti. Upamti, oduprijeti se iskvarenosti koja prati naš put zahtijeva snažnu volju i postojanost. Dokle god je tvoja volja samo tvoja, postići ćeš velik uspjeh.",
        "9cfcdb6c6da954827bf2": "Sada ću ti sastaviti halju. Trebat će samo nekoliko trenutaka. Ne idi daleko.",
        "da89d1ffa78c27d95d35": "Trenutak, $n..."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Pričekaj da Menara Voidrender dovrši tvoj predmet",
