    "ltLT": {
      "description": "Dabar pasiūsiu tau apdarą. Tai užtruks vos kelias akimirkas. Toli nenueik.",
      "dialogue": {
        "7edf100ea8a34a2d1566": "Baigta, $N. Štai tau. Dėvėk su pasididžiavimu.$B$BTu sunkiai dirbai, ir matau, kad tavęs laukia didi ateitis. Atmink, kad atsispirti sugedimui, lydinčiam mūsų kelią, reikia didelės valios ir tvirtybės. Kol valdysi savo valią, tol tau puikiai seksis.",
        "9cfcdb6c6da954827bf2": "Dabar pasiūsiu tau apdarą. Tai užtruks vos kelias akimirkas. Toli nenueik.",
        "da89d1ffa78c27d95d35": "Akimirkėlę, $n..."
      },
