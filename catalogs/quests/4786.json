  "locales": {
    "csCZ": {
      "description": "Róbu pro tebe sestavím hned teď. Zabere to jen pár okamžiků. Nechoď nikam daleko.",
      "dialogue": {
        "7edf100ea8a34a2d1566": "Je hotovo, $N. Tady máš. Nos ho s hrdostí.$B$BTvrdě jsi pracoval a vidím, že tě čeká velká budoucnost. Pamatuj, že vzdorovat zkáze, která provází naši cestu, vyžaduje silnou vůli a odhodlání. Dokud bude tvá vůle patřit tobě, čeká tě velký úspěch.",
        "9cfcdb6c6da954827bf2": "Róbu pro tebe sestavím hned teď. Zabere to jen pár okamžiků. Nechoď nikam daleko.",
        "da89d1ffa78c27d95d35": "Okamžik, $n..."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Počkej, až Menara Voidrender dokončí tvůj předmět",
          "type": "event"
        }
      ],
      "summary": "Počkej, až Menara Voidrender dokončí tvou róbu, a pak si s ní znovu promluv.",
      "title": "Dokončená róba",
