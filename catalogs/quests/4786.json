    "daDK": {
      "description": "Jeg syr kåben sammen til dig nu. Det tager kun et øjeblik. Gå ikke langt væk.",
      "dialogue": {
        "7edf100ea8a34a2d1566": "Det er færdigt, $N. Værsgo. Bær den med stolthed.$B$BDu har arbejdet hårdt, og jeg ser store ting i din fremtid. Husk, at det kræver stor vilje og styrke at modstå den fordærvelse, der følger vores vej. Så længe din vilje er din egen, vil du opnå stor succes.",
        "9cfcdb6c6da954827bf2": "Jeg syr kåben sammen til dig nu. Det tager kun et øjeblik. Gå ikke langt væk.",
        "da89d1ffa78c27d95d35": "Et øjeblik, $n..."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "Vent på, at Menara Voidrender færdiggør din genstand",
          "type": "event"
        }
      ],
      "summary": "Vent på, at Menara Voidrender færdiggør din kåbe, og tal derefter med hende igen.",
      "title": "Den færdige kåbe",
      "translationMetadata": {
