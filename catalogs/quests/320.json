  "locales": {
    "csCZ": {
      "description": "Tady máš soudek Evershine, {name}. A ještě jednou děkuji za ten lov.",
      "dialogue": {
        "2d71b849f8c970d52d53": "Tady je tvůj soudek Evershine, $N. A ještě jednou díky za ten dřívější lov.",
        "7092827d40933fe3670f": "Ano, to bude stačit. Myslím, že si hned otevřu láhev a ochutnám...",
        "e2fb55cc5c7d56299e59": "Sehnal jsi ten Evershine?"
      },
      "summary": "Předej soudek Evershine pilotu Bellowfizovi do Steelgrill's Depot.",
      "title": "Návrat k Bellowfizovi",
