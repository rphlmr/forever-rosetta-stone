    "daDK": {
      "description": "Her er din tønde Evershine, {name}. Og tak igen for jagten tidligere.",
      "dialogue": {
        "2d71b849f8c970d52d53": "Her er din tønde Evershine, $N. Og tak igen for jagten tidligere.",
        "7092827d40933fe3670f": "Ja, det skal nok gå. Jeg tror, jeg åbner en flaske og smager med det samme...",
        "e2fb55cc5c7d56299e59": "Fik du fat i den Evershine?"
      },
      "summary": "Giv tønden med Evershine til pilot Bellowfiz ved Steelgrill's Depot.",
      "title": "Vend tilbage til Bellowfiz",
