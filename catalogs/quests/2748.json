    "plPL": {
      "description": "Doskonałe jajo to takie, z którego w idealnych warunkach wykluje się pisklę wolne od złych skutków inkantacji ogrów Gordunni.",
      "dialogue": {
        "2fc0b8573c58718a0729": "Doskonałe jajo to takie, z którego w idealnych warunkach wykluje się pisklę wolne od złych skutków inkantacji ogrów Gordunni.",
        "cf4754a96e30f70c8deb": "Doskonale, $N. Wyślę to jajo do Darnassus, gdzie mam nadzieję, że wkrótce się wykluje!$B$BPrzyjmij to jako wyraz mojej wdzięczności."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Dorodne jajko",
          "type": "item"
        }
      ],
