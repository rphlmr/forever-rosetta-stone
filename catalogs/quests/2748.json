  "locales": {
    "csCZ": {
      "description": "Kvalitní vejce je takové, z něhož se za ideálních podmínek vylíhne mládě nepoznamenané zlými účinky zaklínání zlobrů Gordunni.",
      "dialogue": {
        "2fc0b8573c58718a0729": "Kvalitní vejce je takové, z něhož se za ideálních podmínek vylíhne mládě nepoznamenané zlými účinky zaklínání zlobrů Gordunni.",
        "cf4754a96e30f70c8deb": "Výborně, $N. Pošlu toto vejce do Darnassu, kde se snad brzy vylíhne!$B$BPřijmi prosím toto jako projev mé vděčnosti."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Pěkné vejce",
          "type": "item"
        }
      ],
      "summary": "Kvalitní vejce je takové, z něhož se za ideálních podmínek vylíhne mládě nepoznamenané zlými účinky zaklínání zlobrů Gordunni.",
      "title": "Pěkné vejce",
