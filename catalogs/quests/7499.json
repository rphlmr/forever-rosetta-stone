    "enUS": {
      "description": "The tome carries the mark of the Athenaeum.",
      "dialogue": {
        "88ca763e58cc895c261d": "Excellent work, $R. Should you find any more tomes, do not hesitate to return them to us.$B$BAs time passes, we tend to change around and even add new rewards for the return of missing tomes.",
        "c5ee52bbe00c8ed75a12": "You have recovered a tome!"
      },
      "summary": "Return the book to its rightful owners.",
