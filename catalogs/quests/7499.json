    "daDK": {
      "description": "Bogen bærer Athenaeums mærke.",
      "dialogue": {
        "88ca763e58cc895c261d": "Godt arbejde, $R. Finder du flere bøger, så tøv ikke med at bringe dem til os.$B$BMed tiden ændrer vi belønningerne og tilføjer nye for de manglende bøger.",
        "c5ee52bbe00c8ed75a12": "Du har fundet en bog!"
      },
      "summary": "Bring bogen tilbage til dens retmæssige ejere.",
