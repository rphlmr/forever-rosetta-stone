    "csCZ": {
      "description": "Kniha nese pečeť Athenaea.",
      "dialogue": {
        "88ca763e58cc895c261d": "Výborná práce, $R. Pokud najdeš další svazky, neváhej nám je přinést.$B$BPostupem času odměny za vrácené svazky obměňujeme a přidáváme nové.",
        "c5ee52bbe00c8ed75a12": "Našel jsi svazek!"
      },
      "summary": "Vrať knihu jejím právoplatným majitelům.",
      "title": "Kodex obrany",
