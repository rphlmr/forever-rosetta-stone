  "locales": {
    "csCZ": {
      "description": "Takže, takhle ty lodě potopíme.\n\nZ ukradenýho střelnýho prachu udělám nálože s časovačem. Stačí, když skočíš na každou z lodí Eastsea a do trupu každé dáš jednu nálož. Hledej místo poblíž jejich děl, ten střelný prach naše výbušniny ještě posílí. Jakmile budou nálože na místě, zmiz odtamtud a já zmáčknu rozbušku!\n\nElegance toho plánu je v jeho jednoduchosti, nemyslíš?",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Nálož na první lodi umístěna",
          "type": "object"
        },
        {
          "index": 2,
          "text": "{current}/{required} Nálož na druhé lodi umístěna",
          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Nálož na třetí lodi umístěna",
          "type": "object"
        }
      ],
      "summary": "Nastraž na každou ze tří lodí Eastsea dálkově odpalovanou nálož.",
      "title": "Sbohem, lumpové!",
      "translationMetadata": {
        "fields": {
