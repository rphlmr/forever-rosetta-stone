    "daDK": {
      "description": "Den gamle skede er udsmykket med udskårne mønstre og mærker. Den passer til beskrivelsen fra krigsveteranen. Den dramatiske udsigt over landet nedenfor er et betagende syn.\n\nMåske kan det at holde skeden i hånden, mens du husker veteranens ord, lokke ånden til dette minde.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Krigsveteranens historie fortalt",
          "type": "monster"
