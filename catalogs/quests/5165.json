  "locales": {
    "csCZ": {
      "description": "Nyní se musíš vrátit do Jaedenaru. Ohniště jsou nejspíš rozmístěna po celé pevnosti Shadow. Uhas jejich plameny a ochrany, které tam vztyčili, padnou alespoň na krátkou dobu. Budu čekat, až se tak stane. Až se to stane, nahlédnu hluboko do pevnosti a pokusím se zjistit, kdo je hlavou této bestie. Pak a teprve pak uvidíme, zda je možné zaútočit na ně přímo.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Uhas ohnivý koš bolesti",
          "type": "object"
        },
        {
          "index": 2,
          "text": "{current}/{required} Uhas ohnivý koš zlovůle",
          "type": "object"
        },
        {
          "index": 3,
          "text": "{current}/{required} Uhas ohnivý koš utrpení",
          "type": "object"
        },
        {
          "index": 4,
          "text": "{current}/{required} Uhas ohnivý koš nenávisti",
          "type": "object"
        }
      ],
      "summary": "Pomocí Purified Moon Well Water uhas plameny čtyř ochranných košů uvnitř Shadow Hold ve Felwoodu a pak se vrať ke Gretě Mosshoof do Emerald Sanctuary.",
      "title": "Uhašení plamenů ochrany",
