  "locales": {
    "csCZ": {
      "description": "Viděl jsem jen velmi málo vajec z Feralasu v mimořádně dobrém stavu. Tato vejce patří k těm nejvzácnějším...",
      "dialogue": {
        "199077111f371ceade41": "Viděl jsem jen velmi málo vajec z Feralasu v mimořádně dobrém stavu. Tato vejce patří k těm nejvzácnějším...",
        "b497156b7b9ca614ce75": "A teď jedno máš, úžasné!$B$BDoufám, že nikdy nezapomeneš na dobro, které jsi dnes vykonal."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Mimořádné vejce",
          "type": "item"
        }
      ],
      "summary": "Viděl jsem jen velmi málo vajec z Feralasu v mimořádně dobrém stavu. Tato vejce patří k těm nejvzácnějším...",
