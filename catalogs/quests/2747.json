    "daDK": {
      "description": "Jeg har set meget få æg hentet fra Feralas i usædvanligt god stand. Disse æg hører til de allersjældneste...",
      "dialogue": {
        "199077111f371ceade41": "Jeg har set meget få æg hentet fra Feralas i usædvanligt god stand. Disse æg hører til de allersjældneste...",
        "b497156b7b9ca614ce75": "Og nu har du et, fantastisk!$B$BJeg håber, du altid vil huske det gode, du har gjort i dag."
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Ekstraordinært æg",
          "type": "item"
        }
      ],
      "summary": "Jeg har set meget få æg hentet fra Feralas i usædvanligt god stand. Disse æg hører til de allersjældneste...",
