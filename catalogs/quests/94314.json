  "locales": {
    "csCZ": {
      "description": "<Vybledlým inkoustem psaný přípis žádá 1× Cindercloth Robe a uvádí místo doručení i platbu. Dole stojí, že je přípis převoditelný.>",
      "dialogue": {
        "eaa78fe9ce8d7cc11d44": "Nemáš tu co dělat, $c."
      },
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Cindercloth Robe",
