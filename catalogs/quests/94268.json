    "enUS": {
      "description": "<Penned in faded ink, the note is requesting oa Steel Plate Helm, along with information about delivery location and payment. At the bottom appears text denoting this writ is transferable.>",
      "dialogue": {
        "b6fe8073a5c6b4d1e933": "You're not my boss, go away."
      },
