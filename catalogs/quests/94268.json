  "locales": {
    "csCZ": {
      "description": "<Vybledlým inkoustem psaný přípis žádá 1× Steel Plate Helm a uvádí místo doručení i platbu. Dole stojí, že je přípis převoditelný.>",
      "dialogue": {
        "b6fe8073a5c6b4d1e933": "Nejsi můj šéf, vypadni."
      },
      "objectiveLines": [
        {
          "index": 2,
          "text": "Ocelová plátová přilba: {current}/{required}",
          "type": "item"
        }
      ],
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Steel Plate Helm",
