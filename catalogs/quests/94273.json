    "esES": {
      "description": "<Escrita con tinta borrosa, la nota solicita oa espada ancha de acero lunar e incluye detalles sobre la ubicación de entrega y el pago. Al final aparece un texto indicando que esta libranza es transferible>.",
      "dialogue": {
        "0a4bbedb0fcd8a8f8fad": "Claro de la Luna no es lugar para la violencia, pero mantengo armas almacenadas por si llega el momento de usarlas."
      },
      "objectiveLines": [
        {
          "index": 2,
          "text": "Espada ancha de acero lunar: {current}/{required}",
          "type": "item"
        }
