    "enUS": {
      "description": "<Penned in faded ink, the note is requesting oa Moonsteel Broadsword, along with information about delivery location and payment. At the bottom appears text denoting this writ is transferable.>",
      "dialogue": {
        "0a4bbedb0fcd8a8f8fad": "Moonglade is not the place for violence, but I keep weapons stocked when the time calls for it."
      },
      "objectiveLines": [
        {
          "index": 2,
          "text": "Moonsteel Broadsword: {current}/{required}",
          "type": "item"
        }
      ],
      "summary": "Acquire the items requested by the customer and deliver them to the location marked on your map. This writ must be in your possession to complete the transaction.",
