  "locales": {
    "csCZ": {
      "description": "<Vybledlým inkoustem psaný přípis žádá 1× Moonsteel Broadsword a uvádí místo doručení i platbu. Dole stojí, že je přípis převoditelný.>",
      "dialogue": {
        "0a4bbedb0fcd8a8f8fad": "Měsíční mýtina není místem pro násilí, ale mám zásobu zbraní pro případ potřeby."
      },
      "objectiveLines": [
        {
          "index": 2,
          "text": "Široký meč z měsíční oceli: {current}/{required}",
          "type": "item"
        }
      ],
      "summary": "Obstarej předměty, které zákazník požaduje, a doruč je na místo vyznačené na mapě. K dokončení obchodu musíš mít tento přípis u sebe.",
      "title": "Přípis řemeslníka: Moonsteel Broadsword",
