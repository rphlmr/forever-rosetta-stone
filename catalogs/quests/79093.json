  "locales": {
    "csCZ": {
      "description": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
      "dialogue": {
        "1417ad55ee02c4723e2e": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
        "b09e98fd07b6ec124cba": "Děkuji, $N. Díky tvému úsilí se naše znalosti rozrůstají.\n\nPokud objevíš další magická díla, která by knihovně prospěla, přines mi je prosím."
      },
      "summary": "Přinášíš něco, co bychom mohli přidat do naší sbírky?",
