  "locales": {
    "csCZ": {
      "description": "Nemožné se stalo skutečností. Matka Černého dračího rodu leží mrtvá u tvých nohou. Vezmi její hlavu a předlož ji vrchnímu lordovi.",
      "dialogue": {
        "d5ae6d9ca87d6f22133a": "Po tolik let mě držela podmanivým pohledem. Konečně byla vykonána spravedlnost a čest Stormwindu obnovena! Dnes slavíme toto slavné vítězství!",
        "ebf53b4f9c7b2c29fe02": "Při Utherově vousu!"
      },
      "summary": "Dones Head of Onyxia vrchnímu lordovi Bolvaru Fordragonovi do Stormwindu.",
      "title": "Vítězství pro Alianci",
      "translationMetadata": {
