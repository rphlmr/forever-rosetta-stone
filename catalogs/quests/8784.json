  "locales": {
    "csCZ": {
      "description": "Podařilo se ti objevit starobylý artefakt Qiraji! Možná by pro tuto relikvii našel využití některý z draků poblíž vchodu do chrámu.",
      "dialogue": {
        "e0047968370ae567249c": "Záříš! Vím, co to znamená...",
        "f66e90c91a3225156ff1": "Výjimečný nález, $N. Prostě úžasné! To nám určitě pomůže nahlédnout do zvrácených myslí našich nepřátel.\n"
      },
      "summary": "Zanes Ancient Qiraji Artifact drakům ukrývajícím se poblíž vchodu do chrámu.",
      "title": "Tajemství Qiraji",
