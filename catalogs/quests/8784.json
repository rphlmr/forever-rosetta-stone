    "enUS": {
      "description": "You have discovered an ancient Qiraji artifact! Perhaps one of the dragons near the entrance of the temple would have a use for this relic.",
      "dialogue": {
        "e0047968370ae567249c": "You're glowing! I know what that means...",
        "f66e90c91a3225156ff1": "An exceptional find, $N. Simply marvelous! This will definitely give us some insight into our enemy's twisted minds.\n"
      },
      "summary": "Take the Ancient Qiraji Artifact to the dragons hiding near the entrance of the temple.\n",
      "title": "Secrets of the Qiraji",
