  "locales": {
    "csCZ": {
      "description": "Nemám ponětí, co se stalo s našima koňma. Jednou ráno jsem vstal, že je nakrmím, a byli pryč, jen tak.\n\nŽivot za Farholde je trochu drsnější. Mohlo je dostat cokoli – zvířata, murloci, orkové, co tě napadne.\n\nJestli chceme zúžit seznam podezřelých, měli bychom prohledat okolí stájí a najít nějaký stopy.",
      "dialogue": {
        "960adcdf3f00e9df76cf": "Stejně jako starý Demar se nemůžu dočkat, až zjistíme, co se koním stalo. Koneckonců mě živí.",
        "e53e626ce056c7f43af7": "Já to věděl! Jsou to ti zatracení kojoti!"
      },
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Najdi stopy",
          "type": "item"
        }
      ],
      "summary": "Prohledej okolí stájí ve Wheeler's Grange a najdi stopy, kam se ztracení koně poděli.",
      "title": "Hříběcí hrátky",
      "translationMetadata": {
        "fields": {
