      ],
      "summary": "Alcaz Hapishanesi'ne gir ve Stormwind Kralı'na ne olduğunu öğren.",
      "title": "Gizli Hapishane",
      "translationMetadata": {
        "fields": {
          "description": {
            "origin": "ai",
