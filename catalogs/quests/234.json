  "locales": {
    "csCZ": {
      "description": "Jestli si dobře pamatuju, Grelinův tábor je dál po cestě na jihovýchod. Určitě se na svou poštu bude těšit.",
      "dialogue": {
        "36eb8c9e71552a5a5afa": "Ach, výborně. Už je to dávno, co jsem dostal zprávu z Ironforge.",
        "5346dc889b8530206014": "Mohu ti s něčím pomoci?",
        "712038461ef0f8813724": "Jestli si dobře pamatuju, Grelinův tábor je dál po cestě na jihovýchod. Určitě se na svou poštu bude těšit."
      },
      "summary": "Doruč dopis Grelinu Whitebeardovi.",
      "title": "Doručení pošty v Coldridge Valley",
