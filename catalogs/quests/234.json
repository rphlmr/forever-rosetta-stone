    "enUS": {
      "description": "If I remember correctly, Grelin's camp is down the road to the southeast. No doubt he'll be eager to get his mail.",
      "dialogue": {
        "36eb8c9e71552a5a5afa": "Ahh, excellent. It's been a while since I received word from Ironforge.",
        "5346dc889b8530206014": "Is there something I can help you with?",
        "712038461ef0f8813724": "If I remember correctly, Grelin's camp is down the road to the southeast. No doubt he'll be eager to get his mail."
      },
      "summary": "Deliver the letter to Grelin Whitebeard.",
      "title": "Coldridge Valley Mail Delivery",
