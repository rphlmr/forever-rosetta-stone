    "hrHR": {
      "description": "Ako si izgubio borbu protiv utjelovljenja, razgovaraj sa mnom i dat ću ti još jednu saptu kojom možeš vidjeti duhove kod svetišta gore.",
      "dialogue": {
        "1a8e9fd9c68e0e67fef5": "Neka vatra gori u tvom srcu, $N.$B$BElementi te čekaju."
      },
      "summary": "Razgovaraj s Telfom Joolamom za još jednu vatrenu saptu.",
      "title": "Vatrena sapta",
