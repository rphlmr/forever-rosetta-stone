  "locales": {
    "csCZ": {
      "description": "Pokud jsi v boji s manifestací prohrál, promluv se mnou a dám ti další saptu, díky níž uvidíš duchy u svatyně nahoře.",
      "dialogue": {
        "1a8e9fd9c68e0e67fef5": "Ať ve tvém srdci hoří oheň, $N.$B$BŽivly na tebe čekají."
      },
      "summary": "Promluv si s Telfem Joolamem o další Fire Sapta.",
      "title": "Ohňová sapta",
