    "daDK": {
      "description": "Hvis du har tabt kampen mod manifestationen, så tal med mig, og jeg vil give dig en ny sapta, så du kan se ånderne ved helligdommen ovenfor.",
      "dialogue": {
        "1a8e9fd9c68e0e67fef5": "Må ilden brænde i dit hjerte, $N.$B$BElementerne venter på dig."
      },
      "summary": "Tal med Telf Joolam for at få endnu en ild-sapta.",
      "title": "Ild-sapta",
