    "enUS": {
      "description": "If you have lost in battle to the manifestation, then speak to me and I shall give you another sapta in which to see the spirits at the shrine above.",
      "dialogue": {
        "1a8e9fd9c68e0e67fef5": "May fire burn within your heart, $N.$B$BThe elements await you."
      },
      "summary": "Speak to Telf Joolam for another Fire Sapta.",
      "title": "Fire Sapta",
