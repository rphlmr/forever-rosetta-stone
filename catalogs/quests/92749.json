    "hrHR": {
      "description": "Industrijska sabotaža? Privukao si mi pozornost!\r\nPočet ćemo s malo dinamita...",
      "dialogue": {
        "340a51ed49ca1978a122": "Ovo je sjajan početak! Sad sve treba povezati... i dodati malo dodatnog žara...",
        "915dd334cc4c88e75a72": "Industrijska sabotaža? Sad me to zanima!\nPočet ćemo s malo dinamita...",
        "99489dc4732599ca1c8b": "Pokaži mi taj eksploziv, $n!"
      },
