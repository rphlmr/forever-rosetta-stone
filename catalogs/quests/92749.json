  "locales": {
    "csCZ": {
      "description": "Průmyslová sabotáž? Máš mou plnou pozornost!\nZačneme s trochou dynamitu...",
      "dialogue": {
        "340a51ed49ca1978a122": "To je skvělý začátek! Teď to všechno spojit... a přidat trochu řízu navíc...",
        "915dd334cc4c88e75a72": "Průmyslová sabotáž? Máš mou plnou pozornost!\nZačneme s trochou dynamitu...",
        "99489dc4732599ca1c8b": "Ukaž mi ty výbušniny, $n!"
      },
      "summary": "Získej 10× Rough Dynamite výrobou, obchodem nebo v aukci, pak se vrať ke Sprite Jumpsprocket do Dwarven District ve Stormwindu.",
