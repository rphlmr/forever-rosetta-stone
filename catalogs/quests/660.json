    "hrHR": {
      "description": "U redu, {name}. Spremna sam ako si i ti.\n\nHoćemo li?",
      "dialogue": {
        "9511535092bb232e2577": "U redu, $N. Spremna sam ako si i ti.$B$BHoćemo li?",
        "b46ba76240376ef96a4c": "Učinio si nam veliku uslugu, $N. Hvala ti.$B$BNadam se da Kin ondje dolje nije bila previše zahtjevna. Vrlo je prijateljski nastrojena, ali može biti jednako smrtonosna kad si joj neprijatelj.",
        "cb4f41c4ea04695014af": "Vrijeme za razgovor je prošlo. Zaštiti Kinelory ako ti je imalo stalo do ljudi iz Hillsbrada."
      },
      "eventObjectiveLabel": "Zaštiti Kinelory",
      "summary": "Zaštiti Kinelory dok se ne vrati Quae.",
      "title": "Naznake nove kuge?",
