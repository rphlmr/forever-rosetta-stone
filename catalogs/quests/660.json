    "daDK": {
      "description": "Godt, {name}. Jeg er klar, hvis du er.\n\nSkal vi?",
      "dialogue": {
        "9511535092bb232e2577": "Godt, $N. Jeg er klar, hvis du er.$B$BSkal vi?",
        "b46ba76240376ef96a4c": "Du har gjort os en stor tjeneste, $N. Tak.$B$BJeg håber ikke, at Kin var for svær at styre dernede. Hun er meget venlig, men kan være lige så dødbringende mod sine fjender.",
        "cb4f41c4ea04695014af": "Tiden til snak er forbi. Beskyt Kinelory, hvis du overhovedet bekymrer dig om folkene i Hillsbrad."
      },
      "eventObjectiveLabel": "Beskyt Kinelory",
      "summary": "Beskyt Kinelory, indtil hun vender tilbage til Quae.",
      "title": "Tegn på en ny pest?",
      "translationMetadata": {
