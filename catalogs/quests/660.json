  "locales": {
    "csCZ": {
      "description": "Dobře, {name}. Jsem připravená, jestli ty taky.\n\nJdeme na to?",
      "dialogue": {
        "9511535092bb232e2577": "Dobrá, $N. Jsem připravená, jestli jsi i ty.$B$BPůjdeme?",
        "b46ba76240376ef96a4c": "Prokázal jsi nám velkou službu, $N. Děkuji.$B$BDoufám, že Kin tam dole nebyla příliš k nezvládnutí. Je velmi přátelská, ale ke svým nepřátelům umí být stejně smrtící.",
        "cb4f41c4ea04695014af": "Čas na řeči skončil. Chraň Kinelory, pokud ti na lidech z Hillsbradu alespoň trochu záleží."
      },
      "eventObjectiveLabel": "Chraň Kinelory",
      "summary": "Chraň Kinelory, dokud se nevrátí ke Quae.",
      "title": "Náznaky nové nákazy?",
      "translationMetadata": {
