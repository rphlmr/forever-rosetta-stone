    "ptBR": {
      "description": "Muito bem, {name}. Estou pronta à sua espera.\n\nPodemos ir?",
      "dialogue": {
        "9511535092bb232e2577": "Muito bem, $N. Estou pronta à sua espera.\n\nPodemos ir?",
        "b46ba76240376ef96a4c": "Você nos fez um grande favor, $N. Obrigada.\n\nEspero que Kin não tenha causado muitos problemas lá embaixo. Embora seja muito amigável, ela sabe ser mortal quando tem inimigos por perto.",
        "cb4f41c4ea04695014af": "O tempo de conversa acabou. Proteja Kinelory se você se importa minimamente com o povo de Eira dos Montes."
      },
      "eventObjectiveLabel": "Protect Kinelory",
      "summary": "Proteja Kinelory até que ela volte para Quae.",
      "title": "Sinais de uma nova peste?",
