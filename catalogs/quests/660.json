    "enUS": {
      "description": "All right, {name}. I'm ready if you are.\n\nShall we?",
      "dialogue": {
        "9511535092bb232e2577": "All right, $N. I'm ready if you are.$B$BShall we?",
        "b46ba76240376ef96a4c": "You've done a great service for us, $N. Thank you.$B$BI hope Kin wasn't too much of a handful down there. She's very friendly, but can be just as deadly when you're her enemy.",
        "cb4f41c4ea04695014af": "The time for talk is done. Protect Kinelory if you care about the people of Hillsbrad at all."
      },
      "eventObjectiveLabel": "Protect Kinelory",
      "summary": "Protect Kinelory until she returns to Quae.",
      "title": "Hints of a New Plague?",
