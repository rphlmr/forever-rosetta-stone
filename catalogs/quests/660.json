    "esES": {
      "description": "Muy bien, {name}. Si tú estás listo, yo también.\n\n¿Vamos?",
      "dialogue": {
        "9511535092bb232e2577": "Muy bien, $N. Si tú estás listo, yo también.\n\n¿Vamos?",
        "b46ba76240376ef96a4c": "Nos has hecho un gran favor, $n. Gracias.\n\nEspero que Kin no te lo pusiera demasiado difícil. Es muy simpática pero como enemiga es letal.",
        "cb4f41c4ea04695014af": "El tiempo para hablar ha terminado.  Protege a Kinelory si te preocupas por la gente de Hillsbrad."
      },
      "eventObjectiveLabel": "Protect Kinelory",
      "summary": "Protege a Kinelory hasta que haya regresado con Quae.",
      "title": "Sospechas de una nueva Peste",
