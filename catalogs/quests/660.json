    "ltLT": {
      "description": "Gerai, {name}. Esu pasiruošusi, jei ir tu pasiruošęs.\n\nEime?",
      "dialogue": {
        "9511535092bb232e2577": "Gerai, $N. Esu pasiruošusi, jei ir tu pasiruošęs.$B$BEime?",
        "b46ba76240376ef96a4c": "Tu mums labai padėjai, $N. Ačiū.$B$BTikiuosi, Kin ten apačioje nesukėlė per daug rūpesčių. Ji labai draugiška, bet priešams gali būti tokia pat mirtinai pavojinga.",
        "cb4f41c4ea04695014af": "Kalboms laikas baigėsi. Saugok Kinelory, jei tau bent kiek rūpi Hillsbrad žmonės."
      },
      "summary": "Saugok Kinelory, kol ji grįš pas Quae.",
      "title": "Naujo maro požymiai?",
