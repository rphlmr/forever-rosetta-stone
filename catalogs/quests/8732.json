    "hrHR": {
      "description": "Papiri za terensku službu? Kakva je to besmislica, {name}?",
      "dialogue": {
        "32a098ea1dd2ca663456": "Pretpostavljam da želiš da potpišem te papire, $Gdečko:djevojko;?",
        "9f9f94489a232e0035fc": "Da, pretpostavljam da se taj mali okršaj danas računa kao služba na terenu. Vrati ove papire u Cenarion Hold, sigurno ti ondje spremaju neki lagodan posao.$B$BSad idi!",
        "ee46b87ee6710449de07": "Pretpostavljam da želiš da potpišem te papire, $Gdečko:djevojko;?"
      },
