  "locales": {
    "csCZ": {
      "description": "Doklady k polní službě? Co je to za nesmysl, {name}?",
      "dialogue": {
        "32a098ea1dd2ca663456": "Předpokládám, že chceš ty papíry podepsat, $Gchlapče:děvče;?",
        "9f9f94489a232e0035fc": "Ano, předpokládám, že tahle malá šarvátka dnes projde jako služba v terénu. Odnes to zpět do Cenarion Hold, určitě už pro tebe mají připravenou nějakou pohodlnou práci.$B$BTak běž!",
        "ee46b87ee6710449de07": "Předpokládám, že chceš ty papíry podepsat, $Gchlapče:děvče;?"
      },
      "summary": "Polní služební dokumenty? Co je to za nesmysl, {name}?",
      "title": "Doklady služby v poli",
