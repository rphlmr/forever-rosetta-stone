  "locales": {
    "csCZ": {
      "description": "Jakmile je sud Marlethina Scalderu uložen ve sklepě palírny v Kharanosu, popadneš sud Thunder Ale jako důkaz toho činu...",
      "dialogue": {
        "ca994c03ad68c62db880": "Podařilo se ti to vyměnit?",
        "fe72ab96a820bfb88724": "Není to špatné, $N! Bylo těžké dostat se přes jejich stráže?$B$BTo je jedno, mnohokrát děkuji. A kdybys někdy potřeboval pořádně řízné tmavé pivo, nezapomeň na Barleybrewovy!"
      },
      "summary": "Dones sud Thunder Ale Marleth Barleybrew do Brewnall Village.",
      "title": "Návrat k Marleth",
