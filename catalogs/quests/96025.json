    "plPL": {
      "description": "Dziękuję za pomoc, {name}. Droga przyjaciółka czeka na twoje przybycie na szczycie.\r\n\r\nZnajdziesz ją przy drodze na wschód.",
      "dialogue": {
        "36c4dff9804040e61829": "Z pewnością udało ci się tu zyskać sporą sławę. Miło cię wreszcie poznać."
      },
      "summary": "Spotkaj przyjaciółkę Elaeny na szczycie Hyjalu.",
