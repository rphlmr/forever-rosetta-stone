    "daDK": {
      "description": "Tak for din hjælp, {name}. En kær veninde venter på din ankomst på toppen.\r\n\r\nDu finder hende oppe ad vejen mod øst.",
      "dialogue": {
        "36c4dff9804040e61829": "Du har bestemt skabt dig et godt ry her. Rart endelig at møde dig."
      },
      "summary": "Mød Elaenas ven på toppen i Hyjal.",
      "title": "I fugleflugtslinje",
