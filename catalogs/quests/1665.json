    "enUS": {
      "description": "Ok, here's my mug.  Wait!  Let me finish what's in it first... there we go.",
      "dialogue": {
        "89a4d084a115133f27cd": "Ok, here's my mug.  Wait!  Let me finish what's in it first... there we go.",
        "c370ddbd561fc23b27cb": "There it is! He sure didn't want to part with it, but you were persuasive. Well done.$B$BNow for your lesson...",
        "f8f5e76be6bf393bac9b": "I saw your fight with Bartleby. Nicely done! Did you get his mug?"
      },
