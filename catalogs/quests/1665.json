  "locales": {
    "csCZ": {
      "description": "Fajn, tady máš můj korbel. Počkej! Nejdřív dopiju, co v něm ještě je... a je to.",
      "dialogue": {
        "89a4d084a115133f27cd": "Fajn, tady máš můj korbel. Počkej! Nejdřív dopiju, co v něm ještě je... a je to.",
        "c370ddbd561fc23b27cb": "Tady je! Rozhodně se s ním nechtěl rozloučit, ale tys ho přesvědčil. Dobrá práce.$B$BA teď k tvé lekci...",
        "f8f5e76be6bf393bac9b": "Viděl jsem tvůj souboj s Bartlebym. Pěkná práce! Získal jsi jeho korbel?"
      },
      "summary": "Přines Bartleby's Mug Burlguardovi.",
      "title": "Bartlebyho korbel",
