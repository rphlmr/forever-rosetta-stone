    "daDK": {
      "description": "Okay, her er mit krus. Vent! Lad mig lige drikke indholdet først... sådan.",
      "dialogue": {
        "89a4d084a115133f27cd": "Okay, her er mit krus. Vent! Lad mig lige drikke indholdet først... sådan.",
        "c370ddbd561fc23b27cb": "Der er den! Han ville bestemt ikke af med den, men du var overbevisende. Godt klaret.$B$BOg nu til din lektion...",
        "f8f5e76be6bf393bac9b": "Jeg så din kamp med Bartleby. Flot klaret! Fik du hans krus?"
      },
      "summary": "Bring Bartlebys krus til Burlguard",
      "title": "Bartlebys krus",
