    "hrHR": {
      "description": "Dobro, evo moje krigle. Čekaj! Dopusti da najprije dovršim ono što je u njoj... tako.",
      "dialogue": {
        "89a4d084a115133f27cd": "Dobro, evo moje krigle. Čekaj! Dopusti da najprije dovršim ono što je u njoj... tako.",
        "c370ddbd561fc23b27cb": "Evo ga! Sigurno ga nije htio dati, ali bio si uvjerljiv. Bravo.$B$BA sada na tvoju lekciju...",
        "f8f5e76be6bf393bac9b": "Vidio sam tvoju borbu s Bartlebyjem. Bravo! Jesi li uzeo njegov vrč?"
      },
      "summary": "Donesi Bartlebyjevu kriglu Burlguardu",
      "title": "Bartlebyjeva krigla",
