  "locales": {
    "csCZ": {
      "description": "Teď, když je bezprostřední hrozba útoků murloků pod kontrolou, doporučuji ti porozhlédnout se po naší pevnosti. Zatím toho není moc, ale je to domov.\n\nAž skončíš s prohlídkou, vyhledej Danithu Morr, naši vůdkyni. Pomůže ti se tu zabydlet.\n\nJsem moc rád, že jsem tě poznal, {name}. Ať tě Světlo vede.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Promluv si s Hildou Lamačkou",
          "type": "monster"
        },
        {
          "index": 2,
          "text": "{current}/{required} Promluv si s Jorinem Crogem",
          "type": "monster"
        },
        {
          "index": 3,
          "text": "{current}/{required} Promluv si s Anderem Sollidenem",
          "type": "monster"
        }
      ],
      "summary": "Promluv si s obyvateli Bandarion Keep.",
