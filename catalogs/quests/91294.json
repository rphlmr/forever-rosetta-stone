    "daDK": {
      "description": "Nu hvor den umiddelbare trussel fra murlocangrebene er under kontrol, vil jeg opfordre dig til at se dig omkring i vores fæstning. Det er ikke meget endnu, men det er hjem.\r\n\r\nNår du er færdig med at udforske, så opsøg vores leder Danitha Morr. Hun kan hjælpe dig med at falde til.\r\n\r\nJeg er meget glad for at have mødt dig, {name}. Må lyset være din vejviser.",
      "objectiveLines": [
        {
          "index": 1,
          "text": "{current}/{required} Tal med Hilda knuseren",
          "type": "monster"
        },
        {
          "index": 2,
