    "daDK": {
      "description": "Vær sød at høre på mig, før du dømmer!\r\n",
      "dialogue": {
        "237dc325d788ad743117": "Som du kan se, var der intet, jeg kunne have gjort.",
        "596db0958346a1c9421a": "Vær sød at høre på mig, før du dømmer!\r\n",
        "cd0a9fb9b1f47bd88972": "Lad mig fortælle min historie færdig."
