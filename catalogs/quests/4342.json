    "csCZ": {
      "description": "Prosím, vyslechni mě, než nade mnou vyneseš soud!",
      "dialogue": {
        "237dc325d788ad743117": "Jak vidíš, nemohl jsem nic udělat.",
        "596db0958346a1c9421a": "Prosím, vyslechni mě, než nade mnou vyneseš soud!",
        "cd0a9fb9b1f47bd88972": "Dovol mi dokončit můj příběh."
      },
