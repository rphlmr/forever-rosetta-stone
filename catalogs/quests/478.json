  "locales": {
    "csCZ": {
      "description": "<Rychle vyndáš přívěsek z bedny a vrátíš víko na místo.>",
      "dialogue": {
        "4d3fb761d0313c776326": "Dozvěděl ses něco užitečného, $n?",
        "e9d283b3e0e5670922c6": "Mapy a tenhle... přívěsek, hm? Zajímavé.$b$bJe zřejmé, že dalaranští čarodějové mají s Ambermillem nějaké plány, ale jejich cíl mi stále uniká.$b$bMožná Dalar ví, k čemu jim to je."
      },
      "summary": "Dones podivný přívěsek stínovému knězi Allisterovi do Sepulcher.",
      "title": "Mapy a runy",
