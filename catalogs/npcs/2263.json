    "csCZ": {
      "dialogue": {
        "01229446be0ab79c5bf8": "Rád bych si prohlédl vaše zboží.",
        "c22a2972931b3058b588": "Doufám, že jsi tu kvůli práci, $C. Máme toho hodně a Horda, Syndikát ani zlobři nám nepomohou.",
        "c72912c6f3d1f9411e51": "Vycvičte mě."
      },
      "name": "Maršál Redpath",
