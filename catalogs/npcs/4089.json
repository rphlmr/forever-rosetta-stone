  "locales": {
    "csCZ": {
      "dialogue": {
        "14220a1e90db03d8535f": "Zdravím. Hledáš výuku válečného umění?",
        "8f0fb7ca36aa53e28793": "Potřebuji výcvik válečníka.",
        "d4c12a96204f3f95e2df": "Nevidím v tobě ducha válečníka, dítě. Nemám žádné učení, které by prospělo někomu, jako je $c.",
        "e0544169a82dc81f6e00": "Při důkladném přeškolování jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je při každém dalším provedení náročnější. Proto je každé další přeškolení také dražší. Chceš, abych tě odnaučila talenty, které ses naučil?"
      },
      "name": "Sildanair",
      "translationMetadata": {
        "fields": {
          "dialogue.14220a1e90db03d8535f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
