    "hrHR": {
      "dialogue": {
        "14220a1e90db03d8535f": "Pozdrav. Tražiš li poduku u umijeću ratovanja?",
        "8f0fb7ca36aa53e28793": "Trebam ratničku obuku.",
        "d4c12a96204f3f95e2df": "Ne vidim duh ratnika u tebi, dijete. Nemam pouka koje bi koristile nekome poput tebe, $c.",
        "e0544169a82dc81f6e00": "Strogim prekvalificiranjem morala sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogla ponovno podučavati. Tu je uslugu sve teže pružiti svaki put kada se ponovi. Zato je svako sljedeće prekvalificiranje sve skuplje. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Sildanair",
