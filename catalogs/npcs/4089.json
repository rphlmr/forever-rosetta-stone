    },
    "daDK": {
      "dialogue": {
        "14220a1e90db03d8535f": "Vær hilset. Søger du undervisning i krigens kunst?",
        "8f0fb7ca36aa53e28793": "Jeg har brug for krigertræning.",
        "d4c12a96204f3f95e2df": "Jeg ser ikke krigerens ånd i dig, barn. Jeg har intet at lære en $c som dig.",
        "e0544169a82dc81f6e00": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang, den udføres. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Sildanair",
      "translationMetadata": {
        "fields": {
