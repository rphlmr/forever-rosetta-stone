    "plPL": {
      "dialogue": {
        "14220a1e90db03d8535f": "Witaj. Szukasz nauki sztuki wojennej?",
        "8f0fb7ca36aa53e28793": "Potrzebuję szkolenia wojownika.",
        "d4c12a96204f3f95e2df": "Nie widzę w tobie ducha wojownika, dziecko. Nie mam nauk, które przydałyby się komuś takiemu jak $c.",
        "e0544169a82dc81f6e00": "Dzięki surowemu przeszkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Z każdym kolejnym razem wykonanie tej usługi staje się trudniejsze. Dlatego też każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym pomogła ci zapomnieć wyuczone talenty?"
      },
      "name": "Sildanair",
      "translationMetadata": {
