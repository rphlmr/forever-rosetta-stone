    "daDK": {
      "dialogue": {
        "cb13f5eb887f3a115491": "Intet andet folk på Azeroth har lidt så meget som vores, $c. At le døden op i ansigtet er blevet en selvfølge for os alle."
      },
      "name": "Skyggepræst Sarvis",
