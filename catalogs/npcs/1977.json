    "daDK": {
      "dialogue": {
        "388fd433f6b465ada32f": "Træn mig.",
        "dc996fd06f024a10fdde": "Jeg vil gerne se dine varer.",
        "e3e8f58abbce2ebc3bf5": "Jeg blev opdraget og uddannet til at tjene offentligheden. Som folkets repræsentant. Mine evner lå ikke i våben eller håndværk, men i ord og overtalelse."
      },
      "name": "Senator Mehr Stonehallow",
