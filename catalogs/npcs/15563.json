    "trTR": {
      "dialogue": {
        "1cad3447846a36c7109d": "Son duyduğuma göre Kadim Yıldızşarkısı, Keder Bataklığı’ndaki Batık Tapınak’taydı.",
        "60c8c3eaf2c413b151d0": "Yılın yenilendiği, ayın parlak ışıldadığı zaman geldi.$B$BBu bizim zamanımız... kadimlerin uyandığı zaman."
      },
      "name": "Ulu Bellowrage",
      "translationMetadata": {
