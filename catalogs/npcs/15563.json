    "enUS": {
      "dialogue": {
        "1cad3447846a36c7109d": "Last I knew, Elder Starsong was in the Sunken Temple of the Swamp of Sorrows.",
        "60c8c3eaf2c413b151d0": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake."
      },
      "name": "Elder Bellowrage",
      "translationMetadata": {
        "fields": {
