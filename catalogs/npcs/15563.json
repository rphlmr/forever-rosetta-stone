    "hrHR": {
      "dialogue": {
        "1cad3447846a36c7109d": "Koliko znam, starješina Starsong bio je u Potopljenom hramu u Močvari tuge.",
        "60c8c3eaf2c413b151d0": "Sada je vrijeme kad je godina nova i mjesec sjajno sja.$B$BTo je naše vrijeme... kad se drevni bude."
      },
      "name": "Starješina Bellowrage",
      "translationMetadata": {
