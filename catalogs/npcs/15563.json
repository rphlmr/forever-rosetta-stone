    "ltLT": {
      "dialogue": {
        "1cad3447846a36c7109d": "Kiek žinau, senolis Starsong buvo Nuskendusioje šventykloje, Swamp of Sorrows.",
        "60c8c3eaf2c413b151d0": "Atėjo metas, kai metai nauji, o mėnulis šviečia skaisčiai.$B$BTai mūsų metas... kai senoliai pabunda."
      },
      "name": "Senolis Bellowrage",
