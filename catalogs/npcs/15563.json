    "plPL": {
      "dialogue": {
        "1cad3447846a36c7109d": "Ostatnio słyszałem, że Starszy Gwiezdna Pieśń był w Zatopionej Świątyni na Bagnach Smutku.",
        "60c8c3eaf2c413b151d0": "Nadszedł nowy rok, a księżyc świeci jasno.$B$BTo nasz czas... gdy pradawni się budzą."
      },
      "name": "Starszy Bellowrage",
      "translationMetadata": {
