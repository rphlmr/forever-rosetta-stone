  "locales": {
    "csCZ": {
      "dialogue": {
        "1cad3447846a36c7109d": "Naposledy jsem slyšel, že prastarý Hvězdopěv byl v Potopeném chrámu v Bažině nářků.",
        "60c8c3eaf2c413b151d0": "Nastal čas nového roku, kdy měsíc jasně září.$B$BJe to náš čas... kdy se prastaří probouzejí."
      },
      "name": "Starší Bellowrage",
      "translationMetadata": {
