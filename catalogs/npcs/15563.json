    "svSE": {
      "dialogue": {
        "1cad3447846a36c7109d": "Senast jag hörde var Elder Starsong i det sjunkna templet i Swamp of Sorrows.",
        "60c8c3eaf2c413b151d0": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar."
      },
      "name": "Äldste Bellowrage",
