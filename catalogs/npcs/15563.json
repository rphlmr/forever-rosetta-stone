    "daDK": {
      "dialogue": {
        "1cad3447846a36c7109d": "Sidst jeg hørte det, var Elder Starsong i det sunkne tempel i Swamp of Sorrows.",
        "60c8c3eaf2c413b151d0": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de gamle vågner."
      },
      "name": "Ældste Bellowrage",
      "translationMetadata": {
        "fields": {
