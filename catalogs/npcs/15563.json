    "esES": {
      "dialogue": {
        "1cad3447846a36c7109d": "Lo último que supe es que el ancestro Cantoestelar estaba en el Templo Sumergido en el Pantano de las Penas.",
        "60c8c3eaf2c413b151d0": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten."
      },
      "name": "Ancestro Bramira",
      "translationMetadata": {
