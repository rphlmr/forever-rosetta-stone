    "trTR": {
      "dialogue": {
        "5dfe6e3fdf4602241e34": "Teldrassil kıyılarındaki balıklar oldukça büyük ve güçlü. Söylentilere göre bunun nedeni yeni dünya ağacımızın hızla büyümesiymiş.",
        "f81f0b5ad86d45c67902": "Mallarına bakmak istiyorum."
      },
      "name": "Nessa Shadowsong",
