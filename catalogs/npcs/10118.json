    "plPL": {
      "dialogue": {
        "5dfe6e3fdf4602241e34": "Ryby u wybrzeży Teldrassilu są duże i dorodne. Podobno zawdzięczają to szybkiemu wzrostowi naszego nowego Drzewa Świata.",
        "f81f0b5ad86d45c67902": "Chcę przejrzeć twoje towary."
