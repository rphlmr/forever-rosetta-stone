    "daDK": {
      "dialogue": {
        "5dfe6e3fdf4602241e34": "Fiskene ud for Teldrassils kyst er store og kraftige. Rygtet siger, at det skyldes vores nye verdenstræs hurtige vækst.",
        "f81f0b5ad86d45c67902": "Jeg vil gerne se dine varer."
      },
      "name": "Nessa Shadowsong",
