    "enUS": {
      "dialogue": {
        "5dfe6e3fdf4602241e34": "The fish off the coast of Teldrassil are quite large and robust.  Rumors say it is the speedy growth of our new world tree that is the cause.",
        "f81f0b5ad86d45c67902": "I want to browse your goods."
      },
      "name": "Nessa Shadowsong",
      "subName": "Fishing Supplies",
