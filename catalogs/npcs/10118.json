    "hrHR": {
      "dialogue": {
        "5dfe6e3fdf4602241e34": "Ribe uz obalu Teldrassila prilično su velike i snažne. Priča se da je uzrok brz rast našeg novog svjetskog stabla.",
        "f81f0b5ad86d45c67902": "Želim pogledati vašu robu."
