  "locales": {
    "csCZ": {
      "dialogue": {
        "70681202d77528450c6a": "Musíš se začít učit věci, které přesahují mé znalosti! Promluv si s Lilliamem Sparkspindlem před tamtím stanem. Navede tě správným směrem!",
        "d59a1c328d5953153770": "Ach, jaký krásný den na to něco vyhodit do povětří!",
        "e398ebab200ffe498fc9": "Vycvičte mě.",
        "feff5d069aa974935338": "Tahle práce není pro slabé povahy. Můj strýc při ní přišel o ruku! Chudák starý Pahýl... každopádně, pokud máš pořád zájem, možná bych ti mohl pár věcí ukázat."
      },
      "name": "Sprite Jumpsprocket",
      "translationMetadata": {
