    "hrHR": {
      "dialogue": {
        "831fb8ce3cce9324f73a": "Od pada Dalarana i uništenja Quel’Thalasa teško je nabaviti ovakvu robu. No Lucan Cordell i neki drugi obrtnici izvrsno ispunjavaju naše narudžbe kvalitetnom robom.",
        "ad2bbaf4bebfec0e32a8": "Prodajem samo najbolju arkansku opremu koju su izradili obrtnici i magovi ovdje u Stormwindu.",
        "ce079b05722002d6801c": "Želim pogledati vašu robu."
      },
      "name": "Darian Singh",
      "translationMetadata": {
