            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "831fb8ce3cce9324f73a": "Siden Dalarans fald og ødelæggelsen af Quel’Thalas har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere har gjort et godt stykke arbejde med at opfylde vores bestillinger med kvalitetsvarer.",
        "ad2bbaf4bebfec0e32a8": "Jeg sælger kun det fineste magiske udstyr, fremstillet af håndværkere og magikere her i Stormwind.",
        "ce079b05722002d6801c": "Jeg vil gerne se dine varer."
      },
      "name": "Darian Singh",
      "translationMetadata": {
        "fields": {
          "dialogue.831fb8ce3cce9324f73a": {
