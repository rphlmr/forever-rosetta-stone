    "ltLT": {
      "dialogue": {
        "831fb8ce3cce9324f73a": "Nuo Dalaran žlugimo ir Quel'Thalas sunaikinimo tokių prekių sunku gauti. Tačiau Lucan Cordell ir kai kurie kiti mūsų amatininkai puikiai aprūpina mus kokybiškomis prekėmis.",
        "ad2bbaf4bebfec0e32a8": "Parduodu tik geriausią magišką įrangą, kurią pagamino čia, Stormwind mieste, gyvenantys amatininkai ir magai.",
        "ce079b05722002d6801c": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Darian Singh",
      "subName": "Fejerverkų pardavėjas",
