    "enUS": {
      "dialogue": {
        "831fb8ce3cce9324f73a": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise.",
        "ad2bbaf4bebfec0e32a8": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "ce079b05722002d6801c": "I want to browse your goods."
      },
      "name": "Darian Singh",
      "subName": "Fireworks Vendor",
      "translationMetadata": {
        "fields": {
