  "locales": {
    "csCZ": {
      "dialogue": {
        "831fb8ce3cce9324f73a": "Od pádu Dalaranu a zničení Quel’Thalasu se takové zboží těžko shání. Lucan Cordell a někteří další řemeslníci však skvěle plní naše objednávky kvalitním zbožím.",
        "ad2bbaf4bebfec0e32a8": "Prodávám jen nejlepší magickou výstroj vyrobenou zdejšími řemeslníky a mágy ve Stormwindu.",
        "ce079b05722002d6801c": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Darian Singh",
      "translationMetadata": {
        "fields": {
          "dialogue.831fb8ce3cce9324f73a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
