        }
      }
    },
    "daDK": {
      "dialogue": {
        "15a35fde135246516f6e": "Dagene, vi har tilbragt her i Azshara, er ikke blandt vores bedste og mest glorværdige, men vi er stadig unge, og blodet strømmer stadig i vores årer. Vi skal nok sejre her. Det er kun et spørgsmål om tid."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
        "fields": {
          "dialogue.15a35fde135246516f6e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
