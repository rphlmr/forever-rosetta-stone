          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "15a35fde135246516f6e": "Azshara’da geçirdiğimiz günler en iyi ve en şanlı günlerimiz arasında değil, ama hâlâ genciz ve damarlarımızda kan akıyor. Burada zafere ulaşacağız. Bu sadece bir zaman meselesi."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
        "fields": {
          "dialogue.15a35fde135246516f6e": {
