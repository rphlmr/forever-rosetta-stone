          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "15a35fde135246516f6e": "The days we've spent here in Azshara are not among our best and most glorious, but we are still young and blood still courses through our veins--we shall find victory here. It is only a matter of time."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
        "fields": {
          "dialogue.15a35fde135246516f6e": {
