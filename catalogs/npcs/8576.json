            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "15a35fde135246516f6e": "Die Tage, die wir hier in Azshara verbracht haben, gehören sicher nicht zu unseren besten und glorreichsten, aber wir sind noch jung und noch fließt Blut in unseren Adern. Hier werden wir den Sieg erringen. Es ist nur eine Frage der Zeit."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
        "fields": {
          "dialogue.15a35fde135246516f6e": {
            "origin": "community",
