    },
    "ptBR": {
      "dialogue": {
        "15a35fde135246516f6e": "Os dias que passamos aqui em Azshara não estão entre os melhores nem os mais gloriosos, mas ainda somos jovens e o sangue ainda corre por nossas veias. Nós encontraremos a vitória aqui. É só uma questão de tempo."
      },
      "name": "Ag'tor Punho de Sangue",
      "translationMetadata": {
        "fields": {
