    "hrHR": {
      "dialogue": {
        "15a35fde135246516f6e": "Dani koje smo proveli ovdje u Azshari nisu među našim najboljima i najslavnijima, ali još smo mladi i krv nam još teče žilama. Ovdje ćemo pobijediti. Samo je pitanje vremena."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
