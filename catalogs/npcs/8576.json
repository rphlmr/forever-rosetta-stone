  "locales": {
    "csCZ": {
      "dialogue": {
        "15a35fde135246516f6e": "Dny, které jsme strávili zde v Azshaře, nepatří k našim nejlepším a nejslavnějším, ale stále jsme mladí a v žilách nám proudí krev. Zde zvítězíme. Je to jen otázka času."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
        "fields": {
          "dialogue.15a35fde135246516f6e": {
