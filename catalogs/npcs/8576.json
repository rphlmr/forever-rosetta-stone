    },
    "plPL": {
      "dialogue": {
        "15a35fde135246516f6e": "Dni spędzone tutaj, w Azsharze, nie należą do naszych najlepszych i najchwalebniejszych, ale wciąż jesteśmy młodzi, a krew płynie w naszych żyłach. Zwyciężymy tutaj. To tylko kwestia czasu."
      },
      "name": "Ag'tor Bloodfist",
      "translationMetadata": {
        "fields": {
