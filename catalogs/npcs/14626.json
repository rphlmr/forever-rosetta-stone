  "locales": {
    "csCZ": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "Jako úřadující dozorce tohoto areálu musím zajistit, aby všechny zdejší záležitosti, práce, odpočinek i zábava obsahovaly jistou míru úmorné nudy.$B$BPokud zjistíš, že je něco, co po tobě žádají, příliš snadné a bezproblémové, okamžitě mi to nahlas."
      },
      "name": "Dozorce Scrange",
      "translationMetadata": {
        "fields": {
          "dialogue.76ec15f1e7b106f89c57": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
