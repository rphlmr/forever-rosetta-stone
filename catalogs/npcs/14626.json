    "hrHR": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "Kao vršitelj dužnosti nadzornika ovog kompleksa, dužan sam osigurati određenu razinu zamornosti u svim poslovima, radu, odmoru i opuštanju koji se ovdje odvijaju.$B$BAko ti se nešto što moraš učiniti čini previše jednostavnim i bez muke, odmah mi to prijavi."
      },
      "name": "Nadzornik Scrange",
      "translationMetadata": {
        "fields": {
          "dialogue.76ec15f1e7b106f89c57": {
