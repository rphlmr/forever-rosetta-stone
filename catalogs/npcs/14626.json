    },
    "daDK": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "Som fungerende arbejdsleder for dette område er det min pligt at sikre, at alle former for forretning, arbejde, hvile og afslapning her indebærer en vis grad af kedsomhed.$B$BHvis noget, du bliver bedt om, er for let og problemfrit, skal du straks melde det til mig."
      },
      "name": "Arbejdsleder Scrange",
      "translationMetadata": {
        "fields": {
          "dialogue.76ec15f1e7b106f89c57": {
