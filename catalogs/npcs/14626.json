          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "Bu yerleşkenin vekil işbaşı olarak burada gerçekleşen her türlü işin, çalışmanın, dinlenmenin ve eğlencenin belli bir sıkıcılık düzeyi içermesini sağlamak benim görevim.$B$BSenden yapman istenen herhangi bir şeyi fazla kolay ve zahmetsiz bulursan hemen bana bildir."
      },
      "name": "Başgözetmen Scrange",
      "translationMetadata": {
        "fields": {
          "dialogue.76ec15f1e7b106f89c57": {
