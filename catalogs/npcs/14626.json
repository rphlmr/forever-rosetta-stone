    "enUS": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "As acting Taskmaster of this here compound, it is my duty to make sure that there is a certain level of tedium involved with all forms of business, work, rest, and relaxation that may take place here.$B$BIf you find anything that you are asked to do to be too easy and hassle free, report to me immediately."
      },
      "name": "Taskmaster Scrange",
      "subName": "The Thorium Brotherhood",
      "translationMetadata": {
        "fields": {
          "dialogue.76ec15f1e7b106f89c57": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
