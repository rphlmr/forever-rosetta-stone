    "plPL": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "Jako pełniący obowiązki nadzorcy tego kompleksu muszę dopilnować, by wszelkie interesy, praca, odpoczynek i rozrywka wiązały się z odpowiednią dawką znużenia.$B$BJeśli uznasz, że coś, o co cię poproszono, jest zbyt łatwe i bezproblemowe, natychmiast mi to zgłoś."
      },
      "name": "Nadzorca Scrange",
      "translationMetadata": {
        "fields": {
          "dialogue.76ec15f1e7b106f89c57": {
