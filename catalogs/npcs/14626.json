            "sourceLocale": "enUS",
            "sourceRevision": "4dbb82440a27856f8dccf57094a5d792cdc7cc9b"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "76ec15f1e7b106f89c57": "Como capataz de este lugar, mi deber es asegurarme de que hay cierto nivel de tedio en todas las formas de negocio, trabajo, descanso y relajación que ocurren aquí.\n\nSi algo que te manden hacer te parece demasiado fácil y sin complicaciones, ven a hablar conmigo inmediatamente."
      },
      "name": "Capataz Scrange",
      "subName": "La Hermandad del Torio",
