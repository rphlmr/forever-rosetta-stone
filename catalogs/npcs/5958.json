    "ptBR": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Creio que você não possua a acuidade mental para compreender os mistérios da magia dos portais.",
        "42f91a636c16e28cfea1": "Por favor, ensine-me.",
        "e7fea531f8ff07d19bf0": "Como um mago, você pertence ao seleto grupo que consegue conjurar um portal que lhe transportará de volta a este mesmo local. Posso lhe ensinar como, se você estiver pronto."
      },
      "name": "Thuul",
      "subName": "Treinamento de Portais",
