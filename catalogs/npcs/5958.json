    "esES": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "No puedo creerme que poseas la agudeza mental necesaria para comprender la naturaleza de la magia del portal.",
        "42f91a636c16e28cfea1": "Por favor, enséñame.",
        "e7fea531f8ff07d19bf0": "Como mago, perteneces a un grupo selecto que puede conjurar un portal para transportarte de nuevo a este lugar. Puedo enseñarte si eres capaz de aprender."
      },
      "name": "Thuul",
      "subName": "Instructor de portal",
