          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Jeg tror ikke, du har den mentale skarphed til at forstå portalmagiens natur.",
        "42f91a636c16e28cfea1": "Lær mig det, tak.",
        "e7fea531f8ff07d19bf0": "Som magiker tilhører du en udvalgt gruppe, der kan fremmane en portal tilbage til netop dette sted. Jeg kan lære dig det, hvis du er klar."
      },
      "name": "Thuul",
      "translationMetadata": {
        "fields": {
          "dialogue.0e2f3bb2a3d90f404155": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
