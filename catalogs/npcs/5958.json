    "frFR": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Je ne pense pas que vous possédiez la finesse mentale requise pour comprendre la nature de la magie des portails.",
        "42f91a636c16e28cfea1": "Veuillez m'apprendre.",
        "e7fea531f8ff07d19bf0": "En tant que mage, vous faites partie d'une élite qui peut invoquer un portail capable de vous ramener ici même. Je peux vous apprendre comment si vous avez les compétences requises."
      },
      "name": "Thuul",
      "subName": "Maître des portails",
