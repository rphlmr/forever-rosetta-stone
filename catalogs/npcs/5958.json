            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Ich glaube nicht, dass Ihr die geistige Schärfe besitzt, um die Natur der Portalmagie zu verstehen.",
        "42f91a636c16e28cfea1": "Bitte unterrichtet mich.",
        "e7fea531f8ff07d19bf0": "Als Magier gehört Ihr zu einer auserwählten Gruppe, die ein Portal herbeizaubern kann, das Euch zurück zu diesem Ort transportiert. Ich kann Euch unterrichten, wenn Ihr bereit seid."
      },
      "name": "Thuul",
      "subName": "Portallehrer",
      "translationMetadata": {
        "fields": {
          "dialogue.0e2f3bb2a3d90f404155": {
