    "svSE": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Jag tror inte att du har skärpan som krävs för att förstå portalmagins natur.",
        "42f91a636c16e28cfea1": "Lär mig, tack.",
        "e7fea531f8ff07d19bf0": "Som magiker tillhör du en utvald grupp som kan frammana en portal tillbaka till just denna plats. Jag kan lära dig om du är redo."
      },
      "name": "Thuul",
