  "locales": {
    "csCZ": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Nevěřím, že máš dost bystrou mysl, abys pochopil podstatu magie portálů.",
        "42f91a636c16e28cfea1": "Prosím, učte mě.",
        "e7fea531f8ff07d19bf0": "Jako mág patříš mezi vyvolené, kteří mohou vyčarovat portál zpět právě na toto místo. Pokud jsi připraven, mohu tě to naučit."
      },
      "name": "Thuul",
      "translationMetadata": {
        "fields": {
          "dialogue.0e2f3bb2a3d90f404155": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
