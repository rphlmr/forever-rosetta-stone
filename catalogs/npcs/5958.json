    "hrHR": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Ne vjerujem da imaš dovoljno oštar um da shvatiš prirodu magije portala.",
        "42f91a636c16e28cfea1": "Molim te, poduči me.",
        "e7fea531f8ff07d19bf0": "Kao mag pripadaš odabranoj skupini koja može stvoriti portal natrag na ovo mjesto. Mogu te podučiti ako si spreman."
      },
      "name": "Thuul",
      "translationMetadata": {
