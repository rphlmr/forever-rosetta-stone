    "ltLT": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "Nemanau, kad tavo protas pakankamai aštrus, kad suvoktum portalų magijos prigimtį.",
        "42f91a636c16e28cfea1": "Prašau, išmokyk mane.",
        "e7fea531f8ff07d19bf0": "Kaip magas priklausai nedidelei grupei, galinčiai išburti portalą, kuris pargabentų tave į šią vietą.  Jei esi pasirengęs, galiu tave išmokyti."
      },
      "name": "Thuul",
      "subName": "Portalų mokytojas",
      "translationMetadata": {
