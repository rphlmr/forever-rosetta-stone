    "enUS": {
      "dialogue": {
        "0e2f3bb2a3d90f404155": "I do not believe you possess the mental acuity to grasp the nature of portal magic.",
        "42f91a636c16e28cfea1": "Please teach me.",
        "e7fea531f8ff07d19bf0": "As a mage, you are one of a select group that can conjure a portal to transport you back to this very place.  I can teach you if you are ready."
      },
      "name": "Thuul",
      "subName": "Portal Trainer",
      "translationMetadata": {
