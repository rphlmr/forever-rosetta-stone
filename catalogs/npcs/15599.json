    "daDK": {
      "dialogue": {
        "7c8240e278777781799c": "Ældste Primestone har tilbragt mange år i Krystaldalen i Silithus.",
        "9155fa3621e3d9bbf47d": "Af grunde, jeg ikke forstår, er ældste Thunderhorn draget til Det Slyngende Ar i Un'Goro-krateret.",
        "9598f000350927a29c41": "Denne tids stjerner følger nye veje, fyrtårne af håb og styrke for kommende tidsaldre."
      },
      "name": "Ældste Bladesing",
