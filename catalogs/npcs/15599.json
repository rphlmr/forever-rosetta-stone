    "trTR": {
      "dialogue": {
        "7c8240e278777781799c": "Yaşlı Primestone, Silithus'taki Kristal Vadi'de uzun yıllar geçirdi.",
        "9155fa3621e3d9bbf47d": "Anlayamadığım nedenlerle Yaşlı Thunderhorn, Un'Goro Krateri'ndeki Sürünen Yara'ya gitti.",
        "9598f000350927a29c41": "Bu zamanın yıldızları yeni yollara yöneliyor, gelecek çağlar için umut ve güç ışıkları oluyor."
      },
      "name": "Ulu Bladesing",
