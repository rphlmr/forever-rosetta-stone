    "enUS": {
      "dialogue": {
        "7c8240e278777781799c": "Elder Primestone has spent many years in the Crystal Vale in Silithus.",
        "9155fa3621e3d9bbf47d": "For reasons I cannot understand, Elder Thunderhorn has gone to the Slithering Scar in Un'Goro Crater.",
        "9598f000350927a29c41": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages."
      },
      "name": "Elder Bladesing",
