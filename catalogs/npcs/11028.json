    "hrHR": {
      "dialogue": {
        "483dd9fd00c19413cde5": "Čula sam da će novi Henweigh 6000 uskoro sići s proizvodne trake. Jedva obuzdavam uzbuđenje!",
        "4d8644f79c8d08b7adaf": "Pa... mrzim to priznati, ali ako želiš nastaviti obuku, morat ćeš razgovarati s mojom sestrom. Ne znam toliko koliko ona... još! Stoji tamo kod raketnog automobila.",
        "9df91e0ec17d9b2eb2d5": "Rado ću te podučiti! Pokazat ću sestri da nije jedina koja zna ponešto o inženjerstvu...",
        "ae6787133879023150ea": "Podučite me."
      },
      "name": "Jemma Quikswitch",
