    "esES": {
      "dialogue": {
        "483dd9fd00c19413cde5": "He oído que el nuevo Pesagallinas 6000 pronto estará en la cadena de montaje. ¡Apenas puedo contener los nervios!",
        "4d8644f79c8d08b7adaf": "Bien... odio admitirlo, pero tendrás que hablar con mi hermana si quieres seguir tu instrucción. No sé tanto como ella... ¡todavía! La encontrarás junto al coche cohete.",
        "9df91e0ec17d9b2eb2d5": "¡Me encantaría instruirte! Le enseñaré a mi hermana que ella no es la única que sabe un par de cosas sobre ingeniería...",
        "ae6787133879023150ea": "Entréname."
      },
      "name": "Jemma Cambioveloz",
      "subName": "Oficial de ingeniería",
