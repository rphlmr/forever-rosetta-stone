    "enUS": {
      "dialogue": {
        "483dd9fd00c19413cde5": "I heard the new Henweigh 6000 will be rolling off the assembly line soon. I can barely contain my excitement!",
        "4d8644f79c8d08b7adaf": "Well... I hate to admit it, but my sister's the one you'll have to talk to if you want to continue training. I don't know as much as she does... yet! She's standing over by the rocket car.",
        "9df91e0ec17d9b2eb2d5": "I'd love to teach you! Show my sister she's not the only one who knows a thing or two about engineering...",
        "ae6787133879023150ea": "Train me."
      },
      "name": "Jemma Quikswitch",
      "subName": "Journeyman Engineer",
      "translationMetadata": {
        "fields": {
