  "locales": {
    "csCZ": {
      "dialogue": {
        "483dd9fd00c19413cde5": "Slyšela jsem, že nový Henweigh 6000 brzy sjede z montážní linky. Sotva dokážu skrýt nadšení!",
        "4d8644f79c8d08b7adaf": "No... nerada to přiznávám, ale pokud chceš pokračovat ve výcviku, musíš promluvit s mou sestrou. Nevím toho tolik co ona... zatím! Stojí tamhle u raketového auta.",
        "9df91e0ec17d9b2eb2d5": "Ráda tě naučím! Ukážu své sestře, že není jediná, kdo něco ví o inženýrství...",
        "ae6787133879023150ea": "Vycvičte mě."
      },
      "name": "Jemma Quikswitch",
      "translationMetadata": {
        "fields": {
