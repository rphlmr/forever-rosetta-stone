    "daDK": {
      "dialogue": {
        "082a63394fdd67222670": "Jeg vil gerne se dine varer.",
        "d42b3da8d115f7c30bf8": "Træn mig.",
        "e979c80874f125df76f9": "Nogle undrer sig over, hvad vi laver herude i ørkenen. Tja... hvis jeg fortalte dig det, ville du blive og prøve at tage vores fortjeneste!"
      },
      "name": "Tran'rek",
      "translationMetadata": {
