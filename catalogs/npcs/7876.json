    "csCZ": {
      "dialogue": {
        "082a63394fdd67222670": "Rád bych si prohlédl vaše zboží.",
        "d42b3da8d115f7c30bf8": "Vycvičte mě.",
        "e979c80874f125df76f9": "Někteří se diví, co tu v poušti děláme. No... kdybych ti to řekl, zůstaneš tu a pokusíš se nám sebrat zisky!"
      },
      "name": "Tran'rek",
