    "deDE": {
      "dialogue": {
        "082a63394fdd67222670": "Ich möchte Eure Waren ansehen.",
        "d42b3da8d115f7c30bf8": "Bildet mich aus.",
        "e979c80874f125df76f9": "Manche Leute fragen sich, was wir hier draußen in der Wüste machen.  Nun... wenn ich es Ihnen sagen würde, dann würden Sie bleiben und versuchen, unsere Gewinne zu machen!"
      },
      "name": "Tran'rek",
      "translationMetadata": {
