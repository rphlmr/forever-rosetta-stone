    "plPL": {
      "dialogue": {
        "0abb49f870d9fbcdbca0": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "3ae968086263cd627ea8": "Magia spacza tylko słabych. Nawet jeśli nie podążasz ścieżką czarnoksiężnika, dobrze będzie o tym pamiętać.",
        "553c0aa324ee0372296f": "Ciemność cię nie obejmuje, $c. Przestań paplać i zniknij mi z oczu! Precz!",
        "ef131155e9c467654881": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "f2841a43eebc3f2574a2": "Dzięki rygorystycznemu przeszkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mogła nauczyć ich od nowa. Ta usługa za każdym razem staje się trudniejsza do wykonania, dlatego też każde kolejne przeszkolenie jest droższe. Czy chcesz, abym pomogła ci zapomnieć wyuczone talenty?"
      },
      "name": "Drusilla La Salle",
      "translationMetadata": {
