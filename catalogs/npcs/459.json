    "daDK": {
      "dialogue": {
        "0abb49f870d9fbcdbca0": "Jeg er interesseret i træning som troldmand.",
        "3ae968086263cd627ea8": "Den arkane magi fordærver kun de svage. Selv hvis du ikke følger dæmonbesværgerens vej, gør du klogt i at huske det.",
        "553c0aa324ee0372296f": "Mørket omfavner dig ikke, $c. Hold inde med din snak og forsvind fra mit åsyn! Forsvind!",
        "ef131155e9c467654881": "Jeg er interesseret i træning som troldmand.",
        "f2841a43eebc3f2574a2": "Gennem grundig omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg aflærer dig de talenter, du har lært?"
      },
      "name": "Drusilla La Salle",
      "translationMetadata": {
        "fields": {
          "dialogue.0abb49f870d9fbcdbca0": {
