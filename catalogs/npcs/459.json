    "hrHR": {
      "dialogue": {
        "0abb49f870d9fbcdbca0": "Zanima me poduka u umijeću vještaca.",
        "3ae968086263cd627ea8": "Arkanska magija kvari samo slabe. Čak i ako ne slijediš put vješca, bilo bi dobro da to zapamtiš.",
        "553c0aa324ee0372296f": "Tama te ne prihvaća, $c. Prestani brbljati i gubi mi se s očiju! Odlazi!",
        "ef131155e9c467654881": "Zanima me poduka u umijeću vještaca.",
        "f2841a43eebc3f2574a2": "Strogom preobukom morala sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla ponovno podučiti. Uslugu koju nudim sve je teže obaviti svaki put, pa je zato i sve skuplja sa svakom preobukom. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Drusilla La Salle",
      "translationMetadata": {
