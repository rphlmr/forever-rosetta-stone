    "ptBR": {
      "dialogue": {
        "30454a82c0700d88d264": "Você busca um conhecimento elevado. Thepa é abençoada com tal conhecimento. Ela deve estar pelas redondezas...",
        "52a03142c093fc17e368": "Com a bênção da Mãe Terra, vamos começar.",
        "7ff5d0b87e1fac0281ee": "Treine-me.",
        "e7da007d260bb7775f09": "Nem sequer um pedaço dos animais que caçamos é desperdiçado."
      },
      "name": "Vhan",
      "subName": "Alfaiate Profissional",
