    "plPL": {
      "dialogue": {
        "30454a82c0700d88d264": "Szukasz wyższej wiedzy. Tepa została nią obdarzona. Powinna stać gdzieś w pobliżu...",
        "52a03142c093fc17e368": "Z błogosławieństwem Matki Ziemi zaczniemy.",
        "7ff5d0b87e1fac0281ee": "Wyszkol mnie.",
        "e7da007d260bb7775f09": "Żadna część zwierząt, na które polujemy, się nie marnuje."
      },
      "name": "Vhan",
