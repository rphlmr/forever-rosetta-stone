    "hrHR": {
      "dialogue": {
        "30454a82c0700d88d264": "Tražiš više znanje. Tepa je blagoslovljena takvim znanjem. Trebala bi biti negdje u blizini...",
        "52a03142c093fc17e368": "Uz blagoslov Majke Zemlje, počet ćemo.",
        "7ff5d0b87e1fac0281ee": "Podučite me.",
        "e7da007d260bb7775f09": "Nijedan dio životinja koje lovimo ne propada."
      },
      "name": "Vhan",
      "translationMetadata": {
