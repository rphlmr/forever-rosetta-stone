    "esES": {
      "dialogue": {
        "30454a82c0700d88d264": "Buscas un conocimiento superior. Tepa ha sido bendecida con un conocimiento así. Creo que está por aquí cerca...",
        "52a03142c093fc17e368": "Con la bendición de la Madre Tierra, comencemos.",
        "7ff5d0b87e1fac0281ee": "Entréname.",
        "e7da007d260bb7775f09": "No desperdiciamos ninguna parte de los animales que cazamos."
      },
      "name": "Vhan",
      "subName": "Oficial de sastrería",
