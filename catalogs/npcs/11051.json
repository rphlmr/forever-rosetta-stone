    "daDK": {
      "dialogue": {
        "30454a82c0700d88d264": "Du søger højere kundskab. Tepa er velsignet med sådan viden. Hun burde stå et sted i nærheden...",
        "52a03142c093fc17e368": "Med Jordmoderens velsignelse begynder vi.",
        "7ff5d0b87e1fac0281ee": "Træn mig.",
        "e7da007d260bb7775f09": "Ingen del af de dyr, vi jager, går til spilde."
      },
      "name": "Vhan",
      "translationMetadata": {
        "fields": {
