  "locales": {
    "csCZ": {
      "dialogue": {
        "30454a82c0700d88d264": "Hledáš vyšší poznání. Tepa je takovým poznáním obdařena. Měla by stát někde poblíž...",
        "52a03142c093fc17e368": "S požehnáním Matky země začneme.",
        "7ff5d0b87e1fac0281ee": "Vycvičte mě.",
        "e7da007d260bb7775f09": "Ze zvířat, která lovíme, nepřijde nazmar žádná část."
      },
      "name": "Vhan",
      "translationMetadata": {
