    "deDE": {
      "dialogue": {
        "30454a82c0700d88d264": "Ihr sucht nach größerem Wissen. Tepa ist mit solchem Wissen gesegnet. Sie sollte irgendwo in der Nähe sein...",
        "52a03142c093fc17e368": "Mit dem Segen der Erdenmutter werden wir beginnen.",
        "7ff5d0b87e1fac0281ee": "Bildet mich aus.",
        "e7da007d260bb7775f09": "Kein Teil der Tiere, die wir jagen, wird verschwendet."
      },
      "name": "Vhan",
      "subName": "Schneidergeselle",
