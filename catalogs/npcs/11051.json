    "trTR": {
      "dialogue": {
        "30454a82c0700d88d264": "Daha yüce bir bilgi arıyorsun. Tepa böyle bir bilgiyle kutsanmıştır. Yakınlarda bir yerde duruyor olmalı...",
        "52a03142c093fc17e368": "Toprak Ana’nın kutsamasıyla başlayalım.",
        "7ff5d0b87e1fac0281ee": "Beni eğit.",
        "e7da007d260bb7775f09": "Avladığımız hayvanların hiçbir parçası ziyan edilmez."
      },
      "name": "Vhan",
