    "enUS": {
      "dialogue": {
        "30454a82c0700d88d264": "You seek a higher knowledge. Tepa is blessed with such knowledge. She should be standing somewhere nearby...",
        "52a03142c093fc17e368": "With the Earth Mother's blessing, we shall begin.",
        "7ff5d0b87e1fac0281ee": "Train me.",
        "e7da007d260bb7775f09": "No part of the animals we hunt is wasted. "
      },
      "name": "Vhan",
      "subName": "Journeyman Tailor",
