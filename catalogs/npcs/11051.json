    "frFR": {
      "dialogue": {
        "30454a82c0700d88d264": "Vous êtes à la recherche d'un savoir plus étendu que le mien. Tepa le possède. Elle doit être quelque part par là...",
        "52a03142c093fc17e368": "Avec les bénédictions de la Terre-mère, nous allons commencer.",
        "7ff5d0b87e1fac0281ee": "Entraînez-moi.",
        "e7da007d260bb7775f09": "Aucune partie des animaux que nous chassons n'est gaspillée."
      },
      "name": "Vhan",
      "subName": "Tailleur - Compagnon",
