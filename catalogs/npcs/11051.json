    "svSE": {
      "dialogue": {
        "30454a82c0700d88d264": "Du söker högre kunskap. Tepa har välsignats med sådan kunskap. Hon borde stå någonstans i närheten...",
        "52a03142c093fc17e368": "Med Jordmoderns välsignelse börjar vi.",
        "7ff5d0b87e1fac0281ee": "Träna mig.",
        "e7da007d260bb7775f09": "Ingen del av djuren vi jagar går till spillo."
      },
      "name": "Vhan",
