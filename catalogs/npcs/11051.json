    "ltLT": {
      "dialogue": {
        "30454a82c0700d88d264": "Tu ieškai gilesnių žinių. Tepa yra palaiminta tokiomis žiniomis. Ji turėtų stovėti kažkur netoliese...",
        "52a03142c093fc17e368": "Su Žemės Motinos palaiminimu pradėsime.",
        "7ff5d0b87e1fac0281ee": "Mokyk mane.",
        "e7da007d260bb7775f09": "Nė viena mūsų medžiojamų gyvūnų dalis nenueina perniek. "
      },
      "name": "Vhan",
      "subName": "Siuvėjo pameistrys",
