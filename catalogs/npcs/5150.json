    "plPL": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Mogę nauczyć cię pierwszej pomocy.",
        "a0172cdbd2aab9bfb9fe": "Potrzebuję szkolenia.",
        "b1dbb52eb1d5c9f9e3b0": "Słyszałam, że Deneb Walker, która ukrywa się w Stromgarde, ma książkę, która pomoże ci doskonalić pierwszą pomoc.",
        "e9711ca63950ff3dad0d": "Studiujesz nauki medyczne?",
        "f7c820f827ce2a6a0162": "Szanowny doktor Gustaf VanHowzen może cię dalej szkolić. Znajdziesz go w Theramore, gdzie opatruje rannych w koszarach."
      },
      "name": "Nissa Firestone",
