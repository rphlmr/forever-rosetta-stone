    "trTR": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Sana ilk yardım tekniklerini öğretebilirim.",
        "a0172cdbd2aab9bfb9fe": "Eğitime ihtiyacım var.",
        "b1dbb52eb1d5c9f9e3b0": "Stromgarde'da saklanan Deneb Walker'ın ilk yardım becerilerini geliştirmene yardımcı olacak bir kitabı olduğunu duydum.",
        "e9711ca63950ff3dad0d": "Tıp bilimleri öğrencisi misin?",
        "f7c820f827ce2a6a0162": "Saygın Doktor Gustaf VanHowzen eğitimine devam edebilir. Onu Theramore'daki kışlada yaralıları tedavi ederken bulabilirsin."
      },
      "name": "Nissa Firestone",
