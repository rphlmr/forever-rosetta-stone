    "enUS": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "I can train you in First Aid techniques.",
        "a0172cdbd2aab9bfb9fe": "I require training.",
        "b1dbb52eb1d5c9f9e3b0": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques.",
        "e9711ca63950ff3dad0d": "Are you a student of the medical sciences?",
        "f7c820f827ce2a6a0162": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks."
      },
      "name": "Nissa Firestone",
      "subName": "First Aid Trainer",
      "translationMetadata": {
        "fields": {
