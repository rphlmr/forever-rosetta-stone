    "svSE": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Jag kan lära dig första hjälpen.",
        "a0172cdbd2aab9bfb9fe": "Jag behöver träning.",
        "b1dbb52eb1d5c9f9e3b0": "Jag har hört att Deneb Walker, som håller till i Stromgarde, har en bok som kan hjälpa dig att förbättra dina kunskaper i första hjälpen.",
        "e9711ca63950ff3dad0d": "Studerar du medicin?",
        "f7c820f827ce2a6a0162": "Den ansedde doktor Gustaf VanHowzen kan lära dig mer. Du hittar honom i Theramore, där han vårdar de sårade i kasernen."
      },
      "name": "Nissa Firestone",
