  "locales": {
    "csCZ": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Mohu tě naučit první pomoc.",
        "a0172cdbd2aab9bfb9fe": "Potřebuji výcvik.",
        "b1dbb52eb1d5c9f9e3b0": "Slyšela jsem, že Deneb Walker, která se ukrývá ve Stromgarde, má knihu, jež ti jistě pomůže zlepšit první pomoc.",
        "e9711ca63950ff3dad0d": "Studuješ lékařské vědy?",
        "f7c820f827ce2a6a0162": "Vážený doktor Gustaf VanHowzen tě může dále vycvičit. Najdeš ho v Theramore, kde v kasárnách ošetřuje raněné."
      },
      "name": "Nissa Firestone",
      "translationMetadata": {
        "fields": {
