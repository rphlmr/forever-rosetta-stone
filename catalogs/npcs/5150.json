    "itIT": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Posso insegnarti le tecniche di Primo Soccorso.",
        "a0172cdbd2aab9bfb9fe": "Ho bisogno di addestramento.",
        "b1dbb52eb1d5c9f9e3b0": "Ho sentito dire che Deneb Walker, rintanato a Stromgarde, ha un libro che ti aiuterà di sicuro a migliorare le tue tecniche di primo soccorso.",
        "e9711ca63950ff3dad0d": "Studi le scienze mediche?",
        "f7c820f827ce2a6a0162": "L'illustre Dottor Gustaf VanHowzen può portare avanti il tuo addestramento. Lo trovi a Theramore, alla caserma, dove cura i feriti."
      },
      "name": "Nissa Firestone",
