    "daDK": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Jeg kan lære dig førstehjælp.",
        "a0172cdbd2aab9bfb9fe": "Jeg har brug for træning.",
        "b1dbb52eb1d5c9f9e3b0": "Jeg har hørt, at Deneb Walker, der holder til i Stromgarde, har en bog, som kan hjælpe dig med at forbedre dine førstehjælpsfærdigheder.",
        "e9711ca63950ff3dad0d": "Studerer du lægevidenskab?",
        "f7c820f827ce2a6a0162": "Den ansete doktor Gustaf VanHowzen kan lære dig mere. Du finder ham i Theramore, hvor han behandler de sårede i kasernen."
      },
      "name": "Nissa Firestone",
      "translationMetadata": {
        "fields": {
          "dialogue.1407aec2f5b7dbba7916": {
