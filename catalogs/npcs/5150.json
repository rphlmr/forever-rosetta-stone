    "hrHR": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Mogu te podučiti tehnikama prve pomoći.",
        "a0172cdbd2aab9bfb9fe": "Treba mi obuka.",
        "b1dbb52eb1d5c9f9e3b0": "Čula sam da Deneb Walker, koja se sklonila u Stromgarde, ima knjigu koja će ti pomoći usavršiti prvu pomoć.",
        "e9711ca63950ff3dad0d": "Proučavaš li medicinske znanosti?",
        "f7c820f827ce2a6a0162": "Cijenjeni doktor Gustaf VanHowzen može te dalje podučiti. Naći ćeš ga u Theramoreu, gdje liječi ranjenike u vojarni."
      },
      "name": "Nissa Firestone",
