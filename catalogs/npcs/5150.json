    "ptBR": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Eu posso lhe ensinar as técnicas de Primeiros Socorros.",
        "a0172cdbd2aab9bfb9fe": "Preciso de treinamento.",
        "b1dbb52eb1d5c9f9e3b0": "Ouvi dizer que Deneb Walker tem um livro que com certeza vai te ajudar a aperfeiçoar sua técnica de Primeiros Socorros. Ele está escondido em Stromgarde.",
        "e9711ca63950ff3dad0d": "Você estuda as ciências médicas?",
        "f7c820f827ce2a6a0162": "O estimado Doutor Gregório Casagrande pode prosseguir com o seu treinamento. Ele fica em Theramore, cuidando dos feridos no quartel."
      },
      "name": "Nissa Pederneira",
      "subName": "Treinamento de Primeiros Socorros",
