    "deDE": {
      "dialogue": {
        "1407aec2f5b7dbba7916": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "a0172cdbd2aab9bfb9fe": "Ich benötige Ausbildung.",
        "b1dbb52eb1d5c9f9e3b0": "Ich habe gehört, dass Deneb Walker sich momentan in Stromgarde aufhält. Er ist im Besitz eines Buchs, das Euch helfen wird Eure Techniken der Ersten Hilfe zu verbessern.",
        "e9711ca63950ff3dad0d": "Seid Ihr ein Schüler der Medizin?",
        "f7c820f827ce2a6a0162": "Der angesehene Doktor Gustav VanHowzen kann Euch weiter ausbilden. Ihr findet ihn in Theramore, er versorgt die Verwundeten in der ansässigen Kaserne."
      },
      "name": "Nissa Firestone",
      "subName": "Lehrerin für Erste Hilfe",
      "translationMetadata": {
        "fields": {
