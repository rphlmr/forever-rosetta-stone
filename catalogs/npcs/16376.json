    "svSE": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Mästerhantverkaren Omarion bara försvann en natt. Som en fis i vinden... Poff! Borta! Bah, nu är jag den ende kvar som kan tillverka utrustning åt grabbarna vid fronten.",
        "be69858257115f3e777a": "Visa mig dina varor, Wilhelm."
      },
      "name": "Hantverkare Wilhelm",
      "translationMetadata": {
