    "enUS": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Master craftsman Omarion just vanished one night. Like a toot in the wind... Poof! Gone! Bah, now I'm the only one left to craft the goods for the boys on the front lines. ",
        "be69858257115f3e777a": "Show me your wares, Wilhelm."
      },
      "name": "Craftsman Wilhelm",
      "subName": "Brotherhood of the Light",
      "translationMetadata": {
        "fields": {
