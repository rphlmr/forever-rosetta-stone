    "daDK": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Mesterhåndværkeren Omarion forsvandt bare en nat. Som en prut i vinden... Puf! Væk! Bah, nu er jeg den eneste tilbage til at fremstille udstyr til gutterne ved fronten.",
        "be69858257115f3e777a": "Vis mig dine varer, Wilhelm."
      },
      "name": "Håndværker Wilhelm",
      "translationMetadata": {
        "fields": {
          "dialogue.9a80aeafcf74d267a798": {
