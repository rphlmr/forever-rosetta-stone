    },
    "zhTW": {
      "dialogue": {
        "9a80aeafcf74d267a798": "在某個夜裡工匠大師歐瑪利安突然消失了。就像風中的號角聲...咻！消失了！呸，現在只剩下我一個人幫前線的戰士們鑄造東西了。",
        "be69858257115f3e777a": "讓我看看你的貨物，威廉。"
      },
      "name": "工匠維爾海姆",
      "subName": "聖光兄弟會",
      "translationMetadata": {
