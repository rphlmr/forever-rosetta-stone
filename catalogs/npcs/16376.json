    "hrHR": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Majstor obrtnik Omarion jednostavno je nestao jedne noći. Kao prdac na vjetru... Puf! Nema ga! Bah, sad sam jedini preostao izrađivati opremu za momke na prvoj crti.",
        "be69858257115f3e777a": "Pokaži mi svoju robu, Wilhelme."
      },
      "name": "Obrtnik Wilhelm",
      "translationMetadata": {
