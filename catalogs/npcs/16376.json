    "ptBR": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Uma noite, o mestre artesão Omarion sumiu... que nem um pum soltado na ventania – puf! Foi-se! Humpf, agora eu tenho que fabricar tudo para os garotos nas linhas de frente sozinho.",
        "be69858257115f3e777a": "Mostre-me suas mercadorias, Wilhelm."
      },
      "name": "Artesão Wilhelm",
      "subName": "Irmandade da Luz",
