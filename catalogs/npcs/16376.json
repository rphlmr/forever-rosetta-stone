    "plPL": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Mistrz rzemiosła Omarion po prostu zniknął pewnej nocy. Jak bąk na wietrze... Puf! Nie ma go! Ech, teraz tylko ja zostałem, żeby wytwarzać wyposażenie dla chłopaków na pierwszej linii.",
        "be69858257115f3e777a": "Pokaż mi swój towar, Wilhelmie."
      },
      "name": "Rzemieślnik Wilhelm",
      "translationMetadata": {
