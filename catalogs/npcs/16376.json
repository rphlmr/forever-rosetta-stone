  "locales": {
    "csCZ": {
      "dialogue": {
        "9a80aeafcf74d267a798": "Mistr řemeslník Omarion jedné noci prostě zmizel. Jako prd ve větru... Puf! Pryč! Bah, teď jsem tu jediný, kdo vyrábí výbavu pro hochy v první linii.",
        "be69858257115f3e777a": "Ukaž mi své zboží, Wilhelme."
      },
      "name": "Řemeslník Wilhelm",
      "translationMetadata": {
        "fields": {
