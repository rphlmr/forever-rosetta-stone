  "locales": {
    "csCZ": {
      "dialogue": {
        "02daeb7e4a317e92ea5f": "Vycvičte mě.",
        "099775d73d48e80b1b38": "Nesnažíš se kladivem zabít kovadlinu, ale vyrobit zbraň, kterou zabiješ nepřátele. Ukážu ti, co děláš špatně.",
        "8e2b660b921087738a48": "Naučil ses mnoho, více, než tě mohu naučit já. Jdi za Jamesem Van Bruntem, naučí tě to, co já nedokážu.",
        "f808e6c4a385b5959498": "Doufám, že jednoho dne budu kovat zbraně a zbroj z kostí svých nepřátel."
      },
      "name": "Basil Frye",
      "translationMetadata": {
        "fields": {
