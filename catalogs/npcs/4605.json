    },
    "daDK": {
      "dialogue": {
        "02daeb7e4a317e92ea5f": "Træn mig.",
        "099775d73d48e80b1b38": "Du prøver ikke at dræbe ambolten med din hammer, men at skabe et våben, du kan dræbe dine fjender med. Lad mig vise dig, hvad du gør forkert.",
        "8e2b660b921087738a48": "Du har lært meget, mere end jeg kan lære dig. Gå til James Van Brunt, han vil lære dig det, jeg ikke kan.",
        "f808e6c4a385b5959498": "Jeg håber en dag at kunne smede våben og rustninger af mine fjenders knogler."
      },
      "name": "Basil Frye",
      "translationMetadata": {
        "fields": {
          "dialogue.02daeb7e4a317e92ea5f": {
