    "enUS": {
      "dialogue": {
        "02daeb7e4a317e92ea5f": "Train me.",
        "099775d73d48e80b1b38": "You are not trying to kill the anvil with your hammer, you are trying to create a weapon to kill your foes with. Let me show you what you are doing wrong.",
        "8e2b660b921087738a48": "You have learned much, more than I can teach. Go to James Van Brunt, he will teach you what I cannot.",
        "f808e6c4a385b5959498": "I hope to one day forge weapons and armor from the bones of my enemies."
      },
      "name": "Basil Frye",
      "subName": "Journeyman Blacksmith",
      "translationMetadata": {
