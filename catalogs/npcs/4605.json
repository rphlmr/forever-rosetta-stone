    "svSE": {
      "dialogue": {
        "02daeb7e4a317e92ea5f": "Träna mig.",
        "099775d73d48e80b1b38": "Du försöker inte döda städet med hammaren, utan skapa ett vapen att döda dina fiender med. Låt mig visa vad du gör fel.",
        "8e2b660b921087738a48": "Du har lärt dig mycket, mer än jag kan lära dig. Gå till James Van Brunt, han lär dig det jag inte kan.",
        "f808e6c4a385b5959498": "Jag hoppas att jag en dag ska smida vapen och rustningar av mina fienders ben."
      },
      "name": "Basil Frye",
      "translationMetadata": {
