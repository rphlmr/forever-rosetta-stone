    "plPL": {
      "dialogue": {
        "02daeb7e4a317e92ea5f": "Wyszkol mnie.",
        "099775d73d48e80b1b38": "Nie próbujesz zabić kowadła młotem, tylko stworzyć broń, którą zabijesz wrogów. Pokażę ci, co robisz źle.",
        "8e2b660b921087738a48": "Wiele się nauczyłeś, więcej, niż mogę ci przekazać. Idź do Jamesa Van Brunta, on nauczy cię tego, czego ja nie potrafię.",
        "f808e6c4a385b5959498": "Mam nadzieję, że pewnego dnia będę wykuwać broń i zbroje z kości moich wrogów."
      },
      "name": "Basil Frye",
      "translationMetadata": {
