    "hrHR": {
      "dialogue": {
        "02daeb7e4a317e92ea5f": "Podučite me.",
        "099775d73d48e80b1b38": "Ne pokušavaš ubiti nakovanj čekićem, nego stvoriti oružje kojim ćeš ubijati neprijatelje. Pokazat ću ti što radiš pogrešno.",
        "8e2b660b921087738a48": "Mnogo si naučio, više nego što te ja mogu naučiti. Idi Jamesu Van Bruntu, on će te naučiti što ja ne mogu.",
        "f808e6c4a385b5959498": "Nadam se da ću jednog dana kovati oružje i oklope od kostiju svojih neprijatelja."
      },
      "name": "Basil Frye",
