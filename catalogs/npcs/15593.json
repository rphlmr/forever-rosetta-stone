    "trTR": {
      "dialogue": {
        "0bdc54101d57016907b7": "Elder Starglade’i Stranglethorn Vale’deki Zul’Gurub’un kapıları dışında bulabilirsin.",
        "1165031d4f433fa7e166": "Elder Bellowrage, Blasted Lands’teki bir sırttan Dark Portal’ı gözetliyor.",
        "288db862ff62e4e9cb1e": "Bu çağın yıldızları yeni yollara yöneliyor, gelecek çağlar için umut ve güç ışıkları oluyor.",
        "6848795c6214bb2d6365": "Elder Stormbrow büyük olasılıkla Elwynn Forest’taki Goldshire köyünde.",
        "b36541816cf074b914c6": "Elder Skychaser, Sentinel Hill’in tepesinden Westfall’ı gözetliyor.",
        "f05d59a0259d2620545c": "Winterhoof mu? Booty Bay’de keyif sürdüğünü duydum."
      },
      "name": "Ulu Starsong",
