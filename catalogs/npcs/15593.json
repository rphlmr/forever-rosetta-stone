  "locales": {
    "csCZ": {
      "dialogue": {
        "0bdc54101d57016907b7": "Staršího Stargladea najdeš před branami Zul’Gurubu ve Stranglethorn Vale.",
        "1165031d4f433fa7e166": "Starší Bellowrage dohlíží na Temný portál z hřebene v Blasted Lands.",
        "288db862ff62e4e9cb1e": "Hvězdy tohoto času se vydávají novými cestami, jsou majáky naděje a síly pro nadcházející věky.",
        "6848795c6214bb2d6365": "Starší Stormbrow je nejspíš ve vesnici Goldshire v Elwynn Forest.",
        "b36541816cf074b914c6": "Starší Skychaser shlíží na Westfall z vrcholu Sentinel Hill.",
        "f05d59a0259d2620545c": "Winterhoof? Slyšel jsem, že si užívá v Booty Bay."
      },
      "name": "Starší Starsong",
      "translationMetadata": {
