    "daDK": {
      "dialogue": {
        "0bdc54101d57016907b7": "Du finder Elder Starglade uden for portene til Zul’Gurub i Stranglethorn Vale.",
        "1165031d4f433fa7e166": "Elder Bellowrage holder øje med Den Mørke Portal fra en højderyg i Blasted Lands.",
        "288db862ff62e4e9cb1e": "Stjernerne i denne tid bevæger sig ad nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "6848795c6214bb2d6365": "Elder Stormbrow er sandsynligvis i landsbyen Goldshire i Elwynn Forest.",
        "b36541816cf074b914c6": "Elder Skychaser ser ud over Westfall fra toppen af Sentinel Hill.",
        "f05d59a0259d2620545c": "Winterhoof? Jeg hører, at han rigtig morer sig i Booty Bay."
      },
      "name": "Ældste Starsong",
