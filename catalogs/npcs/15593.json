    "hrHR": {
      "dialogue": {
        "0bdc54101d57016907b7": "Starješinu Stargladea pronaći ćeš pred vratima Zul’Guruba u Stranglethorn Valeu.",
        "1165031d4f433fa7e166": "Starješina Bellowrage motri Mračni portal s grebena u Blasted Landsu.",
        "288db862ff62e4e9cb1e": "Zvijezde ovog doba kreću novim stazama, svjetionici nade i snage za nadolazeća razdoblja.",
        "6848795c6214bb2d6365": "Starješina Stormbrow najvjerojatnije je u selu Goldshire u Elwynn Forestu.",
        "b36541816cf074b914c6": "Starješina Skychaser gleda na Westfall s vrha Sentinel Hilla.",
        "f05d59a0259d2620545c": "Winterhoof? Čujem da uživa u Booty Bayu."
