    "plPL": {
      "dialogue": {
        "0bdc54101d57016907b7": "Starszy Starglade znajduje się przed bramami Zul’Gurub w Stranglethorn Vale.",
        "1165031d4f433fa7e166": "Starszy Bellowrage obserwuje Mroczny Portal z grani w Blasted Lands.",
        "288db862ff62e4e9cb1e": "Gwiazdy tych czasów podążają nowymi drogami, niczym latarnie nadziei i siły dla nadchodzących epok.",
        "6848795c6214bb2d6365": "Starszy Stormbrow jest najpewniej we wsi Goldshire w Elwynn Forest.",
        "b36541816cf074b914c6": "Starszy Skychaser spogląda na Westfall ze szczytu Sentinel Hill.",
        "f05d59a0259d2620545c": "Winterhoof? Słyszałem, że świetnie się bawi w Booty Bay."
      },
      "name": "Starsza Starsong",
