    "svSE": {
      "dialogue": {
        "0bdc54101d57016907b7": "Du hittar Elder Starglade utanför portarna till Zul’Gurub i Stranglethorn Vale.",
        "1165031d4f433fa7e166": "Elder Bellowrage vakar över Dark Portal från en höjdrygg i Blasted Lands.",
        "288db862ff62e4e9cb1e": "Denna tids stjärnor följer nya banor, ljus av hopp och styrka för kommande tidsåldrar.",
        "6848795c6214bb2d6365": "Elder Stormbrow finns troligen i byn Goldshire i Elwynn Forest.",
        "b36541816cf074b914c6": "Elder Skychaser blickar ut över Westfall från toppen av Sentinel Hill.",
        "f05d59a0259d2620545c": "Winterhoof? Jag hör att han lever loppan i Booty Bay."
      },
      "name": "Äldste Starsong",
