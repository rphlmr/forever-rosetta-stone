    "enUS": {
      "dialogue": {
        "0bdc54101d57016907b7": "You'll find Elder Starglade outside the gates to Zul'Gurub in Stranglethorn Vale.",
        "1165031d4f433fa7e166": "Elder Bellowrage watches over the Dark Portal from a ridge in the Blasted Lands.",
        "288db862ff62e4e9cb1e": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "6848795c6214bb2d6365": "Elder Stormbrow is most likely at the village of Goldshire in Elwynn Forest.",
        "b36541816cf074b914c6": "Elder Skychaser looks out over Westfall from atop Sentinel Hill.",
        "f05d59a0259d2620545c": "Winterhoof? I hear he's living it up in Booty Bay."
      },
      "name": "Elder Starsong",
      "translationMetadata": {
