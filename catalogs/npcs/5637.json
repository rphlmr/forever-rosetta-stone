    "ltLT": {
      "dialogue": {
        "53ce6ed81fc95b966e27": "Noriu apžiūrėti tavo prekes.",
        "b147680e16777a857ef0": "Malonu susipažinti, $c. Mano vardas Roetten. Vadovauju Atgavėjų bendrovei.$B$BMano gildija ir aš specializuojamės prarastų daiktų paieškoje. Paprastai samdome drąsius nuotykių ieškotojus ir siunčiame juos atlikti užduočių tiems, kurie patys negali arba neturi laiko.",
        "ea222334d1ee5a6bf4b6": "Išmokyk mane."
      },
      "name": "Roetten Stonehammer",
      "subName": "Atgavėjų bendrovė",
