    "enUS": {
      "dialogue": {
        "53ce6ed81fc95b966e27": "I want to browse your goods.",
        "b147680e16777a857ef0": "Pleased to meetcha, $c. Me name's Roetten. I lead Reclaimers Incorporated.$B$BMe guild and I specialize in aquiring lost goods. We usually hire brave adventurers and send them off to finish tasks for those who aren't able, or don't have the time.",
        "ea222334d1ee5a6bf4b6": "Train me."
      },
      "name": "Roetten Stonehammer",
      "subName": "Reclaimers Inc.",
