    "daDK": {
      "dialogue": {
        "53ce6ed81fc95b966e27": "Jeg vil gerne se dine varer.",
        "b147680e16777a857ef0": "Hyggeligt at møde dig, $c. Jeg hedder Roetten. Jeg leder Reclaimers Incorporated.$B$BMit gilde og jeg har specialiseret os i at skaffe tabte varer tilbage. Vi hyrer som regel modige eventyrere til at udføre opgaver for dem, der ikke kan eller ikke har tid.",
        "ea222334d1ee5a6bf4b6": "Træn mig."
      },
      "name": "Roetten Stonehammer",
      "translationMetadata": {
        "fields": {
