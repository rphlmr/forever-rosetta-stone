    "hrHR": {
      "dialogue": {
        "53ce6ed81fc95b966e27": "Želim pogledati vašu robu.",
        "b147680e16777a857ef0": "Drago mi je, $c. Zovem se Roetten. Vodim Reclaimers Incorporated.$B$BMoj ceh i ja specijalizirani smo za pronalaženje izgubljene robe. Obično unajmljujemo hrabre pustolove da obave zadatke za one koji ne mogu ili nemaju vremena.",
        "ea222334d1ee5a6bf4b6": "Podučite me."
      },
      "name": "Roetten Stonehammer",
