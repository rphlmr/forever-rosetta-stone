  "locales": {
    "csCZ": {
      "dialogue": {
        "53ce6ed81fc95b966e27": "Chci si prohlédnout vaše zboží.",
        "b147680e16777a857ef0": "Rád tě poznávám, $c. Jmenuju se Roetten. Vedu Reclaimers Incorporated.$B$BS mou gildou se specializujeme na získávání ztraceného zboží. Obvykle najímáme odvážné dobrodruhy a posíláme je plnit úkoly pro ty, kdo to nedokážou nebo nemají čas.",
        "ea222334d1ee5a6bf4b6": "Vycvičte mě."
      },
      "name": "Roetten Stonehammer",
      "translationMetadata": {
        "fields": {
          "dialogue.53ce6ed81fc95b966e27": {
            "origin": "ai",
