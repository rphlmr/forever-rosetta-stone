    "deDE": {
      "dialogue": {
        "df4f270added13c144a2": "Willkommen. Ich bin Chronos - der, der niemals vergisst. Mein Gedächtnis ist unfehlbar. Ich vermag mich an jedes noch so kleine Detail eines Ereignisses zu erinnern.\n\nVertraut mir."
      },
      "name": "Chronos",
      "subName": "Der der niemals vergisst!",
