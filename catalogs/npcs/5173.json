    "hrHR": {
      "dialogue": {
        "13a685b1ff43fe94fb86": "Strogom sam preobukom mnoge učenike morao odviknuti od svega što su ranije naučili kako bih ih mogao poučiti iznova. Ta usluga postaje sve teža svaki put, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "3009cc23fc3ef33d1cd4": "Zanima me poduka u umijeću vještaca.",
        "538dc7f9cfed0045b960": "Tama te ne grli, $c. Prestani brbljati i gubi mi se s očiju! Odlazi!",
        "c54a21201071955e878e": "Arkana kvari samo slabe. Nastavi s obukom ili bi te mogla zadesiti slična sudbina.",
        "c634117ed55337e0a240": "Zanima me poduka u umijeću vještaca.",
        "f773fbd6df4a0e87b453": "Dopustite mi da pogledam vašu robu."
      },
      "name": "Alexander Calder",
