    "enUS": {
      "dialogue": {
        "13a685b1ff43fe94fb86": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "3009cc23fc3ef33d1cd4": "I am interested in warlock training.",
        "538dc7f9cfed0045b960": "The darkness does not embrace you, $c.  Cease your prattle and remove yourself from my sight!  Be gone!",
        "c54a21201071955e878e": "The arcane only corrupts those who are weak. Keep up on your training, or you may find a similar fate.",
        "c634117ed55337e0a240": "I am interested in warlock training.",
        "f773fbd6df4a0e87b453": "Let me browse your goods."
      },
      "name": "Alexander Calder",
      "subName": "Warlock Trainer",
      "translationMetadata": {
