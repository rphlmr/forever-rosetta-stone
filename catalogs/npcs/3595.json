    "plPL": {
      "dialogue": {
        "051bde08f7a4f77a03c9": "W ramach rygorystycznego przekwalifikowania musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc szkolić ich od nowa. Usługa ta staje się coraz trudniejsza za każdym razem, dlatego każde kolejne przekwalifikowanie kosztuje więcej. Czy chcesz, abym oduczyła cię poznanych talentów?",
        "27aaf11bfd4bc4c31bd0": "Niech Elune będzie z tobą, $c.",
        "5f473710552badcd1c4f": "Moja mądrość i wiedza są do twojej dyspozycji. Co mogę dla ciebie zrobić, $n?",
        "c73c995e8ee7dd60f6fc": "Szukam dalszego szkolenia w sztuce kapłańskiej."
      },
      "name": "Shanda",
      "translationMetadata": {
        "fields": {
