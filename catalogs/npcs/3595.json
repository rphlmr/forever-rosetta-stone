    "ltLT": {
      "dialogue": {
        "051bde08f7a4f77a03c9": "Griežtai permokydama turėjau priversti daugelį mokinių pamiršti viską, ko jie anksčiau išmoko, kad galėčiau mokyti juos iš naujo. Kaskart suteikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori pamiršti išmoktus talentus?",
        "27aaf11bfd4bc4c31bd0": "Tebūna Elune su tavimi, $c.",
        "5f473710552badcd1c4f": "Mano išmintis ir žinios yra tavo. Kuo galiu tau padėti, $n?",
        "c73c995e8ee7dd60f6fc": "Noriu daugiau išmokti žynių meno."
      },
      "name": "Shanda",
      "subName": "Žynių mokytoja",
