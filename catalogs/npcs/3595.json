  "locales": {
    "csCZ": {
      "dialogue": {
        "051bde08f7a4f77a03c9": "Přísným přeškolováním jsem musela mnohé studenty odnaučit všemu, co se dříve naučili, abych je mohla učit znovu. Tato služba je pokaždé těžší, a proto je také s každým přeškolením dražší. Přeješ si, abych tě odnaučila talentům, které ses naučil?",
        "27aaf11bfd4bc4c31bd0": "Elune s tebou, $c.",
        "5f473710552badcd1c4f": "Má moudrost i znalosti jsou ti k dispozici. Co pro tebe mohu udělat, $n?",
        "c73c995e8ee7dd60f6fc": "Hledám další výcvik v kněžském umění."
      },
      "name": "Shanda",
      "translationMetadata": {
        "fields": {
          "dialogue.051bde08f7a4f77a03c9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
