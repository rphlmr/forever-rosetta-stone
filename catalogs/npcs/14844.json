    "daDK": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Netop ankommet... endnu et parti Darkmoon Special Reserve. Kom og hent din, før det hele er væk!",
        "280df4ad7ed16da73244": "Drikkepenge modtages altid med tak, ven.",
        "6e00d28904f5b38d1a8c": "Vær ikke genert, giv en omgang til alle!",
        "a41a28594085470b51b7": "Lækre drikke til salg! Sluk tørsten med nogle af Darkmoon Faires bedste bryg!",
        "cf4e3340c9547566d570": "Vis mig drikkevarerne!"
      },
      "name": "Sylannia",
      "translationMetadata": {
        "fields": {
