    "plPL": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Właśnie dotarła kolejna partia specjalnej rezerwy Darkmoon. Kup swoją, zanim wszystko zniknie!",
        "280df4ad7ed16da73244": "Napiwki zawsze przyjmuję z wdzięcznością, przyjacielu.",
        "6e00d28904f5b38d1a8c": "Nie wstydź się, postaw wszystkim kolejkę!",
        "a41a28594085470b51b7": "Smaczne napoje na sprzedaż! Ugaś pragnienie najlepszymi trunkami z jarmarku Darkmoon!",
        "cf4e3340c9547566d570": "Pokaż mi napoje!"
      },
      "name": "Sylannia",
