    "hrHR": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Upravo je stigla još jedna pošiljka posebne rezerve Darkmoona. Dođi po svoju prije nego što sve nestane!",
        "280df4ad7ed16da73244": "Napojnice uvijek rado primam, prijatelju.",
        "6e00d28904f5b38d1a8c": "Ne stidi se, počasti sve rundom!",
        "a41a28594085470b51b7": "Ukusna pića na prodaju! Ugasi žeđ najboljim napicima sajma Darkmoon!",
        "cf4e3340c9547566d570": "Pokaži mi pića!"
      },
      "name": "Sylannia",
