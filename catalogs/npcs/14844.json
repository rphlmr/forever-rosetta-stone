    "enUS": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Just in... another batch of Darkmoon Special Reserve.  Come get yours before they're all gone!",
        "280df4ad7ed16da73244": "Tips are always graciously accepted, friend.",
        "6e00d28904f5b38d1a8c": "Don't be shy, buy a round for everyone!",
        "a41a28594085470b51b7": "Tasty drinks for sale!  Quench your thirst on some of the Darkmoon Faire's finest brews!",
        "cf4e3340c9547566d570": "Show me the drinks!"
      },
      "name": "Sylannia",
      "subName": "Darkmoon Faire Drink Vendor",
