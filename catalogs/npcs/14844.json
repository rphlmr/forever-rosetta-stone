    "trTR": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Yeni geldi... bir parti daha Darkmoon Özel Rezervi. Hepsi tükenmeden sen de al!",
        "280df4ad7ed16da73244": "Bahşişler her zaman memnuniyetle kabul edilir, dostum.",
        "6e00d28904f5b38d1a8c": "Çekinme, herkese birer içki ısmarla!",
        "a41a28594085470b51b7": "Lezzetli içecekler satılır! Darkmoon Panayırının en iyi içkileriyle susuzluğunu gider!",
        "cf4e3340c9547566d570": "İçkileri göster!"
      },
      "name": "Sylannia",
