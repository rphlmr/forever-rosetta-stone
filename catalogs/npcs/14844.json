    "ltLT": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Ką tik atkeliavo... dar viena ypatingojo Darkmoon atsargų gėrimo siunta.  Paskubėk įsigyti, kol dar neišgraibstė!",
        "280df4ad7ed16da73244": "Arbatpinigius visada maloniai priimu, bičiuli.",
        "6e00d28904f5b38d1a8c": "Nesidrovėk, nupirk visiems po bokalą!",
        "a41a28594085470b51b7": "Parduodu gardžius gėrimus!  Numalšink troškulį vienu iš geriausių Darkmoon mugės gėrimų!",
        "cf4e3340c9547566d570": "Parodyk man gėrimus!"
      },
      "name": "Sylannia",
      "subName": "Darkmoon mugės gėrimų pardavėja",
