    "ptBR": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Acabou de sair! É a Reserva Especial de Negraluna. Venha logo antes que acabe!",
        "280df4ad7ed16da73244": "Gorjetas são sempre bem-vindas, gente boa.",
        "6e00d28904f5b38d1a8c": "Deixa a timidez de lado e paga uma rodada pra galera!",
        "a41a28594085470b51b7": "Olha a cervejinha gelada! Mate a sede com as melhores cervejas da Feira de Negraluna!",
        "cf4e3340c9547566d570": "Mostre-me as bebidas!"
      },
      "name": "Sylannia",
      "subName": "Bebidas de Negraluna",
