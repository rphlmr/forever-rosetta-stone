    "svSE": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Just inkommet... ännu en sats Darkmoon Special Reserve. Kom och köp innan allt är slut!",
        "280df4ad7ed16da73244": "Dricks tas alltid tacksamt emot, vännen.",
        "6e00d28904f5b38d1a8c": "Var inte blyg, bjud alla på en omgång!",
        "a41a28594085470b51b7": "Goda drycker till salu! Släck törsten med några av Darkmoon Faires bästa brygder!",
        "cf4e3340c9547566d570": "Visa mig dryckerna!"
      },
      "name": "Sylannia",
