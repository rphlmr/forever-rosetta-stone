  "locales": {
    "csCZ": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Právě dorazila další várka speciální rezervy Darkmoon. Přijď si pro svou, než dojde!",
        "280df4ad7ed16da73244": "Spropitné vždy vděčně přijímám, příteli.",
        "6e00d28904f5b38d1a8c": "Nestyď se, kup všem rundu!",
        "a41a28594085470b51b7": "Lahodné nápoje na prodej! Uhas žízeň těmi nejlepšími nápoji z Darkmoon Faire!",
        "cf4e3340c9547566d570": "Ukaž mi nápoje!"
      },
      "name": "Sylannia",
      "translationMetadata": {
