    "esES": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Solo... Otra tanda de Gran Reserva Luna Negra. ¡Ven a por la tuya antes de que se acaben todas!",
        "280df4ad7ed16da73244": "Siempre se aceptan propinas, camarada.",
        "6e00d28904f5b38d1a8c": "¡Olvida tu timidez, invita a una ronda para todos!",
        "a41a28594085470b51b7": "¡Deliciosas bebidas a la venta! Sacia tu sed con algunos de los mejores brebajes de la Feria de la Luna Negra.",
        "cf4e3340c9547566d570": "¡Muéstrame las bebidas!"
      },
      "name": "Sylannia",
      "subName": "Vendedor de bebidas de la Feria de la Luna Negra",
