    "deDE": {
      "dialogue": {
        "0e921a32bdb8011b99e2": "Gerade eingetroffen… eine weitere Ladung unserer Dunkelmond-Spezialmischung. Kommt und holt sie euch, bevor nichts mehr da ist!",
        "280df4ad7ed16da73244": "Ein kleines Trinkgeld ist immer willkommen, mein Freund!",
        "6e00d28904f5b38d1a8c": "Nur keine Scheu, schmeißt eine Runde für alle!",
        "a41a28594085470b51b7": "Zum Trinken nur das Beste! Stillt Euren Durst mit den edelsten Bieren des Dunkelmond-Jahrmarkts!",
        "cf4e3340c9547566d570": "Zeigt mir die Getränke!"
      },
      "name": "Sylannia",
      "subName": "Getränkeverkäufer des Dunkelmond-Jahrmarkts",
