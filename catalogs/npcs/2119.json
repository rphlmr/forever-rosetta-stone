  "locales": {
    "csCZ": {
      "dialogue": {
        "3199ca0371eb030f8dc8": "Potřebuji výcvik válečníka.",
        "8a904e3dd809bfb37c83": "Při důkladném přeškolování jsem musel mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým opakováním těžší provést. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "987010724cfb240fc01c": "Úkolem válečníka je chránit. Stejně jako v bitvě chráníme své druhy, musíme chránit i zájmy Opuštěných.",
        "fe698944ef059494e627": "Neztrácej můj čas, $c."
      },
      "name": "Dannal Stern",
      "translationMetadata": {
        "fields": {
          "dialogue.3199ca0371eb030f8dc8": {
