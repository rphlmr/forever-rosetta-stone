    },
    "daDK": {
      "dialogue": {
        "3199ca0371eb030f8dc8": "Jeg har brug for krigertræning.",
        "8a904e3dd809bfb37c83": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?",
        "987010724cfb240fc01c": "Krigerens rolle er at beskytte. Ligesom vi beskytter vores landsmænd i kamp, må vi også beskytte de Forsagtes interesser.",
        "fe698944ef059494e627": "Spild ikke min tid, $c."
      },
      "name": "Dannal Stern",
      "translationMetadata": {
        "fields": {
