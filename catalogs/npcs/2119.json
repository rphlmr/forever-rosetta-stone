    "ltLT": {
      "dialogue": {
        "3199ca0371eb030f8dc8": "Noriu mokytis kario įgūdžių.",
        "8a904e3dd809bfb37c83": "Griežtai permokydamas ne vieną mokinį turėjau priversti pamiršti visa, ko jie buvo išmokę, kad galėčiau mokyti iš naujo. Kaskart teikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "987010724cfb240fc01c": "Kario pareiga – saugoti. Kaip mūšyje saugome savo bendražygius, taip privalome saugoti ir Forsaken interesus.",
        "fe698944ef059494e627": "Nešvaistyk mano laiko, $c."
      },
      "name": "Dannal Stern",
      "subName": "Karių mokytojas",
