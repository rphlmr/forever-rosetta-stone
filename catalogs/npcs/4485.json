  "locales": {
    "csCZ": {
      "dialogue": {
        "387fce4ee3132dfd4695": "Rád bych si prohlédl vaše zboží.",
        "404f7328e352e1c08b18": "Dny se vlečou a konec konfliktů v těchto zemích stále není v dohledu. Na to člověk nemusí být kouzelníkem. Chop se zbraně, dokud můžeš, $c. Válka může kdykoli zaklepat na naše dveře, a nemýlím-li se, vypadáš jako někdo, kdo si ji užívá.",
        "9428d15f475109a9c8e1": "Vycvičte mě."
      },
      "name": "Belgrom Rockmaul",
      "translationMetadata": {
        "fields": {
          "dialogue.387fce4ee3132dfd4695": {
            "origin": "ai",
