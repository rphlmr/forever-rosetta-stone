    "daDK": {
      "dialogue": {
        "387fce4ee3132dfd4695": "Jeg vil gerne se dine varer.",
        "404f7328e352e1c08b18": "Dagene bliver lange, og der er stadig ingen ende i sigte på konflikterne i disse lande. Det kræver ingen troldmand at se. Grib et sværd, mens du kan, $c. Krigen kan komme til vores dør når som helst, og hvis jeg ikke tager fejl, ser du ud til at nyde den.",
        "9428d15f475109a9c8e1": "Træn mig."
      },
      "name": "Belgrom Rockmaul",
      "translationMetadata": {
        "fields": {
          "dialogue.387fce4ee3132dfd4695": {
            "origin": "ai",
