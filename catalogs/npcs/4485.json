    "enUS": {
      "dialogue": {
        "387fce4ee3132dfd4695": "I want to browse your goods.",
        "404f7328e352e1c08b18": "The days grow long, and still no end to the conflicts of these lands can be seen. It takes no spell caster to know that much. Take up a blade while you can, $c. War can come to our doors at any time, and if I'm not mistaken, you look to be one who revels in it.",
        "9428d15f475109a9c8e1": "Train me."
      },
      "name": "Belgrom Rockmaul",
      "translationMetadata": {
        "fields": {
          "dialogue.387fce4ee3132dfd4695": {
            "origin": "community",
