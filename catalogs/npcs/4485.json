    "esES": {
      "dialogue": {
        "387fce4ee3132dfd4695": "Quiero ver tus mercancías.",
        "404f7328e352e1c08b18": "Los días se hacen largos y aún no se ve el final de los conflictos de estas tierras. No hace falta ser hechicero para saberlo. Coge una espada mientras puedas, $c. La guerra puede llegar a nuestras puertas en cualquier momento, y si no me equivoco, pareces ser de los que se deleitan con ella.",
        "9428d15f475109a9c8e1": "Entréname."
      },
      "name": "Belgrom Destrozarroca",
      "translationMetadata": {
        "fields": {
