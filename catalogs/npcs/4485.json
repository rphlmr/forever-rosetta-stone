    },
    "ptBR": {
      "dialogue": {
        "387fce4ee3132dfd4695": "Quero ver suas mercadorias.",
        "404f7328e352e1c08b18": "Os dias se arrastam, e ainda não se vê o fim dos conflitos destas terras. Não é preciso ser conjurador para saber disso. Empunhe uma lâmina enquanto pode, $c. A guerra pode chegar à nossa porta a qualquer momento e, se não me engano, você parece ser alguém que gosta dela.",
        "9428d15f475109a9c8e1": "Treine-me."
      },
      "name": "Belgrom Pedramalho",
      "translationMetadata": {
