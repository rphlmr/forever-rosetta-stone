    },
    "plPL": {
      "dialogue": {
        "387fce4ee3132dfd4695": "Chcę przejrzeć twoje towary.",
        "404f7328e352e1c08b18": "Dni mijają, a końca konfliktów na tych ziemiach nadal nie widać. Nie trzeba być czarodziejem, by to dostrzec. Chwyć za broń, póki możesz, $c. Wojna może zapukać do naszych drzwi w każdej chwili, a jeśli się nie mylę, wyglądasz na kogoś, kto ją uwielbia.",
        "9428d15f475109a9c8e1": "Wyszkol mnie."
      },
      "name": "Belgrom Rockmaul",
      "translationMetadata": {
        "fields": {
