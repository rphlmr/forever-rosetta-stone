    "ltLT": {
      "dialogue": {
        "387fce4ee3132dfd4695": "Noriu apžiūrėti tavo prekes.",
        "404f7328e352e1c08b18": "Dienos slenka, o šių žemių konfliktams vis dar nematyti pabaigos. Tam suprasti nereikia būti kerėtoju. Griebk ginklą, kol dar gali, $c. Karas bet kada gali pasibelsti į mūsų duris, o tu, jei neklystu, atrodai kaip tas, kuriam jis teikia džiaugsmo.",
        "9428d15f475109a9c8e1": "Pamokyk mane."
      },
      "name": "Belgrom Rockmaul",
      "translationMetadata": {
        "fields": {
