    "ptBR": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Tente não chamar muita atenção, estou esperando uma audiência com o Rei. Não que eu me importe de esperar. Me sinto bem segura com todos esses guardas parrudos por aí."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
