            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Försök att inte dra till dig för mycket uppmärksamhet. Jag väntar på att kungen ska ge mig audiens. Jag har inget emot att vänta, jag känner mig rätt trygg bland alla dessa kraftiga vakter."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
