          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Staraj się nie zwracać na siebie zbytniej uwagi, czekam, aż król udzieli mi audiencji. Nie przeszkadza mi czekanie, czuję się całkiem bezpiecznie wśród tych krzepkich strażników."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
