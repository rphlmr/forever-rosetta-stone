        }
      }
    },
    "esES": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Intenta no llamar mucho la atención. Estoy esperando a que el Rey me dé audiencia. No es que me importe esperar... de hecho, me siento bastante segura rodeada de todos estos fornidos guardias."
      },
      "name": "Deliana",
      "translationMetadata": {
