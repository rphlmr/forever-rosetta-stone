            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Fazla dikkat çekmemeye çalış, kralın beni huzuruna kabul etmesini bekliyorum. Beklemekten şikâyetçi değilim, bunca iriyarı muhafızın arasında kendimi oldukça güvende hissediyorum."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
