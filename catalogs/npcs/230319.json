            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Намагайся не привертати зайвої уваги, я чекаю, поки король прийме мене на аудієнції. Не те щоб я була проти чекання: серед усіх цих дужих вартових я почуваюся цілком безпечно."
      },
      "name": "Деліана",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
