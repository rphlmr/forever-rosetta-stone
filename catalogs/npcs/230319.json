        }
      }
    },
    "itIT": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Cerca di non dare troppo nell'occhio, sto aspettando che il Re mi conceda udienza. Non che aspettare mi dispiaccia, mi sento piuttosto al sicuro in mezzo a tutte queste guardie nerborute."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
