    "csCZ": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Snaž se na sebe příliš neupozorňovat, čekám, až mě král přijme. Čekání mi nevadí, mezi všemi těmi statnými strážemi se cítím docela bezpečně."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
