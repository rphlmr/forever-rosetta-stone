    "hrHR": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Pokušaj ne privlačiti previše pozornosti, čekam da me kralj primi. Ne smeta mi čekanje, osjećam se prilično sigurno uz sve ove krupne stražare."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
