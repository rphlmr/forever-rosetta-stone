    "enUS": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Try not to draw too much attention, I'm waiting for the King to grant me audience.  Not that I mind waiting, I feel pretty safe around all these burly guards."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
            "origin": "community",
            "source": "Spoken",
