      }
    },
    "daDK": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Prøv ikke at tiltrække for meget opmærksomhed. Jeg venter på, at kongen giver mig audiens. Ikke fordi jeg har noget imod at vente, jeg føler mig ret tryg blandt alle de kraftige vagter."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
