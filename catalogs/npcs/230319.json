    "frFR": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Essayez de ne pas trop attirer l’attention. J’attends que le roi m’accorde une audience. Cela ne m’ennuie pas du tout de patienter, je me sens en sécurité avec tous ces gardes costauds autour de moi."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
