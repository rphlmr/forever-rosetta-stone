      }
    },
    "ltLT": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Pasistenk neatkreipti per daug dėmesio, laukiu, kol karalius mane priims.  Ne tai, kad man nepatiktų laukti, šalia šių kresnų sargybinių jaučiuosi gana saugiai."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
