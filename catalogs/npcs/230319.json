            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "5bad3378fc7f1c2f8011": "Bleibt unauffällig, ich warte darauf, dass der König mir eine Audienz gewährt. Das Warten macht mir aber nichts aus, ich fühle mich zwischen all diesen stämmigen Wachen recht sicher."
      },
      "name": "Deliana",
      "translationMetadata": {
        "fields": {
          "dialogue.5bad3378fc7f1c2f8011": {
