    },
    "daDK": {
      "dialogue": {
        "7076834dffe15216caf1": "Denne kaj her? Tja, her kan du tage skibet til det der natteelversted. Hvad hedder det nu? Øh, Auberdine, tror jeg. Jeg ved det ikke rigtigt, jeg læsser bare ting af og på."
      },
      "name": "Don Pompa",
      "translationMetadata": {
        "fields": {
