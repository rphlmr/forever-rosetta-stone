    "plPL": {
      "dialogue": {
        "7076834dffe15216caf1": "Ten dok? Cóż, możesz stąd złapać statek do tej osady nocnych elfów. Jak ona się nazywa? Eee, chyba Auberdine. Nie wiem na pewno, ja tylko ładuję i rozładowuję towary."
      },
      "name": "Don Pompa",
      "translationMetadata": {
