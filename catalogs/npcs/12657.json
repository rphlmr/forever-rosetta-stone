    "hrHR": {
      "dialogue": {
        "7076834dffe15216caf1": "Ovaj dok ovdje? Pa, možeš uhvatiti brod koji ide do onog mjesta noćnih vilenjaka. Kako se ono zove? Uh, mislim da je Auberdine. Nisam baš siguran, ja samo utovarujem i istovarujem stvari."
      },
      "name": "Don Pompa",
      "translationMetadata": {
