    "ptBR": {
      "dialogue": {
        "7076834dffe15216caf1": "Esta doca? Bem, aqui você embarca para aquele lugar dos elfos noturnos. Qual o nome? Ah, acho que é Auberdine. Não tenho muita certeza, eu só carrego e descarrego os troços."
      },
      "name": "Dom Pompa",
