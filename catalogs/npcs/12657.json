  "locales": {
    "csCZ": {
      "dialogue": {
        "7076834dffe15216caf1": "Tady ten přístav? No, můžeš tu chytit loď do toho místa nočních elfů. Jak se jmenuje? Ehm, myslím, že Auberdine. Vlastně to nevím jistě, jen nakládám a vykládám věci."
      },
      "name": "Don Pompa",
      "translationMetadata": {
