    "enUS": {
      "dialogue": {
        "7076834dffe15216caf1": "This dock here?  Well you can catch the ship that goes to that Night Elf place.  What's it's name?  Uhh Auberdine I think.  I don't really know for sure, I just load and unload stuff."
      },
      "name": "Don Pompa",
      "translationMetadata": {
        "fields": {
          "dialogue.7076834dffe15216caf1": {
