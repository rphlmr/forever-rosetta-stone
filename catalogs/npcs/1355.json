    "daDK": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Træn mig.",
        "29577cf127171b703a7b": "Dirge Quikcleave fra Gadgetzan er mester i kogekunst. Du må opsøge ham for at blive bedre.",
        "cac3b52ed3cf1bee72a5": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler samme lidenskab!",
        "def9211d3a49296b85cd": "Jeg kan lære dig at lave mad!",
        "ebf425df153eeaf5eb65": "Opsøg Shandrina i Silverwind Refuge. Hun kan sælge dig „Ekspertkogebogen“."
      },
      "name": "Kok Ghilm",
