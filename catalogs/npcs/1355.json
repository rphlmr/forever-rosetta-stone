    "hrHR": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Podučite me.",
        "29577cf127171b703a7b": "Dirge Quikcleave iz Gadgetzana majstor je kulinarskog umijeća. Ako želiš napredovati, moraš ga potražiti.",
        "cac3b52ed3cf1bee72a5": "Kuhanje je životni poziv i vidim da dijelimo istu strast!",
        "def9211d3a49296b85cd": "Mogu te naučiti kuhati!",
        "ebf425df153eeaf5eb65": "Potraži Shandrinu u utočištu Silverwind. Ona ti može prodati „Kuharicu za stručnjake“."
      },
      "name": "Kuhar Ghilm",
