    "ptBR": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Treine-me.",
        "29577cf127171b703a7b": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "cac3b52ed3cf1bee72a5": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "def9211d3a49296b85cd": "Eu posso ensinar você a cozinhar!",
        "ebf425df153eeaf5eb65": "Encontre Shandrina no Refúgio Brisaprata. Ela pode lhe vender o \"Livro de Receitas do Perito\"."
      },
      "name": "Cozinheiro Ghilm",
      "subName": "Treinamento de Culinária",
