    "itIT": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Addestrami.",
        "29577cf127171b703a7b": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "cac3b52ed3cf1bee72a5": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "def9211d3a49296b85cd": "Posso insegnarti a cucinare!",
        "ebf425df153eeaf5eb65": "Cerca Shandrina al Rifugio di Silverwind. Può venderti il \"Ricettario per Esperti\"."
      },
      "name": "Cuoco Ghilm",
