    "esES": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Entréname.",
        "29577cf127171b703a7b": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "cac3b52ed3cf1bee72a5": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión.",
        "def9211d3a49296b85cd": "Puedo enseñarte a cocinar.",
        "ebf425df153eeaf5eb65": "Busca a Shandrina en el Refugio Brisa de Plata. Te puede vender el \"Recetario para expertos\"."
      },
      "name": "Cocinero Ghilm",
      "subName": "Instructor de cocina",
