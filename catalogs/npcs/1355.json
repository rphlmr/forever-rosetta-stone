    "trTR": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Beni eğit.",
        "29577cf127171b703a7b": "Gadgetzanlı Dirge Quikcleave, aşçılık sanatında bir ustadır. Kendini geliştirmek için onu bulmalısın.",
        "cac3b52ed3cf1bee72a5": "Yemek pişirmek ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "def9211d3a49296b85cd": "Sana yemek pişirmeyi öğretebilirim!",
        "ebf425df153eeaf5eb65": "Silverwind Refuge’deki Shandrina’yı bul. Sana „Uzman Yemek Kitabı“ satabilir."
      },
      "name": "Aşçı Ghilm",
