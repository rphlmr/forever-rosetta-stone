    "svSE": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Träna mig.",
        "29577cf127171b703a7b": "Dirge Quikcleave i Gadgetzan är en mästare inom kokkonsten. För att bli bättre måste du söka upp honom.",
        "cac3b52ed3cf1bee72a5": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!",
        "def9211d3a49296b85cd": "Jag kan lära dig att laga mat!",
        "ebf425df153eeaf5eb65": "Sök upp Shandrina i Silverwind Refuge. Hon kan sälja dig ”Expertkokboken”."
      },
      "name": "Kock Ghilm",
