    "plPL": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Wyszkol mnie.",
        "29577cf127171b703a7b": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odnaleźć.",
        "cac3b52ed3cf1bee72a5": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!",
        "def9211d3a49296b85cd": "Mogę cię nauczyć gotować!",
        "ebf425df153eeaf5eb65": "Odszukaj Shandrinę w Silverwind Refuge. Może ci sprzedać „Książkę kucharską eksperta”."
      },
      "name": "Kucharz Ghilm",
      "translationMetadata": {
