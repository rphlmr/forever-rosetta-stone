    "enUS": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Train me.",
        "29577cf127171b703a7b": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "cac3b52ed3cf1bee72a5": "Cooking is a life long pursuit and I see we share the same passion!",
        "def9211d3a49296b85cd": "I can teach you how to cook!",
        "ebf425df153eeaf5eb65": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\"."
      },
      "name": "Cook Ghilm",
      "subName": "Cooking Trainer",
