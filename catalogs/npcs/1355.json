    "frFR": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Entraînez-moi.",
        "29577cf127171b703a7b": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "cac3b52ed3cf1bee72a5": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "def9211d3a49296b85cd": "Je peux vous apprendre à cuisiner !",
        "ebf425df153eeaf5eb65": "Allez voir Shandrina au refuge de Vent-argent. Elle pourra vous vendre un livre de cuisine pour experts."
      },
      "name": "Cuisinier Ghilm",
      "subName": "Maître des cuisiniers",
