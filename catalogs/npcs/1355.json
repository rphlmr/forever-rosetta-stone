    "deDE": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Bildet mich aus.",
        "29577cf127171b703a7b": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen.",
        "cac3b52ed3cf1bee72a5": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "def9211d3a49296b85cd": "Ich kann Euch das Kochen beibringen!",
        "ebf425df153eeaf5eb65": "Sucht nach Shandrina in der Silberwindzuflucht. Sie kann Euch das \"Expertenkochbuch\" verkaufen."
      },
      "name": "Koch Ghilm",
      "subName": "Kochkunstlehrer",
      "translationMetadata": {
