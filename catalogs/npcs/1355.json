  "locales": {
    "csCZ": {
      "dialogue": {
        "11f3a2a9cc51e6f93bed": "Vycvičte mě.",
        "29577cf127171b703a7b": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Pokud se chceš zlepšit, musíš ho vyhledat.",
        "cac3b52ed3cf1bee72a5": "Vaření je celoživotní cesta a vidím, že sdílíme stejnou vášeň!",
        "def9211d3a49296b85cd": "Mohu tě naučit vařit!",
        "ebf425df153eeaf5eb65": "Vyhledej Shandrinu v Útočišti Stříbrného větru. Může ti prodat „Kuchařku pro experty“."
      },
      "name": "Kuchař Ghilm",
