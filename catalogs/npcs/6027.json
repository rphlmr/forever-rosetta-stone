    "csCZ": {
      "dialogue": {
        "62babd79f25e8b5bc8c3": "Ukažte mi svou nabídku grimoárů.",
        "b05a67dedefefcf2ec78": "Chceš posílit své démony? Bude tě to něco stát, ale jsi na správném místě.",
        "efa9aa2298600d337b9b": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!"
      },
      "name": "Kitha",
      "translationMetadata": {
