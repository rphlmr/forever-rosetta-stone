    "daDK": {
      "dialogue": {
        "62babd79f25e8b5bc8c3": "Vis mig dit udvalg af grimoirer.",
        "b05a67dedefefcf2ec78": "Vil du gøre dine dæmoner stærkere? Det koster dig noget, men du er kommet til det rette sted.",
        "efa9aa2298600d337b9b": "Du er ingen troldmand, og jeg har ikke tid til dig. Forsvind!"
      },
      "name": "Kitha",
      "translationMetadata": {
