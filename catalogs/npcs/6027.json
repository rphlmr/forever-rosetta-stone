    "enUS": {
      "dialogue": {
        "62babd79f25e8b5bc8c3": "Show me your selection of grimoires.",
        "b05a67dedefefcf2ec78": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place.",
        "efa9aa2298600d337b9b": "You're no warlock and I've no time for you.  Begone!"
      },
      "name": "Kitha",
      "subName": "Demon Trainer",
