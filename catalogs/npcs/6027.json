    "trTR": {
      "dialogue": {
        "62babd79f25e8b5bc8c3": "Bana büyü kitabı seçkini göster.",
        "b05a67dedefefcf2ec78": "İblislerini daha güçlü yapmak mı istiyorsun? Sana pahalıya patlar, ama doğru yere geldin.",
        "efa9aa2298600d337b9b": "Sen bir büyücü değilsin ve sana ayıracak vaktim yok. Defol!"
      },
