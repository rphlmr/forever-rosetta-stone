    "deDE": {
      "dialogue": {
        "62babd79f25e8b5bc8c3": "Zeigt mir Eure Auswahl an Grimoires.",
        "b05a67dedefefcf2ec78": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "efa9aa2298600d337b9b": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!"
      },
      "name": "Kitha",
      "subName": "Dämonenausbilderin",
