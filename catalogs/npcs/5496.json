  "locales": {
    "csCZ": {
      "dialogue": {
        "031b921ed1bb12ac5781": "Mám zájem o výcvik v umění černokněžníků.",
        "04073c6f64c2f4e77b56": "Mám zájem o výcvik v umění černokněžníků.",
        "1283b80fefb769143d49": "Tajemná magie kazí jen slabé. Pokračuj ve výcviku, jinak tě může potkat podobný osud.",
        "67ef3c3f0838338047b9": "Temnota tě neobjímá, $c. Přestaň žvanit a zmiz mi z očí! Pryč!",
        "d4b703da893c20585bfa": "Přísným přeškolením jsem musel mnoho žáků odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvým talentům?"
      },
      "name": "Sandahl",
      "translationMetadata": {
        "fields": {
          "dialogue.031b921ed1bb12ac5781": {
