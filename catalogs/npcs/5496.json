    "daDK": {
      "dialogue": {
        "031b921ed1bb12ac5781": "Jeg er interesseret i træning som troldmand.",
        "04073c6f64c2f4e77b56": "Jeg er interesseret i træning som troldmand.",
        "1283b80fefb769143d49": "Arkan magi fordærver kun de svage. Fortsæt din træning, ellers kan du lide en lignende skæbne.",
        "67ef3c3f0838338047b9": "Mørket omfavner dig ikke, $c. Hold op med at plapre og forsvind fra mit åsyn! Forsvind!",
        "d4b703da893c20585bfa": "Gennem streng omskoling har jeg måttet aflære mange elever alt, hvad de tidligere lærte, så jeg kunne undervise dem på ny. Den tjeneste bliver sværere at udføre hver gang og derfor også dyrere for hver omskoling. Ønsker du, at jeg aflærer dig de talenter, du har lært?"
      },
      "name": "Sandahl",
      "translationMetadata": {
        "fields": {
