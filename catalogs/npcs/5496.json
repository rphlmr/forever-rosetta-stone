    "hrHR": {
      "dialogue": {
        "031b921ed1bb12ac5781": "Zanima me poduka u umijeću vještaca.",
        "04073c6f64c2f4e77b56": "Zanima me poduka u umijeću vještaca.",
        "1283b80fefb769143d49": "Tajanstvena magija kvari samo slabe. Nastavi trenirati ili bi te mogla zadesiti slična sudbina.",
        "67ef3c3f0838338047b9": "Tama te ne prihvaća, $c. Prestani brbljati i makni mi se s očiju! Gubi se!",
        "d4b703da893c20585bfa": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Tu je uslugu sve teže pružiti svaki put, pa zato svaka preobuka postaje skuplja. Želiš li da te odviknem od naučenih talenata?"
      },
      "name": "Sandahl",
      "translationMetadata": {
