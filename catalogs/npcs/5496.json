    "plPL": {
      "dialogue": {
        "031b921ed1bb12ac5781": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "04073c6f64c2f4e77b56": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "1283b80fefb769143d49": "Magia tajemna deprawuje tylko słabych. Kontynuuj trening, inaczej może cię spotkać podobny los.",
        "67ef3c3f0838338047b9": "Mrok cię nie obejmuje, $c. Przestań paplać i zejdź mi z oczu! Precz!",
        "d4b703da893c20585bfa": "Przez rygorystyczne przeszkolenie musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc uczyć ich na nowo. Za każdym razem usługa ta staje się trudniejsza, a przez to droższa. Czy chcesz, abym oduczył cię poznanych talentów?"
      },
