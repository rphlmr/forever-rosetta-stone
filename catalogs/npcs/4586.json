    "hrHR": {
      "dialogue": {
        "4a1a41c00dbecb085b41": "Inženjerstvo će ti pružiti vještine i znanje da rastaviš svoje protivnike! Pokazat ću ti kako...",
        "781664e398b8798317b5": "Spreman si za veće stvari! Obrati se Franklinu Lloydu, meni zdesna. On će te odsad voditi.",
        "a76de05b98c389a4deb1": "Mračna Gospa rekla je da će znanje biti naše najveće oružje u ovom ratu.",
        "e89ce0c84522fb0280b6": "Podučite me."
      },
      "name": "Graham Van Talen",
