    "daDK": {
      "dialogue": {
        "4a1a41c00dbecb085b41": "Ingeniørkunst giver dig evnerne og viden til at skille dine modstandere ad! Lad mig vise dig hvordan...",
        "781664e398b8798317b5": "Du er klar til større ting! Tal med Franklin Lloyd til højre for mig. Han vil vejlede dig fra nu af.",
        "a76de05b98c389a4deb1": "Den mørke frue har sagt, at viden vil være vores største våben i denne krig.",
        "e89ce0c84522fb0280b6": "Træn mig."
      },
      "name": "Graham Van Talen",
      "translationMetadata": {
        "fields": {
          "dialogue.4a1a41c00dbecb085b41": {
