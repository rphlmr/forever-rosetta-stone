  "locales": {
    "csCZ": {
      "dialogue": {
        "4a1a41c00dbecb085b41": "Inženýrství ti dá dovednosti a znalosti potřebné k rozebrání protivníků! Ukážu ti jak...",
        "781664e398b8798317b5": "Jsi připraven na větší věci! Promluv si s Franklinem Lloydem po mé pravici. Odteď tě povede on.",
        "a76de05b98c389a4deb1": "Temná paní řekla, že vědění bude v této válce naší největší zbraní.",
        "e89ce0c84522fb0280b6": "Vycvičte mě."
      },
      "name": "Graham Van Talen",
      "translationMetadata": {
        "fields": {
