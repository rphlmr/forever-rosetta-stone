    "esES": {
      "dialogue": {
        "4a1a41c00dbecb085b41": "¡La ingeniería te dará la técnica y el conocimiento para desmontar a tus oponentes! ¿Me permites mostrarte cómo?",
        "781664e398b8798317b5": "¡Estás listo para hacer grandes cosas! Ve a ver a Franklin Lloyd, a mi derecha. Él te guiará a partir de ahora.",
        "a76de05b98c389a4deb1": "La Dama Oscura ha dicho que mi saber será nuestra mayor arma en esta guerra.",
        "e89ce0c84522fb0280b6": "Entréname."
      },
      "name": "Graham Van Talen",
      "subName": "Oficial de ingeniería",
      "translationMetadata": {
