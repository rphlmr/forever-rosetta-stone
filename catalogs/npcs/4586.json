    "enUS": {
      "dialogue": {
        "4a1a41c00dbecb085b41": "Engineering will provide you with the skills and knowledge to dismantle your opponents! Let me show you how...",
        "781664e398b8798317b5": "You are ready for greater things! See Franklin Lloyd, to my right. He will guide you from now on.",
        "a76de05b98c389a4deb1": "The Dark Lady has said that knowledge will be our greatest weapon in this war.",
        "e89ce0c84522fb0280b6": "Train me."
      },
      "name": "Graham Van Talen",
      "subName": "Journeyman Engineer",
      "translationMetadata": {
        "fields": {
          "dialogue.4a1a41c00dbecb085b41": {
