    "ltLT": {
      "dialogue": {
        "4a1a41c00dbecb085b41": "Inžinerija suteiks tau įgūdžių ir žinių, kaip išardyti savo priešininkus! Leisk parodyti...",
        "781664e398b8798317b5": "Esi pasirengęs didesniems iššūkiams! Kreipkis į Franklin Lloyd, esantį man iš dešinės. Nuo šiol jis tave mokys.",
        "a76de05b98c389a4deb1": "Tamsioji Valdovė sakė, kad žinios bus galingiausias mūsų ginklas šiame kare.",
        "e89ce0c84522fb0280b6": "Išmokyk mane."
      },
      "name": "Graham Van Talen",
      "subName": "Patyręs inžinierius",
