  "locales": {
    "csCZ": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Všichni se dozvědí, co se zde v tomto prokletém chrámu stalo, hrdino. Bude to zapsáno v knihách dějin a příběhy se stanou legendami od Azerothu až po nejvzdálenější končiny samotné Nicoty!",
        "706b16b885d8d27dfa07": "Hrdinové našeho rodu? C’Thun musí být zapuzen! Můžeme ti pomoci, smrtelníku!"
      },
      "name": "Merithra ze snu",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.706b16b885d8d27dfa07": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Alle skal få at vide, hvad der er sket her i dette forbandede tempel, helt. Det vil blive skrevet i historiebøgerne, og fortællingerne vil blive til legender fra Azeroth til de fjerneste egne af selve Nether!",
        "706b16b885d8d27dfa07": "Ynglens helte? C’Thun skal forvises! Vi kan hjælpe dig, dødelige!"
      },
      "name": "Merithra af drømmen",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
