          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Todos saberão o que se passou neste templo maldito, meu herói. A história será escrita nos livros e se tornará uma lenda, de Azeroth até os recônditos sombrios do éter!",
        "706b16b885d8d27dfa07": "Heróis da Prole? C'Thun deve ser banido! Nós podemos ajudá-lo, mortal!"
      },
      "name": "Merithra do Sonho",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
