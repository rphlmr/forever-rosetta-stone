    },
    "itIT": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Tutti sapranno ciò che è accaduto in questo tempio maledetto, eroe. Sarà scritto nei libri di storia e raccontato come leggenda da Azeroth fino ai confini più remoti del Nether!",
        "706b16b885d8d27dfa07": "Eroi della Brood? C'Thun deve essere bandito! Possiamo aiutarti, mortale!"
      },
      "name": "Merithra del Sogno",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
