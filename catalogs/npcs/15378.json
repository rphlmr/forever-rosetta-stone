          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Alla ska få veta vad som hänt här i detta förbannade tempel, hjälte. Det ska skrivas i historieböckerna och berättas som legender från Azeroth till själva Nethers yttersta gränser!",
        "706b16b885d8d27dfa07": "Kullens hjältar? C’Thun måste fördrivas! Vi kan hjälpa dig, dödlige!"
      },
      "name": "Merithra av drömmen",
      "translationMetadata": {
        "fields": {
