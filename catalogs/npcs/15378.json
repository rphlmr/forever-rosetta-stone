    },
    "enUS": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "All will know of what has transpired here in this accursed temple, hero. It will be written about in history books - the tales told as legend from Azeroth to the far reaches of the Nether itself!",
        "706b16b885d8d27dfa07": "Heroes of the Brood? C'Thun must be banished! We can assist you, mortal!"
      },
      "name": "Merithra of the Dream",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
            "origin": "community",
