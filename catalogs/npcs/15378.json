          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Jeder wird erfahren, was in diesem verfluchten Tempel vorgefallen ist, Held. Es wird in den Geschichtsbüchern niedergeschrieben werden. Die Geschichten werden zu Legenden werden und überall, von Azeroth bis hin zum Nether selbst, zu hören sein.",
        "706b16b885d8d27dfa07": "Helden der Brut? C'Thun muss verbannt werden! Wir können Euch unterstützen Sterblicher."
      },
      "name": "Merithra des Traums",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
