    "ltLT": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Visi sužinos, kas nutiko šioje prakeiktoje šventykloje, didvyri. Apie tai bus rašoma istorijos knygose, o pasakojimai virs legendomis nuo Azeroth iki tolimiausių pačios Tuštumos pakraščių!",
        "706b16b885d8d27dfa07": "Sankabos didvyriai? C'Thun turi būti ištremtas! Mes galime jums padėti, mirtingieji!"
      },
      "name": "Sapno Merithra",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
