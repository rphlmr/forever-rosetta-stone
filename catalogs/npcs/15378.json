    },
    "trTR": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Bu lanetli tapınakta yaşananları herkes öğrenecek, kahraman. Tarih kitaplarına yazılacak ve Azeroth’tan Nether’ın en uzak köşelerine kadar efsane olarak anlatılacak!",
        "706b16b885d8d27dfa07": "Soyumuzun kahramanları mı? C’Thun sürülmeli! Sana yardım edebiliriz, ölümlü!"
      },
      "name": "Rüyanın Merithra'sı",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
            "origin": "ai",
