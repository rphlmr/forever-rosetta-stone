        }
      }
    },
    "plPL": {
      "dialogue": {
        "448c4f72b9d8c8e721e1": "Wszyscy dowiedzą się, co wydarzyło się w tej przeklętej świątyni, bohaterze. Zapiszą to księgi historii, a opowieści staną się legendą od Azeroth po najdalsze zakątki samej Otchłani!",
        "706b16b885d8d27dfa07": "Bohaterowie naszego rodu? C’Thun musi zostać wygnany! Możemy ci pomóc, śmiertelniku!"
      },
      "name": "Merithra ze Snu",
      "translationMetadata": {
        "fields": {
          "dialogue.448c4f72b9d8c8e721e1": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
