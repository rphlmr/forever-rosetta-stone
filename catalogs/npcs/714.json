    "hrHR": {
      "dialogue": {
        "5795226a00a56e91c756": "Pozdrav, $c! Divan dan za lov, zar ne? Mene je baš poslužila sreća s veprovima. Želiš li i ti okušati sreću?",
        "6c3fbd9a1c89827f04f8": "Podučite me.",
        "a38746c74a2a0300ad47": "Želim pogledati vašu robu."
      },
      "name": "Talin Keeneye",
