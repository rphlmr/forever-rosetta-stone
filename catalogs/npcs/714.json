    "enUS": {
      "dialogue": {
        "5795226a00a56e91c756": "Greetings, $c! Fine day for hunting, wouldn't you say? I've been having more than a little luck with boars, myself. Perhaps you'd like a shot?",
        "6c3fbd9a1c89827f04f8": "Train me.",
        "a38746c74a2a0300ad47": "I want to browse your goods."
      },
      "name": "Talin Keeneye",
