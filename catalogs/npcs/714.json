  "locales": {
    "csCZ": {
      "dialogue": {
        "5795226a00a56e91c756": "Zdravím, $c! Krásný den na lov, nemyslíš? Mně samotnému se při lovu kanců docela daří. Nechceš si taky vystřelit?",
        "6c3fbd9a1c89827f04f8": "Vycvičte mě.",
        "a38746c74a2a0300ad47": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Talin Keeneye",
      "translationMetadata": {
        "fields": {
