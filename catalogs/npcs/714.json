    "trTR": {
      "dialogue": {
        "5795226a00a56e91c756": "Selamlar, $c! Avlanmak için güzel bir gün, öyle değil mi? Yaban domuzlarında şansım oldukça yaver gitti. Sen de bir atış yapmak ister misin?",
        "6c3fbd9a1c89827f04f8": "Beni eğit.",
        "a38746c74a2a0300ad47": "Mallarına bakmak istiyorum."
      },
