    "daDK": {
      "dialogue": {
        "5795226a00a56e91c756": "Hilsen, $c! En dejlig dag til jagt, synes du ikke? Jeg har selv haft ganske godt held med vildsvinene. Har du lyst til at prøve et skud?",
        "6c3fbd9a1c89827f04f8": "Træn mig.",
        "a38746c74a2a0300ad47": "Jeg vil gerne se dine varer."
      },
      "name": "Talin Keeneye",
      "translationMetadata": {
        "fields": {
          "dialogue.5795226a00a56e91c756": {
            "origin": "ai",
