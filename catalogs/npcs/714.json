    "ptBR": {
      "dialogue": {
        "5795226a00a56e91c756": "Saudações, $c! Belo dia para caçar, não acha? Tenho tido bastante sorte com os javalis. Quer tentar um disparo?",
        "6c3fbd9a1c89827f04f8": "Treine-me.",
        "a38746c74a2a0300ad47": "Quero ver suas mercadorias."
      },
      "name": "Talin Olhobom",
