    "ltLT": {
      "dialogue": {
        "5795226a00a56e91c756": "Sveikas, $c! Puiki diena medžioklei, ar ne? Man pačiam itin sekasi medžioti šernus. Gal ir tu norėtum pamėginti?",
        "6c3fbd9a1c89827f04f8": "Pamokyk mane.",
        "a38746c74a2a0300ad47": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Talin Keeneye",
