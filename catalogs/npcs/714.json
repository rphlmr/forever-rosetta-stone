    "plPL": {
      "dialogue": {
        "5795226a00a56e91c756": "Witaj, $c! Piękny dzień na polowanie, nie sądzisz? Mnie całkiem dobrze wiedzie się z dzikami. Może zechcesz spróbować swoich sił?",
        "6c3fbd9a1c89827f04f8": "Wyszkol mnie.",
        "a38746c74a2a0300ad47": "Chcę przejrzeć twoje towary."
      },
      "name": "Talin Keeneye",
