    "itIT": {
      "dialogue": {
        "5795226a00a56e91c756": "Salute, $C! Bella giornata per andare a caccia, non trovi? Io con i cinghiali sto avendo non poca fortuna. Magari ti va di provarci?",
        "6c3fbd9a1c89827f04f8": "Addestrami.",
        "a38746c74a2a0300ad47": "Vorrei vedere la tua merce."
      },
