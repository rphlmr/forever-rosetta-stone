    "frFR": {
      "dialogue": {
        "5795226a00a56e91c756": "Bonjour, $c ! Belle journée pour la chasse, n'est-ce pas ? J'ai moi-même eu de la chance avec les sangliers. Peut-être aimeriez-vous essayer ?",
        "6c3fbd9a1c89827f04f8": "Entraînez-moi.",
        "a38746c74a2a0300ad47": "Je voudrais regarder vos articles."
