    "esES": {
      "dialogue": {
        "5795226a00a56e91c756": "¡Saludos, $c! Un día perfecto para ir a cazar, ¿no te parece? He estado teniendo bastante suerte con los jabalíes. ¿Te gustaría intentarlo?",
        "6c3fbd9a1c89827f04f8": "Entréname.",
        "a38746c74a2a0300ad47": "Quiero ver tus mercancías."
      },
      "name": "Talin Ojoagudo",
