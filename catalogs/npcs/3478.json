    "trTR": {
      "dialogue": {
        "3334b996b8d556a09070": "Ruhların rehberliğine biraz daha kulak vermelisin genç dostum. Yolun Thunder Bluff’taki Thrag Stonehoof’a çıkıyor. Belki birbirinizden bir şeyler öğrenirsiniz.",
        "802beb075a8c69de7849": "Beni eğit.",
        "e5ad83435c6ddcee640e": "Ruhlar seni bana getirdi, bu yüzden onların kutsamasını hissediyorum."
      },
      "name": "Traugh",
      "translationMetadata": {
