    "daDK": {
      "dialogue": {
        "3334b996b8d556a09070": "Du må lytte bedre til åndernes vejledning, unge ven. Din vej fører til en anden, Thrag Stonehoof i Thunder Bluff. Måske kan I lære noget af hinanden.",
        "802beb075a8c69de7849": "Træn mig.",
        "e5ad83435c6ddcee640e": "Ånderne har bragt dig til mig, og jeg føler mig velsignet af dem."
      },
      "name": "Traugh",
      "translationMetadata": {
        "fields": {
