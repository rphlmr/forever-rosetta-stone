    "plPL": {
      "dialogue": {
        "3334b996b8d556a09070": "Musisz uważniej słuchać wskazówek duchów, młoda duszo. Twoja droga prowadzi do Thraga Stonehoofa w Thunder Bluff. Być może nauczycie się czegoś od siebie nawzajem.",
        "802beb075a8c69de7849": "Wyszkol mnie.",
        "e5ad83435c6ddcee640e": "Duchy przywiodły cię do mnie, więc czuję się przez nie pobłogosławiony."
      },
      "name": "Traugh",
