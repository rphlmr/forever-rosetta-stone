    "hrHR": {
      "dialogue": {
        "3334b996b8d556a09070": "Moraš bolje slušati vodstvo duhova, mlada dušo. Tvoj put vodi do drugoga, Thraga Stonehoofa u Thunder Bluffu. Možda možete nešto naučiti jedno od drugoga.",
        "802beb075a8c69de7849": "Podučite me.",
        "e5ad83435c6ddcee640e": "Duhovi su te doveli k meni i zato se osjećam blagoslovljeno."
      },
      "name": "Traugh",
