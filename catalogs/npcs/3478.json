    "enUS": {
      "dialogue": {
        "3334b996b8d556a09070": "You need to heed the guidance of the spirits a little better young one. Your path lies with another, Thrag Stonehoof in Thunder Bluff. Perhaps you can learn something from one another.",
        "802beb075a8c69de7849": "Train me.",
        "e5ad83435c6ddcee640e": "The spirits have brought you to me, and so I feel blessed by them. "
      },
      "name": "Traugh",
      "subName": "Expert Blacksmith",
