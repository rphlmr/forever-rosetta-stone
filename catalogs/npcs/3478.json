  "locales": {
    "csCZ": {
      "dialogue": {
        "3334b996b8d556a09070": "Mladá duše, musíš lépe naslouchat vedení duchů. Tvá cesta vede k jinému učiteli, Thragovi Stonehoofovi v Thunder Bluff. Snad se jeden od druhého něco naučíte.",
        "802beb075a8c69de7849": "Vycvičte mě.",
        "e5ad83435c6ddcee640e": "Duchové tě přivedli ke mně, a tak cítím jejich požehnání."
      },
      "name": "Traugh",
      "translationMetadata": {
        "fields": {
