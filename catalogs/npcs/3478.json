    "ltLT": {
      "dialogue": {
        "3334b996b8d556a09070": "Jaunuoli, turėtum atidžiau klausytis dvasių patarimų. Tavo kelias veda pas kitą asmenį, Thrag Stonehoof iš Thunder Bluff. Galbūt galėsite vienas iš kito ko nors išmokti.",
        "802beb075a8c69de7849": "Mokyk mane.",
        "e5ad83435c6ddcee640e": "Dvasios atvedė tave pas mane, todėl jaučiuosi jų palaimintas. "
      },
      "name": "Traugh",
      "subName": "Kalvystės ekspertas",
      "translationMetadata": {
