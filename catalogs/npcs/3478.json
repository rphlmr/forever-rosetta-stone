    "frFR": {
      "dialogue": {
        "3334b996b8d556a09070": "Apprenez à mieux vous laisser guider par les esprits. Votre chemin vous conduit vers un autre, Thrag Stonehoof de Thunder Bluff. Peut-être en apprendrez-vous plus avec un autre ?",
        "802beb075a8c69de7849": "Entraînez-moi.",
        "e5ad83435c6ddcee640e": "Les esprits vous ont conduit jusqu'à moi, et je me sens béni par eux."
      },
      "name": "Traugh",
      "subName": "Forgeron - Expert",
