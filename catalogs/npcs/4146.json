    "ltLT": {
      "dialogue": {
        "121dc0c764f7e210279c": "Griežtai permokydama turėjau priversti daugelį mokinių pamiršti visa, ką jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart atlikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "19cfaec4a26cb438db59": "Sveiki atvykę į Cenariono ratą, $c.",
        "4ed859e23a76de34d0ef": "Norėčiau pasimokyti.",
        "9ed096fbdfa66c7e0869": "Negaliu mokyti tokios klasės kaip $c."
      },
      "name": "Jocaste",
      "subName": "Medžiotojų mokytojas",
