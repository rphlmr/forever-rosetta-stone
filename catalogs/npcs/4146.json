    "plPL": {
      "dialogue": {
        "121dc0c764f7e210279c": "Dzięki rygorystycznemu przeszkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mogła nauczyć ich od nowa. Ta usługa za każdym razem staje się trudniejsza do wykonania, dlatego też każde kolejne przeszkolenie jest droższe. Czy chcesz, abym pomogła ci zapomnieć wyuczone talenty?",
        "19cfaec4a26cb438db59": "Witaj w Kręgu Cenariona, $c.",
        "4ed859e23a76de34d0ef": "Chcę się szkolić.",
        "9ed096fbdfa66c7e0869": "Nie mogę szkolić kogoś takiego jak ty, $c."
      },
      "name": "Jocaste",
