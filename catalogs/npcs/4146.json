  "locales": {
    "csCZ": {
      "dialogue": {
        "121dc0c764f7e210279c": "Přísným přeškolením jsem musela mnoho žáků odnaučit všemu, co se dříve naučili, abych je mohla učit znovu. Tato služba je s každým opakováním obtížnější, a proto také dražší. Přeješ si, abych tě odnaučila talenty, které sis osvojil?",
        "19cfaec4a26cb438db59": "Vítej v Cenariově kruhu, $c.",
        "4ed859e23a76de34d0ef": "Chtěl bych trénovat.",
        "9ed096fbdfa66c7e0869": "Nemohu učit někoho jako ty, $c."
      },
      "name": "Jocaste",
      "translationMetadata": {
        "fields": {
