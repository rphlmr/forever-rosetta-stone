    "hrHR": {
      "dialogue": {
        "121dc0c764f7e210279c": "Strogom preobukom morala sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla ponovno podučiti. Uslugu koju nudim sve je teže obaviti svaki put, pa je zato i sve skuplja sa svakom preobukom. Želiš li da te odviknem od talenata koje si naučio?",
        "19cfaec4a26cb438db59": "Dobro došao u Cenarion Circle, $c.",
        "4ed859e23a76de34d0ef": "Želim trenirati.",
        "9ed096fbdfa66c7e0869": "Ne mogu podučavati nekoga poput tebe, $c."
      },
      "name": "Jocaste",
      "translationMetadata": {
