    "daDK": {
      "dialogue": {
        "c058ddd56439e91d711e": "På den nordlige kaj kan du gå ombord på et skib til Rut’theran Village og Darnassus. Fra den sydlige kaj kan du rejse over Great Sea til Menethil Harbor i Khaz Modan. God rejse!"
      },
      "name": "Thamarian",
