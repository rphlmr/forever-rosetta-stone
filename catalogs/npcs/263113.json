    "enUS": {
      "dialogue": {
        "9740ed0422b91e9711b2": "It can get boring up here, you know. I can only annoy that stuffy wretch Halaan so much before even that gets old."
      },
      "name": "Myriaal Mistwake",
      "subName": "Rangers of Thendal Grove",
