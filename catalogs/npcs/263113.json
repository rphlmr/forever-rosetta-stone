    "daDK": {
      "dialogue": {
        "9740ed0422b91e9711b2": "Det kan godt blive kedeligt heroppe, ved du. Jeg kan kun genere den selvhøjtidelige stakkel Halaan så længe, før selv det bliver kedeligt."
      },
      "name": "Myriaal Mistwake",
      "translationMetadata": {
        "fields": {
