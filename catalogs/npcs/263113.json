    "csCZ": {
      "dialogue": {
        "9740ed0422b91e9711b2": "Víš, tady nahoře může být nuda. Toho upjatého bídáka Halaana můžu otravovat jen chvíli, než i to omrzí."
      },
      "name": "Myriaal Mistwake",
      "translationMetadata": {
