  "locales": {
    "csCZ": {
      "dialogue": {
        "0c7d95be9898beb1ba07": "Přísným přeškolením jsem musel mnoho žáků odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je pokaždé obtížnější, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "2471b116d77a1bcf7b9c": "Ano, $c?",
        "5207ce2852ab3d462b6b": "Hledám další výcvik v kněžském umění.",
        "d55c176728db0290e7fc": "Co pro tebe může tento bezvýznamný služebník udělat, $n? Snad výcvik?"
      },
      "name": "Temný kněz Duesten",
      "translationMetadata": {
        "fields": {
          "dialogue.0c7d95be9898beb1ba07": {
