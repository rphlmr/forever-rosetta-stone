    "enUS": {
      "dialogue": {
        "0c7d95be9898beb1ba07": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "2471b116d77a1bcf7b9c": "Yes, $c?",
        "5207ce2852ab3d462b6b": "I seek more training in the priestly ways.",
        "d55c176728db0290e7fc": "What can this insignificant servant do for you, $n? Training perhaps?"
      },
      "name": "Dark Cleric Duesten",
      "subName": "Priest Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.0c7d95be9898beb1ba07": {
