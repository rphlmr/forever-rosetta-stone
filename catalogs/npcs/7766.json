            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "bd28c3f4d7ca0f195f72": "Ah, quem me dera ter um galho para segurar na minha frente. Assim os guardas nunca iam me ver.",
        "d5f72bae78311889a07a": "Vai ter que ter paciência comigo, $n. Meu Robô-Espião está lá dentro cuidando de um assunto muito delicado. Já falo com você.\n\nAh, e me faça um favor, tente não deixar Lescobar ver você... Nós estamos prestes emboscá-lo."
      },
      "name": "Tyrion",
      "translationMetadata": {
        "fields": {
