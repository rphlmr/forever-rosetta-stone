          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "bd28c3f4d7ca0f195f72": "Oh, if I only had a tree branch to hold up in front of me. The guards would never see me then.",
        "d5f72bae78311889a07a": "You'll have to be patient with me, $n. I've got my Spybot inside working on a very delicate matter. I'll be with ya in a second.$B$BOh, and do me a favor, try not to let Lescovar see you... we're about to ambush him."
      },
      "name": "Tyrion",
      "translationMetadata": {
        "fields": {
