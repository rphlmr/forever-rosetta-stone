            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "bd28c3f4d7ca0f195f72": "Åh, hvis bare jeg havde en gren at holde foran mig. Så ville vagterne aldrig få øje på mig.",
        "d5f72bae78311889a07a": "Du må være tålmodig med mig, $n. Min spionrobot arbejder derinde på en meget følsom sag. Jeg er hos dig om lidt.$B$BOg gør mig en tjeneste: Lad ikke Lescovar se dig... vi er ved at lægge os i baghold for ham."
      },
      "name": "Tyrion",
      "translationMetadata": {
        "fields": {
          "dialogue.bd28c3f4d7ca0f195f72": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d5f72bae78311889a07a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
