  "locales": {
    "csCZ": {
      "dialogue": {
        "bd28c3f4d7ca0f195f72": "Ach, kdybych tak měl větev, kterou bych před sebou podržel. Stráže by mě pak nikdy neviděly.",
        "d5f72bae78311889a07a": "Musíš se mnou mít trpělivost, $n. Můj špionážní robot právě uvnitř pracuje na velmi choulostivé záležitosti. Hned jsem u tebe.$B$BA ještě mi prokaž laskavost a nenech se spatřit Lescovarem... chystáme se ho přepadnout."
      },
      "name": "Tyrion",
      "translationMetadata": {
        "fields": {
          "dialogue.bd28c3f4d7ca0f195f72": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d5f72bae78311889a07a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
