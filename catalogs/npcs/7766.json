            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "bd28c3f4d7ca0f195f72": "Ach, wenn ich doch nur einen Ast hätte, um ihn vor mich zu halten. Dann würden die Wachen mich nicht sehen.",
        "d5f72bae78311889a07a": "Ihr müsst Geduld mit mir haben, $n. Mein Spionagebot ist da drin und arbeitet an einer heiklen Sache. Ich bin sofort bei Euch.\n\nOh, und tut mir einen Gefallen, lasst Euch nicht von Lescovar sehen... wir wollen ihn in einen Hinterhalt locken."
      },
      "name": "Tyrion",
      "translationMetadata": {
        "fields": {
          "dialogue.bd28c3f4d7ca0f195f72": {
            "origin": "community",
            "source": "Spoken",
