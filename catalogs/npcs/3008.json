  "locales": {
    "csCZ": {
      "dialogue": {
        "55605d7cffea8fa773aa": "Tvůj talent převyšuje můj, příteli. Promluv si zde s Tarnem, o kůži ví mnohem víc než já. Určitě uvítá dalšího žáka.",
        "878e58a3bc2f7e07e1c7": "Vycvičte mě.",
        "be062a472af9e1ee26c6": "Než začneš pracovat, očisti si ruce. Krev nebo špína by kůži ubraly na její přirozené kráse.",
        "d464669902149ee89c37": "Říká se, že tu žije sám Cairne. Až dokončím vhodný dar, vyhledám ho. Snad mi poskytne moudrou radu."
      },
      "name": "Mak",
      "translationMetadata": {
        "fields": {
          "dialogue.55605d7cffea8fa773aa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
