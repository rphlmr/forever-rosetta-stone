    "hrHR": {
      "dialogue": {
        "55605d7cffea8fa773aa": "Tvoj talent nadilazi moj, prijatelju. Razgovaraj s Tarnom ovdje; njegovo znanje o koži mnogo je veće od mojega. Siguran sam da bi rado primio još jednog učenika.",
        "878e58a3bc2f7e07e1c7": "Podučite me.",
        "be062a472af9e1ee26c6": "Operi ruke prije nego što započneš posao. Krv ili prljavština na koži umanjile bi njezinu prirodnu ljepotu.",
        "d464669902149ee89c37": "Kažu da ovdje živi sam Cairne. Kada završim prikladan dar, potražit ću ga. Možda će mi udijeliti koju mudru riječ."
      },
      "name": "Mak",
      "translationMetadata": {
