    "plPL": {
      "dialogue": {
        "16047dccf3932485cc9c": "Szukam szkolenia w sztuce łowcy.",
        "7990bb793ebbad8a033e": "Co mogę dla ciebie zrobić, przyjacielu?",
        "8f08069e8558ae4707e2": "Hej, przyjacielu, musisz udać się do trenera klasy $c.",
        "9df0fc2209993d940c43": "Podczas surowego przekwalifikowania musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc uczyć ich od nowa. Ta usługa staje się coraz trudniejsza przy każdym powtórzeniu. Dlatego każde kolejne przekwalifikowanie kosztuje więcej. Czy chcesz, abym oduczył cię poznanych talentów?"
      },
      "name": "Jen'shan",
