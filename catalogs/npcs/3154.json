  "locales": {
    "csCZ": {
      "dialogue": {
        "16047dccf3932485cc9c": "Hledám výcvik v umění lovce.",
        "7990bb793ebbad8a033e": "Co pro tebe můžu udělat, kámo?",
        "8f08069e8558ae4707e2": "Hej, kámo, musíš zajít za trenérem $c.",
        "9df0fc2209993d940c43": "Při náročném přeškolování jsem musel mnohé studenty odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je při každém dalším přeškolení těžší provést. Proto je také pokaždé dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?"
      },
      "name": "Jen'shan",
      "translationMetadata": {
        "fields": {
          "dialogue.16047dccf3932485cc9c": {
