    "daDK": {
      "dialogue": {
        "16047dccf3932485cc9c": "Jeg søger træning i jægerens kunst.",
        "7990bb793ebbad8a033e": "Hvad kan jeg gøre for dig, ven?",
        "8f08069e8558ae4707e2": "Hey, ven, du skal hen til $c-træneren.",
        "9df0fc2209993d940c43": "Gennem streng omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre for hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg aflærer dig de talenter, du har lært?"
      },
      "name": "Jen'shan",
      "translationMetadata": {
        "fields": {
          "dialogue.16047dccf3932485cc9c": {
