    "trTR": {
      "dialogue": {
        "16047dccf3932485cc9c": "Avcılığın yollarını öğrenmek istiyorum.",
        "7990bb793ebbad8a033e": "Senin için ne yapabilirim dostum?",
        "8f08069e8558ae4707e2": "Hey dostum, $c eğitmenine gitmelisin.",
        "9df0fc2209993d940c43": "Zorlu bir yeniden eğitimle birçok öğrencime daha önce öğrendikleri her şeyi unutturmam gerekti ki onlara yeniden öğretebileyim. Bu hizmeti her seferinde yerine getirmek daha da zorlaşıyor. Bu yüzden her yeniden eğitimde ücreti artıyor. Öğrendiğin yetenekleri sana unutturmamı ister misin?"
      },
      "name": "Jen'shan",
