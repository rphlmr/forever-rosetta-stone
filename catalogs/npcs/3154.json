    "enUS": {
      "dialogue": {
        "16047dccf3932485cc9c": "I seek training in the ways of the Hunter.",
        "7990bb793ebbad8a033e": "What kin I do for ya, mon?",
        "8f08069e8558ae4707e2": "Hey mon, you be needin' to head on over to da $c trainer.",
        "9df0fc2209993d940c43": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Jen'shan",
      "subName": "Hunter Trainer",
