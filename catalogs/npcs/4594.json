    "hrHR": {
      "dialogue": {
        "1b61b80713932983b91b": "Trebam ratničku obuku.",
        "7ec2dbc47c6899ea83ad": "Ne gubi moje vrijeme, $c.",
        "ae056a882cdbde2fe702": "Uloga ratnika je zaštita. Kao što u borbi štitimo svoje sunarodnjake, moramo štititi i interese Odbačenih.",
        "c6035718fbea05f5f678": "Strogim ponovnim obučavanjem morala sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogla podučavati iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako ponovno obučavanje postaje skuplje. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Angela Curthas",
