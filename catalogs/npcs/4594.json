  "locales": {
    "csCZ": {
      "dialogue": {
        "1b61b80713932983b91b": "Potřebuji výcvik válečníka.",
        "7ec2dbc47c6899ea83ad": "Neztrácej můj čas, $c.",
        "ae056a882cdbde2fe702": "Úlohou válečníka je chránit. Stejně jako v bitvě chráníme své druhy, musíme chránit i zájmy Opuštěných.",
        "c6035718fbea05f5f678": "Přísným přeškolením jsem musela mnoho studentů odnaučit všemu, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talentům, které sis osvojil?"
      },
      "name": "Angela Curthas",
      "translationMetadata": {
        "fields": {
          "dialogue.1b61b80713932983b91b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
