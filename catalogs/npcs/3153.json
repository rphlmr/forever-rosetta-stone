  "locales": {
    "csCZ": {
      "dialogue": {
        "1758b9142fbad24cc15e": "Potřebuji výcvik válečníka.",
        "6adbc43ea2c5c4592e0a": "Jsi tu kvůli výcviku? Nebo jen ztrácíš válečníkův čas?",
        "c8809edb0c4c7090e466": "Tvůj druh necvičím, $c. Najdi si vlastního trenéra, než mě rozzlobíš.",
        "f25a115e2f392d1269f8": "Přísným přecvičením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přecvičení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Frang",
      "translationMetadata": {
        "fields": {
          "dialogue.1758b9142fbad24cc15e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
