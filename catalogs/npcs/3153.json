            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "1758b9142fbad24cc15e": "Jeg har brug for krigertræning.",
        "6adbc43ea2c5c4592e0a": "Er du her for at træne? Eller er du bare her for at spilde en krigers tid?",
        "c8809edb0c4c7090e466": "Jeg træner ikke din slags, $c. Find din egen træner, før du gør mig vred.",
        "f25a115e2f392d1269f8": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang og derfor også dyrere ved hver omskoling. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Frang",
      "translationMetadata": {
        "fields": {
          "dialogue.1758b9142fbad24cc15e": {
