    "hrHR": {
      "dialogue": {
        "1758b9142fbad24cc15e": "Trebam ratničku obuku.",
        "6adbc43ea2c5c4592e0a": "Jesi li ovdje radi obuke? Ili samo trošiš vrijeme jednom ratniku?",
        "c8809edb0c4c7090e466": "Ne obučavam tvoju vrstu, $c. Pronađi svog učitelja prije nego što me naljutiš.",
        "f25a115e2f392d1269f8": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Tu je uslugu sve teže pružiti svaki put, pa zato i cijena raste sa svakim preobučavanjem. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Frang",
      "translationMetadata": {
