    "daDK": {
      "dialogue": {
        "c386870e8c15b6352a22": "Ah... en kunde! Tal med min største opfindelse, Vendor-Tron 1000. Han har alt, hvad du behøver... nogle af de sjældneste varer på noget marked i Kalimdor... og hans programmering tillader ikke prutten om prisen, så den pris, du ser, er den, du betaler."
      },
      "name": "Cork Gizelton",
      "translationMetadata": {
