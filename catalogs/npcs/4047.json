    "trTR": {
      "dialogue": {
        "0bafba34307001a26c71": "Beni eğit.",
        "907e71c76be261c4bacb": "Doğa ruhları saygı duyulması gereken güçlerdir. Layık olanlara büyük yardım sunar, akılsızlara ise hızlı bir ölüm getirirler.",
        "98bf40c1ebc18e4354c8": "Mallarına bakmak istiyorum.",
        "d4f06b3ac683745a150d": "Selamlar, yolcu."
      },
