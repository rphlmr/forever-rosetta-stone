    "svSE": {
      "dialogue": {
        "0bafba34307001a26c71": "Träna mig.",
        "907e71c76be261c4bacb": "Naturens andar är krafter som bör respekteras. De ger stor hjälp åt de värdiga och snabb död åt de dåraktiga.",
        "98bf40c1ebc18e4354c8": "Jag vill se dina varor.",
        "d4f06b3ac683745a150d": "Var hälsad, resande."
      },
      "name": "Zor Lonetree",
