    "ukUA": {
      "dialogue": {
        "0bafba34307001a26c71": "Навчіть мене.",
        "907e71c76be261c4bacb": "Духи природи — це сили, гідні поваги. Вони щедро допомагають достойним, а дурням несуть швидку смерть.",
        "98bf40c1ebc18e4354c8": "Я хочу переглянути ваші товари.",
        "d4f06b3ac683745a150d": "Вітаю, мандрівнику."
      },
      "name": "Зор Самітне Дерево",
