    "ltLT": {
      "dialogue": {
        "0bafba34307001a26c71": "Išmokyk mane.",
        "907e71c76be261c4bacb": "Gamtos dvasios yra galios, kurias reikia gerbti. Vertiesiems jos suteikia didžią pagalbą, o kvailiams siunčia greitą mirtį.",
        "98bf40c1ebc18e4354c8": "Noriu apžiūrėti tavo prekes.",
        "d4f06b3ac683745a150d": "Sveikas, keliautojau."
