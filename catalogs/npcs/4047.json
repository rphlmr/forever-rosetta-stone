    "esES": {
      "dialogue": {
        "0bafba34307001a26c71": "Entréname.",
        "907e71c76be261c4bacb": "Los espíritus de la naturaleza son poderes que hay que respetar.  Ofrecen una gran ayuda a los dignos, e infligen una muerte rápida a los necios.",
        "98bf40c1ebc18e4354c8": "Quiero ver tus mercancías.",
        "d4f06b3ac683745a150d": "Saludos, viajera."
      },
      "name": "Zor Soliárbol",
      "subName": "Anciano clarividente",
