    "csCZ": {
      "dialogue": {
        "0bafba34307001a26c71": "Vycvičte mě.",
        "907e71c76be261c4bacb": "Duchové přírody jsou síly, které si zaslouží úctu. Hodným nabízejí velkou pomoc a pošetilým rychlou smrt.",
        "98bf40c1ebc18e4354c8": "Chci si prohlédnout vaše zboží.",
        "d4f06b3ac683745a150d": "Zdravím tě, poutníku."
      },
      "name": "Zor Lonetree",
