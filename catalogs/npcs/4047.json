    "deDE": {
      "dialogue": {
        "0bafba34307001a26c71": "Bildet mich aus.",
        "907e71c76be261c4bacb": "Die Geister der Natur sind Kräfte, vor denen man Respekt haben muss.  Sie bieten den Würdigen große Hilfe an und bringen den Törichten einen schnellen Tod.",
        "98bf40c1ebc18e4354c8": "Ich möchte Eure Waren ansehen.",
        "d4f06b3ac683745a150d": "Seid gegrüßt, Reisender."
      },
      "name": "Zor Lonetree",
      "subName": "Ältestenscharfseher",
