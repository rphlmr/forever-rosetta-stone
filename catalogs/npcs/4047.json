    "enUS": {
      "dialogue": {
        "0bafba34307001a26c71": "Train me.",
        "907e71c76be261c4bacb": "The spirits of nature are powers to respect.  They offer great aid to the worthy, and mete out swift death to the foolish.",
        "98bf40c1ebc18e4354c8": "I want to browse your goods.",
        "d4f06b3ac683745a150d": "Greetings, traveler."
      },
      "name": "Zor Lonetree",
      "subName": "Elder Far Seer",
