    "hrHR": {
      "dialogue": {
        "0bafba34307001a26c71": "Podučite me.",
        "907e71c76be261c4bacb": "Duhovi prirode sile su koje treba poštovati. Dostojnima pružaju veliku pomoć, a ludima donose brzu smrt.",
        "98bf40c1ebc18e4354c8": "Želim pogledati vašu robu.",
        "d4f06b3ac683745a150d": "Pozdrav, putniče."
