    "daDK": {
      "dialogue": {
        "0bafba34307001a26c71": "Træn mig.",
        "907e71c76be261c4bacb": "Naturens ånder er kræfter, man bør respektere. De yder stor hjælp til de værdige og bringer hurtig død til tåberne.",
        "98bf40c1ebc18e4354c8": "Jeg vil gerne se dine varer.",
        "d4f06b3ac683745a150d": "Vel mødt, rejsende."
      },
      "name": "Zor Lonetree",
