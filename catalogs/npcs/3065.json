    "hrHR": {
      "dialogue": {
        "588b30b393dc162e25fa": "Nemam znanje koje tražiš.",
        "722d80c371cebe550421": "Taureni strastveno vole lov; to je duboko ukorijenjeno u našem narodu.",
        "bbafbe1daac05acfc9cc": "Prijatelju, pomažem samo lovcima i njihovim ljubimcima.",
        "db6712cd74cd364814e6": "Strogim prekvalificiranjem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao ponovno podučavati. Tu je uslugu sve teže pružiti svaki put kada se ponovi. Zato je svako sljedeće prekvalificiranje sve skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "f0b7389c9eba720eb09a": "Lovac sam i želim učiti."
      },
      "name": "Yaw Sharpmane",
