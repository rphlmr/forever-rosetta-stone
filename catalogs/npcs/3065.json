    "plPL": {
      "dialogue": {
        "588b30b393dc162e25fa": "Nie posiadam wiedzy, której szukasz.",
        "722d80c371cebe550421": "Taureni kochają polowania; to głęboko zakorzenione w naszym ludzie.",
        "bbafbe1daac05acfc9cc": "Przyjacielu, pomagam tylko łowcom i ich zwierzętom.",
        "db6712cd74cd364814e6": "Dzięki surowemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Z każdym kolejnym razem wykonanie tej usługi staje się trudniejsze. Dlatego też każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "f0b7389c9eba720eb09a": "Jestem łowcą i chcę się szkolić."
      },
      "name": "Yaw Sharpmane",
      "translationMetadata": {
