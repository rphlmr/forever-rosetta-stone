  "locales": {
    "csCZ": {
      "dialogue": {
        "588b30b393dc162e25fa": "Nemám znalosti, které hledáš.",
        "722d80c371cebe550421": "Taureni vášnivě loví; je to hluboce zakořeněno v naší povaze.",
        "bbafbe1daac05acfc9cc": "Příteli, pomáhám pouze lovcům a jejich mazlíčkům.",
        "db6712cd74cd364814e6": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je při každém dalším provedení náročnější. Proto je každé další přeškolení také dražší. Chceš, abych tě odnaučila talenty, které ses naučil?",
        "f0b7389c9eba720eb09a": "Jsem lovec a chci trénovat."
      },
      "name": "Yaw Sharpmane",
      "translationMetadata": {
        "fields": {
          "dialogue.588b30b393dc162e25fa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
