    "daDK": {
      "dialogue": {
        "588b30b393dc162e25fa": "Jeg har ikke den viden, du søger.",
        "722d80c371cebe550421": "Taurener elsker jagt; det ligger dybt i vores folk.",
        "bbafbe1daac05acfc9cc": "Åh, ven, jeg hjælper kun jægere og deres kæledyr.",
        "db6712cd74cd364814e6": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang, den udføres. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "f0b7389c9eba720eb09a": "Jeg er jæger og ønsker træning."
      },
      "name": "Yaw Sharpmane",
      "translationMetadata": {
        "fields": {
          "dialogue.588b30b393dc162e25fa": {
