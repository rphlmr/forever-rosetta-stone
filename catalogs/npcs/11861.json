    "daDK": {
      "dialogue": {
        "d19fd4c6ec9fde47f0df": "Stonetalon Mountain har mange farlige huler i hele området. At udforske dem kan byde på mange eventyr for dem, der vil risikere livet for ære.$B$B$C, måske søger du rigdomme, som kun kan vindes ved at følge dit hjerte og din sjæl."
      },
      "name": "Mor'rogal",
      "translationMetadata": {
