  "locales": {
    "csCZ": {
      "dialogue": {
        "d19fd4c6ec9fde47f0df": "V celém pohoří Stonetalon se nachází mnoho nebezpečných jeskyní. Jejich průzkum nabízí dobrodružství těm, kdo jsou ochotni riskovat život pro slávu.$B$B$C, možná hledáš bohatství, které získáš jen následováním svého srdce a duše."
      },
      "name": "Mor'rogal",
      "translationMetadata": {
