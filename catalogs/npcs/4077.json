    "hrHR": {
      "dialogue": {
        "0dff9051da70bf9cc98b": "Ako nabavim prave sastojke, možemo napraviti eksploziv koji će mi omogućiti ne samo da naštetim poslovanju Venture Co., nego i da odvratim pozornost.$B$BZnam da si zadivljen, ali bit će još bolje... Uskoro ću ti reći više.",
        "1547c21321c7a2e53fec": "Želim pogledati vašu robu.",
        "67e06b88e01dd530a068": "Podučite me."
      },
      "name": "Gaxim Rustfizzle",
