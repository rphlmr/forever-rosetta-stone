  "locales": {
    "csCZ": {
      "dialogue": {
        "0dff9051da70bf9cc98b": "Pokud získám správné přísady, můžeme vyrobit výbušniny, které mi nejen umožní poškodit operace Venture Co., ale také odvedou pozornost.$B$BVím, že jsi ohromen, ale bude to ještě lepší... Brzy ti povím víc.",
        "1547c21321c7a2e53fec": "Chci si prohlédnout vaše zboží.",
        "67e06b88e01dd530a068": "Vycvičte mě."
      },
      "name": "Gaxim Rustfizzle",
      "translationMetadata": {
        "fields": {
