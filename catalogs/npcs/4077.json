    "enUS": {
      "dialogue": {
        "0dff9051da70bf9cc98b": "If I can get the proper ingredients, we can create some explosives that will not only allow me to damage the Venture's Co.'s operations, but also cause a distraction.$B$BI know you're impressed, but it gets better... I'll tell you more soon enough.",
        "1547c21321c7a2e53fec": "I want to browse your goods.",
        "67e06b88e01dd530a068": "Train me."
      },
      "name": "Gaxim Rustfizzle",
