    "csCZ": {
      "dialogue": {
        "0986a31d4cbe240bd3e0": "Vycvičte mě.",
        "541c59e2c14e749cdbf4": "Rád bych si prohlédl vaše zboží.",
        "a2fb80f72bbedc1ec8cb": "Aha! Dobrý den, dobrý den, mistře $C! Pojďte, posaďte se a dejte si něco k pití. V očích máte podnikavý výraz a myslím, že rozhovor se mnou bude stát za váš čas..."
      },
      "name": "William Pestle",
