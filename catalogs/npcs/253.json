    "deDE": {
      "dialogue": {
        "0986a31d4cbe240bd3e0": "Bildet mich aus.",
        "541c59e2c14e749cdbf4": "Ich möchte Eure Waren ansehen.",
        "a2fb80f72bbedc1ec8cb": "Aha! Guten Tag, guten Tag, Meister $C! Kommt, setzt Euch und trinkt etwas. Ihr habt so ein Leuchten in den Augen, als wolltet ihr gern etwas tun. Ich denke, Ihr solltet ein paar Wörtchen mit mir wechseln, es lohnt sich bestimmt..."
      },
      "name": "William Pestle",
