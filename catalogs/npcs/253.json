    "daDK": {
      "dialogue": {
        "0986a31d4cbe240bd3e0": "Træn mig.",
        "541c59e2c14e749cdbf4": "Jeg vil gerne se dine varer.",
        "a2fb80f72bbedc1ec8cb": "Aha! Goddag, goddag, mester $C! Kom, sæt dig og få noget at drikke. Du har et foretagsomt blik, og jeg tror, du vil finde det umagen værd at tale med mig..."
      },
      "name": "William Pestle",
