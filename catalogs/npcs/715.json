    "plPL": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Chcę przejrzeć twoje towary.",
        "c104441a30c5f4ef958f": "Wyszkol mnie.",
        "cf6093efd04ff13ac8b2": "Kolejny piękny dzień w dżungli! Czuję, że to będzie wspaniałe polowanie. Gdy Barnil skończy czyścić strzelby, poprowadzę grupę w głąb splątanych pnączy. Nie najgorsza emerytura dla starego weterana, co?"
      },
      "name": "Hemet Nesingwary",
