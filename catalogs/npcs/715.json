    "svSE": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Jag vill se dina varor.",
        "c104441a30c5f4ef958f": "Träna mig.",
        "cf6093efd04ff13ac8b2": "Ännu en fin dag i djungeln! Jag känner på mig att det blir en storslagen jakt. När Barnil har rengjort gevären tar jag jaktlaget djupt in bland slingerväxterna. Inte ett dåligt sätt för en gammal krigsveteran att tillbringa pensionen, va?"
      },
      "name": "Hemet Nesingwary",
      "translationMetadata": {
