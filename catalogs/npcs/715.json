    "hrHR": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Želim pogledati vašu robu.",
        "c104441a30c5f4ef958f": "Podučite me.",
        "cf6093efd04ff13ac8b2": "Još jedan lijep dan u džungli! Osjećam da nas čeka odličan lov. Kad Barnil očisti puške, vodim lovačku družinu duboko među lijane. Nije loša mirovina za starog ratnog veterana, zar ne?"
      },
      "name": "Hemet Nesingwary",
      "translationMetadata": {
        "fields": {
