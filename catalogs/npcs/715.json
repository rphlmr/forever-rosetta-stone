    },
    "enUS": {
      "dialogue": {
        "4b8abf697a525e5cae03": "I want to browse your goods.",
        "c104441a30c5f4ef958f": "Train me.",
        "cf6093efd04ff13ac8b2": "Another fine day in the jungle!  It's going to be quite a hunt, I can feel it.  Once Barnil is done cleaning the guns, I'm taking the hunting party deep into the twisting vines.  Not such a bad way for an old war vet to spend his retirement, eh?"
      },
      "name": "Hemet Nesingwary",
      "translationMetadata": {
        "fields": {
          "dialogue.4b8abf697a525e5cae03": {
