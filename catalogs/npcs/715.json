    "ltLT": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Noriu apžiūrėti tavo prekes.",
        "c104441a30c5f4ef958f": "Išmokyk mane.",
        "cf6093efd04ff13ac8b2": "Dar viena puiki diena džiunglėse! Jaučiu, kad laukia neeilinė medžioklė. Kai Barnil baigs valyti šautuvus, vesiu medžiotojų būrį gilyn į susiraizgiusius vijoklius. Visai neblogas būdas senam karo veteranui leisti pensiją, ar ne?"
      },
      "name": "Hemet Nesingwary",
