    },
    "daDK": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Jeg vil gerne se dine varer.",
        "c104441a30c5f4ef958f": "Træn mig.",
        "cf6093efd04ff13ac8b2": "Endnu en dejlig dag i junglen! Jeg kan mærke, at det bliver en fantastisk jagt. Når Barnil er færdig med at rense geværerne, tager jeg jagtselskabet dybt ind mellem slyngplanterne. Ikke nogen dårlig pensionisttilværelse for en gammel krigsveteran, hva?"
      },
      "name": "Hemet Nesingwary",
      "translationMetadata": {
        "fields": {
          "dialogue.4b8abf697a525e5cae03": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
