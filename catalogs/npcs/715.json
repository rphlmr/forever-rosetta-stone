  "locales": {
    "csCZ": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Rád bych si prohlédl vaše zboží.",
        "c104441a30c5f4ef958f": "Vycvičte mě.",
        "cf6093efd04ff13ac8b2": "Další krásný den v džungli! Cítím, že nás čeká skvělý lov. Až Barnil vyčistí pušky, povedu loveckou výpravu hluboko do lián. Na starého válečného veterána to není špatný důchod, co?"
      },
      "name": "Hemet Nesingwary",
      "translationMetadata": {
        "fields": {
          "dialogue.4b8abf697a525e5cae03": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
