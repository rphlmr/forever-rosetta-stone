    "esES": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Quiero ver tus mercancías.",
        "c104441a30c5f4ef958f": "Entréname.",
        "cf6093efd04ff13ac8b2": "¡Otro buen día en la jungla!  Va a ser toda una cacería, puedo sentirlo.  Una vez que Barnil termine de limpiar las armas, llevaré a la partida de caza a las profundidades de las enredaderas retorcidas.  No es una mala manera para un viejo veterano de guerra pasar su jubilación, ¿eh?"
      },
      "name": "Hemet Decautela",
      "translationMetadata": {
        "fields": {
