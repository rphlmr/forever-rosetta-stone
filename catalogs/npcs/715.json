    "ptBR": {
      "dialogue": {
        "4b8abf697a525e5cae03": "Quero ver suas mercadorias.",
        "c104441a30c5f4ef958f": "Treine-me.",
        "cf6093efd04ff13ac8b2": "Mais um belo dia na selva! Sinto que será uma grande caçada. Quando Barnil terminar de limpar as armas, levarei o grupo para o fundo das trepadeiras. Nada mau para um velho veterano passar a aposentadoria, não é?"
      },
      "name": "Rosarães Guima",
