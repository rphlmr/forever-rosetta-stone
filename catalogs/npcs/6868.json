    "daDK": {
      "dialogue": {
        "1460f547cb411dd79c30": "Træn mig.",
        "6cff0501be691cc6be11": "Hvad har du brug for, $c? Jeg går ud fra, at du er kommet til denne ødemark af en anden grund end løs snak.",
        "f93612ccea406eddaaa8": "Jeg vil gerne se dine varer."
      },
      "name": "Jarkal Mossmeld",
      "translationMetadata": {
