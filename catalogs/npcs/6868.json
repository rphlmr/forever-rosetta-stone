      "dialogue": {
        "1460f547cb411dd79c30": "Train me.",
        "6cff0501be691cc6be11": "Whatcha need, $c?  I trust that you've come out to this wasteland for a reason other than idle chit chat.",
        "f93612ccea406eddaaa8": "I want to browse your goods."
      },
      "name": "Jarkal Mossmeld",
