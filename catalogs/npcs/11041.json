    "plPL": {
      "dialogue": {
        "03e87286b1527fad5c50": "Wyszkol mnie.",
        "2789371238b1e4a462e5": "Elune-adore, $gmój bracie:moja siostro;. Witaj tutaj. Mów, a zrobię, co w mojej mocy, by ci pomóc.",
        "3aed7a531da61681ebe5": "Miło, że mnie szukasz, ale twoje umiejętności przewyższają moje. Porozmawiaj z Sylvanną Forestmoon, tam. Szuka kolejnego ucznia.",
        "91ae0890b29d79a5e99d": "Czy to nie zadziwiające, co można stworzyć z leśnych roślin? Elune naprawdę obdarzyła nas swą hojnością.",
        "b2b6a18df813bd30ade2": "Elune-adore, $gmój bracie:moja siostro;. Witaj tutaj. Mów, a zrobię, co w mojej mocy, by ci pomóc."
      },
      "name": "Milla Fairancora",
