  "locales": {
    "csCZ": {
      "dialogue": {
        "03e87286b1527fad5c50": "Vycvičte mě.",
        "2789371238b1e4a462e5": "Elune-adore, $gmůj bratře:má sestro;. Vítej zde. Mluv a já udělám vše, co bude v mých silách, abych ti pomohla.",
        "3aed7a531da61681ebe5": "Je od tebe milé, že jsi mě vyhledal, ale tvé schopnosti převyšují ty mé. Promluv si se Sylvannou Forestmoon, támhle. Hledá dalšího žáka.",
        "91ae0890b29d79a5e99d": "Není úžasné, co všechno lze vytvořit z lesních rostlin? Elune nám skutečně požehnala svými dary.",
        "b2b6a18df813bd30ade2": "Elune-adore, $gmůj bratře:má sestro;. Vítej zde. Mluv a já udělám vše, co bude v mých silách, abych ti pomohla."
      },
      "name": "Milla Fairancora",
