    "daDK": {
      "dialogue": {
        "03e87286b1527fad5c50": "Træn mig.",
        "2789371238b1e4a462e5": "Elune-adore, min $gbror:søster;. Du er velkommen her. Tal, så vil jeg gøre, hvad jeg kan for at hjælpe dig.",
        "3aed7a531da61681ebe5": "Det er venligt af dig at opsøge mig, men dine evner overgår mine. Tal med Sylvanna Forestmoon lige derovre. Hun har ledt efter endnu en elev.",
        "91ae0890b29d79a5e99d": "Er det ikke forbløffende, hvad man kan skabe af skovens planter? Elune har sandelig velsignet os med sin gavmildhed.",
        "b2b6a18df813bd30ade2": "Elune-adore, min $gbror:søster;. Du er velkommen her. Tal, så vil jeg gøre, hvad jeg kan for at hjælpe dig."
      },
      "name": "Milla Fairancora",
