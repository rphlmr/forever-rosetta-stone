    "svSE": {
      "dialogue": {
        "03e87286b1527fad5c50": "Träna mig.",
        "2789371238b1e4a462e5": "Elune-adore, min $gbror:syster;. Du är välkommen här. Tala, så ska jag göra vad jag kan för att hjälpa dig.",
        "3aed7a531da61681ebe5": "Det är vänligt av dig att söka upp mig, men dina färdigheter överträffar mina. Tala med Sylvanna Forestmoon där borta. Hon har sökt en elev till.",
        "91ae0890b29d79a5e99d": "Är det inte fantastiskt vad man kan skapa av skogens växter? Elune har verkligen välsignat oss med sina gåvor.",
        "b2b6a18df813bd30ade2": "Elune-adore, min $gbror:syster;. Du är välkommen här. Tala, så ska jag göra vad jag kan för att hjälpa dig."
      },
      "name": "Milla Fairancora",
