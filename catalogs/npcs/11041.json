    "enUS": {
      "dialogue": {
        "03e87286b1527fad5c50": "Train me.",
        "2789371238b1e4a462e5": "Elune-adore, my $gbrother:sister;. You are welcome here. Speak, and I will do what I can to aid you.",
        "3aed7a531da61681ebe5": "You are kind to seek me out, but your skills are beyond my own. Have a word with Sylvanna Forestmoon, just over there. She's been looking for another student.",
        "91ae0890b29d79a5e99d": "Is it not astonishing what one can create from the plants of the forest? Truly, Elune has blessed us with her bounty.",
        "b2b6a18df813bd30ade2": "Elune-adore, my $gbrother:sister;. You are welcome here. Speak, and I will do what I can to aid you."
      },
      "name": "Milla Fairancora",
      "subName": "Journeyman Alchemist",
