    "esES": {
      "dialogue": {
        "0310363e2810060a5969": "En tiempos remotos, vivíamos para la caza. La caza de gloria, de honor... \n\n¿Es que ahora es tan diferente?",
        "56ea90eb4bbdaf307cd8": "El ancestro Altomonte está en el Campamento Taurajo en Los Baldíos.",
        "6ad57bb36b66cb84b4c9": "El ancestro Astaorgullo está disfrutando de las vistas de Mulgore desde Cima del Trueno.",
        "8b40f0f23a3bbfde5bc6": "El ancestro Vientótem está en compañía de los goblins de Trinquete en la costa de Los Baldíos.",
        "f573221d02c753ce45ee": "El ancestro Guardaluna está vigilando El Cruce en Los Baldíos."
      },
      "name": "Ancestro Pezuña de Sangre",
