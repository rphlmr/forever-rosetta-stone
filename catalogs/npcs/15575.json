    "csCZ": {
      "dialogue": {
        "0310363e2810060a5969": "Kdysi dávno jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "56ea90eb4bbdaf307cd8": "Starší High Mountain je v Camp Taurajo v Barrens.",
        "6ad57bb36b66cb84b4c9": "Starší Proudhorn se kochá výhledem na Mulgore z Thunder Bluffu.",
        "8b40f0f23a3bbfde5bc6": "Starší Windtotem dělá společnost goblinům v Ratchetu na pobřeží Barrens.",
        "f573221d02c753ce45ee": "Starší Moonwarden pozoruje Crossroads v Barrens."
      },
      "name": "Starší Bloodhoof",
