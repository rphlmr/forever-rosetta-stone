    "plPL": {
      "dialogue": {
        "0310363e2810060a5969": "W dawnych czasach żyliśmy dla polowania. Polowaliśmy dla chwały, dla honoru...$B$BCzy dziś jest tak inaczej?",
        "56ea90eb4bbdaf307cd8": "Starszy High Mountain przebywa w Camp Taurajo w Barrens.",
        "6ad57bb36b66cb84b4c9": "Starszy Proudhorn podziwia widoki na Mulgore z Thunder Bluff.",
        "8b40f0f23a3bbfde5bc6": "Starszy Windtotem dotrzymuje towarzystwa goblinom w Ratchet na wybrzeżu Barrens.",
        "f573221d02c753ce45ee": "Starszy Moonwarden obserwuje Crossroads w Barrens."
      },
      "name": "Starszy Bloodhoof",
