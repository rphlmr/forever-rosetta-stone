    "enUS": {
      "dialogue": {
        "0310363e2810060a5969": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "56ea90eb4bbdaf307cd8": "Elder High Mountain is at Camp Taurajo in the Barrens.",
        "6ad57bb36b66cb84b4c9": "Elder Proudhorn is enjoying the vistas above Mulgore at Thunder Bluff.",
        "8b40f0f23a3bbfde5bc6": "Elder Windtotem is keeping company with the goblins of Ratchet on the coast of the Barrens.",
        "f573221d02c753ce45ee": "Elder Moonwarden is observing the Crossroads in the Barrens."
      },
      "name": "Elder Bloodhoof",
      "translationMetadata": {
