    "ltLT": {
      "dialogue": {
        "0310363e2810060a5969": "Seniai seniai gyvenome dėl medžioklės. Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "56ea90eb4bbdaf307cd8": "Vyresnysis High Mountain yra Camp Taurajo stovykloje, Barrens krašte.",
        "6ad57bb36b66cb84b4c9": "Vyresnysis Proudhorn gėrisi vaizdais virš Mulgore, Thunder Bluff mieste.",
        "8b40f0f23a3bbfde5bc6": "Vyresnysis Windtotem leidžia laiką su Ratchet goblinais Barrens pakrantėje.",
        "f573221d02c753ce45ee": "Vyresnysis Moonwarden stebi Crossroads gyvenvietę Barrens krašte."
      },
      "name": "Vyresnysis Bloodhoof",
