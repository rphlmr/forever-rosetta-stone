    "trTR": {
      "dialogue": {
        "0310363e2810060a5969": "Çok eski günlerde av için yaşardık. Şan için, onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "56ea90eb4bbdaf307cd8": "Yaşlı High Mountain, Barrens’taki Camp Taurajo’da.",
        "6ad57bb36b66cb84b4c9": "Yaşlı Proudhorn, Thunder Bluff’tan Mulgore manzarasının tadını çıkarıyor.",
        "8b40f0f23a3bbfde5bc6": "Yaşlı Windtotem, Barrens kıyısındaki Ratchet’ta goblinlere eşlik ediyor.",
        "f573221d02c753ce45ee": "Yaşlı Moonwarden, Barrens’taki Crossroads’u gözetliyor."
      },
      "name": "Ulu Bloodhoof",
