    "svSE": {
      "dialogue": {
        "0310363e2810060a5969": "I svunna tider levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "56ea90eb4bbdaf307cd8": "Äldste High Mountain finns vid Camp Taurajo i Barrens.",
        "6ad57bb36b66cb84b4c9": "Äldste Proudhorn njuter av utsikten över Mulgore vid Thunder Bluff.",
        "8b40f0f23a3bbfde5bc6": "Äldste Windtotem håller goblinerna i Ratchet sällskap på Barrens kust.",
        "f573221d02c753ce45ee": "Äldste Moonwarden vakar över Crossroads i Barrens."
      },
      "name": "Äldste Bloodhoof",
