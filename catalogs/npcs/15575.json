    "daDK": {
      "dialogue": {
        "0310363e2810060a5969": "I svundne tider levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "56ea90eb4bbdaf307cd8": "Ældste High Mountain er ved Camp Taurajo i Barrens.",
        "6ad57bb36b66cb84b4c9": "Ældste Proudhorn nyder udsigten over Mulgore ved Thunder Bluff.",
        "8b40f0f23a3bbfde5bc6": "Ældste Windtotem holder goblinerne i Ratchet med selskab ved Barrens kyst.",
        "f573221d02c753ce45ee": "Ældste Moonwarden holder øje med Crossroads i Barrens."
      },
      "name": "Ældste Bloodhoof",
