    "daDK": {
      "dialogue": {
        "9ba14e7b9f5204b0ef97": "Jeg vil gerne se dine varer.",
        "f32e6319e735f0929ee9": "Tal lavmælt og meget forsigtigt. Et forkert ord her omkring kan få halsen skåret over på dig. Hvad har du brug for fra mig?"
      },
      "name": "Sloan McCoy",
      "translationMetadata": {
