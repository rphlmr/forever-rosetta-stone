    "csCZ": {
      "dialogue": {
        "9ba14e7b9f5204b0ef97": "Rád bych si prohlédl vaše zboží.",
        "f32e6319e735f0929ee9": "Mluv tiše a velmi opatrně, tady tě špatné slovo může stát hrdlo. Tak co ode mě potřebuješ?"
      },
      "name": "Sloan McCoy",
      "translationMetadata": {
        "fields": {
