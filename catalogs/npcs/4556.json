      "dialogue": {
        "2dd51458d51e3da985b1": "Noriu apžiūrėti tavo prekes.",
        "d24dde6be62975c9dd26": "Sveikas atvykęs. Nelabai moku šypsotis, bet patikėk, mielai tau patarnausiu.",
        "zephras:3e639a0d436530c2ffb0": "Leisk apžiūrėti tavo prekes."
