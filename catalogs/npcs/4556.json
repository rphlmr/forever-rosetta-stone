    "deDE": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Ich möchte Eure Waren ansehen.",
        "d24dde6be62975c9dd26": "Seid gegrüßt und willkommen. Zu lächeln fällt mir nicht leicht, aber glaubt mir, ich bin erfreut, Euch dienen zu können.",
        "zephras:3e639a0d436530c2ffb0": "Lasst mich Eure Waren ansehen."
      },
      "name": "Gordon Wendham",
      "subName": "Waffenhändler",
