    "hrHR": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Želim pogledati vašu robu.",
        "d24dde6be62975c9dd26": "Pozdrav i dobro došao. Ne ide mi baš osmjehivanje, ali vjeruj mi, drago mi je poslužiti te.",
        "zephras:3e639a0d436530c2ffb0": "Dopusti mi da razgledam tvoju robu."
      },
      "name": "Gordon Wendham",
