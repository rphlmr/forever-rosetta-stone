    "daDK": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Jeg vil gerne se dine varer.",
        "d24dde6be62975c9dd26": "Velkommen. Jeg er ikke særlig god til at smile, men tro mig, jeg hjælper dig gerne.",
        "zephras:3e639a0d436530c2ffb0": "Lad mig se dine varer."
      },
      "name": "Gordon Wendham",
      "translationMetadata": {
