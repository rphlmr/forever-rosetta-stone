    "ptBR": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Quero ver suas mercadorias.",
        "d24dde6be62975c9dd26": "Saudações e boas-vindas. Não sou muito de sorrir, mas acredite: fico feliz em lhe servir.",
        "zephras:3e639a0d436530c2ffb0": "Deixe-me ver suas mercadorias."
      },
