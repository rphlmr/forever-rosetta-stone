    "itIT": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Vorrei vedere la tua merce.",
        "d24dde6be62975c9dd26": "Salute e benvenuto. Non sono molto bravo a sorridere, ma fidati: sono felice di servirti.",
        "zephras:3e639a0d436530c2ffb0": "Fammi dare un’occhiata alla tua merce."
      },
      "name": "Gordon Wendham",
