  "locales": {
    "csCZ": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Rád bych si prohlédl vaše zboží.",
        "d24dde6be62975c9dd26": "Zdravím a vítej. Usmívání mi moc nejde, ale věř mi, rád tě obsloužím.",
        "zephras:3e639a0d436530c2ffb0": "Dovol mi prohlédnout si tvé zboží."
      },
      "name": "Gordon Wendham",
      "translationMetadata": {
