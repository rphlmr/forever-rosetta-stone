    "enUS": {
      "dialogue": {
        "2dd51458d51e3da985b1": "I want to browse your goods.",
        "d24dde6be62975c9dd26": "Greetings, and welcome.  I am not very good at smiling, but trust me; I am happy to serve you.",
        "zephras:3e639a0d436530c2ffb0": "Let me browse your goods."
      },
      "name": "Gordon Wendham",
      "subName": "Weapons Merchant",
