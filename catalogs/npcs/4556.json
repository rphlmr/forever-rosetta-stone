    "plPL": {
      "dialogue": {
        "2dd51458d51e3da985b1": "Chcę przejrzeć twoje towary.",
        "d24dde6be62975c9dd26": "Witaj. Nie najlepiej wychodzi mi uśmiechanie się, ale uwierz, chętnie cię obsłużę.",
        "zephras:3e639a0d436530c2ffb0": "Pozwól mi obejrzeć twój towar."
