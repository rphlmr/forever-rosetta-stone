    "deDE": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Ich möchte Eure Waren ansehen.",
        "955c3a93ccb48576c09b": "Die Aufgabe der Ausreißer ist es, die Sicherheit derjenigen zu gewährleisten, die durch die Ebenen von Mulgore reisen. Diejenigen, die die Sicherheit der taurischen Heimat bedrohen, riskieren eine Bestrafung durch uns.",
        "b8a0888993754a465a14": "Bildet mich aus."
      },
      "name": "Morin Cloudstalker",
      "translationMetadata": {
        "fields": {
