    "enUS": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "I want to browse your goods.",
        "955c3a93ccb48576c09b": "The Outrunners' duty is to ensure the safety of those who travel across the plains of Mulgore. Those that would threaten the safety of the tauren homeland risk punishment at our hands.",
        "b8a0888993754a465a14": "Train me."
      },
      "name": "Morin Cloudstalker",
