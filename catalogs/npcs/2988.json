    "hrHR": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Želim pogledati vašu robu.",
        "955c3a93ccb48576c09b": "Dužnost je izvidnika osigurati sigurnost onih koji putuju ravnicama Mulgorea. Oni koji ugrožavaju sigurnost taurenske domovine riskiraju našu kaznu.",
        "b8a0888993754a465a14": "Podučite me."
      },
