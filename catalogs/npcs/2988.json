    "daDK": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Jeg vil gerne se dine varer.",
        "955c3a93ccb48576c09b": "Forløbernes opgave er at sikre trygheden for dem, der rejser over Mulgore-sletterne. De, der truer taurenfolkets hjemland, risikerer straf fra os.",
        "b8a0888993754a465a14": "Træn mig."
      },
      "name": "Morin Cloudstalker",
      "translationMetadata": {
        "fields": {
          "dialogue.16bee2f7f9bb743fa8ed": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
