    "frFR": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Je voudrais regarder vos articles.",
        "955c3a93ccb48576c09b": "Le devoir des Outrunners est d'assurer la sécurité de ceux qui voyagent à travers les plaines de Mulgore. Ceux qui menacent la sécurité de la patrie taurine risquent d'être punis par nos soins.",
        "b8a0888993754a465a14": "Entraînez-moi."
      },
      "name": "Morin Cloudstalker",
