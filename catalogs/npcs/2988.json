    "ptBR": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Quero ver suas mercadorias.",
        "955c3a93ccb48576c09b": "O dever dos batedores é garantir a segurança de quem viaja pelas planícies de Mulgore. Aqueles que ameaçam a segurança da terra natal dos tauren arriscam ser punidos por nós.",
        "b8a0888993754a465a14": "Treine-me."
      },
      "name": "Morin Espreita Nuvem",
