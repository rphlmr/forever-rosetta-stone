    "itIT": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Vorrei vedere la tua merce.",
        "955c3a93ccb48576c09b": "Il compito degli Outrunners è garantire la sicurezza di chi attraversa le pianure di Mulgore. Chi osa minacciare la sicurezza della patria dei tauren rischia di essere punito per mano nostra.",
        "b8a0888993754a465a14": "Addestrami."
      },
      "name": "Morin Cloudstalker",
