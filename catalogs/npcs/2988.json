    "plPL": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Chcę przejrzeć twoje towary.",
        "955c3a93ccb48576c09b": "Zadaniem zwiadowców jest zapewnienie bezpieczeństwa podróżującym przez równiny Mulgore. Ci, którzy zagrażają ojczyźnie taurenów, narażają się na naszą karę.",
        "b8a0888993754a465a14": "Wyszkol mnie."
      },
