    "ltLT": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Noriu apžiūrėti tavo prekes.",
        "955c3a93ccb48576c09b": "Žvalgų pareiga yra užtikrinti keliaujančiųjų per Mulgore lygumas saugumą. Tie, kurie kėsinasi į taurenų gimtinės saugumą, rizikuoja sulaukti mūsų bausmės.",
        "b8a0888993754a465a14": "Išmokyk mane."
      },
      "name": "Morin Cloudstalker",
