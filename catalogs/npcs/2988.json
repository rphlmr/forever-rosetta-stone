  "locales": {
    "csCZ": {
      "dialogue": {
        "16bee2f7f9bb743fa8ed": "Chci si prohlédnout vaše zboží.",
        "955c3a93ccb48576c09b": "Úkolem průzkumníků je zajistit bezpečí těch, kdo cestují po pláních Mulgore. Kdo ohrožuje bezpečí domoviny taurenů, riskuje trest z našich rukou.",
        "b8a0888993754a465a14": "Vycvičte mě."
      },
      "name": "Morin Cloudstalker",
      "translationMetadata": {
        "fields": {
          "dialogue.16bee2f7f9bb743fa8ed": {
            "origin": "ai",
