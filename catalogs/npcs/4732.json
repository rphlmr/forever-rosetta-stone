    "plPL": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Szukam szkolenia w jeździe na wierzchowcu.",
        "b981686d406a7a91a83f": "Mogę nauczyć cię tajników jazdy konnej, o ile masz dość złota, by zapłacić za lekcję!",
        "c1bc2b501184ba842fa8": "Musisz cieszyć się najwyższym uznaniem ludzi ze Stormwind, zanim nauczę cię jeździć, $c."
      },
      "name": "Randal Hunter",
