  "locales": {
    "csCZ": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Hledám výcvik v jízdě na jezdeckém zvířeti.",
        "b981686d406a7a91a83f": "Mohu tě zasvětit do jemností jízdy na koni, pokud máš dost zlata na zaplacení lekce!",
        "c1bc2b501184ba842fa8": "Než tě naučím jezdit, musíš si získat úctu lidí z Bouřného větru, $c."
      },
      "name": "Randal Hunter",
      "translationMetadata": {
        "fields": {
