    "hrHR": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Želim naučiti jahati jahaću životinju.",
        "b981686d406a7a91a83f": "Mogu te podučiti vještini jahanja konja, ako imaš dovoljno zlata za lekciju!",
        "c1bc2b501184ba842fa8": "Moraš steći najveći ugled među ljudima Stormwinda prije nego što te naučim jahati, $c."
      },
      "name": "Randal Hunter",
