    "enUS": {
      "dialogue": {
        "207ea34694324f7aa0e0": "I seek training to ride a steed.",
        "b981686d406a7a91a83f": "I can teach you the finer points of Horse Riding, provided you have enough gold to cover the lesson!",
        "c1bc2b501184ba842fa8": "You need to be exalted with the humans of Stormwind before I will teach you a riding skill, $c."
      },
      "name": "Randal Hunter",
      "subName": "Horse Riding Instructor",
