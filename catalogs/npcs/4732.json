    "itIT": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Cerco un addestramento per cavalcare una cavalcatura.",
        "b981686d406a7a91a83f": "Posso insegnarti i segreti di Horse Riding, purché tu abbia abbastanza oro per pagare la lezione!",
        "c1bc2b501184ba842fa8": "Devi essere exalted con gli umani di Stormwind prima che io ti insegni a cavalcare, $C."
      },
      "name": "Randal Hunter",
