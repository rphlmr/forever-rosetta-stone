    "deDE": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Ich suche eine Ausbildung im Reiten.",
        "b981686d406a7a91a83f": "Ich kann Euch die Feinheiten des Reitens auf Pferden beibringen, vorausgesetzt, Ihr tragt genug Gold bei Euch, um die Stunde bezahlen zu können!",
        "c1bc2b501184ba842fa8": "Die Menschen von Stormwind müssen Euch mit Ehrfurcht begegnen, bevor ich Euch eine Reitfertigkeit lehre, $C."
      },
      "name": "Randal Hunter",
      "subName": "Pferdereitlehrer",
      "translationMetadata": {
