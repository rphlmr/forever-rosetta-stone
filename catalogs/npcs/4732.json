    "esES": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Busco instrucción para aprender a montar.",
        "b981686d406a7a91a83f": "Puedo enseñarte los mejores trucos para montar a caballo, ¡siempre que tengas suficiente oro para pagar la lección!",
        "c1bc2b501184ba842fa8": "Es necesario que los humanos de Ventormenta te consideren un exaltado para que te pueda enseñar la habilidad de montar."
      },
      "name": "Randal Predatio",
      "subName": "Instructor de equitación",
