    "daDK": {
      "dialogue": {
        "207ea34694324f7aa0e0": "Jeg søger undervisning i at ride på et ridedyr.",
        "b981686d406a7a91a83f": "Jeg kan lære dig ridekunstens finesser, hvis du har guld nok til at betale for lektionen!",
        "c1bc2b501184ba842fa8": "Du skal være højt agtet blandt Stormwinds mennesker, før jeg lærer dig at ride, $c."
      },
      "name": "Randal Hunter",
      "translationMetadata": {
        "fields": {
