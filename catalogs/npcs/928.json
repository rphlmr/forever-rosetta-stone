  "locales": {
    "csCZ": {
      "dialogue": {
        "5328c2b021d54d4de527": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "756046ea4536a76009d1": "Nechť tě dnes Světlo ochraňuje.",
        "d50f2214f8cb98a4a99d": "Přísným přeškolením jsem musel mnoho studentů odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?"
      },
      "name": "Lord Grayson Shadowbreaker",
      "translationMetadata": {
        "fields": {
          "dialogue.5328c2b021d54d4de527": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
