    "enUS": {
      "dialogue": {
        "5328c2b021d54d4de527": "I would like to train further in the ways of the Light.",
        "756046ea4536a76009d1": "May the Light protect you this day.",
        "d50f2214f8cb98a4a99d": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Lord Grayson Shadowbreaker",
      "subName": "Paladin Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.5328c2b021d54d4de527": {
