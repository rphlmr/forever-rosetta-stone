    "hrHR": {
      "dialogue": {
        "5328c2b021d54d4de527": "Želio bih nastaviti obuku na putevima Svjetlosti.",
        "756046ea4536a76009d1": "Neka te Svjetlost danas štiti.",
        "d50f2214f8cb98a4a99d": "Strogim ponovnim obučavanjem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao podučavati iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako ponovno obučavanje postaje skuplje. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Lord Grayson Shadowbreaker",
      "translationMetadata": {
