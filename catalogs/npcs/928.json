          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "5328c2b021d54d4de527": "Jeg vil gerne videreuddanne mig i Lysets veje.",
        "756046ea4536a76009d1": "Må Lyset beskytte dig denne dag.",
        "d50f2214f8cb98a4a99d": "Gennem grundig omskoling har jeg måttet få mange elever til at aflære alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre, hver gang den gentages. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at aflære de talenter, du har lært?"
      },
      "name": "Lord Grayson Shadowbreaker",
      "translationMetadata": {
        "fields": {
          "dialogue.5328c2b021d54d4de527": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
