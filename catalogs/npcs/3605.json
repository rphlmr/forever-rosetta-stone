    "esES": {
      "dialogue": {
        "6f09bda6d323e4336667": "Entréname.",
        "8315ad3537274fb0f205": "Tienes que hacer los puntos más pequeños, $n. Algunos objetos se saldrían de los carcajes y bolsas de municiones. Además, a nadie le gusta una túnica llena de agujeros.",
        "fb04049d95c83a55c600": "Bienvenido a nuestro hogar, $N. Radnaal y yo tenemos poco que ofrecerte, pero te acogemos con toda nuestra hospitalidad."
      },
      "name": "Nadyia Tejecrín",
      "subName": "Oficial peletero",
