    },
    "daDK": {
      "dialogue": {
        "6f09bda6d323e4336667": "Træn mig.",
        "8315ad3537274fb0f205": "Du skal lave mindre sting, $n. Så falder der færre ting ud af dine kogger og ammunitionsposer. Og ingen bryder sig om en bulet tunika.",
        "fb04049d95c83a55c600": "Velkommen til vores hjem, $N. Radnaal og jeg har ikke meget at byde på, men du er velkommen til den gæstfrihed, vi kan give."
      },
      "name": "Nadyia Maneweaver",
      "translationMetadata": {
        "fields": {
          "dialogue.6f09bda6d323e4336667": {
            "origin": "ai",
