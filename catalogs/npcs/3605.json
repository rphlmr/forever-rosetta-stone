    "hrHR": {
      "dialogue": {
        "6f09bda6d323e4336667": "Podučite me.",
        "8315ad3537274fb0f205": "Trebaš raditi manje šavove, $n. Tako će manje stvari ispadati iz tobolaca i vrećica za streljivo. Osim toga, nitko ne voli kvrgavu tuniku.",
        "fb04049d95c83a55c600": "Dobro došao u naš dom, $N. Radnaal i ja nemamo mnogo, ali rado ćemo ti pružiti gostoprimstvo koliko možemo."
      },
      "name": "Nadyia Maneweaver",
      "translationMetadata": {
        "fields": {
