    "enUS": {
      "dialogue": {
        "6f09bda6d323e4336667": "Train me.",
        "8315ad3537274fb0f205": "You need to make your stitches smaller, $n. Fewer items will slip out of your quivers and ammo pouches. Besides, no one likes a lumpy tunic.",
        "fb04049d95c83a55c600": "Welcome to our home, $N. Radnaal and I have little to offer, but you are welcome to what hospitality we can provide."
      },
      "name": "Nadyia Maneweaver",
      "subName": "Journeyman Leatherworker",
