    "plPL": {
      "dialogue": {
        "6f09bda6d323e4336667": "Wyszkol mnie.",
        "8315ad3537274fb0f205": "Musisz robić mniejsze ściegi, $n. Mniej rzeczy będzie wypadać z twoich kołczanów i sakiewek na amunicję. Poza tym nikt nie lubi nierównej tuniki.",
        "fb04049d95c83a55c600": "Witaj w naszym domu, $N. Radnaal i ja nie mamy wiele, ale chętnie zaoferujemy ci tyle gościnności, ile możemy."
      },
      "name": "Nadyia Maneweaver",
      "translationMetadata": {
        "fields": {
          "dialogue.6f09bda6d323e4336667": {
