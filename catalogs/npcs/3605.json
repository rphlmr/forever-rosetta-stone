      }
    },
    "trTR": {
      "dialogue": {
        "6f09bda6d323e4336667": "Beni eğit.",
        "8315ad3537274fb0f205": "Dikişlerini daha küçük atmalısın, $n. Böylece sadaklarından ve mühimmat keselerinden daha az şey düşer. Hem kimse pütürlü bir tunik sevmez.",
        "fb04049d95c83a55c600": "Evimize hoş geldin, $N. Radnaal ile benim sunacak pek bir şeyimiz yok ama gösterebildiğimiz kadar misafirperverlikten yararlanabilirsin."
      },
      "name": "Nadyia Maneweaver",
      "translationMetadata": {
        "fields": {
