  "locales": {
    "csCZ": {
      "dialogue": {
        "6f09bda6d323e4336667": "Vycvičte mě.",
        "8315ad3537274fb0f205": "Musíš dělat menší stehy, $n. Z toulců a váčků na munici ti pak vypadne méně věcí. A navíc nikdo nemá rád hrbolatou tuniku.",
        "fb04049d95c83a55c600": "Vítej u nás doma, $N. Radnaal a já toho nemáme mnoho, ale rádi se s tebou podělíme o naši pohostinnost."
      },
      "name": "Nadyia Maneweaver",
      "translationMetadata": {
        "fields": {
          "dialogue.6f09bda6d323e4336667": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
