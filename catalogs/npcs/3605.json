      }
    },
    "itIT": {
      "dialogue": {
        "6f09bda6d323e4336667": "Addestrami.",
        "8315ad3537274fb0f205": "Devi fare punti più piccoli, $N. Dalle tue faretre e dalle tue borse per munizioni scivoleranno fuori meno cose. E poi a nessuno piace una tunica bitorzoluta.",
        "fb04049d95c83a55c600": "Benvenuto in casa nostra, avventuriero. Radnaal e io abbiamo poco da offrire, ma l'ospitalità che possiamo darti è tua."
      },
      "name": "Nadyia Maneweaver",
      "translationMetadata": {
        "fields": {
