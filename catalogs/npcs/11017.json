    "ltLT": {
      "dialogue": {
        "2831f9f2c43b6d386c10": "Puikiai padirbėta! Žinojau, kad dėl tavęs neklydau, kad ir ką kiti kalbėjo. Cha! Juokauju! Gerai, tęskime pamokas...",
        "38503f8d7f3d48cb06dd": "Išmokyk mane.",
        "85b60e8e5ab8d76e2d32": "Negaliu išmokyti to, ko pats nemoku! Kad tik būtų kas nors, kas žinotų daugiau už mane... pala, juk yra! Aplankyk Buzzek Bracketswing Gadgetzan mieste!",
        "9452cb40f3811116e01f": "Neblogas bandymas, bet tau reikės daugiau patirties, kad galėčiau tave mokyti! Atgal į apkasus! ",
        "a7f95ca7d3a65cbe6d68": "Kartais net pats save nustebinu!"
      },
      "name": "Roxxik",
      "subName": "Inžinerijos meistras",
