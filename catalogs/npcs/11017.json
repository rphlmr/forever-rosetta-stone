  "locales": {
    "csCZ": {
      "dialogue": {
        "2831f9f2c43b6d386c10": "Dobrá práce! Věděl jsem, že jsem se v tobě nemýlil, ať si ostatní říkali cokoli. Ha! Jen žertuji! Tak tedy zpátky k výuce...",
        "38503f8d7f3d48cb06dd": "Vycvičte mě.",
        "85b60e8e5ab8d76e2d32": "Nemůžu učit něco, co sám neumím! Kdyby tak existoval někdo, kdo ví víc než já... počkat, on existuje! Zajdi za Buzzkem Bracketswingem do Gadgetzanu!",
        "9452cb40f3811116e01f": "Pěkný pokus, ale než tě budu moci učit, potřebuješ více zkušeností! Zpátky do boje!",
        "a7f95ca7d3a65cbe6d68": "Někdy překvapím i sám sebe!"
      },
      "name": "Roxxik",
      "translationMetadata": {
        "fields": {
          "dialogue.2831f9f2c43b6d386c10": {
