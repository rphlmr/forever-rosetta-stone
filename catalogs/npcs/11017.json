    "hrHR": {
      "dialogue": {
        "2831f9f2c43b6d386c10": "Bravo! Znao sam da sam bio u pravu u vezi s tobom, bez obzira na to što su drugi govorili. Ha! Šalim se! Dobro, nastavimo s lekcijama...",
        "38503f8d7f3d48cb06dd": "Podučite me.",
        "85b60e8e5ab8d76e2d32": "Ne mogu te naučiti ono što ne znam! Kad bi barem postojao netko tko zna više od mene... čekaj, postoji! Posjeti Buzzeka Bracketswinga u Gadgetzanu!",
        "9452cb40f3811116e01f": "Dobar pokušaj, ali treba ti još iskustva prije nego što počneš trenirati sa mnom! Natrag u rovove!",
        "a7f95ca7d3a65cbe6d68": "Ponekad iznenadim i samoga sebe!"
      },
      "name": "Roxxik",
      "translationMetadata": {
