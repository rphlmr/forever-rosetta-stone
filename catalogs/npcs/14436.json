  "locales": {
    "csCZ": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Přijde chvíle, kdy nám život, který známe, nestačí. Jsme uvězněni a hledáme odpovědi a v temných místech nacházíme plamínek naděje.$B$BTeprve tehdy, $n, vykročíme poprvé ke svobodě."
      },
      "name": "Mor'zul Bloodbringer",
      "translationMetadata": {
        "fields": {
          "dialogue.759b3d4b2ad75dde1551": {
