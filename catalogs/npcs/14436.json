          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Nadchodzi chwila, gdy życie, jakie znamy, przestaje nam wystarczać. Uwięzieni szukamy odpowiedzi i znajdujemy nadzieję płonącą w ciemnych zakątkach.$B$BDopiero wtedy, $n, stawiamy pierwsze kroki ku wolności."
      },
      "name": "Mor'zul Bloodbringer",
      "translationMetadata": {
        "fields": {
