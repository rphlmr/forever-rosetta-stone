    "ltLT": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Ateina metas, kai gyvenimo, kurį pažįstame, nebeužtenka. Esame įkalinti ir ieškome atsakymų, o tamsiose vietose atrandame rusenančią viltį.$B$BTik tada, $n, žengiame pirmuosius žingsnius į laisvę."
      },
      "name": "Mor'zul Bloodbringer",
      "translationMetadata": {
