          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "There comes a time when the life we know falls short.  We are trapped and look for answers, and we find hope burning in dark places.$B$BOnly then, $n, do we take our first steps to freedom."
      },
      "name": "Mor'zul Bloodbringer",
      "translationMetadata": {
        "fields": {
          "dialogue.759b3d4b2ad75dde1551": {
            "origin": "community",
