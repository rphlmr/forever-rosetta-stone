        }
      }
    },
    "trTR": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Bir zaman gelir, bildiğimiz hayat artık yetmez. Kapana kısılır, cevaplar arar ve umudun karanlık yerlerde yandığını görürüz.$B$Bİşte ancak o zaman, $n, özgürlüğe giden ilk adımlarımızı atarız."
      },
      "name": "Mor'zul Bloodbringer",
      "translationMetadata": {
        "fields": {
          "dialogue.759b3d4b2ad75dde1551": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
