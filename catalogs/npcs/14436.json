    "hrHR": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Dođe vrijeme kada nam život kakav poznajemo više nije dovoljan. Zarobljeni smo i tražimo odgovore, a nadu nalazimo kako gori na mračnim mjestima.$B$BTek tada, $n, činimo prve korake prema slobodi."
      },
      "name": "Mor'zul Bloodbringer",
      "translationMetadata": {
        "fields": {
