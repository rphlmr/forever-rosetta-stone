    },
    "ptBR": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Chega um momento em que a vida que conhecemos não basta. Ficamos encurralados e procuramos respostas. Encontramos as chamas da esperança nos lugares mais sombrios.\n\nSó então, $n, damos os primeiros passos em direção da liberdade."
      },
      "name": "Mor'zul Trazangre",
      "translationMetadata": {
        "fields": {
