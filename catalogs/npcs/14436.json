            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "759b3d4b2ad75dde1551": "Llega un momento cuando la vida que conocemos se nos queda corta. Estamos atrapados y buscamos respuestas. Encontramos la esperanza ardiendo en oscuros lugares.\n\nSolo entonces, $n, damos nuestros primeros pasos hacia la libertad."
      },
      "name": "Mor'zul Sangredoble",
      "translationMetadata": {
