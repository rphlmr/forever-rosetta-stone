    "plPL": {
      "dialogue": {
        "0150db016a8f46112729": "Nie sądzę, by interesowało cię to, czego mogę nauczyć. Poszukaj trenera dla klasy $c.",
        "2e16da51ec5de55f1058": "Wyglądasz na kogoś, przy kim trzeba pilnować sakiewki. Mogę ci w czymś pomóc?",
        "366bb10ef246e7dcccf5": "Mam coś dla ciebie, $n. Wygląda na ważne.",
        "5e1fb06aa14f211c4075": "Czy możesz nauczyć mnie korzystać ze zdolności łotra?",
        "ee4b19c2adad644a8ed8": "Dzięki rygorystycznemu przekwalifikowaniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Za każdym razem jest to coraz trudniejsze, dlatego kolejne przekwalifikowania kosztują coraz więcej. Czy chcesz, abym oduczył cię zdobytych talentów?"
      },
      "name": "Osborne Nocny Człowiek",
      "translationMetadata": {
