    "hrHR": {
      "dialogue": {
        "0150db016a8f46112729": "Mislim da ne želiš naučiti ništa što ti ja mogu pokazati. Potraži učitelja za $c koji ti može pomoći.",
        "2e16da51ec5de55f1058": "Izgledaš kao netko pred kim trebam čuvati kesu. Mogu li ti kako pomoći?",
        "366bb10ef246e7dcccf5": "Imam nešto za tebe, $n. Izgleda važno.",
        "5e1fb06aa14f211c4075": "Možeš li me naučiti kako koristiti vještine odmetnika?",
        "ee4b19c2adad644a8ed8": "Strogim preobučavanjem mnoge sam učenike morao odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Tu je uslugu svaki put sve teže pružiti, pa zato svakim preobučavanjem postaje sve skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Osborne Noćni čovjek",
