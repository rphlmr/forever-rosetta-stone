  "locales": {
    "csCZ": {
      "dialogue": {
        "0150db016a8f46112729": "Nemyslím, že by ses chtěl učit něco z toho, co mohu nabídnout. Najdi si raději trenéra svého povolání, $c.",
        "2e16da51ec5de55f1058": "Vypadáš jako někdo, před kým bych si měl hlídat měšec. Mohu ti s něčím pomoci?",
        "366bb10ef246e7dcccf5": "Něco tu pro tebe mám, $n. Vypadá to důležitě.",
        "5e1fb06aa14f211c4075": "Můžeš mě naučit používat schopnosti tuláka?",
        "ee4b19c2adad644a8ed8": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dosud naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Osborne noční muž",
      "translationMetadata": {
        "fields": {
          "dialogue.0150db016a8f46112729": {
