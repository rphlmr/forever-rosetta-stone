    "daDK": {
      "dialogue": {
        "0a2b0cf90774b9c202dc": "Jeg kan ikke træne en $c som dig.",
        "95ab74116d55df578a03": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?",
        "a96cb012f18f1dc1fedd": "Hvad kan jeg gøre for dig, mit barn?",
        "b1efcbf302baf03a074e": "Jeg vil gerne trænes."
      },
      "name": "Jeen'ra Nightrunner",
      "translationMetadata": {
        "fields": {
          "dialogue.0a2b0cf90774b9c202dc": {
            "origin": "ai",
