    "plPL": {
      "dialogue": {
        "0a2b0cf90774b9c202dc": "Nie mogę szkolić kogoś takiego jak ty, $c.",
        "95ab74116d55df578a03": "Dzięki rygorystycznemu przekwalifikowaniu musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc uczyć ich od nowa. Z każdym razem ta usługa staje się trudniejsza, a przez to droższa. Czy chcesz, bym pomogła ci zapomnieć poznane talenty?",
        "a96cb012f18f1dc1fedd": "Co mogę dla ciebie zrobić, moje dziecko?",
        "b1efcbf302baf03a074e": "Chcę się szkolić."
      },
      "name": "Jeen'ra Nightrunner",
      "translationMetadata": {
        "fields": {
