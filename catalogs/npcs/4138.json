  "locales": {
    "csCZ": {
      "dialogue": {
        "0a2b0cf90774b9c202dc": "Nemohu vycvičit někoho jako ty, $c.",
        "95ab74116d55df578a03": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla vyučit znovu. Tuto službu je pokaždé těžší provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučila tvým talentům?",
        "a96cb012f18f1dc1fedd": "Co pro tebe mohu udělat, dítě?",
        "b1efcbf302baf03a074e": "Chtěl bych výcvik."
      },
      "name": "Jeen'ra Nightrunner",
      "translationMetadata": {
        "fields": {
          "dialogue.0a2b0cf90774b9c202dc": {
            "origin": "ai",
