    "enUS": {
      "dialogue": {
        "0a2b0cf90774b9c202dc": "I cannot train a $c such as yourself.",
        "95ab74116d55df578a03": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "a96cb012f18f1dc1fedd": "What can I do for you my child?",
        "b1efcbf302baf03a074e": "I would like training."
      },
      "name": "Jeen'ra Nightrunner",
      "subName": "Hunter Trainer",
      "translationMetadata": {
        "fields": {
