          }
        }
      }
    },
    "ltLT": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "La... labas, $n. Atleisk, sveikstu po žaizdų.$B$BTie Scarlet Crusade kariai stipresni, nei maniau. Jie vos manęs nepribaigė.$B$BTu irgi būk atsargus. Nenorėčiau, kad jie tave užkluptų netikėtai."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
