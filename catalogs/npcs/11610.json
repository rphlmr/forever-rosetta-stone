            "sourceLocale": "ukUA",
            "sourceRevision": "d9bf29572a85957fd69085be0cec28262cba0c87"
          }
        }
      }
    },
    "zhCN": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "你……你好，$n。对不起，我正从伤势中恢复过来。\n\n那些血色十字军比我料想的要凶猛的多。他们几乎在里面干掉了我。\n\n你也应该多加小心。我不愿看到他们先发制人。"
      },
      "name": "科尔斯塔·迪普沙东",
      "translationMetadata": {
        "fields": {
