            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "Ha... hallo, $n. Es tut mir leid - ich muss mich noch von meinen Wunden erholen.\n\nDiese Scharlachroten Kreuzzügler sind härtere Gegner, als ich gedacht hätte. Die haben mich beinahe fertig gemacht.\n\nIhr solltet ebenfalls vorsichtig sein. Es würde mir gar nicht gefallen, wenn die Euch überrumpeln würden."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
