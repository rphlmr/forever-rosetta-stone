            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "П... привіт, $n. Вибач, я ще оговтуюся від ран.$B$BТі Багряні хрестоносці виявилися міцнішими, ніж я думала. Вони мене ледь не вбили.$B$BТобі теж варто бути обережним. Не хотілося б, щоб вони застали тебе зненацька."
      },
      "name": "Кірста Чорнотінь",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
