          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "Ho... hola, $n. Lo siento, me estoy recuperando de mis heridas.\n\nLos de la Cruzada Escarlata son más duros de lo que había pensado. Casi terminan conmigo.\n\nDeberías tener cuidado. No me gustaría verles lanzarse sobre ti."
      },
      "name": "Kirsta Sombraprofunda",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
