            "sourceLocale": "enUS"
          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "Cz... cześć, $n. Wybacz, dochodzę do siebie po ranach.$B$BCi Szkarłatni Krzyżowcy są twardsi, niż sądziłam. O mało mnie nie zabili.$B$BTy też uważaj. Nie chciałabym, żeby cię zaskoczyli."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
