          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "H... hej, $n. Ursäkta, jag återhämtar mig från mina skador.$B$BDe där Scarlet Crusaders är tuffare än jag trodde. De tog nästan livet av mig.$B$BDu borde också vara försiktig. Jag vill inte att de överraskar dig."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
