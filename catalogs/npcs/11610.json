  "locales": {
    "csCZ": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "A... ahoj, $n. Promiň, zotavuji se ze zranění.$B$BTi Scarlet Crusaders jsou tvrdší, než jsem si myslela. Málem mě dostali.$B$BTaké by sis měl dávat pozor. Nerada bych viděla, jak tě překvapí."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
