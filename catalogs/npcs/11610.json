          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "M... merhaba, $n. Kusura bakma, yaralarımı iyileştirmeye çalışıyorum.$B$BScarlet Crusader'lar düşündüğümden daha çetinmiş. Neredeyse canımı alıyorlardı.$B$BSen de dikkatli olmalısın. Seni hazırlıksız yakalamalarını istemem."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
