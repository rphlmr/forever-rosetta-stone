          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "He... hello, $n. Sorry, I'm recovering from my wounds.$B$BThose Scarlet Crusaders are tougher than I had given them credit for. They almost did me in.$B$BYou should be careful too. I'd hate to see them get the jump on you."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
