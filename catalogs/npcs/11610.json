    },
    "daDK": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "He... hej, $n. Undskyld, jeg er ved at komme mig over mine sår.$B$BDe Scarlet Crusaders er hårdere, end jeg troede. De tog næsten livet af mig.$B$BDu bør også passe på. Jeg ville nødigt se dem overraske dig."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
