          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "S... salve, $n. Scusa, mi sto riprendendo dalle ferite.$B$BQuei Crociati Scarlatti sono più duri di quanto pensassi. Mi hanno quasi uccisa.$B$BAnche tu dovresti stare attento. Non vorrei che ti cogliessero di sorpresa."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
