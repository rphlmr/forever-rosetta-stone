        }
      }
    },
    "hrHR": {
      "dialogue": {
        "f3ee57a9fb8814fa79e4": "B... bok, $n. Oprosti, oporavljam se od rana.$B$BTi Scarlet Crusaders su žilaviji nego što sam mislila. Zamalo su me ubili.$B$BI ti bi trebao paziti. Ne bih voljela da te iznenade."
      },
      "name": "Kirsta Deepshadow",
      "translationMetadata": {
        "fields": {
          "dialogue.f3ee57a9fb8814fa79e4": {
