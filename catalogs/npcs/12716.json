    "plPL": {
      "dialogue": {
        "500919332e3fa87ec1c2": "Tak lubię tu siedzieć i słuchać odgłosów Wielkiego Morza. Och, co? Tak, jest statek, który zabierze cię do portu Menethil. Od czasu do czasu tu zawija."
      },
      "name": "Decedra Willham",
