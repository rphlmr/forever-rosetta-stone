    "ltLT": {
      "dialogue": {
        "500919332e3fa87ec1c2": "Man taip patinka čia sėdėti ir klausytis Didžiosios jūros garsų.  O, ką?  Taip, yra laivas, kuris tave nuplukdys į Menethil uostą.  Jis kartkartėmis čia prisišvartuoja."
      },
      "name": "Decedra Willham",
