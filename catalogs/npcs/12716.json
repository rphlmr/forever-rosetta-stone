    "csCZ": {
      "dialogue": {
        "500919332e3fa87ec1c2": "Tak ráda tu sedím a poslouchám zvuky Velkého moře. Ale cože? Ano, je tu loď, která tě zaveze do přístavu Menethil. Čas od času tu kotví."
      },
      "name": "Decedra Willham",
      "translationMetadata": {
