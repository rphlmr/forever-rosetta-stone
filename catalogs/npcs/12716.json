    "daDK": {
      "dialogue": {
        "500919332e3fa87ec1c2": "Jeg elsker at sidde herude og lytte til lydene fra Det Store Hav. Åh, hvad? Ja, der er et skib, som kan tage dig til Menethil Havn. Det lægger til her fra tid til anden."
      },
      "name": "Decedra Willham",
      "translationMetadata": {
        "fields": {
