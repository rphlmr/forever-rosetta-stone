    "hrHR": {
      "dialogue": {
        "500919332e3fa87ec1c2": "Tako uživam sjediti ovdje i slušati zvukove Velikog mora. Oh, što? Da, postoji brod koji će te odvesti u luku Menethil. Pristaje ovdje s vremena na vrijeme."
      },
      "name": "Decedra Willham",
