    "enUS": {
      "dialogue": {
        "500919332e3fa87ec1c2": "I do so enjoy sitting out here, listening to the sounds of the Great Sea.  Oh, what?  Yes, there is a ship that will take you to Menethil Harbor.  It docks here from time to time."
      },
      "name": "Decedra Willham",
      "translationMetadata": {
        "fields": {
          "dialogue.500919332e3fa87ec1c2": {
