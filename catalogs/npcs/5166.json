  "locales": {
    "csCZ": {
      "dialogue": {
        "0221db0ca034f291c93b": "Přísným přeškolováním jsem musel mnoho studentů odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "712de290d7ae577a4c88": "Něco pro tebe mám, $n. Vypadá to důležitě.",
        "808debc7dc86badbbd2d": "Nemůžu ti pomoct, $n. Cvičím jen darebáky.",
        "e2fa4650d4281e5a867f": "Co pro tebe můžu udělat, $n?",
        "f04f47346e0057134ea6": "Hledám výcvik pro tuláky."
      },
      "name": "Ormyr Flinteye",
      "translationMetadata": {
        "fields": {
          "dialogue.0221db0ca034f291c93b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
