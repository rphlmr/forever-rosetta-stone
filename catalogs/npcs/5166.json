    "plPL": {
      "dialogue": {
        "0221db0ca034f291c93b": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Z każdym razem wykonanie tej usługi staje się trudniejsze. Dlatego każde kolejne szkolenie kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "712de290d7ae577a4c88": "Mam coś dla ciebie, $n. Wygląda na ważne.",
        "808debc7dc86badbbd2d": "Nie pomogę ci, $n. Szkolę tylko łotrzyków.",
        "e2fa4650d4281e5a867f": "Co mogę dla ciebie zrobić, $n?",
        "f04f47346e0057134ea6": "Szukam szkolenia dla łotrzyków."
      },
      "name": "Ormyr Flinteye",
      "translationMetadata": {
