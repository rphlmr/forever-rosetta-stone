    "hrHR": {
      "dialogue": {
        "0221db0ca034f291c93b": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Tu je uslugu svaki put sve teže pružiti. Zato je svaka sljedeća preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "712de290d7ae577a4c88": "Imam nešto za tebe, $n. Izgleda važno.",
        "808debc7dc86badbbd2d": "Ne mogu ti pomoći, $n. Podučavam samo lupeže.",
        "e2fa4650d4281e5a867f": "Što mogu učiniti za tebe, $n?",
        "f04f47346e0057134ea6": "Tražim obuku za lupeže."
      },
      "name": "Ormyr Flinteye",
