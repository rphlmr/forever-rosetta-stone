    "daDK": {
      "dialogue": {
        "b12e34198d00d1c655aa": "Jeg vil gerne se dine varer.",
        "bede6fcd0310bf665047": "Træn mig.",
        "d1bba4b6c96ee0c4a0e1": "Vægten af en økse, dine allieredes kampråb, blodet, der sprøjter i dit ansigt. Det er, hvad en kriger higer efter, $n. Jeg vil erobre The Barrens med mit sværd i Hordens navn."
      },
      "name": "Kargal Battlescar",
      "translationMetadata": {
        "fields": {
