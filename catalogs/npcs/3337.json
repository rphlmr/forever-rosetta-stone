  "locales": {
    "csCZ": {
      "dialogue": {
        "b12e34198d00d1c655aa": "Rád bych si prohlédl vaše zboží.",
        "bede6fcd0310bf665047": "Vycvičte mě.",
        "d1bba4b6c96ee0c4a0e1": "Váha sekery, bojový pokřik spojenců, krev stříkající do tváře. Po tom všem válečník touží, $n. Svým mečem vybojuji Pustiny ve jménu Hordy."
      },
      "name": "Kargal Battlescar",
      "translationMetadata": {
