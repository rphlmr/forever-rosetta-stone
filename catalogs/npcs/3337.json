    "esES": {
      "dialogue": {
        "b12e34198d00d1c655aa": "Quiero ver tus mercancías.",
        "bede6fcd0310bf665047": "Entréname.",
        "d1bba4b6c96ee0c4a0e1": "El peso de un hacha, el grito de guerra de tus aliados, el chorro de sangre en tu cara. Estas son las cosas que un guerrero anhela, $n. Esculpiré Los Barrens con mi espada en nombre de la Horda."
      },
      "name": "Kargal Marcaguerra",
