    "deDE": {
      "dialogue": {
        "b12e34198d00d1c655aa": "Ich möchte Eure Waren ansehen.",
        "bede6fcd0310bf665047": "Bildet mich aus.",
        "d1bba4b6c96ee0c4a0e1": "Das Gewicht einer Axt, der Schlachtruf deiner Verbündeten, die Blutspritzer in deinem Gesicht. Das sind die Dinge, nach denen sich ein Krieger sehnt, $n. Im Namen der Horde werde ich das Brachland mit meinem Schwert zerfurchen."
      },
      "name": "Kargal Battlescar",
      "translationMetadata": {
        "fields": {
