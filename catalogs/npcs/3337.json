    "enUS": {
      "dialogue": {
        "b12e34198d00d1c655aa": "I want to browse your goods.",
        "bede6fcd0310bf665047": "Train me.",
        "d1bba4b6c96ee0c4a0e1": "The heft of an axe, the battlecry of your allies, the spray of blood in your face. These are the things a warrior craves, $n. I will carve out The Barrens with my sword in the name of the Horde."
      },
      "name": "Kargal Battlescar",
