  "locales": {
    "csCZ": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "Nemohu uvěřit představitelům Stormwindu, že poslali většinu naší armády do ciziny... když je naše domovina pod takovým tlakem!$B$BKdyž ze Westfallu přicházejí zloději a z východu i západu dorážejí gnollové, je div, že samotný Stormwind není v obležení."
      },
      "name": "Zástupce Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "Jeg kan ikke fatte embedsmændene i Stormwind, der sender størstedelen af vores hær til udlandet... når vores hjemland er under så stort pres!$B$BMed tyve fra Westfall og gnoller, der trænger ind fra øst og vest, er det et mirakel, at selve Stormwind ikke er belejret."
      },
      "name": "Stedfortræder Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "Ich kann die Führung von Stormwind nicht verstehen. Sie schickt den Großteil unserer Armee weg... wo unsere Heimat so sehr bedrängt wird!\n\nVon Westfall kommen Diebe, aus Ost und West nähern sich Gnolle - es ist ein Wunder, dass Stormwind selbst nicht belagert wird."
      },
      "name": "Deputy Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
            "sourceSha256": "c1cd1597ee8ef61b8859daf63d724a5ec28d311078335b8014ae4d85c11777ac"
          },
          "name": {
