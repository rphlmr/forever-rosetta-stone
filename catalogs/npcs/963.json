            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "Non riesco a credere che i funzionari di Stormwind mandino il grosso del nostro esercito all'estero... quando il fronte interno è così sotto pressione!\n\nCon i ladri che arrivano da Westfall e gli gnoll che avanzano da est e da ovest, è un miracolo che la stessa Stormwind non sia sotto assedio."
      },
      "name": "Vice Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "itIT",
