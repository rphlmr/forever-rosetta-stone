    },
    "hrHR": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "Ne mogu vjerovati vlastima Stormwinda da šalju glavninu naše vojske u inozemstvo... dok je naša domovina pod tolikim pritiskom!$B$BDok lopovi dolaze iz Westfalla, a gnollovi nadiru s istoka i zapada, pravo je čudo da sam Stormwind nije pod opsadom."
      },
      "name": "Zamjenik Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
