            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "I can't believe the officials in Stormwind, sending the bulk of our army abroad... when our home front is under so much pressure!$B$BWith thieves coming from Westfall and gnolls encroaching from from the east and west, it's a wonder Stormwind itself isn't besieged."
      },
      "name": "Deputy Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
          },
          "name": {
            "origin": "original",
            "source": "egLink",
            "sourceBuild": "1.60.1.70938",
            "sourceLocale": "enUS",
            "sourceRevision": "6ff5612b54191f297eb77ca8eda81de029d9d6f0"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "8216c12e2e79f05e3e13": "No puedo creer en los funcionarios de Ventormenta, enviando a la mayor parte de nuestro ejército al extranjero... ¡cuando el frente interno está sometido a tanta presión!\n\nCon ladrones que vienen desde Páramos de Poniente y gnolls invadiéndonos desde el este y el oeste, es increíble que Ventormenta no esté sitiado a estas alturas."
      },
      "name": "Ayudante del alguacil Rainer",
      "translationMetadata": {
        "fields": {
          "dialogue.8216c12e2e79f05e3e13": {
            "origin": "community",
