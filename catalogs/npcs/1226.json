    },
    "daDK": {
      "dialogue": {
        "27ce52b5a87302d0ff84": "Må Lyset beskytte dig, $c.",
        "49adcd57596a7d7d498a": "Jeg søger mere træning i præsternes kunst.",
        "79bfea31172cb1cc3b8b": "Jeg håber, Lyset er med dig, $n. Er der noget, jeg kan gøre for dig i dag?",
        "bea95e9cd557e272a137": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre, hver gang den bruges. Derfor bliver hver omskoling dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Maxan Anvol",
      "translationMetadata": {
        "fields": {
          "dialogue.27ce52b5a87302d0ff84": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
