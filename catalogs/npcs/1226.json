  "locales": {
    "csCZ": {
      "dialogue": {
        "27ce52b5a87302d0ff84": "Světlo tě ochraňuj, $c.",
        "49adcd57596a7d7d498a": "Hledám další výcvik v kněžském umění.",
        "79bfea31172cb1cc3b8b": "Doufám, že je Světlo s tebou, $n. Mohu pro tebe dnes něco udělat?",
        "bea95e9cd557e272a137": "Při náročném přeškolování jsem musel mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ovládáš?"
      },
      "name": "Maxan Anvol",
      "translationMetadata": {
        "fields": {
          "dialogue.27ce52b5a87302d0ff84": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
