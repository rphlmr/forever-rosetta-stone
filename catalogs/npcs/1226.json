      }
    },
    "plPL": {
      "dialogue": {
        "27ce52b5a87302d0ff84": "Niech Światło cię chroni, $c.",
        "49adcd57596a7d7d498a": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "79bfea31172cb1cc3b8b": "Mam nadzieję, że Światło jest z tobą, $n. Czy mogę dziś coś dla ciebie zrobić?",
        "bea95e9cd557e272a137": "Poprzez rygorystyczne szkolenie musiałem oduczyć wielu uczniów wszystkiego, czego się wcześniej nauczyli, aby móc szkolić ich na nowo. Usługa, którą oferuję, staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne szkolenie jest droższe. Czy chcesz, abym oduczył cię poznanych talentów?"
      },
      "name": "Maxan Anvol",
      "translationMetadata": {
        "fields": {
          "dialogue.27ce52b5a87302d0ff84": {
