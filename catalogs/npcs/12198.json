    },
    "daDK": {
      "dialogue": {
        "6b82403a98869748965a": "Tror du, du har det, der skal til for at knuse League of Arathor, $c? Det håber jeg. Hvad vil du, eller er du bare her for at spilde min tid?",
        "b3ed56092c39d025431f": "Beklager, $c, men du skal være stærkere, før jeg kan lade dig komme ind i Arathi Basin."
      },
      "name": "Martin Lindsey",
      "translationMetadata": {
        "fields": {
          "dialogue.6b82403a98869748965a": {
