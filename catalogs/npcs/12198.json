    "esES": {
      "dialogue": {
        "6b82403a98869748965a": "¿Crees que tienes lo que hay que tener para destruir a la Liga de Arathor, $c? Eso espero. ¿Qué quieres, o estás aquí solo para hacerme perder el tiempo?",
        "b3ed56092c39d025431f": "Lo siento, $c, pero necesitas tener más poder para que pueda permitirte entrar en la Cuenca de Arathi."
      },
      "name": "Martin Lindsey",
      "subName": "Maestro de batalla de la Cuenca de Arathi",
