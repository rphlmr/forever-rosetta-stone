    "hrHR": {
      "dialogue": {
        "6b82403a98869748965a": "Misliš li da imaš sve što je potrebno da uništiš League of Arathor, $c? Nadam se. Što želiš ili si samo došao gubiti moje vrijeme?",
        "b3ed56092c39d025431f": "Žao mi je, $c, ali moraš biti snažniji prije nego što ti dopustim ulazak u Arathi Basin."
      },
      "name": "Martin Lindsey",
      "translationMetadata": {
