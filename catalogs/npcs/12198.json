    "ptBR": {
      "dialogue": {
        "6b82403a98869748965a": "Você acha que tem peito para destruir a Liga de Arathor, $c? Eu espero que sim. Você quer alguma coisa ou está aqui só para me fazer perder tempo?",
        "b3ed56092c39d025431f": "Sinto muito, $c, mas você tem de estar mais poderoso para que eu o deixe entrar na Bacia Arathi."
      },
      "name": "Martim Lagos",
      "subName": "Mestre de Batalha da Bacia Arathi",
