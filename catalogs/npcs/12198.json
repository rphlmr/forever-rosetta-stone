    "plPL": {
      "dialogue": {
        "6b82403a98869748965a": "Myślisz, że zdołasz zniszczyć Ligę Arathoru, $c? Mam nadzieję. Czego chcesz, czy może tylko marnujesz mój czas?",
        "b3ed56092c39d025431f": "Przykro mi, $c, ale musisz być silniejszy, zanim pozwolę ci wejść do Kotliny Arathi."
      },
      "name": "Martin Lindsey",
      "translationMetadata": {
