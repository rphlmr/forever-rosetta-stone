    "enUS": {
      "dialogue": {
        "6b82403a98869748965a": "You think you have what it takes to destroy The League of Arathor, $c?  I hope so.  What is it that you want, or are you simply here to waste my time?",
        "b3ed56092c39d025431f": "I am sorry $c, but you need to be more powerful before I can allow you to enter Arathi Basin."
      },
      "name": "Martin Lindsey",
      "subName": "Arathi Basin Battlemaster",
