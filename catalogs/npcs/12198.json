  "locales": {
    "csCZ": {
      "dialogue": {
        "6b82403a98869748965a": "Myslíš, že máš na to zničit League of Arathor, $c? Doufám v to. Co chceš, nebo jsi tu jen proto, abys mě zdržoval?",
        "b3ed56092c39d025431f": "Promiň, $c, ale musíš být silnější, než tě mohu pustit do Arathijské pánve."
      },
      "name": "Martin Lindsey",
      "translationMetadata": {
        "fields": {
          "dialogue.6b82403a98869748965a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
