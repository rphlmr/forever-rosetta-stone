    "daDK": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Himmelskibene og færgerne har ikke sejlet i årevis. Så vidt vi ved, er der måske ingen andre øer tilbage at importere varer fra. Men jeg er her stadig... for en sikkerheds skyld."
      },
      "name": "Xy'aaria Streamrunner",
      "translationMetadata": {
        "fields": {
