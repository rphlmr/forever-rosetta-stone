    "esES": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Las aeronaves y los transbordadores llevan años sin funcionar. Que sepamos, puede que ya no queden otras islas de las que importar mercancías. Aun así, aquí estoy... por si acaso."
      },
      "name": "Xy'aaria Correcorrientes",
      "subName": "Imports",
      "translationMetadata": {
