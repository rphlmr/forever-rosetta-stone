          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Gök kesiciler ve feribotlar yıllardır çalışmıyor. Bildiğimiz kadarıyla ithalat yapabileceğimiz başka ada kalmamış olabilir. Yine de buradayım... her ihtimale karşı."
      },
      "name": "Xy'aaria Streamrunner",
      "translationMetadata": {
        "fields": {
