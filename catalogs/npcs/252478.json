    "plPL": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Powietrzne kutry i promy nie kursują już od lat. O ile nam wiadomo, mogło nie zostać już żadnych innych wysp, z których moglibyśmy sprowadzać towary. Mimo to jestem tutaj... na wszelki wypadek."
      },
      "name": "Xy'aaria Streamrunner",
      "translationMetadata": {
        "fields": {
