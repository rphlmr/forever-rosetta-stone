    "esMX": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Las aeronaves y los transbordadores no funcionan desde hace años. Por lo que sabemos, quizá ya no queden otras islas de las que podamos importar mercancías. Aun así, aquí estoy... por si acaso."
      },
      "name": "Xy'aaria Correcorrientes",
      "subName": "Imports",
