  "locales": {
    "csCZ": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Vzducholodě ani přívozy už léta nejezdí. Pokud víme, možná už nezbyly žádné další ostrovy, odkud bychom mohli dovážet zboží. Přesto jsem tu... pro jistotu."
      },
      "name": "Xy'aaria Streamrunner",
      "translationMetadata": {
        "fields": {
