    "hrHR": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "Neborezači i trajekti već godinama ne prometuju. Koliko znamo, možda više nema drugih otoka s kojih bismo mogli uvoziti robu. Ipak, još sam ovdje... za svaki slučaj."
      },
      "name": "Xy'aaria Streamrunner",
      "translationMetadata": {
        "fields": {
