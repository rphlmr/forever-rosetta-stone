    "enUS": {
      "dialogue": {
        "3ca46aa3028d1f42a815": "The skycutters and ferries haven't run in years at this point. For all we know, there are no other islands left for us to get imports from. Still though, I'm here... just in case."
      },
      "name": "Xy'aaria Streamrunner",
      "subName": "Imports",
