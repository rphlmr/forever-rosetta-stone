      }
    },
    "daDK": {
      "dialogue": {
        "0875b348c389561e79dd": "Jeg er bange for, at jeg ikke har noget at lære en med din erfaring. Men du er ikke nået til vejs ende endnu. Tal med Lucan Cordell bag disken derovre. Han vil vejlede dig gennem næste del af din rejse.",
        "5f94605a650405d5a9cd": "Hmm... du virker kompetent nok. Hvis du virkelig ønsker at lære, vil intet stå i vejen for dig! Jeg vil vejlede dig gennem de første skridt på det, jeg håber bliver en lang og givende vej.",
        "6cf96cdcab89928a262d": "Træn mig.",
        "c540a7988b33a4422214": "Vær hilset, rejsende! Hvad bringer dig til min dør?"
      },
      "name": "Betty Quin",
      "translationMetadata": {
        "fields": {
          "dialogue.0875b348c389561e79dd": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
