  "locales": {
    "csCZ": {
      "dialogue": {
        "0875b348c389561e79dd": "Obávám se, že někoho s tvými zkušenostmi už nemám co naučit. Ale tvá cesta ještě nekončí. Promluv si s Lucanem Cordellem za tamním pultem. Provede tě další fází tvé cesty.",
        "5f94605a650405d5a9cd": "Hmm... zdá se, že jsi dost schopný. Pokud se opravdu chceš učit, nic ti nebude stát v cestě! Provedu tě prvními kroky na cestě, která bude, doufám, dlouhá a naplňující.",
        "6cf96cdcab89928a262d": "Vycvičte mě.",
        "c540a7988b33a4422214": "Zdravím, cestovateli! Co tě přivádí ke mým dveřím?"
      },
      "name": "Betty Quin",
      "translationMetadata": {
        "fields": {
          "dialogue.0875b348c389561e79dd": {
            "origin": "ai",
