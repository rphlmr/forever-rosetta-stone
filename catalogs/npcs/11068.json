    "enUS": {
      "dialogue": {
        "0875b348c389561e79dd": "I'm afraid I have nothing to teach to someone with your experience. But you haven't reached the end of the road yet. Speak to Lucan Cordell, behind the counter there. He'll guide you through the next phase of your journey.",
        "5f94605a650405d5a9cd": "Hmm... well you seem capable enough. If you truly desire to learn, then nothing will stand in your way! I will guide you through your first steps on what I hope will be a long and fulfilling path.",
        "6cf96cdcab89928a262d": "Train me.",
        "c540a7988b33a4422214": "Hail, traveler! What brings you to my doorstep?"
      },
      "name": "Betty Quin",
      "subName": "Journeyman Enchanter",
      "translationMetadata": {
        "fields": {
          "dialogue.0875b348c389561e79dd": {
