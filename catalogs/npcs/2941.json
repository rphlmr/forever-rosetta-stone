  "locales": {
    "csCZ": {
      "dialogue": {
        "15d16dd12ac5ec784500": "Thorium Brotherhood nebo ne, jestli se ke mně některý z těch Temných želez přiblíží, ochutná můj krumpáč z boku hlavy! Tak kam tě mám poslat, $G chlapče : děvče;?",
        "63c9e29aeaea83c68d17": "Vycvičte mě.",
        "cc1fb25ac51957df7dfa": "Rád bych si prohlédl vaše zboží.",
        "d5542cd7cf1907080846": "Thorium Brotherhood nebo ne, jestli se ke mně některý z těch Temných želez přiblíží, ochutná můj krumpáč z boku hlavy! Tak kam tě mám poslat, $G chlapče : děvče;?"
      },
