    "enUS": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Elder Moonstrike can be found in the Scholomance in the Western Plaguelands.",
        "0e7ae1c033eb03f6d4d1": "Elder Windrun resides in the Crown Guard Tower in the Eastern Plaguelands.",
        "4879157e760d52d7ff53": "Elder Graveborn spends time near Brill in Tirisfal Glades.",
        "522c966b493a92a77408": "Elder Farwhisper can be found wandering the streets of Stratholme.",
        "dd75db19ece100039eee": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "ee42af43a87e447e4d1f": "I last saw Elder Meadowrun at the Weeping Cave in the Western Plaguelands."
      },
      "name": "Elder Snowcrown",
