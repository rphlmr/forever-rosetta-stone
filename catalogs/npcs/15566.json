    "ltLT": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Senolį Moonstrike galima rasti Scholomance, Western Plaguelands.",
        "0e7ae1c033eb03f6d4d1": "Senolis Windrun gyvena Crown Guard Tower, Eastern Plaguelands.",
        "4879157e760d52d7ff53": "Senolis Graveborn leidžia laiką netoli Brill, Tirisfal Glades.",
        "522c966b493a92a77408": "Senolį Farwhisper galima sutikti klaidžiojantį Stratholme gatvėmis.",
        "dd75db19ece100039eee": "Dabar metas, kai metai dar nauji, o mėnulis ryškiai šviečia.$B$BTai mūsų metas... kai pabunda senoliai.",
        "ee42af43a87e447e4d1f": "Paskutinį kartą senolį Meadowrun mačiau prie Weeping Cave, Western Plaguelands."
      },
      "name": "Senolis Snowcrown",
