    "plPL": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Starszego Moonstrike’a można znaleźć w Scholomance w Zachodnich Ziemiach Plagi.",
        "0e7ae1c033eb03f6d4d1": "Starszy Windrun przebywa w wieży Crown Guard we Wschodnich Ziemiach Plagi.",
        "4879157e760d52d7ff53": "Starszy Graveborn przebywa w pobliżu Brill na Polanach Tirisfal.",
        "522c966b493a92a77408": "Starszego Farwhispera znajdziesz wędrującego ulicami Stratholme.",
        "dd75db19ece100039eee": "Teraz rok jest nowy, a księżyc świeci jasno.$B$BTo nasz czas... gdy budzą się pradawni.",
        "ee42af43a87e447e4d1f": "Ostatnio widziałem starszego Meadowruna przy Płaczącej Jaskini w Zachodnich Ziemiach Plagi."
      },
      "name": "Starszy Snowcrown",
