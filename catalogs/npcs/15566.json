    "hrHR": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Starješina Moonstrike nalazi se u Scholomanceu u Zapadnim okuženim zemljama.",
        "0e7ae1c033eb03f6d4d1": "Starješina Windrun boravi u tornju Crown Guard u Istočnim okuženim zemljama.",
        "4879157e760d52d7ff53": "Starješina Graveborn provodi vrijeme blizu Brilla na Proplancima Tirisfala.",
        "522c966b493a92a77408": "Starješinu Farwhisper možeš pronaći kako luta ulicama Stratholmea.",
        "dd75db19ece100039eee": "Sada je vrijeme kada je godina nova, a mjesec sjaji jarko.$B$BTo je naše vrijeme... kad se drevni bude.",
        "ee42af43a87e447e4d1f": "Starješinu Meadowruna posljednji sam put vidio kod Špilje plača u Zapadnim okuženim zemljama."
      },
      "name": "Starješina Snowcrown",
