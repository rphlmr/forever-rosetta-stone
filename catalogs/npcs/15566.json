    "daDK": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Ældste Moonstrike findes i Scholomance i Western Plaguelands.",
        "0e7ae1c033eb03f6d4d1": "Ældste Windrun opholder sig i Crown Guard Tower i Eastern Plaguelands.",
        "4879157e760d52d7ff53": "Ældste Graveborn opholder sig nær Brill i Tirisfal Glades.",
        "522c966b493a92a77408": "Elder Farwhisper vandrer rundt i Stratholmes gader.",
        "dd75db19ece100039eee": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "ee42af43a87e447e4d1f": "Jeg så sidst ældste Meadowrun ved Weeping Cave i Western Plaguelands."
      },
      "name": "Ældste Snowcrown",
