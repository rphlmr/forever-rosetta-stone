    "svSE": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Äldste Moonstrike finns i Scholomance i Western Plaguelands.",
        "0e7ae1c033eb03f6d4d1": "Äldste Windrun bor i Crown Guard Tower i Eastern Plaguelands.",
        "4879157e760d52d7ff53": "Äldste Graveborn håller till nära Brill i Tirisfal Glades.",
        "522c966b493a92a77408": "Elder Farwhisper vandrar längs Stratholmes gator.",
        "dd75db19ece100039eee": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "ee42af43a87e447e4d1f": "Jag såg senast äldste Meadowrun vid Weeping Cave i Western Plaguelands."
      },
