    "trTR": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Yaşlı Moonstrike, Western Plaguelands’teki Scholomance’ta bulunabilir.",
        "0e7ae1c033eb03f6d4d1": "Yaşlı Windrun, Eastern Plaguelands’teki Crown Guard Kulesi’nde yaşar.",
        "4879157e760d52d7ff53": "Yaşlı Graveborn, Tirisfal Glades’te Brill yakınlarında vakit geçirir.",
        "522c966b493a92a77408": "Kadim Farwhisper'ı Stratholme sokaklarında dolaşırken bulabilirsin.",
        "dd75db19ece100039eee": "Şimdi yeni yılın başladığı ve ayın parlakça parladığı zaman.$B$BBu bizim zamanımız... kadimlerin uyandığı zaman.",
        "ee42af43a87e447e4d1f": "Yaşlı Meadowrun’u en son Western Plaguelands’teki Weeping Cave’de gördüm."
      },
      "name": "Ulu Snowcrown",
