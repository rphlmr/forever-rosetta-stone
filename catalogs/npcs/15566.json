  "locales": {
    "csCZ": {
      "dialogue": {
        "0bb8a3c22ccfcb1f1ae1": "Starší Moonstrike se nachází ve Scholomance v Západních morových zemích.",
        "0e7ae1c033eb03f6d4d1": "Starší Windrun sídlí ve věži Crown Guard ve Východních morových zemích.",
        "4879157e760d52d7ff53": "Starší Graveborn tráví čas poblíž Brillu v Tirisfalských pasekách.",
        "522c966b493a92a77408": "Prastarého Farwhispera můžeš najít, jak se potuluje ulicemi Stratholmu.",
        "dd75db19ece100039eee": "Nyní je čas, kdy začíná nový rok a měsíc jasně září.$B$BJe to náš čas... kdy se probouzejí prastaří.",
        "ee42af43a87e447e4d1f": "Starší Meadowrun jsem naposledy viděl u Plačící jeskyně v Západních morových zemích."
      },
      "name": "Starší Snowcrown",
