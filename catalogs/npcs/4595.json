    "hrHR": {
      "dialogue": {
        "080325610f45344c6f06": "Uloga ratnika je zaštita. Kao što štitimo svoje sunarodnjake u bitci, moramo štititi i interese Forsakena.",
        "1ec493aea3eb016cef51": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Tu je uslugu svaki put sve teže pružiti. Zato je svaka sljedeća preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "d5b42a7fd0a1cc46abb3": "Ne trati moje vrijeme, $c.",
        "eebeb83d92b9d6c1e04c": "Trebam ratničku obuku."
      },
      "name": "Baltus Fowler",
      "translationMetadata": {
