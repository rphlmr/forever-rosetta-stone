    "plPL": {
      "dialogue": {
        "080325610f45344c6f06": "Rolą wojownika jest ochrona. Tak jak chronimy rodaków w bitwie, musimy też chronić interesy Forsaken.",
        "1ec493aea3eb016cef51": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Z każdym razem wykonanie tej usługi staje się trudniejsze. Dlatego każde kolejne szkolenie kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "d5b42a7fd0a1cc46abb3": "Nie marnuj mojego czasu, $c.",
        "eebeb83d92b9d6c1e04c": "Potrzebuję szkolenia wojownika."
      },
      "name": "Baltus Fowler",
      "translationMetadata": {
        "fields": {
