  "locales": {
    "csCZ": {
      "dialogue": {
        "080325610f45344c6f06": "Úlohou válečníka je chránit. Stejně jako v bitvě chráníme své druhy, musíme chránit i zájmy Forsaken.",
        "1ec493aea3eb016cef51": "Přísným přeškolováním jsem musel mnoho studentů odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "d5b42a7fd0a1cc46abb3": "Neztrácej můj čas, $c.",
        "eebeb83d92b9d6c1e04c": "Potřebuji výcvik válečníka."
      },
      "name": "Baltus Fowler",
      "translationMetadata": {
        "fields": {
          "dialogue.080325610f45344c6f06": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
