    "enUS": {
      "dialogue": {
        "080325610f45344c6f06": "The warrior's role is one of protection.  Just as we protect our compatriots in battle, we must also protect the interests of the Forsaken.",
        "1ec493aea3eb016cef51": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "d5b42a7fd0a1cc46abb3": "Do not waste my time, $c.",
        "eebeb83d92b9d6c1e04c": "I require warrior training."
      },
      "name": "Baltus Fowler",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.080325610f45344c6f06": {
