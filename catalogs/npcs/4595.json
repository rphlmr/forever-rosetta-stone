    "ltLT": {
      "dialogue": {
        "080325610f45344c6f06": "Kario pareiga yra ginti. Kaip mūšyje giname savo tautiečius, taip privalome ginti ir Apleistųjų interesus.",
        "1ec493aea3eb016cef51": "Griežtai permokydamas turėjau priversti daugelį mokinių atsisakyti visko, ko jie buvo išmokę, kad galėčiau juos išmokyti iš naujo. Kaskart teikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "d5b42a7fd0a1cc46abb3": "Nešvaistyk mano laiko, $c.",
        "eebeb83d92b9d6c1e04c": "Noriu mokytis kario įgūdžių."
      },
      "name": "Baltus Fowler",
      "subName": "Karių mokytojas",
      "translationMetadata": {
        "fields": {
