    "enUS": {
      "dialogue": {
        "10d9e08dd65aea20cc49": "Greetings.  Do you seek instruction in art of war?",
        "17589461ead632d308b7": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "34b3f58ddda25e502927": "I require warrior training.",
        "38186711a48f99e5a36b": "I do not see the warrior's spirit within you, child.  I have no teachings which would benefit a $c such as yourself."
      },
      "name": "Arias'ta Bladesinger",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.10d9e08dd65aea20cc49": {
