    "plPL": {
      "dialogue": {
        "10d9e08dd65aea20cc49": "Witaj. Szukasz nauki sztuki wojennej?",
        "17589461ead632d308b7": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "34b3f58ddda25e502927": "Potrzebuję szkolenia wojownika.",
        "38186711a48f99e5a36b": "Nie widzę w tobie ducha wojownika, dziecko. Nie mam nauk, które przydałyby się komuś takiemu jak $c."
      },
      "name": "Arias'ta Bladesinger",
