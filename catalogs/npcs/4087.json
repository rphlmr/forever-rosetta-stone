  "locales": {
    "csCZ": {
      "dialogue": {
        "10d9e08dd65aea20cc49": "Zdravím. Hledáš výuku válečného umění?",
        "17589461ead632d308b7": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "34b3f58ddda25e502927": "Potřebuji výcvik válečníka.",
        "38186711a48f99e5a36b": "Nevidím v tobě ducha válečníka, dítě. Nemám co naučit někoho, jako je $c."
      },
      "name": "Arias'ta Bladesinger",
      "translationMetadata": {
        "fields": {
          "dialogue.10d9e08dd65aea20cc49": {
