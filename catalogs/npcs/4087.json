    "daDK": {
      "dialogue": {
        "10d9e08dd65aea20cc49": "Hilsen. Søger du undervisning i krigskunst?",
        "17589461ead632d308b7": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "34b3f58ddda25e502927": "Jeg har brug for krigertræning.",
        "38186711a48f99e5a36b": "Jeg ser ikke en krigers ånd i dig, barn. Jeg har ingen lære, der gavner en $c som dig."
      },
      "name": "Arias'ta Bladesinger",
      "translationMetadata": {
        "fields": {
          "dialogue.10d9e08dd65aea20cc49": {
