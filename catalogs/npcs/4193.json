    "esES": {
      "dialogue": {
        "130cac733eefee4f8548": "Es hora de que vayas a Darnassus y hables con Me'lynn. Ella te guiará a partir de ahora.",
        "6795adc4b26638c82404": "Me encantará hacerme cargo de ti. Comencemos.",
        "bf2b56331276e106fa18": "Entréname.",
        "c8b0b7448ca5d3a852c9": "Las labores de aguja requieren un pulso firme. Y paciencia... por encima de todo, paciencia."
      },
      "name": "Grondal Brisaluna",
      "subName": "Oficial de sastrería",
