    "hrHR": {
      "dialogue": {
        "130cac733eefee4f8548": "Vrijeme je da otputuješ u Darnassus i razgovaraš s Me’lynn. Ona će te odsad voditi.",
        "6795adc4b26638c82404": "Rado ću te uzeti pod svoje okrilje. Počnimo.",
        "bf2b56331276e106fa18": "Podučite me.",
        "c8b0b7448ca5d3a852c9": "Ručni rad zahtijeva mirnu ruku. I strpljenje... prije svega strpljenje."
      },
      "name": "Grondal Moonbreeze",
