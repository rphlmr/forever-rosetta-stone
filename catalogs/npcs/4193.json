    "enUS": {
      "dialogue": {
        "130cac733eefee4f8548": "It is time for you to journey to Darnassus and speak to Me'lynn. She will guide you from now on.",
        "6795adc4b26638c82404": "I would be happy to take you under my wing. Let us begin.",
        "bf2b56331276e106fa18": "Train me.",
        "c8b0b7448ca5d3a852c9": "Needlework requires a steady hand. And patience... above all, patience."
      },
      "name": "Grondal Moonbreeze",
      "subName": "Journeyman Tailor",
