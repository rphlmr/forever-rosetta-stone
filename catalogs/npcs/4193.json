    "trTR": {
      "dialogue": {
        "130cac733eefee4f8548": "Darnassus’a gidip Me’lynn ile konuşma vakti geldi. Bundan sonra sana o yol gösterecek.",
        "6795adc4b26638c82404": "Seni kanatlarımın altına almaktan mutluluk duyarım. Başlayalım.",
        "bf2b56331276e106fa18": "Beni eğit.",
        "c8b0b7448ca5d3a852c9": "İğne işi sağlam bir el ister. Ve sabır... her şeyden önce sabır."
      },
      "name": "Grondal Moonbreeze",
