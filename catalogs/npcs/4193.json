    "plPL": {
      "dialogue": {
        "130cac733eefee4f8548": "Czas udać się do Darnassus i porozmawiać z Me’lynn. Od tej pory ona będzie cię prowadzić.",
        "6795adc4b26638c82404": "Z przyjemnością wezmę cię pod swoje skrzydła. Zaczynajmy.",
        "bf2b56331276e106fa18": "Wyszkol mnie.",
        "c8b0b7448ca5d3a852c9": "Robótki ręczne wymagają pewnej dłoni. I cierpliwości... przede wszystkim cierpliwości."
      },
      "name": "Grondal Moonbreeze",
