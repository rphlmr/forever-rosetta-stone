    "daDK": {
      "dialogue": {
        "130cac733eefee4f8548": "Det er tid til at rejse til Darnassus og tale med Me’lynn. Hun vil vejlede dig fra nu af.",
        "6795adc4b26638c82404": "Jeg tager dig gerne under mine vinger. Lad os begynde.",
        "bf2b56331276e106fa18": "Træn mig.",
        "c8b0b7448ca5d3a852c9": "Håndarbejde kræver en sikker hånd. Og tålmodighed... frem for alt tålmodighed."
      },
      "name": "Grondal Moonbreeze",
      "translationMetadata": {
