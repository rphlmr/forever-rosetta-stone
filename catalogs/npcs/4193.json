    "ltLT": {
      "dialogue": {
        "130cac733eefee4f8548": "Atėjo laikas tau keliauti į Darnassus ir pasikalbėti su Me'lynn. Nuo šiol ji tave mokys.",
        "6795adc4b26638c82404": "Mielai paimsiu tave savo globon. Pradėkime.",
        "bf2b56331276e106fa18": "Pamokyk mane.",
        "c8b0b7448ca5d3a852c9": "Siuvinėjant reikia tvirtos rankos. Ir kantrybės... visų pirma kantrybės."
      },
      "name": "Grondal Moonbreeze",
      "subName": "Siuvėjo pameistrys",
