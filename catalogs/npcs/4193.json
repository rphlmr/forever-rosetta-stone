  "locales": {
    "csCZ": {
      "dialogue": {
        "130cac733eefee4f8548": "Je načase vydat se do Darnassu a promluvit si s Me’lynn. Od této chvíle tě povede ona.",
        "6795adc4b26638c82404": "Rád tě vezmu pod svá křídla. Začněme.",
        "bf2b56331276e106fa18": "Vycvičte mě.",
        "c8b0b7448ca5d3a852c9": "Vyšívání vyžaduje pevnou ruku. A trpělivost... především trpělivost."
      },
      "name": "Grondal Moonbreeze",
