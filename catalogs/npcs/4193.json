    "svSE": {
      "dialogue": {
        "130cac733eefee4f8548": "Det är dags att resa till Darnassus och tala med Me’lynn. Hon kommer att vägleda dig från och med nu.",
        "6795adc4b26638c82404": "Jag tar dig gärna under mina vingar. Låt oss börja.",
        "bf2b56331276e106fa18": "Träna mig.",
        "c8b0b7448ca5d3a852c9": "Handarbete kräver en stadig hand. Och tålamod... framför allt tålamod."
      },
      "name": "Grondal Moonbreeze",
