    "enUS": {
      "dialogue": {
        "78b4f624ff3c26686a54": "I am in charge of recruitment for the Frostwolf Clan. As a soldier of Frostwolf, it is your responsibility to check in with me as your rank among the clan rises.$B$BHonor and respect are earned on this frigid field."
      },
      "name": "Warmaster Laggrond",
