    },
    "daDK": {
      "dialogue": {
        "78b4f624ff3c26686a54": "Jeg står for rekrutteringen til Frostwolf-klanen. Som soldat i Frostwolf er det dit ansvar at melde dig hos mig, når du stiger i rang i klanen.$B$BÆre og respekt skal fortjenes på denne isnende slagmark."
      },
      "name": "Krigsmester Laggrond",
      "translationMetadata": {
        "fields": {
