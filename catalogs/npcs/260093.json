  "locales": {
    "csCZ": {
      "dialogue": {
        "bdd93ce90d5631109394": "Neztrácej můj čas, $c.",
        "ed80b662c741455bedf8": "Přísným přecvičením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přecvičení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Garen Largo",
      "translationMetadata": {
        "fields": {
          "dialogue.bdd93ce90d5631109394": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.ed80b662c741455bedf8": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "bdd93ce90d5631109394": "Spild ikke min tid, $c.",
        "ed80b662c741455bedf8": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang og derfor også dyrere ved hver omskoling. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Garen Largo",
      "translationMetadata": {
        "fields": {
          "dialogue.bdd93ce90d5631109394": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.ed80b662c741455bedf8": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
