    "hrHR": {
      "dialogue": {
        "bdd93ce90d5631109394": "Ne traći moje vrijeme, $c.",
        "ed80b662c741455bedf8": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Tu je uslugu sve teže pružiti svaki put, pa zato i cijena raste sa svakim preobučavanjem. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Garen Largo",
      "translationMetadata": {
        "fields": {
