    "enUS": {
      "dialogue": {
        "1fa24d62133db47e2707": "Rough times, huh, $n? No matter where you turn someone needs help, and my wife and I are no exception.",
        "e9fa771cb79c490ceed8": "I'd like to see what you have to sell."
      },
