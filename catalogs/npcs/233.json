    "daDK": {
      "dialogue": {
        "1fa24d62133db47e2707": "Hårde tider, hva', $n? Hvor end man vender sig, har nogen brug for hjælp, og min kone og jeg er ingen undtagelse.",
        "e9fa771cb79c490ceed8": "Jeg vil gerne se, hvad du sælger."
      },
      "name": "Landmand Saldean",
