    "deDE": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Das Dorf Astranaar in Ashenvale ist Urahnin Riversongs momentanes Zuhause.",
        "24470ca2e739c107ed43": "Urahne Bladeswift wandert die Pfade von Darnassus in Teldrassil entlang.",
        "cb1a1f18073d459b1d6a": "Urahne Nightwind verbringt seine Zeit in dem Schrein in Jaedenar im Teufelswald.",
        "f6cae680bce6a8f1a0d5": "Die Sterne bewegen sich nun auf neuen Bahnen fort. Fortan scheinen sie als Zeichen der Hoffnung und der Stärke für kommende Zeiten."
      },
      "name": "Urahnin Starweave",
