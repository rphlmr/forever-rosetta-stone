    "ltLT": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Vyresnysis Riversong šiuo metu gyvena Astranaar kaime, Ashenvale.",
        "24470ca2e739c107ed43": "Vyresnysis Bladeswift klaidžioja Darnassus takais, Teldrassil viršūnėje.",
        "cb1a1f18073d459b1d6a": "Vyresnysis Nightwind leidžia dienas Jaedenar šventovėje, Felwood.",
        "f6cae680bce6a8f1a0d5": "Šio meto žvaigždės pasuko naujais keliais, tapdamos vilties ir stiprybės švyturiais ateinantiems amžiams."
      },
