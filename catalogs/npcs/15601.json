    "frFR": {
      "dialogue": {
        "13f3d7176793300f0aa7": "L'Ancienne Riversong réside en ce moment au village d'Astraanar, en Ashenvale.",
        "24470ca2e739c107ed43": "L'Ancien Bladeswift arpente les sentiers de Darnassus, au sommet de Teldrassil.",
        "cb1a1f18073d459b1d6a": "L'Ancien Nightwind regarde s'écouler les jours au sanctuaire de Jaedenar, à Gangrebois.",
        "f6cae680bce6a8f1a0d5": "Les étoiles de ce temps suivent des chemins nouveaux, et leurs lueurs seront des foyers d’espoir et de force pour les âges qui s’annoncent."
      },
      "name": "Ancienne Starweave",
