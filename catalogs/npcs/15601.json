    "daDK": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Ældste Riversong bor nu i landsbyen Astranaar i Ashenvale.",
        "24470ca2e739c107ed43": "Ældste Bladeswift vandrer ad Darnassus’ stier på toppen af Teldrassil.",
        "cb1a1f18073d459b1d6a": "Ældste Nightwind tilbringer dagene ved helligdommen i Jaedenar i Felwood.",
        "f6cae680bce6a8f1a0d5": "Stjernerne i denne tid følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre."
      },
      "name": "Ældste Starweave",
