    "csCZ": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Starší Riversong nyní žije ve vesnici Astranaar v Ashenvale.",
        "24470ca2e739c107ed43": "Starší Bladeswift putuje po cestách Darnassu na vrcholu Teldrassilu.",
        "cb1a1f18073d459b1d6a": "Starší Nightwind tráví dny u svatyně v Jaedenaru ve Felwoodu.",
        "f6cae680bce6a8f1a0d5": "Hvězdy této doby se vydávají novými cestami, jako majáky naděje a síly pro nadcházející věky."
      },
      "name": "Starší Starweave",
