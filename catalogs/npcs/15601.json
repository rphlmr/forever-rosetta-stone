    "svSE": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Äldste Riversong bor för närvarande i byn Astranaar i Ashenvale.",
        "24470ca2e739c107ed43": "Äldste Bladeswift vandrar på Darnassus stigar uppe på Teldrassil.",
        "cb1a1f18073d459b1d6a": "Äldste Nightwind tillbringar dagarna vid helgedomen i Jaedenar i Felwood.",
        "f6cae680bce6a8f1a0d5": "Denna tids stjärnor följer nya banor, fyrar av hopp och styrka för kommande tidsåldrar."
      },
      "name": "Äldste Starweave",
