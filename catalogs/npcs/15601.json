    "ptBR": {
      "dialogue": {
        "13f3d7176793300f0aa7": "A anciã Cantoflúvio mora, atualmente, em Astranaar, no Vale Gris.",
        "24470ca2e739c107ed43": "O ancião Açolesto vaga pelas ruas de Darnassus, no alto da Teldrassil.",
        "cb1a1f18073d459b1d6a": "O ancião Venterral passa seus dias no santuário em Jaedenar, que fica na Selva Maleva.",
        "f6cae680bce6a8f1a0d5": "As estrelas desta época iluminam outros caminhos – raios de força e esperança para as eras vindouras."
      },
      "name": "Anciã Tecestrela",
