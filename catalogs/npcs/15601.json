    "esES": {
      "dialogue": {
        "13f3d7176793300f0aa7": "La aldea de Astranaar en Vallefresno es el actual hogar del ancestro Riosona.",
        "24470ca2e739c107ed43": "El ancestro Filoveloz vaga por los caminos de Darnassus en lo alto de Teldrassil.",
        "cb1a1f18073d459b1d6a": "El ancestro Nochebrisa pasa los días en el santuario de Jaedenar en Frondavil.",
        "f6cae680bce6a8f1a0d5": "Las estrellas de nuestro tiempo están cambiando su trayectoria, faros de esperanza y fortaleza para los años venideros."
      },
      "name": "Ancestro Tejestrellas",
