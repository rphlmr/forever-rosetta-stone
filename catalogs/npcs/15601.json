    "plPL": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Starsza Riversong mieszka obecnie w wiosce Astranaar w Ashenvale.",
        "24470ca2e739c107ed43": "Starszy Bladeswift przemierza ścieżki Darnassus na szczycie Teldrassil.",
        "cb1a1f18073d459b1d6a": "Starszy Nightwind spędza dni przy sanktuarium w Jaedenar w Felwood.",
        "f6cae680bce6a8f1a0d5": "Gwiazdy tej epoki obierają nowe drogi, wskazując nadzieję i siłę dla nadchodzących wieków."
      },
      "name": "Starsza Starweave",
