    "hrHR": {
      "dialogue": {
        "13f3d7176793300f0aa7": "Starješina Riversong trenutačno živi u selu Astranaar u Ashenvaleu.",
        "24470ca2e739c107ed43": "Starješina Bladeswift luta stazama Darnassusa na vrhu Teldrassila.",
        "cb1a1f18073d459b1d6a": "Starješina Nightwind provodi dane kod svetišta u Jaedenaru u Felwoodu.",
        "f6cae680bce6a8f1a0d5": "Zvijezde ovog doba kreću novim putovima, svjetionici nade i snage za nadolazeća vremena."
