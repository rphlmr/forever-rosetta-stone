    "enUS": {
      "dialogue": {
        "13f3d7176793300f0aa7": "The village of Astranaar in Ashenvale is Elder Riversong's current home.",
        "24470ca2e739c107ed43": "Elder Bladeswift wanders the paths of Darnassus atop Teldrassil.",
        "cb1a1f18073d459b1d6a": "Elder Nightwind passes the days at the shrine in Jaedenar in Felwood.",
        "f6cae680bce6a8f1a0d5": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages."
      },
      "name": "Elder Starweave",
