    "itIT": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Forse un giorno i tuoi contributi all'Alleanza saranno grandi quanto quelli degli eroi che hai visto oggi. Rendi loro onore, $N.",
        "bf8ea184e945a19e3738": "Vivo solo per servire il nostro Re."
      },
      "name": "Maggiore Mattingly",
