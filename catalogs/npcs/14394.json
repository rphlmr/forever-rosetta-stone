  "locales": {
    "csCZ": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Možná jednou přispěješ Alianci stejně jako hrdinové, které jsi dnes viděl. Vzdej jim čest, $n.",
        "bf8ea184e945a19e3738": "Žiji jen proto, abych sloužil našemu králi."
      },
      "name": "Major Mattingly",
      "translationMetadata": {
        "fields": {
