    "plPL": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Być może pewnego dnia twoje zasługi dla Przymierza dorównają zasługom bohaterów, których dziś widzisz. Oddaj im cześć, $n.",
        "bf8ea184e945a19e3738": "Żyję tylko po to, by służyć naszemu królowi."
      },
      "name": "Major Mattingly",
      "translationMetadata": {
