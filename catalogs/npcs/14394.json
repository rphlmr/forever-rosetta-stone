    "enUS": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Perhaps one day, your contributions to the Alliance will be as great as the heroes you have seen this day. Honor them, $n.",
        "bf8ea184e945a19e3738": "I live only to serve our King."
      },
      "name": "Major Mattingly",
      "translationMetadata": {
        "fields": {
          "dialogue.0d8cfc235582ea8f16fe": {
