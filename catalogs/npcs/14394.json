    },
    "daDK": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Måske vil dine bidrag til Alliancen en dag være lige så store som de heltes, du har set i dag. Ær dem, $n.",
        "bf8ea184e945a19e3738": "Jeg lever kun for at tjene vores konge."
      },
      "name": "Major Mattingly",
      "translationMetadata": {
        "fields": {
          "dialogue.0d8cfc235582ea8f16fe": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
