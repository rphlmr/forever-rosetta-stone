    "svSE": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Kanske blir dina insatser för Alliansen en dag lika stora som hjältarnas du har sett i dag. Hedra dem, $n.",
        "bf8ea184e945a19e3738": "Jag lever bara för att tjäna vår kung."
      },
      "name": "Major Mattingly",
      "translationMetadata": {
