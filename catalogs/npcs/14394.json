    "trTR": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Belki bir gün İttifak’a katkıların bugün gördüğün kahramanlarınki kadar büyük olur. Onları onurlandır, $n.",
        "bf8ea184e945a19e3738": "Yalnızca kralımıza hizmet etmek için yaşıyorum."
      },
      "name": "Binbaşı Mattingly",
      "translationMetadata": {
        "fields": {
          "dialogue.0d8cfc235582ea8f16fe": {
            "origin": "ai",
