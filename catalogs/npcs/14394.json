    "ltLT": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Galbūt vieną dieną tavo nuopelnai Aljansui prilygs šiandien matytų didvyrių nuopelnams. Pagerbk juos, $n.",
        "bf8ea184e945a19e3738": "Gyvenu tik tam, kad tarnaučiau mūsų karaliui."
      },
      "name": "Majoras Mattingly",
