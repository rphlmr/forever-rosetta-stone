    "hrHR": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Možda će jednog dana tvoj doprinos Savezu biti velik poput doprinosa junaka koje si danas vidio. Iskaži im počast, $n.",
        "bf8ea184e945a19e3738": "Živim samo da služim našem kralju."
      },
      "name": "Bojnik Mattingly",
