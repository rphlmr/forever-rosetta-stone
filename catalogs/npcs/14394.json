            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "0d8cfc235582ea8f16fe": "Можливо, колись твій внесок в Альянс буде таким самим великим, як внесок героїв, яких ти сьогодні бачиш. Віддай їм шану, $n.",
        "bf8ea184e945a19e3738": "Я живу лише для того, щоб служити нашому королю."
      },
      "name": "майор Маттінґлі",
      "translationMetadata": {
        "fields": {
          "dialogue.0d8cfc235582ea8f16fe": {
