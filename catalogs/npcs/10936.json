  "locales": {
    "csCZ": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Zrak mi zahalila temnota, ale ty jsi mě vytrhl z mého bezbožného snění. Zachránil jsi mě, $n.$B$BA teď tě prosím... odpusť mi."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
