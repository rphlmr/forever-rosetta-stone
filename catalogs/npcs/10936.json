          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "ptBR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Тьма застилала мне глаза, но вы вырвали меня из нечестивых грез. Вы спасли меня, $N.\n\nА теперь я умоляю вас… о прощении."
      },
      "name": "Джозеф Редпат",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ruRU",
            "sourceSha256": "6c631198f2820ad1638d95d5c2405c11c90019cbf3afeca9541bb2b70432f7ff"
          },
          "name": {
