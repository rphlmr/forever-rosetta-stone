            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Gözlerimi bir karanlık bürümüştü, ama sen beni o uğursuz dalgınlıktan çekip çıkardın. Beni kurtardın, $n.$B$BŞimdi senden yalvararak diliyorum... beni affet."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
