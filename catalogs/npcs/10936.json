            "sourceLocale": "frFR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "hrHR": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Tama mi je prekrila oči, ali ti si me otrgnuo od mojeg nesvetog sanjarenja. Spasio si me, $n.$B$BA sada te molim... oprosti mi."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
