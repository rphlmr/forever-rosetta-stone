            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Una tenebra era calata sui miei occhi, ma tu mi hai strappato a quel sogno empio. Mi hai salvato, $N.\n\nE ora ti supplico... di perdonarmi."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
