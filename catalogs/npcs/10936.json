            "sourceLocale": "koKR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Ciemność przesłoniła mi oczy, lecz wyrwałeś mnie z bezbożnego otępienia. Ocaliłeś mnie, $n.$B$BA teraz błagam cię... wybacz mi."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "As trevas cobriram meus olhos, mas você me despertou daquele devaneio profano. Você me salvou, $n.\n\nAgora eu lhe imploro... perdoe-me!"
      },
      "name": "Josefo Trilharrubra",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "community",
