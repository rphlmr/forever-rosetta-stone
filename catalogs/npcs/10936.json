            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Темрява застелила мені очі, але ти вирвав мене з нечестивого забуття. Ти врятував мене, $n.$B$BА тепер я благаю тебе... пробач мені."
      },
      "name": "Джозеф Редпат",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
