    "frFR": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "La pénombre était tombée devant mes yeux, mais vous m'avez fait sortir de ma rêverie impie. Vous avez sauvé ma vie, $n.\n\nEt je vous supplie maintenant de me pardonner."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "frFR",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
