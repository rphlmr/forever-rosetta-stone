            "sourceLocale": "ruRU",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Ett mörker hade fallit över mina ögon, men du slet mig ur min oheliga dröm. Du räddade mig, $n.$B$BOch nu ber jag dig... förlåt mig."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
