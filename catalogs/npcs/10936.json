            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Et mørke havde lagt sig over mine øjne, men du rev mig ud af min vanhellige drømmetilstand. Du reddede mig, $n.$B$BOg nu beder jeg dig... tilgiv mig."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "Dunkelheit hatte sich über meine Augen gelegt, doch Ihr habt mich aus meiner unheiligen Trance gerissen. Ihr habt mich gerettet, $n.\n\nUnd nun bitte ich Euch... vergebt mir."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
            "sourceSha256": "c1cd1597ee8ef61b8859daf63d724a5ec28d311078335b8014ae4d85c11777ac"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "A darkness had fallen over my eyes, but you tore me from my unholy reverie.  You saved me, $n.$B$BAnd now I beg you... to forgive me."
      },
      "name": "Joseph Redpath",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "c0fe49678097f95d0d2f": "La oscuridad había caído sobre mis ojos, pero me has arrancado de mi impura ensoñación. Me has salvado, $n.\n\nY ahora, te lo suplico... perdóname."
      },
      "name": "Joseph Rutagrana",
      "translationMetadata": {
        "fields": {
          "dialogue.c0fe49678097f95d0d2f": {
