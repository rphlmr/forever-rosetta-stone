    "hrHR": {
      "dialogue": {
        "1a6717fdb85854ecfb01": "Ne mogu te podučavati. Moraš razgovarati s učiteljem svoje klase.",
        "6606f3517bd9dd6e10dd": "Uz odobrenje lorda Varimathrasa, redovi Deathstalkera rastu. Više oštrica za udar na naše neprijatelje kad se najmanje nadaju.",
        "f5b625cc4485ea5887d4": "Želim trenirati."
      },
      "name": "Marion Call",
