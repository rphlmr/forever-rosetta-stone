    "deDE": {
      "dialogue": {
        "1a6717fdb85854ecfb01": "Ich kann Euch nicht ausbilden. Da müsst Ihr mit dem Lehrer für Eure Klasse sprechen.",
        "6606f3517bd9dd6e10dd": "Mit Zustimmung von Lord Varimathras steigt die Anzahl der Todespirscher an. Mehr Klingen, die unsere Feinde treffen, wenn sie es am wenigsten erwarten.",
        "f5b625cc4485ea5887d4": "Ich möchte ausgebildet werden."
      },
      "name": "Marion Call",
      "subName": "Schurkenlehrerin",
