    "plPL": {
      "dialogue": {
        "1a6717fdb85854ecfb01": "Nie mogę cię szkolić. Musisz porozmawiać z trenerem swojej klasy.",
        "6606f3517bd9dd6e10dd": "Za zgodą lorda Varimathrasa szeregi Deathstalkerów rosną. Więcej ostrzy uderzy w naszych wrogów, gdy najmniej będą się tego spodziewać.",
        "f5b625cc4485ea5887d4": "Chcę się szkolić."
      },
