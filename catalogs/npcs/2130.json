    "enUS": {
      "dialogue": {
        "1a6717fdb85854ecfb01": "I can not train you. You need to talk to your class trainer.",
        "6606f3517bd9dd6e10dd": "With the sanction of Lord Varimathras, the Deathstalkers' numbers grow. More blades to strike at our enemies when they least expect it.",
        "f5b625cc4485ea5887d4": "I would like to train."
      },
      "name": "Marion Call",
      "subName": "Rogue Trainer",
