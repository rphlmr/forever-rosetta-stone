  "locales": {
    "csCZ": {
      "dialogue": {
        "1a6717fdb85854ecfb01": "Nemohu tě cvičit. Musíš promluvit se svým trenérem povolání.",
        "6606f3517bd9dd6e10dd": "S požehnáním lorda Varimathrase řady Deathstalkerů rostou. Další čepele zasáhnou naše nepřátele, až to budou nejméně čekat.",
        "f5b625cc4485ea5887d4": "Chtěl bych se vycvičit."
      },
      "name": "Marion Call",
      "translationMetadata": {
        "fields": {
          "dialogue.1a6717fdb85854ecfb01": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
