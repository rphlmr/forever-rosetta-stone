    },
    "daDK": {
      "dialogue": {
        "1a6717fdb85854ecfb01": "Jeg kan ikke træne dig. Du må tale med din klassetræner.",
        "6606f3517bd9dd6e10dd": "Med lord Varimathras' godkendelse vokser Deathstalkers' rækker. Flere klinger til at ramme vores fjender, når de mindst venter det.",
        "f5b625cc4485ea5887d4": "Jeg vil gerne trænes."
      },
      "name": "Marion Call",
      "translationMetadata": {
        "fields": {
          "dialogue.1a6717fdb85854ecfb01": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
