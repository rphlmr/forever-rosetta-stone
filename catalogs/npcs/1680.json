    "esES": {
      "dialogue": {
        "09a7b8be74fa276061af": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "2cf590f3dab1b722c788": "Puedo enseñarte a pescar.",
        "8b65e104e910aeb772e7": "Entréname.",
        "e768a7ea4ed298f71715": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad."
      },
      "name": "Matías Arero",
      "subName": "Instructor de pesca",
