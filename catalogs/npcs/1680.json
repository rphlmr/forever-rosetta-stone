    "daDK": {
      "dialogue": {
        "09a7b8be74fa276061af": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu.",
        "2cf590f3dab1b722c788": "Jeg kan lære dig at fiske.",
        "8b65e104e910aeb772e7": "Træn mig.",
        "e768a7ea4ed298f71715": "Dine færdigheder overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"The Bass and You\". Den vil sikkert hjælpe dig med at blive bedre."
      },
      "name": "Matthew Hooper",
      "translationMetadata": {
