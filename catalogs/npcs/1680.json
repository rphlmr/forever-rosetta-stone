    "svSE": {
      "dialogue": {
        "09a7b8be74fa276061af": "Du måste hitta Nat Pagle i Dustwallow Marsh för att bli bättre än du är nu.",
        "2cf590f3dab1b722c788": "Jag kan lära dig att fiska.",
        "8b65e104e910aeb772e7": "Träna mig.",
        "e768a7ea4ed298f71715": "Din färdighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av \"Abborren och du\". Den hjälper dig säkert att bli bättre."
      },
      "name": "Matthew Hooper",
