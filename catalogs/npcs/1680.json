    "enUS": {
      "dialogue": {
        "09a7b8be74fa276061af": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "2cf590f3dab1b722c788": "I can teach you fishing skills.",
        "8b65e104e910aeb772e7": "Train me.",
        "e768a7ea4ed298f71715": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill."
      },
      "name": "Matthew Hooper",
      "subName": "Fishing Trainer",
