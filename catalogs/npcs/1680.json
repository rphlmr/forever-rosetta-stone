    "frFR": {
      "dialogue": {
        "09a7b8be74fa276061af": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "2cf590f3dab1b722c788": "Je peux vous apprendre à pêcher.",
        "8b65e104e910aeb772e7": "Entraînez-moi.",
        "e768a7ea4ed298f71715": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser."
      },
      "name": "Matthew Hooper",
      "subName": "Maître des pêcheurs",
