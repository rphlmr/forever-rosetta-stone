  "locales": {
    "csCZ": {
      "dialogue": {
        "09a7b8be74fa276061af": "Pokud se chceš dále zlepšit, musíš najít Nata Pagleho v močálu Dustwallow.",
        "2cf590f3dab1b722c788": "Mohu tě naučit rybařit.",
        "8b65e104e910aeb772e7": "Vycvičte mě.",
        "e768a7ea4ed298f71715": "Tvé dovednosti převyšují mé, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit."
      },
      "name": "Matthew Hooper",
      "translationMetadata": {
