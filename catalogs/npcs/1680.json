    "deDE": {
      "dialogue": {
        "09a7b8be74fa276061af": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "2cf590f3dab1b722c788": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "8b65e104e910aeb772e7": "Bildet mich aus.",
        "e768a7ea4ed298f71715": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern."
      },
      "name": "Matthew Hooper",
      "subName": "Angellehrer",
      "translationMetadata": {
