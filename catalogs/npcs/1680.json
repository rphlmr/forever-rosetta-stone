    "hrHR": {
      "dialogue": {
        "09a7b8be74fa276061af": "Moraš pronaći Nata Paglea u močvari Dustwallow želiš li se dalje usavršavati.",
        "2cf590f3dab1b722c788": "Mogu te naučiti ribolovu.",
        "8b65e104e910aeb772e7": "Podučite me.",
        "e768a7ea4ed298f71715": "Tvoja je vještina veća od moje, no čuo sam da stari Heming u Booty Bayu ima primjerke knjige „Grgeč i ti”. Ona će ti sigurno pomoći da napreduješ."
      },
      "name": "Matthew Hooper",
