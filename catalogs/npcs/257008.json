  "locales": {
    "csCZ": {
      "dialogue": {
        "3aeb2ab608ca1a8c816b": "Á, kolega rybář. Nepotřebuješ trochu výcviku? Možná bych ti mohl něco ukázat?",
        "aca4d09f19052e78a069": "Tvá dovednost převyšuje mou, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti určitě pomůže se zlepšit."
      },
      "name": "Baelann Swiftcurrent",
      "translationMetadata": {
        "fields": {
