    "enUS": {
      "dialogue": {
        "3aeb2ab608ca1a8c816b": "Ah, a fellow Fisherman. Are you perhaps in need of a little training? Maybe I can show you a thing or two?",
        "aca4d09f19052e78a069": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill."
      },
      "name": "Baelann Swiftcurrent",
      "subName": "Fisher",
