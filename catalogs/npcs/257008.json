    "svSE": {
      "dialogue": {
        "3aeb2ab608ca1a8c816b": "Jaså, en fiskarkollega. Behöver du lite träning? Jag kanske kan visa dig ett och annat?",
        "aca4d09f19052e78a069": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av \"Abborren och du\". Den hjälper dig säkert att bli skickligare."
      },
      "name": "Baelann Swiftcurrent",
      "translationMetadata": {
