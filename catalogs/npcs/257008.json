    "plPL": {
      "dialogue": {
        "3aeb2ab608ca1a8c816b": "Ach, kolega po wędce. Potrzebujesz może trochę nauki? Może zdołam pokazać ci to i owo?",
        "aca4d09f19052e78a069": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci się rozwinąć."
      },
      "name": "Baelann Swiftcurrent",
      "translationMetadata": {
