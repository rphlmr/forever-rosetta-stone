    "daDK": {
      "dialogue": {
        "3aeb2ab608ca1a8c816b": "Nå, en fiskerkollega. Har du måske brug for lidt træning? Måske kan jeg lære dig et og andet?",
        "aca4d09f19052e78a069": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den vil helt sikkert hjælpe dig med at blive bedre."
      },
      "name": "Baelann Swiftcurrent",
      "translationMetadata": {
        "fields": {
