    "hrHR": {
      "dialogue": {
        "3aeb2ab608ca1a8c816b": "Ah, kolega ribar. Trebaš li možda malo obuke? Možda ti mogu nešto pokazati?",
        "aca4d09f19052e78a069": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige \"Grgeč i ti\". Ona će ti sigurno pomoći da se usavršiš."
      },
      "name": "Baelann Swiftcurrent",
      "translationMetadata": {
