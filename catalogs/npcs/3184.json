  "locales": {
    "csCZ": {
      "dialogue": {
        "0401180b08d92724a059": "Máš otázky, ale ty jsou na mě moc složité, $n. Musíš si promluvit s orkem Yelmakem v Drag v Orgrimmaru. Ten ti pomůže.",
        "094caeaa018285f8e6cb": "Vycvičte mě.",
        "0c202f7bbc71c55eaf0d": "Připraven na další lekci? Tak dobře. Nejdřív se uvolni. Musíš být v pohodě, abys lektvar správně zamíchal.",
        "885ee7913afefbbdf1cd": "Vypadáš jako někdo, kdo hledá dobrodružství. Já už ho měl dost, když jsme my trollové přišli sem. Teď beru každý den, jak přichází, a učím ostatní, aby dobrodružství zvládali za mě."
      },
      "name": "Miao'zan",
      "translationMetadata": {
        "fields": {
          "dialogue.0401180b08d92724a059": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
