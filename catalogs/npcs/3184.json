    "enUS": {
      "dialogue": {
        "0401180b08d92724a059": "You got questions, but they be too big for me to answer, $n. You be needin' to have words with the orc Yelmak in the Drag of Orgrimmar. He'll help you out.",
        "094caeaa018285f8e6cb": "Train me.",
        "0c202f7bbc71c55eaf0d": "Ready for another lesson? All right, then. First, relax. You gotta stay loose to stir a potion just right.",
        "885ee7913afefbbdf1cd": "You got the look of someone wantin' adventure. Me, I had enough of that by the time we trolls came here. Now I take each day as it comes, an' I train other folks to handle adventures for me."
      },
      "name": "Miao'zan",
      "subName": "Journeyman Alchemist",
      "translationMetadata": {
