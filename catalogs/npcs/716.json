    "daDK": {
      "dialogue": {
        "1e7b8fefde382b975e71": "Mester Nesingwary har en stor jagt foran sig. Jeg synes, det er langt mere afslappende at hjælpe ham med at forberede en dag i junglen end at gøre ham klar til kamp. Selvom jeg savner nogle af de glorværdige øjeblikke på slagmarken."
      },
      "name": "Barnil Stonepot",
      "translationMetadata": {
        "fields": {
          "dialogue.1e7b8fefde382b975e71": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
