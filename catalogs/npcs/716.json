    "hrHR": {
      "dialogue": {
        "1e7b8fefde382b975e71": "Pred majstorom Nesingwaryjem velik je lov. Pripremati ga za dan u džungli mnogo je opuštajuće nego spremati ga za borbu. Premda mi nedostaju neki od slavnih trenutaka na bojištu."
      },
      "name": "Barnil Stonepot",
