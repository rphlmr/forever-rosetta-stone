    "ltLT": {
      "dialogue": {
        "1e7b8fefde382b975e71": "Meistro Nesingwary laukia didelė medžioklė. Padėti jam pasiruošti dienai džiunglėse man kur kas ramiau nei rengti jį mūšiui. Nors kai kurių šlovingų akimirkų mūšio lauke ir pasiilgstu."
      },
      "name": "Barnil Stonepot",
      "translationMetadata": {
