          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "1e7b8fefde382b975e71": "Master Nesingwary has a big hunt ahead of him.  I find helping him prepare for a day in the jungle is much more relaxing than helping him ready for combat.  Although I do miss some of those glorious moments on the battlefield."
      },
      "name": "Barnil Stonepot",
      "translationMetadata": {
        "fields": {
          "dialogue.1e7b8fefde382b975e71": {
