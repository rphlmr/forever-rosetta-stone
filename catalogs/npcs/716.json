  "locales": {
    "csCZ": {
      "dialogue": {
        "1e7b8fefde382b975e71": "Mistra Nesingwaryho čeká velký lov. Připravovat ho na den v džungli je mnohem klidnější než ho chystat do boje. I když některé slavné chvíle na bitevním poli mi chybí."
      },
      "name": "Barnil Stonepot",
      "translationMetadata": {
        "fields": {
          "dialogue.1e7b8fefde382b975e71": {
