    "hrHR": {
      "dialogue": {
        "0e27df1841f0dff38208": "Zvijezde ovoga doba kreću novim putanjama, svjetionici nade i snage za buduća vremena.",
        "ccf62acee8f8110b5075": "Winterhoof? Čujem da uživa u Booty Bayu.",
        "f624818cdb12dbf7d2fc": "Koliko znam, Elder Starsong posljednji je put bio u Potopljenom hramu u Močvari tuge."
      },
      "name": "Starješina Starglade",
