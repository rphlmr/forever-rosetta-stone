  "locales": {
    "csCZ": {
      "dialogue": {
        "0e27df1841f0dff38208": "Hvězdy této doby se vydávají novými cestami, majáky naděje a síly pro nadcházející věky.",
        "ccf62acee8f8110b5075": "Winterhoof? Slyšel jsem, že si užívá v Booty Bay.",
        "f624818cdb12dbf7d2fc": "Naposledy, co vím, byl Elder Starsong v Potopeném chrámu v Bažině nářků."
      },
      "name": "Starší Starglade",
      "translationMetadata": {
        "fields": {
          "dialogue.0e27df1841f0dff38208": {
