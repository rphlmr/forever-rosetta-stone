    "plPL": {
      "dialogue": {
        "0e27df1841f0dff38208": "Gwiazdy tych czasów obierają nowe drogi, będąc światłem nadziei i siły dla przyszłych epok.",
        "ccf62acee8f8110b5075": "Winterhoof? Słyszałem, że świetnie się bawi w Booty Bay.",
        "f624818cdb12dbf7d2fc": "Ostatnio, gdy o nim słyszałem, Elder Starsong przebywał w Zatopionej Świątyni na Bagnach Smutku."
      },
      "name": "Starsza Starglade",
