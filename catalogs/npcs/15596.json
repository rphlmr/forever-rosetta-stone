    "enUS": {
      "dialogue": {
        "0e27df1841f0dff38208": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "ccf62acee8f8110b5075": "Winterhoof? I hear he's living it up in Booty Bay.",
        "f624818cdb12dbf7d2fc": "Last I knew, Elder Starsong was in the Sunken Temple of the Swamp of Sorrows."
      },
      "name": "Elder Starglade",
      "translationMetadata": {
