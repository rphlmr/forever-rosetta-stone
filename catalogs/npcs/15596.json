    "daDK": {
      "dialogue": {
        "0e27df1841f0dff38208": "Denne tids stjerner slår ind på nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "ccf62acee8f8110b5075": "Winterhoof? Jeg hører, at han nyder livet i Booty Bay.",
        "f624818cdb12dbf7d2fc": "Sidst jeg hørte, var Elder Starsong i det sunkne tempel i Swamp of Sorrows."
      },
      "name": "Ældste Starglade",
      "translationMetadata": {
        "fields": {
          "dialogue.0e27df1841f0dff38208": {
