  "locales": {
    "csCZ": {
      "dialogue": {
        "07488843045c747a79af": "Plucky nechce, aby Tirth věděl, že je pořád v Shimmering Flats, a tak se proměnil v kuře!$B$BKdyž Pluckyho najdeš, pokyň mu. Možná vyleze z úkrytu.",
        "37e513effbe6e1549c72": "Ahoj, $c! Vítej na závodech v Shimmering Flats!",
        "3ff76a8bfd77da51fc18": "Vítej na závodech! Užij si pobyt a nevsázej všechny peníze na jedno místo!",
        "62a3c84f2d360736a4f7": "Kdo má nejrychlejší vůz? Kdo ví?!",
        "f8b866b8f6bfb5ac743f": "Gobliní závoďák má pořádnou sílu, ale gnómové ve svém autě schovali jeden či dva triky..."
      },
      "name": "Mistr závodů Kronkrider",
      "translationMetadata": {
        "fields": {
