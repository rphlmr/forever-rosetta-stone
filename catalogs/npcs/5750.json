    "ptBR": {
      "dialogue": {
        "32d5851b604c03e74796": "Você não é bruxo e eu não tenho tempo para você. Suma!",
        "4539675c8c20487e4217": "Mostre-me sua seleção de grimórios.",
        "b52f6795f8fc5b8814e0": "Quer tornar seus demônios mais poderosos? Isso não vai sair de graça, mas você veio ao lugar certo."
      },
