    "frFR": {
      "dialogue": {
        "32d5851b604c03e74796": "Vous n'êtes pas démoniste et je n'ai pas de temps pour vous. Filez !",
        "4539675c8c20487e4217": "Montrez-moi vos grimoires.",
        "b52f6795f8fc5b8814e0": "Vous voulez que vos démons soient plus puissants ? Cela vous coûtera cher, mais vous êtes au bon endroit."
      },
      "name": "Gina Lang",
      "subName": "Maître des démons",
