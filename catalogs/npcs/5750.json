    "deDE": {
      "dialogue": {
        "32d5851b604c03e74796": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "4539675c8c20487e4217": "Zeigt mir Eure Auswahl an Grimoires.",
        "b52f6795f8fc5b8814e0": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig."
      },
      "name": "Gina Lang",
      "subName": "Dämonenausbilderin",
