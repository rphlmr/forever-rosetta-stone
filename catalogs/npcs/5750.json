    "plPL": {
      "dialogue": {
        "32d5851b604c03e74796": "Nie jesteś czarnoksiężnikiem i nie mam dla ciebie czasu. Precz!",
        "4539675c8c20487e4217": "Pokaż mi swoją ofertę grymuarów.",
        "b52f6795f8fc5b8814e0": "Chcesz wzmocnić swoje demony? Będzie cię to kosztować, ale jesteś we właściwym miejscu."
      },
