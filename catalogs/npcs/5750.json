    "itIT": {
      "dialogue": {
        "32d5851b604c03e74796": "Non sei uno stregone e non ho tempo per te. Vattene!",
        "4539675c8c20487e4217": "Mostrami la tua selezione di grimori.",
        "b52f6795f8fc5b8814e0": "Vuoi rendere più potenti i tuoi demoni? Ti costerà qualcosa, ma sei nel posto giusto."
      },
      "name": "Gina Lang",
