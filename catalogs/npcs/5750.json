    "svSE": {
      "dialogue": {
        "32d5851b604c03e74796": "Du är ingen demonbesvärjare och jag har inte tid med dig. Försvinn!",
        "4539675c8c20487e4217": "Visa mig ditt utbud av grimorier.",
        "b52f6795f8fc5b8814e0": "Vill du göra dina demoner starkare? Det kommer att kosta, men du har kommit rätt."
      },
