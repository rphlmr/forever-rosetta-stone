    "esES": {
      "dialogue": {
        "32d5851b604c03e74796": "No eres un brujo y no tengo tiempo para ti. ¡Largo!",
        "4539675c8c20487e4217": "Muéstrame tu selección de grimorios.",
        "b52f6795f8fc5b8814e0": "¿Quieres que tus demonios sean más poderosos? Te costará, pero has venido al lugar adecuado."
      },
      "name": "Gina Lang",
      "subName": "Instructor de demonios",
