    "ltLT": {
      "dialogue": {
        "32d5851b604c03e74796": "Tu ne burtininkas, ir aš neturiu tau laiko.  Nešdinkis!",
        "4539675c8c20487e4217": "Parodyk man savo grimuarus.",
        "b52f6795f8fc5b8814e0": "Nori sustiprinti savo demonus?  Tai kainuos, bet atėjai ten, kur reikia."
      },
      "name": "Gina Lang",
      "subName": "Demonų dresuotojas",
