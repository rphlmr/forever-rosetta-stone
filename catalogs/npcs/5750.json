    "enUS": {
      "dialogue": {
        "32d5851b604c03e74796": "You're no warlock and I've no time for you.  Begone!",
        "4539675c8c20487e4217": "Show me your selection of grimoires.",
        "b52f6795f8fc5b8814e0": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place."
      },
      "name": "Gina Lang",
      "subName": "Demon Trainer",
