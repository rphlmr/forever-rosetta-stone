    },
    "daDK": {
      "dialogue": {
        "32d5851b604c03e74796": "Du er ikke troldmand, og jeg har ikke tid til dig. Forsvind!",
        "4539675c8c20487e4217": "Vis mig dit udvalg af grimoirer.",
        "b52f6795f8fc5b8814e0": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted."
      },
      "name": "Gina Lang",
      "translationMetadata": {
        "fields": {
          "dialogue.32d5851b604c03e74796": {
