  "locales": {
    "csCZ": {
      "dialogue": {
        "32d5851b604c03e74796": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "4539675c8c20487e4217": "Ukažte mi svou nabídku grimoárů.",
        "b52f6795f8fc5b8814e0": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě."
      },
      "name": "Gina Lang",
      "translationMetadata": {
        "fields": {
          "dialogue.32d5851b604c03e74796": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
