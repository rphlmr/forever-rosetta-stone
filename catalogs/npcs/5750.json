    "hrHR": {
      "dialogue": {
        "32d5851b604c03e74796": "Nisi vještac i nemam vremena za tebe. Gubi se!",
        "4539675c8c20487e4217": "Pokažite mi svoj izbor grimoara.",
        "b52f6795f8fc5b8814e0": "Želiš osnažiti svoje demone? To će te stajati, ali na pravom si mjestu."
      },
      "name": "Gina Lang",
      "translationMetadata": {
