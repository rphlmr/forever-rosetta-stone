    "esMX": {
      "dialogue": {
        "02a39551fcf185c0816f": "Quiero ver tus mercancías.",
        "ad24eb60dd81c0aa130b": "No desperdiciamos ninguna parte de los animales que cazamos.",
        "b15526429f5e13344748": "Entréname.",
        "f6eb92612944fe3b710c": "Los tauren somos hijos e hijas de la Madre Tierra y respetamos a todos sus hijos. Incluso valoramos a las bestias que matamos, pues sus cuerpos nos alimentan y sus pieles nos abrigan."
      },
      "name": "Veren Zancaalta",
