  "locales": {
    "csCZ": {
      "dialogue": {
        "02a39551fcf185c0816f": "Rád bych si prohlédl vaše zboží.",
        "ad24eb60dd81c0aa130b": "Ze zvířat, která lovíme, nepřijde nazmar žádná část.",
        "b15526429f5e13344748": "Vycvičte mě.",
        "f6eb92612944fe3b710c": "Taureni jsou syny a dcerami Matky Země a projevujeme úctu všem jejím dětem. I zvířat, která zabíjíme, si vážíme, neboť jejich těla nás živí a jejich kůže nás hřejí."
      },
      "name": "Veren Tallstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.02a39551fcf185c0816f": {
