    "hrHR": {
      "dialogue": {
        "02a39551fcf185c0816f": "Želim pogledati vašu robu.",
        "ad24eb60dd81c0aa130b": "Nijedan dio životinja koje lovimo ne propada.",
        "b15526429f5e13344748": "Podučite me.",
        "f6eb92612944fe3b710c": "Taureni su sinovi i kćeri Majke Zemlje i poštujemo svu njezinu djecu. Cijenimo čak i zvijeri koje ubijamo, jer nas njihova tijela hrane, a kože griju."
      },
      "name": "Veren Tallstrider",
      "translationMetadata": {
