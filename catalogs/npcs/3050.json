    "trTR": {
      "dialogue": {
        "02a39551fcf185c0816f": "Mallarına bakmak istiyorum.",
        "ad24eb60dd81c0aa130b": "Avladığımız hayvanların hiçbir parçası ziyan edilmez.",
        "b15526429f5e13344748": "Beni eğit.",
        "f6eb92612944fe3b710c": "Taurenler Toprak Ana’nın oğulları ve kızlarıdır; onun tüm çocuklarına saygı gösteririz. Öldürdüğümüz hayvanlara bile değer veririz, çünkü bedenleri bizi besler, derileri bizi ısıtır."
      },
      "name": "Veren Tallstrider",
