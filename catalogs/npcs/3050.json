    "frFR": {
      "dialogue": {
        "02a39551fcf185c0816f": "Je voudrais regarder vos articles.",
        "ad24eb60dd81c0aa130b": "Aucune partie des animaux que nous chassons n'est gaspillée.",
        "b15526429f5e13344748": "Entraînez-moi.",
        "f6eb92612944fe3b710c": "Les taurens sont les fils et les filles de la Mère de la Terre, et nous respectons tous ses enfants.  Même les bêtes que nous tuons sont chéries, car leur corps les nourrit et leur peau les réchauffe."
      },
      "name": "Veren Tallstrider",
