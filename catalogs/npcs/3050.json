    "plPL": {
      "dialogue": {
        "02a39551fcf185c0816f": "Chcę przejrzeć twoje towary.",
        "ad24eb60dd81c0aa130b": "Żadna część zwierząt, na które polujemy, się nie marnuje.",
        "b15526429f5e13344748": "Wyszkol mnie.",
        "f6eb92612944fe3b710c": "Taureni są synami i córkami Matki Ziemi, a my szanujemy wszystkie jej dzieci. Cenimy nawet zabijane przez nas zwierzęta, gdyż ich ciała dają nam pożywienie, a skóry ciepło."
      },
      "name": "Veren Tallstrider",
      "translationMetadata": {
