    "daDK": {
      "dialogue": {
        "02a39551fcf185c0816f": "Jeg vil gerne se dine varer.",
        "ad24eb60dd81c0aa130b": "Ingen del af de dyr, vi jager, går til spilde.",
        "b15526429f5e13344748": "Træn mig.",
        "f6eb92612944fe3b710c": "Tauren er Jordmoderens sønner og døtre, og vi viser respekt for alle hendes børn. Selv de dyr, vi dræber, værdsættes, for deres kroppe giver næring og deres skind varme."
      },
      "name": "Veren Tallstrider",
      "translationMetadata": {
        "fields": {
