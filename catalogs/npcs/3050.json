    "enUS": {
      "dialogue": {
        "02a39551fcf185c0816f": "I want to browse your goods.",
        "ad24eb60dd81c0aa130b": "No part of the animals we hunt is wasted. ",
        "b15526429f5e13344748": "Train me.",
        "f6eb92612944fe3b710c": "The tauren are sons and daughters of the Earthmother, and we show respect to all her children.  Even the beasts we slay are cherished, as their bodies give nourishment and their skins provide warmth."
      },
      "name": "Veren Tallstrider",
      "translationMetadata": {
