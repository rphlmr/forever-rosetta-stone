    "esES": {
      "dialogue": {
        "02a39551fcf185c0816f": "Quiero ver tus mercancías.",
        "ad24eb60dd81c0aa130b": "No desperdiciamos ninguna parte de los animales que cazamos.",
        "b15526429f5e13344748": "Entréname.",
        "f6eb92612944fe3b710c": "Los tauren son hijos e hijas de la Madre Tierra, y mostramos respeto a todos sus hijos.  Incluso las bestias que matamos son apreciadas, ya que sus cuerpos nos dan alimento y sus pieles nos proporcionan calor."
      },
      "name": "Veren Zancaalta",
      "translationMetadata": {
