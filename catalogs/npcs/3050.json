    "ptBR": {
      "dialogue": {
        "02a39551fcf185c0816f": "Quero ver suas mercadorias.",
        "ad24eb60dd81c0aa130b": "Nem sequer um pedaço dos animais que caçamos é desperdiçado.",
        "b15526429f5e13344748": "Treine-me.",
        "f6eb92612944fe3b710c": "Os taurens são filhos e filhas da Mãe Terra, e respeitamos todos os seus filhos. Até mesmo as feras que abatemos são estimadas, pois seus corpos nos alimentam e suas peles nos aquecem."
      },
      "name": "Veren Passo Alto",
      "translationMetadata": {
