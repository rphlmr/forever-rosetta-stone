    "svSE": {
      "dialogue": {
        "02a39551fcf185c0816f": "Jag vill se dina varor.",
        "ad24eb60dd81c0aa130b": "Ingen del av djuren vi jagar går till spillo.",
        "b15526429f5e13344748": "Träna mig.",
        "f6eb92612944fe3b710c": "Taurerna är Jordmoderns söner och döttrar, och vi visar alla hennes barn respekt. Även djuren vi dödar är värdefulla, för deras kroppar ger näring och deras skinn ger värme."
      },
      "name": "Veren Tallstrider",
