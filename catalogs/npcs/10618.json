    "trTR": {
      "dialogue": {
        "46a2ef5310efd603b3aa": "Mallarına bakmak istiyorum.",
        "abe15e22472292c56d33": "Merhaba yolcu. Buralarda beni pek az kişi bulur.$B$BBenim adım Rivern. Winterspring’in buz kılıçdişlerini binek olarak eğitiyorum.$B$BBu kediler tüm kılıçdişlerin en vahşi ve en zor evcilleştirilenleridir. Yalnızca en güvenilir ve saygın kişiler birine binmeyi deneyebilir.$B$BBöyle bir bineği herkese satmam; bunun için çalışmalı ve yalnızca benim değil, kılıçdişlerin de kabulünü kazanmalısın."
      },
      "name": "Rivern Frostwind",
      "translationMetadata": {
        "fields": {
          "dialogue.46a2ef5310efd603b3aa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.abe15e22472292c56d33": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
