            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "46a2ef5310efd603b3aa": "Я хочу переглянути ваші товари.",
        "abe15e22472292c56d33": "Вітаю, мандрівнику. Мало хто знаходить мене тут.$B$BМене звати Ріверн, і я навчаю зимокрайських морозних шаблезубів бути верховими тваринами.$B$BЦі коти — найдичавіші й найважчі для приборкання з усіх шаблезубів. Лише ті, хто здобув найбільшу довіру та шану, можуть спробувати осідлати одного.$B$BЯ не продам такого скакуна будь-кому; ти маєш заслужити його й здобути прихильність не лише мою, а й самих шаблезубів."
      },
      "name": "Риверн Криговій",
      "translationMetadata": {
        "fields": {
