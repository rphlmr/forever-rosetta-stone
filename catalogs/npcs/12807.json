    "daDK": {
      "dialogue": {
        "10127189f9ceef32c341": "Vis mig dit udvalg af grimoirer.",
        "1687ccc19fca875f2842": "Du er ikke en troldmand, og jeg har ikke tid til dig. Forsvind!",
        "3642d2ec4696e4191ea7": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted."
      },
      "name": "Greshka",
      "translationMetadata": {
