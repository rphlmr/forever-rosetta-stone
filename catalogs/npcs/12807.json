    "csCZ": {
      "dialogue": {
        "10127189f9ceef32c341": "Ukažte mi svou nabídku grimoárů.",
        "1687ccc19fca875f2842": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "3642d2ec4696e4191ea7": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě."
      },
      "name": "Greshka",
      "translationMetadata": {
        "fields": {
