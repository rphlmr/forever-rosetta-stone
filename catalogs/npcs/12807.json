      "dialogue": {
        "10127189f9ceef32c341": "Show me your selection of grimoires.",
        "1687ccc19fca875f2842": "You're no warlock and I've no time for you.  Begone!",
        "3642d2ec4696e4191ea7": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place."
      },
      "name": "Greshka",
      "subName": "Demon Master",
