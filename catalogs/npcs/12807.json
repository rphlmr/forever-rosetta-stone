    "deDE": {
      "dialogue": {
        "10127189f9ceef32c341": "Zeigt mir Eure Auswahl an Grimoires.",
        "1687ccc19fca875f2842": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "3642d2ec4696e4191ea7": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig."
      },
      "name": "Greshka",
      "subName": "Dämonenmeisterin",
