    "plPL": {
      "dialogue": {
        "89efe6b1a1d9512db959": "Co ta niegodna służka może dla ciebie zrobić, $N? Może szkolenie?",
        "9fbc4b9bac5a970f2f6b": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "fd5b5c6f7bce685bdcee": "Jeśli chcesz, poza szkoleniem mogę wymazać z twojego umysłu wiedzę o twoich talentach. Pamiętaj, że za każdym razem zabieg staje się trudniejszy, a przez to droższy."
      },
      "name": "Aelthalyste",
