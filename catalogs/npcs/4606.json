    "frFR": {
      "dialogue": {
        "89efe6b1a1d9512db959": "Que peut pour vous cet insignifiant serviteur, $N ? Vous entraîner peut-être ?",
        "9fbc4b9bac5a970f2f6b": "Je veux qu'on m'enseigne la voie des prêtres.",
        "fd5b5c6f7bce685bdcee": "Si vous le voulez, en plus de l'enseignement que je propose, j'ai le pouvoir de faire disparaître de votre esprit la connaissance de vos talents. Sachez qu'à chaque fois que vous subissez cette procédure elle est plus difficile à accomplir, et donc plus onéreuse."
      },
      "name": "Aelthalyste",
      "subName": "Maître des prêtres",
