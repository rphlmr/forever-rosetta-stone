    "daDK": {
      "dialogue": {
        "89efe6b1a1d9512db959": "Hvad kan denne ubetydelige tjener gøre for dig, $N? Træning, måske?",
        "9fbc4b9bac5a970f2f6b": "Jeg søger mere træning i præsternes kunst.",
        "fd5b5c6f7bce685bdcee": "Hvis du ønsker det, kan jeg ud over træning også slette kendskabet til dine talenter fra dit sind. Vær advaret om, at proceduren bliver sværere og derfor dyrere, hver gang den udføres."
      },
      "name": "Aelthalyste",
      "translationMetadata": {
        "fields": {
          "dialogue.89efe6b1a1d9512db959": {
