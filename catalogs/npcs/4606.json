    "enUS": {
      "dialogue": {
        "89efe6b1a1d9512db959": "What can this insignificant servant do for you, $N? Training perhaps?",
        "9fbc4b9bac5a970f2f6b": "I seek more training in the priestly ways.",
        "fd5b5c6f7bce685bdcee": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes."
      },
      "name": "Aelthalyste",
      "subName": "Priest Trainer",
      "translationMetadata": {
