    "hrHR": {
      "dialogue": {
        "89efe6b1a1d9512db959": "Što ova neznatna službenica može učiniti za tebe, $N? Možda obuka?",
        "9fbc4b9bac5a970f2f6b": "Tražim daljnju poduku u svećeničkom umijeću.",
        "fd5b5c6f7bce685bdcee": "Ako želiš, osim obuke mogu ti iz uma izbrisati znanje o tvojim talentima. Imaj na umu da je postupak svaki put sve teži, a time i skuplji."
      },
      "name": "Aelthalyste",
