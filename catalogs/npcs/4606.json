  "locales": {
    "csCZ": {
      "dialogue": {
        "89efe6b1a1d9512db959": "Co pro tebe může tato bezvýznamná služebnice udělat, $N? Snad výcvik?",
        "9fbc4b9bac5a970f2f6b": "Hledám další výcvik v kněžském umění.",
        "fd5b5c6f7bce685bdcee": "Pokud si přeješ, mohu ti kromě výcviku vymazat z mysli znalost tvých talentů. Věz však, že každé další provedení je těžší, a proto také dražší."
      },
      "name": "Aelthalyste",
      "translationMetadata": {
        "fields": {
          "dialogue.89efe6b1a1d9512db959": {
