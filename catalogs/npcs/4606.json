    "esES": {
      "dialogue": {
        "89efe6b1a1d9512db959": "¿Qué puede hacer esta insignificante servidora por ti, $N? ¿Entrenamiento, quizás?",
        "9fbc4b9bac5a970f2f6b": "Busco más instrucción en el camino del sacerdote.",
        "fd5b5c6f7bce685bdcee": "Si lo deseas, además de la instrucción, tengo el poder de borrar el conocimiento de tus talentos de tu mente. Te advierto que cada vez que realizas este proceso es más difícil y, por lo tanto, es más caro."
      },
      "name": "Aelthalyste",
      "subName": "Instructor de sacerdotes",
