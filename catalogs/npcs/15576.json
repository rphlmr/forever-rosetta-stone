    "plPL": {
      "dialogue": {
        "29561a20cc2d589f753e": "Starszy Rumblerock spędza lata w jaskini na szczycie Dreadmaul Rock w Burning Steppes.",
        "2bac7604ae88addacd07": "Dawno temu żyliśmy dla łowów. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest tak inaczej?",
        "77389783717cf2e52f41": "Ostatnio słyszałem, że starszy Starsong przebywa w Zatopionej Świątyni na Bagnach Smutku.",
        "ba4bdeef828d1f1a1b06": "Starszego Starglade znajdziesz przed bramami Zul’Gurubu w Stranglethorn Vale.",
        "f38ee0dca33efa1d54c2": "Starszy Skychaser spogląda na Westfall ze szczytu Sentinel Hill."
      },
      "name": "Starszy Winterhoof",
