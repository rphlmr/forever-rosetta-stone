    "svSE": {
      "dialogue": {
        "29561a20cc2d589f753e": "Äldste Rumblerock tillbringar åren i en grotta på toppen av Dreadmaul Rock i Burning Steppes.",
        "2bac7604ae88addacd07": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "77389783717cf2e52f41": "Senast jag hörde var äldste Starsong i det sjunkna templet i Swamp of Sorrows.",
        "ba4bdeef828d1f1a1b06": "Du hittar äldste Starglade utanför Zul’Gurubs portar i Stranglethorn Vale.",
        "f38ee0dca33efa1d54c2": "Äldste Skychaser blickar ut över Westfall från toppen av Sentinel Hill."
      },
      "name": "Äldste Winterhoof",
