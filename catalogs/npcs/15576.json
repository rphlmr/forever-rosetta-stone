    "daDK": {
      "dialogue": {
        "29561a20cc2d589f753e": "Ældste Rumblerock tilbringer årene i en hule på toppen af Dreadmaul Rock i Burning Steppes.",
        "2bac7604ae88addacd07": "For længe siden levede vi for jagten. Vi jagede for ære og hæder...$B$BEr det så anderledes nu?",
        "77389783717cf2e52f41": "Sidst jeg hørte det, var ældste Starsong i det sunkne tempel i Swamp of Sorrows.",
        "ba4bdeef828d1f1a1b06": "Du finder ældste Starglade uden for Zul’Gurubs porte i Stranglethorn Vale.",
        "f38ee0dca33efa1d54c2": "Ældste Skychaser skuer ud over Westfall fra toppen af Sentinel Hill."
      },
      "name": "Ældste Winterhoof",
      "translationMetadata": {
