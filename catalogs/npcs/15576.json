  "locales": {
    "csCZ": {
      "dialogue": {
        "29561a20cc2d589f753e": "Stařešina Rumblerock tráví léta v jeskyni na vrcholu Dreadmaul Rock v Burning Steppes.",
        "2bac7604ae88addacd07": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "77389783717cf2e52f41": "Naposledy jsem slyšel, že stařešina Starsong je v Potopeném chrámu v Swamp of Sorrows.",
        "ba4bdeef828d1f1a1b06": "Stařešinu Starglade najdeš před branami Zul’Gurubu v Stranglethorn Vale.",
        "f38ee0dca33efa1d54c2": "Stařešina Skychaser shlíží na Westfall z vrcholu Sentinel Hill."
      },
      "name": "Starší Winterhoof",
