    "trTR": {
      "dialogue": {
        "29561a20cc2d589f753e": "Yaşlı Rumblerock, Burning Steppes’teki Dreadmaul Rock’ın tepesinde bir mağarada yıllarını geçiriyor.",
        "2bac7604ae88addacd07": "Çok eski günlerde av için yaşardık. Şan için, onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "77389783717cf2e52f41": "Son bildiğim kadarıyla Yaşlı Starsong, Swamp of Sorrows’taki Batık Tapınak’taydı.",
        "ba4bdeef828d1f1a1b06": "Yaşlı Starglade’i Stranglethorn Vale’deki Zul’Gurub kapılarının dışında bulabilirsin.",
        "f38ee0dca33efa1d54c2": "Yaşlı Skychaser, Sentinel Hill’in tepesinden Westfall’u seyrediyor."
      },
      "name": "Ulu Winterhoof",
