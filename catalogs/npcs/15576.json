    "hrHR": {
      "dialogue": {
        "29561a20cc2d589f753e": "Starješina Rumblerock provodi godine u špilji na vrhu Dreadmaul Rocka u Burning Steppes.",
        "2bac7604ae88addacd07": "U davna vremena živjeli smo za lov. Lovili smo radi slave, radi časti...$B$BZar je sada toliko drukčije?",
        "77389783717cf2e52f41": "Koliko znam, starješina Starsong bio je u Potopljenom hramu u Swamp of Sorrows.",
        "ba4bdeef828d1f1a1b06": "Starješinu Starglade pronaći ćeš pred vratima Zul’Guruba u Stranglethorn Valeu.",
        "f38ee0dca33efa1d54c2": "Starješina Skychaser promatra Westfall s vrha Sentinel Hilla."
      },
      "name": "Starješina Winterhoof",
