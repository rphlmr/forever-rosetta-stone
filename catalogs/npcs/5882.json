    "plPL": {
      "dialogue": {
        "27aea2ac548f1e58462f": "Witaj, $c. Czy przybywasz, by poznać tajemne sztuki?",
        "2d84b3815bb6f2c0b1df": "Witaj, $c. Żal mi twojego rodzaju, gdyż sekrety prawdziwej magii są poza waszym zasięgiem...",
        "bf592d278d6c79755148": "Poprzez rygorystyczne przeszkolenie musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mogła uczyć ich od nowa. Usługa, którą oferuję, staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne przeszkolenie jest droższe. Czy chcesz, abym oduczyła cię poznanych talentów?",
        "dd8392754979808d3455": "Interesuje mnie szkolenie maga.",
        "ee64a5722eb9fd383575": "Interesuje mnie szkolenie maga."
      },
      "name": "Pephredo",
