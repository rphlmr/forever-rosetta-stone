  "locales": {
    "csCZ": {
      "dialogue": {
        "27aea2ac548f1e58462f": "Zdravím, $c. Přišel ses učit skrytým uměním?",
        "2d84b3815bb6f2c0b1df": "Zdravím, $c. Je mi líto tvého druhu, neboť tajemství skutečné magie jsou nad vaše síly...",
        "bf592d278d6c79755148": "Přísným přeučováním jsem musela mnohé žáky odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je s každým opakováním náročnější. Proto je každé další přeučení dražší. Přeješ si, abych tě odnaučila talentům, které sis osvojil?",
        "dd8392754979808d3455": "Mám zájem o výcvik mága.",
        "ee64a5722eb9fd383575": "Mám zájem o výcvik mága."
      },
      "name": "Pephredo",
      "translationMetadata": {
        "fields": {
