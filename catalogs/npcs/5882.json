    "ltLT": {
      "dialogue": {
        "27aea2ac548f1e58462f": "Sveiki, $c.  Ar atvykote mokytis slaptųjų menų?",
        "2d84b3815bb6f2c0b1df": "Sveiki, $c.  Man gaila tokių kaip jūs, nes tikrosios magijos paslaptys jums nepasiekiamos...",
        "bf592d278d6c79755148": "Griežtai permokydama ne vieną mokinį turėjau atpratinti nuo visko, ką jis buvo išmokęs, kad galėčiau mokyti iš naujo.  Kaskart suteikti šią paslaugą darosi vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar norite, kad padėčiau jums pamiršti išmoktus talentus?",
        "dd8392754979808d3455": "Norėčiau mokytis magijos.",
        "ee64a5722eb9fd383575": "Norėčiau mokytis magijos."
      },
      "name": "Pephredo",
      "subName": "Magų mokytoja",
