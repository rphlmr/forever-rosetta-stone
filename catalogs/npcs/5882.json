    "daDK": {
      "dialogue": {
        "27aea2ac548f1e58462f": "Hilsen, $c. Er du her for at lære de skjulte kunster?",
        "2d84b3815bb6f2c0b1df": "Hilsen, $c. Jeg har medlidenhed med din slags, for sand magis hemmeligheder er uden for jeres rækkevidde...",
        "bf592d278d6c79755148": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere for hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "dd8392754979808d3455": "Jeg er interesseret i magikertræning.",
        "ee64a5722eb9fd383575": "Jeg er interesseret i magikertræning."
      },
      "name": "Pephredo",
      "translationMetadata": {
