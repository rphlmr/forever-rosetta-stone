    "hrHR": {
      "dialogue": {
        "27aea2ac548f1e58462f": "Pozdrav, $c. Jesi li ovdje učiti skrivene vještine?",
        "2d84b3815bb6f2c0b1df": "Pozdrav, $c. Žalim tvoju vrstu, jer tajne prave magije izvan su vašeg dosega...",
        "bf592d278d6c79755148": "Strogom sam preobukom morala mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla poučiti iznova. Uslugu koju nudim sve je teže izvesti svaki sljedeći put. Zato je svaka preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "dd8392754979808d3455": "Zanima me obuka za maga.",
        "ee64a5722eb9fd383575": "Zanima me obuka za maga."
      },
      "name": "Pephredo",
