    "ptBR": {
      "dialogue": {
        "27aea2ac548f1e58462f": "Saudações, $c. Está aqui para aprender as artes ocultas?",
        "2d84b3815bb6f2c0b1df": "Saudações, $c. Tenho pena de tipos como você, pois os segredos da magia verdadeira lhe são inalcançáveis...",
        "bf592d278d6c79755148": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "dd8392754979808d3455": "Tenho interesse em treinamento de mago.",
        "ee64a5722eb9fd383575": "Tenho interesse em treinamento de mago."
      },
      "name": "Pefreda",
      "subName": "Treinamento de Magos",
