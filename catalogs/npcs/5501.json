    "hrHR": {
      "dialogue": {
        "05403b84f581bd651f72": "Dobro došao u Cenarionski krug, $c. Kako ti mogu pomoći?",
        "61a8158407fcff169bce": "Strogim prekvalificiranjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Usluga koju nudim svaki put postaje sve teža. Zato je svaka sljedeća prekvalifikacija skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "9fb633a0b085855fdaaf": "Želim trenirati.",
        "faff7ebb3cdf676a9ddf": "Ne mogu obučavati nekoga poput tebe, $c.",
        "fecd1f75ee447aba9ce5": "Što mogu učiniti za tebe, dijete moje?"
      },
      "name": "Kaerbrus",
