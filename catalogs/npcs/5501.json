  "locales": {
    "csCZ": {
      "dialogue": {
        "05403b84f581bd651f72": "Vítej v Cenarionském kruhu, $c. Jak ti mohu pomoci?",
        "61a8158407fcff169bce": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým dalším provedením obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "9fb633a0b085855fdaaf": "Chtěl bych trénovat.",
        "faff7ebb3cdf676a9ddf": "Nemohu cvičit někoho jako $c.",
        "fecd1f75ee447aba9ce5": "Co pro tebe mohu udělat, dítě?"
      },
      "name": "Kaerbrus",
      "translationMetadata": {
        "fields": {
