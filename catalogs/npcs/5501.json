    "daDK": {
      "dialogue": {
        "05403b84f581bd651f72": "Velkommen til Cenarion Circle, $c. Hvordan kan jeg hjælpe dig?",
        "61a8158407fcff169bce": "Gennem streng omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang, den udføres. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg aflærer dig de talenter, du har lært?",
        "9fb633a0b085855fdaaf": "Jeg vil gerne trænes.",
        "faff7ebb3cdf676a9ddf": "Jeg kan ikke træne en $c som dig.",
        "fecd1f75ee447aba9ce5": "Hvad kan jeg gøre for dig, mit barn?"
      },
      "name": "Kaerbrus",
      "translationMetadata": {
        "fields": {
