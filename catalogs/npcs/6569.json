    "daDK": {
      "dialogue": {
        "d3677432979f28fd3c31": "Jeg vil gerne se dine varer.",
        "dabcba6165ab5211e9a9": "Træn mig.",
        "e41c1d5322a33ae1ff12": "Hvor trogger og spedalske gnomer strejfer omkring, ligger vores hjem: Gnomeregan.$B$BVores familier er tabt, vores hjem forladt. Vi er spredt.$B$BÅh, hvor jeg længes efter det sorgløse liv i Gnomeregan, men den tid er forbi. Vi må gøre modstand! Vi må redde Gnomeregan!"
      },
      "name": "Gnoarn",
      "translationMetadata": {
        "fields": {
          "dialogue.d3677432979f28fd3c31": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
