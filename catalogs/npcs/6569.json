    "hrHR": {
      "dialogue": {
        "d3677432979f28fd3c31": "Želim pogledati vašu robu.",
        "dabcba6165ab5211e9a9": "Podučite me.",
        "e41c1d5322a33ae1ff12": "Ondje gdje lutaju troggovi i gubavi gnomovi stoji naš dom, Gnomeregan.$B$BIzgubili smo obitelji i domove. Raspršeni smo.$B$BO, kako čeznem za bezbrižnim životom u Gnomereganu, ali ti su dani prošli. Moramo se oduprijeti! Moramo spasiti Gnomeregan!"
      },
      "name": "Gnoarn",
