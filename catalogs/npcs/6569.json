    "enUS": {
      "dialogue": {
        "d3677432979f28fd3c31": "I want to browse your goods.",
        "dabcba6165ab5211e9a9": "Train me.",
        "e41c1d5322a33ae1ff12": "Where Troggs and Leper Gnomes roam stands our home - Gnomeregan.$B$BOur families lost, our homes displaced. Scattered.$B$BOh how I long for the days of carefree Gnomeregan life, but those days are no more. We must make our stand! We must save Gnomeregan!"
      },
      "name": "Gnoarn",
      "translationMetadata": {
        "fields": {
