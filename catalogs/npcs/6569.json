  "locales": {
    "csCZ": {
      "dialogue": {
        "d3677432979f28fd3c31": "Chci si prohlédnout vaše zboží.",
        "dabcba6165ab5211e9a9": "Vycvičte mě.",
        "e41c1d5322a33ae1ff12": "Tam, kde se potulují troggové a malomocní gnómové, stojí náš domov — Gnomeregan.$B$BPřišli jsme o rodiny, o domovy. Byli jsme rozptýleni.$B$BJak toužím po dnech bezstarostného života v Gnomereganu, ale ty jsou pryč. Musíme se postavit na odpor! Musíme Gnomeregan zachránit!"
      },
      "name": "Gnoarn",
      "translationMetadata": {
        "fields": {
          "dialogue.d3677432979f28fd3c31": {
