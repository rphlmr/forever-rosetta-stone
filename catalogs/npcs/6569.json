    "esES": {
      "dialogue": {
        "d3677432979f28fd3c31": "Quiero ver tus mercancías.",
        "dabcba6165ab5211e9a9": "Entréname.",
        "e41c1d5322a33ae1ff12": "Donde vagan troggs y gnomos leprosos está nuestro hogar - Gnomeregan.\n\nOnuestras familias perdidas, nuestros hogares desplazados. Dispersos.\n\nOh cómo añoro los días de la despreocupada vida en Gnomeregan, pero esos días ya no existen. ¡Debemos resistir! ¡Debemos salvar Gnomeregan!"
      },
      "name": "Gnoarn",
      "translationMetadata": {
