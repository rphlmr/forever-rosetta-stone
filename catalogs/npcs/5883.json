    "ltLT": {
      "dialogue": {
        "257da1337b0b8013f251": "Griežtai permokydama turėjau priversti daugelį mokinių pamiršti visa, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart tai padaryti darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad priversčiau tave pamiršti išmoktus talentus?",
        "402232199e7ab75827d8": "Sveiki, $c. Ar atėjai mokytis slaptųjų menų?",
        "6469373ae30df46a3dac": "Sveiki, $c. Gailiuosi tokių kaip tu, nes tikrosios magijos paslaptys jums nepasiekiamos...",
        "7d8b2efd08d86b0f2a0c": "Norėčiau mokytis magijos.",
        "a872b229c81ecf224493": "Norėčiau mokytis magijos."
