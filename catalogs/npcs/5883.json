    "hrHR": {
      "dialogue": {
        "257da1337b0b8013f251": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Tu je uslugu svaki put sve teže pružiti. Zato je svaka sljedeća preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "402232199e7ab75827d8": "Pozdrav, $c. Jesi li ovdje kako bi učio o skrivenim vještinama?",
        "6469373ae30df46a3dac": "Pozdrav, $c. Žalim tvoju vrstu, jer tajne prave magije nisu vam dostupne...",
        "7d8b2efd08d86b0f2a0c": "Zanima me obuka za maga.",
        "a872b229c81ecf224493": "Zanima me obuka za maga."
      },
      "name": "Enyo",
