  "locales": {
    "csCZ": {
      "dialogue": {
        "257da1337b0b8013f251": "Přísným přeškolováním jsem musel mnoho studentů odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "402232199e7ab75827d8": "Zdravím, $c. Přicházíš poznat skrytá umění?",
        "6469373ae30df46a3dac": "Zdravím, $c. Lituji tvého druhu, neboť tajemství pravé magie jsou mimo tvůj dosah...",
        "7d8b2efd08d86b0f2a0c": "Mám zájem o výcvik mága.",
        "a872b229c81ecf224493": "Mám zájem o výcvik mága."
      },
      "name": "Enyo",
      "translationMetadata": {
