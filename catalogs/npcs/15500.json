            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "Dieser Krieg ist noch lange nicht vorbei, er hat gerade erst begonnen. Unsere tapferen Männer und Frauen kämpfen Tag und Nacht hinter den Mauern von Ahn'Qiraj, $n. Es wird nicht mehr lange dauern, bis die Stadt der Qiraji fällt."
      },
      "name": "Keyl Swiftclaw",
      "translationMetadata": {
        "fields": {
          "dialogue.73a1f1d6dce2efdfecc5": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
