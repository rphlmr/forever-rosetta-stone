    },
    "daDK": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "Denne krig er ikke forbi, den er kun lige begyndt! Vores modige mænd og kvinder kæmper mod fjenden inde i Ahn'Qiraj dag og nat, $n. Der går ikke længe, før qiraji-byen falder."
      },
      "name": "Keyl Swiftclaw",
      "translationMetadata": {
        "fields": {
          "dialogue.73a1f1d6dce2efdfecc5": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
