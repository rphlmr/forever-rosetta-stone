      }
    },
    "ptBR": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "Esta guerra só está começando, $n! Temos homens e mulheres valorosos lutando contra o inimigo em Ahn'Qiraj noite e dia. A queda dos qirajis está próxima."
      },
