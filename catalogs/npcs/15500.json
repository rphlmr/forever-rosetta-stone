    "plPL": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "Ta wojna się nie skończyła, ona dopiero się zaczęła! Nasi dzielni wojownicy i wojowniczki walczą z wrogiem w Ahn'Qiraj dniem i nocą, $n. Miasto qirajów wkrótce padnie."
      },
      "name": "Keyl Swiftclaw",
      "translationMetadata": {
        "fields": {
