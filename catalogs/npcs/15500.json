    "hrHR": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "Ovaj rat nije gotov, tek je počeo! Naši se hrabri muškarci i žene danonoćno bore protiv neprijatelja unutar Ahn'Qiraja, $n. Neće proći dugo prije nego što grad qiraja padne."
      },
      "name": "Keyl Swiftclaw",
      "translationMetadata": {
        "fields": {
