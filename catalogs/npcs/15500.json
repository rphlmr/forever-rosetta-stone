          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "This war's not over, it's only just begun!  We have brave men and women fighting our enemy inside Ahn'Qiraj day and night, $n.  It won't be long before the Qiraji city falls."
      },
      "name": "Keyl Swiftclaw",
      "translationMetadata": {
        "fields": {
          "dialogue.73a1f1d6dce2efdfecc5": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
