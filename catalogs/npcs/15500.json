          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "¡Esta guerra no ha acabado sino que no ha hecho más que comenzar! Contamos con valientes hombres y mujeres que luchan día y noche contra el enemigo en el interior de Ahn'Qiraj, $N. La ciudad de Ahn'Qiraj no tardará mucho en caer."
      },
      "name": "Keyl Patacerce",
      "translationMetadata": {
