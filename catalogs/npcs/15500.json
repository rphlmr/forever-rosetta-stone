  "locales": {
    "csCZ": {
      "dialogue": {
        "73a1f1d6dce2efdfecc5": "Tahle válka neskončila, teprve začala! Naši stateční muži a ženy bojují ve dne v noci s nepřítelem uvnitř Ahn'Qiraje, $n. Město qirajů brzy padne."
      },
      "name": "Keyl Swiftclaw",
      "translationMetadata": {
        "fields": {
