    "plPL": {
      "dialogue": {
        "0894aae8d1eba9d19960": "Chcę przejrzeć twoje towary.",
        "4a88062885b4216c27d9": "Ciemność otaczająca nasze ziemie wielokrotnie wystawi cię na próbę, $N. Aby zapewnić ci gotowość, będziemy często powierzać ci zadania, które pozwolą ci osiągnąć pełnię mocy.$B$BIdź ze Światłością i trwaj w cnocie.",
        "b25d591ac00e52f71416": "Wyszkol mnie."
      },
      "name": "Duthorian Rall",
