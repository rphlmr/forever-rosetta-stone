    "hrHR": {
      "dialogue": {
        "0894aae8d1eba9d19960": "Želim pogledati vašu robu.",
        "4a88062885b4216c27d9": "Tama koja okružuje naše zemlje mnogo će te puta staviti na kušnju, $N. Kako bismo osigurali da uvijek budeš spreman, često ćemo ti zadavati zadatke da dosegneš vrhunac svoje moći.$B$BIdi sa Svjetlom i ostani čestit.",
        "b25d591ac00e52f71416": "Podučite me."
      },
      "name": "Duthorian Rall",
      "translationMetadata": {
