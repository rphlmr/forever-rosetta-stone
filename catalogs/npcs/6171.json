    "trTR": {
      "dialogue": {
        "0894aae8d1eba9d19960": "Mallarına bakmak istiyorum.",
        "4a88062885b4216c27d9": "Topraklarımızı çevreleyen karanlık seni birçok kez sınayacak, $N. Her zaman hazır olmanı sağlamak için gücünün doruğuna ulaşacağın görevler vermeye devam edeceğiz.$B$BIşık seninle olsun ve erdemli kal.",
        "b25d591ac00e52f71416": "Beni eğit."
      },
      "name": "Duthorian Rall",
