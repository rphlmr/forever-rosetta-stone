    "daDK": {
      "dialogue": {
        "0894aae8d1eba9d19960": "Jeg vil gerne se dine varer.",
        "4a88062885b4216c27d9": "Mørket, som omgiver vores lande, vil sætte dig på prøve mange gange, $N. For at sikre, at du altid er beredt, vil vi ofte give dig opgaver, så du kan nå højden af din styrke.$B$BGå med Lyset og forbliv dydig.",
        "b25d591ac00e52f71416": "Træn mig."
      },
      "name": "Duthorian Rall",
      "translationMetadata": {
