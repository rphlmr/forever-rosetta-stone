  "locales": {
    "csCZ": {
      "dialogue": {
        "0894aae8d1eba9d19960": "Ukažte mi prosím své zboží.",
        "4a88062885b4216c27d9": "Temnota obklopující naše země tě mnohokrát vystaví zkoušce, $N. Abychom zajistili tvou připravenost, budeme ti často zadávat úkoly, díky nimž dosáhneš vrcholu svých sil.$B$BJdi se Světlem a zůstaň ctnostný.",
        "b25d591ac00e52f71416": "Vycvičte mě."
      },
      "name": "Duthorian Rall",
      "translationMetadata": {
