  "locales": {
    "csCZ": {
      "dialogue": {
        "2ffbd45d0abf7a4bfc89": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talenty, které sis osvojil?",
        "659d789e74aca550a238": "Nauč mě cestám duchů.",
        "b4805cbe2cdeab1037bf": "Duchové tě ke mně přivedli. Jak ti mohu pomoci?",
        "f506844a7a0f13b3122a": "Ať jsou duchové s tebou."
      },
      "name": "Meela Dawnstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.2ffbd45d0abf7a4bfc89": {
