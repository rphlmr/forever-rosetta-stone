    "hrHR": {
      "dialogue": {
        "2ffbd45d0abf7a4bfc89": "Strogim preobučavanjem morala sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogla podučiti iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako preobučavanje stoji sve više. Želiš li da te odviknem od talenata koje si naučio?",
        "659d789e74aca550a238": "Nauči me putovima duhova.",
        "b4805cbe2cdeab1037bf": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "f506844a7a0f13b3122a": "Neka duhovi budu s tobom."
      },
      "name": "Meela Dawnstrider",
      "translationMetadata": {
