    "plPL": {
      "dialogue": {
        "65c7c06a7ca5db59fe62": "Co? Ale jak? Nie! To niemożliwe! Byłem tak ostrożny... nie mógł wiedzieć!$B$BKłamiesz! Kłamiesz i teraz umrzesz za swoje oszustwo!",
        "7ac7bdb4acc8ed4a2723": "... Wiadomość od Banehollowa? Jaka wiadomość? Czy potrzebuje swojego wielkiego doradcy i sługi, Ulatheka? Czy wzywa mnie do siebie?",
        "c51e3ffac9a54f06874e": "Precz! Naradzam się z władcami strachu, a nasze sprawy cię nie dotyczą!"
      },
      "name": "Ulathek",
      "translationMetadata": {
