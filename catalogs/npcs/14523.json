            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "65c7c06a7ca5db59fe62": "Was? Aber wie? Nein! Das ist nicht möglich! Ich war so vorsichtig... er konnte es nicht wissen!\n\nIhr lügt! Ihr lügt und Ihr werdet für diese Täuschung sterben!",
        "7ac7bdb4acc8ed4a2723": "...Eine Nachricht von Banehollow? Was für eine Nachricht ist das? Braucht er die Hilfe seines großen Beraters und Dieners Ulathek? Fordert er mein Erscheinen?",
        "c51e3ffac9a54f06874e": "Verschwindet! Ich berate mich mit den Schreckenslords und unsere Angelegenheiten gehen Euch nichts an!"
      },
      "name": "Ulathek",
      "translationMetadata": {
        "fields": {
          "dialogue.65c7c06a7ca5db59fe62": {
            "origin": "community",
            "source": "Spoken",
