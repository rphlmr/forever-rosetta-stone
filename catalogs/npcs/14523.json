    "ltLT": {
      "dialogue": {
        "65c7c06a7ca5db59fe62": "Ką?  Bet kaip?  Ne!  Tai neįmanoma!  Buvau toks atsargus... jis negalėjo sužinoti!$B$BTu meluoji!  Meluoji, ir dabar mirsi už savo klastą!",
        "7ac7bdb4acc8ed4a2723": "... Žinia nuo Banehollow?  Kokia žinia?  Ar jam reikia savo didžiojo patarėjo ir tarno Ulathek?  Ar jis reikalauja mano buvimo?",
        "c51e3ffac9a54f06874e": "Dink!  Tariuosi su Dreadlords, ir mūsų aptariami reikalai tavęs neliečia!"
      },
      "name": "Ulathek",
      "translationMetadata": {
