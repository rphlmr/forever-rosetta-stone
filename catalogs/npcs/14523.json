  "locales": {
    "csCZ": {
      "dialogue": {
        "65c7c06a7ca5db59fe62": "Cože? Ale jak? Ne! To není možné! Byl jsem tak opatrný... nemohl to vědět!$B$BLžeš! Lžeš a za svůj podvod teď zemřeš!",
        "7ac7bdb4acc8ed4a2723": "... Zpráva od Banehollowa? Jaká zpráva? Potřebuje svého velkého rádce a služebníka Ulatheka? Žádá si mou přítomnost?",
        "c51e3ffac9a54f06874e": "Zmiz! Radím se s pány děsu a záležitosti, o kterých mluvíme, se tě netýkají!"
      },
      "name": "Ulathek",
      "translationMetadata": {
        "fields": {
          "dialogue.65c7c06a7ca5db59fe62": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.7ac7bdb4acc8ed4a2723": {
