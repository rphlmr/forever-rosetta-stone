    "enUS": {
      "dialogue": {
        "65c7c06a7ca5db59fe62": "What?  But how?  No!  This is not possible!  I have been so careful... he could not know!$B$BYou lie!  You lie, and now you'll die for your deceit!",
        "7ac7bdb4acc8ed4a2723": "... A message from Banehollow?  What message is that?  Does he have need of his great advisor and servant, Ulathek?  Does he require my presence?",
        "c51e3ffac9a54f06874e": "Be gone!  I hold counsel with Dreadlords, and the matters we discuss are not your concern!"
      },
      "name": "Ulathek",
      "translationMetadata": {
        "fields": {
