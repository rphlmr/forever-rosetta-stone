        }
      }
    },
    "daDK": {
      "dialogue": {
        "65c7c06a7ca5db59fe62": "Hvad? Men hvordan? Nej! Det er ikke muligt! Jeg har været så forsigtig... han kunne ikke vide det!$B$BDu lyver! Du lyver, og nu skal du dø for dit bedrag!",
        "7ac7bdb4acc8ed4a2723": "... En besked fra Banehollow? Hvilken besked? Har han brug for sin store rådgiver og tjener, Ulathek? Kræver han min tilstedeværelse?",
        "c51e3ffac9a54f06874e": "Forsvind! Jeg rådfører mig med rædselsfyrster, og det, vi drøfter, kommer ikke dig ved!"
      },
      "name": "Ulathek",
      "translationMetadata": {
        "fields": {
          "dialogue.65c7c06a7ca5db59fe62": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
