    "daDK": {
      "dialogue": {
        "cb1b53100133a409948f": "Jeg søger undervisning i at ride på et ridedyr.",
        "cc597cb470a11e798f28": "Jeg kan lære dig tigeridningens finesser, hvis du har guld nok til at betale for undervisningen!",
        "f38a38dd89232293da61": "Du skal være exalted hos natteelverne i Darnassus, før jeg lærer dig at ride, $c."
      },
      "name": "Jartsam",
      "translationMetadata": {
