    "enUS": {
      "dialogue": {
        "cb1b53100133a409948f": "I seek training to ride a steed.",
        "cc597cb470a11e798f28": "I can teach you the finer points of Tiger Riding, provided you have enough gold to cover the lesson!",
        "f38a38dd89232293da61": "You need to be exalted with the night elves of Darnassus before I will teach you a riding skill, $c."
      },
      "name": "Jartsam",
      "subName": "Nightsaber Riding Instructor",
