  "locales": {
    "csCZ": {
      "dialogue": {
        "cb1b53100133a409948f": "Hledám výcvik v jízdě na jezdeckém zvířeti.",
        "cc597cb470a11e798f28": "Mohu tě naučit jemnosti jízdy na tygrovi, pokud máš dost zlata na zaplacení výuky!",
        "f38a38dd89232293da61": "Než tě naučím jezdeckému umění, musíš mít u nočních elfů z Darnassu pověst exalted, $c."
      },
      "name": "Jartsam",
      "translationMetadata": {
        "fields": {
