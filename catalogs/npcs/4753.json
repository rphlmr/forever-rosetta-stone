    "deDE": {
      "dialogue": {
        "cb1b53100133a409948f": "Ich suche eine Ausbildung im Reiten.",
        "cc597cb470a11e798f28": "Ich kann Euch die Feinheiten des Tigerreitens beibringen, vorausgesetzt, Ihr habt genug Gold, um die Stunde zu bezahlen!",
        "f38a38dd89232293da61": "Die Nachtelfen von Darnassus müssen Euch mit Ehrfurcht begegnen, bevor ich Euch eine Reitfertigkeit lehre, $C."
      },
      "name": "Jartsam",
      "subName": "Nachtsäblerreitlehrer",
