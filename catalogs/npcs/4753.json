    "ltLT": {
      "dialogue": {
        "cb1b53100133a409948f": "Noriu išmokti joti.",
        "cc597cb470a11e798f28": "Galiu išmokyti tave jojimo tigrais subtilybių, jei turi pakankamai aukso pamokai apmokėti!",
        "f38a38dd89232293da61": "Prieš mokydamas tave joti, turiu žinoti, kad esi pelnęs Darnaso naktinių elfų išaukštinimą, $c."
      },
      "name": "Jartsam",
      "subName": "Jojimo naktiniais kardadančiais instruktorius",
