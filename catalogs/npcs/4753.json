    "itIT": {
      "dialogue": {
        "cb1b53100133a409948f": "Cerco un addestramento per cavalcare una cavalcatura.",
        "cc597cb470a11e798f28": "Posso insegnarti i segreti del Tiger Riding, se hai abbastanza oro per pagare la lezione!",
        "f38a38dd89232293da61": "Devi essere exalted presso gli elfi della notte di Darnassus prima che io ti insegni a cavalcare, $C."
      },
      "name": "Jartsam",
