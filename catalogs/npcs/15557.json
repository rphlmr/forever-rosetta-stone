    "daDK": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "a426b7587f4b14cbbbb4": "Winterhoof? Jeg hører, at han nyder livet i Booty Bay.",
        "df8cd496a62ca26bd336": "Ældste Stormbrow er højst sandsynligt i landsbyen Goldshire i Elwynn Forest.",
        "f91fc2c957a91cb625c6": "Ældste Hammershout findes inden for Stormwinds mure.",
        "fbc7538b3bc091d64e58": "Ældste Dawnstrider findes ved Flame Crest i Burning Steppes."
      },
      "name": "Ældste Rumblerock",
