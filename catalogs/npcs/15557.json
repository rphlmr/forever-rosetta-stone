    "plPL": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Nastał czas, gdy rok jest nowy, a księżyc jasno świeci.$B$BTo nasz czas... gdy budzą się pradawni.",
        "a426b7587f4b14cbbbb4": "Winterhoof? Słyszałem, że świetnie się bawi w Booty Bay.",
        "df8cd496a62ca26bd336": "Starszy Stormbrow jest najpewniej w wiosce Goldshire w lesie Elwynn.",
        "f91fc2c957a91cb625c6": "Starszego Hammershouta znajdziesz w murach Stormwind.",
        "fbc7538b3bc091d64e58": "Starszego Dawnstridera znajdziesz w Flame Crest na Płonących Stepach."
      },
      "name": "Starszy Rumblerock",
      "translationMetadata": {
