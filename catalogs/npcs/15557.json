    "trTR": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Şimdi yeni yılın başladığı ve ayın parlakça ışıldadığı zaman.$B$BBizim zamanımız... kadimlerin uyandığı zaman.",
        "a426b7587f4b14cbbbb4": "Winterhoof mu? Duyduğuma göre Booty Bay’de hayatın tadını çıkarıyormuş.",
        "df8cd496a62ca26bd336": "Bilge Stormbrow büyük olasılıkla Elwynn Ormanı’ndaki Goldshire köyündedir.",
        "f91fc2c957a91cb625c6": "Bilge Hammershout’u Stormwind surlarının içinde bulabilirsin.",
        "fbc7538b3bc091d64e58": "Bilge Dawnstrider’ı Burning Steppes’teki Flame Crest’te bulabilirsin."
      },
      "name": "Ulu Rumblerock",
