    "hrHR": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude.",
        "a426b7587f4b14cbbbb4": "Winterhoof? Čujem da uživa u Booty Bayu.",
        "df8cd496a62ca26bd336": "Starješina Stormbrow najvjerojatnije je u selu Goldshire u šumi Elwynn.",
        "f91fc2c957a91cb625c6": "Starješinu Hammershouta možeš pronaći unutar zidina Stormwinda.",
        "fbc7538b3bc091d64e58": "Starješinu Dawnstridera možeš pronaći u Flame Crestu na Burning Steppes."
      },
      "name": "Starješina Rumblerock",
