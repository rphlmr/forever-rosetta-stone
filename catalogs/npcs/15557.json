  "locales": {
    "csCZ": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... čas, kdy se probouzejí prastaří.",
        "a426b7587f4b14cbbbb4": "Winterhoof? Slyšel jsem, že si užívá v Booty Bay.",
        "df8cd496a62ca26bd336": "Starší Stormbrow je nejspíš ve vesnici Goldshire v Elwynnském lese.",
        "f91fc2c957a91cb625c6": "Staršího Hammershouta najdeš za hradbami Stormwindu.",
        "fbc7538b3bc091d64e58": "Staršího Dawnstridera najdeš ve Flame Crest v Burning Steppes."
      },
      "name": "Starší Rumblerock",
