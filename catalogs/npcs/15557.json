    "esES": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten.",
        "a426b7587f4b14cbbbb4": "¿Pezuña Invernal? He oído que vive en Bahía del Botín.",
        "df8cd496a62ca26bd336": "El ancestro Tormenceño es probable que se encuentre en Villadorada en el Bosque de Elwynn.",
        "f91fc2c957a91cb625c6": "Puedes encontrar al ancestro Rugidomazo dentro de las murallas de Ventormenta.",
        "fbc7538b3bc091d64e58": "El ancestro Caminocaso se encuentra en Peñasco Llamarada en Las Estepas Ardientes."
      },
      "name": "Ancestro Rocaestruendo",
