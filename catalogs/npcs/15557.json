    "svSE": {
      "dialogue": {
        "66b1c59cef0f1d0db8be": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "a426b7587f4b14cbbbb4": "Winterhoof? Jag hör att han njuter av livet i Booty Bay.",
        "df8cd496a62ca26bd336": "Äldste Stormbrow är troligen i byn Goldshire i Elwynn Forest.",
        "f91fc2c957a91cb625c6": "Äldste Hammershout finns innanför Stormwinds murar.",
        "fbc7538b3bc091d64e58": "Äldste Dawnstrider finns vid Flame Crest på Burning Steppes."
      },
      "name": "Äldste Rumblerock",
