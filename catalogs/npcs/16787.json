    "csCZ": {
      "dialogue": {
        "3e839832ac4e24e738d0": "Buď zdráv, $n. Přineseš-li mi nekrotické kameny od nemrtvých útočníků, mohu ti zpřístupnit zásoby Argent Dawn.",
        "8bd934d7e5c157b76554": "Vycvičte mě.",
        "b3d88dc07911a54135da": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Výstrojník Argentového úsvitu",
