    "plPL": {
      "dialogue": {
        "606de6f475b1516fb806": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odszukać.",
        "939d2e71895260e5066b": "Czy wyglądam, jakbym miał czas i siłę niańczyć każdego turystę, który tu zawita? Powiedz szybko, czego potrzebujesz.",
        "b0d4aa5d05cb19e93c32": "Niewielu kucharzy przychodzi tu po nauki, ale chyba mogę ci czegoś nauczyć, jeśli jesteś gotów.",
        "b313171483640eceaf99": "Wyszkol mnie.",
        "cf0eadb4c83137d96578": "Odszukaj Shandrinę w Silverwind Refuge. Może sprzedać ci \"Książkę kucharską eksperta\"."
      },
      "name": "Stephen Ryback",
      "translationMetadata": {
