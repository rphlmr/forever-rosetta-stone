    "enUS": {
      "dialogue": {
        "606de6f475b1516fb806": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "939d2e71895260e5066b": "Do I look like I have the time or energy to coddle every tourist that wanders through my door? Tell me what you need, and make it quick.",
        "b0d4aa5d05cb19e93c32": "I don't get too many cooks in here looking for training, but I guess I could teach you something if you're ready.",
        "b313171483640eceaf99": "Train me.",
        "cf0eadb4c83137d96578": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\"."
      },
      "name": "Stephen Ryback",
      "subName": "Cooking Trainer",
      "translationMetadata": {
