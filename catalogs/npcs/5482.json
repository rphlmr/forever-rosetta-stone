    "daDK": {
      "dialogue": {
        "606de6f475b1516fb806": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham for at blive bedre.",
        "939d2e71895260e5066b": "Ser jeg ud, som om jeg har tid eller energi til at pylre om enhver turist, der kommer ind ad døren? Fortæl mig hurtigt, hvad du vil.",
        "b0d4aa5d05cb19e93c32": "Jeg får ikke mange kokke herind, der søger træning, men jeg kan vel lære dig noget, hvis du er klar.",
        "b313171483640eceaf99": "Træn mig.",
        "cf0eadb4c83137d96578": "Find Shandrina i Silverwind Refuge. Hun kan sælge dig \"Ekspertkogebogen\"."
      },
      "name": "Stephen Ryback",
      "translationMetadata": {
        "fields": {
