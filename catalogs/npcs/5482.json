    "hrHR": {
      "dialogue": {
        "606de6f475b1516fb806": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Moraš ga potražiti želiš li se usavršiti.",
        "939d2e71895260e5066b": "Izgledam li kao da imam vremena ili snage ugađati svakom turistu koji mi uđe na vrata? Reci što trebaš i budi brz.",
        "b0d4aa5d05cb19e93c32": "Ne dolazi mi mnogo kuhara na obuku, ali mogao bih te nešto naučiti ako si spreman.",
        "b313171483640eceaf99": "Podučite me.",
        "cf0eadb4c83137d96578": "Potraži Shandrinu u Silverwind Refugeu. Može ti prodati \"Kuharicu za stručnjake\"."
      },
      "name": "Stephen Ryback",
      "translationMetadata": {
