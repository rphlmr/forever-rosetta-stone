    },
    "plPL": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Jak cudownie zobaczyć kogoś w tak odległym zakątku świata. Chodź, przejdź się ze mną. Niech nasze ciała ogrzeją się nawzajem."
      },
      "name": "Artorius Uprzejmy",
      "translationMetadata": {
        "fields": {
