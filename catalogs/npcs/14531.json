    "trTR": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Dünyanın bu ücra köşesinde başka birini görmek ne güzel. Gel, benimle yürü. Bedenlerimiz birbirini sıcak tutsun."
      },
      "name": "Sevimli Artorius",
