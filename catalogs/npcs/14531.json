    "daDK": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Hvor er det dejligt at se et andet menneske i denne afsides del af verden. Kom, gå med mig. Lad vores kroppe holde hinanden varme."
      },
      "name": "Artorius den elskværdige",
      "translationMetadata": {
        "fields": {
