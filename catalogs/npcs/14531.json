    "enUS": {
      "dialogue": {
        "708a41af44ca0957ccf6": "How wonderful to see another person in this remote region of the world. Come, walk with me. Let our bodies keep each other warm."
      },
      "name": "Artorius the Amiable",
      "translationMetadata": {
        "fields": {
          "dialogue.708a41af44ca0957ccf6": {
