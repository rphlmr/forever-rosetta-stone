    "ltLT": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Kaip nuostabu šiame nuošaliame pasaulio krašte sutikti kitą žmogų. Eikš, pasivaikščiokime kartu. Tegul mūsų kūnai šildo vienas kitą."
      },
      "name": "Malonusis Artorius",
