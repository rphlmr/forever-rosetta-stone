    "csCZ": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Jak úžasné vidět v této odlehlé části světa dalšího člověka. Pojď, projdi se se mnou. Ať se naše těla navzájem zahřejí."
      },
      "name": "Artorius Laskavý",
