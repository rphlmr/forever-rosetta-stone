    "ptBR": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Que maravilha encontrar alguém nesse lugar tão isolado. Vem caminhar comigo. Vamos aproveitar a companhia um do outro e nos conhecer melhor."
      },
      "name": "Artórius, o Bondoso",
