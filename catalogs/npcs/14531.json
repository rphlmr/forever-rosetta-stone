    "hrHR": {
      "dialogue": {
        "708a41af44ca0957ccf6": "Divno je vidjeti još nekoga u ovom zabačenom kraju svijeta. Dođi, prošetaj sa mnom. Neka nam tijela griju jedno drugo."
