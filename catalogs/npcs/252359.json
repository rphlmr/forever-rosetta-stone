  "locales": {
    "csCZ": {
      "dialogue": {
        "13f432dbf12e094d4130": "Pokud si přeješ, mohu ti kromě výcviku vymazat z mysli znalosti tvých talentů. Varuji tě, že s každým opakováním je tento postup náročnější, a proto i dražší.",
        "45f238b56b2c5204b815": "Našinců je dnes málo, ale mezi shen’dorei stále žijí ti, kdo sní ve smaragdové zeleni."
      },
      "name": "Lotheluum Starbreeze",
      "translationMetadata": {
        "fields": {
          "dialogue.13f432dbf12e094d4130": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
