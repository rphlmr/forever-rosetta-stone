            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "13f432dbf12e094d4130": "Wenn Ihr es wünscht, dann liegt es neben der Ausbildung in meiner Macht, das Wissen über Eure Talente aus Eurem Gehirn zu löschen. Doch ich warne Euch: Diese Prozedur wird mit jeder Durchführung schwieriger und daher auch teurer.",
        "45f238b56b2c5204b815": "Unsere Art ist heutzutage selten, doch unter den Shendorei gibt es noch jene, die in Smaragdgrün träumen."
      },
      "name": "Lotheluum Starbreeze",
      "subName": "Druid Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.13f432dbf12e094d4130": {
