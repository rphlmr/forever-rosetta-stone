          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "13f432dbf12e094d4130": "Hvis du ønsker det, kan jeg ud over træning også slette viden om dine talenter fra dit sind. Vær advaret: Hver gang du gennemgår proceduren, bliver den sværere at udføre og derfor dyrere.",
        "45f238b56b2c5204b815": "Vores slags er sjældne i disse dage, men blandt shen’dorei findes der stadig dem, der drømmer i smaragdgrønt."
      },
      "name": "Lotheluum Starbreeze",
      "translationMetadata": {
        "fields": {
          "dialogue.13f432dbf12e094d4130": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
