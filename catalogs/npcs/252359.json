    "enUS": {
      "dialogue": {
        "13f432dbf12e094d4130": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes.",
        "45f238b56b2c5204b815": "Our kind are rare these days, but there are those who still dream in emerald amongst the Shen'dorei."
      },
      "name": "Lotheluum Starbreeze",
      "subName": "Druid Trainer",
      "translationMetadata": {
        "fields": {
