  "factionTemplateId": 80,
  "locales": {
    "csCZ": {
      "dialogue": {
        "2f5498f2292d32a6bd6e": "Promiň, ale o kůži už víš víc než já. Pokud se chceš naučit víc, promluv si s Faldronem támhle.",
        "7b43fb849a28a4b3b664": "Pokud tě zajímá šití z kůže, přišel jsi na správné místo. Faldron a Telonis jsou skuteční umělci a doufám, že se od nich mnoho naučím.",
        "8014a6501c13fa372725": "Je tak vzrušující být tady v Darnassu, obklopená talentovanými lidmi! Vím, že na mě rodina bude pyšná. Možná mě, budu-li mít velké štěstí, Strážkyně požádají, abych se k nim připojila na frontě!",
        "f1fc40b29bb9ad91db79": "Vycvičte mě."
      },
      "name": "Darianna",
      "translationMetadata": {
        "fields": {
          "dialogue.2f5498f2292d32a6bd6e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.7b43fb849a28a4b3b664": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.8014a6501c13fa372725": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f1fc40b29bb9ad91db79": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "2f5498f2292d32a6bd6e": "Åh, beklager, men du ved mere om læder end jeg nu. Tal med Faldron derovre, hvis du vil lære mere.",
        "7b43fb849a28a4b3b664": "Hvis du er interesseret i at sy i læder, er du kommet til det rette sted. Faldron og Telonis er sande kunstnere, og jeg håber at lære meget af dem.",
        "8014a6501c13fa372725": "Det er så spændende at være her i Darnassus omgivet af talentfulde mennesker! Jeg ved bare, at jeg vil gøre min familie stolt. Måske vil Sentinels, hvis jeg er rigtig heldig, bede mig slutte mig til dem ved fronten!",
        "f1fc40b29bb9ad91db79": "Træn mig."
      },
      "name": "Darianna",
      "translationMetadata": {
        "fields": {
          "dialogue.2f5498f2292d32a6bd6e": {
            "origin": "ai",
