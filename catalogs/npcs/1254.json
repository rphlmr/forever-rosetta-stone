      }
    },
    "deDE": {
      "dialogue": {
        "0f9e311e892df289d367": "Bildet mich aus.",
        "2c469e93e85238cd29e5": "Troggs! Ich schwöre, die Götter haben sie nur in dieses Land gesetzt, um mich zu quälen! Vier Zoll tiefer in die Minen, dann zwei Fuß zurück vor den Troggs!",
        "67d40de1128f7090e0d8": "Ich möchte Eure Waren ansehen."
      },
      "name": "Großknecht Stonebrow",
      "subName": "Minenarbeiterliga",
