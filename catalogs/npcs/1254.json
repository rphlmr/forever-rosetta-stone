    "plPL": {
      "dialogue": {
        "0f9e311e892df289d367": "Wyszkol mnie.",
        "2c469e93e85238cd29e5": "Troggowie! Przysięgam, że bogowie zesłali ich na tę ziemię tylko po to, żeby mnie dręczyć! Cztery cale w głąb kopalni, a potem dwie stopy wstecz przez troggów!",
        "67d40de1128f7090e0d8": "Chcę przejrzeć twoje towary."
      },
      "name": "Brygadzista Stonebrow",
