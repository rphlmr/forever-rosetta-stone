    "ltLT": {
      "dialogue": {
        "0f9e311e892df289d367": "Išmokyk mane.",
        "2c469e93e85238cd29e5": "Trogai! Prisiekiu, dievai juos apgyvendino šioje žemėje tik tam, kad mane kankintų! Keturi coliai gilyn į kasyklą, tada dvi pėdos atgal nuo trogų!",
        "67d40de1128f7090e0d8": "Noriu apžiūrėti tavo prekes."
