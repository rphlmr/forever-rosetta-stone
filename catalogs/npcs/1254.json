    "hrHR": {
      "dialogue": {
        "0f9e311e892df289d367": "Podučite me.",
        "2c469e93e85238cd29e5": "Trogovi! Kunem se da su ih bogovi postavili u ovu zemlju samo da me muče! Četiri palca dublje u rudnike, pa dvije stope natrag zbog trogova!",
        "67d40de1128f7090e0d8": "Želim pogledati vašu robu."
      },
