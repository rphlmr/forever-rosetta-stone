      }
    },
    "daDK": {
      "dialogue": {
        "0f9e311e892df289d367": "Træn mig.",
        "2c469e93e85238cd29e5": "Trogger! Jeg sværger, guderne satte dem i dette land kun for at plage mig! Fire tommer dybere ind i minerne og så to fod tilbage på grund af troggerne!",
        "67d40de1128f7090e0d8": "Jeg vil gerne se dine varer."
      },
      "name": "Formand Stonebrow",
      "translationMetadata": {
        "fields": {
          "dialogue.0f9e311e892df289d367": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
