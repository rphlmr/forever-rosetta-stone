    "frFR": {
      "dialogue": {
        "0f9e311e892df289d367": "Entraînez-moi.",
        "2c469e93e85238cd29e5": "Les trognes ! Je jure que les dieux les ont mis sur cette terre uniquement pour me tourmenter ! Quatre pouces de plus dans les mines, puis deux pieds de recul par rapport aux trognes !",
        "67d40de1128f7090e0d8": "Je voudrais regarder vos articles."
      },
      "name": "Contremaître Stonebrow",
