  "locales": {
    "csCZ": {
      "dialogue": {
        "0f9e311e892df289d367": "Vycvičte mě.",
        "2c469e93e85238cd29e5": "Troggové! Přísahám, že je bohové do téhle země poslali jen proto, aby mě trápili! Čtyři palce hlouběji do dolů a pak dvě stopy zpátky před troggy!",
        "67d40de1128f7090e0d8": "Chci si prohlédnout vaše zboží."
      },
      "name": "Předák Stonebrow",
      "translationMetadata": {
        "fields": {
          "dialogue.0f9e311e892df289d367": {
