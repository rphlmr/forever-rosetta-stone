  "locales": {
    "csCZ": {
      "dialogue": {
        "4d0d7d6cef52838d15cd": "Karty Darkmoon Faire? Na ty se zeptej zdejšího profesora. Za mnou přijď, pokud obchoduješ se vzácnými starožitnostmi a artefakty.",
        "54938cfab6b98a0e1cea": "Co máš na prodej?",
        "653fc2ba7681ebf1845f": "Máš vůbec představu, čím procházím, abych přivezla tyto nesrovnatelné cennosti k prodeji? Přijď si je všechny prohlédnout!",
        "b337f5560f99a7d2f67d": "Každý předmět, který prodávám, jsem získala sama. Osobně ručím za jejich pravost.",
        "cef5af94525ecd7e1e5d": "Pojď se podívat na mé zboží, dokud můžeš. Jsme tu celý týden a pak odjedeme do daleké země."
      },
      "name": "Lhara",
      "translationMetadata": {
        "fields": {
          "dialogue.4d0d7d6cef52838d15cd": {
