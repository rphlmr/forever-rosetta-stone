    "hrHR": {
      "dialogue": {
        "4d0d7d6cef52838d15cd": "Darkmoon Faire karte? Za njih se obrati profesoru ovdje. Dođi k meni ako trguješ rijetkim starinama i artefaktima.",
        "54938cfab6b98a0e1cea": "Što imaš na prodaju?",
        "653fc2ba7681ebf1845f": "Imaš li pojma što sve prolazim da bih donijela ove neusporedive dragocjenosti na prodaju? Dođi i pogledaj ih!",
        "b337f5560f99a7d2f67d": "Svaki predmet koji prodajem sama sam nabavila. Osobno jamčim njihovu autentičnost.",
        "cef5af94525ecd7e1e5d": "Dođi pogledati moju robu dok još možeš. Ovdje smo cijeli tjedan, a onda odlazimo u daleku zemlju."
      },
      "name": "Lhara",
      "translationMetadata": {
