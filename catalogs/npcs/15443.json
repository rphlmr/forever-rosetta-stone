    "enUS": {
      "dialogue": {
        "9785475753f3e655dfac": "Hail, $c.  The Ironforge Brigade is stationed here to keep an eye on Hive'Zora.  The Cenarion Circle druids have been monitoring silithid movement and they're anticipating something major in this area."
      },
      "name": "Janela Stouthammer",
