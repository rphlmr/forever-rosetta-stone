    "daDK": {
      "dialogue": {
        "9785475753f3e655dfac": "Vær hilset, $c. Ironforge-brigaden er stationeret her for at holde øje med Hive'Zora. Cenarion-cirklens druider har overvåget silithidernes bevægelser og forventer, at noget stort er på vej i området."
      },
      "name": "Janela Stouthammer",
      "translationMetadata": {
        "fields": {
