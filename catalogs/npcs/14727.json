    "ltLT": {
      "dialogue": {
        "bfd4451f35c467b4b1c2": "Ei, tu!  Jei nori pelnyti Darkspear pagarbą, pradėk nuo vertingų išteklių aukojimo tiems, kuriems jų reikia!  Audiniai ir tvarsčiai ant medžių neauga, žinai.$B$BUžuot pardavęs įvairius nuotykių metu rastus audinio gabalus, paaukok juos!  Taip pelnysi Darkspear pripažinimą!"
      },
      "name": "Vehena",
      "subName": "Ordos audinių intendantė",
