  "locales": {
    "csCZ": {
      "dialogue": {
        "bfd4451f35c467b4b1c2": "Hej, ty tam! Pokud chceš získat úctu kmene Darkspear, můžeš začít tím, že daruješ cenné zásoby potřebným! Látky a obvazy přece nerostou na stromech.$B$BMísto abys prodával látky nalezené při dobrodružstvích, daruj je! Tak si získáš uznání kmene Darkspear!"
      },
      "name": "Vehena",
      "translationMetadata": {
