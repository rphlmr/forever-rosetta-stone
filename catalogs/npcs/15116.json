  "locales": {
    "csCZ": {
      "dialogue": {
        "02dc1f9d2e1eedd082bf": "Hej, hej, hej! Pokud chceš vyzkoušet své rybářské dovednosti, mám pro tebe to pravé místo! Tuto neděli pořádáme rybářský turnaj ve Stranglethornu!\n\n",
        "097eb2e3450c45eae47f": "Hej, hej, hej! Propaguji báječný rybářský turnaj ve Stranglethornu, ale musíš být dost tvrdý, abys tam přežil, a dost zkušený, abys v tamních vodách mohl rybařit.$B$B Vrať se později, až budeš mít lepší kvalifikaci!\n\n"
      },
      "name": "Grinkle",
      "translationMetadata": {
        "fields": {
          "dialogue.02dc1f9d2e1eedd082bf": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
