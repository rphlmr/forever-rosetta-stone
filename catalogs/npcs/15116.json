          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "02dc1f9d2e1eedd082bf": "Hej, hej, hej! Hvis du vil teste dine fiskeevner, har jeg lige stedet til dig! På søndag holder vi en fisketurnering i Stranglethorn!\n\n",
        "097eb2e3450c45eae47f": "Hej, hej, hej! Jeg er her for at reklamere for en fantastisk fisketurnering i Stranglethorn, men du skal være stærk nok til at overleve der og dygtig nok til at fiske i de vande.$B$B Kom tilbage senere, når du er bedre kvalificeret!\n\n"
      },
      "name": "Grinkle",
      "translationMetadata": {
        "fields": {
          "dialogue.02dc1f9d2e1eedd082bf": {
