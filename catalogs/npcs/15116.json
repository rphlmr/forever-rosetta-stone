    "enUS": {
      "dialogue": {
        "02dc1f9d2e1eedd082bf": "Heya Heya Heya!   If you want to test your fishing skills then I have just the place for you!   This Sunday we have a fishing tournament in Stranglethorn!\n\n",
        "097eb2e3450c45eae47f": "Hey Hey Hey!  I am here to promote a fabulous fishing tournament in Stranglethorn but you need to be tough enough to survive there and have enough skill in fishing to fish those waters.$B$B Come back later when you are more qualified!\n\n"
      },
      "name": "Grinkle",
      "subName": "Fishing Promoter",
      "translationMetadata": {
