    "hrHR": {
      "dialogue": {
        "6443ecd8657f6de02382": "Dolina kušnji i najslabijeg će iskušati i pretvoriti u ratnika dostojnog Horde. One koji ne uspiju svladati njezine kušnje ostavit ćemo da se peku na užarenom pustinjskom suncu."
      },
      "name": "Gornek",
