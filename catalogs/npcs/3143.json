    "daDK": {
      "dialogue": {
        "6443ecd8657f6de02382": "Prøvelsernes Dal hærder selv den svageste til en kriger, der er værdig til at slutte sig til Horden. De, der ikke består prøverne, efterlades til at stege i ørkenens brændende sol."
      },
      "name": "Gornek",
      "translationMetadata": {
