    "csCZ": {
      "dialogue": {
        "6443ecd8657f6de02382": "Údolí zkoušek zocelí i ty nejslabší a učiní z nich válečníky hodné vstupu do Hordy. Ty, kdo jeho zkouškám nedostojí, necháme péct pod žhavým pouštním sluncem."
      },
      "name": "Gornek",
