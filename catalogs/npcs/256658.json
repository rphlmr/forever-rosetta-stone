      }
    },
    "plPL": {
      "dialogue": {
        "6a0f1878d5d2918e307a": "Szybko się uczysz, a to dobrze. Pamiętaj tylko, by wykonać zadanie należycie, choćby miało to długo potrwać. Obawiam się, że muszę cię teraz wysłać do Snarla po dalsze nauki. Naucz się tego, co ma ci do przekazania, ale nie słuchaj jego gniewnych słów. Taki się robi, gdy córki Saru się z niego śmieją."
      },
      "name": "Gur'dok",
      "translationMetadata": {
        "fields": {
          "dialogue.6a0f1878d5d2918e307a": {
