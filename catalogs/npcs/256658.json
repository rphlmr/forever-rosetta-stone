        }
      }
    },
    "trTR": {
      "dialogue": {
        "6a0f1878d5d2918e307a": "Çabuk öğreniyorsun, bu kötü bir şey değil. Yeter ki ne kadar sürerse sürsün işi doğru yaptığından emin ol. Şimdi daha fazlasını öğrenmen için seni Snarl'a göndermem gerekiyor. Öğretebildiklerini öğren ama öfkeli sözlerine kulak asma. Saru'nun kızları ona güldüğünde böyle oluyor."
      },
      "name": "Gur'dok",
      "translationMetadata": {
        "fields": {
          "dialogue.6a0f1878d5d2918e307a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
