    "hrHR": {
      "dialogue": {
        "6a0f1878d5d2918e307a": "Brzo učiš, a to nije loše. Samo se pobrini da posao obaviš kako treba, koliko god dugo trajalo. Sad te, bojim se, moram poslati Snarlu da naučiš više. Nauči što te može naučiti, ali ne slušaj njegove ljutite riječi. Takav postane kad mu se Saruove kćeri smiju."
      },
      "name": "Gur'dok",
      "translationMetadata": {
        "fields": {
          "dialogue.6a0f1878d5d2918e307a": {
