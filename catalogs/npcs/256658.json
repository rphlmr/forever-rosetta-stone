  "locales": {
    "csCZ": {
      "dialogue": {
        "6a0f1878d5d2918e307a": "Učíš se rychle, a to není na škodu. Jen se ujisti, že práci odvedeš pořádně, ať to trvá jakkoli dlouho. Teď tě bohužel musím poslat ke Snarlovi, aby ses naučil víc. Nauč se, co tě může naučit, ale neposlouchej jeho rozzlobená slova. Takový bývá, když se mu Saruovy dcery smějí."
      },
      "name": "Gur'dok",
      "translationMetadata": {
        "fields": {
          "dialogue.6a0f1878d5d2918e307a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
