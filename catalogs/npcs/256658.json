            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "6a0f1878d5d2918e307a": "Du lærer hurtigt, og det er ikke dårligt. Sørg blot for at gøre arbejdet ordentligt, uanset hvor lang tid det tager. Nu må jeg desværre sende dig til Snarl for at lære mere. Lær det, han kan lære dig, men lyt ikke til hans vrede ord. Han bliver sådan, når Sarus døtre griner af ham."
      },
      "name": "Gur'dok",
      "translationMetadata": {
        "fields": {
          "dialogue.6a0f1878d5d2918e307a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
