    "plPL": {
      "dialogue": {
        "0858359c2b9dea92627d": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "eff974e2515ca35b621c": "Moja mądrość i wiedza są do twojej dyspozycji. Co mogę dla ciebie zrobić, $n?",
        "f0a98cd00a95f947fcce": "Niech Elune będzie z tobą, $c.",
        "f29c4845ff6d52c772cb": "Poprzez rygorowne przeszkolenie musiałam oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by móc uczyć ich od nowa. Usługa ta staje się coraz trudniejsza z każdym razem, dlatego też jest coraz droższa. Czy chcesz, abym oduczyła cię poznanych talentów?"
      },
      "name": "Jandria",
      "translationMetadata": {
