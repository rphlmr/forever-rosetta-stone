  "locales": {
    "csCZ": {
      "dialogue": {
        "0858359c2b9dea92627d": "Hledám další výcvik v kněžském umění.",
        "eff974e2515ca35b621c": "Má moudrost i znalosti jsou ti k dispozici. Co pro tebe mohu udělat, $n?",
        "f0a98cd00a95f947fcce": "Elune s tebou, $c.",
        "f29c4845ff6d52c772cb": "Přísným přeškolením jsem musela mnohé žáky odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto je také dražší. Přeješ si, abych tě odnaučila talenty, které ses naučil?"
      },
      "name": "Jandria",
      "translationMetadata": {
        "fields": {
          "dialogue.0858359c2b9dea92627d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.eff974e2515ca35b621c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f0a98cd00a95f947fcce": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f29c4845ff6d52c772cb": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
