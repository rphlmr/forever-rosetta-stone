    "hrHR": {
      "dialogue": {
        "0858359c2b9dea92627d": "Tražim daljnju poduku u svećeničkom umijeću.",
        "eff974e2515ca35b621c": "Moja mudrost i znanje pripadaju tebi. Što mogu učiniti za tebe, $n?",
        "f0a98cd00a95f947fcce": "Elune s tobom, $c.",
        "f29c4845ff6d52c772cb": "Strogom sam preobukom mnoge učenike morala odviknuti od svega što su ranije naučili kako bih ih mogla poučiti iznova. Ta usluga postaje sve teža svaki put, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Jandria",
      "translationMetadata": {
