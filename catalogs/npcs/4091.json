          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "0858359c2b9dea92627d": "Jeg søger mere træning i præsternes kunst.",
        "eff974e2515ca35b621c": "Min visdom og min viden er din. Hvad kan jeg gøre for dig, $n?",
        "f0a98cd00a95f947fcce": "Elune være med dig, $c.",
        "f29c4845ff6d52c772cb": "Gennem hård omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne lære dem det på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine tillærte talenter?"
      },
      "name": "Jandria",
      "translationMetadata": {
        "fields": {
          "dialogue.0858359c2b9dea92627d": {
