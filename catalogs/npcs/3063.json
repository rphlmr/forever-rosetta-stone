  "locales": {
    "csCZ": {
      "dialogue": {
        "13d1fca03615091af36a": "Potřebuji výcvik válečníka.",
        "41629d100596ebb9b7d6": "Ať se člověk naučí sebevíc, vždy je co poznávat.",
        "7203599e9b4a396d598e": "Nemohu tě cvičit, $c.",
        "846e591227a96ab5f86f": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto také dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Krang Stonehoof",
      "translationMetadata": {
        "fields": {
          "dialogue.13d1fca03615091af36a": {
