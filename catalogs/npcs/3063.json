    "enUS": {
      "dialogue": {
        "13d1fca03615091af36a": "I require warrior training.",
        "41629d100596ebb9b7d6": "No matter how much one learns, there is always more to know.",
        "7203599e9b4a396d598e": "I can not train you, $c.",
        "846e591227a96ab5f86f": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Krang Stonehoof",
      "subName": "Warrior Trainer",
      "translationMetadata": {
