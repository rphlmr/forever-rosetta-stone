    "ltLT": {
      "dialogue": {
        "13d1fca03615091af36a": "Man reikia kario mokymo.",
        "41629d100596ebb9b7d6": "Kad ir kiek išmoktum, visada yra ko dar išmokti.",
        "7203599e9b4a396d598e": "Negaliu tavęs mokyti, $c.",
        "846e591227a96ab5f86f": "Griežtai permokydamas turėjau padėti daugeliui mokinių atsisakyti visko, ką jie anksčiau buvo išmokę, kad galėčiau juos mokyti iš naujo.  Kaskart šią paslaugą suteikti darosi vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?"
      },
      "name": "Krang Stonehoof",
      "subName": "Karių mokytojas",
