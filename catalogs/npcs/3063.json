    "daDK": {
      "dialogue": {
        "13d1fca03615091af36a": "Jeg har brug for krigertræning.",
        "41629d100596ebb9b7d6": "Uanset hvor meget man lærer, er der altid mere at vide.",
        "7203599e9b4a396d598e": "Jeg kan ikke træne dig, $c.",
        "846e591227a96ab5f86f": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Krang Stonehoof",
      "translationMetadata": {
        "fields": {
          "dialogue.13d1fca03615091af36a": {
