    "hrHR": {
      "dialogue": {
        "13d1fca03615091af36a": "Trebam ratničku obuku.",
        "41629d100596ebb9b7d6": "Bez obzira na to koliko naučimo, uvijek ima još toga za spoznati.",
        "7203599e9b4a396d598e": "Ne mogu te obučavati, $c.",
        "846e591227a96ab5f86f": "Temeljitom sam prekvalifikacijom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Ta je usluga svaki put sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Krang Stonehoof",
