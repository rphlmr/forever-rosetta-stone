    "daDK": {
      "dialogue": {
        "56c2743e63ad8c741bf4": "Min forretningsplan tog ikke højde for kæmpe kodoer... måske skulle jeg have flettet kurve under vandet i stedet.",
        "5768b30ba89749dfc1b8": "Træn mig.",
        "e91ee70e1c53e021da73": "Jeg vil gerne se dine varer."
      },
      "name": "Smeed Scrabblescrew",
      "translationMetadata": {
