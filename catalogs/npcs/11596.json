  "locales": {
    "csCZ": {
      "dialogue": {
        "56c2743e63ad8c741bf4": "Můj podnikatelský plán nepočítal s ustájením obřích kodů... Možná jsem se měl věnovat podvodnímu pletení košíků.",
        "5768b30ba89749dfc1b8": "Vycvičte mě.",
        "e91ee70e1c53e021da73": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Smeed Scrabblescrew",
