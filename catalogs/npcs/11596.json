    "enUS": {
      "dialogue": {
        "56c2743e63ad8c741bf4": "My business plan never accounted for housing giant kodos... maybe I should have gone into the underwater basket weaving business instead.",
        "5768b30ba89749dfc1b8": "Train me.",
        "e91ee70e1c53e021da73": "I want to browse your goods."
