    "itIT": {
      "dialogue": {
        "741a1caddc85dffc0178": "Addestrami.",
        "899960f195359798fc2f": "Qualcosa la so, ma non sono un esperto. Per tua fortuna, Magar lo è. Sta in fondo alla bottega. Vedi se può aiutarti, ma bada a non farlo arrabbiare. A volte è irascibile.",
        "cd60c5f111f8a968c74d": "Ti insegnerò quello che posso.",
        "ce118266420ab3dfcd66": "Nelle nostre creazioni usiamo molte pelli e pellicce di animali."
      },
      "name": "Snang",
      "translationMetadata": {
