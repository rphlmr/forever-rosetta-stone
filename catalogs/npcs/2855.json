    "plPL": {
      "dialogue": {
        "741a1caddc85dffc0178": "Wyszkol mnie.",
        "899960f195359798fc2f": "Co nieco wiem, ale nie jestem ekspertem. Na twoje szczęście Magar nim jest. Stoi z tyłu sklepu. Spytaj, czy może ci pomóc, ale uważaj, żeby go nie rozdrażnić. Bywa drażliwy.",
        "cd60c5f111f8a968c74d": "Nauczę cię, czego mogę.",
        "ce118266420ab3dfcd66": "W naszych wyrobach używamy wielu zwierzęcych futer i skór."
      },
      "name": "Snang",
      "translationMetadata": {
