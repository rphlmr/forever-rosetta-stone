  "locales": {
    "csCZ": {
      "dialogue": {
        "741a1caddc85dffc0178": "Vycvičte mě.",
        "899960f195359798fc2f": "Pár věcí vím, ale odborník nejsem. Naštěstí pro tebe jím Magar je. Stojí vzadu v obchodě. Zeptej se ho, jestli ti pomůže, ale dej pozor, abys ho nerozčílil. Bývá podrážděný.",
        "cd60c5f111f8a968c74d": "Naučím tě, co budu moci.",
        "ce118266420ab3dfcd66": "Při naší práci používáme mnoho zvířecích kožešin a kůží."
      },
      "name": "Snang",
      "translationMetadata": {
        "fields": {
