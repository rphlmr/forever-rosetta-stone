    "trTR": {
      "dialogue": {
        "741a1caddc85dffc0178": "Beni eğit.",
        "899960f195359798fc2f": "Birkaç şey bilirim ama uzman değilim. Neyse ki Magar uzman. Dükkânın arka tarafında duruyor. Sana yardım edip edemeyeceğine bak ama onu kızdırmamaya dikkat et. Huysuz olabilir.",
        "cd60c5f111f8a968c74d": "Sana elimden geldiğince öğreteceğim.",
        "ce118266420ab3dfcd66": "Yaptığımız ürünlerde birçok hayvan postu ve derisi kullanırız."
      },
      "name": "Snang",
      "translationMetadata": {
        "fields": {
