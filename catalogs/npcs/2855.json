    "frFR": {
      "dialogue": {
        "741a1caddc85dffc0178": "Entraînez-moi.",
        "899960f195359798fc2f": "Je ne suis pas ignorant, mais je suis loin d'être un expert. Heureusement pour vous, Magar en est un. Il se trouve derrière l'échoppe. Voyez s'il peut vous aider, mais attention à ce que vous dites. Il est irritable.",
        "cd60c5f111f8a968c74d": "Je vous apprendrai tout ce que je peux.",
        "ce118266420ab3dfcd66": "Dans nos créations, nous utilisons différentes peaux d'animaux."
      },
      "name": "Snang",
      "subName": "Tailleur - Compagnon",
