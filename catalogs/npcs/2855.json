    "hrHR": {
      "dialogue": {
        "741a1caddc85dffc0178": "Podučite me.",
        "899960f195359798fc2f": "Znam ponešto, ali nisam stručnjak. Srećom po tebe, Magar jest. Stoji u stražnjem dijelu trgovine. Pitaj ga može li ti pomoći, ali pazi da ga ne razljutiš. Zna biti razdražljiv.",
        "cd60c5f111f8a968c74d": "Naučit ću te što mogu.",
        "ce118266420ab3dfcd66": "U svojim izrađevinama koristimo mnogo životinjskih krzna i koža."
      },
      "name": "Snang",
      "translationMetadata": {
