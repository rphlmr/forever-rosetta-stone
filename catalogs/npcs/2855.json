    "deDE": {
      "dialogue": {
        "741a1caddc85dffc0178": "Bildet mich aus.",
        "899960f195359798fc2f": "Ich weiß ein paar Dinge, aber ich bin kein Experte. Zu Eurem Glück ist Magar aber einer. Er ist im hinteren Teil des Ladens. Seht, ob er Euch helfen kann, aber verärgert ihn ja nicht. Er ist sehr reizbar.",
        "cd60c5f111f8a968c74d": "Ich werde Euch beibringen, was ich weiß.",
        "ce118266420ab3dfcd66": "Wir verwenden viele Tierpelze und Häute bei unseren Kreationen."
      },
      "name": "Snang",
      "subName": "Schneidergeselle",
      "translationMetadata": {
