    "esES": {
      "dialogue": {
        "741a1caddc85dffc0178": "Entréname.",
        "899960f195359798fc2f": "Sé un par de cosas, pero no soy un experto. Por suerte para ti, Magar sí que lo es. Está cerca de la parte trasera de la tienda. Vete a ver si puede ayudarte, pero ten cuidado y no le irrites. Puede llegar a ser muy quisquilloso.",
        "cd60c5f111f8a968c74d": "Te enseñaré lo que pueda.",
        "ce118266420ab3dfcd66": "En nuestras creaciones utilizamos muchas pieles y pelambres de animales."
      },
      "name": "Snang",
      "subName": "Oficial de sastrería",
