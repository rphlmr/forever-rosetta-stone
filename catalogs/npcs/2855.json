    "ptBR": {
      "dialogue": {
        "741a1caddc85dffc0178": "Treine-me.",
        "899960f195359798fc2f": "Eu sei uma coisa ou outra, mas não sou especialista. Sorte a sua que o Magar é. Ele está ali perto do fundo da loja. Veja se ele pode ajudá-lo, mas cuidado para não aborrecê-lo. Ele é muito irritadiço.",
        "cd60c5f111f8a968c74d": "Ensinarei a você o que eu puder.",
        "ce118266420ab3dfcd66": "Usamos muitos pelegos e peles em nossas criações."
      },
      "name": "Snang",
      "subName": "Alfaiate Profissional",
      "translationMetadata": {
