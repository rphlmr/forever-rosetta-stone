    "enUS": {
      "dialogue": {
        "741a1caddc85dffc0178": "Train me.",
        "899960f195359798fc2f": "I know a few things, but I'm no expert. Lucky for you, Magar is. He's standing near the back of the shop. See if he can help you, but be careful not to rile him. He can be irritable.",
        "cd60c5f111f8a968c74d": "I will teach you what I can.",
        "ce118266420ab3dfcd66": "We use many animal pelts and skins in our creations. "
      },
      "name": "Snang",
      "subName": "Journeyman Tailor",
