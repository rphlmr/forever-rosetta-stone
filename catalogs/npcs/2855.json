    "daDK": {
      "dialogue": {
        "741a1caddc85dffc0178": "Træn mig.",
        "899960f195359798fc2f": "Jeg ved lidt, men jeg er ingen ekspert. Heldigvis for dig er Magar det. Han står bagest i butikken. Spørg, om han kan hjælpe dig, men pas på ikke at gøre ham vred. Han kan være irritabel.",
        "cd60c5f111f8a968c74d": "Jeg vil lære dig, hvad jeg kan.",
        "ce118266420ab3dfcd66": "Vi bruger mange dyreskind og huder i vores arbejde."
      },
      "name": "Snang",
      "translationMetadata": {
        "fields": {
