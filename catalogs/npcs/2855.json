    "ltLT": {
      "dialogue": {
        "741a1caddc85dffc0178": "Išmokyk mane.",
        "899960f195359798fc2f": "Šį tą išmanau, bet nesu žinovas. Tavo laimei, Magaras yra žinovas. Jis stovi parduotuvės gale. Pažiūrėk, ar jis gali tau padėti, bet atsargiai, nesuerzink jo. Jis gali būti irzlus.",
        "cd60c5f111f8a968c74d": "Išmokysiu tave, ko galiu.",
        "ce118266420ab3dfcd66": "Savo dirbiniams naudojame daug gyvūnų kailių ir odų. "
      },
      "name": "Snang",
      "subName": "Siuvėjas pameistrys",
