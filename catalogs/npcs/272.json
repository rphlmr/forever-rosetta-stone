    "enUS": {
      "dialogue": {
        "0b8cae0c7e2917bf02b3": "Hello, hello!  Welcome to my kitchen, $g sir : m'lady;!  This is where all of the Scarlet Raven Tavern's finest delicacies are made.  Ah, just smell the wonderful aroma!",
        "537754f4bdd9117856a1": "Train me.",
