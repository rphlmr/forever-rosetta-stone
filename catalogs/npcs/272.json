    "hrHR": {
      "dialogue": {
        "0b8cae0c7e2917bf02b3": "Pozdrav, pozdrav! Dobro došli u moju kuhinju, $g gospodine : gospo;! Ovdje se pripremaju sve najbolje delicije krčme Scarlet Raven. Ah, samo osjetite taj divan miris!",
        "537754f4bdd9117856a1": "Podučite me.",
        "73a5e9b5c5e3e9d67949": "Pozdrav, pozdrav! Dobro došli u moju kuhinju, $g gospodine : gospo;! Ovdje se pripremaju sve najbolje delicije krčme Scarlet Raven. Ah, samo osjetite taj divan miris!",
        "9c356c932b6a35035cd8": "Želim pogledati vašu robu."
      },
