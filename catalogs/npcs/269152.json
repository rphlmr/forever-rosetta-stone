    "plPL": {
      "dialogue": {
        "8d7021eed7d1b7c894f6": "Mój lud cię nie zna. Kodo to potężny wierzchowiec, wychowany z miłością i troską przez mój lud; nie oddajemy go obcym. Dopóki starszyzna Thunder Bluff nie uzna cię za osobę o najwyższym poważaniu, nie mogę sprzedać ci kodo."
      },
      "name": "Tylana Clawhoof",
      "translationMetadata": {
        "fields": {
