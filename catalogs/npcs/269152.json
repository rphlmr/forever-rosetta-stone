    "ltLT": {
      "dialogue": {
        "8d7021eed7d1b7c894f6": "Mano žmonės tavęs nepažįsta. Kodo yra galingas jojamasis gyvūnas, kurį mano žmonės augina su meile ir rūpesčiu, todėl svetimšaliams jo nepatikime. Kol Thunder Bluff vyresnieji tavęs nelaikys išaukštintuoju, negalėsiu tau parduoti kodo."
      },
      "name": "Tylana Clawhoof",
      "translationMetadata": {
