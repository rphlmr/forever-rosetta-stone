    "hrHR": {
      "dialogue": {
        "8d7021eed7d1b7c894f6": "Moj te narod ne poznaje. Kodo je moćan jahaći stvor, odgojen ljubavlju i brigom mojeg naroda; ne dajemo ga strancima. Dok te starješine Thunder Bluffa ne budu smatrale uzvišenim, ne mogu ti prodati kodoa."
      },
      "name": "Tylana Clawhoof",
      "translationMetadata": {
