    "ptBR": {
      "dialogue": {
        "8d7021eed7d1b7c894f6": "Meu povo não conhece você. Um kodo é uma montaria poderosa, criada com o amor e o cuidado do meu povo; não entregamos uma a estranhos. Até que os anciãos do Penhasco do Trovão considerem você Exaltado, não posso vender um kodo a você."
      },
      "name": "Tylana Casco Afiado",
      "subName": "Kodo Mounts",
