    },
    "daDK": {
      "dialogue": {
        "8d7021eed7d1b7c894f6": "Mit folk kender dig ikke. En kodo er et mægtigt ridedyr, skabt gennem mit folks kærlighed og omsorg; sådanne gives ikke til fremmede. Før Thunder Bluffs ældste anser dig for ophøjet, kan jeg ikke sælge dig en kodo."
      },
      "name": "Tylana Clawhoof",
      "translationMetadata": {
        "fields": {
          "dialogue.8d7021eed7d1b7c894f6": {
