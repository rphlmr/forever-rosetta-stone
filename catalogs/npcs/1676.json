    "ptBR": {
      "dialogue": {
        "83a4f8bc26edc6d1514b": "Hum... Bem, não posso te ajudar ainda. Você tem que aprender o básico antes. Por que não procura Lorien Grenagem em Ventobravo?",
        "a53604e5d3f0af89a431": "Nunca estou ocupado demais para falar com um forasteiro! Quase nunca, enfim...",
        "ad9934bf640a3e5100a9": "Treine-me.",
        "bc5b093f6099587402c8": "Você tá sabendo muito, hein... Já sabe mais do que eu! Vá falar com Carretemola Fungrenagem em Altaforja. Ele vai te mostrar mais do que eu jamais poderia!",
        "c6c6311a3000262f3ad4": "Fantástico! Como você é trabalhador? Bem, vamos começar... podemos?"
      },
      "name": "Finbus Mancalfiado",
      "subName": "Engenheiro Perito",
