    "hrHR": {
      "dialogue": {
        "83a4f8bc26edc6d1514b": "Hmm... još ti ne mogu pomoći! Najprije moraš naučiti osnove. Zašto ne odeš do Spritea Jumpsprocketa u Stormwindu?",
        "a53604e5d3f0af89a431": "Nikad nisam prezaposlen za razgovor sa strancem! Gotovo nikad, barem...",
        "ad9934bf640a3e5100a9": "Podučite me.",
        "bc5b093f6099587402c8": "Napreduješ... sada si već bolji od mene! Trebaš razgovarati sa Springspindleom Fizzlegearom u Ironforgeu! On? Ona? može ti pokazati više nego što bih ja ikad mogao!",
        "c6c6311a3000262f3ad4": "Fantastično! Baš si marljiv! Pa, krenimo, može?"
      },
      "name": "Finbus Geargrind",
