    "daDK": {
      "dialogue": {
        "83a4f8bc26edc6d1514b": "Hmm... jeg kan ikke hjælpe dig endnu! Du skal først lære det grundlæggende. Hvorfor besøger du ikke Sprite Jumpsprocket i Stormwind?",
        "a53604e5d3f0af89a431": "Jeg har aldrig for travlt til at tale med en fremmed! Næsten aldrig, i hvert fald...",
        "ad9934bf640a3e5100a9": "Træn mig.",
        "bc5b093f6099587402c8": "Du arbejder dig opad... højere end mig nu! Du bør tale med Springspindle Fizzlegear i Ironforge! Han? Hun? kan vise dig mere, end jeg nogensinde kunne!",
        "c6c6311a3000262f3ad4": "Fantastisk! Sikke flittig du er! Nå, skal vi komme i gang?"
      },
      "name": "Finbus Geargrind",
      "translationMetadata": {
