    "svSE": {
      "dialogue": {
        "83a4f8bc26edc6d1514b": "Hmm... jag kan inte hjälpa dig riktigt än! Du måste lära dig grunderna först. Varför inte besöka Sprite Jumpsprocket i Stormwind?",
        "a53604e5d3f0af89a431": "Jag är aldrig för upptagen för att tala med en främling! Nästan aldrig, i alla fall...",
        "ad9934bf640a3e5100a9": "Träna mig.",
        "bc5b093f6099587402c8": "Du arbetar dig uppåt... högre än jag nu! Du borde tala med Springspindle Fizzlegear i Ironforge! Han? Hon? kan visa dig mer än jag någonsin skulle kunna!",
        "c6c6311a3000262f3ad4": "Fantastiskt! Visst är du flitig? Nå, ska vi sätta igång?"
      },
      "name": "Finbus Geargrind",
