  "locales": {
    "csCZ": {
      "dialogue": {
        "83a4f8bc26edc6d1514b": "Hmm... zatím ti ještě nemohu pomoci! Nejdřív se musíš naučit základy. Zajdi za Sprite Jumpsprocketem ve Stormwindu!",
        "a53604e5d3f0af89a431": "Nikdy nemám tolik práce, abych si nepromluvil s cizincem! Skoro nikdy...",
        "ad9934bf640a3e5100a9": "Vycvičte mě.",
        "bc5b093f6099587402c8": "Postupuješ výš... teď už výš než já! Promluv si se Springspindlem Fizzlegearem v Ironforge! Ten? Ta? tě naučí víc, než bych kdy dokázal já!",
        "c6c6311a3000262f3ad4": "Fantastické! Ty jsi ale pilný! Tak se do toho pustíme, ano?"
      },
      "name": "Finbus Geargrind",
      "translationMetadata": {
        "fields": {
          "dialogue.83a4f8bc26edc6d1514b": {
