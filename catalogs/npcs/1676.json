    "plPL": {
      "dialogue": {
        "83a4f8bc26edc6d1514b": "Hmm... jeszcze nie mogę ci pomóc! Najpierw musisz poznać podstawy. Odwiedź Sprite'a Jumpsprocketa w Stormwindzie!",
        "a53604e5d3f0af89a431": "Nigdy nie jestem zbyt zajęty, żeby porozmawiać z nieznajomym! Prawie nigdy...",
        "ad9934bf640a3e5100a9": "Wyszkol mnie.",
        "bc5b093f6099587402c8": "Robisz postępy... jesteś już lepszy ode mnie! Porozmawiaj ze Springspindle'em Fizzlegearem w Ironforge! On? Ona? nauczy cię więcej, niż ja kiedykolwiek mógłbym!",
        "c6c6311a3000262f3ad4": "Fantastycznie! Ale z ciebie pracuś! No to zaczynajmy, dobrze?"
      },
      "name": "Finbus Geargrind",
      "translationMetadata": {
