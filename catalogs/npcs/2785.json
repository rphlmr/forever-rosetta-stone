    "trTR": {
      "dialogue": {
        "064f346374f9b052c2e5": "Mallarına bakmak istiyorum.",
        "a5899bed177760a47fbf": "Geri çekil! Uzak dur! Çantam patlayıcı barutla dolu ve onu kullanmaktan korkmuyorum! Hepimizi havaya uçururum!$B$BAh, boş ver. Seni başkası sanmıştım...",
        "d4981138c58ac0ca8afb": "Beni eğit."
      },
