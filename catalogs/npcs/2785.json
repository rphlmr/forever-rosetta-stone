    "enUS": {
      "dialogue": {
        "064f346374f9b052c2e5": "I want to browse your goods.",
        "a5899bed177760a47fbf": "Back away!  Stay back!  I have a pack full of blastpowder and I'm not afraid to use it!  I'll blow us all away!$B$BOh, never mind.  I thought you were someone else....",
        "d4981138c58ac0ca8afb": "Train me."
      },
      "name": "Theldurin the Lost",
