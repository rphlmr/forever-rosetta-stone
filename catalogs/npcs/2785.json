    "daDK": {
      "dialogue": {
        "064f346374f9b052c2e5": "Jeg vil gerne se dine varer.",
        "a5899bed177760a47fbf": "Tilbage! Hold afstand! Jeg har en sæk fuld af sprængkrudt, og jeg er ikke bange for at bruge det! Jeg sprænger os alle i luften!$B$BNå, glem det. Jeg troede, du var en anden...",
        "d4981138c58ac0ca8afb": "Træn mig."
      },
      "name": "Theldurin den fortabte",
      "translationMetadata": {
        "fields": {
          "dialogue.064f346374f9b052c2e5": {
            "origin": "ai",
