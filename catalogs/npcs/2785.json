    "zhCN": {
      "dialogue": {
        "064f346374f9b052c2e5": "我想看看你的货物。",
        "a5899bed177760a47fbf": "退开!  别过来！  我有一包爆炸性的火药，我不怕用它!  我要把我们都炸飞！\n\n哦，没关系。 我还以为你是别人…",
        "d4981138c58ac0ca8afb": "训练我。"
      },
      "name": "迷失者塞尔杜林",
      "translationMetadata": {
