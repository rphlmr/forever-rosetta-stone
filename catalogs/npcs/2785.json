    "hrHR": {
      "dialogue": {
        "064f346374f9b052c2e5": "Želim pogledati vašu robu.",
        "a5899bed177760a47fbf": "Odstupi! Drži se podalje! Imam torbu punu eksplozivnog praha i ne bojim se upotrijebiti ga! Sve ću nas dići u zrak!$B$BOh, nema veze. Mislio sam da si netko drugi...",
        "d4981138c58ac0ca8afb": "Podučite me."
      },
      "name": "Izgubljeni Theldurin",
