    "svSE": {
      "dialogue": {
        "064f346374f9b052c2e5": "Jag vill se dina varor.",
        "a5899bed177760a47fbf": "Backa! Håll dig undan! Jag har en packning full med sprängkrut och jag är inte rädd för att använda det! Jag spränger oss allihop i luften!$B$BÄh, glöm det. Jag trodde att du var någon annan...",
        "d4981138c58ac0ca8afb": "Träna mig."
      },
      "name": "Theldurin den vilsegångne",
