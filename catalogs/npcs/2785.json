    "deDE": {
      "dialogue": {
        "064f346374f9b052c2e5": "Ich möchte Eure Waren ansehen.",
        "a5899bed177760a47fbf": "Zurückbleiben!  Bleibt zurück!  Ich habe einen Rucksack voll mit Sprengpulver und ich habe keine Angst, es zu benutzen!  Ich werde uns alle wegpusten!\n\nOh, vergiss es.  Ich dachte, du wärst jemand anderes. ....",
        "d4981138c58ac0ca8afb": "Bildet mich aus."
      },
      "name": "Theldurin der Verirrte",
      "translationMetadata": {
        "fields": {
