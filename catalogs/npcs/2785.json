    "plPL": {
      "dialogue": {
        "064f346374f9b052c2e5": "Chcę przejrzeć twoje towary.",
        "a5899bed177760a47fbf": "Odsuń się! Trzymaj się z daleka! Mam plecak pełen prochu wybuchowego i nie zawaham się go użyć! Wysadzę nas wszystkich!$B$BAch, nieważne. Myślałem, że jesteś kimś innym...",
        "d4981138c58ac0ca8afb": "Wyszkol mnie."
      },
      "name": "Theldurin Zagubiony",
