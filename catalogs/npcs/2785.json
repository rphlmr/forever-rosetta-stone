  "locales": {
    "csCZ": {
      "dialogue": {
        "064f346374f9b052c2e5": "Rád bych si prohlédl vaše zboží.",
        "a5899bed177760a47fbf": "Zpátky! Drž se dál! Mám batoh plný trhavého prachu a nebojím se ho použít! Vyhodím nás všechny do povětří!$B$BAle nic. Myslel jsem, že jsi někdo jiný...",
        "d4981138c58ac0ca8afb": "Vycvičte mě."
      },
      "name": "Theldurin Ztracený",
      "translationMetadata": {
        "fields": {
