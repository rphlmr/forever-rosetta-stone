    "itIT": {
      "dialogue": {
        "064f346374f9b052c2e5": "Vorrei vedere la tua merce.",
        "a5899bed177760a47fbf": "Indietro! Non ti avvicinare! Ho uno zaino pieno di polvere esplosiva e non ho paura di usarla! Ci faccio saltare tutti in aria!\n\nOh, lascia perdere. Ti avevo scambiato per qualcun altro....",
        "d4981138c58ac0ca8afb": "Addestrami."
      },
