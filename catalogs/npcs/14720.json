  "locales": {
    "csCZ": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Pohleď na tohoto padlého draka, $r. O síle Hordy není pochyb!",
        "5d65fd712ae27a164e39": "Já jsem ten, kdo je střeží. Jsem pěst odplaty, která krotí vzdorovité. Odvážíš se vzepřít náčelníkovi? Odvážíš se čelit mému nemilosrdnému soudu?"
      },
      "name": "Vrchní velitel Saurfang",
      "translationMetadata": {
        "fields": {
          "dialogue.4d9a9f09db0a7bb5d136": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.5d65fd712ae27a164e39": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
