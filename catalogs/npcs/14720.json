    "svSE": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Se på denna fallna drake, $r. Hordens makt kan inte betvivlas!",
        "5d65fd712ae27a164e39": "Jag är den som vakar över dem. Jag är vedergällningens näve, den som kuvar de motsträviga. Vågar du trotsa krigshövdingen? Vågar du möta min skoningslösa dom?"
      },
      "name": "Högöverherre Saurfang",
