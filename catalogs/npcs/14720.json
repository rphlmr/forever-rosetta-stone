    "esES": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Mira al dragón caído, $r. ¡El poder de la Horda es incuestionable!",
        "5d65fd712ae27a164e39": "Yo soy quien les observa. Soy el puño del castigo. Quien aplasta a los obstinados. ¿Osas desafiar al Jefe de Guerra? ¿Osas enfrentarte a mi castigo despiadado?"
      },
      "name": "Alto señor supremo Colmillosauro",
      "translationMetadata": {
