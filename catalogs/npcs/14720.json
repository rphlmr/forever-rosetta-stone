          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Se på denne faldne drage, $r. Hordens styrke kan ikke betvivles!",
        "5d65fd712ae27a164e39": "Jeg er den, der holder øje med dem. Jeg er gengældelsens næve, som undertvinger de genstridige. Tør du trodse krigshøvdingen? Tør du møde min nådesløse dom?"
      },
      "name": "Overherre Saurfang",
      "translationMetadata": {
        "fields": {
          "dialogue.4d9a9f09db0a7bb5d136": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
