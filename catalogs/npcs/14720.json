    "hrHR": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Pogledaj ovog palog zmaja, $r. Moć Horde neupitna je!",
        "5d65fd712ae27a164e39": "Ja sam onaj koji ih nadzire. Ja sam šaka odmazde koja pokorava neposlušne. Usuđuješ li se prkositi ratnom poglavici? Usuđuješ li se suočiti s mojom nemilosrdnom presudom?"
      },
      "name": "Visoki vrhovni gospodar Saurfang",
