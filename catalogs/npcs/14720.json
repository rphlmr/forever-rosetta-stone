    "enUS": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Look to this fallen dragon, $r. The might of the Horde is unquestionable!",
        "5d65fd712ae27a164e39": "I am he that watches they. I am the fist of retribution. That which does quell the recalcitrant. Dare you defy the Warchief? Dare you face my merciless judgement?"
      },
      "name": "High Overlord Saurfang",
      "translationMetadata": {
        "fields": {
          "dialogue.4d9a9f09db0a7bb5d136": {
            "origin": "community",
