        }
      }
    },
    "deDE": {
      "dialogue": {
        "4d9a9f09db0a7bb5d136": "Sieh dir diesen gefallenen Drachen an, $R. Die Macht der Horde ist unbestreitbar!",
        "5d65fd712ae27a164e39": "Ich bin der, der alle Verräter beobachtet. Ich bin die Faust der Vergeltung, die die Widerspenstigen bezwingt. Wagt Ihr es, Euch dem Kriegshäuptling zu widersetzen? Wagt Ihr es, Euch meinem gnadenlosen Urteil zu stellen?"
      },
      "name": "Hochfürst Saurfang",
      "translationMetadata": {
        "fields": {
          "dialogue.4d9a9f09db0a7bb5d136": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
