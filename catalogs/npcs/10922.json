    "enUS": {
      "dialogue": {
        "df11ba603c89ced144cc": "I welcome you, $N. And the Emerald Circle welcomes you.$B$BHopefully together we can help rejuventate and protect this once-mighty forest. Many forces seek to destroy it from without... and within.$B$BDo not be persuaded by the power here--it will only corrupt you, like it has this entire land."
      },
      "name": "Greta Mosshoof",
      "subName": "Emerald Circle",
      "translationMetadata": {
        "fields": {
          "dialogue.df11ba603c89ced144cc": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
          },
