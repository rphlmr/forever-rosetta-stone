    "hrHR": {
      "dialogue": {
        "df11ba603c89ced144cc": "Pozdravljam te, $N. I Smaragdni krug ti želi dobrodošlicu.$B$BNadamo se da zajedno možemo obnoviti i zaštititi ovu nekoć moćnu šumu. Mnoge je sile nastoje uništiti izvana... i iznutra.$B$BNe dopusti da te zavede moć ovoga mjesta. Samo će te iskvariti, kao što je iskvarila cijelu ovu zemlju."
      },
      "name": "Greta Mosshoof",
      "translationMetadata": {
        "fields": {
          "dialogue.df11ba603c89ced144cc": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
