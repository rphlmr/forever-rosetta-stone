        }
      }
    },
    "plPL": {
      "dialogue": {
        "df11ba603c89ced144cc": "Witaj, $N. Szmaragdowy Krąg również cię wita.$B$BMam nadzieję, że razem pomożemy odnowić i ochronić ten niegdyś potężny las. Wiele sił próbuje go zniszczyć z zewnątrz... i od wewnątrz.$B$BNie daj się skusić tutejszej mocy. Skaża cię tak, jak skaziła całą tę krainę."
      },
      "name": "Greta Mosshoof",
      "translationMetadata": {
        "fields": {
          "dialogue.df11ba603c89ced144cc": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
