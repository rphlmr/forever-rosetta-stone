            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "df11ba603c89ced144cc": "Minhas boas-vindas, $N. E o Círculo Esmeraldino lhe dá boas-vindas, também.\n\nTenho esperança de que juntos possamos ajudar a rejuvenescer e proteger esta outrora imponente floresta. Várias forças querem destruí-la de fora para dentro... e de dentro para fora.\n\nNão se deixe persuadir pelo poder daqui, ele só vai corromper você assim como fez com toda esta terra."
      },
      "name": "Greta Musgo no Casco",
      "subName": "Círculo Esmeraldino",
      "translationMetadata": {
        "fields": {
          "dialogue.df11ba603c89ced144cc": {
