    "esES": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "Si estás aquí por la comida, ¡bienvenido!  No encontrarás mejor comida en todo Stormwind... ¡ni en Azeroth! Si estás aquí por otros asuntos, por favor, sé breve.  Tengo una docena de platos en preparación, y debo cuidar de cada uno.",
        "506efdfc863876d10bc4": "Quiero ver tus mercancías.",
        "ff2b10894448f5a54b3a": "Entréname."
      },
