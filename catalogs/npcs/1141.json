    "daDK": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "Hvis du er her for madens skyld, så velkommen! Du finder ikke bedre mad i hele Stormwind... eller Azeroth!$B$BHvis du er her i et andet ærinde, så fat dig venligst i korthed. Jeg er ved at tilberede et dusin retter og må passe hver enkelt.",
        "506efdfc863876d10bc4": "Jeg vil gerne se dine varer.",
        "ff2b10894448f5a54b3a": "Træn mig."
      },
      "name": "Angus Stern",
      "translationMetadata": {
        "fields": {
