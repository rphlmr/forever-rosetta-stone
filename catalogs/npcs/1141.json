    "enUS": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "If you're here for the food, then welcome!  You won't find finer dining in all of Stormwind...or Azeroth!$B$BIf you're here on other matters, then please be brief.  I have a dozen dishes in preparation, and must care for each.",
        "506efdfc863876d10bc4": "I want to browse your goods.",
        "ff2b10894448f5a54b3a": "Train me."
      },
      "name": "Angus Stern",
      "subName": "Head Chef",
