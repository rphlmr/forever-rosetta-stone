    "ltLT": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "Jei atėjai pavalgyti, sveikas atvykęs! Geresnio maisto nerasi visame Stormwind... ar net Azeroth!$B$BJei atėjai kitais reikalais, prašau kalbėti trumpai. Ruošiu tuziną patiekalų ir kiekvienam turiu skirti dėmesio.",
        "506efdfc863876d10bc4": "Noriu apžiūrėti tavo prekes.",
        "ff2b10894448f5a54b3a": "Išmokyk mane."
      },
      "name": "Angus Stern",
      "subName": "Vyriausiasis virėjas",
