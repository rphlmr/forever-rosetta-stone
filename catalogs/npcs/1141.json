    "hrHR": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "Ako si ovdje zbog hrane, dobro došao! Bolje jelo nećeš pronaći u cijelom Stormwindu... ni Azerothu!$B$BAko si ovdje zbog nečeg drugog, molim te budi kratak. Pripremam desetak jela i moram paziti na svako.",
        "506efdfc863876d10bc4": "Želim pogledati vašu robu.",
        "ff2b10894448f5a54b3a": "Podučite me."
      },
      "name": "Angus Stern",
