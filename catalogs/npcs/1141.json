    "ptBR": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "Se veio pela comida, seja bem-vindo! Você não encontrará refeição melhor em toda Ventobravo... ou em Azeroth!$B$BSe veio por outro assunto, seja breve. Tenho uma dúzia de pratos em preparo e preciso cuidar de cada um.",
        "506efdfc863876d10bc4": "Quero ver suas mercadorias.",
        "ff2b10894448f5a54b3a": "Treine-me."
      },
