  "locales": {
    "csCZ": {
      "dialogue": {
        "3a82a598cb271a9b0f50": "Jestli jsi tu kvůli jídlu, vítej! Lepší kuchyni nenajdeš v celém Stormwindu... ani na Azerothu!$B$BPokud máš jinou záležitost, buď prosím stručný. Připravuji tucet jídel a musím se věnovat každému z nich.",
        "506efdfc863876d10bc4": "Rád bych si prohlédl vaše zboží.",
        "ff2b10894448f5a54b3a": "Vycvičte mě."
      },
      "name": "Angus Stern",
      "translationMetadata": {
        "fields": {
          "dialogue.3a82a598cb271a9b0f50": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
