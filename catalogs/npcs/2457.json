    "daDK": {
      "dialogue": {
        "762f4bd23e07241adefd": "Velkommen til Stormwind Bank. Vi tilbyder konti og bankbokse til værdigenstande. Har De allerede en konto hos os, $g herre : frue;?",
        "7d340dca0ef037f52dcb": "Velkommen til Stormwind Bank. Vi tilbyder konti og bankbokse til værdigenstande. Har De allerede en konto hos os, $g herre : frue;?",
        "c9ee832690a4f254c0ed": "Ingen har nogensinde stjålet noget herfra. Ikke i hele historien... hele historien!",
        "zephras:54fef075e1b4e38f411e": "Jeg vil gerne se i min bankboks."
      },
      "name": "John Burnside",
