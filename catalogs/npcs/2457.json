    "ltLT": {
      "dialogue": {
        "762f4bd23e07241adefd": "Sveiki atvykę į Stormwind banką. Siūlome sąskaitas ir seifus vertingiems daiktams laikyti. Ar jau turite pas mus sąskaitą, $g pone : ponia;?",
        "7d340dca0ef037f52dcb": "Sveiki atvykę į Stormwind banką. Siūlome sąskaitas ir seifus vertingiems daiktams laikyti. Ar jau turite pas mus sąskaitą, $g pone : ponia;?",
        "c9ee832690a4f254c0ed": "Iš čia dar niekas nieko nepavogė. Per visą... visą istoriją!",
        "zephras:54fef075e1b4e38f411e": "Norėčiau patikrinti savo seifą."
      },
