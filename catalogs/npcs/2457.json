    "ptBR": {
      "dialogue": {
        "762f4bd23e07241adefd": "Bem-vindo ao Banco de Ventobravo. Nossos serviços incluem contas correntes e compartimentos bancários para itens valiosos. Você já nosso cliente, senhor?",
        "7d340dca0ef037f52dcb": "Bem-vinda ao Banco de Ventobravo. Nossos serviços incluem contas correntes e compartimentos bancários para itens valiosos. Você já nossa cliente, senhora?",
        "c9ee832690a4f254c0ed": "Ninguém nunca roubou nada daqui. Nunca na história da... da história inteira!",
        "zephras:54fef075e1b4e38f411e": "Gostaria de conferir meu cofre."
      },
