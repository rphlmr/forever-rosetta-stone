    "plPL": {
      "dialogue": {
        "762f4bd23e07241adefd": "Witamy w banku Stormwind. Oferujemy konta i skrytki na cenne przedmioty. Czy ma już $g pan : pani; u nas konto?",
        "7d340dca0ef037f52dcb": "Witamy w banku Stormwind. Oferujemy konta i skrytki na cenne przedmioty. Czy ma już $g pan : pani; u nas konto?",
        "c9ee832690a4f254c0ed": "Nikt nigdy niczego stąd nie ukradł. Przez całą historię... całą historię!",
        "zephras:54fef075e1b4e38f411e": "Chcę zajrzeć do swojej skrytki bankowej."
