  "locales": {
    "csCZ": {
      "dialogue": {
        "762f4bd23e07241adefd": "Vítejte v bance Stormwindu. Nabízíme finanční účty a bezpečnostní schránky na cennosti. Máte u nás již účet, $g pane : paní;?",
        "7d340dca0ef037f52dcb": "Vítejte v bance Stormwindu. Nabízíme finanční účty a bezpečnostní schránky na cennosti. Máte u nás již účet, $g pane : paní;?",
        "c9ee832690a4f254c0ed": "Nikdo odsud nikdy nic neukradl. Za celou historii... za celou historii!",
        "zephras:54fef075e1b4e38f411e": "Chtěl bych se podívat do své bezpečnostní schránky."
      },
      "name": "John Burnside",
      "translationMetadata": {
