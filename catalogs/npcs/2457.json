    "deDE": {
      "dialogue": {
        "762f4bd23e07241adefd": "Willkommen bei der Bank von Stormwind. Wir bieten Bankkonten und Schließfächer für wertvolle Gegenstände. Habt Ihr bereits ein Konto bei uns, werter Herr?",
        "7d340dca0ef037f52dcb": "Willkommen bei der Bank von Stormwind. Wir bieten Bankkonten und Schließfächer für wertvolle Gegenstände. Habt Ihr bereits ein Konto bei uns, gnädige Frau?",
        "c9ee832690a4f254c0ed": "Hier wurde noch nie etwas gestohlen. Noch nie in der ganzen Geschichte von... der ganzen Geschichte!",
        "zephras:54fef075e1b4e38f411e": "Ich möchte einen Blick in mein Schließfach werfen."
      },
      "name": "John Burnside",
      "subName": "Bankier",
