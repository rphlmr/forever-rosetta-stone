    "enUS": {
      "dialogue": {
        "762f4bd23e07241adefd": "Welcome to the Bank of Stormwind. We offer financial accounts and safety deposit boxes for valuable items. Do you already have an account with us $g sir : ma'am;?",
        "7d340dca0ef037f52dcb": "Welcome to the Bank of Stormwind. We offer financial accounts and safety deposit boxes for valuable items. Do you already have an account with us $g sir : ma'am;?",
        "c9ee832690a4f254c0ed": "No one's ever stolen anything out of here. Not in the whole history of... the whole history!",
        "zephras:54fef075e1b4e38f411e": "I would like to check my deposit box."
      },
      "name": "John Burnside",
      "subName": "Banker",
