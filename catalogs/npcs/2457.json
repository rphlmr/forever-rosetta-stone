    "svSE": {
      "dialogue": {
        "762f4bd23e07241adefd": "Välkommen till Stormwinds bank. Vi erbjuder konton och bankfack för värdesaker. Har ni redan ett konto hos oss, $g herrn : frun;?",
        "7d340dca0ef037f52dcb": "Välkommen till Stormwinds bank. Vi erbjuder konton och bankfack för värdesaker. Har ni redan ett konto hos oss, $g herrn : frun;?",
        "c9ee832690a4f254c0ed": "Ingen har någonsin stulit något härifrån. Inte under hela historien... hela historien!",
        "zephras:54fef075e1b4e38f411e": "Jag skulle vilja titta i mitt bankfack."
      },
