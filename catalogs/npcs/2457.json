    "hrHR": {
      "dialogue": {
        "762f4bd23e07241adefd": "Dobro došli u banku Stormwinda. Nudimo račune i sefove za dragocjenosti. Imate li već račun kod nas, $g gospodine : gospođo;?",
        "7d340dca0ef037f52dcb": "Dobro došli u banku Stormwinda. Nudimo račune i sefove za dragocjenosti. Imate li već račun kod nas, $g gospodine : gospođo;?",
        "c9ee832690a4f254c0ed": "Nitko nikada ništa nije ukrao odavde. Ni u cijeloj povijesti... cijeloj povijesti!",
        "zephras:54fef075e1b4e38f411e": "Želim pogledati svoj bankovni sef."
      },
      "name": "John Burnside",
