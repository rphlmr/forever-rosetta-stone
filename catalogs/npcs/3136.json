  "locales": {
    "csCZ": {
      "dialogue": {
        "35e30bc92e795906891d": "Jo, doslechla jsem se, že tě dřív nebo později uvidím. Ale neberu jen tak někoho, nejdřív se musím ujistit, že na to máš. Podstoupíš mou malou zkoušku a zjistíš to?",
        "3e7401c221c3bcc565d1": "Vycvičte mě.",
        "e13beeb4ff9eb1bf2069": "Nevynořuj se takhle ze stínů. Příště mě aspoň předem varuj.",
        "e9c8ea8f8465b842e5b4": "Od chvíle, kdy Duskwood pohltily stíny, nemohu spát. Ve větru mě budí přízračné zvuky křiku. Zní to skoro jako křičící jehňata a neustává to."
      },
      "name": "Clarise Gnarltree",
      "translationMetadata": {
        "fields": {
          "dialogue.35e30bc92e795906891d": {
