          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "160e3ea99eeea5a5be77": "Navnet er Burninate, smedning er min sag... og øh... jeg sælger også lidt mad og vand ved siden af. Vil du have noget kød?",
        "ac96f1f8751006eed9a1": "Du har gjort alt, hvad jeg bad dig om, $n. Der er ikke mere til dig her. Hvis du vil fortsætte som agent for Thoriumbroderskabet, så tal med Lokhtos Darkbargainer i Grim Guzzler i Blackrock Depths.$B$BFarvel!",
        "d676bab4b4ce3f9e75ad": "Jeg vil gerne se dine varer."
      },
      "name": "Smedemester Burninate",
      "translationMetadata": {
        "fields": {
          "dialogue.160e3ea99eeea5a5be77": {
            "origin": "ai",
