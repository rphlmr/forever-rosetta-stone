  "locales": {
    "csCZ": {
      "dialogue": {
        "160e3ea99eeea5a5be77": "Říkají mi Burninate a kovařina je moje živobytí... a, ehm... bokem prodávám trochu jídla a vody. Dáš si maso?",
        "ac96f1f8751006eed9a1": "Splnil jsi vše, oč jsem tě požádal, $n. Nic dalšího tu pro tebe není. Pokud chceš pokračovat jako zástupce Thoriového bratrstva, promluv si s Lokthosem Darkbargainerem v Grim Guzzleru v Blackrock Depths.$B$BSbohem!",
        "d676bab4b4ce3f9e75ad": "Rád bych si prohlédl tvé zboží."
      },
      "name": "Kovářský mistr Burninate",
      "translationMetadata": {
        "fields": {
          "dialogue.160e3ea99eeea5a5be77": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
