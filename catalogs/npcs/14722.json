  "locales": {
    "csCZ": {
      "dialogue": {
        "91ec1f000865f676c313": "Příteli, Stormwind potřebuje tvou pomoc a štědrost!$B$BNaše kdysi veliké zásoby látek jsou kriticky nízké. Stormwind nyní vyvíjí úsilí na několika frontách, aby zásoby pro výrobu textilií a obvazů obnovil! Tvůj dar látek by Stormwindu nesmírně pomohl a získal by sis také úctu jeho obyvatel!"
      },
      "name": "Clavicus Knavingham",
      "translationMetadata": {
        "fields": {
          "dialogue.91ec1f000865f676c313": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
