    "plPL": {
      "dialogue": {
        "91ec1f000865f676c313": "Przyjacielu, Stormwind potrzebuje twojej pomocy i hojności!$B$BNasze niegdyś ogromne zapasy tkanin są na wyczerpaniu. Stormwind podejmuje teraz wielokierunkowe wysiłki, by odnowić zapasy potrzebne do produkcji tkanin i bandaży! Twój dar materiałów ogromnie pomógłby miastu i zapewnił ci szacunek mieszkańców!"
      },
      "name": "Clavicus Knavingham",
      "translationMetadata": {
