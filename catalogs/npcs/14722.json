    "ltLT": {
      "dialogue": {
        "91ec1f000865f676c313": "Drauge, Stormwind reikia tavo pagalbos ir dosnumo!$B$BKadaise didelės mūsų audinių atsargos kritiškai išseko. Dabar Stormwind deda visas pastangas, kad papildytų šias atsargas audiniams ir tvarsčiams gaminti! Paaukotas audinys labai padėtų Stormwind, o tau pelnytų miestiečių pagarbą!"
      },
      "name": "Clavicus Knavingham",
      "subName": "Aljanso audinių tiekėjas",
