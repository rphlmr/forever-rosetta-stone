    "enUS": {
      "dialogue": {
        "91ec1f000865f676c313": "Friend - Stormwind needs your assistance and your generosity!$B$BOur once large stockpile of textiles has run critically low.  Stormwind is now engaged in a multi-pronged effort to rebuild those stocks for the manufacture of textiles and bandages!  Your donation of cloth would help Stormwind immensely, as well as earn the respect of the citizenry!"
      },
      "name": "Clavicus Knavingham",
      "subName": "Alliance Cloth Quartermaster",
      "translationMetadata": {
        "fields": {
