        }
      }
    },
    "daDK": {
      "dialogue": {
        "91ec1f000865f676c313": "Ven, Stormwind har brug for din hjælp og gavmildhed!$B$BVores engang så store lager af stof er kritisk lavt. Stormwind arbejder nu på flere fronter for at genopbygge lagrene til fremstilling af tekstiler og forbindinger! Din donation af stof ville hjælpe Stormwind enormt og give dig borgernes respekt!"
      },
      "name": "Clavicus Knavingham",
      "translationMetadata": {
        "fields": {
