    "plPL": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Chcę przejrzeć twoje towary.",
        "ef20ddf50f5320026734": "Spocznij, $C. Jeśli tylko tędy przechodzisz, radzę trzymać się dróg i podróżować wyłącznie za dnia. Jeśli masz sprawy w Darkshire, rozważ użyczenie swych umiejętności Nocnej Straży. Nasze umiejętności są niezaprzeczalne, lecz jest nas niewielu.",
        "fc410799339c484d2f4b": "Wyszkol mnie."
      },
      "name": "Dowódczyni Althea Ebonlocke",
      "translationMetadata": {
        "fields": {
          "dialogue.8a93d3d36e9d570ea985": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
