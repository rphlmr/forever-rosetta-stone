    "svSE": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Jag vill se dina varor.",
        "ef20ddf50f5320026734": "Lediga, $C. Om du bara är på genomresa föreslår jag att du håller dig till vägarna och bara färdas på dagen. Om du har ärenden här i Darkshire, överväg att ställa dina förmågor till Nattvaktens tjänst. Vår skicklighet är obestridlig, men vi är få.",
        "fc410799339c484d2f4b": "Träna mig."
      },
      "name": "Befälhavare Althea Ebonlocke",
      "translationMetadata": {
        "fields": {
          "dialogue.8a93d3d36e9d570ea985": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
