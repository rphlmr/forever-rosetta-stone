            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Vorrei vedere la tua merce.",
        "ef20ddf50f5320026734": "Riposo, $C. Se sei solo di passaggio, ti consiglio di restare sulle strade e di viaggiare soltanto di giorno. Se invece hai da fare qui a Darkshire, pensa a mettere le tue capacità al servizio dei Guardiani della Notte. La nostra abilità è fuori discussione, ma siamo in pochi.",
        "fc410799339c484d2f4b": "Addestrami."
      },
      "name": "Comandante Althea Ebonlocke",
      "translationMetadata": {
        "fields": {
