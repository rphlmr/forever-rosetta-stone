    "hrHR": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Želim pogledati vašu robu.",
        "ef20ddf50f5320026734": "Voljno, $C. Ako samo prolaziš, savjetujem ti da se držiš cesta i putuješ samo danju. Ako imaš posla ovdje u Darkshireu, razmisli o tome da svoje sposobnosti ponudiš Noćnoj straži. Naša je vještina neupitna, ali malobrojni smo.",
        "fc410799339c484d2f4b": "Podučite me."
      },
      "name": "Zapovjednica Althea Ebonlocke",
      "translationMetadata": {
        "fields": {
          "dialogue.8a93d3d36e9d570ea985": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
