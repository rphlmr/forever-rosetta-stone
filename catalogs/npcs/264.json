  "locales": {
    "csCZ": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Rád bych si prohlédl vaše zboží.",
        "ef20ddf50f5320026734": "Pohov, $C. Pokud jen procházíš, doporučuji držet se cest a cestovat pouze ve dne. Máš-li však záležitosti zde v Darkshire, zvaž, zda své schopnosti nenabídneš Noční hlídce. Naše dovednosti jsou nesporné, ale je nás málo.",
        "fc410799339c484d2f4b": "Vycvičte mě."
      },
      "name": "Velitelka Althea Ebonlocke",
      "translationMetadata": {
        "fields": {
          "dialogue.8a93d3d36e9d570ea985": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.ef20ddf50f5320026734": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.fc410799339c484d2f4b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Jeg vil gerne se dine varer.",
        "ef20ddf50f5320026734": "Rør, $C. Hvis du blot er på gennemrejse, anbefaler jeg, at du holder dig til vejene og kun rejser om dagen. Har du ærinder her i Darkshire, så overvej at stille dine evner til rådighed for Nattevagten. Vores dygtighed er ubestridelig, men vi er få.",
        "fc410799339c484d2f4b": "Træn mig."
      },
      "name": "Kommandør Althea Ebonlocke",
      "translationMetadata": {
        "fields": {
          "dialogue.8a93d3d36e9d570ea985": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.ef20ddf50f5320026734": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.fc410799339c484d2f4b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Ich möchte Eure Waren ansehen.",
        "ef20ddf50f5320026734": "Rühren, $C.  Wenn Ihr nur auf der Durchreise seid, schlage ich vor, dass Ihr auf den Straßen bleibt und nur bei Tag reist. Wenn Ihr hier in Darkshire zu tun habt, solltet Ihr Eure Fähigkeiten der Nachtwache zur Verfügung stellen.  Unsere Fähigkeiten sind unbestreitbar, aber unsere Zahl ist gering.",
        "fc410799339c484d2f4b": "Bildet mich aus."
      },
      "name": "Kommandantin Althea Ebonlocke",
      "subName": "Anführerin der Nachtwache",
      "translationMetadata": {
        "fields": {
          "dialogue.8a93d3d36e9d570ea985": {
