            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Quero ver suas mercadorias.",
        "ef20ddf50f5320026734": "À vontade, $C. Se estiver apenas de passagem, sugiro que siga pelas estradas e viaje somente durante o dia. Se tiver negócios aqui em Vila Sombria, considere oferecer suas habilidades à Patrulha Noturna. Nossa competência é inquestionável, mas somos poucos.",
        "fc410799339c484d2f4b": "Treine-me."
      },
      "name": "Comandante Aldora Ebanez",
      "subName": "Líder da Vigília Noturna",
      "translationMetadata": {
        "fields": {
