    "esES": {
      "dialogue": {
        "8a93d3d36e9d570ea985": "Quiero ver tus mercancías.",
        "ef20ddf50f5320026734": "Descanse, $C.  Si sólo estás de paso, te sugiero que te quedes en los caminos y sólo viajes de día. Si tu negocio está aquí en Darkshire, considera prestar tus habilidades a la Guardia de la Noche.  Nuestra habilidad es incuestionable, pero nuestros números son pequeños.",
        "fc410799339c484d2f4b": "Entréname."
      },
      "name": "Comandante Althea Cerranegro",
      "subName": "Líder de La Guardia Nocturna",
