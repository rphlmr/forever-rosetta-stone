    "hrHR": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Govori tiho i vrlo oprezno. Pogrešna riječ ovdje bi te mogla stajati života. Što trebaš od mene?",
        "7eded19ef949b89a0805": "Želim pogledati vašu robu."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
