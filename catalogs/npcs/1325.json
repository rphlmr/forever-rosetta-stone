  "locales": {
    "csCZ": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Mluv tiše a velmi opatrně. Špatné slovo tě tady může stát život. Co ode mě potřebuješ?",
        "7eded19ef949b89a0805": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
        "fields": {
