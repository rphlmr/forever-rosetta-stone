    },
    "daDK": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Tal lavmælt og meget forsigtigt. Et forkert ord her kan koste dig livet. Hvad har du brug for?",
        "7eded19ef949b89a0805": "Jeg vil gerne se dine varer."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
        "fields": {
          "dialogue.6aeff1a7121cbe7f879c": {
