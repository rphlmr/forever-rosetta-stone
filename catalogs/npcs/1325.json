    "frFR": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Parlez calmement et choisissez bien vos mots. Ici, se tromper de vocabulaire peut vous mener droit au tombeau. Que voulez-vous ?",
        "7eded19ef949b89a0805": "Je voudrais regarder vos articles."
      },
      "name": "Jasper Fel",
      "subName": "Marchand douteux",
