    "trTR": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Alçak sesle ve çok dikkatli konuş. Buralarda yanlış bir söz boğazının kesilmesine yol açabilir. Benden ne istiyorsun?",
        "7eded19ef949b89a0805": "Mallarına bakmak istiyorum."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
        "fields": {
          "dialogue.6aeff1a7121cbe7f879c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
