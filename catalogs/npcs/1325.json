    "esES": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Habla bajito y con cuidado. Pronunciar una palabra equivocada por estos lugares puede hacer que te corten el cuello. Y bien, ¿en qué puedo ayudarte?",
        "7eded19ef949b89a0805": "Quiero ver tus mercancías."
      },
      "name": "Jasper Vil",
      "subName": "Vendedor sospechoso",
