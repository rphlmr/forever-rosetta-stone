    "enUS": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Speak quietly and with great care, the wrong word in these parts could get your throat cut. Now, what is it you need from me?",
        "7eded19ef949b89a0805": "I want to browse your goods."
      },
      "name": "Jasper Fel",
      "subName": "Shady Dealer",
      "translationMetadata": {
