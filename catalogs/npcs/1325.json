    },
    "ptBR": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Fale baixo e com muito cuidado, nestas bandas a palavra errada pode te matar. Agora me diga o que você quer.",
        "7eded19ef949b89a0805": "Quero ver suas mercadorias."
      },
      "name": "Jasper Fel",
      "subName": "Negociante Escuso",
      "translationMetadata": {
        "fields": {
