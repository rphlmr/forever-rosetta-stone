    "plPL": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Mów cicho i bardzo ostrożnie. Jedno niewłaściwe słowo może cię tu kosztować życie. Czego ode mnie potrzebujesz?",
        "7eded19ef949b89a0805": "Chcę przejrzeć twoje towary."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
        "fields": {
          "dialogue.6aeff1a7121cbe7f879c": {
