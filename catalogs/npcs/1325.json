          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Sprecht leise und vorsichtig. Ein falsches Wort kann Euch hierzulande den Kopf kosten. Nun denn, was ist Euer Begehr?",
        "7eded19ef949b89a0805": "Ich möchte Eure Waren ansehen."
      },
      "name": "Jasper Fel",
      "subName": "Zwielichtiger Händler",
      "translationMetadata": {
