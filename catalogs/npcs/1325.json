    "itIT": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Parla a bassa voce e scegli bene le parole: da queste parti, una parola sbagliata può farti tagliare la gola. Allora, cosa ti serve da me?",
        "7eded19ef949b89a0805": "Vorrei vedere la tua merce."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
