    "svSE": {
      "dialogue": {
        "6aeff1a7121cbe7f879c": "Tala tyst och mycket försiktigt. Ett felaktigt ord kan kosta dig livet här. Vad behöver du av mig?",
        "7eded19ef949b89a0805": "Jag vill se dina varor."
      },
      "name": "Jasper Fel",
      "translationMetadata": {
        "fields": {
