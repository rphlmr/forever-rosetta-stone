    "ltLT": {
      "dialogue": {
        "04c8be93320edf4c56a5": "Balai Lok'Wein iš Brackenwall kaimo Dustwallow pelkėje parduoda vadovą, kurį turėsi išstudijuoti, kad patobulintum savo įgūdžius!",
        "63056c02d376374c5bc8": "Mokyk mane.",
        "6cf98785c45c056f38b0": "Galiu išmokyti tave pirmosios pagalbos metodų.",
        "ee78ad2c4da99cdc43f9": "Dabar tavo įgūdžius gali patobulinti tik garsusis daktaras Gregory Victor.  Jį rasi Hammerfall gyvenvietėje Arathi aukštumose."
      },
      "name": "Pand Stonebinder",
      "subName": "Pirmosios pagalbos mokytojas",
