    "hrHR": {
      "dialogue": {
        "04c8be93320edf4c56a5": "Balai Lok’Wein iz Brackenwall Villagea u Dustwallow Marshu prodaje priručnik koji moraš proučiti kako bi poboljšao svoje vještine!",
        "63056c02d376374c5bc8": "Podučite me.",
        "6cf98785c45c056f38b0": "Mogu te naučiti tehnikama prve pomoći.",
        "ee78ad2c4da99cdc43f9": "Samo slavni doktor Gregory Victor sada može poboljšati tvoju vještinu. Možeš ga pronaći u Hammerfallu u Arathi Highlandsu."
      },
      "name": "Pand Stonebinder",
