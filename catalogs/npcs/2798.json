    "daDK": {
      "dialogue": {
        "04c8be93320edf4c56a5": "Balai Lok’Wein i Brackenwall Village i Dustwallow Marsh sælger en håndbog, som du skal studere for at forbedre dine evner!",
        "63056c02d376374c5bc8": "Træn mig.",
        "6cf98785c45c056f38b0": "Jeg kan lære dig førstehjælpsteknikker.",
        "ee78ad2c4da99cdc43f9": "Kun den berømte doktor Gregory Victor kan forbedre dine evner nu. Han findes i Hammerfall i Arathi Highlands."
      },
      "name": "Pand Stonebinder",
