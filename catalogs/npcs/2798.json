  "locales": {
    "csCZ": {
      "dialogue": {
        "04c8be93320edf4c56a5": "Balai Lok’Wein z Brackenwall Village v Dustwallow Marsh prodává příručku, kterou si musíš prostudovat, abys zlepšil své schopnosti!",
        "63056c02d376374c5bc8": "Vycvičte mě.",
        "6cf98785c45c056f38b0": "Mohu tě naučit techniky první pomoci.",
        "ee78ad2c4da99cdc43f9": "Tvé schopnosti teď může zlepšit jedině proslulý doktor Gregory Victor. Najdeš ho v Hammerfall v Arathi Highlands."
      },
      "name": "Pand Stonebinder",
