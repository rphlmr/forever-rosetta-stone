    "plPL": {
      "dialogue": {
        "04c8be93320edf4c56a5": "Balai Lok’Wein z Brackenwall Village w Dustwallow Marsh sprzedaje podręcznik, który musisz przestudiować, aby rozwinąć swoje umiejętności!",
        "63056c02d376374c5bc8": "Wyszkol mnie.",
        "6cf98785c45c056f38b0": "Mogę nauczyć cię technik pierwszej pomocy.",
        "ee78ad2c4da99cdc43f9": "Tylko słynny doktor Gregory Victor może teraz rozwinąć twoje umiejętności. Znajdziesz go w Hammerfall w Arathi Highlands."
      },
      "name": "Pand Stonebinder",
