    "enUS": {
      "dialogue": {
        "04c8be93320edf4c56a5": "Balai Lok'Wein of Brackenwall Village in Dustwallow Marsh sells a manual that you will need to study in order to improve your skills!",
        "63056c02d376374c5bc8": "Train me.",
        "6cf98785c45c056f38b0": "I can train you in First Aid techniques.",
        "ee78ad2c4da99cdc43f9": "Only the renowned Doctor Gregory Victor can improve your skill now.  He can be found in Arathi Highlands at Hammerfall."
      },
      "name": "Pand Stonebinder",
      "subName": "First Aid Trainer",
