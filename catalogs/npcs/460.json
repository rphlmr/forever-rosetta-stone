  "locales": {
    "csCZ": {
      "dialogue": {
        "6993344f92723e1ebb0b": "Mám zájem o výcvik v umění černokněžníků.",
        "7610c900b98ed86bcf6e": "Mám zájem o výcvik v umění černokněžníků.",
        "865daa8bb5427ae00776": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvé naučené talenty?",
        "bcc2d6e822adbc8dbddd": "Tajemná magie kazí jen slabé. Pokračuj ve výcviku, jinak tě může potkat stejný osud.",
        "e604685cb224f042f479": "Obávám se, že tvá míra temnoty nestačí na to, abych se s tebou dále obtěžoval. Prosím, jdi dál.",
        "f441950302b8844e7185": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!"
      },
      "name": "Alamar Grimm",
      "translationMetadata": {
        "fields": {
