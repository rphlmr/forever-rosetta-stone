    "hrHR": {
      "dialogue": {
        "6993344f92723e1ebb0b": "Zanima me poduka u umijeću vještaca.",
        "7610c900b98ed86bcf6e": "Zanima me poduka u umijeću vještaca.",
        "865daa8bb5427ae00776": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao podučiti iznova. Ta je usluga svaki put sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "bcc2d6e822adbc8dbddd": "Tajanstvena magija kvari samo slabe. Nastavi s obukom ili bi te mogla zadesiti ista sudbina.",
        "e604685cb224f042f479": "Bojim se da tvoja razina tame nije dovoljna da bih dalje razgovarao s tobom. Produži, molim te.",
        "f441950302b8844e7185": "Nisi čarobnjak tame i nemam vremena za tebe. Gubi se!"
      },
      "name": "Alamar Grimm",
      "translationMetadata": {
        "fields": {
          "dialogue.6993344f92723e1ebb0b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
