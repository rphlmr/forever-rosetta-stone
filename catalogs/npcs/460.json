    "daDK": {
      "dialogue": {
        "6993344f92723e1ebb0b": "Jeg er interesseret i træning som troldmand.",
        "7610c900b98ed86bcf6e": "Jeg er interesseret i træning som troldmand.",
        "865daa8bb5427ae00776": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "bcc2d6e822adbc8dbddd": "Arkan magi fordærver kun de svage. Fortsæt din træning, ellers kan du lide samme skæbne.",
        "e604685cb224f042f479": "Jeg er bange for, at dit mørke ikke er tilstrækkeligt til, at jeg gider tale mere med dig. Gå venligst videre.",
        "f441950302b8844e7185": "Du er ingen troldmand, og jeg har ikke tid til dig. Forsvind!"
      },
      "name": "Alamar Grimm",
      "translationMetadata": {
        "fields": {
