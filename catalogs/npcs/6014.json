  "locales": {
    "csCZ": {
      "dialogue": {
        "0acafd077a20396dbfac": "Udělám, co mohu, abych tě naučila kněžským cestám, pokud jsi kvůli tomu tady.",
        "b03f3503894c94a86a44": "Dávej na sebe pozor, $c. Cti naše zvyky, jinak stihne tebe i tvé blízké kletba.",
        "ce28440f4da876991444": "Hledám další výcvik v kněžském umění.",
        "ff1aa0d41569d1477f6f": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dosud naučili, abych je mohla učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talenty, které ses naučil?"
      },
      "name": "X'yera",
      "translationMetadata": {
        "fields": {
          "dialogue.0acafd077a20396dbfac": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
