    "plPL": {
      "dialogue": {
        "139c84dad0579d458c85": "Nastał czas, gdy rok jest nowy, a księżyc świeci jasno.$B$BTo nasz czas... gdy pradawni się budzą.",
        "b129334a1c5bd9d313a3": "Starszy Ironband mieszka w jaskini Blackchar w Searing Gorge.",
