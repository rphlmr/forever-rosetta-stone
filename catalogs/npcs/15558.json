    "daDK": {
      "dialogue": {
        "139c84dad0579d458c85": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "b129334a1c5bd9d313a3": "Ældste Ironband bor i Blackchar Cave i Searing Gorge.",
        "ef01c847347aaeb4c5cd": "Ældste Goldwell opholder sig i landsbyen Kharanos i Dun Morogh."
      },
      "name": "Ældste Silvervein",
      "translationMetadata": {
