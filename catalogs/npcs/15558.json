    "enUS": {
      "dialogue": {
        "139c84dad0579d458c85": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "b129334a1c5bd9d313a3": "Elder Ironband lives in Blackchar Cave in Searing Gorge.",
        "ef01c847347aaeb4c5cd": "Elder Goldwell spends his time in the village of Kharanos in Dun Morogh."
      },
      "name": "Elder Silvervein",
