    "ltLT": {
      "dialogue": {
        "139c84dad0579d458c85": "Atėjo metas, kai metai nauji, o mėnulis šviečia skaisčiai.$B$BTai mūsų metas... kai senoliai pabunda.",
        "b129334a1c5bd9d313a3": "Senolis Ironband gyvena Blackchar urve, Searing Gorge.",
