    "ptBR": {
      "dialogue": {
        "139c84dad0579d458c85": "Agora é a hora em que o ano ainda é jovem e a lua brilha forte.\n\nÉ a nossa hora... a hora em que despertam os ancestrais.",
        "b129334a1c5bd9d313a3": "O ancião Bandaferro mora na Caverna Calcinar, em Garganta Abrasadora.",
        "ef01c847347aaeb4c5cd": "O ancião Poçodouro passa seu tempo na vila de Kharanos, em Dun Morogh."
      },
      "name": "Ancião Venaprata",
