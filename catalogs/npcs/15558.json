    "hrHR": {
      "dialogue": {
        "139c84dad0579d458c85": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude.",
        "b129334a1c5bd9d313a3": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu.",
        "ef01c847347aaeb4c5cd": "Starješina Goldwell provodi vrijeme u selu Kharanos u Dun Moroghu."
      },
      "name": "Starješina Silvervein",
