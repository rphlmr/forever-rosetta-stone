    "deDE": {
      "dialogue": {
        "139c84dad0579d458c85": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "b129334a1c5bd9d313a3": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht.",
        "ef01c847347aaeb4c5cd": "Urahne Goldwell verbringt seine Zeit im Dorf Kharanos in Dun Morogh."
      },
      "name": "Urahne Silvervein",
