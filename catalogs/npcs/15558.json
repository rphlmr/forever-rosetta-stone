  "locales": {
    "csCZ": {
      "dialogue": {
        "139c84dad0579d458c85": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... kdy se pradávní probouzejí.",
        "b129334a1c5bd9d313a3": "Stařešina Ironband žije v jeskyni Blackchar v Searing Gorge.",
        "ef01c847347aaeb4c5cd": "Stařešina Goldwell tráví čas ve vesnici Kharanos v Dun Morogh."
      },
      "name": "Starší Silvervein",
      "translationMetadata": {
