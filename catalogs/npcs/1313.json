    },
    "daDK": {
      "dialogue": {
        "76cc213cb0e45c00635c": "Jeg sælger kun det fineste magiske udstyr, fremstillet af håndværkerne og magikerne her i Stormwind.",
        "b689e3a829c3fdcbe1ca": "Jeg vil gerne se dine varer.",
        "f9469f88a058f2aa3043": "Siden Dalarans fald og ødelæggelsen af Quel'Thalas har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere gør et flot stykke arbejde med at levere kvalitetsvarer til vores bestillinger."
      },
      "name": "Maria Lumere",
      "translationMetadata": {
        "fields": {
          "dialogue.76cc213cb0e45c00635c": {
