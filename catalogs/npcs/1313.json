    "hrHR": {
      "dialogue": {
        "76cc213cb0e45c00635c": "Prodajem samo najbolju arkansku opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu.",
        "b689e3a829c3fdcbe1ca": "Želim pogledati vašu robu.",
        "f9469f88a058f2aa3043": "Od pada Dalarana i uništenja Quel'Thalasa do takve je robe teško doći. No Lucan Cordell i neki od naših drugih obrtnika izvrsno ispunjavaju naše narudžbe kvalitetnom robom."
      },
      "name": "Maria Lumere",
      "translationMetadata": {
