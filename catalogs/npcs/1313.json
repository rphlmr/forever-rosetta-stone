  "locales": {
    "csCZ": {
      "dialogue": {
        "76cc213cb0e45c00635c": "Prodávám jen to nejlepší magické vybavení, které vyrábějí řemeslníci a mágové zde ve Stormwindu.",
        "b689e3a829c3fdcbe1ca": "Chci si prohlédnout vaše zboží.",
        "f9469f88a058f2aa3043": "Od pádu Dalaranu a zničení Quel'Thalasu je takové zboží těžké sehnat. Lucan Cordell a někteří další naši řemeslníci však odvádějí skvělou práci a dodávají nám kvalitní zboží."
      },
      "name": "Maria Lumere",
      "translationMetadata": {
        "fields": {
          "dialogue.76cc213cb0e45c00635c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
