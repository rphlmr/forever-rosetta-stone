    },
    "deDE": {
      "dialogue": {
        "76cc213cb0e45c00635c": "Ich verkaufe nur die beste arkane Ausrüstung, gemacht von den Handwerkern und Magiern hier in Stormwind.",
        "b689e3a829c3fdcbe1ca": "Ich möchte Eure Waren ansehen.",
        "f9469f88a058f2aa3043": "Seit dem Fall von Dalaran und der Zerstörung von Quel'Thalas sind solche Waren schwer zu bekommen. Aber Lucan Cordell und einige andere unserer Handwerker haben es geschafft, für unsere Bestellungen erstklassige Handelsware zu besorgen."
      },
      "name": "Maria Lumere",
      "subName": "Alchimiebedarf",
      "translationMetadata": {
