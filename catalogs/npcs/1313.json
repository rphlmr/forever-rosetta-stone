    "enUS": {
      "dialogue": {
        "76cc213cb0e45c00635c": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "b689e3a829c3fdcbe1ca": "I want to browse your goods.",
        "f9469f88a058f2aa3043": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise."
      },
      "name": "Maria Lumere",
      "subName": "Alchemy Supplies",
      "translationMetadata": {
