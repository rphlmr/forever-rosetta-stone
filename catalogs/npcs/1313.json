    "svSE": {
      "dialogue": {
        "76cc213cb0e45c00635c": "Jag säljer bara den finaste magiska utrustningen, tillverkad av hantverkare och magiker här i Stormwind.",
        "b689e3a829c3fdcbe1ca": "Jag vill se dina varor.",
        "f9469f88a058f2aa3043": "Sedan Dalarans fall och förstörelsen av Quel'Thalas har varor av det här slaget varit svåra att få tag på. Men Lucan Cordell och några av våra andra hantverkare gör ett utmärkt jobb med att fylla våra beställningar med kvalitetsvaror."
      },
      "name": "Maria Lumere",
      "translationMetadata": {
        "fields": {
          "dialogue.76cc213cb0e45c00635c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.b689e3a829c3fdcbe1ca": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f9469f88a058f2aa3043": {
