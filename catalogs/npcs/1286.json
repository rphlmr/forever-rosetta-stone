    "csCZ": {
      "dialogue": {
        "35b21cd280d7f74f15e2": "Rád bych si prohlédl vaše zboží.",
        "654527ec9e90b9c849ab": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?",
        "99bf0cbd0a7dc405e80d": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?"
      },
      "name": "Edna Mullby",
