    "daDK": {
      "dialogue": {
        "35b21cd280d7f74f15e2": "Jeg vil gerne se dine varer.",
        "654527ec9e90b9c849ab": "De bedste tilbud i hele Stormwind, min ven. Du finder ingen bedre. Hvad kan jeg hjælpe dig med?",
        "99bf0cbd0a7dc405e80d": "Ser du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?"
      },
      "name": "Edna Mullby",
