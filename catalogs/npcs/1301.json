    "enUS": {
      "dialogue": {
        "171a44f65b6b0a529d67": "I want to browse your goods.",
        "310be9fc24b3ee97a3d3": "Best deals in all of Stormwind my friend, won't find any better. Now, what can I help you with?",
        "c56c4efeebbbaa548e61": "Just browsing my wares or is there something specific I can help you find today?"
      },
      "name": "Julia Gallina",
      "subName": "Wine Vendor",
