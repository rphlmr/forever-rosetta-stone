    "csCZ": {
      "dialogue": {
        "171a44f65b6b0a529d67": "Rád bych si prohlédl vaše zboží.",
        "310be9fc24b3ee97a3d3": "Nejlepší ceny v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?",
        "c56c4efeebbbaa548e61": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?"
      },
      "name": "Julia Gallina",
