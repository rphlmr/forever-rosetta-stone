    "daDK": {
      "dialogue": {
        "171a44f65b6b0a529d67": "Jeg vil gerne se dine varer.",
        "310be9fc24b3ee97a3d3": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe dig med?",
        "c56c4efeebbbaa548e61": "Kigger du bare på mine varer, eller kan jeg hjælpe dig med at finde noget bestemt i dag?"
      },
      "name": "Julia Gallina",
      "translationMetadata": {
