  "locales": {
    "csCZ": {
      "dialogue": {
        "0733fc5a374956fcbc22": "Potřebuji výcvik válečníka.",
        "117a2dd10c3e01be81ff": "Přísným přeškolením jsem musel mnoho žáků odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je pokaždé obtížnější, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "17fa04e12b98e57954c1": "Kvůli nekompatibilitě specifikace tvého povolání ti nemohu pomoci napravit případný nedostatek schopností.",
        "925d045bfe8f8ea4295f": "Výborně! Splňuješ požadované parametry a specifikace. Co pro tebe mohu udělat?"
      },
      "name": "Bilban Tosslespanner",
      "translationMetadata": {
        "fields": {
          "dialogue.0733fc5a374956fcbc22": {
