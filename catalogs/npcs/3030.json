  "locales": {
    "csCZ": {
      "dialogue": {
        "2c4dcf97f291ca43e273": "Ať jsou duchové s tebou.",
        "2daf07080a800ba924e0": "Duchové tě ke mně přivedli. Jak mohu posloužit?",
        "b926ca555f63d27e28cd": "Nauč mě cestám duchů.",
        "c6450bc287a52dc8c622": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl vyučit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto i dražší. Přeješ si zapomenout naučené talenty?",
        "e9d78a370a282fc84fea": "Kromě výcviku mohu na přání vymazat z tvé mysli znalost talentů. Varuji tě, že každý další zákrok je těžší a tedy dražší."
      },
      "name": "Siln Skychaser",
      "translationMetadata": {
        "fields": {
