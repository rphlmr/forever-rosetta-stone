    "hrHR": {
      "dialogue": {
        "44664a208d8370ccdadb": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Tu je uslugu svaki put teže pružiti, pa je zato svaka sljedeća preobuka skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "60b8d8890ac56a31443e": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "99661356f85fece514b9": "Ako želiš, osim obuke mogu iz tvojeg uma izbrisati znanje o tvojim talentima. Znaj da je taj postupak svaki put teže provesti, pa je stoga i skuplji.",
        "9b7976855d86a4e0416c": "Neka duhovi budu s tobom.",
        "ec3c2b2964d7ca7b9ebc": "Nauči me putovima duhova."
      },
      "name": "Sagorne Creststrider",
