  "locales": {
    "csCZ": {
      "dialogue": {
        "31517a9e4ff09637ec8f": "Karn říká, že musíme naslouchat duchům výhně a oceli, že nás povedou. Já slyším jen zvonění v uších. Tady, vezmi kladivo a zkusme těm duchům naslouchat společně.",
        "4ac8c5b975534aeb33b3": "Vycvičte mě.",
        "694785fae14c9a933b88": "Asi tě mají duchové radši než mě. Já jejich volání stále neslyšel, ale zdá se, že ty ses z jejich lekcí dobře poučil. Promluv si s Karnem, bude nadšený, že někdo slyší duchy jako on.",
        "8282a153be58de94b3c3": "Naslouchám a naslouchám, ale ty duchy, o kterých Karn mluví, neslyším. "
      },
      "name": "Thrag Stonehoof",
      "translationMetadata": {
        "fields": {
          "dialogue.31517a9e4ff09637ec8f": {
