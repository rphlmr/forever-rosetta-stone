    "deDE": {
      "dialogue": {
        "6a940730cd0d7304206d": "Ich möchte Eure Waren ansehen.",
        "8a87afb7efdb934add25": "Seid gegrüßt, $C. Seid wachsam, wenn Ihr nach Osten zum Bollwerk reist. Aktuellen Spähermeldungen zufolge ist in dem Bereich eine erhöhte Aktivität der Greißel zu verzeichnen. Hier ist also Vorsicht geboten.",
        "ed36c21e8c42398251a9": "Bildet mich aus."
      },
      "name": "Todeswache Linnea",
