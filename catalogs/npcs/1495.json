    "daDK": {
      "dialogue": {
        "6a940730cd0d7304206d": "Jeg vil gerne se dine varer.",
        "8a87afb7efdb934add25": "Hilsner, $C. Vær på vagt, når du rejser østpå mod Bulwark. Nye overvågningsrapporter viser øget aktivitet fra Svøben i området, så vær forsigtig.",
        "ed36c21e8c42398251a9": "Træn mig."
      },
      "name": "Dødsvagt Linnea",
      "translationMetadata": {
