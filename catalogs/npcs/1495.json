    "hrHR": {
      "dialogue": {
        "6a940730cd0d7304206d": "Želim pogledati vašu robu.",
        "8a87afb7efdb934add25": "Pozdrav, $C. Budi na oprezu dok putuješ na istok prema Bulwarku. Nedavna izviđačka izvješća ukazuju na pojačanu aktivnost Pošasti u tom području, zato pazi.",
        "ed36c21e8c42398251a9": "Podučite me."
      },
      "name": "Smrtna stražarka Linnea",
