  "locales": {
    "csCZ": {
      "dialogue": {
        "6a940730cd0d7304206d": "Chci si prohlédnout vaše zboží.",
        "8a87afb7efdb934add25": "Zdravím, $C. Při cestě na východ k Bulwarku buď ve střehu. Nedávná hlášení průzkumníků svědčí o zvýšené aktivitě Pohromy v této oblasti, proto jednej opatrně.",
        "ed36c21e8c42398251a9": "Vycvičte mě."
      },
      "name": "Smrtistrážkyně Linnea",
      "translationMetadata": {
        "fields": {
          "dialogue.6a940730cd0d7304206d": {
