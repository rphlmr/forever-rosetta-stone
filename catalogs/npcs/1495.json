    "ltLT": {
      "dialogue": {
        "6a940730cd0d7304206d": "Noriu apžiūrėti jūsų prekes.",
        "8a87afb7efdb934add25": "Sveiki, $C. Keliaudami į rytus, link The Bulwark, būkite budrūs. Naujausi žvalgybos pranešimai rodo, kad toje vietovėje suaktyvėjo Scourge, todėl būkite atsargūs.",
        "ed36c21e8c42398251a9": "Išmokykite mane."
      },
      "name": "Mirties sargybinė Linnea",
