    "ptBR": {
      "dialogue": {
        "6a940730cd0d7304206d": "Quero ver suas mercadorias.",
        "8a87afb7efdb934add25": "Saudações, $C. Tome cuidado ao viajar para leste em direção ao Baluarte. Relatórios recentes de vigilância indicam maior atividade do Flagelo naquela região, portanto mantenha-se alerta.",
        "ed36c21e8c42398251a9": "Treine-me."
