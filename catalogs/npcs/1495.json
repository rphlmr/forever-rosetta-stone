    "plPL": {
      "dialogue": {
        "6a940730cd0d7304206d": "Chcę przejrzeć twoje towary.",
        "8a87afb7efdb934add25": "Witaj, $C. Zachowaj czujność w drodze na wschód ku Bulwarkowi. Ostatnie meldunki zwiadowców wskazują na wzmożoną aktywność Plagi w tej okolicy, więc miej się na baczności.",
        "ed36c21e8c42398251a9": "Wyszkol mnie."
      },
      "name": "Strażniczka śmierci Linnea",
