    "daDK": {
      "dialogue": {
        "d9e24756d98853c43e49": "Remulos’ helligdom er et helligt sted for os i Cenarioncirklen her i Moonglade... så opfør dig venligst som en passende gæst.$B$BEn gæst, der ikke ønsker at få min krumsabel begravet i sig, altså."
      },
      "name": "Tajarri",
      "translationMetadata": {
        "fields": {
