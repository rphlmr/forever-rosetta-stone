    "enUS": {
      "dialogue": {
        "d9e24756d98853c43e49": "The Shrine of Remulos is a sacred place for us in the Cenarion Circle here in Moonglade... so please conduct yourself in a manner befitting a visitor.$B$BA visitor who doesn't want my scimitar buried in them, that is."
      },
      "name": "Tajarri",
