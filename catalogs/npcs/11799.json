    "csCZ": {
      "dialogue": {
        "d9e24756d98853c43e49": "Remulova svatyně je pro nás z Cenarijského kruhu tady v Moonglade posvátným místem... chovej se tedy, prosím, jako řádný návštěvník.$B$BTedy návštěvník, který nechce mít v těle můj šavlový meč."
      },
      "name": "Tajarri",
      "translationMetadata": {
