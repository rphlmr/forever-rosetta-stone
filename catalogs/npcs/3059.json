    "hrHR": {
      "dialogue": {
        "070ab2cb7cd3246435f1": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Ta usluga svakim je izvođenjem sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "0e76b95883c70433bc3a": "Ne mogu te podučavati, $c.",
        "46960c63419e4094df50": "Bez obzira na to koliko naučiš, uvijek ima još znanja.",
        "7015b7697fa1e92e7de9": "Trebam ratničku obuku."
      },
      "name": "Harutt Thunderhorn",
      "translationMetadata": {
