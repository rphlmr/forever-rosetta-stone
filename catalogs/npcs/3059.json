    "trTR": {
      "dialogue": {
        "070ab2cb7cd3246435f1": "Titiz bir yeniden eğitimle birçok öğrenciye daha önce öğrendiklerini unutturup onları baştan eğitmem gerekti. Sunduğum hizmet her seferinde zorlaşıyor. Bu yüzden her yeniden eğitimde ücreti de artıyor. Öğrendiğin yetenekleri sana unutturmamı ister misin?",
        "0e76b95883c70433bc3a": "Seni eğitemem, $c.",
        "46960c63419e4094df50": "İnsan ne kadar öğrenirse öğrensin, her zaman bilecek daha çok şey vardır.",
        "7015b7697fa1e92e7de9": "Savaşçı eğitimi almak istiyorum."
      },
      "name": "Harutt Thunderhorn",
