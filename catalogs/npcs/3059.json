  "locales": {
    "csCZ": {
      "dialogue": {
        "070ab2cb7cd3246435f1": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl učit znovu. Tato služba je pokaždé obtížnější, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil získané talenty?",
        "0e76b95883c70433bc3a": "Nemohu tě vycvičit, $c.",
        "46960c63419e4094df50": "Ať se člověk naučí sebevíc, vždy je co dalšího poznávat.",
        "7015b7697fa1e92e7de9": "Potřebuji výcvik válečníka."
      },
      "name": "Harutt Thunderhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.070ab2cb7cd3246435f1": {
