  "locales": {
    "csCZ": {
      "dialogue": {
        "170f003662f63ae17875": "Vycvičte mě.",
        "25c4a9ae54d602540df4": "Působíš sebejistě. Určitě ti nebude vadit zkouška tvých schopností?",
        "2d9b3515c707164b6b1d": "Skutečný profesionál zná své hranice a nestydím se přiznat, že mě tvé schopnosti převyšují. Navštiv Kittu Firewind ve věži Azora. Je proslulá, a právem.",
        "6ad72de2e5d67171f336": "Tvá sebedůvěra je oprávněná, cestovateli. Nyní může začít tvé skutečné vzdělání!",
        "8139d477ff9e307dc6fe": "Pokud na to máš, rád ti ukážu cestu.",
        "b7d884616c77a3b4e865": "Nejsi připraven. Promluv si s Betty Quinn, stojí tamhle u schodů. Vrať se, až dosáhneš vyššího osvícení."
      },
      "name": "Lucan Cordell",
      "translationMetadata": {
