    "daDK": {
      "dialogue": {
        "170f003662f63ae17875": "Træn mig.",
        "25c4a9ae54d602540df4": "Du virker selvsikker. Du har vel ikke noget imod at få dine evner prøvet?",
        "2d9b3515c707164b6b1d": "En sand fagperson kender sine begrænsninger, og jeg skammer mig ikke over at indrømme, at dine evner overgår mine. Besøg Kitta Firewind i Tower of Azora. Hun er berømt, og med god grund.",
        "6ad72de2e5d67171f336": "Din selvtillid er velbegrundet, rejsende. Nu kan din egentlige uddannelse begynde!",
        "8139d477ff9e307dc6fe": "Hvis du har evnerne, viser jeg dig gerne vejen.",
        "b7d884616c77a3b4e865": "Du er ikke klar. Tal med Betty Quinn, hun står ved trappen derovre. Kom tilbage, når du har opnået større indsigt."
      },
      "name": "Lucan Cordell",
      "translationMetadata": {
        "fields": {
