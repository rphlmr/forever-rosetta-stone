    "esES": {
      "dialogue": {
        "170f003662f63ae17875": "Entréname.",
        "25c4a9ae54d602540df4": "Pareces muy seguro, así que no te importará que ponga a prueba tus habilidades, ¿verdad?",
        "2d9b3515c707164b6b1d": "Un verdadero profesional conoce sus límites, y no me avergüenza admitir que tus habilidades superan a las mías. Quiero que hagas una visita a Kitta Vientofuego en la Torre de Azora. Tiene buena fama, y por buenas razones.",
        "6ad72de2e5d67171f336": "Tu confianza está bien fundada, viajero. ¡Que comience tu verdadera educación!",
        "8139d477ff9e307dc6fe": "Si tienes lo necesario, estaré encantado de enseñarte.",
        "b7d884616c77a3b4e865": "No estás preparado. Habla con Betty Quinn, la encontrarás junto a las escaleras. Vuelve aquí cuando tu preparación haya mejorado."
      },
      "name": "Lucan Cordell",
      "subName": "Experto encantador",
      "translationMetadata": {
