    "hrHR": {
      "dialogue": {
        "170f003662f63ae17875": "Podučite me.",
        "25c4a9ae54d602540df4": "Djeluješ samouvjereno. Sigurno ti neće smetati provjera tvojih vještina?",
        "2d9b3515c707164b6b1d": "Pravi profesionalac poznaje svoje granice i ne sramim se priznati da tvoje vještine nadmašuju moje. Posjeti Kittu Firewind u Tower of Azori. Glasovita je, i to s dobrim razlogom.",
        "6ad72de2e5d67171f336": "Tvoje je samopouzdanje opravdano, putniče. Sada može početi tvoje pravo obrazovanje!",
        "8139d477ff9e307dc6fe": "Ako imaš što je potrebno, rado ću ti pokazati put.",
        "b7d884616c77a3b4e865": "Nisi spreman. Razgovaraj s Betty Quinn, stoji ondje uz stube. Vrati se kad postigneš viši stupanj prosvjetljenja."
      },
