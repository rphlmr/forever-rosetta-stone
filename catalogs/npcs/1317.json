    "enUS": {
      "dialogue": {
        "170f003662f63ae17875": "Train me.",
        "25c4a9ae54d602540df4": "You seem confident. Surely you wouldn't mind a test of your skills?",
        "2d9b3515c707164b6b1d": "A true professional know his limitations, and I'm not ashamed to admit that your skills exceed mine. I want you to pay a visit to Kitta Firewind at the Tower of Azora. She is well-renowned, and with good reason.",
        "6ad72de2e5d67171f336": "Your confidence is well-founded, traveler. Now your true education may begin!",
        "8139d477ff9e307dc6fe": "If you have what it takes, I will be happy to show you the way.",
        "b7d884616c77a3b4e865": "You are not ready. Speak to Betty Quinn, she's standing by the stairs over there. Return to me when you have achieved a higher enlightenment."
      },
      "name": "Lucan Cordell",
      "subName": "Expert Enchanter",
