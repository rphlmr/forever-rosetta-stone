  "locales": {
    "csCZ": {
      "dialogue": {
        "29db2a440631b9280b10": "Rád bych si prohlédl vaše zboží.",
        "5bf43ad014e4c5fe0c32": "Vycvičte mě.",
        "8e760c7c320d4641f323": "Ti parchanti na nás zaútočili v noci, když už jsme měli pár skleniček v sobě. Jinak bychom si s nimi poradili, na to vem jed.$B$BVšichni jsou teď mrtví... až na pár z nás."
      },
      "name": "Prospektor Ryedol",
