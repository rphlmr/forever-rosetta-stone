    "deDE": {
      "dialogue": {
        "29db2a440631b9280b10": "Ich möchte Eure Waren ansehen.",
        "5bf43ad014e4c5fe0c32": "Bildet mich aus.",
        "8e760c7c320d4641f323": "Die Bastarde kamen nachts direkt auf uns zu, nachdem wir ein paar Drinks zu uns genommen hatten. Sonst hätten wir es mit ihnen aufnehmen können, verlass dich drauf.\n\nJetzt sind alle tot... außer ein paar von uns."
      },
      "name": "Ausgrabungsleiter Ryedol",
      "subName": "Forscherliga",
