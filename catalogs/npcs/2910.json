    },
    "daDK": {
      "dialogue": {
        "29db2a440631b9280b10": "Jeg vil gerne se dine varer.",
        "5bf43ad014e4c5fe0c32": "Træn mig.",
        "8e760c7c320d4641f323": "Slynglerne overfaldt os om natten, efter vi havde fået et par drinks. Ellers havde vi klaret dem, det kan du tro.$B$BNu er alle døde... undtagen nogle få af os."
      },
      "name": "Prospektør Ryedol",
      "translationMetadata": {
