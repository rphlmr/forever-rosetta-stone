    "deDE": {
      "dialogue": {
        "aa842fe073c635649aa5": "Ich werde Euch die Kunst des Hammerschmieds lehren. Bittet einfach nett darum.",
        "c5ea1e2ef2f7d76c529d": "Kommt nicht zu nahe, $n. Ich bin ungeschickt und könnte Euch den Schädel mit der Vorderseite meines Hammers einschlagen."
      },
      "name": "Lilith die Liebliche",
