    "daDK": {
      "dialogue": {
        "aa842fe073c635649aa5": "Jeg vil lære dig hammermedens håndværk. Du skal bare spørge pænt.",
        "c5ea1e2ef2f7d76c529d": "Kom ikke for tæt på, $n. Jeg kunne komme til at fumle og slå hjernen ud på dig med hammeren."
      },
      "name": "Lilith den Smidige",
      "translationMetadata": {
        "fields": {
