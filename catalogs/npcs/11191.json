    "csCZ": {
      "dialogue": {
        "aa842fe073c635649aa5": "Naučím tě umění kováře kladiv. Stačí pěkně poprosit.",
        "c5ea1e2ef2f7d76c529d": "Nechoď příliš blízko, $n. Mohla bych se ohnat nešikovně a rozbít ti hlavu kladivem."
      },
      "name": "Lilith Ohebná",
