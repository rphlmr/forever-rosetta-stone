    "enUS": {
      "dialogue": {
        "aa842fe073c635649aa5": "I will teach you the way of the hammersmith. Just ask nicely.",
        "c5ea1e2ef2f7d76c529d": "Don't get too close, $n. I'm liable to fumble and bash your brains open with the face of my hammer."
      },
      "name": "Lilith the Lithe",
