    "ptBR": {
      "dialogue": {
        "aa842fe073c635649aa5": "Eu lhe ensinarei a arte de forjar martelos. Basta pedir com educação.",
        "c5ea1e2ef2f7d76c529d": "Não chegue muito perto, $n. Posso acabar arrancando e esmagando os seus miolos com o meu martelo."
