    "plPL": {
      "dialogue": {
        "0de26dd7da09580331ff": "Duchy przywiodły cię do mnie. Jak mogę pomóc?",
        "0f7106c71277b1ad41ac": "Jeśli chcesz, oprócz szkolenia mogę też wymazać z twojego umysłu wiedzę o talentach. Ostrzegam, że za każdym razem zabieg jest trudniejszy, a przez to droższy."
      },
      "name": "Eldrun Stormbreaker",
