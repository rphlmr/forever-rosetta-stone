    "csCZ": {
      "dialogue": {
        "0de26dd7da09580331ff": "Duchové tě ke mně dovedli. Jak ti mohu posloužit?",
        "0f7106c71277b1ad41ac": "Pokud si přeješ, mohu kromě výcviku také vymazat znalost tvých talentů z tvé mysli. Varuji tě, že s každým opakováním je tento postup těžší, a proto také dražší."
      },
      "name": "Eldrun Stormbreaker",
