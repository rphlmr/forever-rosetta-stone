    "enUS": {
      "dialogue": {
        "0de26dd7da09580331ff": "The spirits have guided you to me. How may I be of service?",
        "0f7106c71277b1ad41ac": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes."
      },
      "name": "Eldrun Stormbreaker",
      "subName": "Shaman Trainer",
