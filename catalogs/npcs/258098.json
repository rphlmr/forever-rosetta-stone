    "daDK": {
      "dialogue": {
        "0de26dd7da09580331ff": "Ånderne har ført dig til mig. Hvordan kan jeg hjælpe?",
        "0f7106c71277b1ad41ac": "Hvis du ønsker det, kan jeg ud over træning slette kendskabet til dine talenter fra dit sind. Vær advaret om, at proceduren bliver vanskeligere og derfor dyrere, hver gang du gennemgår den."
      },
      "name": "Eldrun Stormbreaker",
      "translationMetadata": {
