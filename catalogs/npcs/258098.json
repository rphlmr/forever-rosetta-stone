    "ltLT": {
      "dialogue": {
        "0de26dd7da09580331ff": "Dvasios tave atvedė pas mane. Kuo galiu tau padėti?",
        "0f7106c71277b1ad41ac": "Jei pageidauji, galiu ne tik tave mokyti, bet ir ištrinti iš tavo atminties žinias apie tavo talentus. Įspėju: kaskart atliekant šią procedūrą, ji tampa vis sunkesnė, todėl ir brangesnė."
      },
      "name": "Eldrun Stormbreaker",
