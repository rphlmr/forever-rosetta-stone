    "hrHR": {
      "dialogue": {
        "0de26dd7da09580331ff": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "0f7106c71277b1ad41ac": "Ako želiš, osim obuke mogu iz tvog uma izbrisati znanje o tvojim talentima. Upozoravam te da je postupak svaki put teže izvesti pa je stoga i skuplji."
      },
      "name": "Eldrun Stormbreaker",
