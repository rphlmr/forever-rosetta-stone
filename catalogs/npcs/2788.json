    "csCZ": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Ahoj, $n. Vítej v Útočišti.",
        "b39ef44a5d34a69300e7": "Nevšímej si Skuerta, $n. Nechce být nezdvořilý, jen má strašně moc práce. Než dokončí průzkum, co kdybychom se věnovali něčemu užitečnějšímu?"
      },
      "name": "Učeň Kryten",
      "translationMetadata": {
        "fields": {
