    "deDE": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Hallo, $N. Willkommen in der Zuflucht.",
        "b39ef44a5d34a69300e7": "Macht Euch keine Gedanken wegen Skuerto, $n. Er wollte nicht unhöflich sein, er ist einfach nur schwer beschäftigt. Warum tun wir nichts Produktiveres, während wir darauf warten, bis er mit seiner Ausspäherei fertig ist?"
      },
      "name": "Lehrling Kryten",
      "translationMetadata": {
        "fields": {
