    "hrHR": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Pozdrav, $n. Dobro došao u Refuge Pointe.",
        "b39ef44a5d34a69300e7": "Ne obaziri se na Skuerta, $n. Ne želi biti nepristojan, samo je strašno zauzet. Dok čekamo da završi izviđanje, zašto ne bismo radili nešto korisnije?"
      },
      "name": "Naučnik Kryten",
