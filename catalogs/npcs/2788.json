    "daDK": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Hej, $n. Velkommen til Refuge Pointe.",
        "b39ef44a5d34a69300e7": "Tag dig ikke af Skuerto, $n. Han mener det ikke uhøfligt, han har bare frygtelig travlt. Mens vi venter på, at han bliver færdig med at spejde, kunne vi så ikke lave noget mere nyttigt?"
      },
      "name": "Lærling Kryten",
      "translationMetadata": {
        "fields": {
