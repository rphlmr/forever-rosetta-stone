    "itIT": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Salve, $n. Benvenuto a Refuge Pointe.",
        "b39ef44a5d34a69300e7": "Non badare a Skuerto, $N. Non lo fa per scortesia, è solo che ha moltissimo da fare. Mentre aspettiamo che finisca la ricognizione, perché non ci dedichiamo a qualcosa di più produttivo?"
      },
      "name": "Apprendista Kryten",
