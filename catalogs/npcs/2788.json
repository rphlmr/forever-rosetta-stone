    "frFR": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Bonjour, $N. Bienvenue au refuge de l'Ornière.",
        "b39ef44a5d34a69300e7": "Veuillez excuser Skuerto, $N. Il ne voulait pas être grossier, mais il est très occupé. Attendons qu'il ait fini ses explorations et travaillons en attendant sur quelque chose de productif, d'accord ?"
      },
      "name": "Apprenti Kryten",
