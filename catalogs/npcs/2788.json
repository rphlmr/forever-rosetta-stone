    "enUS": {
      "dialogue": {
        "9327db1a2b45ad07c7fa": "Hello, $n. Welcome to Refuge Pointe.",
        "b39ef44a5d34a69300e7": "Don't mind Skuerto, $n. He doesn't mean to be rude, he's just terribly busy. While we wait for him to finish scouting, why don't we work on something more productive?"
      },
      "name": "Apprentice Kryten",
      "translationMetadata": {
        "fields": {
