    "plPL": {
      "dialogue": {
        "35b2635a1f7657662303": "Może nie podążasz ścieżką Światłości jak rycerz Srebrnej Dłoni, ale zawsze możesz poprosić nas o pomoc.",
        "9aaf1d830c88375a3b65": "Światłość z tobą, $c. Jak mogę pomóc?",
        "9d3101cc51bc875da50f": "Chcę dalej szkolić się na ścieżkach Światłości.",
        "a0d771dae13dae43299f": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Za każdym razem ta usługa staje się trudniejsza do wykonania. Dlatego każde kolejne szkolenie jest coraz droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?"
      },
      "name": "Bromos Grummner",
      "translationMetadata": {
        "fields": {
          "dialogue.35b2635a1f7657662303": {
