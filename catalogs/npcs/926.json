  "factionTemplateId": 55,
  "locales": {
    "csCZ": {
      "dialogue": {
        "35b2635a1f7657662303": "Možná nekráčíš cestou Světla jako rytíř Stříbrné ruky, ale vždy nás můžeš požádat o pomoc.",
        "9aaf1d830c88375a3b65": "Světlo s tebou, $c. Jak ti mohu pomoci?",
        "9d3101cc51bc875da50f": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "a0d771dae13dae43299f": "Přísným přeškolením jsem musel mnoho studentů odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?"
      },
      "name": "Bromos Grummner",
      "translationMetadata": {
        "fields": {
          "dialogue.35b2635a1f7657662303": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
