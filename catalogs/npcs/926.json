    "ltLT": {
      "dialogue": {
        "35b2635a1f7657662303": "Gal ir neseki Šviesos keliu kaip Sidabrinės Rankos riteris, bet visada gali prašyti mūsų pagalbos.",
        "9aaf1d830c88375a3b65": "Tebūnie Šviesa su tavimi, $c. Kaip galiu tau padėti?",
        "9d3101cc51bc875da50f": "Norėčiau toliau mokytis Šviesos kelio.",
        "a0d771dae13dae43299f": "Griežtai perkvalifikuodamas turėjau priversti daugybę mokinių pamiršti viską, ką jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Kaskart suteikti šią paslaugą darosi vis sunkiau.  Todėl kiekvienas perkvalifikavimas kainuoja vis brangiau.  Ar nori, kad padėčiau tau pamiršti išmoktus talentus?"
      },
      "name": "Bromos Grummner",
      "subName": "Paladinų mokytojas",
      "translationMetadata": {
