  "locales": {
    "csCZ": {
      "dialogue": {
        "3bab0d33fda54c0eed1e": "Máme tu opravdu krásné počasí, nemyslíš?",
        "8d035bc07d9f32126676": "Já se budu smát naposled... však oni uvidí! Ach, ahoj, $c, nevšimla jsem si tě.",
        "95749647bb4cdf85a6be": "Jak to, že se nikdy nikde nepovaluje gyrochronatom, když ho člověk potřebuje?",
        "e129f7b49efdb44a31c2": "Vynalézání, milý $c, tvoří dvě procenta inspirace v lahvi, čtyři procenta slunečního záření, šestiprocentní šance, že se bouřky do poloviny odpoledne vyjasní, a devadesát tři procent Rumplesnicker.$B$BPočkat, dává to dohromady sto? Někde tady mám poznámky."
      },
      "name": "Umi Rumplesnicker",
      "translationMetadata": {
        "fields": {
          "dialogue.3bab0d33fda54c0eed1e": {
