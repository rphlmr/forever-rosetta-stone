    "hrHR": {
      "dialogue": {
        "3bab0d33fda54c0eed1e": "Baš je krasno vrijeme ovdje, zar ne?",
        "8d035bc07d9f32126676": "Ja ću se posljednja smijati... vidjet će oni! Oh, bok $c, nisam te vidjela.",
        "95749647bb4cdf85a6be": "Zašto nikad nema gyrochronatoma pri ruci kad ti treba?",
        "e129f7b49efdb44a31c2": "Izumiteljstvo je, dragi $c, dva posto inspiracije u boci, četiri posto izloženosti suncu, šest posto izgleda da se grmljavinsko nevrijeme razvedri do sredine poslijepodneva i devedeset tri posto Rumplesnicker.$B$BČekaj, je li to ukupno sto? Negdje ovdje imam bilješke."
      },
      "name": "Umi Rumplesnicker",
