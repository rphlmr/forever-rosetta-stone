    "daDK": {
      "dialogue": {
        "3bab0d33fda54c0eed1e": "Det er da et vældig dejligt vejr, vi har her, synes du ikke?",
        "8d035bc07d9f32126676": "Jeg får det sidste grin... det skal de få at se! Åh, hej $c, jeg så dig ikke.",
        "95749647bb4cdf85a6be": "Hvorfor ligger der aldrig en gyrochronatom i nærheden, når man har brug for en?",
        "e129f7b49efdb44a31c2": "Opfindelse, min kære $c, består af to procent inspiration på flaske, fire procent soleksponering, seks procents chance for at tordenvejret klarer op midt på eftermiddagen og treoghalvfems procent Rumplesnicker.$B$BVent, gav det hundrede? Jeg har mine noter et sted heromkring."
      },
      "name": "Umi Rumplesnicker",
      "translationMetadata": {
        "fields": {
