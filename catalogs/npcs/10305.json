    "enUS": {
      "dialogue": {
        "3bab0d33fda54c0eed1e": "Mighty fine weather we're having here, wouldn't you say?",
        "8d035bc07d9f32126676": "I'll get the last laugh... they'll see! Oh, hi $c, I didn't see you there.",
        "95749647bb4cdf85a6be": "Why is it that there's never a gyrochronatom lying around when you need one?",
        "e129f7b49efdb44a31c2": "Invention, my dear $c, is two percent bottled inspiration, four percent solar exposure, six percent chance of thunderstorms clearing by mid-afternoon, and ninety-three percent Rumplesnicker.$B$BWait, did that add to one hundred? I've got my notes around here somewhere."
      },
      "name": "Umi Rumplesnicker",
      "translationMetadata": {
        "fields": {
