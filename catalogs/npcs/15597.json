  "locales": {
    "csCZ": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Stařešinu Bloodhoofa najdeš v Bloodhoof Village v Mulgore.",
        "2742035a04ad544e234a": "Stařešina High Mountain je v Camp Taurajo v Barrens.",
        "8292d162da2e96fd34e8": "Naposledy jsem slyšel, že stařešina Runetotem cestuje do Razor Hill v Durotaru.",
        "b3fa4ad595934ea47884": "Stařešina Windtotem dělá společnost goblinům z Ratchetu na pobřeží Barrens.",
        "bcc9e1f266454bea42d9": "Hvězdy této doby se ubírají novými cestami, jsou majáky naděje a síly pro nadcházející věky.",
        "cc716c05274f1188d17d": "Stařešina Morningdew se zabavil sledováním ruchu na závodišti Mirage Raceway v Thousand Needles."
      },
      "name": "Starší Moonwarden",
      "translationMetadata": {
