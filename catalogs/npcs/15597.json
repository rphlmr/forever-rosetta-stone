    "ltLT": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Seniūną Bloodhoof gali rasti Bloodhoof kaime, Mulgore.",
        "2742035a04ad544e234a": "Seniūnas High Mountain yra Camp Taurajo, Barrens krašte.",
        "8292d162da2e96fd34e8": "Paskutinį kartą girdėjau, kad seniūnas Runetotem keliauja į Razor Hill, Durotare.",
        "b3fa4ad595934ea47884": "Seniūnas Windtotem leidžia laiką su Ratchet goblinais Barrens pakrantėje.",
        "bcc9e1f266454bea42d9": "Šio meto žvaigždės suka naujais keliais, tapdamos vilties ir stiprybės švyturiais ateinantiems amžiams.",
        "cc716c05274f1188d17d": "Seniūnas Morningdew stebi šurmulį Mirage Raceway lenktynių trasoje, Thousand Needles krašte."
