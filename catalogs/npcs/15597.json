    "daDK": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Ældste Bloodhoof findes i Bloodhoof Village i Mulgore.",
        "2742035a04ad544e234a": "Ældste High Mountain er i Camp Taurajo i Barrens.",
        "8292d162da2e96fd34e8": "Sidst jeg hørte noget, rejste ældste Runetotem til Razor Hill i Durotar.",
        "b3fa4ad595934ea47884": "Ældste Windtotem holder goblinerne i Ratchet ved Barrens’ kyst med selskab.",
        "bcc9e1f266454bea42d9": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "cc716c05274f1188d17d": "Ældste Morningdew er begyndt at følge ståhejen ved Mirage Raceway i Thousand Needles."
      },
      "name": "Ældste Moonwarden",
      "translationMetadata": {
