    "plPL": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Starszego Bloodhoofa znajdziesz w Bloodhoof Village w Mulgore.",
        "2742035a04ad544e234a": "Starszy High Mountain przebywa w Camp Taurajo w Barrens.",
        "8292d162da2e96fd34e8": "Ostatnio słyszałem, że starszy Runetotem podróżował do Razor Hill w Durotarze.",
