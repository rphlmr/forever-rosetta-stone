    "enUS": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Elder Bloodhoof can be found at Bloodhoof Village in Mulgore.",
        "2742035a04ad544e234a": "Elder High Mountain is at Camp Taurajo in the Barrens.",
        "8292d162da2e96fd34e8": "Last I heard, Elder Runetotem was traveling to Razor Hill in Durotar.",
        "b3fa4ad595934ea47884": "Elder Windtotem is keeping company with the goblins of Ratchet on the coast of the Barrens.",
        "bcc9e1f266454bea42d9": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "cc716c05274f1188d17d": "Elder Morningdew has taken to watching the commotion at the Mirage Raceway in Thousand Needles."
      },
      "name": "Elder Moonwarden",
