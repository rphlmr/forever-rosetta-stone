    "trTR": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Yaşlı Bloodhoof’u Mulgore’daki Bloodhoof Village’da bulabilirsin.",
        "2742035a04ad544e234a": "Yaşlı High Mountain, Barrens’taki Camp Taurajo’da.",
        "8292d162da2e96fd34e8": "Son duyduğuma göre Yaşlı Runetotem, Durotar’daki Razor Hill’e gidiyordu.",
        "b3fa4ad595934ea47884": "Yaşlı Windtotem, Barrens kıyısındaki Ratchet goblinlerine arkadaşlık ediyor.",
        "bcc9e1f266454bea42d9": "Bu çağın yıldızları yeni yollara yöneliyor; gelecek çağlar için umut ve güç işaretleri oluyorlar.",
        "cc716c05274f1188d17d": "Yaşlı Morningdew, Thousand Needles’taki Mirage Raceway’deki telaşı izliyor."
