    "svSE": {
      "dialogue": {
        "1c69dbbcc496188d879c": "Äldste Bloodhoof finns i Bloodhoof Village i Mulgore.",
        "2742035a04ad544e234a": "Äldste High Mountain finns i Camp Taurajo i Barrens.",
        "8292d162da2e96fd34e8": "Senast jag hörde var äldste Runetotem på väg till Razor Hill i Durotar.",
        "b3fa4ad595934ea47884": "Äldste Windtotem håller goblinerna i Ratchet på Barrens kust sällskap.",
        "bcc9e1f266454bea42d9": "Denna tids stjärnor följer nya banor, ledstjärnor av hopp och styrka för kommande tidsåldrar.",
        "cc716c05274f1188d17d": "Äldste Morningdew har börjat följa uppståndelsen vid Mirage Raceway i Thousand Needles."
