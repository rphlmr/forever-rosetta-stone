    "itIT": {
      "dialogue": {
        "1c69dbbcc496188d879c": "L'Anziano Bloodhoof si trova a Bloodhoof Village, in Mulgore.",
        "2742035a04ad544e234a": "L'Anziano High Mountain si trova a Camp Taurajo, nelle Barrens.",
        "8292d162da2e96fd34e8": "Le ultime voci dicevano che l'Anziana Runetotem era in viaggio verso Razor Hill, in Durotar.",
        "b3fa4ad595934ea47884": "L'Anziana Windtotem se ne sta in compagnia dei goblin di Ratchet, sulla costa delle Barrens.",
        "bcc9e1f266454bea42d9": "Le stelle di questo tempo sono risolute a seguire nuovi sentieri, fari di speranza e di forza per le ere a venire.",
        "cc716c05274f1188d17d": "L'Anziana Morningdew ha preso l'abitudine di osservare il trambusto alla Pista dei Miraggi, nelle Thousand Needles."
      },
      "name": "Anziano Moonwarden",
      "translationMetadata": {
