      "dialogue": {
        "7e8dba778706f3481503": "Chci si prohlédnout vaše zboží.",
        "837542a71ffd16dafd0a": "Jmenuji se Dran Droffers a tohle je můj hloupý syn Malton. Pokud potřebuješ šrot nebo ho chceš prodat, jsi tu správně!",
        "8b5abefdefc453ce300c": "Vycvičte mě."
      },
      "name": "Dran Droffers",
