        }
      }
    },
    "deDE": {
      "dialogue": {
        "05eda746acbcea3b4100": "Bildet mich aus.",
        "8ba0456f03cb811342b0": "Dieses Lager darf nicht zerstört werden, $C, koste es, was es wolle! Wir dürfen keinen Zentimeter zurückweichen, denn der Feind wird es niemals tun.",
        "bb0d4c594d029f3593f2": "Ich möchte Eure Waren ansehen."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
        "fields": {
