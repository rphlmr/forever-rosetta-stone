    },
    "daDK": {
      "dialogue": {
        "05eda746acbcea3b4100": "Træn mig.",
        "8ba0456f03cb811342b0": "Vi må sikre denne lejrs overlevelse for enhver pris, $c! Vi må ikke vise vores fjender nåde, for de ville ikke vise os nogen, hvis vi havde brug for det.",
        "bb0d4c594d029f3593f2": "Jeg vil gerne se dine varer."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.05eda746acbcea3b4100": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
