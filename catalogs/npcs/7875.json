    "frFR": {
      "dialogue": {
        "05eda746acbcea3b4100": "Entraînez-moi.",
        "8ba0456f03cb811342b0": "Nous devons assurer la survie de ce camp à tout prix, $c !  Nous ne devons pas faire quartier à nos ennemis, car ils ne nous témoigneront de leur part aucune pitié.",
        "bb0d4c594d029f3593f2": "Je voudrais regarder vos articles."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
