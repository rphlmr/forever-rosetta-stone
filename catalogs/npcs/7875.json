    "trTR": {
      "dialogue": {
        "05eda746acbcea3b4100": "Beni eğit.",
        "8ba0456f03cb811342b0": "Bu kampın hayatta kalmasını ne pahasına olursa olsun sağlamalıyız, $c! Düşmanlarımıza merhamet göstermemeliyiz; çünkü ihtiyacımız olsa onlar da bize göstermezdi.",
        "bb0d4c594d029f3593f2": "Mallarına bakmak istiyorum."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
        "fields": {
