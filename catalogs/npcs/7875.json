  "locales": {
    "csCZ": {
      "dialogue": {
        "05eda746acbcea3b4100": "Vycvičte mě.",
        "8ba0456f03cb811342b0": "Musíme za každou cenu zajistit přežití tohoto tábora, $c! Nepřátelům nesmíme dát žádné slitování, protože oni by se nad námi také neslitovali.",
        "bb0d4c594d029f3593f2": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.05eda746acbcea3b4100": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
