    "itIT": {
      "dialogue": {
        "05eda746acbcea3b4100": "Addestrami.",
        "8ba0456f03cb811342b0": "Dobbiamo garantire a ogni costo la sopravvivenza di questo accampamento, $C! Ai nostri nemici non va concessa alcuna pietà, perché di certo loro non ne avrebbero per noi, se ne avessimo bisogno.",
        "bb0d4c594d029f3593f2": "Vorrei vedere la tua merce."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.05eda746acbcea3b4100": {
