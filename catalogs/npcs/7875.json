    "svSE": {
      "dialogue": {
        "05eda746acbcea3b4100": "Träna mig.",
        "8ba0456f03cb811342b0": "Vi måste säkra lägrets överlevnad till varje pris, $c! Vi får inte visa våra fiender någon nåd, för de skulle inte visa oss någon om vi behövde den.",
        "bb0d4c594d029f3593f2": "Jag vill se dina varor."
      },
      "name": "Hadoken Swiftstrider",
