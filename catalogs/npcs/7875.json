    "esES": {
      "dialogue": {
        "05eda746acbcea3b4100": "Entréname.",
        "8ba0456f03cb811342b0": "Debemos asegurar la supervivencia de este campamento a toda costa, $c. No hay que dar cuartel a nuestros enemigos, ya que ellos no nos lo darían si lo necesitásemos nosotros.",
        "bb0d4c594d029f3593f2": "Quiero ver tus mercancías."
      },
      "name": "Hadoken Zancoveloz",
      "translationMetadata": {
