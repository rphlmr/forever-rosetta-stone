    },
    "plPL": {
      "dialogue": {
        "05eda746acbcea3b4100": "Wyszkol mnie.",
        "8ba0456f03cb811342b0": "Musimy za wszelką cenę zapewnić przetrwanie tego obozu, $c! Nie możemy okazać wrogom litości, bo oni z pewnością nie okazaliby jej nam.",
        "bb0d4c594d029f3593f2": "Chcę przejrzeć twoje towary."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
