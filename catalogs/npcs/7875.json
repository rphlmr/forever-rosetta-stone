    "ptBR": {
      "dialogue": {
        "05eda746acbcea3b4100": "Treine-me.",
        "8ba0456f03cb811342b0": "Precisamos assegurar a sobrevivência da aldeia a qualquer custo, $c! Não tenha piedade dos inimigos. Se eles estivessem no seu lugar, eles não teriam de você.",
        "bb0d4c594d029f3593f2": "Quero ver suas mercadorias."
      },
      "name": "Hadoken Passo Veloz",
      "translationMetadata": {
        "fields": {
