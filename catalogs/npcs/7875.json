    },
    "ltLT": {
      "dialogue": {
        "05eda746acbcea3b4100": "Išmokyk mane.",
        "8ba0456f03cb811342b0": "Privalome bet kokia kaina užtikrinti šios stovyklos išlikimą, $c! Neturime pasigailėti savo priešų, nes jie tikrai nepasigailėtų mūsų, jei mums to prireiktų.",
        "bb0d4c594d029f3593f2": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
