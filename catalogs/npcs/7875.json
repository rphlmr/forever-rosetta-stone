    "hrHR": {
      "dialogue": {
        "05eda746acbcea3b4100": "Podučite me.",
        "8ba0456f03cb811342b0": "Moramo pod svaku cijenu osigurati opstanak ovog tabora, $c! Ne smijemo poštedjeti neprijatelje jer ni oni ne bi poštedjeli nas kada bi nam to trebalo.",
        "bb0d4c594d029f3593f2": "Želim pogledati vašu robu."
      },
      "name": "Hadoken Swiftstrider",
      "translationMetadata": {
        "fields": {
