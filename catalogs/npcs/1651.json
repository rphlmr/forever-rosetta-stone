    "enUS": {
      "dialogue": {
        "5be823991afb29defb09": "Train me.",
        "bd6cb3e39f6da87a3d13": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "cd2aa439c3fe734feae2": "I can teach you fishing skills.",
        "d7fe0745d51bbdb2cd39": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently."
      },
      "name": "Lee Brown",
      "subName": "Fisherman",
