    "plPL": {
      "dialogue": {
        "5be823991afb29defb09": "Wyszkol mnie.",
        "bd6cb3e39f6da87a3d13": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze „The Bass and You”. Ta książka z pewnością pomoże ci się doskonalić.",
        "cd2aa439c3fe734feae2": "Mogę nauczyć cię wędkarstwa.",
        "d7fe0745d51bbdb2cd39": "Musisz znaleźć Nata Pagle'a na Bagnach Pyłowych, jeśli chcesz dalej się doskonalić."
      },
      "name": "Lee Brown",
