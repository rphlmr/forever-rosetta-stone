    "hrHR": {
      "dialogue": {
        "5be823991afb29defb09": "Podučite me.",
        "bd6cb3e39f6da87a3d13": "Tvoja je vještina veća od moje, no čuo sam da stari Heming u Booty Bayu ima primjerke knjige „The Bass and You“. Ona će ti sigurno pomoći da se usavršiš.",
        "cd2aa439c3fe734feae2": "Mogu te naučiti ribolovu.",
        "d7fe0745d51bbdb2cd39": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako se želiš dalje usavršavati."
      },
      "name": "Lee Brown",
