    "esES": {
      "dialogue": {
        "5be823991afb29defb09": "Entréname.",
        "bd6cb3e39f6da87a3d13": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "cd2aa439c3fe734feae2": "Puedo enseñarte a pescar.",
        "d7fe0745d51bbdb2cd39": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades."
      },
      "name": "Lee Brown",
      "subName": "Pescador",
