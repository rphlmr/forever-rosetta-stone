    "ltLT": {
      "dialogue": {
        "5be823991afb29defb09": "Pamokyk mane.",
        "bd6cb3e39f6da87a3d13": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senasis Hemingas Booty Bay turi knygos „Ešerys ir tu“ kopijų. Ji tikrai padės tau tobulėti.",
        "cd2aa439c3fe734feae2": "Galiu išmokyti tave žvejybos.",
        "d7fe0745d51bbdb2cd39": "Jei nori tobulėti toliau, turėsi susirasti Nat Pagle Dustwallow Marsh pelkėje."
      },
      "name": "Lee Brown",
      "subName": "Žvejys",
