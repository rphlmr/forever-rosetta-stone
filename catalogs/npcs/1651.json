    "daDK": {
      "dialogue": {
        "5be823991afb29defb09": "Træn mig.",
        "bd6cb3e39f6da87a3d13": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af „The Bass and You“. Den vil helt sikkert hjælpe dig med at blive bedre.",
        "cd2aa439c3fe734feae2": "Jeg kan lære dig at fiske.",
        "d7fe0745d51bbdb2cd39": "Du må finde Nat Pagle i Dustwallow Marsh for at blive bedre, end du er nu."
      },
      "name": "Lee Brown",
      "translationMetadata": {
