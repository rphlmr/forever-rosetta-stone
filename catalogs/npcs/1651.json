    "frFR": {
      "dialogue": {
        "5be823991afb29defb09": "Entraînez-moi.",
        "bd6cb3e39f6da87a3d13": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "cd2aa439c3fe734feae2": "Je peux vous apprendre à pêcher.",
        "d7fe0745d51bbdb2cd39": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange."
      },
      "name": "Lee Brown",
      "subName": "Pêcheur",
