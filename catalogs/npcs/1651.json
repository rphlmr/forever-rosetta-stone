    "deDE": {
      "dialogue": {
        "5be823991afb29defb09": "Bildet mich aus.",
        "bd6cb3e39f6da87a3d13": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern.",
        "cd2aa439c3fe734feae2": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "d7fe0745d51bbdb2cd39": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können."
      },
      "name": "Lee Brown",
      "subName": "Angler",
      "translationMetadata": {
