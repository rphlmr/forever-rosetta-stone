  "locales": {
    "csCZ": {
      "dialogue": {
        "5be823991afb29defb09": "Vycvičte mě.",
        "bd6cb3e39f6da87a3d13": "Tvá dovednost převyšuje mou, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti určitě pomůže se zlepšit.",
        "cd2aa439c3fe734feae2": "Mohu tě naučit rybařit.",
        "d7fe0745d51bbdb2cd39": "Pokud se chceš dále zlepšit, musíš najít Nata Paglea v Dustwallow Marsh."
      },
      "name": "Lee Brown",
      "translationMetadata": {
        "fields": {
          "dialogue.5be823991afb29defb09": {
