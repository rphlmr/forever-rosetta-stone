    "itIT": {
      "dialogue": {
        "5be823991afb29defb09": "Addestrami.",
        "bd6cb3e39f6da87a3d13": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità.",
        "cd2aa439c3fe734feae2": "Posso insegnarti l'arte della pesca.",
        "d7fe0745d51bbdb2cd39": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh."
      },
      "name": "Lee Brown",
