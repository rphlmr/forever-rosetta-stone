    "ptBR": {
      "dialogue": {
        "0d72a72a9a471cc6eafa": "O que posso fazer por você, criança?",
        "0f6a3897a1dd1af82ac2": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "173c3aba109884d4a160": "Gostaria de receber treinamento.",
        "1f6fd0037d301a261313": "Não posso treinar um $c como você."
      },
      "name": "Danlaar Noctandas",
      "subName": "Treinamento de Caçadores",
