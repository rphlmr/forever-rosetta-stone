    "ltLT": {
      "dialogue": {
        "0d72a72a9a471cc6eafa": "Kuo galiu tau padėti, mano vaike?",
        "0f6a3897a1dd1af82ac2": "Griežtai permokydamas ne vieną mokinį turėjau priversti pamiršti visa, ko jis anksčiau išmoko, kad galėčiau išmokyti iš naujo. Su kiekvienu permokymu šią paslaugą suteikti darosi vis sunkiau. Todėl kaskart ji kainuoja vis daugiau. Ar nori, kad priversčiau tave pamiršti išmoktus talentus?",
        "173c3aba109884d4a160": "Norėčiau pasimokyti.",
        "1f6fd0037d301a261313": "Negaliu mokyti tokios klasės kaip $c."
      },
      "name": "Danlaar Nightstride",
