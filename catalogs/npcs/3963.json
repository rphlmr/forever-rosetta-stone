  "locales": {
    "csCZ": {
      "dialogue": {
        "0d72a72a9a471cc6eafa": "Co pro tebe mohu udělat, dítě?",
        "0f6a3897a1dd1af82ac2": "Důsledným přeškolením jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl učit znovu. Tuto službu je při každém dalším provedení těžší poskytnout, a proto je také dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "173c3aba109884d4a160": "Chci se vycvičit.",
        "1f6fd0037d301a261313": "Nemohu cvičit někoho jako ty, $c."
      },
      "name": "Danlaar Nightstride",
      "translationMetadata": {
        "fields": {
