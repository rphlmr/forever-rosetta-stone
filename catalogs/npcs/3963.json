    "hrHR": {
      "dialogue": {
        "0d72a72a9a471cc6eafa": "Što mogu učiniti za tebe, dijete moje?",
        "0f6a3897a1dd1af82ac2": "Strogom sam prekvalifikacijom mnoge učenike morao odviknuti od svega što su prije naučili kako bih ih mogao poučavati iznova. Ta usluga svakim izvođenjem postaje sve teža, pa zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "173c3aba109884d4a160": "Želim obuku.",
        "1f6fd0037d301a261313": "Ne mogu podučavati nekoga poput tebe, $c."
      },
      "name": "Danlaar Nightstride",
