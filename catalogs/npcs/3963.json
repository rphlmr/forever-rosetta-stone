    "plPL": {
      "dialogue": {
        "0d72a72a9a471cc6eafa": "Co mogę dla ciebie zrobić, moje dziecko?",
        "0f6a3897a1dd1af82ac2": "Przez rygorystyczne szkolenie musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc szkolić ich od nowa. Usługa ta staje się coraz trudniejsza przy każdym kolejnym razie, dlatego też kosztuje coraz więcej. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "173c3aba109884d4a160": "Chcę się szkolić.",
        "1f6fd0037d301a261313": "Nie mogę szkolić kogoś takiego jak ty, $c."
      },
      "name": "Danlaar Nightstride",
