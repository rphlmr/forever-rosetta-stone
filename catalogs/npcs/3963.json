    "daDK": {
      "dialogue": {
        "0d72a72a9a471cc6eafa": "Hvad kan jeg gøre for dig, mit barn?",
        "0f6a3897a1dd1af82ac2": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere at udføre for hver gang, og derfor bliver den også dyrere. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?",
        "173c3aba109884d4a160": "Jeg vil gerne trænes.",
        "1f6fd0037d301a261313": "Jeg kan ikke træne en $c som dig."
      },
      "name": "Danlaar Nightstride",
      "translationMetadata": {
        "fields": {
          "dialogue.0d72a72a9a471cc6eafa": {
