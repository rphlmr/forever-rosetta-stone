    "ltLT": {
      "dialogue": {
        "03139d73afded384de73": "Tavo įgūdžiai pranoksta manuosius, tačiau girdėjau, kad senasis Heming iš Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau tobulėti.",
        "29e36d2c568733f2c0d0": "Kad galėtum tobulėti toliau, turėsi surasti Nat Pagle Dustwallow Marsh pelkėje.",
        "571c41b84979aeb638aa": "Mokyk mane.",
        "d7f39d427b340f941da6": "Galiu tave išmokyti žvejoti."
      },
      "name": "Astaia",
      "subName": "Žvejybos mokytoja",
