    "enUS": {
      "dialogue": {
        "03139d73afded384de73": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "29e36d2c568733f2c0d0": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "571c41b84979aeb638aa": "Train me.",
        "d7f39d427b340f941da6": "I can teach you fishing skills."
      },
      "name": "Astaia",
      "subName": "Fishing Trainer",
