  "locales": {
    "csCZ": {
      "dialogue": {
        "03139d73afded384de73": "Tvá dovednost překonává mou, ale slyšela jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže zlepšit se.",
        "29e36d2c568733f2c0d0": "Chceš-li se dále zlepšit, musíš najít Nata Paglea v Dustwallow Marsh.",
        "571c41b84979aeb638aa": "Vycvičte mě.",
        "d7f39d427b340f941da6": "Mohu tě naučit rybařit."
      },
      "name": "Astaia",
      "translationMetadata": {
