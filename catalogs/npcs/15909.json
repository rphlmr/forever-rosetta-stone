      "dialogue": {
        "fb4fd4965c22fd5ad91f": "I, like my brother, honor those who honor their ancestors.  It brings me great joy to share my crafting secrets to disciples of the Lunar Festival!"
      },
      "name": "Fariel Starsong",
      "subName": "Coin of Ancestry Collector",
