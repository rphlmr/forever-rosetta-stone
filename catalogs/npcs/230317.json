    "ltLT": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall parodė didelį gerumą, suteikdamas man prieglobstį savo valdose. Vis dėlto nenoriu per ilgai užsibūti. Būtų didelė negarbė, jei užtraukčiau kokių nors bėdų mūsų vadui."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
