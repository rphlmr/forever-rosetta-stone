      }
    },
    "trTR": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall bana topraklarında sığınak sağlayarak büyük bir iyilik gösterdi. Yine de misafirliğimi uzatmak istemiyorum. Liderimizin başına dert açarsam bu büyük bir utanç olur."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.40045ae896a0e3a29c4b": {
