            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall hat mir große Güte gezeigt, als er mir Schutz in seinem Reich anbot. Ich will nicht langer hier verweilen, als ich willkommen bin. Es ware eine große Schmach für mich, wenn ich unseren Anführer in Gefahr bringen sollte."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.40045ae896a0e3a29c4b": {
