      }
    },
    "svSE": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall visade stor vänlighet när han gav mig en fristad inom sitt område. Jag vill inte stanna längre än jag är välkommen. Det vore en stor vanära om jag drog problem över vår ledare."
      },
      "name": "Mokvar",
      "translationMetadata": {
