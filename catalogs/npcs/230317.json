    "hrHR": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall je pokazao veliku dobrotu pruživši mi utočište na svom području. Ne želim se predugo zadržavati. Bila bi velika sramota da našem vođi prouzročim nevolje."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
