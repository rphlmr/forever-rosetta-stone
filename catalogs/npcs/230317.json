    },
    "enUS": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall has shown great kindness in granting me sanctuary within his domain.  I do not wish to overstay my welcome, at any rate.  It would be a great dishonor if I brought any trouble to our leader."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.40045ae896a0e3a29c4b": {
            "origin": "community",
            "source": "Spoken",
