    "csCZ": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall byl velmi laskav, když mi poskytl útočiště ve své říši. Nechci však jeho pohostinnosti zneužívat. Byla by to velká potupa, kdybych našemu vůdci způsobil nějaké potíže."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
