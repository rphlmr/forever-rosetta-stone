    "plPL": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall okazał mi wielką życzliwość, udzielając mi schronienia w swej domenie. Nie chcę jednak nadużywać jego gościnności. Byłoby wielką hańbą, gdybym sprowadził kłopoty na naszego przywódcę."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.40045ae896a0e3a29c4b": {
