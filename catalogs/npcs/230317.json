    "daDK": {
      "dialogue": {
        "40045ae896a0e3a29c4b": "Thrall var meget venlig at give mig tilflugt i sit domæne. Jeg ønsker dog ikke at blive længere, end jeg er velkommen. Det ville være en stor vanære, hvis jeg bragte vores leder i vanskeligheder."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.40045ae896a0e3a29c4b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
