    "csCZ": {
      "dialogue": {
        "06614d2d5ad385187289": "Chci si prohlédnout vaše zboží.",
        "47b393198ccfb2c47298": "Buď zdráv, $N! Vítej v mé skromné zahradě. Poslední dobou nám přeje počasí. Doufejme, že vydrží až do bohaté sklizně.",
        "6b667bbb2b96a344536b": "Vycvičte mě."
      },
      "name": "Martie Jainrose",
