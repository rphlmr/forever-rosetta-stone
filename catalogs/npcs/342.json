    "svSE": {
      "dialogue": {
        "06614d2d5ad385187289": "Jag vill se dina varor.",
        "47b393198ccfb2c47298": "Var hälsad, $N! Välkommen till min enkla trädgård. Vädret har varit perfekt på sistone. Låt oss hoppas att det håller i sig så att skörden blir god.",
        "6b667bbb2b96a344536b": "Träna mig."
