    "daDK": {
      "dialogue": {
        "06614d2d5ad385187289": "Jeg vil gerne se dine varer.",
        "47b393198ccfb2c47298": "Hil dig, $N! Velkommen til min beskedne have. Vejret har været perfekt på det seneste. Lad os håbe, det holder, så høsten bliver god.",
        "6b667bbb2b96a344536b": "Træn mig."
      },
      "name": "Martie Jainrose",
      "translationMetadata": {
