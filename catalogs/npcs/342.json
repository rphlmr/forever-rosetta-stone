    "hrHR": {
      "dialogue": {
        "06614d2d5ad385187289": "Želim pogledati vašu robu.",
        "47b393198ccfb2c47298": "Pozdrav, $N! Dobro došao u moj skromni vrt. Vrijeme je u posljednje vrijeme savršeno. Nadajmo se da će tako ostati do bogate žetve.",
        "6b667bbb2b96a344536b": "Podučite me."
      },
      "name": "Martie Jainrose",
