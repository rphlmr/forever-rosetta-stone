    "hrHR": {
      "dialogue": {
        "2e864d73dbb1b5ff825b": "U davna vremena živjeli smo za lov. Lovili smo za slavu, za čast...$B$BZar je sada toliko drukčije?",
        "565c6297f3b9c055c339": "Starješina Morningdew promatra metež na trkalištu Mirage u Thousand Needlesu.",
        "7582f307b53c6680caf2": "Mislim da je starješina Splitrock otputovao u Mauradon u Desolaceu.",
        "a6896f1111bb9d2a5f0b": "Starješina Mistwalker uživa promatrati borbe u Maulu u Feralasu."
      },
      "name": "Starješina Grimtotem",
