    "daDK": {
      "dialogue": {
        "2e864d73dbb1b5ff825b": "For længe siden levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "565c6297f3b9c055c339": "Ældste Morningdew er begyndt at se på virakken ved Mirage Raceway i Thousand Needles.",
        "7582f307b53c6680caf2": "Jeg tror, ældste Splitrock er rejst til Mauradon i Desolace.",
        "a6896f1111bb9d2a5f0b": "Ældste Mistwalker nyder at se kampene ved Maul i Feralas."
      },
      "name": "Ældste Grimtotem",
      "translationMetadata": {
