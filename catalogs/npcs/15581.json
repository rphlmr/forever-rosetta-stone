    "enUS": {
      "dialogue": {
        "2e864d73dbb1b5ff825b": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "565c6297f3b9c055c339": "Elder Morningdew has taken to watching the commotion at the Mirage Raceway in Thousand Needles.",
        "7582f307b53c6680caf2": "I think Elder Splitrock has traveled to Mauradon in the Desolace.",
        "a6896f1111bb9d2a5f0b": "Elder Mistwalker enjoys watching the struggles at the Maul in Feralas."
      },
      "name": "Elder Grimtotem",
      "translationMetadata": {
