    "svSE": {
      "dialogue": {
        "2e864d73dbb1b5ff825b": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "565c6297f3b9c055c339": "Äldste Morningdew har börjat betrakta uppståndelsen vid Mirage Raceway i Thousand Needles.",
        "7582f307b53c6680caf2": "Jag tror att äldste Splitrock har rest till Mauradon i Desolace.",
        "a6896f1111bb9d2a5f0b": "Äldste Mistwalker tycker om att se striderna vid Maul i Feralas."
      },
      "name": "Äldste Grimtotem",
