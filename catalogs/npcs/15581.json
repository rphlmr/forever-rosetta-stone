  "locales": {
    "csCZ": {
      "dialogue": {
        "2e864d73dbb1b5ff825b": "Kdysi dávno jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "565c6297f3b9c055c339": "Stařešina Morningdew si oblíbil sledování ruchu na závodišti Mirage v Thousand Needles.",
        "7582f307b53c6680caf2": "Myslím, že stařešina Splitrock cestoval do Mauradonu v Desolace.",
        "a6896f1111bb9d2a5f0b": "Stařešina Mistwalker rád sleduje zápasy v Maulu ve Feralasu."
      },
      "name": "Starší Grimtotem",
      "translationMetadata": {
        "fields": {
