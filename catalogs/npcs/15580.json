  "locales": {
    "csCZ": {
      "dialogue": {
        "232c641e31822c1248cc": "Starší Ironband žije v jeskyni Blackchar v Searing Gorge.",
        "26bb97461cda2ef71343": "Starší Windtotem tráví čas s gobliny v Ratchetu na pobřeží Barrens.",
        "289ba597ae9cf1b22752": "Kdysi dávno jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "33a85cc747384e1a314a": "Staršího Darkhorna najdeš mezi červenými skalami Orgrimmaru.",
        "6c57d592bf635ea8fa28": "Staršího Bloodhoofa najdeš ve vesnici Bloodhoof v Mulgore.",
        "9417a0cb573eefa418b7": "Staršího Darkcorea najdeš v Undercity."
      },
      "name": "Starší Proudhorn",
