    "ptBR": {
      "dialogue": {
        "232c641e31822c1248cc": "O ancião Bandaferro mora na Caverna Calcinar, em Garganta Abrasadora.",
        "26bb97461cda2ef71343": "A anciã Totem do Vento está em companhia dos goblins de Vila Catraca, no litoral dos Sertões.",
        "289ba597ae9cf1b22752": "Num passado distante, nós vivíamos para a caça. Caçávamos pela glória, pela honra...\n\nHoje é assim tão diferente?",
        "33a85cc747384e1a314a": "A anciã Chifre Preto se encontra entre as rochas vermelhas de Orgrimmar.",
        "6c57d592bf635ea8fa28": "O ancião Casco Sangrento fica na Aldeia Casco Sangrento, em Mulgore.",
        "9417a0cb573eefa418b7": "O ancião Negrocerne encontra-se na Cidade Baixa."
      },
      "name": "Ancião Chifre Orgulhoso",
      "translationMetadata": {
