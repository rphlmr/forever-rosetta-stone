    "hrHR": {
      "dialogue": {
        "232c641e31822c1248cc": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu.",
        "26bb97461cda2ef71343": "Starješina Windtotem druži se s goblinima Ratcheta na obali Barrensa.",
        "289ba597ae9cf1b22752": "U davna vremena živjeli smo za lov. Lovili smo radi slave i časti...$B$BJe li danas toliko drukčije?",
        "33a85cc747384e1a314a": "Starješinu Darkhorna možeš pronaći među crvenim stijenama Orgrimmara.",
        "6c57d592bf635ea8fa28": "Starješinu Bloodhoofa možeš pronaći u selu Bloodhoof u Mulgoreu.",
        "9417a0cb573eefa418b7": "Starješinu Darkcorea možeš pronaći u Undercityju."
      },
