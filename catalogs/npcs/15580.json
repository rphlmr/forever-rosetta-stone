    "enUS": {
      "dialogue": {
        "232c641e31822c1248cc": "Elder Ironband lives in Blackchar Cave in Searing Gorge.",
        "26bb97461cda2ef71343": "Elder Windtotem is keeping company with the goblins of Ratchet on the coast of the Barrens.",
        "289ba597ae9cf1b22752": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "33a85cc747384e1a314a": "Elder Darkhorn can be found among the red rocks of Orgrimmar.",
        "6c57d592bf635ea8fa28": "Elder Bloodhoof can be found at Bloodhoof Village in Mulgore.",
        "9417a0cb573eefa418b7": "Elder Darkcore can be found in the Undercity."
      },
      "name": "Elder Proudhorn",
