    "svSE": {
      "dialogue": {
        "232c641e31822c1248cc": "Äldste Ironband bor i Blackchargrottan i Searing Gorge.",
        "26bb97461cda2ef71343": "Äldste Windtotem umgås med goblinerna i Ratchet vid Barrens kust.",
        "289ba597ae9cf1b22752": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "33a85cc747384e1a314a": "Äldste Darkhorn finns bland Orgrimmars röda klippor.",
        "6c57d592bf635ea8fa28": "Äldste Bloodhoof finns i Bloodhoof Village i Mulgore.",
        "9417a0cb573eefa418b7": "Äldste Darkcore finns i Undercity."
      },
      "name": "Äldste Proudhorn",
