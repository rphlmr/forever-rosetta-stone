    "deDE": {
      "dialogue": {
        "232c641e31822c1248cc": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht.",
        "26bb97461cda2ef71343": "Urahnin Windtotem leistet den Goblins in Ratchet, an der Küste des Brachlands, Gesellschaft.",
        "289ba597ae9cf1b22752": "In längst vergangenen Tagen lebten wir für die Jagd. Wir jagten nach Ruhm, nach Ehre…\n\nIst jetzt alles anders?",
        "33a85cc747384e1a314a": "Urahnin Darkhorn kann an den roten Felsen von Orgrimmar angetroffen werden.",
        "6c57d592bf635ea8fa28": "Urahne Bloodhoof? Na, den könnt Ihr in Bloodhoof treffen, in Mulgore.",
        "9417a0cb573eefa418b7": "Urahne Darkcore ist in Undercity."
      },
      "name": "Urahne Proudhorn",
