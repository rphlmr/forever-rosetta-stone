    "plPL": {
      "dialogue": {
        "232c641e31822c1248cc": "Starszy Ironband mieszka w jaskini Blackchar w Searing Gorge.",
        "26bb97461cda2ef71343": "Starszy Windtotem przebywa wśród goblinów z Ratchet na wybrzeżu Barrens.",
        "289ba597ae9cf1b22752": "Dawno temu żyliśmy dla polowania. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest aż tak inaczej?",
        "33a85cc747384e1a314a": "Starszego Darkhorna znajdziesz wśród czerwonych skał Orgrimmaru.",
        "6c57d592bf635ea8fa28": "Starszego Bloodhoofa znajdziesz w wiosce Bloodhoof w Mulgore.",
        "9417a0cb573eefa418b7": "Starszego Darkcore’a znajdziesz w Undercity."
      },
      "name": "Starszy Proudhorn",
