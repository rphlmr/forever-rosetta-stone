    "itIT": {
      "dialogue": {
        "232c641e31822c1248cc": "L'Anziano Ironband vive nella Grotta di Blackchar, a Searing Gorge.",
        "26bb97461cda2ef71343": "L'Anziana Windtotem se ne sta in compagnia dei goblin di Ratchet, sulla costa delle Barrens.",
        "289ba597ae9cf1b22752": "In tempi ormai lontani, vivevamo per la caccia. Cacciavamo per la gloria, per l'onore...\n\nÈ poi così diverso, adesso?",
        "33a85cc747384e1a314a": "L'Anziana Darkhorn la trovi fra le rocce rosse di Orgrimmar.",
        "6c57d592bf635ea8fa28": "L'Anziano Bloodhoof si trova a Bloodhoof Village, in Mulgore.",
        "9417a0cb573eefa418b7": "L'Anziano Darkcore si trova a Undercity."
      },
      "name": "Anziano Proudhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.232c641e31822c1248cc": {
