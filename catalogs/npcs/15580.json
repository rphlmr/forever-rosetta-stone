    "zhCN": {
      "dialogue": {
        "232c641e31822c1248cc": "铁环长者生活在灼热峡谷的黑炭谷中。",
        "26bb97461cda2ef71343": "风之图腾长者在贫瘠之地的棘齿城和地精为伴。",
        "289ba597ae9cf1b22752": "在过去的岁月里，我们以狩猎为生。我们为了荣誉而狩猎……\n\n现在有什么不同吗？",
        "33a85cc747384e1a314a": "暗角长者在遍布红色巨岩的奥格瑞玛城中。",
        "6c57d592bf635ea8fa28": "血蹄长者在莫高雷的血蹄村里。",
        "9417a0cb573eefa418b7": "暗灵长者在幽暗城。"
      },
      "name": "傲角长者",
      "translationMetadata": {
        "fields": {
          "dialogue.232c641e31822c1248cc": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "zhCN",
            "sourceSha256": "93fdbbbf1ced545d4289fe2fbdf3bf67307343eca1bd2c3e83d1e0f738d14067"
          },
          "dialogue.26bb97461cda2ef71343": {
