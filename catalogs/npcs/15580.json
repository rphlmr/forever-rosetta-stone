    "daDK": {
      "dialogue": {
        "232c641e31822c1248cc": "Ældste Ironband bor i Blackchar-hulen i Searing Gorge.",
        "26bb97461cda2ef71343": "Ældste Windtotem holder goblinerne i Ratchet ved Barrens kyst med selskab.",
        "289ba597ae9cf1b22752": "For længe siden levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "33a85cc747384e1a314a": "Ældste Darkhorn findes blandt Orgrimmars røde klipper.",
        "6c57d592bf635ea8fa28": "Ældste Bloodhoof findes i Bloodhoof Village i Mulgore.",
        "9417a0cb573eefa418b7": "Ældste Darkcore findes i Undercity."
      },
      "name": "Ældste Proudhorn",
