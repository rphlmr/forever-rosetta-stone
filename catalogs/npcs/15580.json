    "frFR": {
      "dialogue": {
        "232c641e31822c1248cc": "L’Ancien Ironband vit dans la caverne de Noircharbon de la gorge des Vents brûlants.",
        "26bb97461cda2ef71343": "L'Ancienne Windtotem s'est installée chez les gobelins de Ratchet, sur la côte des Tarides.",
        "289ba597ae9cf1b22752": "Dans les temps anciens, nous vivions pour la chasse.  Nous chassions pour la gloire, pour l’honneur…\n\nEst-ce si différent maintenant ?",
        "33a85cc747384e1a314a": "L'Ancienne Darkhorn arpente les rochers rouges d'Orgrimmar.",
        "6c57d592bf635ea8fa28": "L'Ancien Bloodhoof se trouve au village Bloodhoof de Mulgore.",
        "9417a0cb573eefa418b7": "L'Ancien Darkcore se trouve à Undercity."
      },
      "name": "Ancien Proudhorn",
