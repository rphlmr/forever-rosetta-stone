    "ltLT": {
      "dialogue": {
        "232c641e31822c1248cc": "Vyresnysis Ironband gyvena Blackchar oloje Searing Gorge tarpeklyje.",
        "26bb97461cda2ef71343": "Vyresnysis Windtotem leidžia laiką su Ratchet goblinais Barrens pakrantėje.",
        "289ba597ae9cf1b22752": "Seniai seniai gyvenome dėl medžioklės. Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "33a85cc747384e1a314a": "Vyresnįjį Darkhorn galima rasti tarp raudonųjų Orgrimmar uolų.",
        "6c57d592bf635ea8fa28": "Vyresnįjį Bloodhoof galima rasti Bloodhoof kaime Mulgore krašte.",
        "9417a0cb573eefa418b7": "Vyresnįjį Darkcore galima rasti Undercity mieste."
      },
      "name": "Vyresnysis Proudhorn",
