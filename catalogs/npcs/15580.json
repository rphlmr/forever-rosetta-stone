    "trTR": {
      "dialogue": {
        "232c641e31822c1248cc": "Yaşlı Ironband, Searing Gorge’daki Blackchar Mağarası’nda yaşar.",
        "26bb97461cda2ef71343": "Yaşlı Windtotem, Barrens kıyısındaki Ratchet’ta goblinlerle vakit geçiriyor.",
        "289ba597ae9cf1b22752": "Çok eskiden av için yaşardık. Şan ve onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "33a85cc747384e1a314a": "Yaşlı Darkhorn’u Orgrimmar’ın kızıl kayalıkları arasında bulabilirsin.",
        "6c57d592bf635ea8fa28": "Yaşlı Bloodhoof’u Mulgore’daki Bloodhoof Köyü’nde bulabilirsin.",
        "9417a0cb573eefa418b7": "Yaşlı Darkcore’u Undercity’de bulabilirsin."
      },
      "name": "Ulu Proudhorn",
