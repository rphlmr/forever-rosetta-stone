    "deDE": {
      "dialogue": {
        "34a96606f13a4c19c837": "Zeigt mir Eure Auswahl an Grimoires.",
        "baf0a5b35ccec9c7347b": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "de80b5589714434e2986": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig."
      },
      "name": "Dannie Fizzwizzle",
      "subName": "Dämonenausbilder",
