    "enUS": {
      "dialogue": {
        "34a96606f13a4c19c837": "Show me your selection of grimoires.",
        "baf0a5b35ccec9c7347b": "You're no warlock and I've no time for you.  Begone!",
        "de80b5589714434e2986": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place."
      },
      "name": "Dannie Fizzwizzle",
      "subName": "Demon Trainer",
