    },
    "daDK": {
      "dialogue": {
        "34a96606f13a4c19c837": "Vis mig dit udvalg af grimoirer.",
        "baf0a5b35ccec9c7347b": "Du er ikke en troldmand, og jeg har ikke tid til dig. Forsvind!",
        "de80b5589714434e2986": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted."
      },
      "name": "Dannie Fizzwizzle",
      "translationMetadata": {
        "fields": {
          "dialogue.34a96606f13a4c19c837": {
            "origin": "ai",
