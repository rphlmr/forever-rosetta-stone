  "locales": {
    "csCZ": {
      "dialogue": {
        "34a96606f13a4c19c837": "Ukažte mi svou nabídku grimoárů.",
        "baf0a5b35ccec9c7347b": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "de80b5589714434e2986": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě."
      },
      "name": "Dannie Fizzwizzle",
      "translationMetadata": {
        "fields": {
          "dialogue.34a96606f13a4c19c837": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
