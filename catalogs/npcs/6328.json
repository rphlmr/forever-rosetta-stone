    "plPL": {
      "dialogue": {
        "34a96606f13a4c19c837": "Pokaż mi swoją ofertę grymuarów.",
        "baf0a5b35ccec9c7347b": "Nie jesteś czarnoksiężnikiem i nie mam dla ciebie czasu. Precz!",
        "de80b5589714434e2986": "Chcesz wzmocnić swoje demony? Będzie cię to kosztować, ale dobrze trafiasz."
