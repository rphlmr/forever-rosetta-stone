            "source": "questie",
            "sourceLocale": "ruRU",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "ac88489ce8b4f2baae07": "Liksom många andra kom jag för att hjälpa mina druidbröder när kriget började.$B$BNu när Ahn’Qirajs portar är öppna har jag insett att mycket arbete återstår. Jag har bestämt mig för att stanna i Silithus och göra mitt bästa för vår sak, $n."
      },
      "name": "Väktare Haro",
      "translationMetadata": {
        "fields": {
          "dialogue.ac88489ce8b4f2baae07": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
