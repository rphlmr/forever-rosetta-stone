        }
      }
    },
    "plPL": {
      "dialogue": {
        "ac88489ce8b4f2baae07": "Podobnie jak wielu innych przybyłem z pomocą moim druickim druhom, gdy rozpoczęła się wojna.$B$BTeraz, gdy bramy Ahn’Qiraj stoją otworem, zrozumiałem, że wciąż pozostało wiele do zrobienia. Postanowiłem zostać w Silithus i wspierać naszą sprawę najlepiej, jak potrafię, $n."
      },
      "name": "Dozorca Haro",
      "translationMetadata": {
        "fields": {
          "dialogue.ac88489ce8b4f2baae07": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
