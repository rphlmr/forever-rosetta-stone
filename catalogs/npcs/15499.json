    "hrHR": {
      "dialogue": {
        "ac88489ce8b4f2baae07": "Kao i mnogi drugi, došao sam pomoći svojim kolegama druidima kad je rat počeo.$B$BSada kad su vrata Ahn’Qiraja otvorena, shvatio sam da još mnogo toga treba učiniti. Odlučio sam ostati u Silithusu i učiniti sve što mogu za naš cilj, $n."
      },
      "name": "Čuvar Haro",
      "translationMetadata": {
        "fields": {
          "dialogue.ac88489ce8b4f2baae07": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
