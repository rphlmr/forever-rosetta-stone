    },
    "ptBR": {
      "dialogue": {
        "ac88489ce8b4f2baae07": "Eu, como muitos outros, vim auxiliar meus amigos druidas quando a guerra começou.\n\nAgora que os Portões de Ahn'Qiraj estão abertos, percebi que ainda tem muito trabalho a ser feito. Resolvi ficar em Silithus e fazer o melhor para ajudar a causa, $n."
      },
      "name": "Guardião Haro",
      "translationMetadata": {
        "fields": {
          "dialogue.ac88489ce8b4f2baae07": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ptBR",
