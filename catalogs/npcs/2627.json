    "hrHR": {
      "dialogue": {
        "036b0d4a2c68981ec30f": "Da, znaš ti ponešto! Ako želiš naučiti više, moraš razgovarati s Georgiom Bolerom u Stormwindu.",
        "27ab1b0780257a78e5cb": "Podučite me.",
        "566a76323ba3e7bfdc60": "Pa, pa, nije loše. Možda ti IPAK mogu pokazati nekoliko stvari...",
        "724e4951c925dd5552e7": "Nije loše... za amatera! Ipak, znaš otprilike koliko i ja. Ako želiš naučiti više, moraš razgovarati s Josefom Gregorianom u Undercityju.",
        "a02ea5c1a6f5dbcd7a2b": "Kažu da jedan ubod na vrijeme štedi... koliko, jedanaest? Ah, ne sjećam se. Ionako glupa izreka."
      },
      "name": "Grarnik Goodstitch",
      "translationMetadata": {
