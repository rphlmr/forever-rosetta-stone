    "ltLT": {
      "dialogue": {
        "036b0d4a2c68981ec30f": "Taip, šį tą jau moki! Jei nori išmokti daugiau, turėsi pasikalbėti su Georgio Bolero Stormwind mieste.",
        "27ab1b0780257a78e5cb": "Išmokyk mane.",
        "566a76323ba3e7bfdc60": "Na, na, visai neblogai. Gal ir GALIU kai ko tave išmokyti...",
        "724e4951c925dd5552e7": "Neblogai... kaip mėgėjui! Vis dėlto tu moki beveik tiek pat, kiek ir aš. Jei nori išmokti daugiau, turėsi pasikalbėti su Josef Gregorian Undercity mieste.",
        "a02ea5c1a6f5dbcd7a2b": "Sako, laiku padarytas dygsnis sutaupo... kiek ten, vienuolika? Ak, nepamenu. Vis tiek kvailas posakis."
      },
      "name": "Grarnik Goodstitch",
      "subName": "Siuvimo ekspertas",
