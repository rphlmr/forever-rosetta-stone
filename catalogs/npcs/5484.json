  "locales": {
    "csCZ": {
      "dialogue": {
        "2ec09cc685080472b2a3": "Neobracej se ke Světlu zády, $c. Jednoho dne tě možná právě ono zachrání.",
        "9a2745fcffce231b92f3": "Hledám další výcvik v kněžském umění.",
        "dd58d3364a5a6014f71e": "Přísným přeškolením jsem musel mnoho žáků odnaučit všemu, co dříve znali, abych je mohl učit znovu. Tato služba je s každým opakováním náročnější, a proto také dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "e7e9b549bd0e45448843": "Věřím, že Světlo je s tebou, $n. Mohu ti s něčím pomoci?"
      },
      "name": "Bratr Benjamin",
      "translationMetadata": {
        "fields": {
          "dialogue.2ec09cc685080472b2a3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
