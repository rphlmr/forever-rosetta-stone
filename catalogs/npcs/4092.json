  "locales": {
    "csCZ": {
      "dialogue": {
        "0849b58ed5b3533fb51a": "Má moudrost i vědomosti jsou ti k dispozici. Co pro tebe mohu udělat, $n?",
        "2ba9e3309df451f818d0": "Pokud si přeješ, mohu ti kromě výcviku vymazat z mysli znalost tvých talentů. Upozorňuji, že tento postup je pokaždé obtížnější, a proto také dražší.",
        "53c33f24e66250bbd7ce": "Hledám další výcvik v kněžském umění.",
        "cd91e7e938d4f3f8a69a": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla vyučit znovu. Tuto službu je pokaždé těžší provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučila tvým talentům?",
        "cf71adfbe5c86d1031c9": "Elune s tebou, $c."
      },
      "name": "Lariia",
      "translationMetadata": {
        "fields": {
          "dialogue.0849b58ed5b3533fb51a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
