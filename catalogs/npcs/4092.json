    "hrHR": {
      "dialogue": {
        "0849b58ed5b3533fb51a": "Moja mudrost i znanje na raspolaganju su ti. Što mogu učiniti za tebe, $n?",
        "2ba9e3309df451f818d0": "Ako želiš, osim obuke mogu izbrisati znanje o tvojim talentima iz tvojeg uma. Upozoravam te da je postupak svaki put teži i zato skuplji.",
        "53c33f24e66250bbd7ce": "Tražim daljnju poduku u svećeničkom umijeću.",
        "cd91e7e938d4f3f8a69a": "Strogom sam preobukom mnoge učenike morala odviknuti od svega što su prije naučili kako bih ih mogla ponovno podučiti. Tu je uslugu svaki put sve teže pružiti, pa je zato svakom preobukom sve skuplja. Želiš li da te odviknem od naučenih talenata?",
        "cf71adfbe5c86d1031c9": "Neka Elune bude s tobom, $c."
      },
      "name": "Lariia",
      "translationMetadata": {
