  "locales": {
    "csCZ": {
      "dialogue": {
        "075d97a1b289952da0ed": "Při náročném přeškolování jsem musel mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ovládáš?",
        "0e8cf346d8283896db55": "Potřebuji výcvik válečníka.",
        "60afa9a0a4cde8280d7e": "Neztrácej můj čas, $c.",
        "92e298c1e2be65d17c5f": "Úlohou bojovníka je chránit. Stejně jako v bitvě chráníme své krajany, musíme chránit i zájmy Opuštěných."
      },
      "name": "Austil de Mon",
      "translationMetadata": {
        "fields": {
          "dialogue.075d97a1b289952da0ed": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
