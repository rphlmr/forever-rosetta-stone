    "enUS": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "2c62a931c640b8c5df1d": "Train me.",
        "3a2b160a88f2c737f238": "I can teach you how to cook!",
        "77cb839bee739d6c088d": "Cooking is a life long pursuit and I see we share the same passion!",
        "7806c4afa094fb62947b": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself."
      },
      "name": "Eunice Burch",
      "subName": "Cooking Trainer",
      "translationMetadata": {
