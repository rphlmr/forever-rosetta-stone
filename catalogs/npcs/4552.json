  "locales": {
    "csCZ": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Pokud se chceš zlepšit, musíš ho vyhledat.",
        "2c62a931c640b8c5df1d": "Vycvičte mě.",
        "3a2b160a88f2c737f238": "Mohu tě naučit vařit!",
        "77cb839bee739d6c088d": "Vaření je celoživotní záliba a vidím, že sdílíme stejnou vášeň!",
        "7806c4afa094fb62947b": "Wulan ve vesnici Shadowprey ti může prodat „Expertní kuchařku“. Budeš ji potřebovat, pokud se chceš zlepšit."
      },
      "name": "Eunice Burch",
      "translationMetadata": {
