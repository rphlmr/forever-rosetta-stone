    "frFR": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "2c62a931c640b8c5df1d": "Entraînez-moi.",
        "3a2b160a88f2c737f238": "Je peux vous apprendre à cuisiner !",
        "77cb839bee739d6c088d": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "7806c4afa094fb62947b": "Wuland du village de Proie-de-l'Ombre peut vous vendre un livre de cuisine pour experts. Il vous faudra bien ça si vous voulez vous améliorer."
      },
      "name": "Eunice Burch",
      "subName": "Maître des cuisiniers",
