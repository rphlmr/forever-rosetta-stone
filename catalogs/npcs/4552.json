    "daDK": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunst. Du må opsøge ham for at blive bedre.",
        "2c62a931c640b8c5df1d": "Træn mig.",
        "3a2b160a88f2c737f238": "Jeg kan lære dig at lave mad!",
        "77cb839bee739d6c088d": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler samme passion!",
        "7806c4afa094fb62947b": "Wulan i Shadowprey Village kan sælge dig „Expert Cookbook“. Du får brug for den, hvis du vil blive bedre."
      },
      "name": "Eunice Burch",
      "translationMetadata": {
