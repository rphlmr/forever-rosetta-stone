    "ltLT": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meno meistras. Jei nori tobulėti, turėsi jį susirasti.",
        "2c62a931c640b8c5df1d": "Pamokyk mane.",
        "3a2b160a88f2c737f238": "Galiu tave išmokyti gaminti maistą!",
        "77cb839bee739d6c088d": "Maisto gaminimas yra viso gyvenimo užsiėmimas, ir matau, kad mus sieja ta pati aistra!",
        "7806c4afa094fb62947b": "Wulan iš Shadowprey kaimo gali tau parduoti „Eksperto kulinarijos knygą“. Jos prireiks, jei nori tobulėti."
      },
      "name": "Eunice Burch",
      "subName": "Maisto gaminimo mokytojas",
