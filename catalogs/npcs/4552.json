    "trTR": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarında bir ustadır. Kendini geliştirmek için onu bulmalısın.",
        "2c62a931c640b8c5df1d": "Beni eğit.",
        "3a2b160a88f2c737f238": "Sana yemek yapmayı öğretebilirim!",
        "77cb839bee739d6c088d": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "7806c4afa094fb62947b": "Shadowprey Köyü'ndeki Wulan sana \"Expert Cookbook\" satabilir. Kendini geliştirmek istiyorsan ona ihtiyacın olacak."
      },
      "name": "Eunice Burch",
