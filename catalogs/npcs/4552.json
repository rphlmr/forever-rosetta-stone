    "hrHR": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave iz Gadgetzana majstor je kulinarske umjetnosti. Moraš ga potražiti ako se želiš usavršiti.",
        "2c62a931c640b8c5df1d": "Podučite me.",
        "3a2b160a88f2c737f238": "Mogu te naučiti kuhati!",
        "77cb839bee739d6c088d": "Kuhanje je životni poziv i vidim da dijelimo istu strast!",
        "7806c4afa094fb62947b": "Wulan u selu Shadowprey može ti prodati „Expert Cookbook“. Trebat će ti ako želiš napredovati."
      },
      "name": "Eunice Burch",
