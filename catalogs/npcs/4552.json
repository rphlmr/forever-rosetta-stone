    "plPL": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave z Gadgetzanu jest mistrzem sztuki kulinarnej. Musisz go odszukać, jeśli chcesz się doskonalić.",
        "2c62a931c640b8c5df1d": "Wyszkol mnie.",
        "3a2b160a88f2c737f238": "Mogę nauczyć cię gotować!",
        "77cb839bee739d6c088d": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!",
        "7806c4afa094fb62947b": "Wulan w wiosce Shadowprey może sprzedać ci „Expert Cookbook”. Będzie ci potrzebna, jeśli chcesz się doskonalić."
      },
      "name": "Eunice Burch",
