    "svSE": {
      "dialogue": {
        "0309cefa1b0c340cf8f8": "Dirge Quikcleave i Gadgetzan är en mästare i kokkonst. Du måste söka upp honom för att bli bättre.",
        "2c62a931c640b8c5df1d": "Träna mig.",
        "3a2b160a88f2c737f238": "Jag kan lära dig att laga mat!",
        "77cb839bee739d6c088d": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!",
        "7806c4afa094fb62947b": "Wulan i Shadowprey Village kan sälja dig ”Expert Cookbook”. Du behöver den om du vill bli bättre."
      },
      "name": "Eunice Burch",
