    "daDK": {
      "dialogue": {
        "5cd31c3c987404de9017": "Jeg kan lære dig kunsten at ride på ulve, hvis du har guld nok til at betale for undervisningen!",
        "6acb45cf84d8ef6f4564": "Du skal være ophøjet hos orkerne i Orgrimmar, før jeg vil lære dig at ride, $c.",
        "7c73fb79682f13ff79b6": "Jeg søger undervisning i at ride på et ridedyr."
      },
      "name": "Kildar",
      "translationMetadata": {
        "fields": {
