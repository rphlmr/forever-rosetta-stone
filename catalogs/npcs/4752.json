    "ltLT": {
      "dialogue": {
        "5cd31c3c987404de9017": "Galiu išmokyti tave jojimo vilkais subtilybių, jei turi pakankamai aukso pamokai apmokėti!",
        "6acb45cf84d8ef6f4564": "Prieš mokydamas tave joti, $c, turiu žinoti, kad Orgrimmar orkai tave aukština.",
        "7c73fb79682f13ff79b6": "Noriu išmokti joti."
      },
      "name": "Kildar",
      "subName": "Jojimo vilkais instruktorius",
