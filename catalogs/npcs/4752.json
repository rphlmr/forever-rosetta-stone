    "plPL": {
      "dialogue": {
        "5cd31c3c987404de9017": "Mogę nauczyć cię tajników jazdy na wilku, pod warunkiem że masz dość złota na lekcję!",
        "6acb45cf84d8ef6f4564": "Musisz zdobyć najwyższe poważanie u orków z Orgrimmaru, zanim nauczę cię jeździć, $c.",
        "7c73fb79682f13ff79b6": "Szukam szkolenia w jeździe na wierzchowcu."
      },
