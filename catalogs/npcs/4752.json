    "esES": {
      "dialogue": {
        "5cd31c3c987404de9017": "Puedo enseñarte los mejores trucos para montar un lobo, ¡siempre que tengas suficiente oro para pagar la lección!",
        "6acb45cf84d8ef6f4564": "Es necesario que los orcos de Orgrimmar te consideren un exaltado para que te pueda enseñar la habilidad de montar.",
        "7c73fb79682f13ff79b6": "Busco instrucción para aprender a montar."
      },
      "name": "Kildar",
      "subName": "Instructor de jinetes de lobos",
