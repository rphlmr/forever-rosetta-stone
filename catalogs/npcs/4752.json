    "itIT": {
      "dialogue": {
        "5cd31c3c987404de9017": "Posso insegnarti i segreti del Wolf Riding, purché tu abbia abbastanza oro per pagare la lezione!",
        "6acb45cf84d8ef6f4564": "Devi essere exalted presso gli orchi di Orgrimmar prima che io ti insegni a cavalcare, $C.",
        "7c73fb79682f13ff79b6": "Cerco un addestramento per cavalcare una cavalcatura."
      },
