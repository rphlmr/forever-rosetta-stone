    "enUS": {
      "dialogue": {
        "5cd31c3c987404de9017": "I can teach you the finer points of Wolf Riding, provided you have enough gold to cover the lesson!",
        "6acb45cf84d8ef6f4564": "You need to be exalted with the orcs of Orgrimmar before I will teach you a riding skill, $c.",
        "7c73fb79682f13ff79b6": "I seek training to ride a steed."
      },
      "name": "Kildar",
      "subName": "Wolf Riding Instructor",
      "translationMetadata": {
