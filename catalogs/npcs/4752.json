    "hrHR": {
      "dialogue": {
        "5cd31c3c987404de9017": "Mogu te naučiti umijeću jahanja vuka, pod uvjetom da imaš dovoljno zlata za poduku!",
        "6acb45cf84d8ef6f4564": "Moraš biti uzvišen kod orkova Orgrimmara prije nego što te naučim jahati, $c.",
        "7c73fb79682f13ff79b6": "Želim naučiti jahati jahaću životinju."
      },
      "name": "Kildar",
