  "locales": {
    "csCZ": {
      "dialogue": {
        "5cd31c3c987404de9017": "Mohu tě naučit jemnostem jízdy na vlku, pokud máš dost zlata na zaplacení lekce!",
        "6acb45cf84d8ef6f4564": "Než tě naučím jezdit, musíš si získat nejvyšší úctu orků z Orgrimmaru, $c.",
        "7c73fb79682f13ff79b6": "Hledám výcvik v jízdě na jezdeckém zvířeti."
      },
      "name": "Kildar",
      "translationMetadata": {
        "fields": {
