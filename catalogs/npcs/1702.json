    "csCZ": {
      "dialogue": {
        "0082e2735c4f84ff505e": "Chceš být inženýrem, co? Při Muradinovi, jsi na správném místě!",
        "62278a3d013021c469f9": "Jen malá úprava tady... a je to!",
        "c9db6a8f2175bd68a69d": "Vycvičte mě."
