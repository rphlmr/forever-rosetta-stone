        }
      }
    },
    "daDK": {
      "dialogue": {
        "8cea410a128d1f540e00": "Jeg vil gerne se dine varer.",
        "9cbbbf5be98def64c1de": "$C, siger du? Jeg er Krazek, baron Revilgaz' sekretær. Jeg ved alt om, hvad der foregår i denne jungle og udenfor. Måske er du interesseret i den aktuelle oliepris i Ratchet? Ikke? Leder du måske efter arbejde? Det kan jeg hjælpe med.",
        "f50747221e6693f4bf90": "Træn mig."
      },
      "name": "Krazek",
      "translationMetadata": {
        "fields": {
          "dialogue.8cea410a128d1f540e00": {
            "origin": "ai",
