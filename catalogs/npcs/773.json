    "plPL": {
      "dialogue": {
        "8cea410a128d1f540e00": "Chcę przejrzeć twoje towary.",
        "9cbbbf5be98def64c1de": "$C, powiadasz? Jestem Krazek, sekretarz barona Revilgaza. Wiem wszystko o tym, co dzieje się w tej dżungli i poza nią. Może interesuje cię obecna cena ropy w Ratchet? Nie? Szukasz pracy? Mogę ci w tym pomóc.",
        "f50747221e6693f4bf90": "Wyszkol mnie."
      },
      "name": "Krazek",
