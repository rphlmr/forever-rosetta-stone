    "hrHR": {
      "dialogue": {
        "8cea410a128d1f540e00": "Želim pogledati vašu robu.",
        "9cbbbf5be98def64c1de": "$C, ha? Ja sam Krazek, tajnik baruna Revilgaza. Znam sve što se zbiva u ovoj džungli i izvan nje. Možda te zanima trenutačna cijena nafte u Ratchetu? Ne? Možda tražiš posao? S time ti mogu pomoći.",
        "f50747221e6693f4bf90": "Podučite me."
      },
      "name": "Krazek",
