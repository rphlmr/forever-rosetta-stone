  "locales": {
    "csCZ": {
      "dialogue": {
        "8cea410a128d1f540e00": "Rád bych si prohlédl vaše zboží.",
        "9cbbbf5be98def64c1de": "$C, říkáš? Jsem Krazek, sekretář barona Revilgaze. Vím všechno o tom, co se děje v této džungli i za jejími hranicemi. Možná tě zajímá aktuální cena ropy v Ratchetu? Ne? Možná hledáš práci? S tím ti mohu pomoci.",
        "f50747221e6693f4bf90": "Vycvičte mě."
      },
      "name": "Krazek",
      "translationMetadata": {
        "fields": {
          "dialogue.8cea410a128d1f540e00": {
            "origin": "ai",
