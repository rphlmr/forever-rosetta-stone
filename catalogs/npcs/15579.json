    "daDK": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Ældste Ironband bor i Blackchar Cave i Searing Gorge.",
        "21180eec040e0ae46c15": "Ældste Windtotem holder goblinerne i Ratchet på Barrens-kysten med selskab.",
        "373fa338f717d9f650b1": "Ældste Proudhorn nyder udsigten over Mulgore fra Thunder Bluff.",
        "7aabda39009bedc9b67c": "I gamle dage levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "cbed6444ab5892a52c8b": "Sidst jeg hørte nyt, var ældste Runetotem på vej til Razor Hill i Durotar.",
        "d4c789d28d5b5c45af61": "Ældste Darkcore kan findes i Undercity."
      },
      "name": "Ældste Darkhorn",
      "translationMetadata": {
