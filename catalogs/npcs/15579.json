    "ltLT": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Vyresnysis Ironband gyvena Blackchar Cave Searing Gorge tarpeklyje.",
        "21180eec040e0ae46c15": "Vyresnysis Windtotem leidžia laiką su Ratchet goblinais Barrens pakrantėje.",
        "373fa338f717d9f650b1": "Vyresnysis Proudhorn gėrisi vaizdais virš Mulgore, Thunder Bluff mieste.",
        "7aabda39009bedc9b67c": "Seniai seniai gyvenome dėl medžioklės.  Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "cbed6444ab5892a52c8b": "Paskutinį kartą girdėjau, kad vyresnysis Runetotem keliavo į Razor Hill Durotar regione.",
        "d4c789d28d5b5c45af61": "Vyresnįjį Darkcore galima rasti Undercity mieste."
      },
      "name": "Vyresnysis Darkhorn",
