    "plPL": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Starszy Ironband mieszka w jaskini Blackchar w Searing Gorge.",
        "21180eec040e0ae46c15": "Starszy Windtotem dotrzymuje towarzystwa goblinom w Ratchet na wybrzeżu Pustkowi.",
        "373fa338f717d9f650b1": "Starszy Proudhorn podziwia widoki na Mulgore z Thunder Bluff.",
        "7aabda39009bedc9b67c": "W dawnych czasach żyliśmy dla polowania. Polowaliśmy dla chwały i honoru...$B$BCzy teraz jest inaczej?",
        "cbed6444ab5892a52c8b": "Ostatnio słyszałem, że starszy Runetotem podróżował do Razor Hill w Durotarze.",
        "d4c789d28d5b5c45af61": "Starszego Darkcore’a znajdziesz w Undercity."
