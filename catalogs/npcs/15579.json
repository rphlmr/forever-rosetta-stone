    "hrHR": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu.",
        "21180eec040e0ae46c15": "Starješina Windtotem druži se s goblinima u Ratchetu na obali Barrensa.",
        "373fa338f717d9f650b1": "Starješina Proudhorn uživa u pogledima na Mulgore iz Thunder Bluffa.",
        "7aabda39009bedc9b67c": "U davna vremena živjeli smo za lov. Lovili smo za slavu i čast...$B$BJe li danas toliko drukčije?",
        "cbed6444ab5892a52c8b": "Posljednje što sam čuo jest da je starješina Runetotem putovao u Razor Hill u Durotaru.",
        "d4c789d28d5b5c45af61": "Starješinu Darkcorea možeš pronaći u Undercityju."
      },
