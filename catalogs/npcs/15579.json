    "trTR": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Yaşlı Ironband, Searing Gorge’daki Blackchar Mağarası’nda yaşıyor.",
        "21180eec040e0ae46c15": "Yaşlı Windtotem, Barrens kıyısındaki Ratchet’ta goblinlere eşlik ediyor.",
        "373fa338f717d9f650b1": "Yaşlı Proudhorn, Thunder Bluff’ta Mulgore manzarasının tadını çıkarıyor.",
        "7aabda39009bedc9b67c": "Eski günlerde av için yaşardık. Şan ve şeref için avlanırdık...$B$BŞimdi çok mu farklı?",
        "cbed6444ab5892a52c8b": "Son duyduğuma göre Yaşlı Runetotem, Durotar’daki Razor Hill’e gidiyordu.",
        "d4c789d28d5b5c45af61": "Yaşlı Darkcore’u Undercity’de bulabilirsin."
      },
      "name": "Ulu Darkhorn",
