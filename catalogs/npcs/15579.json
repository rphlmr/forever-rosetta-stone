    "enUS": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Elder Ironband lives in Blackchar Cave in Searing Gorge.",
        "21180eec040e0ae46c15": "Elder Windtotem is keeping company with the goblins of Ratchet on the coast of the Barrens.",
        "373fa338f717d9f650b1": "Elder Proudhorn is enjoying the vistas above Mulgore at Thunder Bluff.",
        "7aabda39009bedc9b67c": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "cbed6444ab5892a52c8b": "Last I heard, Elder Runetotem was traveling to Razor Hill in Durotar.",
        "d4c789d28d5b5c45af61": "Elder Darkcore can be found in the Undercity."
      },
      "name": "Elder Darkhorn",
      "translationMetadata": {
