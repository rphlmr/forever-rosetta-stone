  "locales": {
    "csCZ": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Stařešina Ironband žije v jeskyni Blackchar v Searing Gorge.",
        "21180eec040e0ae46c15": "Stařešina Windtotem dělá společnost goblinům v Ratchetu na pobřeží Barrens.",
        "373fa338f717d9f650b1": "Stařešina Proudhorn se kochá výhledy na Mulgore v Thunder Bluffu.",
        "7aabda39009bedc9b67c": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu a čest...$B$BJe to dnes tak jiné?",
        "cbed6444ab5892a52c8b": "Naposledy jsem slyšel, že stařešina Runetotem cestoval do Razor Hillu v Durotaru.",
        "d4c789d28d5b5c45af61": "Stařešinu Darkcore najdeš v Undercity."
      },
      "name": "Starší Darkhorn",
