    "itIT": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "L'Anziano Ironband vive nella Grotta di Blackchar, a Searing Gorge.",
        "21180eec040e0ae46c15": "L'Anziana Windtotem se ne sta in compagnia dei goblin di Ratchet, sulla costa delle Barrens.",
        "373fa338f717d9f650b1": "L'Anziano Proudhorn si sta godendo il panorama sopra Mulgore, a Thunder Bluff.",
        "7aabda39009bedc9b67c": "In tempi ormai lontani, vivevamo per la caccia. Cacciavamo per la gloria, per l'onore...\n\nÈ poi così diverso, adesso?",
        "cbed6444ab5892a52c8b": "Le ultime voci dicevano che l'Anziana Runetotem era in viaggio verso Razor Hill, in Durotar.",
        "d4c789d28d5b5c45af61": "L'Anziano Darkcore si trova a Undercity."
      },
      "name": "Anziano Darkhorn",
      "translationMetadata": {
