    "deDE": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht.",
        "21180eec040e0ae46c15": "Urahnin Windtotem leistet den Goblins in Ratchet, an der Küste des Brachlands, Gesellschaft.",
        "373fa338f717d9f650b1": "Urahne Proudhorn genießt die Aussicht auf Mulgore von Thunder Bluff aus.",
        "7aabda39009bedc9b67c": "In längst vergangenen Tagen lebten wir für die Jagd. Wir jagten nach Ruhm, nach Ehre…\n\nIst jetzt alles anders?",
        "cbed6444ab5892a52c8b": "Ich habe zuletzt gehört, dass Urahnin Runetotem sich auf den Weg zum Klingenhügel in Durotar gemacht hat.",
        "d4c789d28d5b5c45af61": "Urahne Darkcore ist in Undercity."
      },
      "name": "Urahnin Darkhorn",
      "translationMetadata": {
        "fields": {
