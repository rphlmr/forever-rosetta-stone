    "svSE": {
      "dialogue": {
        "04c5ead99a45bf3f2469": "Äldste Ironband bor i Blackchar Cave i Searing Gorge.",
        "21180eec040e0ae46c15": "Äldste Windtotem håller goblinerna i Ratchet på Barrens kust sällskap.",
        "373fa338f717d9f650b1": "Äldste Proudhorn njuter av utsikten över Mulgore från Thunder Bluff.",
        "7aabda39009bedc9b67c": "I forna dagar levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "cbed6444ab5892a52c8b": "Senast jag hörde var äldste Runetotem på väg till Razor Hill i Durotar.",
        "d4c789d28d5b5c45af61": "Äldste Darkcore finns i Undercity."
      },
      "name": "Äldste Darkhorn",
