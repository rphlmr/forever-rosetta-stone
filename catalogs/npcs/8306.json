    "enUS": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "I can teach you how to cook!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "752b44a65764a14bd999": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself.",
        "7ec23e0706269e64293b": "Cooking is a life long pursuit and I see we share the same passion!",
        "cb2eaceef5f5ed5cfaa6": "Train me."
      },
      "name": "Duhng",
      "subName": "Cook",
