    "plPL": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Mogę nauczyć cię gotować!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odszukać.",
        "752b44a65764a14bd999": "Wulan w Shadowprey Village może ci sprzedać \"Expert Cookbook\". Będzie ci potrzebna, jeśli chcesz się doskonalić.",
        "7ec23e0706269e64293b": "Gotowanie to zajęcie na całe życie i widzę, że podzielamy tę samą pasję!",
        "cb2eaceef5f5ed5cfaa6": "Wyszkol mnie."
      },
      "name": "Duhng",
