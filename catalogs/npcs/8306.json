    "trTR": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Sana yemek yapmayı öğretebilirim!",
        "3f7384f46c8acb396ad8": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarının ustasıdır. Kendini geliştirmek için onu bulmalısın.",
        "752b44a65764a14bd999": "Shadowprey Village'daki Wulan sana \"Expert Cookbook\" satabilir. Kendini geliştirmek istiyorsan ona ihtiyacın olacak.",
        "7ec23e0706269e64293b": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "cb2eaceef5f5ed5cfaa6": "Beni eğit."
      },
      "name": "Duhng",
