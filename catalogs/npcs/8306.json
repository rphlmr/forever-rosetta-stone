    "daDK": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Jeg kan lære dig at lave mad!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham for at blive bedre.",
        "752b44a65764a14bd999": "Wulan i Shadowprey Village kan sælge dig \"Expert Cookbook\". Den får du brug for, hvis du vil blive bedre.",
        "7ec23e0706269e64293b": "Madlavning er en livslang bestræbelse, og jeg kan se, at vi deler samme passion!",
        "cb2eaceef5f5ed5cfaa6": "Træn mig."
      },
      "name": "Duhng",
      "translationMetadata": {
