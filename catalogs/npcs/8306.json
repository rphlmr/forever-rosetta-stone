  "locales": {
    "csCZ": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Mohu tě naučit vařit!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Chceš-li se zlepšit, musíš ho vyhledat.",
        "752b44a65764a14bd999": "Wulan ve Shadowprey Village ti může prodat \"Expert Cookbook\". Budeš ji potřebovat, chceš-li se zlepšit.",
        "7ec23e0706269e64293b": "Vaření je celoživotní poslání a vidím, že sdílíme stejnou vášeň!",
        "cb2eaceef5f5ed5cfaa6": "Vycvičte mě."
      },
      "name": "Duhng",
