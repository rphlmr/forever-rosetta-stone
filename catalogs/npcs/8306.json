    "deDE": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Ich kann Euch das Kochen beibringen!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen.",
        "752b44a65764a14bd999": "Wulan in Shadowprey kann Euch das \"Expertenkochbuch\" verkaufen. Ihr werdet es brauchen, wenn Ihr Euch verbessern wollt.",
        "7ec23e0706269e64293b": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "cb2eaceef5f5ed5cfaa6": "Bildet mich aus."
      },
      "name": "Duhng",
      "subName": "Koch",
