    "hrHR": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Mogu te naučiti kuhati!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave iz Gadgetzana majstor je kulinarskog umijeća. Moraš ga potražiti želiš li se usavršiti.",
        "752b44a65764a14bd999": "Wulan u Shadowprey Villageu može ti prodati \"Expert Cookbook\". Trebat će ti želiš li napredovati.",
        "7ec23e0706269e64293b": "Kuhanje je životni poziv i vidim da dijelimo istu strast!",
        "cb2eaceef5f5ed5cfaa6": "Podučite me."
      },
      "name": "Duhng",
