    "itIT": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Posso insegnarti a cucinare!",
        "3f7384f46c8acb396ad8": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "752b44a65764a14bd999": "Wulan, a Shadowprey Village, può venderti il \"Ricettario dell'Esperto\". Ti servirà, se vuoi migliorarti.",
        "7ec23e0706269e64293b": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "cb2eaceef5f5ed5cfaa6": "Addestrami."
      },
      "name": "Duhng",
