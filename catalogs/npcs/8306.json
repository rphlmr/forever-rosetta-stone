    "ptBR": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Eu posso ensinar você a cozinhar!",
        "3f7384f46c8acb396ad8": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "752b44a65764a14bd999": "Wulan, da Aldeia Pescassombra, pode lhe vender o \"Livro de Receitas do Perito\". Se você quiser se aperfeiçoar, terá de ler esse livro.",
        "7ec23e0706269e64293b": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "cb2eaceef5f5ed5cfaa6": "Treine-me."
      },
      "name": "Barrão",
      "subName": "Cozinheiro",
