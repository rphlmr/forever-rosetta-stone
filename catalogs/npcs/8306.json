    "frFR": {
      "dialogue": {
        "35aecc32ea61bdc743ef": "Je peux vous apprendre à cuisiner !",
        "3f7384f46c8acb396ad8": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "752b44a65764a14bd999": "Wuland du village de Proie-de-l'Ombre peut vous vendre un livre de cuisine pour experts. Il vous faudra bien ça si vous voulez vous améliorer.",
        "7ec23e0706269e64293b": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "cb2eaceef5f5ed5cfaa6": "Entraînez-moi."
      },
      "name": "Duhng",
      "subName": "Cuisinier",
