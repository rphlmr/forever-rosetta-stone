  "locales": {
    "csCZ": {
      "dialogue": {
        "eb31aed1b545650921c1": "„Skvěle jsi sbíral zásoby pro válku,“ říkali. „Povýšíme tě,“ říkali. Ve skutečnosti tím mysleli: „Budeš hlídat před hmyzím úlem v Silithu s bandou zpocených trpaslíků, Carnesi!“$B$BDíky za povýšení, kapitáne!"
      },
      "name": "Seržant Carnes",
      "translationMetadata": {
        "fields": {
          "dialogue.eb31aed1b545650921c1": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "eb31aed1b545650921c1": "„Godt arbejde med at samle forsyninger til krigen,“ sagde de. „Du bliver forfremmet,“ sagde de. Det, de virkelig mente, var: „Du bliver stationeret uden for en insektrede i Silithus med en flok svedige dværge, Carnes!“$B$BTak for forfremmelsen, kaptajn!"
      },
      "name": "Sergent Carnes",
      "translationMetadata": {
        "fields": {
          "dialogue.eb31aed1b545650921c1": {
