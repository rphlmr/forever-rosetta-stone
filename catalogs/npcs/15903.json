          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "eb31aed1b545650921c1": "\"Ein klasse Job in der Kriegsressourcenbeschaffung\" hieß es, \"Wie wär's mit einer Beförderung?\", hieß es. Die Übersetzung von dem ganzen Quatsch lautet: \"Du wirst gleich neben 'nem Käferbau in Silithus zusammen mit 'nem Haufen schwitzender Zwerge stationiert, Carnes.\"\n\nVielen Dank für die Beförderung, Captain!"
      },
      "name": "Sergeant Carnes",
      "translationMetadata": {
        "fields": {
          "dialogue.eb31aed1b545650921c1": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
