    },
    "plPL": {
      "dialogue": {
        "eb31aed1b545650921c1": "„Świetnie zbierałeś zaopatrzenie na wojnę”, mówili. „Dostaniesz awans”, mówili. A tak naprawdę mieli na myśli: „Będziesz stacjonował przed rojaczem w Silithus z bandą spoconych krasnoludów, Carnes!”$B$BDzięki za awans, kapitanie!"
      },
      "name": "Sierżant Carnes",
      "translationMetadata": {
        "fields": {
          "dialogue.eb31aed1b545650921c1": {
