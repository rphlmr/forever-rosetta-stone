            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "eb31aed1b545650921c1": "\"Great job collecting resources for the war,\" they said, \"Have a promotion,\" they said.  What they really meant is \"You're stationed outside a bughive in Silithus with a bunch of sweaty dwarves, Carnes!\"$B$BThanks for the promotion, Captain!"
      },
      "name": "Sergeant Carnes",
      "translationMetadata": {
        "fields": {
          "dialogue.eb31aed1b545650921c1": {
            "origin": "community",
            "source": "Spoken",
