    "hrHR": {
      "dialogue": {
        "eb31aed1b545650921c1": "„Odlično si prikupio zalihe za rat“, rekli su. „Dobit ćeš promaknuće“, rekli su. Zapravo su mislili: „Bit ćeš smješten pred gnijezdom kukaca u Silithusu s hrpom znojnih patuljaka, Carnes!“$B$BHvala na promaknuću, kapetane!"
      },
      "name": "Narednik Carnes",
      "translationMetadata": {
