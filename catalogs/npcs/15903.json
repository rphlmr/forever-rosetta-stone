          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "eb31aed1b545650921c1": "”Bra jobbat med att samla resurser till kriget”, sa de. ”Du får en befordran”, sa de. Vad de egentligen menade var: ”Du ska stationeras utanför ett insektsbo i Silithus med ett gäng svettiga dvärgar, Carnes!”$B$BTack för befordran, kapten!"
      },
      "name": "Sergeant Carnes",
      "translationMetadata": {
