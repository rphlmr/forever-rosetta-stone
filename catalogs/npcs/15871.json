    "hrHR": {
      "dialogue": {
        "48044843063a0d10d50a": "Starješinu Hammershouta možeš pronaći unutar zidina Stormwinda.",
        "572993b9e86e9baffa94": "Starješina Goldwell boravi u selu Kharanos u Dun Moroghu.",
        "5a440d384c2d93cceaa1": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude.",
        "a5b2e8dfb9be7fb30563": "Starješina Bladeswift luta stazama Darnassusa na vrhu Teldrassila.",
        "e4f45712145531bc7abc": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu."
      },
      "name": "Starješina Bronzebeard",
