    "ptBR": {
      "dialogue": {
        "48044843063a0d10d50a": "O Ancião Malhogrito se encontra dentro da muralha de Ventobravo.",
        "572993b9e86e9baffa94": "O ancião Poçodouro passa seu tempo na vila de Kharanos, em Dun Morogh.",
        "5a440d384c2d93cceaa1": "Agora é a hora em que o ano ainda é jovem e a lua brilha forte.\n\nÉ a nossa hora... a hora em que despertam os ancestrais.",
        "a5b2e8dfb9be7fb30563": "O ancião Açolesto vaga pelas ruas de Darnassus, no alto da Teldrassil.",
        "e4f45712145531bc7abc": "O ancião Bandaferro mora na Caverna Calcinar, em Garganta Abrasadora."
      },
      "name": "Ancião Barbabronze",
