    "enUS": {
      "dialogue": {
        "48044843063a0d10d50a": "Elder Hammershout can be found within the walls of Stormwind.",
        "572993b9e86e9baffa94": "Elder Goldwell spends his time in the village of Kharanos in Dun Morogh.",
        "5a440d384c2d93cceaa1": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "a5b2e8dfb9be7fb30563": "Elder Bladeswift wanders the paths of Darnassus atop Teldrassil.",
        "e4f45712145531bc7abc": "Elder Ironband lives in Blackchar Cave in Searing Gorge."
      },
      "name": "Elder Bronzebeard",
      "translationMetadata": {
