    "trTR": {
      "dialogue": {
        "48044843063a0d10d50a": "Bilge Hammershout, Stormwind surlarının içinde bulunabilir.",
        "572993b9e86e9baffa94": "Bilge Goldwell, Dun Morogh'taki Kharanos köyünde vakit geçirir.",
        "5a440d384c2d93cceaa1": "Yılın yeni, ayın parlak olduğu zaman geldi.$B$BBizim zamanımız... kadimlerin uyandığı zaman.",
        "a5b2e8dfb9be7fb30563": "Bilge Bladeswift, Teldrassil'in tepesindeki Darnassus yollarında dolaşır.",
        "e4f45712145531bc7abc": "Bilge Ironband, Searing Gorge'daki Blackchar Mağarası'nda yaşar."
      },
      "name": "Ulu Bronzebeard",
