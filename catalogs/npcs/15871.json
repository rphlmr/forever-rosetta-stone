  "locales": {
    "csCZ": {
      "dialogue": {
        "48044843063a0d10d50a": "Staršího Hammershouta najdeš za hradbami Stormwindu.",
        "572993b9e86e9baffa94": "Starší Goldwell tráví čas ve vesnici Kharanos v Dun Moroghu.",
        "5a440d384c2d93cceaa1": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... kdy se probouzejí pradávní.",
        "a5b2e8dfb9be7fb30563": "Starší Bladeswift se prochází po cestách Darnassu na vrcholu Teldrassilu.",
        "e4f45712145531bc7abc": "Starší Ironband žije v jeskyni Blackchar v Searing Gorge."
      },
      "name": "Starší Bronzebeard",
