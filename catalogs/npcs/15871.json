    "plPL": {
      "dialogue": {
        "48044843063a0d10d50a": "Starszego Hammershouta znajdziesz w murach Stormwind.",
        "572993b9e86e9baffa94": "Starszy Goldwell przebywa we wsi Kharanos w Dun Morogh.",
        "5a440d384c2d93cceaa1": "Nastał czas nowego roku, a księżyc świeci jasno.$B$BTo nasz czas... czas przebudzenia pradawnych.",
        "a5b2e8dfb9be7fb30563": "Starszy Bladeswift przemierza ścieżki Darnassus na szczycie Teldrassilu.",
        "e4f45712145531bc7abc": "Starszy Ironband mieszka w jaskini Blackchar w Searing Gorge."
      },
      "name": "Starszy Bronzebeard",
