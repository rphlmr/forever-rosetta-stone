    "deDE": {
      "dialogue": {
        "48044843063a0d10d50a": "Urahne Hammershout hält sich innerhalb der Mauern von Stormwind auf.",
        "572993b9e86e9baffa94": "Urahne Goldwell verbringt seine Zeit im Dorf Kharanos in Dun Morogh.",
        "5a440d384c2d93cceaa1": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "a5b2e8dfb9be7fb30563": "Urahne Bladeswift wandert die Pfade von Darnassus in Teldrassil entlang.",
        "e4f45712145531bc7abc": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht."
      },
      "name": "Urahne Bronzebeard",
