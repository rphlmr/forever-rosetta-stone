    "svSE": {
      "dialogue": {
        "48044843063a0d10d50a": "Den äldre Hammershout finns innanför Stormwinds murar.",
        "572993b9e86e9baffa94": "Den äldre Goldwell vistas i byn Kharanos i Dun Morogh.",
        "5a440d384c2d93cceaa1": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "a5b2e8dfb9be7fb30563": "Den äldre Bladeswift vandrar längs Darnassus stigar på Teldrassils topp.",
        "e4f45712145531bc7abc": "Den äldre Ironband bor i Blackchar-grottan i Searing Gorge."
      },
      "name": "Äldste Bronzebeard",
