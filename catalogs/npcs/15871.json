    "esES": {
      "dialogue": {
        "48044843063a0d10d50a": "Puedes encontrar al ancestro Rugidomazo dentro de las murallas de Ventormenta.",
        "572993b9e86e9baffa94": "El ancestro Pozo de Oro se encuentra en la aldea de Kharanos en Dun Morogh.",
        "5a440d384c2d93cceaa1": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten.",
        "a5b2e8dfb9be7fb30563": "El ancestro Filoveloz vaga por los caminos de Darnassus en lo alto de Teldrassil.",
        "e4f45712145531bc7abc": "El ancestro Vetaferro vive en la Cueva Tizonegro en La Garganta de Fuego."
      },
      "name": "Ancestro Barbabronce",
