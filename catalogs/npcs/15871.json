    "daDK": {
      "dialogue": {
        "48044843063a0d10d50a": "Ældste Hammershout findes inden for Stormwinds mure.",
        "572993b9e86e9baffa94": "Ældste Goldwell opholder sig i landsbyen Kharanos i Dun Morogh.",
        "5a440d384c2d93cceaa1": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "a5b2e8dfb9be7fb30563": "Ældste Bladeswift vandrer ad Darnassus' stier på toppen af Teldrassil.",
        "e4f45712145531bc7abc": "Ældste Ironband bor i Blackchar-hulen i Searing Gorge."
      },
      "name": "Ældste Bronzebeard",
