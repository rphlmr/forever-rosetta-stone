    "hrHR": {
      "dialogue": {
        "07f5a1acb5aa279a352d": "Čuo sam da Deneb Walker, koja se skriva u Stromgardeu, ima knjigu koja će ti zasigurno pomoći usavršiti tehnike prve pomoći.",
        "0e6cd14ec7ef63de32c6": "Cijenjeni doktor Gustaf VanHowzen može te dalje podučavati. Možeš ga pronaći u Theramoreu, gdje u vojarni liječi ranjenike.",
        "44b276492c4b5e9e60f6": "Mogu te podučiti tehnikama prve pomoći.",
        "9662acc3fa5f34f017a7": "Treba mi obuka."
      },
      "name": "Thamner Pol",
