    "daDK": {
      "dialogue": {
        "07f5a1acb5aa279a352d": "Jeg har hørt, at Deneb Walker, som holder til i Stromgarde, har en bog, der helt sikkert kan hjælpe dig med at forbedre dine førstehjælpsfærdigheder.",
        "0e6cd14ec7ef63de32c6": "Den højt estimerede doktor Gustaf VanHowzen kan undervise dig yderligere. Du finder ham i Theramore, hvor han behandler de sårede i kasernen.",
        "44b276492c4b5e9e60f6": "Jeg kan lære dig førstehjælpsteknikker.",
        "9662acc3fa5f34f017a7": "Jeg har brug for træning."
      },
      "name": "Thamner Pol",
      "translationMetadata": {
        "fields": {
