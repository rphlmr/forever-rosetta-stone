  "locales": {
    "csCZ": {
      "dialogue": {
        "07f5a1acb5aa279a352d": "Slyšel jsem, že Deneb Walker, která se ukrývá ve Stromgarde, má knihu, která ti určitě pomůže zdokonalit se v první pomoci.",
        "0e6cd14ec7ef63de32c6": "Vážený doktor Gustaf VanHowzen tě může dále vycvičit. Najdeš ho v Theramore, kde v kasárnách ošetřuje raněné.",
        "44b276492c4b5e9e60f6": "Mohu tě naučit postupům první pomoci.",
        "9662acc3fa5f34f017a7": "Potřebuji výcvik."
      },
      "name": "Thamner Pol",
      "translationMetadata": {
        "fields": {
