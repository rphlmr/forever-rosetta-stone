    "enUS": {
      "dialogue": {
        "07f5a1acb5aa279a352d": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques.",
        "0e6cd14ec7ef63de32c6": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks.",
        "44b276492c4b5e9e60f6": "I can train you in First Aid techniques.",
        "9662acc3fa5f34f017a7": "I require training."
      },
      "name": "Thamner Pol",
      "subName": "Physician",
      "translationMetadata": {
