    "trTR": {
      "dialogue": {
        "07f5a1acb5aa279a352d": "Stromgarde’da saklanan Deneb Walker’ın, İlk Yardım tekniklerini geliştirmene kesinlikle yardımcı olacak bir kitabı olduğunu duydum.",
        "0e6cd14ec7ef63de32c6": "Saygıdeğer Doktor Gustaf VanHowzen eğitimine devam edebilir. Onu Theramore’daki kışlada yaralıları tedavi ederken bulabilirsin.",
        "44b276492c4b5e9e60f6": "Sana İlk Yardım tekniklerini öğretebilirim.",
        "9662acc3fa5f34f017a7": "Eğitime ihtiyacım var."
      },
      "name": "Thamner Pol",
