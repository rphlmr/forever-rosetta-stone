    "plPL": {
      "dialogue": {
        "07f5a1acb5aa279a352d": "Słyszałem, że Deneb Walker, która ukrywa się w Stromgarde, ma książkę, która z pewnością pomoże ci doskonalić techniki pierwszej pomocy.",
        "0e6cd14ec7ef63de32c6": "Szanowany doktor Gustaf VanHowzen może dalej cię szkolić. Znajdziesz go w Theramore, gdzie opatruje rannych w koszarach.",
        "44b276492c4b5e9e60f6": "Mogę nauczyć cię technik pierwszej pomocy.",
        "9662acc3fa5f34f017a7": "Potrzebuję szkolenia."
      },
      "name": "Thamner Pol",
      "translationMetadata": {
        "fields": {
          "dialogue.07f5a1acb5aa279a352d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
