    "enUS": {
      "dialogue": {
        "31988e935d89c389bce1": "Yes, Augustus.  I would like to do business.",
        "e46fcbc4f93f01500dee": "Hi $n!  Are you here to buy something?  Or maybe sell something?$B$BYou won't find better prices anywhere, or my name isn't Augustus the Touched!",
        "fab1210c8c57414f4df1": "Before the Scourge came, I had a great business.  I bought and sold everything.  Everything!$B$BAnd my prices were INSANE!$B$BJust ask anyone.  Anyone who's not dead."
      },
      "name": "Augustus the Touched",
      "translationMetadata": {
