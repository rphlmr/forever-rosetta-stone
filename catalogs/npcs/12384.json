  "locales": {
    "csCZ": {
      "dialogue": {
        "31988e935d89c389bce1": "Ano, Auguste. Rád bych obchodoval.",
        "e46fcbc4f93f01500dee": "Ahoj, $n! Přišel sis něco koupit? Nebo snad něco prodat?$B$BLepší ceny nikde nenajdeš, nebo se nejmenuji Augustus Pomatený!",
        "fab1210c8c57414f4df1": "Než přišla Pohroma, měl jsem skvělý obchod. Kupoval a prodával jsem všechno. Všechno!$B$BA mé ceny byly ŠÍLENÉ!$B$BZeptej se kohokoli. Kohokoli, kdo není mrtvý."
      },
      "name": "Augustus Dotčený",
      "translationMetadata": {
        "fields": {
          "dialogue.31988e935d89c389bce1": {
