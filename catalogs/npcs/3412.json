    "daDK": {
      "dialogue": {
        "02a4d403f2617c934af5": "Du har endnu ikke gjort dig fortjent til at træne hos mig. Tal først med Thund ovre ved bordet. Kom tilbage, når han siger, at du er klar!",
        "4b480dd1634e38fe70c2": "Du har bestået din prøve, godt klaret! Din træning kan nu fortsætte.",
        "797b6e25b631234f26f3": "Træn mig.",
        "ae11ef33f202653efbb1": "Du har gjort dig fortjent til at træne hos en højere instruktør. Gå over til min ven Roxxik derovre.",
        "b2ab6ba762c1c4f2fc1a": "Hvis bare døgnet havde et par timer mere..."
      },
      "name": "Nogg",
      "translationMetadata": {
        "fields": {
          "dialogue.02a4d403f2617c934af5": {
