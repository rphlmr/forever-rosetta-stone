    "hrHR": {
      "dialogue": {
        "02a4d403f2617c934af5": "Još nisi zaslužio pravo učiti sa mnom. Najprije posjeti Thunda ondje pokraj stola. Vrati se kad kaže da si spreman!",
        "4b480dd1634e38fe70c2": "Položio si ispit, bravo! Tvoje se učenje sada može nastaviti.",
        "797b6e25b631234f26f3": "Podučite me.",
        "ae11ef33f202653efbb1": "Zaslužio si povlasticu učiti kod naprednijeg instruktora. Idi k mojem prijatelju Roxxiku ondje.",
        "b2ab6ba762c1c4f2fc1a": "Kad bi barem dan imao još nekoliko sati..."
      },
      "name": "Nogg",
      "translationMetadata": {
