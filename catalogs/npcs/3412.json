  "locales": {
    "csCZ": {
      "dialogue": {
        "02a4d403f2617c934af5": "Ještě sis nevysloužil právo cvičit se mnou. Nejprve zajdi za Thundem tam u stolu. Vrať se, až řekne, že jsi připraven!",
        "4b480dd1634e38fe70c2": "Prošel jsi zkouškou, výborně! Tvůj výcvik může pokračovat.",
        "797b6e25b631234f26f3": "Vycvičte mě.",
        "ae11ef33f202653efbb1": "Vysloužil sis výsadu učit se u vyššího instruktora. Zajdi tam za mým kamarádem Roxxikem.",
        "b2ab6ba762c1c4f2fc1a": "Kdyby měl den tak o pár hodin víc..."
      },
      "name": "Nogg",
      "translationMetadata": {
        "fields": {
          "dialogue.02a4d403f2617c934af5": {
