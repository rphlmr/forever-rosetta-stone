    "enUS": {
      "dialogue": {
        "02a4d403f2617c934af5": "You have not yet earned the right to train with me. See Thund first, over by the table. Come back when he says you're ready!",
        "4b480dd1634e38fe70c2": "You have passed your test, well done! Your training may now continue.",
        "797b6e25b631234f26f3": "Train me.",
        "ae11ef33f202653efbb1": "You have earned the privilege of training with a higher instructor. Go see my pal Roxxik there.",
        "b2ab6ba762c1c4f2fc1a": "If there were just a few more hours in a day..."
      },
      "name": "Nogg",
      "subName": "Expert Engineer",
