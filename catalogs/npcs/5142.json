  "factionTemplateId": 55,
  "locales": {
    "csCZ": {
      "dialogue": {
        "3452c9ef60e27b882a73": "Nechť tě Světlo chrání, $c.",
        "85f9545b08920f9e6301": "Hledám další výcvik v kněžském umění.",
        "9c865e9a0cafcc5398e2": "Doufám, že je Světlo s tebou, $n. Mohu pro tebe dnes něco udělat?",
        "ed9dc128e2dfa5bb8240": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvé naučené talenty?"
      },
      "name": "Braenna Flintcrag",
      "translationMetadata": {
        "fields": {
          "dialogue.3452c9ef60e27b882a73": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
