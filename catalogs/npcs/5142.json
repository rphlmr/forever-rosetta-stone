    },
    "daDK": {
      "dialogue": {
        "3452c9ef60e27b882a73": "Må Lyset beskytte dig, $c.",
        "85f9545b08920f9e6301": "Jeg søger mere træning i præsternes kunst.",
        "9c865e9a0cafcc5398e2": "Jeg håber, Lyset er med dig, $n. Er der noget, jeg kan gøre for dig i dag?",
        "ed9dc128e2dfa5bb8240": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Braenna Flintcrag",
      "translationMetadata": {
        "fields": {
          "dialogue.3452c9ef60e27b882a73": {
