    "enUS": {
      "dialogue": {
        "3452c9ef60e27b882a73": "The Light protect you, $c.",
        "85f9545b08920f9e6301": "I seek more training in the priestly ways.",
        "9c865e9a0cafcc5398e2": "I hope the Light is with you, $n. Is there anything I can do for you today?",
        "ed9dc128e2dfa5bb8240": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Braenna Flintcrag",
      "subName": "Priest Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.3452c9ef60e27b882a73": {
