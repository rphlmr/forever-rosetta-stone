    "daDK": {
      "dialogue": {
        "07d36cac4e4af5c32fa1": "Træn mig.",
        "543618692f1927ac577b": "Hva?!? Åh. Du ligner ikke en Defias-tyv... eller et medlem af Nattevagten. Hav medlidenhed med en stakkels sjæl, vil du?",
        "7eb4f6d863967dc71f7b": "Jeg vil gerne se dine varer."
      },
      "name": "Jitters",
      "translationMetadata": {
