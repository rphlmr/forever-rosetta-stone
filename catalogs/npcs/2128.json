    "enUS": {
      "dialogue": {
        "0eb586f00584946bfecf": "Greetings.  I'm an undead mage trainer, and you're a mage.",
        "2e65520923a9fba32279": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "5b7570ad4fb3bf8d65c6": "I am interested in mage training.",
        "7c316359b774d4cc32c0": "I am interested in mage training.",
        "b0f5680ce2c514aeb23a": "Well met, $c.  My advice to you is this: As you travel the world, be wary of magic for it will burn the untrained."
      },
      "name": "Cain Firesong",
      "subName": "Mage Trainer",
      "translationMetadata": {
