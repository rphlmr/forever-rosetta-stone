  "locales": {
    "csCZ": {
      "dialogue": {
        "2852a14e61a245b1273f": "Hledám výcvik.",
        "8260d95fbf794b289c52": "Zdravím tě, mladý zloději. Co hledáš?",
        "a2d5d82ed60a9be9f2eb": "Při důkladném přeškolování jsem musel mnohé žáky zbavit všeho, co se dosud naučili, abych je mohl učit znovu. Pokaždé je tato služba náročnější, a proto je také s každým přeškolením dražší. Chceš, abych tě zbavil naučených talentů?",
        "a4809317959ab68bb6e6": "Jsme jen temnota a stíny. Věční. Neviditelní.",
        "a5a358faab931c26ccde": "Poslové z Ravenholdu mi dnes ráno doručili tento dopis. Je adresován tobě, $n.",
        "fb1cb2aee8ed40e34195": "Tvůj druh necvičím, $c."
      },
      "name": "Erion Shadewhisper",
      "translationMetadata": {
        "fields": {
