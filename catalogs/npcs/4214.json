    "daDK": {
      "dialogue": {
        "2852a14e61a245b1273f": "Jeg søger træning.",
        "8260d95fbf794b289c52": "Goddag, unge slyngel. Hvad søger du?",
        "a2d5d82ed60a9be9f2eb": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver sværere at udføre hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme dine lærte talenter?",
        "a4809317959ab68bb6e6": "Vi er kun mørke og skygger. Evige. Usynlige.",
        "a5a358faab931c26ccde": "Budbringere fra Ravenholdt afleverede dette brev til mig i morges. Det er adresseret til dig, $n.",
        "fb1cb2aee8ed40e34195": "Jeg træner ikke din slags, $c."
      },
      "name": "Erion Shadewhisper",
      "translationMetadata": {
        "fields": {
