    "hrHR": {
      "dialogue": {
        "2852a14e61a245b1273f": "Tražim poduku.",
        "8260d95fbf794b289c52": "Pozdrav, mladi lupežu. Što tražiš?",
        "a2d5d82ed60a9be9f2eb": "Temeljitom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su prethodno naučili kako bih ih mogao poučiti iznova. Tu je uslugu svaki put sve teže pružiti. Zato je svaka prekvalifikacija sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "a4809317959ab68bb6e6": "Mi smo samo tama i sjene. Vječni. Nevidljivi.",
        "a5a358faab931c26ccde": "Glasnici iz Ravenholdta jutros su mi dostavili ovo pismo. Naslovljeno je na tebe, $n.",
        "fb1cb2aee8ed40e34195": "Ne obučavam tvoju vrstu, $c."
      },
      "name": "Erion Shadewhisper",
