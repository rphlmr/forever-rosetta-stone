    "plPL": {
      "dialogue": {
        "2852a14e61a245b1273f": "Szukam szkolenia.",
        "8260d95fbf794b289c52": "Witaj, młody łotrze. Czego szukasz?",
        "a2d5d82ed60a9be9f2eb": "Dzięki gruntownemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mógł uczyć ich od nowa. Za każdym razem ta usługa staje się trudniejsza. Dlatego z każdym przeszkoleniem kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć poznane talenty?",
        "a4809317959ab68bb6e6": "Jesteśmy tylko ciemnością i cieniami. Wiecznymi. Niewidzialnymi.",
        "a5a358faab931c26ccde": "Posłańcy z Ravenholdt dostarczyli mi dziś rano ten list. Jest zaadresowany do ciebie, $n.",
        "fb1cb2aee8ed40e34195": "Nie szkolę takich jak ty, $c."
      },
      "name": "Erion Shadewhisper",
      "translationMetadata": {
