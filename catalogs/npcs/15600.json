    "hrHR": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Zvijezde ovog doba kreću novim putovima, svjetionici nade i snage za buduća vremena.",
        "6e823f2accda3234db21": "Selo Astranaar u Ashenvaleu trenutačni je dom starješine Riversong.",
        "8d0f36007e4f794b806d": "Starješina Bladeswift luta stazama Darnassusa na Teldrassilu.",
        "ca70c6bb6459f007b4e8": "Starješina Nightwind provodi dane u svetištu u Jaedenaru u Felwoodu.",
        "f7d06105c977b2787d48": "Selo Dolanaar na Teldrassilu dom je starješine Bladeleaf."
      },
      "name": "Starješina Skygleam",
