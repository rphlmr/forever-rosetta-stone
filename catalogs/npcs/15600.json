    "plPL": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Gwiazdy tej epoki podążają nowymi szlakami, niosąc nadzieję i siłę przyszłym pokoleniom.",
        "6e823f2accda3234db21": "Starszy Riversong mieszka obecnie w wiosce Astranaar w Ashenvale.",
        "8d0f36007e4f794b806d": "Starszy Bladeswift przemierza ścieżki Darnassus na Teldrassilu.",
        "ca70c6bb6459f007b4e8": "Starszy Nightwind spędza dni przy świątyni w Jaedenar w Felwood.",
        "f7d06105c977b2787d48": "Wioska Dolanaar na Teldrassilu jest domem starszego Bladeleaf."
      },
      "name": "Starsza Skygleam",
      "translationMetadata": {
