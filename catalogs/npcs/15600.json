  "locales": {
    "csCZ": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Hvězdy této doby se vydávají novými cestami, jsou majáky naděje a síly pro nadcházející věky.",
        "6e823f2accda3234db21": "Starší Riversong nyní žije ve vesnici Astranaar v Ashenvale.",
        "8d0f36007e4f794b806d": "Starší Bladeswift putuje po cestách Darnassu na Teldrassilu.",
        "ca70c6bb6459f007b4e8": "Starší Nightwind tráví dny u svatyně v Jaedenaru ve Felwoodu.",
        "f7d06105c977b2787d48": "Domovem starší Bladeleaf je vesnice Dolanaar na Teldrassilu."
      },
      "name": "Starší Skygleam",
