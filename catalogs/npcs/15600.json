    "ltLT": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Šio meto žvaigždės pasuko naujais keliais, tapdamos vilties ir stiprybės švyturiais ateinantiems amžiams.",
        "6e823f2accda3234db21": "Vyresnysis Riversong šiuo metu gyvena Astranaar kaime, Ashenvale.",
        "8d0f36007e4f794b806d": "Vyresnysis Bladeswift klaidžioja Darnassus takais, Teldrassil viršūnėje.",
        "ca70c6bb6459f007b4e8": "Vyresnysis Nightwind leidžia dienas Jaedenar šventovėje, Felwood.",
        "f7d06105c977b2787d48": "Vyresnysis Bladeleaf gyvena Dolanaar kaime, Teldrassil viršūnėje."
      },
      "name": "Vyresnysis Skygleam",
