    "enUS": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "6e823f2accda3234db21": "The village of Astranaar in Ashenvale is Elder Riversong's current home.",
        "8d0f36007e4f794b806d": "Elder Bladeswift wanders the paths of Darnassus atop Teldrassil.",
        "ca70c6bb6459f007b4e8": "Elder Nightwind passes the days at the shrine in Jaedenar in Felwood.",
        "f7d06105c977b2787d48": "The village of Dolanaar atop Teldrassil is home to Elder Bladeleaf."
      },
      "name": "Elder Skygleam",
