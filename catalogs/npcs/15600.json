    "deDE": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Die Sterne bewegen sich nun auf neuen Bahnen fort. Fortan scheinen sie als Zeichen der Hoffnung und der Stärke für kommende Zeiten.",
        "6e823f2accda3234db21": "Das Dorf Astranaar in Ashenvale ist Urahnin Riversongs momentanes Zuhause.",
        "8d0f36007e4f794b806d": "Urahne Bladeswift wandert die Pfade von Darnassus in Teldrassil entlang.",
        "ca70c6bb6459f007b4e8": "Urahne Nightwind verbringt seine Zeit in dem Schrein in Jaedenar im Teufelswald.",
        "f7d06105c977b2787d48": "Das Dorf Dolanaar auf Teldrassil ist das Zuhause des Urahnen Bladeleaf."
      },
      "name": "Urahne Skygleam",
