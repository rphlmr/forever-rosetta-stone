    "daDK": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "6e823f2accda3234db21": "Ældste Riversong bor nu i landsbyen Astranaar i Ashenvale.",
        "8d0f36007e4f794b806d": "Ældste Bladeswift vandrer ad Darnassus’ stier på Teldrassil.",
        "ca70c6bb6459f007b4e8": "Ældste Nightwind tilbringer dagene ved helligdommen i Jaedenar i Felwood.",
        "f7d06105c977b2787d48": "Landsbyen Dolanaar på Teldrassil er hjemsted for ældste Bladeleaf."
      },
      "name": "Ældste Skygleam",
