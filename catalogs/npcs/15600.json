    "svSE": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Denna tids stjärnor följer nya banor, fyrar av hopp och styrka för kommande tidsåldrar.",
        "6e823f2accda3234db21": "Byn Astranaar i Ashenvale är för närvarande äldste Riversongs hem.",
        "8d0f36007e4f794b806d": "Äldste Bladeswift vandrar längs Darnassus stigar på Teldrassil.",
        "ca70c6bb6459f007b4e8": "Äldste Nightwind tillbringar dagarna vid helgedomen i Jaedenar i Felwood.",
        "f7d06105c977b2787d48": "Byn Dolanaar på Teldrassil är hem åt äldste Bladeleaf."
      },
      "name": "Äldste Skygleam",
