    "trTR": {
      "dialogue": {
        "13fb3b7fd056750ffcba": "Bu çağın yıldızları yeni yollara yöneliyor, gelecek çağlar için umut ve güç ışıkları oluyor.",
        "6e823f2accda3234db21": "Ashenvale’deki Astranaar köyü şu anda Bilge Riversong’un evidir.",
        "8d0f36007e4f794b806d": "Bilge Bladeswift, Teldrassil üzerindeki Darnassus’un yollarında dolaşır.",
        "ca70c6bb6459f007b4e8": "Bilge Nightwind günlerini Felwood’daki Jaedenar tapınağında geçirir.",
        "f7d06105c977b2787d48": "Teldrassil üzerindeki Dolanaar köyü, Bilge Bladeleaf’in evidir."
      },
      "name": "Ulu Skygleam",
