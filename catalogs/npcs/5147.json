        }
      }
    },
    "daDK": {
      "dialogue": {
        "5f248985d3b952c01db1": "Jeg vil gerne videreuddanne mig i Lysets veje.",
        "99c4f9642e96fa796b24": "Du følger måske ikke Lysets veje som en ridder af Sølvhånden, men du kan altid bede os om hjælp.",
        "c2fc5ab5673da6429142": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, de tidligere lærte, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "d345f8551e5897f1b724": "Lyset være med dig, $c. Hvordan kan jeg hjælpe dig?"
      },
      "name": "Valgar Highforge",
      "translationMetadata": {
        "fields": {
          "dialogue.5f248985d3b952c01db1": {
