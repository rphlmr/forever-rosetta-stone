  "locales": {
    "csCZ": {
      "dialogue": {
        "5f248985d3b952c01db1": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "99c4f9642e96fa796b24": "Možná nekráčíš cestou Světla jako rytíř Stříbrné ruky, ale vždy nás můžeš požádat o pomoc.",
        "c2fc5ab5673da6429142": "Přísným přeškolením jsem musel mnoho žáků odnaučit všemu, co dříve znali, abych je mohl učit znovu. Tato služba je s každým opakováním náročnější, a proto také dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "d345f8551e5897f1b724": "Světlo s tebou, $c. Jak ti mohu pomoci?"
      },
      "name": "Valgar Highforge",
      "translationMetadata": {
        "fields": {
          "dialogue.5f248985d3b952c01db1": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
