    "plPL": {
      "dialogue": {
        "7dccf8635eaf04b9350a": "Witaj. Jestem nieumarłym nauczycielem magów, a ty jesteś magiem.",
        "8555dbe294dccbb93d7d": "Interesuje mnie szkolenie maga.",
        "8dea7f5f655b8b7f65a0": "Witaj, $c. Oto moja rada: podróżując po świecie, strzeż się magii, gdyż spali niewprawnych.",
        "9d4986eb13cfb633d7a1": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by móc uczyć ich od nowa. Z każdym kolejnym razem ta usługa staje się trudniejsza, a przez to także droższa. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "9e1fe032883e49f13553": "Interesuje mnie szkolenie maga."
      },
      "name": "Pierce Shackleton",
