    "enUS": {
      "dialogue": {
        "7dccf8635eaf04b9350a": "Greetings.  I'm an undead mage trainer, and you're a mage.",
        "8555dbe294dccbb93d7d": "I am interested in mage training.",
        "8dea7f5f655b8b7f65a0": "Well met, $c.  My advice to you is this: As you travel the world, be wary of magic for it will burn the untrained.",
        "9d4986eb13cfb633d7a1": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "9e1fe032883e49f13553": "I am interested in mage training."
      },
      "name": "Pierce Shackleton",
      "subName": "Mage Trainer",
      "translationMetadata": {
        "fields": {
