  "locales": {
    "csCZ": {
      "dialogue": {
        "7dccf8635eaf04b9350a": "Zdravím. Jsem nemrtvý učitel mágů a ty jsi mág.",
        "8555dbe294dccbb93d7d": "Mám zájem o výcvik mága.",
        "8dea7f5f655b8b7f65a0": "Vítej, $c. Poradím ti toto: při cestách světem si dávej pozor na magii, neboť spálí ty, kdo nejsou vycvičení.",
        "9d4986eb13cfb633d7a1": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým dalším přeškolením těžší provést. Proto je také pokaždé dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "9e1fe032883e49f13553": "Mám zájem o výcvik mága."
      },
      "name": "Pierce Shackleton",
      "translationMetadata": {
        "fields": {
