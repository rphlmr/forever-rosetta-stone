    "daDK": {
      "dialogue": {
        "7dccf8635eaf04b9350a": "Vær hilset. Jeg er en udød magikertræner, og du er magiker.",
        "8555dbe294dccbb93d7d": "Jeg er interesseret i magikertræning.",
        "8dea7f5f655b8b7f65a0": "Vel mødt, $c. Mit råd er dette: Pas på magi, når du rejser rundt i verden, for den brænder de utrænede.",
        "9d4986eb13cfb633d7a1": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre, hver gang den gentages. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?",
        "9e1fe032883e49f13553": "Jeg er interesseret i magikertræning."
      },
      "name": "Pierce Shackleton",
      "translationMetadata": {
