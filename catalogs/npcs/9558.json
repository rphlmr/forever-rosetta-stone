    },
    "ptBR": {
      "dialogue": {
        "abc75769e41ed349c304": "Você parece alguém que precisa cruzar o Grande Oceano. Ora, você veio ao lugar certo! Este é o ancoradouro do Capricho da Donzela, o melhor navio de passageiros destas águas. Quando ele chegar é só embarcar, e daqui a pouco você estará tomando sol nas praias brancas do Espinhaço."
      },
      "name": "Taramela",
      "subName": "Capitão",
