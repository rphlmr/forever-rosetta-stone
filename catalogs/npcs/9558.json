  "locales": {
    "csCZ": {
      "dialogue": {
        "abc75769e41ed349c304": "Vypadáš, že potřebuješ přepravit přes Great Sea. Pak jsi na správném místě, tady kotví Maiden's Fancy, nejlepší osobní loď, která se po těchto vodách plaví. Až připluje, stačí nastoupit a zanedlouho se budeš vyhřívat na písečných plážích Stranglethornu."
      },
      "name": "Grimble",
      "translationMetadata": {
        "fields": {
          "dialogue.abc75769e41ed349c304": {
