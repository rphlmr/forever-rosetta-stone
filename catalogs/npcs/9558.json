            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "abc75769e41ed349c304": "Du ser ud til at have brug for en overfart over Great Sea. Så er du kommet til det rette sted. Her lægger Maiden's Fancy til, det fineste passagerskib på disse vande. Når hun ankommer, skal du blot gå om bord, og før du ved af det, kan du sole dig på Stranglethorns sandstrande."
      },
      "name": "Grimble",
      "translationMetadata": {
        "fields": {
          "dialogue.abc75769e41ed349c304": {
