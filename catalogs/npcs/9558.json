    "hrHR": {
      "dialogue": {
        "abc75769e41ed349c304": "Čini se da ti treba prijevoz preko Great Seaja. Došao si na pravo mjesto, ovdje pristaje Maiden's Fancy, najbolji putnički brod koji plovi ovim vodama. Kad stigne, samo se ukrcaj i začas ćeš uživati na pješčanim plažama Stranglethorna."
      },
      "name": "Grimble",
      "translationMetadata": {
