    "enUS": {
      "dialogue": {
        "abc75769e41ed349c304": "You look like you might be needing passage across the Great Sea. Well you have come to the right place, this here is the berth of the Maiden's Fancy, finest passenger ship to travel these waters. When she arrives, just climb aboard and the next thing you know you will find yourself basking on the sandy beaches of Stranglethorn."
      },
      "name": "Grimble",
      "subName": "Shipmaster",
      "translationMetadata": {
        "fields": {
