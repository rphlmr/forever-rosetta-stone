  "locales": {
    "csCZ": {
      "dialogue": {
        "1c14c96fec9931e38fc7": "Tvé schopnosti už přesahují mé možnosti. Nastal čas čelit novým výzvám. Taladan ti pomůže s přípravou. Stojí tam u stolu.",
        "288d8e340ff01aa5e030": "Vycvičte mě.",
        "a0b14c856fc460c03196": "Naučím tě, co budu moci. Každá lekce je darem samotné Bohyně. Nakládej s jejími dary moudře a nezakolísáš.",
        "b7cff4f9267dc118d6eb": "Bohyně mi propůjčila moudrost, cizinče. Bude-li to její vůle, předám ti ji."
      },
      "name": "Lalina Summermoon",
      "translationMetadata": {
        "fields": {
          "dialogue.1c14c96fec9931e38fc7": {
