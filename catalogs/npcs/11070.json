    "esMX": {
      "dialogue": {
        "1c14c96fec9931e38fc7": "Tus habilidades quedan fuera de mi alcance. Es hora de que afrontes nuevos retos. Taladan te ayudará a prepararte. Está junto a esa mesa.",
        "288d8e340ff01aa5e030": "Entréname.",
