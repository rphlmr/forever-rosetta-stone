    "daDK": {
      "dialogue": {
        "1c14c96fec9931e38fc7": "Dine evner er vokset ud over, hvad jeg kan lære dig. Det er tid til nye udfordringer. Taladan vil hjælpe dig med at forberede dig. Han står derovre ved bordet.",
        "288d8e340ff01aa5e030": "Træn mig.",
        "a0b14c856fc460c03196": "Jeg vil lære dig, hvad jeg kan. Hver lektion er en gave fra Gudinden selv. Brug hendes gaver med omtanke, så vil du ikke vakle.",
        "b7cff4f9267dc118d6eb": "Gudinden har skænket mig visdom, fremmede. Hvis det er hendes vilje, vil jeg give den videre til dig."
      },
      "name": "Lalina Summermoon",
      "translationMetadata": {
        "fields": {
          "dialogue.1c14c96fec9931e38fc7": {
            "origin": "ai",
