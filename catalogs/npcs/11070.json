    "hrHR": {
      "dialogue": {
        "1c14c96fec9931e38fc7": "Tvoje su vještine izvan mojeg dosega. Vrijeme je da se suočiš s novim izazovima. Taladan će ti pomoći pripremiti se. Stoji ondje kraj stola.",
        "288d8e340ff01aa5e030": "Podučite me.",
        "a0b14c856fc460c03196": "Naučit ću te što mogu. Svaka je lekcija dar same Božice. Mudro koristi njezine darove i nećeš posrnuti.",
        "b7cff4f9267dc118d6eb": "Božica mi je podarila mudrost, stranče. Ako je to njezina volja, prenijet ću je tebi."
      },
      "name": "Lalina Summermoon",
      "translationMetadata": {
