    "enUS": {
      "dialogue": {
        "1c14c96fec9931e38fc7": "Your skills are beyond my reach. It is time for you to face new challenges. Taladan will help you prepare. He is standing by the table there.",
        "288d8e340ff01aa5e030": "Train me.",
        "a0b14c856fc460c03196": "I will teach you what I can. Each lesson is a gift from the Goddess herself. Use her gifts wisely, and you shall not falter.",
        "b7cff4f9267dc118d6eb": "The Goddess has granted me wisdom, stranger. If it is her will, I shall pass it on to you."
      },
      "name": "Lalina Summermoon",
      "subName": "Journeyman Enchanter",
      "translationMetadata": {
        "fields": {
