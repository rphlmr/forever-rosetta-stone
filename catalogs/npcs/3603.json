  "locales": {
    "csCZ": {
      "dialogue": {
        "53e4d768d0e49ea2d7ff": "Vycvičte mě.",
        "5ff0c26376da9c5ee5db": "Druidové říkají, že je jen otázkou času, než sama příroda vyžene Hordu z Kalimdoru. Přesto se naší zemí dál šíří zkaženost, dokonce i tady na Teldrassilu.",
        "9ee8c961dbbd77d9d87a": "Bohužel tě toho vzhledem k tvým zkušenostem mohu naučit jen málo, příteli. Vyhledej noční elfku Sylvannu Forestmoon, která žije na Řemeslnické terase v Darnassu.",
        "e7c085e684ac099476d4": "Dobrá práce! Tvé znalosti lektvarů se pěkně rozvíjejí."
      },
      "name": "Cyndra Kindwhisper",
      "translationMetadata": {
        "fields": {
          "dialogue.53e4d768d0e49ea2d7ff": {
            "origin": "ai",
