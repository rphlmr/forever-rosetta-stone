          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "53e4d768d0e49ea2d7ff": "Træn mig.",
        "5ff0c26376da9c5ee5db": "Druiderne siger, at det kun er et spørgsmål om tid, før naturen selv driver Horden ud af Kalimdor. Alligevel fortsætter fordærvelsen med at brede sig i vores lande, selv her på Teldrassil.",
        "9ee8c961dbbd77d9d87a": "Desværre kan jeg kun lære en med din erfaring ganske lidt, min ven. Opsøg natelveren Sylvanna Forestmoon, som bor på Håndværkernes Terrasse i Darnassus.",
        "e7c085e684ac099476d4": "Godt klaret! Din forståelse af eliksirer udvikler sig fint."
      },
      "name": "Cyndra Kindwhisper",
      "translationMetadata": {
        "fields": {
          "dialogue.53e4d768d0e49ea2d7ff": {
