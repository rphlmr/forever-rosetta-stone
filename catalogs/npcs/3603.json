    "ltLT": {
      "dialogue": {
        "53e4d768d0e49ea2d7ff": "Pamokyk mane.",
        "5ff0c26376da9c5ee5db": "Druidai sako, kad tik laiko klausimas, kada pati gamta išvys Ordą iš Kalimdoro. Vis dėlto mūsų žemėse, net čia, Teldrassilyje, toliau plinta sugedimas.",
        "9ee8c961dbbd77d9d87a": "Deja, nedaug galiu išmokyti tokios patirties turintį žmogų, bičiuli. Susirask naktinę elfę Sylvanna Forestmoon, gyvenančią Darnassuso Amatininkų terasoje.",
        "e7c085e684ac099476d4": "Šaunu! Tavo žinios apie eliksyrus gražiai auga."
      },
      "name": "Cyndra Kindwhisper",
      "subName": "Alchemikė pameistrė",
      "translationMetadata": {
        "fields": {
