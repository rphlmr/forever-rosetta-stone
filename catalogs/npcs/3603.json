    "hrHR": {
      "dialogue": {
        "53e4d768d0e49ea2d7ff": "Podučite me.",
        "5ff0c26376da9c5ee5db": "Druidi kažu da je samo pitanje vremena kada će sama priroda otjerati Hordu iz Kalimdora. Ipak, iskvarenost se nastavlja širiti našim zemljama, čak i ovdje na Teldrassilu.",
        "9ee8c961dbbd77d9d87a": "Nažalost, malo što mogu naučiti nekoga s tvojim iskustvom, prijatelju. Potraži noćnu vilenjakinju Sylvannu Forestmoon, koja živi na Obrtničkoj terasi u Darnassusu.",
        "e7c085e684ac099476d4": "Bravo! Tvoje razumijevanje napitaka lijepo napreduje."
      },
      "name": "Cyndra Kindwhisper",
      "translationMetadata": {
