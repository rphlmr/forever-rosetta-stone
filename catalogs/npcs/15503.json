  "locales": {
    "csCZ": {
      "dialogue": {
        "64b11d8a83c9303015d1": "Před tisíci lety, když skončila válka Pohyblivých písků, se tři z našich druhů obětovali a zadrželi Qiraje v těchto síních, zatímco Anachronos a Staghelm zapečetili Ahn'Qiraj.$B$BVšichni jsme přísahali, že vyhledáme Merithru, Arygose a Caelestrasze, pokud Skarabeova zeď někdy padne.$B$BA padla... a tak jsme přišli."
      },
      "name": "Kandrostrasz",
      "translationMetadata": {
        "fields": {
          "dialogue.64b11d8a83c9303015d1": {
