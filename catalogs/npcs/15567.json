  "locales": {
    "csCZ": {
      "dialogue": {
        "17d21caa227d2a137408": "Starší Stonefort se uchýlil do podzemí Blackrock Spire.",
        "23f621376f8f846c1e88": "Starší Morndeep tráví čas v Ring of Law v Blackrock Depths.",
        "2cebab1089881b8a0316": "Starší Goldwell tráví čas ve vesnici Kharanos v Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Staršího Bronzebearda najdeš v prastarém domově Bronzebeardů, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Nastal čas nového roku a měsíc jasně září.$B$BJe to náš čas... kdy se probouzejí prastaré bytosti.",
        "a6f8c4e788b8d45c08a3": "Staršího Silverveina najdeš poblíž Thelsamaru v Loch Modan."
      },
      "name": "Starší Ironband",
      "translationMetadata": {
