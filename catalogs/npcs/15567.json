    "deDE": {
      "dialogue": {
        "17d21caa227d2a137408": "Urahne Stonefort hat sich in die Verliese der Blackrockspitze begeben.",
        "23f621376f8f846c1e88": "Urahne Morndeep verbringt seine Zeit im Ring des Gesetzes der Blackrocktiefen.",
        "2cebab1089881b8a0316": "Urahne Goldwell verbringt seine Zeit im Dorf Kharanos in Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Urahne Bronzebeard kann im Zuhause der Ahnen der Bronzebeards angetroffen werden, also in Ironforge.",
        "9ca94bdab8df2b86aaf9": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "a6f8c4e788b8d45c08a3": "Urahne Silvervein ist in der Nähe von Thelsamar, in Loch Modan."
      },
      "name": "Urahne Ironband",
      "translationMetadata": {
