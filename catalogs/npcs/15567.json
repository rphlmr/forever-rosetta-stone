    "trTR": {
      "dialogue": {
        "17d21caa227d2a137408": "Yaşlı Stonefort, Blackrock Spire’ın zindanlarına gitti.",
        "23f621376f8f846c1e88": "Yaşlı Morndeep, Blackrock Depths’teki Ring of Law’da vakit geçiriyor.",
        "2cebab1089881b8a0316": "Yaşlı Goldwell, Dun Morogh’taki Kharanos köyünde vakit geçiriyor.",
        "8b0aa1c9c755665f9d0d": "Yaşlı Bronzebeard’ı Bronzebeardların atalarının yurdu Ironforge’da bulabilirsin.",
        "9ca94bdab8df2b86aaf9": "Şimdi yeni yılın geldiği ve ayın parlakça ışıldadığı zaman.$B$BBu bizim zamanımız... kadimlerin uyandığı zaman.",
        "a6f8c4e788b8d45c08a3": "Yaşlı Silvervein’ı Loch Modan’daki Thelsamar yakınlarında bulabilirsin."
      },
      "name": "Ulu Ironband",
