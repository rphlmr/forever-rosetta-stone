    "esES": {
      "dialogue": {
        "17d21caa227d2a137408": "El ancestro Petraforte se ha ido a las mazmorras de Cumbre de Roca Negra.",
        "23f621376f8f846c1e88": "El ancestro Alborhondo se encuentra en el Círculo de la Ley en las Profundidades de Roca Negra.",
        "2cebab1089881b8a0316": "El ancestro Pozo de Oro se encuentra en la aldea de Kharanos en Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Puedes encontrar al ancestro Barbabronce en Forjaz, hogar ancestral de los Barbabronce.",
        "9ca94bdab8df2b86aaf9": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten.",
        "a6f8c4e788b8d45c08a3": "El ancestro Venaplata se encuentra cerca de Thelsamar en Loch Modan."
      },
      "name": "Ancestro Vetaferro",
