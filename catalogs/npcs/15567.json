    "daDK": {
      "dialogue": {
        "17d21caa227d2a137408": "Ældste Stonefort har begivet sig ned i Blackrock Spires fangekældre.",
        "23f621376f8f846c1e88": "Ældste Morndeep opholder sig ved Ring of Law i Blackrock Depths.",
        "2cebab1089881b8a0316": "Ældste Goldwell opholder sig i landsbyen Kharanos i Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Ældste Bronzebeard kan findes i Bronzebeardernes forfædres hjem, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de gamle vågner.",
        "a6f8c4e788b8d45c08a3": "Ældste Silvervein kan findes nær Thelsamar i Loch Modan."
      },
      "name": "Ældste Ironband",
      "translationMetadata": {
