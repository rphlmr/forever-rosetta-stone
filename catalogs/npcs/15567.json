    "hrHR": {
      "dialogue": {
        "17d21caa227d2a137408": "Starješina Stonefort otišao je u tamnice Blackrock Spirea.",
        "23f621376f8f846c1e88": "Starješina Morndeep provodi vrijeme u Ringu of Law u Blackrock Depthsu.",
        "2cebab1089881b8a0316": "Starješina Goldwell provodi vrijeme u selu Kharanos u Dun Moroghu.",
        "8b0aa1c9c755665f9d0d": "Starješinu Bronzebearda možeš pronaći u pradomovini Bronzebeardovih, Ironforgeu.",
        "9ca94bdab8df2b86aaf9": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude.",
        "a6f8c4e788b8d45c08a3": "Starješinu Silverveina možeš pronaći blizu Thelsamara u Loch Modanu."
      },
      "name": "Starješina Ironband",
