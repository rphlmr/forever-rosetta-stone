    "plPL": {
      "dialogue": {
        "17d21caa227d2a137408": "Starszy Stonefort udał się do podziemi Blackrock Spire.",
        "23f621376f8f846c1e88": "Starszy Morndeep przebywa przy Ring of Law w Blackrock Depths.",
        "2cebab1089881b8a0316": "Starszy Goldwell przebywa w wiosce Kharanos w Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Starszego Bronzebearda można znaleźć w siedzibie przodków rodu Bronzebeardów, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Nadszedł nowy rok, a księżyc świeci jasno.$B$BTo nasz czas... kiedy budzą się pradawni.",
        "a6f8c4e788b8d45c08a3": "Starszego Silverveina można znaleźć niedaleko Thelsamar w Loch Modan."
      },
      "name": "Starszy Ironband",
