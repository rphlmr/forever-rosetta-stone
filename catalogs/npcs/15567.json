    "ptBR": {
      "dialogue": {
        "17d21caa227d2a137408": "O ancião Pedraforte partiu para as masmorras do Pico da Rocha Negra.",
        "23f621376f8f846c1e88": "O ancião Alvafunda passa seu tempo no Círculo da Lei, que fica no Abismo Rocha Negra.",
        "2cebab1089881b8a0316": "O ancião Poçodouro passa seu tempo na vila de Kharanos, em Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "O ancião Barbabronze se encontra no lar ancestral dos Barbabronze, em Altaforja.",
        "9ca94bdab8df2b86aaf9": "Agora é a hora em que o ano ainda é jovem e a lua brilha forte.\n\nÉ a nossa hora... a hora em que despertam os ancestrais.",
        "a6f8c4e788b8d45c08a3": "O ancião Venaprata se encontra perto de Thelsamar, em Loch Modan."
      },
      "name": "Ancião Bandaferro",
