    "svSE": {
      "dialogue": {
        "17d21caa227d2a137408": "Äldste Stonefort har begett sig till Blackrock Spires fängelsehålor.",
        "23f621376f8f846c1e88": "Äldste Morndeep tillbringar sin tid vid Ring of Law i Blackrock Depths.",
        "2cebab1089881b8a0316": "Äldste Goldwell tillbringar sin tid i byn Kharanos i Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Äldste Bronzebeard finns i Bronzebeardsläktens förfäders hem, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "a6f8c4e788b8d45c08a3": "Äldste Silvervein finns nära Thelsamar i Loch Modan."
      },
      "name": "Äldste Ironband",
