    "enUS": {
      "dialogue": {
        "17d21caa227d2a137408": "Elder Stonefort has taken to the dungeons of Blackrock Spire.",
        "23f621376f8f846c1e88": "Elder Morndeep spends time at the Ring of Law in Blackrock Depths.",
        "2cebab1089881b8a0316": "Elder Goldwell spends his time in the village of Kharanos in Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "Elder Bronzebeard can be found in the ancestral home of the Bronzebeards, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "a6f8c4e788b8d45c08a3": "Elder Silvervein can be found near Thelsamar in Loch Modan."
      },
      "name": "Elder Ironband",
