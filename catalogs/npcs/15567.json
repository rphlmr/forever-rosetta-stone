    "itIT": {
      "dialogue": {
        "17d21caa227d2a137408": "L'Anziano Stonefort si è addentrato nei sotterranei di Blackrock Spire.",
        "23f621376f8f846c1e88": "L'Anziano Morndeep passa il suo tempo all'Anello della Legge, a Blackrock Depths.",
        "2cebab1089881b8a0316": "L'Anziano Goldwell passa il suo tempo nel villaggio di Kharanos, a Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "L'Anziano Bronzebeard si trova nella dimora ancestrale dei Bronzebeards, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Questo è il tempo in cui l'anno è nuovo e la luna splende luminosa.\n\nÈ il nostro tempo... quello in cui gli antichi si destano.",
        "a6f8c4e788b8d45c08a3": "L'Anziano Silvervein si trova vicino a Thelsamar, in Loch Modan."
      },
      "name": "Anziano Ironband",
      "translationMetadata": {
        "fields": {
          "dialogue.17d21caa227d2a137408": {
