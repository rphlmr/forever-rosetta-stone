    "frFR": {
      "dialogue": {
        "17d21caa227d2a137408": "L'Ancien Stonefort s'est installé dans les oubliettes du pic Blackrock.",
        "23f621376f8f846c1e88": "L'Ancien Morndeep passe son temps au Cercle de la loi, dans les profondeurs de Blackrock.",
        "2cebab1089881b8a0316": "L’Ancien Goldwell passe son temps au village de Kharanos, à Dun Morogh.",
        "8b0aa1c9c755665f9d0d": "L’Ancien Bronzebeard réside dans le domaine ancestral des Bronzebeard, Ironforge.",
        "9ca94bdab8df2b86aaf9": "Voici venu le temps où l’année renaît et où la lune brille dans le ciel.\n\nVoici notre heure…. L’heure où les anciens s’éveillent.",
        "a6f8c4e788b8d45c08a3": "L'Ancien Silvervein se trouve près de Thelsamar, au Loch Modan."
      },
      "name": "Ancien Ironband",
      "translationMetadata": {
