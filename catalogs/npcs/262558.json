    "daDK": {
      "dialogue": {
        "0650b219f2552327ba1c": "Må ånderne være med dig.",
        "0e16646912cf9f55e36d": "Hvis du ønsker det, kan jeg ud over træning slette kendskabet til dine talenter fra dit sind. Vær advaret: Hver gang du gennemgår proceduren, bliver den sværere og derfor dyrere."
      },
      "name": "Palah Thunderhoof",
      "translationMetadata": {
        "fields": {
