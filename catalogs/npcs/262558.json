    "enUS": {
      "dialogue": {
        "0650b219f2552327ba1c": "May the spirits be with you.",
        "0e16646912cf9f55e36d": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes."
      },
      "name": "Palah Thunderhoof",
      "subName": "Shaman Trainer",
