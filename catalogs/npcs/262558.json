  "locales": {
    "csCZ": {
      "dialogue": {
        "0650b219f2552327ba1c": "Ať tě provázejí duchové.",
        "0e16646912cf9f55e36d": "Pokud si přeješ, mohu kromě výcviku také vymazat znalost tvých talentů z tvé mysli. Měj však na paměti, že s každým dalším provedením je tento postup obtížnější, a tedy i dražší."
      },
      "name": "Palah Thunderhoof",
      "translationMetadata": {
