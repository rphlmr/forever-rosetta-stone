    "hrHR": {
      "dialogue": {
        "0650b219f2552327ba1c": "Neka duhovi budu s tobom.",
        "0e16646912cf9f55e36d": "Ako želiš, osim poduke mogu iz tvojeg uma izbrisati znanje o tvojim talentima. Imaj na umu da je postupak svakim ponavljanjem teže izvesti pa zato postaje i skuplji."
      },
      "name": "Palah Thunderhoof",
