  "locales": {
    "csCZ": {
      "dialogue": {
        "2dc910967b1f4742198c": "Vítej ve Stormwindu! Jsem jedním z městských úředníků a pomáhám občanům prostřednictvím našeho sčítacího úřadu. Pokud potřebuješ najít konkrétní osobu, možná ti dokážu pomoci. Pomocí magie a vytříbené duševní disciplíny mám k těmto záznamům přístup.$B$BPokud se mnou máš nějakou záležitost, prosím pokračuj!"
      },
      "name": "Královský správce Bathrilor",
      "translationMetadata": {
        "fields": {
          "dialogue.2dc910967b1f4742198c": {
