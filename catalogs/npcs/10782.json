    "enUS": {
      "dialogue": {
        "2dc910967b1f4742198c": "Welcome to Stormwind!  I am one of the city's officers, aiding the citizenry of the city through our census bureau.  If you are in need of locating someone specific, then I might be able to assist you.  Through arcane methods and sharpened mental discipline, I am able to access these records.$B$BIf you have business with me, then please proceed!"
      },
      "name": "Royal Factor Bathrilor",
      "subName": "Stormwind Census",
      "translationMetadata": {
