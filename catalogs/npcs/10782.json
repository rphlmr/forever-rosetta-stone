            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "2dc910967b1f4742198c": "Velkommen til Stormwind! Jeg er en af byens embedsmænd og hjælper borgerne gennem vores folketællingskontor. Hvis du søger en bestemt person, kan jeg måske hjælpe. Ved hjælp af magi og skærpet mental disciplin kan jeg tilgå disse optegnelser.$B$BHvis du har et ærinde hos mig, så fortsæt endelig!"
      },
      "name": "Kongelig forvalter Bathrilor",
      "translationMetadata": {
        "fields": {
          "dialogue.2dc910967b1f4742198c": {
