    "enUS": {
      "dialogue": {
        "81339fca5164a6d3e983": "I can teach you the finer points of Mechanostrider Piloting, provided you have enough gold to cover the lesson!",
        "a01443c9ee1eab9d0cbe": "I'd be wasting both your gold and my time if I were to teach you how to pilot a Mechanostrider, $c.  You're just too large!",
        "b4091b24a7f683520b37": "You need to be exalted with the gnomes of the Gnomeregan Exiles before I will teach you how to pilot a Mechanostrider, $c.",
        "ceab5361eb9fe0e32682": "I seek training to ride a steed."
      },
      "name": "Binjy Featherwhistle",
      "subName": "Mechanostrider Pilot",
      "translationMetadata": {
        "fields": {
