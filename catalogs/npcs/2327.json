    "ptBR": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Sim, meu filho? Em que posso ajudá-lo?",
        "304ef30005ae7ac16dd6": "Ouvi dizer que Deneb Walker tem um livro que com certeza vai te ajudar a aperfeiçoar sua técnica de Primeiros Socorros. Ele está escondido em Stromgarde.",
        "3c5a9941567e4383c2b1": "O estimado Doutor Gregório Casagrande pode prosseguir com o seu treinamento. Ele fica em Theramore, cuidando dos feridos no quartel.",
        "4e17f2441014f2df063a": "Sim, minha filha? Em que posso ajudá-la?",
        "5cfb2a5b62c8f3ea2698": "Treine-me.",
        "d031285b145c56a2903d": "Ah, um colega médico. Eu adoraria lhe ensinar algo que lhe fosse útil em suas viagens."
      },
      "name": "Suzi Lira",
      "subName": "Treinamento de Primeiros Socorros",
