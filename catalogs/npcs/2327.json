    "plPL": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Tak, $g synu : córko;? W czym mogę ci pomóc?",
        "304ef30005ae7ac16dd6": "Słyszałam, że Deneb Walker, która ukrywa się w Stromgarde, ma książkę, która na pewno pomoże ci udoskonalić techniki pierwszej pomocy.",
        "3c5a9941567e4383c2b1": "Szanowany doktor Gustaf VanHowzen może dalej cię szkolić. Znajdziesz go w Theramore, gdzie opatruje rannych w koszarach.",
        "4e17f2441014f2df063a": "Tak, $g synu : córko;? W czym mogę ci pomóc?",
        "5cfb2a5b62c8f3ea2698": "Wyszkol mnie.",
        "d031285b145c56a2903d": "Och, kolega po fachu. Z chęcią nauczę cię wszystkiego, co pomoże ci w podróżach."
      },
      "name": "Shaina Fuller",
