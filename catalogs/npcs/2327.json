    "ltLT": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Taip, mano $g sūnau : dukra;? Kuo galiu tau padėti?",
        "304ef30005ae7ac16dd6": "Girdėjau, kad Stromgarde įsitaisiusi Deneb Walker turi knygą, kuri tikrai padės tau patobulinti pirmosios pagalbos įgūdžius.",
        "3c5a9941567e4383c2b1": "Gerbiamas daktaras Gustaf VanHowzen gali tave mokyti toliau. Jį rasi Theramore kareivinėse, gydantį sužeistuosius.",
        "4e17f2441014f2df063a": "Taip, mano $g sūnau : dukra;? Kuo galiu tau padėti?",
        "5cfb2a5b62c8f3ea2698": "Pamokyk mane.",
        "d031285b145c56a2903d": "O, kolega gydytojas. Mielai išmokysiu tave visko, kas padėtų tavo kelionėse."
      },
      "name": "Shaina Fuller",
      "subName": "Pirmosios pagalbos mokytoja",
