    "esES": {
      "dialogue": {
        "1deb3244c0db85b18b93": "¿Sí, hijo mía? ¿En qué puedo ayudarte?",
        "304ef30005ae7ac16dd6": "He oído decir que Deneb Camino, en Stromgarde, tiene un libro que podría ayudarte a mejorar tus técnicas de primeros auxilios.",
        "3c5a9941567e4383c2b1": "El estimado doctor Gustav VanHowzen, puede darte una instrucción mejor. Puedes encontrarle en Theramore, cuidando a los enfermos en el cuartel.",
        "4e17f2441014f2df063a": "¿Sí, hija mía? ¿En qué puedo ayudarte?",
        "5cfb2a5b62c8f3ea2698": "Entréname.",
        "d031285b145c56a2903d": "Oh, un compañero médico. Será un placer para mí enseñarte cualquier cosa que pueda servirte en tus viajes."
      },
      "name": "Shaina Fuller",
      "subName": "Instructor de primeros auxilios",
