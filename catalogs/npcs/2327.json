    "daDK": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Ja, min $g søn : datter;? Hvad kan jeg hjælpe dig med?",
        "304ef30005ae7ac16dd6": "Jeg har hørt, at Deneb Walker, som holder til i Stromgarde, har en bog, der helt sikkert kan forbedre dine førstehjælpsfærdigheder.",
        "3c5a9941567e4383c2b1": "Den højt ansete doktor Gustaf VanHowzen kan undervise dig videre. Han behandler sårede i kasernen i Theramore.",
        "4e17f2441014f2df063a": "Ja, min $g søn : datter;? Hvad kan jeg hjælpe dig med?",
        "5cfb2a5b62c8f3ea2698": "Træn mig.",
        "d031285b145c56a2903d": "Åh, en kollega i lægekunsten. Jeg lærer dig gerne alt, der kan hjælpe dig på dine rejser."
      },
      "name": "Shaina Fuller",
      "translationMetadata": {
