    "svSE": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Ja, min $g son : dotter;? Vad kan jag hjälpa dig med?",
        "304ef30005ae7ac16dd6": "Jag har hört att Deneb Walker, som håller till i Stromgarde, har en bok som säkert kan hjälpa dig att förbättra dina kunskaper i första hjälpen.",
        "3c5a9941567e4383c2b1": "Den högt ansedde doktor Gustaf VanHowzen kan utbilda dig vidare. Du hittar honom i Theramore, där han vårdar sårade i kasernen.",
        "4e17f2441014f2df063a": "Ja, min $g son : dotter;? Vad kan jag hjälpa dig med?",
        "5cfb2a5b62c8f3ea2698": "Träna mig.",
        "d031285b145c56a2903d": "Åh, en läkarkollega. Jag lär dig gärna allt som kan hjälpa dig på dina resor."
      },
      "name": "Shaina Fuller",
