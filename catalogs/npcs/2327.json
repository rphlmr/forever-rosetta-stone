    "frFR": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Oui, mon fils ? Que puis-je faire pour vous ?",
        "304ef30005ae7ac16dd6": "J’ai entendu dire qu’un certain Deneb Walker, qui se planque dans Stromgarde, possède un livre qui pourrait améliorer votre compétence en Premiers soins.",
        "3c5a9941567e4383c2b1": "L’estimable docteur Gustav VanHowzen peut vous faire progresser. Vous le trouverez à la caserne de Theramore, où Il soigne les blessés.",
        "4e17f2441014f2df063a": "Oui, ma fille ? Que puis-je faire pour vous ?",
        "5cfb2a5b62c8f3ea2698": "Entraînez-moi.",
        "d031285b145c56a2903d": "Oh, un camarade Médecin. Je serais heureuse de vous enseigner quelques techniques utiles."
      },
      "name": "Shaina Fuller",
      "subName": "Maître des premiers soins",
