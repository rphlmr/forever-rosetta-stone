    "itIT": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Sì, figlio mio? In cosa posso esserti utile?",
        "304ef30005ae7ac16dd6": "Ho sentito dire che Deneb Walker, rintanato a Stromgarde, ha un libro che ti aiuterà di sicuro a migliorare le tue tecniche di primo soccorso.",
        "3c5a9941567e4383c2b1": "L'illustre Dottor Gustaf VanHowzen può portare avanti il tuo addestramento. Lo trovi a Theramore, alla caserma, dove cura i feriti.",
        "4e17f2441014f2df063a": "Sì, figlia mia? In cosa posso esserti utile?",
        "5cfb2a5b62c8f3ea2698": "Addestrami.",
        "d031285b145c56a2903d": "Oh, un collega medico. Sarò lieta di insegnarti tutto ciò che può esserti utile nei tuoi viaggi."
      },
      "name": "Shaina Fuller",
