  "locales": {
    "csCZ": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Ano, $g synu : dcero;? S čím ti mohu pomoci?",
        "304ef30005ae7ac16dd6": "Slyšela jsem, že Deneb Walker, která se ukrývá ve Stromgarde, má knihu, jež ti určitě pomůže zlepšit dovednosti první pomoci.",
        "3c5a9941567e4383c2b1": "Vážený doktor Gustaf VanHowzen tě může dále vycvičit. Najdeš ho v Theramore, kde v kasárnách ošetřuje raněné.",
        "4e17f2441014f2df063a": "Ano, $g synu : dcero;? S čím ti mohu pomoci?",
        "5cfb2a5b62c8f3ea2698": "Vycvičte mě.",
        "d031285b145c56a2903d": "Ach, další lékař. Ráda tě naučím vše, co by ti mohlo pomoci na cestách."
      },
      "name": "Shaina Fuller",
      "translationMetadata": {
