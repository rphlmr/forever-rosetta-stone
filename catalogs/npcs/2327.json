    "hrHR": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Da, $g sine : kćeri;? Kako ti mogu pomoći?",
        "304ef30005ae7ac16dd6": "Čula sam da Deneb Walker, koja se skriva u Stromgardeu, ima knjigu koja će ti sigurno pomoći poboljšati vještine prve pomoći.",
        "3c5a9941567e4383c2b1": "Cijenjeni doktor Gustaf VanHowzen može te dalje obučavati. Naći ćeš ga u Theramoreu kako liječi ranjenike u vojarni.",
        "4e17f2441014f2df063a": "Da, $g sine : kćeri;? Kako ti mogu pomoći?",
        "5cfb2a5b62c8f3ea2698": "Podučite me.",
        "d031285b145c56a2903d": "Oh, kolega liječnik. Rado ću te naučiti svemu što ti može pomoći na putovanjima."
      },
      "name": "Shaina Fuller",
      "translationMetadata": {
