    "enUS": {
      "dialogue": {
        "1deb3244c0db85b18b93": "Yes my $g son : daughter;? What can I assist you with?",
        "304ef30005ae7ac16dd6": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques.",
        "3c5a9941567e4383c2b1": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks.",
        "4e17f2441014f2df063a": "Yes my $g son : daughter;? What can I assist you with?",
        "5cfb2a5b62c8f3ea2698": "Train me.",
        "d031285b145c56a2903d": "Oh, a fellow Physician. I would be glad to teach you anything that would aid your journeys."
      },
      "name": "Shaina Fuller",
      "subName": "First Aid Trainer",
