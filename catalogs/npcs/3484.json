    "trTR": {
      "dialogue": {
        "334b25522b0956a01528": "Beni eğit.",
        "53ac0fc32ec8830ccb24": "Artık sen de benim kadar biliyorsun dostum. Belki Orgrimmar'daki Magar'ı görmelisin. Dünyanın en neşeli terzisi değildir ama yine de sana yardım eder.",
        "d33512242bdb4ead83d4": "Hey dostum, senin için ne yapabilirim?"
      },
      "name": "Kil'hala",
      "translationMetadata": {
        "fields": {
