    "csCZ": {
      "dialogue": {
        "334b25522b0956a01528": "Vycvičte mě.",
        "53ac0fc32ec8830ccb24": "Teď už toho víš stejně jako já, kámo. Možná zajdi za Magarem do Orgrimmaru. Není to nejveselejší krejčí, ale stejně ti pomůže.",
        "d33512242bdb4ead83d4": "Hej, kámo, co pro tebe můžu udělat?"
      },
      "name": "Kil'hala",
      "translationMetadata": {
