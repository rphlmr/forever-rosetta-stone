    "deDE": {
      "dialogue": {
        "334b25522b0956a01528": "Bildet mich aus.",
        "53ac0fc32ec8830ccb24": "An diesem Punkt wisst Ihr so viel wie ich, Mann. Vielleicht solltet Ihr Magar in Orgrimmar aufsuchen. Is' vielleicht nich' der glücklichste Schneider in der Gegend, aber er wird Euch trotzdem helfen.",
        "d33512242bdb4ead83d4": "He, Mann, was kann ich für Euch tun?"
      },
      "name": "Kil'hala",
      "subName": "Schneidergeselle",
