    "daDK": {
      "dialogue": {
        "334b25522b0956a01528": "Træn mig.",
        "53ac0fc32ec8830ccb24": "Nu ved du lige så meget som mig, ven. Måske skulle du besøge Magar i Orgrimmar. Han er ikke den gladeste skrædder, men han skal nok hjælpe dig.",
        "d33512242bdb4ead83d4": "Hej, ven, hvad kan jeg gøre for dig?"
      },
      "name": "Kil'hala",
      "translationMetadata": {
