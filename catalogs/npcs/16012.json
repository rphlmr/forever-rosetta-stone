          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall has shown great kindness in granting me sanctuary within his domain.  I do not wish to overstay my welcome, at any rate.  It would be a great dishonor if I brought any trouble to our leader."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.7076dcd8d8713a1945ef": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
