    "hrHR": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall mi je iskazao veliku dobrotu pruživši mi utočište u svojoj zemlji. Ne želim predugo iskorištavati njegovo gostoprimstvo. Bila bi velika sramota kad bih našem vođi donio nevolje."
      },
      "name": "Mokvar",
      "translationMetadata": {
