          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall har vist stor venlighed ved at give mig tilflugt i sit rige. Jeg ønsker på ingen måde at blive længere, end jeg er velkommen. Det ville være en stor vanære, hvis jeg bragte problemer over vores leder."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.7076dcd8d8713a1945ef": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
