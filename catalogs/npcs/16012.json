        }
      }
    },
    "trTR": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall, topraklarında bana sığınak sağlayarak büyük bir iyilik gösterdi. Her hâlükârda misafirliğimi uzatmak istemiyorum. Liderimizin başına bir dert açmam büyük bir onursuzluk olurdu."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.7076dcd8d8713a1945ef": {
