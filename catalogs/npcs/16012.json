    },
    "plPL": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall okazał mi wielką życzliwość, udzielając mi schronienia w swych włościach. Nie chcę nadużywać jego gościnności. Byłoby wielką hańbą, gdybym sprowadził kłopoty na naszego przywódcę."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.7076dcd8d8713a1945ef": {
