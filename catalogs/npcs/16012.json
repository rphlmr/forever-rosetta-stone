  "locales": {
    "csCZ": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall mi prokázal velkou laskavost, když mi poskytl útočiště ve své říši. V žádném případě nechci jeho pohostinnosti zneužívat. Byla by to velká hanba, kdybych našemu vůdci způsobil nějaké potíže."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
          "dialogue.7076dcd8d8713a1945ef": {
