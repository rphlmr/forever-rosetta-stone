        }
      }
    },
    "esES": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall ha sido muy generoso acogiéndome en su dominio. De ningún modo quisiera abusar de su hospitalidad. Causarle problemas a nuestro líder sería una gran deshonra para mí."
      },
      "name": "Mokvar",
      "translationMetadata": {
