        }
      }
    },
    "ltLT": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall parodė didžiulį gerumą, suteikdamas man prieglobstį savo valdose. Vis dėlto nenoriu piktnaudžiauti jo svetingumu. Būtų didelė negarbė, jei užtraukčiau mūsų vadui nemalonumų."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
