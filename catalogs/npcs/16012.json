          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall har visat stor vänlighet genom att ge mig en fristad i sitt rike. Jag vill inte stanna längre än jag är välkommen. Det vore en stor vanära om jag orsakade vår ledare några problem."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
