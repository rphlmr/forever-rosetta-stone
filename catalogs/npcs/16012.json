          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "7076dcd8d8713a1945ef": "Thrall mostrou grande gentileza ao me conceder abrigo em seus domínios. De qualquer forma, não quero me demorar demais. Seria uma grande desonra se eu causasse problemas ao nosso líder."
      },
      "name": "Mokvar",
      "translationMetadata": {
        "fields": {
