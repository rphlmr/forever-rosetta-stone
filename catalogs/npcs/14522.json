    "deDE": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "Die Wege von Jaedenar sind dunkel und verschlagen. Wacht über Eure Schritte, $C, oder Eure Seele wird von Euren Feinden verzaubert werden...",
        "e2417a65f13e15af7d74": "Ich möchte etwas bei Euch kaufen."
      },
      "name": "Ur'dan",
