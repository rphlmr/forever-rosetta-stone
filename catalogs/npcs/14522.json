    "plPL": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "Ścieżki Jaedenaru są mroczne i zdradliwe. Uważaj na każdy krok, $C, bo inaczej twoi rywale zniewolą twoją duszę...",
        "e2417a65f13e15af7d74": "Chcę coś od ciebie kupić."
      },
      "name": "Ur'dan",
