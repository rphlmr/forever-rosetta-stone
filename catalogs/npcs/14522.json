    "ptBR": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "Os caminhos do Jaedenar são obscuros e traiçoeiros. Pense duas vezes antes de agir, $c, ou pode acabar tendo sua alma escravizada pelos seus rivais...",
        "e2417a65f13e15af7d74": "Quero comprar algo de você."
      },
