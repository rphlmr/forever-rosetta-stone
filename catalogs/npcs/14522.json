    "daDK": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "Jaedenars veje er mørke og forræderiske. Pas på dine skridt her, $C, ellers vil dine rivaler gøre din sjæl til deres slave...",
        "e2417a65f13e15af7d74": "Jeg vil gerne købe noget af dig."
      },
      "name": "Ur'dan",
      "translationMetadata": {
