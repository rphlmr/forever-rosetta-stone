    "enUS": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "The ways of Jaedenar are dark and treacherous.  Watch your moves in this place, $C, or you will find your soul entralled by your rivals...",
        "e2417a65f13e15af7d74": "I wish to purchase from you."
      },
      "name": "Ur'dan",
