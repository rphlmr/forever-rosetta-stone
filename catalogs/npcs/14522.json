    "hrHR": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "Putovi Jaedenara mračni su i podmukli. Pazi kako se krećeš ovdje, $C, ili će tvoji suparnici zarobiti tvoju dušu...",
        "e2417a65f13e15af7d74": "Želim nešto kupiti od tebe."
      },
      "name": "Ur'dan",
