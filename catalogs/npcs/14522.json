    "csCZ": {
      "dialogue": {
        "2b6ef85d400276d74b9f": "Cesty Jaedenaru jsou temné a zrádné. Dávej si zde pozor na každý krok, $C, nebo tvou duši zotročí tvoji sokové...",
        "e2417a65f13e15af7d74": "Chci od tebe nakoupit."
      },
      "name": "Ur'dan",
      "translationMetadata": {
        "fields": {
