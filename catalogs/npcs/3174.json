  "locales": {
    "csCZ": {
      "dialogue": {
        "24eb943d37a97d037bd6": "Pouhé mávání kladivem nad kovadlinou z tebe kováře neudělá. Dej mi to a nech mě tě něco naučit, než nás všechny ztrapníš.",
        "3145c42f44dee81d1b8f": "Vycvičte mě.",
        "ba876d92879e2bec9218": "Není to špatné. Promluv si se Snarlem, právě se přestěhoval do Orgrimmaru, aby studoval u Sarua. Hledej ho ve čtvrti válečníků poblíž Saruovy kovárny. A vyzkouší tě, takže buď opravdu připraven.",
        "f82c0306e13e284c5dfd": "Uslyším jedinou poznámku o vodním ptactvu a budeš jíst brčkem."
      },
      "name": "Dwukk",
      "translationMetadata": {
        "fields": {
          "dialogue.24eb943d37a97d037bd6": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
