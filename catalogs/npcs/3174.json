        }
      }
    },
    "daDK": {
      "dialogue": {
        "24eb943d37a97d037bd6": "At svinge en hammer mod en ambolt gør dig ikke til smed. Giv mig den, og lad mig lære dig noget, før du gør os alle til grin.",
        "3145c42f44dee81d1b8f": "Træn mig.",
        "ba876d92879e2bec9218": "Ikke dårligt. Tal med Snarl; han er lige flyttet til Orgrimmar for at studere hos Saru. Find ham i krigerkvarteret nær Sarus smedje. Han vil teste dig, så du må hellere være så klar, som du tror.",
        "f82c0306e13e284c5dfd": "Hører jeg én bemærkning om vandfugle, kommer du til at spise gennem et rør."
      },
      "name": "Dwukk",
      "translationMetadata": {
        "fields": {
          "dialogue.24eb943d37a97d037bd6": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
