    "ltLT": {
      "dialogue": {
        "24eb943d37a97d037bd6": "Vien mosuodamas kūju prie priekalo kalviu netapsi. Duokš jį man, pamokysiu tave, kol visų mūsų dar nesugėdinai.",
        "3145c42f44dee81d1b8f": "Pamokyk mane.",
        "ba876d92879e2bec9218": "Neblogai. Nueik pasikalbėti su Snarl, jis ką tik persikėlė į Orgrimmar mokytis pas Saru. Ieškok jo karių rajone, netoli Saru kalvės. Beje, jis tave išbandys, tad geriau jau būk taip pasiruošęs, kaip manaisi esąs.",
        "f82c0306e13e284c5dfd": "Išgirsiu bent vieną pastabą apie vandens paukščius, ir valgysi per vamzdelį."
      },
      "name": "Dwukk",
      "subName": "Patyręs kalvis",
      "translationMetadata": {
