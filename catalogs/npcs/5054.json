    "enUS": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Our ancestors teach us that while the individual must be strong, there is safety in numbers.  Do you wish to defend the honor of Thunder Bluff by organizing a guild?",
        "zephras:89c7d6d8041f8b63e7ac": "How do I form a guild?",
        "zephras:8efc9a1f6147d5cddd98": "I want to create a guild crest."
      },
      "name": "Krumn",
      "subName": "Guild Master",
      "translationMetadata": {
