    "hrHR": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Naši preci uče nas da pojedinac mora biti snažan, ali da je sigurnost u brojnosti. Želiš li braniti čast Thunder Bluffa osnivanjem ceha?",
        "zephras:89c7d6d8041f8b63e7ac": "Kako mogu osnovati ceh?",
        "zephras:8efc9a1f6147d5cddd98": "Želim izraditi cehovski grb."
