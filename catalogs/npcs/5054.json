    "ltLT": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Mūsų protėviai moko, kad nors kiekvienas turi būti stiprus, būryje saugiau. Ar nori apginti Thunder Bluff garbę įkurdamas gildiją?",
        "zephras:89c7d6d8041f8b63e7ac": "Kaip įkurti gildiją?",
        "zephras:8efc9a1f6147d5cddd98": "Noriu sukurti gildijos herbą."
