    "trTR": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Atalarımız bize bireyin güçlü olması gerektiğini, ama kalabalıkta güven bulunduğunu öğretir. Bir lonca kurarak Thunder Bluff’un onurunu savunmak ister misin?",
        "zephras:89c7d6d8041f8b63e7ac": "Nasıl lonca kurabilirim?",
        "zephras:8efc9a1f6147d5cddd98": "Bir lonca arması oluşturmak istiyorum."
      },
      "name": "Krumn",
