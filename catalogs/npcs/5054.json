    },
    "daDK": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Vores forfædre lærer os, at den enkelte må være stærk, men at der er sikkerhed i antal. Vil du forsvare Thunder Bluffs ære ved at oprette en guild?",
        "zephras:89c7d6d8041f8b63e7ac": "Hvordan opretter jeg et gilde?",
        "zephras:8efc9a1f6147d5cddd98": "Jeg vil gerne oprette et laugsvåben."
      },
      "name": "Krumn",
      "translationMetadata": {
        "fields": {
