  "locales": {
    "csCZ": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Naši předkové nás učí, že jednotlivec musí být silný, ale v počtu je bezpečí. Chceš bránit čest Thunder Bluffu založením cechu?",
        "zephras:89c7d6d8041f8b63e7ac": "Jak založím gildu?",
        "zephras:8efc9a1f6147d5cddd98": "Chci vytvořit cechovní znak."
      },
      "name": "Krumn",
      "translationMetadata": {
        "fields": {
          "dialogue.db63b0e5626084da1bfb": {
