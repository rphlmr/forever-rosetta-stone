    "svSE": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Våra förfäder lär oss att individen måste vara stark, men att tryggheten finns i antalet. Vill du försvara Thunder Bluffs ära genom att bilda ett gille?",
        "zephras:89c7d6d8041f8b63e7ac": "Hur bildar jag ett gille?",
        "zephras:8efc9a1f6147d5cddd98": "Jag vill skapa ett gillesvapen."
      },
      "name": "Krumn",
