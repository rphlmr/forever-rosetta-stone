    "plPL": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Nasi przodkowie uczą nas, że jednostka musi być silna, lecz w liczbie tkwi bezpieczeństwo. Czy chcesz bronić honoru Thunder Bluff, zakładając gildię?",
        "zephras:89c7d6d8041f8b63e7ac": "Jak założyć gildię?",
        "zephras:8efc9a1f6147d5cddd98": "Chcę stworzyć herb gildii."
