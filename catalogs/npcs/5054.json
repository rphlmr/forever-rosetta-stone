    "ruRU": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Предки учили нас, что один в поле не воин – каким бы сильным он ни был. Хочешь ли ты прославить Громовой Утес, создав гильдию?",
        "zephras:89c7d6d8041f8b63e7ac": "Как мне создать гильдию?",
        "zephras:8efc9a1f6147d5cddd98": "Я хочу нарисовать герб гильдии."
      },
      "name": "Крумн",
      "subName": "Регистратор гильдий",
      "translationMetadata": {
        "fields": {
          "dialogue.db63b0e5626084da1bfb": {
