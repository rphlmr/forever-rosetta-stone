    "deDE": {
      "dialogue": {
        "db63b0e5626084da1bfb": "Unsere Vorfahren lehren uns, dass der Einzelne stark sein muss, wir aber nur mit Vielen Sicherheit finden. Wollt Ihr die Ehre von Thunder Bluff verteidigen, indem Ihr eine Gilde gründet?",
        "zephras:89c7d6d8041f8b63e7ac": "Wie gründe ich eine Gilde?",
        "zephras:8efc9a1f6147d5cddd98": "Ich möchte ein Gildewappen herstellen."
      },
      "name": "Krumn",
      "subName": "Gildenmeister",
