    "hrHR": {
      "dialogue": {
        "03a8f7603625bd06e084": "Želim pogledati vašu robu.",
        "2401c274cd561330b0cd": "Podučite me.",
        "c0a8627abd43076fe411": "Kad mi je prvi put ponuđena titula magistrata Southshorea, bio sam oduševljen što sam tako rano u karijeri dobio takvu dužnost.$B$BAli sad kad sam ovdje, pitam se ne bi li mi bilo bolje da premještam papire u Stormwindu."
      },
      "name": "Magistrat Henry Maleb",
