  "locales": {
    "csCZ": {
      "dialogue": {
        "03a8f7603625bd06e084": "Chci si prohlédnout vaše zboží.",
        "2401c274cd561330b0cd": "Vycvičte mě.",
        "c0a8627abd43076fe411": "Když mi poprvé nabídli titul magistráta Jižního pobřeží, nadšeně jsem přijal, že jsem takové pověření získal tak brzy ve své kariéře.$B$BTeď, když jsem tady, si ale říkám, jestli by mi nebylo lépe při přebírání papírů ve Stormwindu."
      },
      "name": "Rychtář Henry Maleb",
      "translationMetadata": {
        "fields": {
          "dialogue.03a8f7603625bd06e084": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.2401c274cd561330b0cd": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.c0a8627abd43076fe411": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "03a8f7603625bd06e084": "Jeg vil gerne se dine varer.",
        "2401c274cd561330b0cd": "Træn mig.",
        "c0a8627abd43076fe411": "Da jeg først blev tilbudt titlen som Southshores magistrat, var jeg lykkelig over at få en sådan post så tidligt i min karriere.$B$BMen nu hvor jeg er her, spekulerer jeg på, om jeg havde haft det bedre med at flytte papirer i Stormwind."
      },
      "name": "Magistrat Henry Maleb",
      "translationMetadata": {
        "fields": {
          "dialogue.03a8f7603625bd06e084": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.2401c274cd561330b0cd": {
