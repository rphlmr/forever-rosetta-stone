    "enUS": {
      "dialogue": {
        "03a8f7603625bd06e084": "I want to browse your goods.",
        "2401c274cd561330b0cd": "Train me.",
        "c0a8627abd43076fe411": "When I was first offered the title of Southshore Magistrate I was elated to have earned such a commission so early in my career.$B$BBut now that I'm here, I wonder if I'd have been better off shuffling papers in Stormwind."
      },
      "name": "Magistrate Henry Maleb",
      "translationMetadata": {
