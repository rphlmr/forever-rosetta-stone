    "hrHR": {
      "dialogue": {
        "036aa5fa5006daf02f75": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "642633b95c42eeab06d5": "Ako želiš, uz obuku mogu izbrisati znanje o tvojim talentima iz tvojeg uma. Upozoravam te da je postupak svakim ponavljanjem teži, a time i skuplji.",
        "b022c5e1ea65df3037d0": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Usluga koju nudim svakim je ponavljanjem sve teža. Zato je svaka preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "e0ad82aeae671b8c87e2": "Nauči me putovima duhova.",
        "ec12b6a751169a5328a5": "Neka duhovi budu s tobom."
      },
      "name": "Tigor Skychaser",
