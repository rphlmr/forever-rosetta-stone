    "esMX": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Entréname.",
        "d3ed651877d1f1dcb9f4": "Espero que estés bien, dadas las circunstancias.$B$BSiéntate un rato y escucha mi historia. Es una tragedia, claro, ¡pero espero que termine en venganza!",
        "d7107ca22e434fddfe97": "Quiero ver tus mercancías."
