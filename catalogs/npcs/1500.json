    },
    "deDE": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Bildet mich aus.",
        "d3ed651877d1f1dcb9f4": "Ich hoffe, Ihr seid den Umständen entsprechend wohlauf.\r\n\r\nNehmt doch hier Platz und lauscht meiner Geschichte. Natürlich ist es eine Tragödie, aber hoffentlich eine, die am Ende gerächt wird!",
        "d7107ca22e434fddfe97": "Ich möchte Eure Waren ansehen."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
        "fields": {
          "dialogue.5c28ef588bee1a3ae301": {
            "origin": "ai",
