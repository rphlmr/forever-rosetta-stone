    "svSE": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Träna mig.",
        "d3ed651877d1f1dcb9f4": "Jag hoppas att du mår bra, allt som hänt till trots.$B$BSitt ner en stund och hör min berättelse. Det är förstås en tragedi, men jag hoppas att den slutar med hämnd!",
        "d7107ca22e434fddfe97": "Jag vill se dina varor."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
