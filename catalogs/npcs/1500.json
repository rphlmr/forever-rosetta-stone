  "locales": {
    "csCZ": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Vycvičte mě.",
        "d3ed651877d1f1dcb9f4": "Doufám, že se máš za daných okolností dobře.$B$BNa chvíli si sedni a vyslechni můj příběh. Je to samozřejmě tragédie, ale doufám, že skončí pomstou!",
        "d7107ca22e434fddfe97": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
        "fields": {
          "dialogue.5c28ef588bee1a3ae301": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
