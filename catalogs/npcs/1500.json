    "ptBR": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Treine-me.",
        "d3ed651877d1f1dcb9f4": "Espero que esteja bem, considerando tudo o que aconteceu.$B$BSente-se um pouco e ouça minha história. É uma tragédia, claro, mas espero que termine em vingança!",
        "d7107ca22e434fddfe97": "Quero ver suas mercadorias."
      },
      "name": "Eurico Palhares",
