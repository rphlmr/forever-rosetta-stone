    "frFR": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Entraînez-moi.",
        "d3ed651877d1f1dcb9f4": "J'espère que vous allez bien, tout compte fait.\n\nAsseyez-vous un moment et écoutez mon histoire.  C'est une tragédie, bien sûr, mais j'espère qu'elle se terminera par une vengeance !",
        "d7107ca22e434fddfe97": "Je voudrais regarder vos articles."
      },
      "name": "Coleman Farthing",
