    "trTR": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Beni eğit.",
        "d3ed651877d1f1dcb9f4": "Her şeye rağmen iyi olduğunu umarım.$B$BBiraz otur ve hikâyemi dinle. Elbette bir trajedi ama umarım intikamla son bulur!",
        "d7107ca22e434fddfe97": "Mallarına bakmak istiyorum."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
