    "enUS": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Train me.",
        "d3ed651877d1f1dcb9f4": "I hope you're well, all things considered.$B$BSit for a spell, and hear my tale.  It's a tragedy, of course, but one I hope will end in revenge!",
        "d7107ca22e434fddfe97": "I want to browse your goods."
      },
      "name": "Coleman Farthing",
