    },
    "daDK": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Træn mig.",
        "d3ed651877d1f1dcb9f4": "Jeg håber, du har det godt efter omstændighederne.$B$BSæt dig lidt, og hør min historie. Det er naturligvis en tragedie, men jeg håber, den ender med hævn!",
        "d7107ca22e434fddfe97": "Jeg vil gerne se dine varer."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
        "fields": {
          "dialogue.5c28ef588bee1a3ae301": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
