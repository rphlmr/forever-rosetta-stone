    "ltLT": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Išmokyk mane.",
        "d3ed651877d1f1dcb9f4": "Tikiuosi, kad tau sekasi gerai, atsižvelgiant į visas aplinkybes.$B$BPrisėsk valandėlei ir išklausyk mano istoriją. Žinoma, tai tragedija, bet tikiuosi, kad ji baigsis kerštu!",
        "d7107ca22e434fddfe97": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
