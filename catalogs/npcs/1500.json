    },
    "plPL": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Wyszkol mnie.",
        "d3ed651877d1f1dcb9f4": "Mam nadzieję, że trzymasz się dobrze, zważywszy na okoliczności.$B$BUsiądź na chwilę i wysłuchaj mojej opowieści. To oczywiście tragedia, ale mam nadzieję, że zakończy się zemstą!",
        "d7107ca22e434fddfe97": "Chcę przejrzeć twoje towary."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
