    "hrHR": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Podučite me.",
        "d3ed651877d1f1dcb9f4": "Nadam se da si dobro, s obzirom na sve.$B$BSjedni nakratko i poslušaj moju priču. Tragedija je, naravno, ali nadam se da će završiti osvetom!",
        "d7107ca22e434fddfe97": "Želim pogledati vašu robu."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
