    "itIT": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Addestrami.",
        "d3ed651877d1f1dcb9f4": "Spero che tu stia bene, tutto sommato.\n\nSiediti un momento e ascolta la mia storia. È una tragedia, naturalmente, ma spero che si concluda con una vendetta!",
        "d7107ca22e434fddfe97": "Vorrei vedere la tua merce."
      },
      "name": "Coleman Farthing",
      "translationMetadata": {
