    "esES": {
      "dialogue": {
        "5c28ef588bee1a3ae301": "Entréname.",
        "d3ed651877d1f1dcb9f4": "Espero que estés bien. Siéntate un momento y escucha mi historia.  Es una tragedia, por supuesto, ¡pero espero que termine en venganza!",
        "d7107ca22e434fddfe97": "Quiero ver tus mercancías."
      },
