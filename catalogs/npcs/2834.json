    "frFR": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "34d67bae26cfc2604cd7": "Je peux vous apprendre à pêcher.",
        "444f90eef14438f00339": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "8bf60ef05d6307cf2b3e": "Entraînez-moi."
      },
      "name": "Myizz Luckycatch",
      "subName": "Excellent pêcheur",
