    "daDK": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre.",
        "34d67bae26cfc2604cd7": "Jeg kan lære dig at fiske.",
        "444f90eef14438f00339": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den vil helt sikkert hjælpe dig med at blive bedre.",
        "8bf60ef05d6307cf2b3e": "Træn mig."
      },
      "name": "Myizz Luckycatch",
      "translationMetadata": {
