    "enUS": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "34d67bae26cfc2604cd7": "I can teach you fishing skills.",
        "444f90eef14438f00339": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "8bf60ef05d6307cf2b3e": "Train me."
      },
      "name": "Myizz Luckycatch",
      "subName": "Superior Fisherman",
