    "ltLT": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Jei nori toliau tobulėti, turi surasti Nat Pagle Dustwallow pelkėje.",
        "34d67bae26cfc2604cd7": "Galiu išmokyti tave žvejoti.",
