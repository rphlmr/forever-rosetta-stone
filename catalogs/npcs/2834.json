    "trTR": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Daha da ustalaşmak için Dustwallow Marsh'ta Nat Pagle'ı bulmalısın.",
        "34d67bae26cfc2604cd7": "Sana balık tutmayı öğretebilirim.",
        "444f90eef14438f00339": "Beceri düzeyin benimkini aşıyor, ama Booty Bay'deki İhtiyar Heming'in \"Levrek ve Sen\" kitabının kopyalarına sahip olduğunu duydum. Bu, becerini geliştirmene kesinlikle yardım eder.",
        "8bf60ef05d6307cf2b3e": "Beni eğit."
      },
      "name": "Myizz Luckycatch",
