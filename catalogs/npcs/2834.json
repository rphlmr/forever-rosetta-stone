    "hrHR": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako želiš postati bolji.",
        "34d67bae26cfc2604cd7": "Mogu te podučiti ribolovu.",
        "444f90eef14438f00339": "Tvoja vještina nadmašuje moju, ali čuo sam da starac Heming u Booty Bayu ima primjerke knjige \"Grgeč i ti\". Sigurno će ti pomoći da se usavršiš.",
        "8bf60ef05d6307cf2b3e": "Podučite me."
      },
      "name": "Myizz Luckycatch",
