    "itIT": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "34d67bae26cfc2604cd7": "Posso insegnarti l'arte della pesca.",
        "444f90eef14438f00339": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità.",
        "8bf60ef05d6307cf2b3e": "Addestrami."
      },
      "name": "Myizz Luckycatch",
