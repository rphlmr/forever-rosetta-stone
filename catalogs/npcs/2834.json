    "esES": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "34d67bae26cfc2604cd7": "Puedo enseñarte a pescar.",
        "444f90eef14438f00339": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "8bf60ef05d6307cf2b3e": "Entréname."
      },
      "name": "Myizz Buenapieza",
      "subName": "Pescador superior",
