    "svSE": {
      "dialogue": {
        "33a0e49e928bd83a8ef9": "Du måste hitta Nat Pagle i Dustwallow Marsh om du vill bli bättre.",
        "34d67bae26cfc2604cd7": "Jag kan lära dig att fiska.",
        "444f90eef14438f00339": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av \"Abborren och du\". Den hjälper dig säkert att bli bättre.",
        "8bf60ef05d6307cf2b3e": "Träna mig."
      },
      "name": "Myizz Luckycatch",
