    "ltLT": {
      "dialogue": {
        "52e6bebebe785db8a733": "Pamokyk mane.",
        "9e9b6113e96cc8e7b4da": "Tau neblogai sekasi, bet leisk parodyti kelias gudrybes, kurios gali praversti. ",
        "c16c5c61bdd3e8bd1892": "Ar atrodau taip, lyg turėčiau laiko plepėti?",
        "e435d45224371a621886": "Jis tikrai daug geresnis kalvis už mane. Nors jei kam nors pasakysi, kad taip sakiau, viską neigsiu. Turėtum pasikalbėti su Therum Deepforge. Jei kas nors gali tave dar ko nors išmokyti, tai jis."
      },
      "name": "Dane Lindgren",
      "subName": "Patyręs kalvis",
      "translationMetadata": {
        "fields": {
          "dialogue.52e6bebebe785db8a733": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
