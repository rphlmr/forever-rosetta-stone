    "hrHR": {
      "dialogue": {
        "52e6bebebe785db8a733": "Podučite me.",
        "9e9b6113e96cc8e7b4da": "Nisi loš, ali dopusti da ti pokažem nekoliko trikova koji bi ti mogli koristiti.",
        "c16c5c61bdd3e8bd1892": "Izgledam li kao da imam vremena za čavrljanje?",
        "e435d45224371a621886": "Daleko je bolji kovač od mene, to je sigurno. No poreći ću ako ikome kažeš da sam to rekao. Trebaš razgovarati s Therumom Deepforgeom. Ako te itko može još nečemu naučiti, to je on."
      },
      "name": "Dane Lindgren",
      "translationMetadata": {
