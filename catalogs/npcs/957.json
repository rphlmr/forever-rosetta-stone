    "enUS": {
      "dialogue": {
        "52e6bebebe785db8a733": "Train me.",
        "9e9b6113e96cc8e7b4da": "You're not bad, but let me show you a few tricks you might find handy. ",
        "c16c5c61bdd3e8bd1892": "Do I look like I have the time to spend jawin?",
        "e435d45224371a621886": "A far better blacksmith than I am, that's for sure. Though I'll deny it if you tell anyone I said that. You should go speak with Therum Deepforge. If anyone can teach you more, it's him."
      },
      "name": "Dane Lindgren",
      "subName": "Journeyman Blacksmith",
      "translationMetadata": {
