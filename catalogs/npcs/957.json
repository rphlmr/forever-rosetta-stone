    "daDK": {
      "dialogue": {
        "52e6bebebe785db8a733": "Træn mig.",
        "9e9b6113e96cc8e7b4da": "Du er ikke dårlig, men lad mig vise dig et par tricks, du måske får brug for.",
        "c16c5c61bdd3e8bd1892": "Ser jeg ud, som om jeg har tid til at sludre?",
        "e435d45224371a621886": "Han er en langt bedre smed end jeg, det er sikkert. Men jeg nægter, hvis du siger til nogen, at jeg har sagt det. Tal med Therum Deepforge. Hvis nogen kan lære dig mere, er det ham."
      },
      "name": "Dane Lindgren",
      "translationMetadata": {
        "fields": {
          "dialogue.52e6bebebe785db8a733": {
