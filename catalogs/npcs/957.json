  "locales": {
    "csCZ": {
      "dialogue": {
        "52e6bebebe785db8a733": "Vycvičte mě.",
        "9e9b6113e96cc8e7b4da": "Nejsi špatný, ale ukážu ti pár triků, které by se ti mohly hodit.",
        "c16c5c61bdd3e8bd1892": "Vypadám snad, že mám čas na tlachání?",
        "e435d45224371a621886": "Je určitě mnohem lepší kovář než já. Ale pokud někomu řekneš, že jsem to řekl, zapřu to. Promluv si s Therumem Deepforgem. Jestli tě někdo může naučit víc, je to on."
      },
      "name": "Dane Lindgren",
      "translationMetadata": {
        "fields": {
          "dialogue.52e6bebebe785db8a733": {
