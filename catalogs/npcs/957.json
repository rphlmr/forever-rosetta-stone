    "esES": {
      "dialogue": {
        "52e6bebebe785db8a733": "Entréname.",
        "9e9b6113e96cc8e7b4da": "No está mal, pero déjame enseñarte algunos trucos que encontrarás útiles.",
        "c16c5c61bdd3e8bd1892": "¿Te parece que me sobra el tiempo para darle a la sinhueso?",
        "e435d45224371a621886": "Un herrero mucho mejor que yo, eso está claro. Pero lo negaré si lo vas diciendo por ahí. Deberías hablar con Therum Forjahonda. Si hay alguien que pueda seguir instruyéndote, ese es él."
      },
      "name": "Dane Lindgren",
      "subName": "Oficial herrero",
