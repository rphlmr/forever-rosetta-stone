    "hrHR": {
      "dialogue": {
        "991d74785e25153c1720": "Strogim prekvalificiranjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Usluga koju nudim svaki put postaje sve teža. Zato je svaka sljedeća prekvalifikacija skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "bba3019297bcbf6806ce": "Neka duhovi budu s tobom.",
        "c2355706cd4ba49c07fc": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "ca06ca43849d8e719e1a": "Nauči me putovima duhova."
      },
      "name": "Narm Skychaser",
