  "locales": {
    "csCZ": {
      "dialogue": {
        "991d74785e25153c1720": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým dalším provedením obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "bba3019297bcbf6806ce": "Duchové ať jsou s tebou.",
        "c2355706cd4ba49c07fc": "Duchové tě ke mně přivedli. Jak ti mohu posloužit?",
        "ca06ca43849d8e719e1a": "Nauč mě cestám duchů."
      },
      "name": "Narm Skychaser",
      "translationMetadata": {
        "fields": {
          "dialogue.991d74785e25153c1720": {
