    "ltLT": {
      "dialogue": {
        "991d74785e25153c1720": "Griežtai permokydamas turėjau padėti daugeliui mokinių atsisakyti visko, ką jie anksčiau buvo išmokę, kad galėčiau juos mokyti iš naujo.  Kaskart šią paslaugą suteikti darosi vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "bba3019297bcbf6806ce": "Tegul dvasios būna su tavimi.",
        "c2355706cd4ba49c07fc": "Dvasios atvedė tave pas mane. Kuo galiu padėti?",
        "ca06ca43849d8e719e1a": "Išmokyk mane dvasių kelio."
      },
      "name": "Narm Skychaser",
      "subName": "Šamanų mokytojas",
