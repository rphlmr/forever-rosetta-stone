    "enUS": {
      "dialogue": {
        "991d74785e25153c1720": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "bba3019297bcbf6806ce": "May the spirits be with you.",
        "c2355706cd4ba49c07fc": "The spirits have guided you to me. How may I be of service?",
        "ca06ca43849d8e719e1a": "Teach me the ways of the spirits."
      },
      "name": "Narm Skychaser",
      "subName": "Shaman Trainer",
      "translationMetadata": {
        "fields": {
