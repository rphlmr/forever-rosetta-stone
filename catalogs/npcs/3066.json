    "plPL": {
      "dialogue": {
        "991d74785e25153c1720": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mógł uczyć ich od nowa. Usługa ta staje się coraz trudniejsza za każdym razem, gdy ją wykonuję. Dlatego każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym oduczył cię poznanych talentów?",
        "bba3019297bcbf6806ce": "Niech duchy będą z tobą.",
        "c2355706cd4ba49c07fc": "Duchy przywiodły cię do mnie. Jak mogę służyć?",
        "ca06ca43849d8e719e1a": "Naucz mnie ścieżek duchów."
      },
      "name": "Narm Skychaser",
      "translationMetadata": {
