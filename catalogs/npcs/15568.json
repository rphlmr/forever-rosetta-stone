    "trTR": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Şimdi yeni yılın başladığı ve ayın parlakça ışıldadığı zaman.$B$BBizim zamanımız... kadimlerin uyandığı zaman.",
        "7819d6c769fce85a146d": "Bilge Moonstrike’ı Western Plaguelands’teki Scholomance’ta bulabilirsin.",
        "8f22e54eba3966565084": "Bilge Meadowrun’u en son Western Plaguelands’teki Weeping Cave’de gördüm.",
        "986e59f665c308533980": "Bilge Darkcore’u Undercity’de bulabilirsin.",
        "b24386d8c9a84411b399": "Bilge Snowcrown’u Eastern Plaguelands’teki Light’s Hope Chapel’da bulabilirsin.",
        "eaf9414ec95121ab5c07": "Bilge Obsidian, Silverpine Ormanı’ndaki Sepulcher yakınlarında dolaşıyor."
      },
      "name": "Ulu Graveborn",
