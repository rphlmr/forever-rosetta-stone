  "locales": {
    "csCZ": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... čas, kdy se probouzejí prastaří.",
        "7819d6c769fce85a146d": "Staršího Moonstrika najdeš ve Scholomance v Western Plaguelands.",
        "8f22e54eba3966565084": "Staršího Meadowruna jsem naposledy viděl u Plačící jeskyně v Western Plaguelands.",
        "986e59f665c308533980": "Staršího Darkcorea najdeš v Undercity.",
        "b24386d8c9a84411b399": "Staršího Snowcrowna najdeš v kapli Light’s Hope v Eastern Plaguelands.",
        "eaf9414ec95121ab5c07": "Starší Obsidian se potuluje poblíž Sepulcheru v Silverpine Forest."
      },
      "name": "Starší Graveborn",
      "translationMetadata": {
