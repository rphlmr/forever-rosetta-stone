    "ltLT": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Dabar metas, kai metai dar nauji, o mėnulis ryškiai šviečia.$B$BTai mūsų metas... kai senovės dvasios pabunda.",
        "7819d6c769fce85a146d": "Senolį Moonstrike rasi Scholomance, Western Plaguelands krašte.",
        "8f22e54eba3966565084": "Paskutinį kartą senolį Meadowrun mačiau prie Weeping Cave, Western Plaguelands krašte.",
        "986e59f665c308533980": "Senolį Darkcore rasi Undercity mieste.",
        "b24386d8c9a84411b399": "Senolį Snowcrown rasi Light's Hope Chapel, Eastern Plaguelands krašte.",
        "eaf9414ec95121ab5c07": "Senolis Obsidian klaidžioja netoli Sepulcher, Silverpine Forest miške."
      },
      "name": "Senolis Graveborn",
