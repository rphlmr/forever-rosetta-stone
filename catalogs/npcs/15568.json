    "plPL": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Nastał czas, gdy rok jest nowy, a księżyc jasno świeci.$B$BTo nasz czas... gdy budzą się pradawni.",
        "7819d6c769fce85a146d": "Starszego Moonstrike’a znajdziesz w Scholomance na Zachodnich Ziemiach Plagi.",
        "8f22e54eba3966565084": "Ostatnio widziałem starszego Meadowruna przy Weeping Cave na Zachodnich Ziemiach Plagi.",
        "986e59f665c308533980": "Starszego Darkcore’a znajdziesz w Undercity.",
        "b24386d8c9a84411b399": "Starszego Snowcrowna znajdziesz w kaplicy Light’s Hope na Wschodnich Ziemiach Plagi.",
        "eaf9414ec95121ab5c07": "Starszy Obsidian wędruje w pobliżu Sepulcher w lesie Silverpine."
      },
      "name": "Starszy Graveborn",
