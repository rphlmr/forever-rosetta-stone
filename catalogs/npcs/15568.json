    "hrHR": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude.",
        "7819d6c769fce85a146d": "Starješinu Moonstrikea možeš pronaći u Scholomanceu u Western Plaguelandsu.",
        "8f22e54eba3966565084": "Starješinu Meadowruna posljednji sam put vidio kod Weeping Cave u Western Plaguelandsu.",
        "986e59f665c308533980": "Starješinu Darkcorea možeš pronaći u Undercityju.",
        "b24386d8c9a84411b399": "Starješinu Snowcrowna možeš pronaći u kapeli Light’s Hope u Eastern Plaguelandsu.",
        "eaf9414ec95121ab5c07": "Starješina Obsidian luta blizu Sepulchera u šumi Silverpine."
      },
      "name": "Starješina Graveborn",
