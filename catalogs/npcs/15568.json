    "enUS": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "7819d6c769fce85a146d": "Elder Moonstrike can be found in the Scholomance in the Western Plaguelands.",
        "8f22e54eba3966565084": "I last saw Elder Meadowrun at the Weeping Cave in the Western Plaguelands.",
        "986e59f665c308533980": "Elder Darkcore can be found in the Undercity.",
        "b24386d8c9a84411b399": "Elder Snowcrown can be found in Light's Hope Chapel in the Eastern Plaguelands.",
        "eaf9414ec95121ab5c07": "Elder Obsidian wanders near the Sepulcher in Silverpine Forest."
      },
      "name": "Elder Graveborn",
