    "daDK": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "7819d6c769fce85a146d": "Ældste Moonstrike findes i Scholomance i Western Plaguelands.",
        "8f22e54eba3966565084": "Jeg så sidst ældste Meadowrun ved Weeping Cave i Western Plaguelands.",
        "986e59f665c308533980": "Ældste Darkcore findes i Undercity.",
        "b24386d8c9a84411b399": "Ældste Snowcrown findes i Light’s Hope Chapel i Eastern Plaguelands.",
        "eaf9414ec95121ab5c07": "Ældste Obsidian vandrer nær Sepulcher i Silverpine Forest."
      },
      "name": "Ældste Graveborn",
