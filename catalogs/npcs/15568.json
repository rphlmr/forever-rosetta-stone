    "svSE": {
      "dialogue": {
        "12513d5b8d97df6bb72b": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "7819d6c769fce85a146d": "Äldste Moonstrike finns i Scholomance i Western Plaguelands.",
        "8f22e54eba3966565084": "Jag såg senast äldste Meadowrun vid Weeping Cave i Western Plaguelands.",
        "986e59f665c308533980": "Äldste Darkcore finns i Undercity.",
        "b24386d8c9a84411b399": "Äldste Snowcrown finns i Light’s Hope Chapel i Eastern Plaguelands.",
        "eaf9414ec95121ab5c07": "Äldste Obsidian vandrar nära Sepulcher i Silverpine Forest."
      },
      "name": "Äldste Graveborn",
