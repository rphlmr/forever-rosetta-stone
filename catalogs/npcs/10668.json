    "svSE": {
      "dialogue": {
        "8b3dc768dc8605d0fa34": "Kroppen tillhör en kvinnlig orchkrigare.$B$BDet är tydligt att hon dog i strid, troligen mot områdets quilboarer.",
        "f7e9f4aaafb9f2696def": "Du vänder på kroppen och ser märken efter klingor och besvärjelser på den döda orchen. Hennes rustning är nästan förstörd och håret klibbar mot ansiktet.$B$BUtifrån Mankriks beskrivning råder inget tvivel om att detta var hans hustru.$B$BNyheten kommer att göra honom upprörd, men du är säker på att han bör få veta sanningen.",
        "zephras:32d94721b2b33039e734": "Jag undersöker kroppen närmare."
      },
      "name": "Misshandlat lik",
      "translationMetadata": {
        "fields": {
          "dialogue.8b3dc768dc8605d0fa34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f7e9f4aaafb9f2696def": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.zephras:32d94721b2b33039e734": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
