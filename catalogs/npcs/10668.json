            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "8b3dc768dc8605d0fa34": "Це тіло орчині-воїтельки.$B$BОчевидно, вона загинула в бою, ймовірно, проти місцевих голкошерстів.",
        "f7e9f4aaafb9f2696def": "Ти перевертаєш тіло й бачиш на загиблій орчині сліди клинків і заклять. Її обладунок майже знищений, волосся злиплося на обличчі.$B$BЗважаючи на опис Манкріка, ти не сумніваєшся, що це була його дружина.$B$BНовина засмутить його, але ти певен, що він має знати правду.",
        "zephras:32d94721b2b33039e734": "Я оглядаю тіло уважніше."
      },
      "name": "побитий труп",
      "translationMetadata": {
        "fields": {
          "dialogue.8b3dc768dc8605d0fa34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
