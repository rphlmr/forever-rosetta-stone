            "sourceLocale": "enUS"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "8b3dc768dc8605d0fa34": "Ceset bir dişi ork savaşçıya ait.$B$BSavaşta, muhtemelen bölgedeki kıl sırtlılara karşı öldüğü açık.",
        "f7e9f4aaafb9f2696def": "Cesedi çevirince ölü orkun üzerinde kılıç ve büyü izleri görüyorsun. Zırhı neredeyse tamamen parçalanmış, saçları yüzüne yapışmış.$B$BMankrik'in tarifine bakılırsa bunun karısı olduğundan şüphen yok.$B$BHaber onu üzecek, ama gerçeği bilmesi gerektiğinden eminsin.",
        "zephras:32d94721b2b33039e734": "Cesedi daha yakından inceliyorum."
      },
      "name": "Dövülmüş Ceset",
      "translationMetadata": {
        "fields": {
          "dialogue.8b3dc768dc8605d0fa34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f7e9f4aaafb9f2696def": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.zephras:32d94721b2b33039e734": {
