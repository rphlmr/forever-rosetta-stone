            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "8b3dc768dc8605d0fa34": "Der Leichnam ist der einer Orckriegerin.\n\nEs ist klar, dass sie im Kampf starb, wahrscheinlich gegen die Stacheleber in dieser Gegend.",
        "f7e9f4aaafb9f2696def": "Ihr dreht den Leichnam um und seht Spuren von Klingen und Zaubern an der verstorbenen Orc-Frau - ihre Rüstung ist fast zerstört, das Haar klebt an ihrem Gesicht.\n\nNach Mankriks Beschreibung habt Ihr keinen Zweifel, dass dies seine Frau ist.\n\nDie Wahrheit wird schmerzlich für ihn sein, aber Ihr seid sicher, dass er sie erfahren sollte.",
        "zephras:32d94721b2b33039e734": "Ich untersuche den Leichnam weiter."
      },
      "name": "Geschlagener Kadaver",
      "translationMetadata": {
        "fields": {
          "dialogue.8b3dc768dc8605d0fa34": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
