  "locales": {
    "csCZ": {
      "dialogue": {
        "8b3dc768dc8605d0fa34": "Tělo patří orčí bojovnici.$B$BJe zřejmé, že padla v boji, nejspíš proti místním quilboarům.",
        "f7e9f4aaafb9f2696def": "Otočíš tělo a na mrtvé orce spatříš stopy čepelí a kouzel. Její zbroj je téměř zničená a vlasy přilepené k obličeji.$B$BPodle Mankrikova popisu nepochybuješ, že jde o jeho ženu.$B$BZpráva ho zarmoutí, ale určitě by měl znát pravdu.",
        "zephras:32d94721b2b33039e734": "Prohlédnu si tělo důkladněji."
      },
      "name": "Zbitá mrtvola",
      "translationMetadata": {
        "fields": {
          "dialogue.8b3dc768dc8605d0fa34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
