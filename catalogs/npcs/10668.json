            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "8b3dc768dc8605d0fa34": "Liget tilhører en kvindelig orkkriger.$B$BDet er tydeligt, at hun døde i kamp, sandsynligvis mod områdets quilboarer.",
        "f7e9f4aaafb9f2696def": "Du vender liget og ser mærker efter klinger og besværgelser på den døde ork. Hendes rustning er næsten ødelagt, og håret er klistret til hendes ansigt.$B$BUd fra Mankriks beskrivelse er du ikke i tvivl om, at det var hans kone.$B$BNyheden vil gøre ham ked af det, men han bør kende sandheden.",
        "zephras:32d94721b2b33039e734": "Jeg undersøger liget nærmere."
      },
      "name": "Gennembanket lig",
      "translationMetadata": {
        "fields": {
          "dialogue.8b3dc768dc8605d0fa34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
