    "hrHR": {
      "dialogue": {
        "a3a39cacc0dc7eea6859": "Naša sloboda ne bi značila ništa da je C'Thun preživio. Ti si doista junak proročanstva.",
        "ef5c68db60012bac54cc": "Čak i da si nas nekako uspio osloboditi bez poraza C'Thuna, usmjerili bismo svu svoju moć da zvijer protjeramo natrag u pakao iz kojeg je došla, POD SVAKU CIJENU."
      },
      "name": "Caelestrasz",
      "translationMetadata": {
        "fields": {
