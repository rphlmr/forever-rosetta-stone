          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "a3a39cacc0dc7eea6859": "Our freedom would have meant nothing if C'Thun had survived. You are truly a champion of prophecy.",
        "ef5c68db60012bac54cc": "Even if you somehow managed to free us without defeating C'Thun, we would focus all of our powers to see the beast banished back to the hell from whence it came - AT ANY COST."
      },
      "name": "Caelestrasz",
      "translationMetadata": {
        "fields": {
          "dialogue.a3a39cacc0dc7eea6859": {
            "origin": "community",
            "source": "Spoken",
