          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "a3a39cacc0dc7eea6859": "Vores frihed ville intet have betydet, hvis C'Thun havde overlevet. Du er sandelig profetiens forkæmper.",
        "ef5c68db60012bac54cc": "Selv hvis det var lykkedes dig at befri os uden at besejre C'Thun, ville vi samle alle vores kræfter for at sende uhyret tilbage til det helvede, det kom fra, FOR ENHVER PRIS."
      },
      "name": "Caelestrasz",
      "translationMetadata": {
        "fields": {
          "dialogue.a3a39cacc0dc7eea6859": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
