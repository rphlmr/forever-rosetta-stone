            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "a3a39cacc0dc7eea6859": "Wenn C'Thun überlebt hätte, wäre unsere Freiheit bedeutungslos gewesen. Ihr seid wahrhaft der Held der Prophezeiung.",
        "ef5c68db60012bac54cc": "Selbst wenn Ihr es irgendwie schaffen solltet uns zu befreien ohne C'Thun zu besiegen, wir sollten all unsere Bemühungen darauf konzentrieren, diese Bestie zurück in die Hölle zu schicken, aus der sie gekommen ist - KOSTE ES, WAS ES WOLLE!"
      },
      "name": "Caelestrasz",
      "translationMetadata": {
        "fields": {
          "dialogue.a3a39cacc0dc7eea6859": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
