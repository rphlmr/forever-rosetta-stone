  "locales": {
    "csCZ": {
      "dialogue": {
        "a3a39cacc0dc7eea6859": "Naše svoboda by nic neznamenala, kdyby C'Thun přežil. Opravdu jsi šampionem z proroctví.",
        "ef5c68db60012bac54cc": "I kdyby se ti nás nějak podařilo osvobodit bez porážky C'Thuna, soustředili bychom veškerou svou moc na vyhnání té bestie zpět do pekla, odkud přišla, ZA KAŽDOU CENU."
      },
      "name": "Caelestrasz",
      "translationMetadata": {
        "fields": {
          "dialogue.a3a39cacc0dc7eea6859": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
