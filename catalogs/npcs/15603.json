    "trTR": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Elder Starweave'i Darkshore'daki kıyı köyü Auberdine'de bulabilirsin.",
        "51e8d7901f9a07058848": "Bu çağın yıldızları yeni yörüngelere yöneliyor, gelecek çağlar için umut ve güç ışıkları oluyor.",
        "53993d3d3e5af0811d0d": "Son bildiğim kadarıyla Elder Stonespire, Winterspring'deki Everlook'taydı.",
        "5541d20c14dc01eddf58": "Elder Riversong şu anda Ashenvale'deki Astranaar köyünde yaşıyor.",
        "9a494c46fd7c13e51a82": "Elder Brightspear'ı Winterspring'deki Kel'Theril harabelerinde dolaşırken bulabilirsin.",
        "fb36dc8d6d90d69822b1": "Elder Skygleam'i Azshara'daki Ravencrest Anıtı yakınlarında bulabilirsin."
      },
      "name": "Ulu Nightwind",
