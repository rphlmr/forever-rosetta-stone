    "daDK": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Ældste Starweave findes i kystlandsbyen Auberdine i Darkshore.",
        "51e8d7901f9a07058848": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "53993d3d3e5af0811d0d": "Sidst jeg hørte, var ældste Stonespire i Everlook i Winterspring.",
        "5541d20c14dc01eddf58": "Landsbyen Astranaar i Ashenvale er ældste Riversongs nuværende hjem.",
        "9a494c46fd7c13e51a82": "Ældste Brightspear vandrer omkring ruinerne af Kel'Theril i Winterspring.",
        "fb36dc8d6d90d69822b1": "Ældste Skygleam findes nær Ravencrest-monumentet i Azshara."
      },
      "name": "Ældste Nightwind",
      "translationMetadata": {
