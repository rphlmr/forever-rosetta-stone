    "esES": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Puedes encontrar al ancestro Tejestrellas en la villa costera de Auberdine en Costa Oscura.",
        "51e8d7901f9a07058848": "Las estrellas de nuestro tiempo están cambiando su trayectoria, faros de esperanza y fortaleza para los años venideros.",
        "53993d3d3e5af0811d0d": "Lo último que supe es que el ancestro Picopiedra estaba en Vista Eterna en Cuna del Invierno.",
        "5541d20c14dc01eddf58": "La aldea de Astranaar en Vallefresno es el actual hogar del ancestro Riosona.",
        "9a494c46fd7c13e51a82": "Puedes encontrar al ancestro Relulanza vagando entre las ruinas de Kel'Theril en Cuna del Invierno.",
        "fb36dc8d6d90d69822b1": "El ancestro Relucielo se encuentra cerca del Monumento Cresta Cuervo en Azshara."
      },
      "name": "Ancestro Nochebrisa",
