    "deDE": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Urahnin Moonstrike kann in der Küstenstadt Auberdine an der Dunkelküste angetroffen werden.",
        "51e8d7901f9a07058848": "Die Sterne bewegen sich nun auf neuen Bahnen fort. Fortan scheinen sie als Zeichen der Hoffnung und der Stärke für kommende Zeiten.",
        "53993d3d3e5af0811d0d": "Soweit ich weiß, hält sich Urahne Stonespire in Everlook in Winterspring auf.",
        "5541d20c14dc01eddf58": "Das Dorf Astranaar in Ashenvale ist Urahnin Riversongs momentanes Zuhause.",
        "9a494c46fd7c13e51a82": "Urahnin Brightspear wandert in den Ruinen von Kel'Theril in Winterspring umher.",
        "fb36dc8d6d90d69822b1": "Urahne Skygleam kann nahe des Ravencrest-Monuments in Azshara angetroffen werden."
      },
      "name": "Urahne Nightwind",
      "translationMetadata": {
