    "frFR": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "L'Ancienne Starweave se trouve dans le village côtier d'Auberdine, à Sombrivage.",
        "51e8d7901f9a07058848": "Les étoiles de ce temps suivent des chemins nouveaux, et leurs lueurs seront des foyers d’espoir et de force pour les âges qui s’annoncent.",
        "53993d3d3e5af0811d0d": "Aux dernières nouvelles, l'Ancien Stonespire se trouvait à Long-guet, au Berceau-de-l'Hiver.",
        "5541d20c14dc01eddf58": "L'Ancienne Riversong réside en ce moment au village d'Astraanar, en Ashenvale.",
        "9a494c46fd7c13e51a82": "L'Ancienne Brightspear erre généralement près des ruines de Kel'Theril, au Berceau-de-l'Hiver.",
        "fb36dc8d6d90d69822b1": "L'Ancien Skygleam se trouve près du monument de Ravencrest, en Azshara."
      },
      "name": "Ancien Nightwind",
      "translationMetadata": {
