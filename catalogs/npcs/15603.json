    "plPL": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Starszego Starweave'a znajdziesz w nadmorskiej wiosce Auberdine w Darkshore.",
        "51e8d7901f9a07058848": "Gwiazdy tej epoki podążają nowymi drogami, będąc latarniami nadziei i siły dla nadchodzących wieków.",
        "53993d3d3e5af0811d0d": "Ostatnio starszy Stonespire przebywał w Everlook w Winterspring.",
        "5541d20c14dc01eddf58": "Wioska Astranaar w Ashenvale jest obecnym domem starszego Riversonga.",
        "9a494c46fd7c13e51a82": "Starszego Brightspeara znajdziesz wśród ruin Kel'Theril w Winterspring.",
        "fb36dc8d6d90d69822b1": "Starszego Skygleama znajdziesz w pobliżu pomnika Ravencresta w Azsharze."
      },
      "name": "Starsza Nightwind",
