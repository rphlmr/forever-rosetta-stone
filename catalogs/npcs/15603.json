    "svSE": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Äldste Starweave finns i kustbyn Auberdine i Darkshore.",
        "51e8d7901f9a07058848": "Denna tids stjärnor följer nya banor, ledstjärnor av hopp och styrka för kommande tidsåldrar.",
        "53993d3d3e5af0811d0d": "Sist jag hörde var äldste Stonespire i Everlook i Winterspring.",
        "5541d20c14dc01eddf58": "Byn Astranaar i Ashenvale är äldste Riversongs nuvarande hem.",
        "9a494c46fd7c13e51a82": "Äldste Brightspear vandrar bland ruinerna av Kel'Theril i Winterspring.",
        "fb36dc8d6d90d69822b1": "Äldste Skygleam finns nära Ravencrest-monumentet i Azshara."
      },
      "name": "Äldste Nightwind",
