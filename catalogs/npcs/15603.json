  "locales": {
    "csCZ": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Starší Starweave je v pobřežní vesnici Auberdine v Darkshore.",
        "51e8d7901f9a07058848": "Hvězdy této doby se ubírají novými cestami, jsou majáky naděje a síly pro nadcházející věky.",
        "53993d3d3e5af0811d0d": "Naposledy byl starší Stonespire v Everlooku ve Winterspringu.",
        "5541d20c14dc01eddf58": "Starší Riversong nyní žije ve vesnici Astranaar v Ashenvale.",
        "9a494c46fd7c13e51a82": "Starší Brightspear se prochází mezi ruinami Kel'Therilu ve Winterspringu.",
        "fb36dc8d6d90d69822b1": "Starší Skygleam se nachází poblíž památníku Ravencrest v Azshaře."
      },
      "name": "Starší Nightwind",
      "translationMetadata": {
