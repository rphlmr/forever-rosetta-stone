    "hrHR": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Starješinu Starweavea možeš pronaći u obalnom selu Auberdine u Darkshoreu.",
        "51e8d7901f9a07058848": "Zvijezde ovog doba kreću novim putovima, svjetionici nade i snage za nadolazeća vremena.",
        "53993d3d3e5af0811d0d": "Koliko znam, starješina Stonespire posljednji je put bio u Everlooku u Winterspringu.",
        "5541d20c14dc01eddf58": "Selo Astranaar u Ashenvaleu sadašnji je dom starješine Riversonga.",
        "9a494c46fd7c13e51a82": "Starješina Brightspear luta među ruševinama Kel'Therila u Winterspringu.",
        "fb36dc8d6d90d69822b1": "Starješinu Skygleama možeš pronaći blizu spomenika Ravencrest u Azshari."
      },
      "name": "Starješina Nightwind",
