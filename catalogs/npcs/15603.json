    "enUS": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Elder Starweave can be found at the coastal village of Auberdine in Darkshore.",
        "51e8d7901f9a07058848": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "53993d3d3e5af0811d0d": "Last I knew, Elder Stonespire was at Everlook in Winterspring.",
        "5541d20c14dc01eddf58": "The village of Astranaar in Ashenvale is Elder Riversong's current home.",
        "9a494c46fd7c13e51a82": "Elder Brightspear can be found wandering amongst the ruins of Kel'Theril in Winterspring.",
        "fb36dc8d6d90d69822b1": "Elder Skygleam can be found near the Ravencrest Monument in Azshara."
      },
      "name": "Elder Nightwind",
      "translationMetadata": {
