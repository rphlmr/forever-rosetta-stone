    "ptBR": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "A Anciã Tecestrela se encontra cidade litorânea de Auberdine, na Costa Negra.",
        "51e8d7901f9a07058848": "As estrelas desta época iluminam outros caminhos – raios de força e esperança para as eras vindouras.",
        "53993d3d3e5af0811d0d": "Da última vez, o ancião Agulha de Pedra estava em Visteterna, que fica em Hibérnia.",
        "5541d20c14dc01eddf58": "A anciã Cantoflúvio mora, atualmente, em Astranaar, no Vale Gris.",
        "9a494c46fd7c13e51a82": "A anciã Setalume vaga pelas ruínas de Kel'Theril, em Hibérnia.",
        "fb36dc8d6d90d69822b1": "O ancião Brilhacéu se encontra perto do Monumento a Cristacorvo, em Azshara."
      },
      "name": "Ancião Noctéolas",
