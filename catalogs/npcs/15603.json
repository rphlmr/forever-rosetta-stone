    "itIT": {
      "dialogue": {
        "0d65263fedaabf6fc4ba": "Troverai l'Anziana Starweave nel villaggio costiero di Auberdine, a Darkshore.",
        "51e8d7901f9a07058848": "Le stelle di questo tempo sono risolute a seguire nuovi sentieri, fari di speranza e di forza per le ere a venire.",
        "53993d3d3e5af0811d0d": "Le ultime notizie che ho dicono che l'Anziano Stonespire era a Everlook, a Winterspring.",
        "5541d20c14dc01eddf58": "Il villaggio di Astranaar, ad Ashenvale, è l'attuale dimora dell'Anziana Riversong.",
        "9a494c46fd7c13e51a82": "L'Anziana Brightspear vaga fra le rovine di Kel'Theril, a Winterspring.",
        "fb36dc8d6d90d69822b1": "L'Anziano Skygleam si trova vicino al Monumento di Ravencrest, ad Azshara."
      },
      "name": "Anziano Nightwind",
      "translationMetadata": {
        "fields": {
          "dialogue.0d65263fedaabf6fc4ba": {
