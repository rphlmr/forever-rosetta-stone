    "deDE": {
      "dialogue": {
        "0355c2289701c4dd2433": "Danke, werter Herr, dass Ihr meine Halskette gefunden habt! Ihr seid 'ne Wucht!",
        "c37a96b6e8bc3c44f3eb": "Ich glaube, meine Halskette ist in den See gefallen. Mein Papa hat sie mir geschenkt. Jetzt wird er bestimmt schrecklich wütend."
      },
      "name": "Hilary",
