    "csCZ": {
      "dialogue": {
        "0355c2289701c4dd2433": "Děkuji, pane, že jste našel můj náhrdelník! Jste nejlepší!",
        "c37a96b6e8bc3c44f3eb": "Myslím, že mi náhrdelník spadl do jezera. Dal mi ho tatínek a teď se bude zlobit."
      },
      "name": "Hilary",
