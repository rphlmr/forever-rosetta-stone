    "enUS": {
      "dialogue": {
        "0355c2289701c4dd2433": "Thank you mister for finding my necklace!  You're the best!",
        "c37a96b6e8bc3c44f3eb": "I think my necklace fell in the lake.  My daddy got it for me, and he's gonna be mad now."
      },
      "name": "Hilary",
