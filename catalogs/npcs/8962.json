    "daDK": {
      "dialogue": {
        "0355c2289701c4dd2433": "Tak, fordi du fandt min halskæde, hr.! Du er den bedste!",
        "c37a96b6e8bc3c44f3eb": "Jeg tror, min halskæde faldt i søen. Min far gav mig den, og nu bliver han vred."
      },
      "name": "Hilary",
