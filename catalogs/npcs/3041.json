          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "27f33da9ac4faf06ec10": "Jeg kan ikke træne dig, $c.",
        "394d21b876a1139d3909": "Uanset hvor meget man lærer, er der altid mere at vide.",
        "7e3863de3e17948bf264": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine lærte talenter?",
        "e75a959977d9643ad958": "Jeg har brug for krigertræning."
      },
      "name": "Torm Ragetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.27f33da9ac4faf06ec10": {
            "origin": "ai",
