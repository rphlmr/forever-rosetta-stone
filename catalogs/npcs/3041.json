    "ltLT": {
      "dialogue": {
        "27f33da9ac4faf06ec10": "Negaliu tavęs mokyti, $c.",
        "394d21b876a1139d3909": "Kad ir kiek išmoktum, visada lieka dar daugiau sužinoti.",
        "7e3863de3e17948bf264": "Griežtai permokydamas turėjau priversti daugelį mokinių atsisakyti visko, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Šią paslaugą kaskart atlikti darosi vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "e75a959977d9643ad958": "Noriu mokytis kario įgūdžių."
      },
      "name": "Torm Ragetotem",
      "subName": "Karių mokytojas",
