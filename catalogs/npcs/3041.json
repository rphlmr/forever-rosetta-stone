    "esES": {
      "dialogue": {
        "27f33da9ac4faf06ec10": "No puedo entrenarte, $c.",
        "394d21b876a1139d3909": "No importa cuánto aprendamos, siempre queda más por saber.",
        "7e3863de3e17948bf264": "He tenido que realizar una rigurosa reconversión con muchos estudiantes de todo lo que habían aprendido, para poder enseñarles desde cero. El servicio que ofrezco aumenta de dificultad cada vez que se hace. Por esa razón, también aumenta el precio de cada nueva instrucción. ¿Quieres que elimine todos los talentos que has aprendido?",
        "e75a959977d9643ad958": "Necesito entrenamiento de guerrero."
      },
      "name": "Torm Furiatótem",
      "subName": "Instructor de guerreros",
