    "enUS": {
      "dialogue": {
        "27f33da9ac4faf06ec10": "I can not train you, $c.",
        "394d21b876a1139d3909": "No matter how much one learns, there is always more to know.",
        "7e3863de3e17948bf264": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "e75a959977d9643ad958": "I require warrior training."
      },
      "name": "Torm Ragetotem",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
