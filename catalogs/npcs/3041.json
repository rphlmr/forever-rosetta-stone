  "locales": {
    "csCZ": {
      "dialogue": {
        "27f33da9ac4faf06ec10": "Nemohu tě cvičit, $c.",
        "394d21b876a1139d3909": "Bez ohledu na to, kolik se člověk naučí, vždy je co poznávat.",
        "7e3863de3e17948bf264": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto je také dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?",
        "e75a959977d9643ad958": "Potřebuji výcvik válečníka."
      },
      "name": "Torm Ragetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.27f33da9ac4faf06ec10": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
