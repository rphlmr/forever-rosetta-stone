    "daDK": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Hvad?",
        "1d9655ac91f7f3ab6cc6": "Ved grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Det bliver sværere hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "abb447bcbc9e8abad77f": "Spild ikke min tid.",
        "fc7a8c5904201a485446": "Jeg søger træning i jægerens kunst."
      },
      "name": "Kragg",
      "translationMetadata": {
        "fields": {
