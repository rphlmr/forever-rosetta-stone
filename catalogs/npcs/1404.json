    "hrHR": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Što?",
        "1d9655ac91f7f3ab6cc6": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su naučili kako bih ih mogao ponovno podučiti. Svaka sljedeća prekvalifikacija sve je teža, pa zato i skuplja. Želiš li da zaboraviš naučene talente?",
        "abb447bcbc9e8abad77f": "Ne gubi moje vrijeme.",
        "fc7a8c5904201a485446": "Tražim obuku u lovačkim vještinama."
      },
      "name": "Kragg",
