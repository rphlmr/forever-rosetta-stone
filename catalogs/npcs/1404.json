    "ltLT": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Ką?",
        "1d9655ac91f7f3ab6cc6": "Griežtai permokydamas ne vieną mokinį turėjau priversti pamiršti viską, ko buvo išmokęs, kad galėčiau jį mokyti iš naujo. Kaskart suteikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "abb447bcbc9e8abad77f": "Negaišink mano laiko.",
        "fc7a8c5904201a485446": "Noriu išmokti medžiotojo amato."
      },
      "name": "Kragg",
      "subName": "Medžiotojų mokytojas",
      "translationMetadata": {
        "fields": {
          "dialogue.0abff3acac0e688a40cc": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
