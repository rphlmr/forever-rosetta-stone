    "ptBR": {
      "dialogue": {
        "0abff3acac0e688a40cc": "O quê?",
        "1d9655ac91f7f3ab6cc6": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "abb447bcbc9e8abad77f": "Não me faça perder tempo!",
        "fc7a8c5904201a485446": "Procuro treinamento nos caminhos do caçador."
      },
      "name": "Kragg",
      "subName": "Treinamento de Caçadores",
