  "locales": {
    "csCZ": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Co?",
        "1d9655ac91f7f3ab6cc6": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl vyučit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto i dražší. Přeješ si zapomenout naučené talenty?",
        "abb447bcbc9e8abad77f": "Neztrácej můj čas.",
        "fc7a8c5904201a485446": "Hledám výcvik v umění lovce."
      },
      "name": "Kragg",
      "translationMetadata": {
