    "trTR": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Ne?",
        "1d9655ac91f7f3ab6cc6": "Sıkı bir yeniden eğitimle birçok öğrencime öğrendikleri her şeyi unutturup onları baştan eğitmem gerekti. Bu işlem her tekrarlandığında zorlaşır ve bu yüzden pahalılaşır. Öğrendiğin yetenekleri sana unutturmamı ister misin?",
        "abb447bcbc9e8abad77f": "Vaktimi boşa harcama.",
        "fc7a8c5904201a485446": "Avcılığın yollarını öğrenmek istiyorum."
      },
      "name": "Kragg",
