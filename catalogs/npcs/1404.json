    "plPL": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Co?",
        "1d9655ac91f7f3ab6cc6": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by uczyć ich na nowo. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz zapomnieć wyuczone talenty?",
        "abb447bcbc9e8abad77f": "Nie marnuj mojego czasu.",
        "fc7a8c5904201a485446": "Szukam szkolenia w sztuce łowcy."
      },
      "name": "Kragg",
