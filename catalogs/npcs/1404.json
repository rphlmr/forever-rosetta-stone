    "svSE": {
      "dialogue": {
        "0abff3acac0e688a40cc": "Vad?",
        "1d9655ac91f7f3ab6cc6": "Genom rigorös omskolning har jag fått många elever att glömma allt de lärt sig för att kunna lära dem på nytt. Varje omskolning blir svårare och därför också dyrare. Vill du att jag får dig att glömma dina talanger?",
        "abb447bcbc9e8abad77f": "Slösa inte min tid.",
        "fc7a8c5904201a485446": "Jag söker träning i jägarens konst."
      },
      "name": "Kragg",
