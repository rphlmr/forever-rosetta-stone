    "trTR": {
      "dialogue": {
        "0236d2b4586f2cf184e0": "Ben Rutherford Twing, Arathi Havzası’nda görevli Defilerların baş tedarikçisiyim. Aramızdaki itibarın arttıkça işine yarayabilecek seçkin malları sana sunacağım. Eşyalarını tamir ettirmen gerekirse bu hizmeti de veriyorum.",
        "c553514d0359b335b105": "Defilerlardan hangi malları satın alma hakkını kazandım?"
      },
      "name": "Rutherford Twing",
      "translationMetadata": {
