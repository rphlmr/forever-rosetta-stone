    "enUS": {
      "dialogue": {
        "0236d2b4586f2cf184e0": "I am Rutherford Twing, the main supplier for the Defilers posted here at Arathi Basin.  As you improve your standing with us, I will make available to you a fine selection of goods that you might find useful.  Should you find yourself in need of item repair, I also provide those services.",
        "c553514d0359b335b105": "What goods have I earned the right to purchase from the Defilers?"
      },
      "name": "Rutherford Twing",
      "subName": "Defilers Supply Officer",
      "translationMetadata": {
