  "locales": {
    "csCZ": {
      "dialogue": {
        "0236d2b4586f2cf184e0": "Jsem Rutherford Twing, hlavní zásobovač Defilerů zde v Arathijské pánvi. Jakmile si u nás získáš lepší postavení, zpřístupním ti výběr kvalitního zboží, které by se ti mohlo hodit. Pokud potřebuješ opravit vybavení, nabízím i tuto službu.",
        "c553514d0359b335b105": "Jaké zboží si mohu díky své pověsti koupit od Defilerů?"
      },
      "name": "Rutherford Twing",
      "translationMetadata": {
        "fields": {
          "dialogue.0236d2b4586f2cf184e0": {
