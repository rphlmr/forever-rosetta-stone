    "daDK": {
      "dialogue": {
        "0236d2b4586f2cf184e0": "Jeg er Rutherford Twing, hovedleverandør for Defilers her i Arathi Basin. Efterhånden som dit omdømme hos os forbedres, får du adgang til et godt udvalg af varer, du måske kan bruge. Hvis du har brug for reparationer, tilbyder jeg også den tjeneste.",
        "c553514d0359b335b105": "Hvilke varer har jeg gjort mig fortjent til at købe hos Defilers?"
      },
      "name": "Rutherford Twing",
      "translationMetadata": {
        "fields": {
          "dialogue.0236d2b4586f2cf184e0": {
