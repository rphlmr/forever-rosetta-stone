    "hrHR": {
      "dialogue": {
        "0236d2b4586f2cf184e0": "Ja sam Rutherford Twing, glavni dobavljač Defilera ovdje u Arathijskom bazenu. Kako budeš stjecao ugled među nama, ponudit ću ti izbor kvalitetne robe koja bi ti mogla koristiti. Ako trebaš popraviti opremu, nudim i tu uslugu.",
        "c553514d0359b335b105": "Koju robu imam pravo kupiti od Defilera?"
      },
      "name": "Rutherford Twing",
      "translationMetadata": {
