    "daDK": {
      "dialogue": {
        "2fdd407addec4499ffd2": "$n, hvordan kan jeg fremme din træning i Jordmoderens øjne?",
        "4ad63843ce4c208ee429": "Jordmoderens veje er mange. Må dine forfædre våge over dig, $c.",
        "62938a31331421a38980": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "90e9253eb97e204c3fc2": "Jeg søger yderligere druideundervisning for bedre at forstå Jordmoderens vilje."
      },
      "name": "Jannos Lighthoof",
      "translationMetadata": {
