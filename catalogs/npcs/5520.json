    "daDK": {
      "dialogue": {
        "cfc88a66863097e837e3": "Vis mig dit udvalg af grimoirer.",
        "f1b9c7feb4e01bca9034": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted.",
        "f6dcc6102f376f509fdf": "Du er ikke dæmonolog, og jeg har ikke tid til dig. Forsvind!"
      },
      "name": "Spackle Thornberry",
