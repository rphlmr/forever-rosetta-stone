    "deDE": {
      "dialogue": {
        "cfc88a66863097e837e3": "Zeigt mir Eure Auswahl an Grimoires.",
        "f1b9c7feb4e01bca9034": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "f6dcc6102f376f509fdf": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!"
      },
      "name": "Spackle Thornberry",
      "subName": "Dämonenausbilder",
