    "csCZ": {
      "dialogue": {
        "cfc88a66863097e837e3": "Ukažte mi svou nabídku grimoárů.",
        "f1b9c7feb4e01bca9034": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě.",
        "f6dcc6102f376f509fdf": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!"
      },
      "name": "Spackle Thornberry",
