    "trTR": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Sana ilk yardım tekniklerini öğretebilirim.",
        "9c7841690674ca8cff25": "Eğitime ihtiyacım var.",
        "a402c8696d52ac736475": "Saygın Doktor Gustaf VanHowzen sana daha fazlasını öğretebilir. Onu Theramore'daki kışlada yaralıları tedavi ederken bulabilirsin.",
        "ab9f6067325a6196cb36": "Stromgarde'da saklanan Deneb Walker'ın ilk yardım becerilerini geliştirmen için yararlı bir kitabı olduğunu duydum."
      },
      "name": "Michelle Belle",
