    "itIT": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Posso insegnarti le tecniche di Primo Soccorso.",
        "9c7841690674ca8cff25": "Ho bisogno di addestramento.",
        "a402c8696d52ac736475": "L'illustre Dottor Gustaf VanHowzen può portare avanti il tuo addestramento. Lo trovi a Theramore, alla caserma, dove cura i feriti.",
        "ab9f6067325a6196cb36": "Ho sentito dire che Deneb Walker, rintanato a Stromgarde, ha un libro che ti aiuterà di sicuro a migliorare le tue tecniche di primo soccorso."
      },
      "name": "Michelle Belle",
