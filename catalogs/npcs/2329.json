    "daDK": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Jeg kan lære dig førstehjælpsteknikker.",
        "9c7841690674ca8cff25": "Jeg har brug for træning.",
        "a402c8696d52ac736475": "Den ansete doktor Gustaf VanHowzen kan lære dig mere. Han behandler de sårede i kasernen i Theramore.",
        "ab9f6067325a6196cb36": "Jeg har hørt, at Deneb Walker, som holder til i Stromgarde, har en bog, der kan forbedre dine førstehjælpsfærdigheder."
      },
      "name": "Michelle Belle",
      "translationMetadata": {
        "fields": {
