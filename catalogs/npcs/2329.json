    "frFR": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Je peux vous enseigner des techniques de Premiers soins.",
        "9c7841690674ca8cff25": "J'ai besoin d'entraînement.",
        "a402c8696d52ac736475": "L’estimable docteur Gustav VanHowzen peut vous faire progresser. Vous le trouverez à la caserne de Theramore, où Il soigne les blessés.",
        "ab9f6067325a6196cb36": "J’ai entendu dire qu’un certain Deneb Walker, qui se planque dans Stromgarde, possède un livre qui pourrait améliorer votre compétence en Premiers soins."
      },
      "name": "Michelle Belle",
      "subName": "Médecin",
