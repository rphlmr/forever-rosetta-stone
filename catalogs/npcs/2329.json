  "locales": {
    "csCZ": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Mohu tě naučit techniky první pomoci.",
        "9c7841690674ca8cff25": "Potřebuji výcvik.",
        "a402c8696d52ac736475": "Vážený doktor Gustaf VanHowzen tě může naučit víc. Najdeš ho v Theramoru, kde v kasárnách ošetřuje raněné.",
        "ab9f6067325a6196cb36": "Slyšela jsem, že Deneb Walkerová, která se skrývá ve Stromgardu, má knihu, která ti určitě pomůže zlepšit první pomoc."
      },
      "name": "Michelle Belle",
      "translationMetadata": {
