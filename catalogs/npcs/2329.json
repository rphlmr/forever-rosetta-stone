    "svSE": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Jag kan lära dig första hjälpen.",
        "9c7841690674ca8cff25": "Jag behöver träning.",
        "a402c8696d52ac736475": "Den ansedde doktor Gustaf VanHowzen kan lära dig mer. Han behandlar sårade i kasernen i Theramore.",
        "ab9f6067325a6196cb36": "Jag har hört att Deneb Walker, som håller till i Stromgarde, har en bok som säkert kan hjälpa dig att bli bättre på första hjälpen."
      },
      "name": "Michelle Belle",
