    "plPL": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Mogę nauczyć cię technik pierwszej pomocy.",
        "9c7841690674ca8cff25": "Potrzebuję szkolenia.",
        "a402c8696d52ac736475": "Szanowany doktor Gustaf VanHowzen może dalej cię szkolić. Znajdziesz go w Theramore, gdzie opatruje rannych w koszarach.",
        "ab9f6067325a6196cb36": "Słyszałam, że Deneb Walker, która ukrywa się w Stromgarde, ma książkę, która z pewnością pomoże ci doskonalić pierwszą pomoc."
      },
