    "hrHR": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Mogu te naučiti tehnikama prve pomoći.",
        "9c7841690674ca8cff25": "Trebam obuku.",
        "a402c8696d52ac736475": "Uvaženi doktor Gustaf VanHowzen može te dalje obučavati. Naći ćeš ga u Theramoreu, gdje liječi ranjenike u vojarni.",
        "ab9f6067325a6196cb36": "Čula sam da Deneb Walker, koja se skriva u Stromgardeu, ima knjigu koja će ti sigurno pomoći usavršiti prvu pomoć."
      },
      "name": "Michelle Belle",
