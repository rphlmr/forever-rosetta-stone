    "enUS": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "I can train you in First Aid techniques.",
        "9c7841690674ca8cff25": "I require training.",
        "a402c8696d52ac736475": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks.",
        "ab9f6067325a6196cb36": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques."
      },
      "name": "Michelle Belle",
      "subName": "Physician",
      "translationMetadata": {
