    "ptBR": {
      "dialogue": {
        "121f9ce4c2ad50fddae3": "Eu posso lhe ensinar as técnicas de Primeiros Socorros.",
        "9c7841690674ca8cff25": "Preciso de treinamento.",
        "a402c8696d52ac736475": "O estimado Doutor Gregório Casagrande pode prosseguir com o seu treinamento. Ele fica em Theramore, cuidando dos feridos no quartel.",
        "ab9f6067325a6196cb36": "Ouvi dizer que Deneb Walker tem um livro que com certeza vai te ajudar a aperfeiçoar sua técnica de Primeiros Socorros. Ele está escondido em Stromgarde."
      },
      "name": "Michelle Belle",
      "subName": "Médica",
