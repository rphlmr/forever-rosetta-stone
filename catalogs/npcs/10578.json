          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "58dfb62032a603e703aa": "Iaí, cara! Fala ali com o Mestre Gadrin, ó. Cuida lá do maluco do Zalazane pra ele que eu te quebro um galho, belê?",
        "80d4b7e544ee7f14a921": "Esse trabalho voluntário aqui é o meu jeito de me formar na Faculdade de Mandinga. Como tu me deu uma força, eu vou te ajudar de graça. O que tu quer que eu fortaleça aí?"
      },
      "name": "Bom'bay",
      "subName": "Mandingueiro em Treinamento",
      "translationMetadata": {
        "fields": {
