    "plPL": {
      "dialogue": {
        "58dfb62032a603e703aa": "Hej, stary. Pogadaj z moim mistrzem Gadrinem, o tam. Załatw dla niego tego szaleńca Zalazane'a, a ja cię poskładam!",
        "80d4b7e544ee7f14a921": "Tak, stary, jestem pomocnikiem Gadrina. Ta praca na ochotnika pomaga mi przetrwać szkołę znachorów. Skoro pomagasz jemu, ja pomogę tobie za darmo. Co trzeba naprawić?"
      },
      "name": "Bom'bay",
      "translationMetadata": {
        "fields": {
          "dialogue.58dfb62032a603e703aa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
