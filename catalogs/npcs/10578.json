    "hrHR": {
      "dialogue": {
        "58dfb62032a603e703aa": "Hej, prijatelju. Razgovaraj s mojim učiteljem Gadrinom tamo. Riješi za njega onog luđaka Zalazanea pa ću te ja srediti!",
        "80d4b7e544ee7f14a921": "Da, prijatelju, ja sam Gadrinov pomoćnik. Ovim volontiranjem prolazim školu vračeva. Kad ti pomažeš njemu, ja ću tebi besplatno. Što treba popraviti?"
      },
      "name": "Bom'bay",
      "translationMetadata": {
