  "locales": {
    "csCZ": {
      "dialogue": {
        "58dfb62032a603e703aa": "Nazdar, kámo. Promluv si s mým mistrem Gadrinem támhle. Postarej se pro něj o toho šílence Zalazaneho a já tě dám do pořádku!",
        "80d4b7e544ee7f14a921": "Jasně, kámo, jsem Gadrinův pomocník. Tahle dobrovolná práce mi pomáhá zvládnout školu šamanů. Když pomáháš jemu, já pomůžu tobě zadarmo. Co potřebuješ spravit?"
      },
      "name": "Bom'bay",
      "translationMetadata": {
        "fields": {
          "dialogue.58dfb62032a603e703aa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.80d4b7e544ee7f14a921": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "58dfb62032a603e703aa": "Hej, ven. Tal med min mester Gadrin lige derovre. Tag dig af den gale Zalazane for ham, så lapper jeg dig sammen!",
        "80d4b7e544ee7f14a921": "Ja, ven, jeg er Gadrins assistent. Det her frivillige arbejde hjælper mig gennem heksedoktorskolen. Når du hjælper ham, hjælper jeg dig gratis. Hvad skal ordnes?"
      },
      "name": "Bom'bay",
      "translationMetadata": {
        "fields": {
          "dialogue.58dfb62032a603e703aa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
