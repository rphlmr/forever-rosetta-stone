    "esES": {
      "dialogue": {
        "58dfb62032a603e703aa": "Ey colega. Ve hablar con mi maestro Gadrin allá. ¡Cuidado con el Zalazane, estar loco con él, y yo arreglar todo!",
        "80d4b7e544ee7f14a921": "Sí, colega, yo ayudante de Gadrin soy. Este ser trabajo voluntario que mi modo es de terminar con la escuela de médicos brujos. Como tu ayudarme yo te ayudo gratis. ¿Qué necesitar?"
      },
      "name": "Bom'bay",
      "subName": "Médico brujo en prácticas",
