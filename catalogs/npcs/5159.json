    "itIT": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Ho bisogno di addestramento, Daryl.",
        "4901f250242fdaa84bb9": "Do loro da mangiare, ragazzo. Già, Daryl Riknussun al tuo servizio.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "b1cdf0a59f35b2f0556e": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "c609b79c59389291423b": "Cerca Shandrina al Rifugio di Silverwind. Può venderti il \"Ricettario per Esperti\"."
      },
      "name": "Daryl Riknussun",
