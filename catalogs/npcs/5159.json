    "daDK": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Jeg har brug for træning, Daryl.",
        "4901f250242fdaa84bb9": "Jeg sørger for, at de får mad, knægt. Ja, Daryl Riknussun til tjeneste.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave fra Gadgetzan er mester i kogekunst. Du må opsøge ham for at blive bedre.",
        "b1cdf0a59f35b2f0556e": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme passion!",
        "c609b79c59389291423b": "Opsøg Shandrina i Silverwind Refuge. Hun kan sælge dig \"Expert Cookbook\"."
      },
      "name": "Daryl Riknussun",
      "translationMetadata": {
        "fields": {
          "dialogue.0ef53ac2e7ea659e7adf": {
