    "hrHR": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Treba mi obuka, Daryle.",
        "4901f250242fdaa84bb9": "Ja ih hranim, mali. Da, Daryl Riknussun tebi na usluzi.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave iz Gadgetzana majstor je kulinarske umjetnosti. Potraži ga ako se želiš usavršiti.",
        "b1cdf0a59f35b2f0556e": "Kuhanje je cjeloživotni poziv i vidim da dijelimo istu strast!",
        "c609b79c59389291423b": "Potraži Shandrinu u Silverwind Refugeu. Ona ti može prodati „Expert Cookbook”."
      },
      "name": "Daryl Riknussun",
