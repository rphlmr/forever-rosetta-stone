    "svSE": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Jag behöver träning, Daryl.",
        "4901f250242fdaa84bb9": "Jag ser till att de får mat, grabben. Japp, Daryl Riknussun till din tjänst.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave från Gadgetzan är en mästare på matlagning. Du måste söka upp honom för att bli bättre.",
        "b1cdf0a59f35b2f0556e": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!",
        "c609b79c59389291423b": "Sök upp Shandrina i Silverwind Refuge. Hon kan sälja dig \"Expert Cookbook\"."
      },
      "name": "Daryl Riknussun",
