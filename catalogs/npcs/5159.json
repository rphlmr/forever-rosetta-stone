    "ptBR": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Preciso de treinamento, Daryl.",
        "4901f250242fdaa84bb9": "Eu os mantenho de barriga cheia, guri. Isso aí, Daryl Ricinum ao seu dispor.",
        "a899b0c23bc2215e9025": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "b1cdf0a59f35b2f0556e": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "c609b79c59389291423b": "Encontre Shandrina no Refúgio Brisaprata. Ela pode lhe vender o \"Livro de Receitas do Perito\"."
      },
      "name": "Daryl Ricinum",
      "subName": "Treinamento de Culinária",
