    "enUS": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "I require training, Daryl.",
        "4901f250242fdaa84bb9": "I keep 'em fed, kid. Yep, Daryl Riknussun, at yer service.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "b1cdf0a59f35b2f0556e": "Cooking is a life long pursuit and I see we share the same passion!",
        "c609b79c59389291423b": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\"."
      },
      "name": "Daryl Riknussun",
      "subName": "Cooking Trainer",
