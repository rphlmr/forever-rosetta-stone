    "trTR": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Eğitim almak istiyorum, Daryl.",
        "4901f250242fdaa84bb9": "Onları ben doyururum, ufaklık. Evet, Daryl Riknussun hizmetinde.",
        "a899b0c23bc2215e9025": "Gadgetzanlı Dirge Quikcleave, yemek sanatlarında bir ustadır. Kendini geliştirmek için onu bulmalısın.",
        "b1cdf0a59f35b2f0556e": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "c609b79c59389291423b": "Silverwind Refuge’daki Shandrina’yı bul. Sana \"Expert Cookbook\" satabilir."
      },
      "name": "Daryl Riknussun",
