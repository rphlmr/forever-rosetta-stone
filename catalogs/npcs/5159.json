  "locales": {
    "csCZ": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Potřebuji výcvik, Daryle.",
        "4901f250242fdaa84bb9": "Krmím je, mládě. Ano, Daryl Riknussun k vašim službám.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Pokud se chceš zlepšit, musíš ho vyhledat.",
        "b1cdf0a59f35b2f0556e": "Vaření je celoživotní záliba a vidím, že sdílíme stejnou vášeň!",
        "c609b79c59389291423b": "Vyhledej Shandrinu v Silverwind Refuge. Může ti prodat „Expert Cookbook“."
      },
      "name": "Daryl Riknussun",
      "translationMetadata": {
        "fields": {
          "dialogue.0ef53ac2e7ea659e7adf": {
