    "plPL": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Potrzebuję szkolenia, Darylu.",
        "4901f250242fdaa84bb9": "Dbam o to, by byli najedzeni, młody. Tak, Daryl Riknussun do usług.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Musisz go odszukać, by doskonalić swoje umiejętności.",
        "b1cdf0a59f35b2f0556e": "Gotowanie to zajęcie na całe życie i widzę, że podzielamy tę samą pasję!",
        "c609b79c59389291423b": "Odszukaj Shandrinę w Silverwind Refuge. Sprzeda ci „Expert Cookbook”."
      },
      "name": "Daryl Riknussun",
