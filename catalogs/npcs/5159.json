    "frFR": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "J'ai besoin d'une formation, Daryl.",
        "4901f250242fdaa84bb9": "Faut pas se laisser aller, la jeunesse. Ouais, Daryl Riknussun, à votre service.",
        "a899b0c23bc2215e9025": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "b1cdf0a59f35b2f0556e": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "c609b79c59389291423b": "Allez voir Shandrina au refuge de Vent-argent. Elle pourra vous vendre un livre de cuisine pour experts."
      },
      "name": "Daryl Riknussun",
      "subName": "Maître des cuisiniers",
