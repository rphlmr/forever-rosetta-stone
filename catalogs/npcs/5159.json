    "deDE": {
      "dialogue": {
        "0ef53ac2e7ea659e7adf": "Ich brauche eine Ausbildung, Daryl.",
        "4901f250242fdaa84bb9": "Ich sorge für sie. Jawoll, Daryl Riknussun, zu Euren Diensten.",
        "a899b0c23bc2215e9025": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen.",
        "b1cdf0a59f35b2f0556e": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "c609b79c59389291423b": "Sucht nach Shandrina in der Silberwindzuflucht. Sie kann Euch das \"Expertenkochbuch\" verkaufen."
      },
      "name": "Daryl Riknussun",
      "subName": "Kochkunstlehrer",
      "translationMetadata": {
        "fields": {
