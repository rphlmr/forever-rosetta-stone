    "plPL": {
      "dialogue": {
        "3ba034e9e219212c1edd": "Interesuje mnie szkolenie maga.",
        "421835593dd7195a919f": "Interesuje mnie szkolenie maga.",
        "89e840df8e631e62787b": "Dzięki gruntownemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Ta usługa staje się coraz trudniejsza za każdym razem, dlatego każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, bym pomógł ci zapomnieć poznane talenty?",
        "a4335f11be685ac0c614": "Witaj. Jestem nieumarłym nauczycielem magów, a ty jesteś magiem.",
        "da32b221810cbf6f37a0": "Witaj, $c. Oto moja rada: podróżując po świecie, strzeż się magii, bo sparzy niewprawnych."
      },
      "name": "Ursyn Ghull",
      "translationMetadata": {
