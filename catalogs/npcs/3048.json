  "locales": {
    "csCZ": {
      "dialogue": {
        "3ba034e9e219212c1edd": "Mám zájem o výcvik mága.",
        "421835593dd7195a919f": "Mám zájem o výcvik mága.",
        "89e840df8e631e62787b": "Přísným přeškolením jsem musel mnohé studenty odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Chceš, abych tě odnaučil talentům, které ses naučil?",
        "a4335f11be685ac0c614": "Zdravím. Jsem nemrtvý trenér mágů a ty jsi mág.",
        "da32b221810cbf6f37a0": "Vítej, $c. Radím ti: až budeš cestovat světem, měj se na pozoru před magií, protože může nevycvičené popálit."
      },
      "name": "Ursyn Ghull",
      "translationMetadata": {
        "fields": {
          "dialogue.3ba034e9e219212c1edd": {
