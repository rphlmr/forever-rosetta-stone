    "daDK": {
      "dialogue": {
        "3ba034e9e219212c1edd": "Jeg er interesseret i magikertræning.",
        "421835593dd7195a919f": "Jeg er interesseret i magikertræning.",
        "89e840df8e631e62787b": "Gennem grundig omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere ved hver omskoling. Ønsker du, at jeg aflærer dig de talenter, du har lært?",
        "a4335f11be685ac0c614": "Hilsner. Jeg er en udød magikertræner, og du er magiker.",
        "da32b221810cbf6f37a0": "Godt mødt, $c. Mit råd er dette: Når du rejser i verden, så vær på vagt over for magi, for den brænder de uøvede."
      },
      "name": "Ursyn Ghull",
      "translationMetadata": {
