    "ltLT": {
      "dialogue": {
        "3ba034e9e219212c1edd": "Norėčiau mokytis magijos.",
        "421835593dd7195a919f": "Norėčiau mokytis magijos.",
        "89e840df8e631e62787b": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti viską, ką jie buvo išmokę, kad galėčiau juos išmokyti iš naujo. Kaskart atlikti šią paslaugą darosi vis sunkiau. Todėl su kiekvienu permokymu ji vis brangsta. Ar nori, kad priversčiau tave pamiršti išmoktus talentus?",
        "a4335f11be685ac0c614": "Sveikas. Esu nemirėlis magų mokytojas, o tu esi magas.",
        "da32b221810cbf6f37a0": "Sveikas, $c. Patarsiu tau štai ką: keliaudamas po pasaulį saugokis magijos, nes nepasirengusį ji gali nudeginti."
      },
      "name": "Ursyn Ghull",
      "subName": "Magų mokytojas",
