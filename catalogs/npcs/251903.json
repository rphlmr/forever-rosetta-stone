            "sourceRevision": "6ff5612b54191f297eb77ca8eda81de029d9d6f0"
          },
          "subName": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "4dbb82440a27856f8dccf57094a5d792cdc7cc9b"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "f07445ed214b8547d35d": "Muchos discrepan en este punto. Los Modelavientos quieren hacerte creer que basta con unir las manos y esperar el regreso de los espíritus. Sin embargo, el poder de su orden ha menguado y su camino nos devuelve al ciclo de dependencia que nos trajo hasta aquí. La Alta Orden, en cambio... creemos en un método más directo."
      },
      "name": "Rathiril Lanzasol",
      "subName": "Anciano de la Orden Eminente",
      "translationMetadata": {
        "fields": {
          "dialogue.f07445ed214b8547d35d": {
