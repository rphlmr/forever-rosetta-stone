  "locales": {
    "csCZ": {
      "dialogue": {
        "f07445ed214b8547d35d": "V tomto bodě panuje mnoho neshod. Windshapers by tě přesvědčili, že stačí spojit ruce a doufat v návrat duchů. Moc jejich řádu však zeslábla a jejich cesta nás vrací do kruhu závislosti, který nás sem přivedl. Nejvyšší řád naopak... věříme v přímější přístup."
      },
      "name": "Rathiril Sunlance",
      "translationMetadata": {
        "fields": {
          "dialogue.f07445ed214b8547d35d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
