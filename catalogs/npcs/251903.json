            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "f07445ed214b8547d35d": "Mange er uenige om dette. Windshapers vil have dig til at tro, at det er nok at holde hinanden i hånden og håbe på åndernes tilbagevenden. Deres ordens magt er imidlertid aftaget, og deres vej fører os tilbage i den afhængighedscyklus, der bragte os hertil. High Order derimod... vi tror på en mere direkte tilgang."
      },
      "name": "Rathiril Sunlance",
      "translationMetadata": {
        "fields": {
          "dialogue.f07445ed214b8547d35d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
