    "hrHR": {
      "dialogue": {
        "f07445ed214b8547d35d": "Mnogi se ne slažu oko toga. Windshaperi bi te uvjerili da je dovoljno udružiti ruke i samo se nadati povratku duhova. Međutim, moć njihova reda oslabila je, a njihov nas put vraća u krug ovisnosti koji nas je doveo dovde. Visoki red, s druge strane... mi vjerujemo u izravniji pristup."
      },
      "name": "Rathiril Sunlance",
      "translationMetadata": {
        "fields": {
          "dialogue.f07445ed214b8547d35d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
