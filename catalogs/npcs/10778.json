  "locales": {
    "csCZ": {
      "dialogue": {
        "2db1eb97b7b479c19c0d": "Pššt... cítíš něco?",
        "77c8d395fa55f3ec8c3f": "Duch na tebe hledí s pocitem úplnosti a uvědomění, který předtím chyběl.$B$B\"Mám pocit, jako by z mé duše spadlo velké břemeno. Brzy budu navždy pokojně odpočívat. Teď to vím a trpělivě na tu chvíli čekám.$B$BDěkuji ti, cizinče.\"",
        "7a38e238843bdac78c99": "Johne, miláčku, kde jsi?",
        "b8b2d647dedd23796356": "Čas mi dochází... nám všem...",
        "e897747df902bd335e8d": "Mám tolik práce... tolik toho musím udělat, než přijde mor...\n",
        "ff36a69c4e9ef7cbae71": "Co se to se všemi děje? Je mi... zima..."
      },
      "name": "Janice Felstone",
      "translationMetadata": {
