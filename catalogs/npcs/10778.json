    "enUS": {
      "dialogue": {
        "2db1eb97b7b479c19c0d": "Shhh... do you smell something?",
        "77c8d395fa55f3ec8c3f": "The spirit looks upon you with a sense of completeness and cognizance that had not been present before.$B$B\"I feel as though a great burden has been lifted from my soul.  Soon I will rest forever in peace.  I now know this, and I await this time patiently.$B$BThank you, stranger.\"",
        "7a38e238843bdac78c99": "John, honey, where are you?",
        "b8b2d647dedd23796356": "Time is running out for me... for us all...",
        "e897747df902bd335e8d": "I have so much to do... so much before the plague comes...\n",
        "ff36a69c4e9ef7cbae71": "What is happening to everyone?  I feel... cold..."
      },
      "name": "Janice Felstone",
      "translationMetadata": {
