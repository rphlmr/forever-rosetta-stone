    "hrHR": {
      "dialogue": {
        "2db1eb97b7b479c19c0d": "Psst... osjećaš li nešto?",
        "77c8d395fa55f3ec8c3f": "Duh te gleda s osjećajem potpunosti i svijesti kojih prije nije bilo.$B$B\"Osjećam kao da je velik teret skinut s moje duše. Uskoro ću zauvijek počivati u miru. Sada to znam i strpljivo čekam taj trenutak.$B$BHvala ti, stranče.\"",
        "7a38e238843bdac78c99": "Johne, dušo, gdje si?",
        "b8b2d647dedd23796356": "Vrijeme mi istječe... svima nama...",
        "e897747df902bd335e8d": "Toliko toga moram učiniti... toliko prije nego što kuga stigne...\n",
        "ff36a69c4e9ef7cbae71": "Što se događa sa svima? Osjećam... hladnoću..."
      },
      "name": "Janice Felstone",
