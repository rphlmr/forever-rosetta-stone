    "plPL": {
      "dialogue": {
        "2db1eb97b7b479c19c0d": "Ciii... czujesz coś?",
        "77c8d395fa55f3ec8c3f": "Duch patrzy na ciebie z poczuciem spełnienia i świadomością, których wcześniej mu brakowało.$B$B\"Czuję, jakby wielki ciężar spadł z mojej duszy. Wkrótce zaznam wiecznego spokoju. Teraz to wiem i cierpliwie czekam na tę chwilę.$B$BDziękuję, nieznajomy.\"",
        "7a38e238843bdac78c99": "Johnie, kochanie, gdzie jesteś?",
        "b8b2d647dedd23796356": "Kończy mi się czas... nam wszystkim...",
        "e897747df902bd335e8d": "Mam tyle do zrobienia... tak wiele, zanim nadejdzie zaraza...\n",
        "ff36a69c4e9ef7cbae71": "Co się dzieje ze wszystkimi? Czuję... chłód..."
      },
      "name": "Janice Felstone",
      "translationMetadata": {
