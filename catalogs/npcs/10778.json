    "itIT": {
      "dialogue": {
        "2db1eb97b7b479c19c0d": "Shhh... senti odore di qualcosa?",
        "77c8d395fa55f3ec8c3f": "Lo spirito ti guarda con un senso di completezza e consapevolezza che prima non c'era.$B$B\"Sento come se un grande peso fosse stato sollevato dalla mia anima. Presto riposerò per sempre in pace. Ora lo so e attendo pazientemente quel momento.$B$BGrazie, straniero.\"",
        "7a38e238843bdac78c99": "John, tesoro, dove sei?",
        "b8b2d647dedd23796356": "Il tempo sta finendo per me... per tutti noi...",
        "e897747df902bd335e8d": "Ho così tanto da fare... così tanto prima che arrivi la piaga...",
        "ff36a69c4e9ef7cbae71": "Cosa sta succedendo a tutti? Sento... freddo..."
      },
      "name": "Janice Felstone",
      "translationMetadata": {
