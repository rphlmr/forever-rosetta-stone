    "daDK": {
      "dialogue": {
        "3fdacfacffd92f525185": "Jeg vil gerne se dine varer.",
        "871fba304d54eae2be80": "Jagten på rigdom er det eneste mål for en respektabel goblin.$B$BAltså, måske rigdom... og en stor, larmende død!",
        "a9b31176a3b74b247239": "Træn mig."
      },
      "name": "Maxwort Uberglint",
      "translationMetadata": {
