    "csCZ": {
      "dialogue": {
        "3fdacfacffd92f525185": "Rád bych si prohlédl vaše zboží.",
        "871fba304d54eae2be80": "Honba za bohatstvím je jediným cílem váženého goblina.$B$BNo, možná bohatství... a pořádně hlučná smrt!",
        "a9b31176a3b74b247239": "Vycvičte mě."
      },
      "name": "Maxwort Uberglint",
