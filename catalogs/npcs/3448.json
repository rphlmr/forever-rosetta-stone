    "plPL": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "Czasy, w których żyjemy, są tak zmienne jak wiatry, $c. Ważne, by pamiętać o tym, co na tym świecie prawdziwe i trwałe, oraz to chronić. Cała reszta jest stratą czasu."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
        "fields": {
