        }
      }
    },
    "ptBR": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "Os tempos em que vivemos são volúveis qual pluma ao vento, $c. É importante lembrar do que é verdadeiro e perene neste mundo, e preservá-lo. Tudo mais é desperdício."
      },
      "name": "Tonga Runa Totem",
