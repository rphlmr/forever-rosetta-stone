    "hrHR": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "Vremena u kojima živimo promjenjiva su poput vjetrova, $c. Važno je pamtiti i čuvati ono što je istinito i trajno na ovom svijetu. Sve ostalo je uzaludno."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
        "fields": {
