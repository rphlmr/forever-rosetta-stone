    "enUS": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "The times we live in are as fickle as the shifting winds, $c.  It is important to remember what is true and lasting in this world, and to preserve that.  Everything else is a waste."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.3cb9d55a9d3be17afadc": {
