    "daDK": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "Tiden, vi lever i, er lige så omskiftelig som vinden, $c. Det er vigtigt at huske og bevare det, der er sandt og varigt i denne verden. Alt andet er spild."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.3cb9d55a9d3be17afadc": {
