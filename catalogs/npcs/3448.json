            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "Die Zeiten, in denen wir leben, sind so wechselhaft wie die Winde, $C. Es ist wichtig, dass wir nicht vergessen, was in dieser Welt wahrhaftig und von Dauer ist, und dass wir das bewahren. Alles andere ist nur verlorene Zeit."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
        "fields": {
