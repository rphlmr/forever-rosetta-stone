      }
    },
    "trTR": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "İçinde yaşadığımız zamanlar değişken rüzgârlar kadar kararsız, $c. Bu dünyada gerçek ve kalıcı olanı hatırlamak ve korumak önemlidir. Geri kalan her şey boşa çabadır."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
        "fields": {
