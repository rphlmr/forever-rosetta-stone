  "locales": {
    "csCZ": {
      "dialogue": {
        "3cb9d55a9d3be17afadc": "Časy, v nichž žijeme, jsou stejně proměnlivé jako vítr, $c. Je důležité pamatovat na to, co je v tomto světě pravdivé a trvalé, a chránit to. Všechno ostatní je marnost."
      },
      "name": "Tonga Runetotem",
      "translationMetadata": {
