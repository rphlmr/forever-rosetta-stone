    "csCZ": {
      "dialogue": {
        "1ea7ac4900543d36e1ed": "Arr! Není nic lepšího než sledovat, jak v aréně lidé bojují na život a na smrt. Když přijdeš ve správný čas, možná budeš jedním z nich!"
      },
      "name": "Krátký John Mithril",
