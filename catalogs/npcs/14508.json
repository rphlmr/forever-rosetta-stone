    "daDK": {
      "dialogue": {
        "1ea7ac4900543d36e1ed": "Arr! Der er intet, jeg hellere vil se end folk, der kæmper til døden i arenaen. Er du her på det rette tidspunkt, kan du måske selv blive en af dem!"
      },
      "name": "Short John Mithril",
      "translationMetadata": {
        "fields": {
