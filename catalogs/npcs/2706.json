    "hrHR": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Zahvaljujući ratnom vođi, čak i ovdje u ruševinama našeg bivšeg zatvora još ima nade, a Horda se ponovno uzdiže.",
        "4a0c19ac2644babb5dd6": "Podučite me.",
        "a487285e07293b6d4eb1": "Želim pogledati vašu robu."
