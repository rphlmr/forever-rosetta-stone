    "enUS": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Thanks to the Warchief, even here in the ruins of our former prison, some hope remains, and the Horde rises anew.",
        "4a0c19ac2644babb5dd6": "Train me.",
        "a487285e07293b6d4eb1": "I want to browse your goods."
      },
      "name": "Tor'gan",
