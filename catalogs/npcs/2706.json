    "trTR": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Savaş Şefi sayesinde, eski hapishanemizin harabelerinde bile hâlâ umut var ve Horda yeniden yükseliyor.",
        "4a0c19ac2644babb5dd6": "Beni eğit.",
