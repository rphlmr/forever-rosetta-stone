    "daDK": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Takket være krigshøvdingen er der stadig håb, selv her i ruinerne af vores tidligere fængsel, og Horden rejser sig på ny.",
        "4a0c19ac2644babb5dd6": "Træn mig.",
        "a487285e07293b6d4eb1": "Jeg vil gerne se dine varer."
      },
      "name": "Tor'gan",
      "translationMetadata": {
        "fields": {
