    "frFR": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Grâce au Warchief, même ici, dans les ruines de notre ancienne prison, l'espoir demeure et la Horde se relève.",
        "4a0c19ac2644babb5dd6": "Entraînez-moi.",
        "a487285e07293b6d4eb1": "Je voudrais regarder vos articles."
