  "locales": {
    "csCZ": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Díky náčelníkovi zůstává i zde, v troskách našeho někdejšího vězení, naděje a Horda znovu povstává.",
        "4a0c19ac2644babb5dd6": "Vycvičte mě.",
        "a487285e07293b6d4eb1": "Chci si prohlédnout vaše zboží."
      },
      "name": "Tor'gan",
      "translationMetadata": {
