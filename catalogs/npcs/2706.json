    "esES": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Gracias al Jefe Supremo, incluso aquí, en las ruinas de nuestra antigua prisión, queda algo de esperanza, y la Horda se levanta de nuevo.",
        "4a0c19ac2644babb5dd6": "Entréname.",
        "a487285e07293b6d4eb1": "Quiero ver tus mercancías."
