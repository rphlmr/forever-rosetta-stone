    "ltLT": {
      "dialogue": {
        "0dc9c47dc2ae95fba3fd": "Karvedžio dėka net čia, mūsų buvusio kalėjimo griuvėsiuose, dar rusena viltis, o Orda vėl kyla.",
        "4a0c19ac2644babb5dd6": "Išmokyk mane.",
