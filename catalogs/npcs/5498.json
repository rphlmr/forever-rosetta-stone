    "enUS": {
      "dialogue": {
        "107fe01e33316ff8b6d8": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes.",
        "486bd0d3eb3ec6eac3a8": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes.",
        "746a9b0550629cc3d8ff": "I am interested in mage training.",
        "888d3991be4f60e2b495": "Well met, $c.  My advice to you is this: As you travel the world, be wary of magic for it will burn the untrained.",
        "d3fce9736bdbea596583": "Well met, $c.  My advice to you is this: As you travel the world, be wary of magic for it will burn the untrained.",
        "e2c798abecccb5164250": "I am interested in mage training."
      },
