  "locales": {
    "csCZ": {
      "dialogue": {
        "107fe01e33316ff8b6d8": "Kromě výcviku mám moc vymazat z tvé mysli znalost tvých talentů, pokud si to přeješ. Varuji tě, že pokaždé je tento postup obtížnější, a proto také dražší.",
        "486bd0d3eb3ec6eac3a8": "Kromě výcviku mám moc vymazat z tvé mysli znalost tvých talentů, pokud si to přeješ. Varuji tě, že pokaždé je tento postup obtížnější, a proto také dražší.",
        "746a9b0550629cc3d8ff": "Mám zájem o výcvik mága.",
        "888d3991be4f60e2b495": "Vítej, $c. Radím ti toto: při svých cestách světem se měj na pozoru před magií, neboť nevycvičené spálí.",
        "d3fce9736bdbea596583": "Vítej, $c. Radím ti toto: při svých cestách světem se měj na pozoru před magií, neboť nevycvičené spálí.",
        "e2c798abecccb5164250": "Mám zájem o výcvik mága."
      },
      "name": "Elsharin",
