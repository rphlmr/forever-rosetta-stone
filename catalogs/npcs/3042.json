    "hrHR": {
      "dialogue": {
        "1b482e5ba75ef6107b03": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao podučiti iznova. Ta je usluga svaki put sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "4930e776ec87536e1db8": "Koliko god čovjek naučio, uvijek ima još toga što može saznati.",
        "59d7395ce156ca5bbd68": "Ne mogu te podučavati, $c.",
        "bbcc8c9b5ad854cac100": "Trebam ratničku obuku."
      },
      "name": "Sark Ragetotem",
