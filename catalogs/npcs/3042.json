    "enUS": {
      "dialogue": {
        "1b482e5ba75ef6107b03": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "4930e776ec87536e1db8": "No matter how much one learns, there is always more to know.",
        "59d7395ce156ca5bbd68": "I can not train you, $c.",
        "bbcc8c9b5ad854cac100": "I require warrior training."
      },
      "name": "Sark Ragetotem",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
