        }
      }
    },
    "daDK": {
      "dialogue": {
        "1b482e5ba75ef6107b03": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "4930e776ec87536e1db8": "Uanset hvor meget man lærer, er der altid mere at vide.",
        "59d7395ce156ca5bbd68": "Jeg kan ikke træne dig, $c.",
        "bbcc8c9b5ad854cac100": "Jeg har brug for krigertræning."
      },
      "name": "Sark Ragetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.1b482e5ba75ef6107b03": {
