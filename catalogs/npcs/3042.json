    "ltLT": {
      "dialogue": {
        "1b482e5ba75ef6107b03": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti visa, ką jie anksčiau išmoko, kad galėčiau juos mokyti iš naujo.  Kaskart atlikti šią paslaugą tampa vis sunkiau.  Todėl su kiekvienu permokymu ji vis brangsta.  Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "4930e776ec87536e1db8": "Kad ir kiek išmoktum, visada lieka daugiau, ką sužinoti.",
        "59d7395ce156ca5bbd68": "Negaliu tavęs mokyti, $c.",
        "bbcc8c9b5ad854cac100": "Man reikia kario mokymų."
      },
      "name": "Sark Ragetotem",
      "subName": "Karių mokytojas",
