  "locales": {
    "csCZ": {
      "dialogue": {
        "1b482e5ba75ef6107b03": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvé naučené talenty?",
        "4930e776ec87536e1db8": "Ať se člověk naučí sebevíc, vždy je co dalšího poznávat.",
        "59d7395ce156ca5bbd68": "Nemohu tě trénovat, $c.",
        "bbcc8c9b5ad854cac100": "Potřebuji výcvik válečníka."
      },
      "name": "Sark Ragetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.1b482e5ba75ef6107b03": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
