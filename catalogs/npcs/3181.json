    "svSE": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "Den ansedde doktor Gustaf VanHowzen kan utbilda dig vidare. Du hittar honom i Theramore, där han vårdar sårade i kasernen.",
        "96c7dd015a77324d8df1": "Jag kan lära dig första hjälpen.",
        "b0465f7e3950de1830ac": "Jag har hört att Deneb Walker, som håller till i Stromgarde, har en bok som säkert hjälper dig att bli bättre på första hjälpen.",
        "fd73dc88c7caaa2a1864": "Jag behöver utbildning."
      },
      "name": "Fremal Doohickey",
