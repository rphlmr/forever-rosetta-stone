    "hrHR": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "Uvaženi doktor Gustaf VanHowzen može te dalje podučavati. Naći ćeš ga u Theramoreu, gdje u vojarni liječi ranjenike.",
        "96c7dd015a77324d8df1": "Mogu te podučiti tehnikama prve pomoći.",
        "b0465f7e3950de1830ac": "Čuo sam da Deneb Walker, koja se sklonila u Stromgardeu, ima knjigu koja će ti sigurno pomoći da usavršiš prvu pomoć.",
        "fd73dc88c7caaa2a1864": "Treba mi obuka."
      },
      "name": "Fremal Doohickey",
