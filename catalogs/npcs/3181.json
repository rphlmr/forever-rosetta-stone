  "locales": {
    "csCZ": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "Ctihodný doktor Gustaf VanHowzen tě může učit dál. Najdeš ho v Theramoru, kde v kasárnách ošetřuje raněné.",
        "96c7dd015a77324d8df1": "Mohu tě naučit techniky první pomoci.",
        "b0465f7e3950de1830ac": "Slyšel jsem, že Deneb Walkerová, která se ukrývá ve Stromgarde, má knihu, jež ti jistě pomůže zdokonalit se v první pomoci.",
        "fd73dc88c7caaa2a1864": "Potřebuji výcvik."
      },
      "name": "Fremal Doohickey",
      "translationMetadata": {
        "fields": {
