    "plPL": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "Szanowany doktor Gustaf VanHowzen może cię dalej szkolić. Znajdziesz go w Theramore, gdzie opatruje rannych w koszarach.",
        "96c7dd015a77324d8df1": "Mogę nauczyć cię technik pierwszej pomocy.",
        "b0465f7e3950de1830ac": "Słyszałem, że Deneb Walker, która ukrywa się w Stromgarde, ma książkę, która z pewnością pomoże ci udoskonalić techniki pierwszej pomocy.",
        "fd73dc88c7caaa2a1864": "Potrzebuję szkolenia."
      },
      "name": "Fremal Doohickey",
