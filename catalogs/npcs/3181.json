    "itIT": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "L'illustre Dottor Gustaf VanHowzen può portare avanti il tuo addestramento. Lo trovi a Theramore, alla caserma, dove cura i feriti.",
        "96c7dd015a77324d8df1": "Posso insegnarti le tecniche di Primo Soccorso.",
        "b0465f7e3950de1830ac": "Ho sentito dire che Deneb Walker, rintanato a Stromgarde, ha un libro che ti aiuterà di sicuro a migliorare le tue tecniche di primo soccorso.",
        "fd73dc88c7caaa2a1864": "Ho bisogno di addestramento."
      },
      "name": "Fremal Doohickey",
