    "enUS": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks.",
        "96c7dd015a77324d8df1": "I can train you in First Aid techniques.",
        "b0465f7e3950de1830ac": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques.",
        "fd73dc88c7caaa2a1864": "I require training."
      },
      "name": "Fremal Doohickey",
      "subName": "First Aid Trainer",
      "translationMetadata": {
        "fields": {
