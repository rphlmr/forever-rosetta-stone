    "deDE": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "Der angesehene Doktor Gustav VanHowzen kann Euch weiter ausbilden. Ihr findet ihn in Theramore, er versorgt die Verwundeten in der dort ansässigen Kaserne.",
        "96c7dd015a77324d8df1": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "b0465f7e3950de1830ac": "Ich habe gehört, dass Deneb Walker sich momentan in Stromgarde aufhält. Er ist im Besitz eines Buchs, das Euch helfen wird, Eure Techniken der Ersten Hilfe zu verbessern.",
        "fd73dc88c7caaa2a1864": "Ich benötige Ausbildung."
      },
      "name": "Fremal Doohickey",
      "subName": "Lehrer für Erste Hilfe",
      "translationMetadata": {
        "fields": {
