    "daDK": {
      "dialogue": {
        "85917f32ef0e9398fa8e": "Den ansete doktor Gustaf VanHowzen kan undervise dig videre. Du finder ham i Theramore, hvor han behandler de sårede i kasernen.",
        "96c7dd015a77324d8df1": "Jeg kan undervise dig i førstehjælp.",
        "b0465f7e3950de1830ac": "Jeg har hørt, at Deneb Walker, som holder til i Stromgarde, har en bog, der helt sikkert kan forbedre dine førstehjælpsfærdigheder.",
        "fd73dc88c7caaa2a1864": "Jeg har brug for træning."
      },
      "name": "Fremal Doohickey",
      "translationMetadata": {
