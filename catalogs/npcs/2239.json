    "enUS": {
      "dialogue": {
        "29c1d198f892d0808259": "One of the humans has the key to this infernal contraption. Eston I think they said his name was.",
        "da5ce83f34700d7d502a": "Do you mock me while I am unable to defend myself, bound to this ball of iron?",
        "zephras:c1e1f421f543d3eae79a": "How can I free you?"
      },
      "name": "Drull",
