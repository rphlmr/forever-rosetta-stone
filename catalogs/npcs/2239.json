  "locales": {
    "csCZ": {
      "dialogue": {
        "29c1d198f892d0808259": "Jeden z lidí má klíč k téhle pekelné věci. Myslím, že říkali, že se jmenuje Eston.",
        "da5ce83f34700d7d502a": "Posmíváš se mi, když se nemohu bránit, připoután k téhle železné kouli?",
        "zephras:c1e1f421f543d3eae79a": "Jak tě mohu osvobodit?"
      },
      "name": "Drull",
      "translationMetadata": {
        "fields": {
