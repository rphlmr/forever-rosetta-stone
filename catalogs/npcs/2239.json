    "ptBR": {
      "dialogue": {
        "29c1d198f892d0808259": "Um dos humanos está com a chave desta geringonça infernal. Acho que o nome dele é Elton.",
        "da5ce83f34700d7d502a": "Você zomba de mim enquanto estou incapaz de me defender, preso a esta bola de ferro?",
        "zephras:c1e1f421f543d3eae79a": "Como posso libertar você?"
