    "trTR": {
      "dialogue": {
        "29c1d198f892d0808259": "İnsanlardan birinde bu lanet düzeneğin anahtarı var. Sanırım adının Eston olduğunu söylediler.",
        "da5ce83f34700d7d502a": "Bu demir küreye bağlı olduğumdan kendimi savunamazken benimle alay mı ediyorsun?",
        "zephras:c1e1f421f543d3eae79a": "Seni nasıl özgür bırakabilirim?"
      },
      "name": "Drull",
