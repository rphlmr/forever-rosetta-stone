    "ltLT": {
      "dialogue": {
        "29c1d198f892d0808259": "Vienas iš žmonių turi šio pragariško įtaiso raktą. Regis, jie sakė, kad jo vardas Eston.",
        "da5ce83f34700d7d502a": "Ar tyčiojiesi iš manęs, kai negaliu apsiginti, prikaustytas prie šio geležinio rutulio?",
        "zephras:c1e1f421f543d3eae79a": "Kaip galiu tave išlaisvinti?"
