    "frFR": {
      "dialogue": {
        "29c1d198f892d0808259": "Un des humains a la clé de ce mécanisme infernal. Eston est son nom, je crois.",
        "da5ce83f34700d7d502a": "Vous moquez-vous de moi alors qu'il m'est impossible de me défendre, attaché à cette boule de fer ?",
        "zephras:c1e1f421f543d3eae79a": "Comment puis-je vous libérer ?"
