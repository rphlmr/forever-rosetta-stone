    "deDE": {
      "dialogue": {
        "29c1d198f892d0808259": "Einer der Menschen hat den Schlüssel zu diesem Höllenapparat. Ich meine, jemand hätte gesagt, er hieße Eston.",
        "da5ce83f34700d7d502a": "Macht Ihr Euch etwa über mich lustig, während ich an dieses Eisen gefesselt bin und mich nicht verteidigen kann?",
        "zephras:c1e1f421f543d3eae79a": "Wie kann ich Euch befreien?"
      },
      "name": "Drull",
