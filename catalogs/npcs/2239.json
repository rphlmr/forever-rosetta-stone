    "hrHR": {
      "dialogue": {
        "29c1d198f892d0808259": "Jedan od ljudi ima ključ ove paklene naprave. Mislim da su rekli da se zove Eston.",
        "da5ce83f34700d7d502a": "Rugaš li mi se dok se ne mogu braniti, vezan za ovu željeznu kuglu?",
        "zephras:c1e1f421f543d3eae79a": "Kako te mogu osloboditi?"
