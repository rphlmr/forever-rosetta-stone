    "daDK": {
      "dialogue": {
        "29c1d198f892d0808259": "En af menneskene har nøglen til denne forbandede anordning. Eston, tror jeg, de kaldte ham.",
        "da5ce83f34700d7d502a": "Håner du mig, mens jeg ikke kan forsvare mig, bundet til denne jernkugle?",
        "zephras:c1e1f421f543d3eae79a": "Hvordan kan jeg befri dig?"
      },
      "name": "Drull",
      "translationMetadata": {
        "fields": {
          "dialogue.29c1d198f892d0808259": {
            "origin": "ai",
