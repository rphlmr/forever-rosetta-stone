    "esES": {
      "dialogue": {
        "29c1d198f892d0808259": "Uno de los humanos tiene la llave de este artilugio infernal. Creo haber escuchado que su nombre era Eston.",
        "da5ce83f34700d7d502a": "¿Te burlas de mí ahora que no puedo defenderme, atado a esta bola de hierro?",
        "zephras:c1e1f421f543d3eae79a": "¿Cómo puedo liberarte?"
      },
      "name": "Drull",
