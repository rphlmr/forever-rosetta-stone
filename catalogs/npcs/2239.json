    "plPL": {
      "dialogue": {
        "29c1d198f892d0808259": "Jeden z ludzi ma klucz do tego piekielnego ustrojstwa. Chyba mówili, że nazywa się Eston.",
        "da5ce83f34700d7d502a": "Drwisz ze mnie, kiedy nie mogę się bronić, przykuty do tej żelaznej kuli?",
        "zephras:c1e1f421f543d3eae79a": "Jak mogę cię uwolnić?"
