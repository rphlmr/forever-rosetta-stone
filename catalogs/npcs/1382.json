    "itIT": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Addestrami.",
        "6241e961b1cf46c87022": "Posso insegnarti a cucinare!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "c5dae1fe1c0ca06f1afe": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "fc6994972d1c9c197b34": "Wulan, a Shadowprey Village, può venderti il \"Ricettario dell'Esperto\". Ti servirà, se vuoi migliorarti."
      },
      "name": "Mudduk",
