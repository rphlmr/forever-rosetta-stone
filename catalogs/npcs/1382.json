    "svSE": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Träna mig.",
        "6241e961b1cf46c87022": "Jag kan lära dig att laga mat!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave i Gadgetzan är en mästare i kokkonst. Sök upp honom om du vill bli bättre.",
        "c5dae1fe1c0ca06f1afe": "Matlagning är en livslång sysselsättning, och jag ser att vi delar samma passion!",
        "fc6994972d1c9c197b34": "Wulan i Shadowprey Village kan sälja dig ”Expert Cookbook”. Du behöver den för att bli bättre."
      },
      "name": "Mudduk",
