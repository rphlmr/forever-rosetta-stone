    "ltLT": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Pamokyk mane.",
        "6241e961b1cf46c87022": "Galiu išmokyti tave gaminti maistą!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meno meistras.  Jei nori tobulėti, turėsi jį susirasti.",
        "c5dae1fe1c0ca06f1afe": "Maisto gaminimo mokomasi visą gyvenimą, ir matau, kad mus sieja ta pati aistra!",
        "fc6994972d1c9c197b34": "Wulan iš Shadowprey Village gali tau parduoti „Eksperto receptų knygą“.  Jos reikės, jei nori tobulėti."
      },
      "name": "Mudduk",
      "subName": "Aukščiausios klasės virėjas",
