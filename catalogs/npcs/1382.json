    "enUS": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Train me.",
        "6241e961b1cf46c87022": "I can teach you how to cook!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "c5dae1fe1c0ca06f1afe": "Cooking is a life long pursuit and I see we share the same passion!",
        "fc6994972d1c9c197b34": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself."
      },
      "name": "Mudduk",
      "subName": "Superior Cook",
