    "ptBR": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Treine-me.",
        "6241e961b1cf46c87022": "Eu posso ensinar você a cozinhar!",
        "b84c80aa18e1c1aad7bf": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "c5dae1fe1c0ca06f1afe": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "fc6994972d1c9c197b34": "Wulan, da Aldeia Pescassombra, pode lhe vender o \"Livro de Receitas do Perito\". Se você quiser se aperfeiçoar, terá de ler esse livro."
      },
      "name": "Mudduk",
      "subName": "Cozinheiro Superior",
