  "locales": {
    "csCZ": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Vycvičte mě.",
        "6241e961b1cf46c87022": "Mohu tě naučit vařit!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave z Gadgetzanu je mistr kuchařského umění. Chceš-li se zdokonalit, musíš ho vyhledat.",
        "c5dae1fe1c0ca06f1afe": "Vaření je celoživotní poslání a vidím, že sdílíme stejnou vášeň!",
        "fc6994972d1c9c197b34": "Wulan ve vesnici Shadowprey ti může prodat „Expertní kuchařku“. Budeš ji potřebovat k dalšímu zdokonalení."
      },
      "name": "Mudduk",
      "translationMetadata": {
