    "daDK": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Træn mig.",
        "6241e961b1cf46c87022": "Jeg kan lære dig at lave mad!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham for at blive bedre.",
        "c5dae1fe1c0ca06f1afe": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme passion!",
        "fc6994972d1c9c197b34": "Wulan i Shadowprey Village kan sælge dig „Expert Cookbook“. Du får brug for den for at blive bedre."
      },
      "name": "Mudduk",
      "translationMetadata": {
        "fields": {
