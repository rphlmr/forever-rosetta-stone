    "plPL": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Wyszkol mnie.",
        "6241e961b1cf46c87022": "Mogę cię nauczyć gotować!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Odnajdź go, jeśli chcesz się doskonalić.",
        "c5dae1fe1c0ca06f1afe": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!",
        "fc6994972d1c9c197b34": "Wulan z wioski Shadowprey sprzeda ci „Expert Cookbook”. Będziesz jej potrzebować do dalszej nauki."
      },
      "name": "Mudduk",
