    "deDE": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Bildet mich aus.",
        "6241e961b1cf46c87022": "Ich kann Euch das Kochen beibringen!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen.",
        "c5dae1fe1c0ca06f1afe": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "fc6994972d1c9c197b34": "Wulan in Shadowprey kann Euch das \"Expertenkochbuch\" verkaufen. Ihr werdet es brauchen, wenn Ihr Euch verbessern wollt."
      },
      "name": "Mudduk",
      "subName": "Überragender Koch",
