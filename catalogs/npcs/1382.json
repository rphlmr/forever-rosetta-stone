    "trTR": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Beni eğit.",
        "6241e961b1cf46c87022": "Sana yemek yapmayı öğretebilirim!",
        "b84c80aa18e1c1aad7bf": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarının ustasıdır. Kendini geliştirmek için onu bulmalısın.",
        "c5dae1fe1c0ca06f1afe": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "fc6994972d1c9c197b34": "Shadowprey Köyü’ndeki Wulan sana “Expert Cookbook” satabilir. Kendini geliştirmek için ona ihtiyacın olacak."
      },
      "name": "Mudduk",
