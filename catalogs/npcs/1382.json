    "hrHR": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Podučite me.",
        "6241e961b1cf46c87022": "Mogu te naučiti kuhati!",
        "b84c80aa18e1c1aad7bf": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Potraži ga želiš li napredovati.",
        "c5dae1fe1c0ca06f1afe": "Kuhanje je cjeloživotni poziv i vidim da dijelimo istu strast!",
        "fc6994972d1c9c197b34": "Wulan u selu Shadowprey može ti prodati „Expert Cookbook“. Trebat će ti za napredovanje."
      },
      "name": "Mudduk",
