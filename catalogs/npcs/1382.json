    "esES": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Entréname.",
        "6241e961b1cf46c87022": "Puedo enseñarte a cocinar.",
        "b84c80aa18e1c1aad7bf": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "c5dae1fe1c0ca06f1afe": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión.",
        "fc6994972d1c9c197b34": "Wulan, en la Aldea Cazasombras, puede venderte el \"Recetario para expertos\". Lo necesitarás si quieres mejorar."
      },
      "name": "Mudduk",
      "subName": "Cocinero superior",
