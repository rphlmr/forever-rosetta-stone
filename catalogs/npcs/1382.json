    "frFR": {
      "dialogue": {
        "2d7e5a6854af1decf000": "Entraînez-moi.",
        "6241e961b1cf46c87022": "Je peux vous apprendre à cuisiner !",
        "b84c80aa18e1c1aad7bf": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "c5dae1fe1c0ca06f1afe": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "fc6994972d1c9c197b34": "Wuland du village de Proie-de-l'Ombre peut vous vendre un livre de cuisine pour experts. Il vous faudra bien ça si vous voulez vous améliorer."
      },
      "name": "Mudduk",
      "subName": "Excellent cuisinier",
