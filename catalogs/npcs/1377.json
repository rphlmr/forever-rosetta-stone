    "esMX": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Conducir un tanque de vapor no es para cualquiera. Hace falta un agarre de hierro y nervios de acero... ¡por suerte tengo ambas cosas! ¿Y tú? ¿Tienes temple? ¿Quieres demostrármelo?",
        "14e53899a2a24d664119": "Entréname.",
        "3b835b580a97c2aeb0d5": "Quiero ver tus mercancías."
