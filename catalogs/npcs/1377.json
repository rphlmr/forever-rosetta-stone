    "ltLT": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Vairuoti garo tanką gali ne kiekvienas. Tam reikia geležinio gniaužto ir plieninių nervų... Laimė, turiu ir viena, ir kita! O kaip tu? Ar esi pakankamai tvirtas? Nori man tai įrodyti?",
        "14e53899a2a24d664119": "Išmokyk mane.",
        "3b835b580a97c2aeb0d5": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Pilotas Stonegear",
