    "daDK": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Det er ikke for alle at køre en damptank. Det kræver et jerngreb og nerver af stål... heldigvis har jeg begge dele! Hvad med dig? Har du modet? Vil du bevise det for mig?",
        "14e53899a2a24d664119": "Træn mig.",
        "3b835b580a97c2aeb0d5": "Jeg vil gerne se dine varer."
      },
      "name": "Pilot Stonegear",
      "translationMetadata": {
