    "esES": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Conducir un tanque de vapor no es para todo el mundo.  Se necesita un agarre de hierro y nervios de acero... ¡tengo suerte de tener ambas cosas!  ¿Y tú?  ¿Cómo está tu temple?  ¿Quieres demostrármelo?",
        "14e53899a2a24d664119": "Entréname.",
        "3b835b580a97c2aeb0d5": "Quiero ver tus mercancías."
      },
      "name": "Piloto Roscapiedra",
