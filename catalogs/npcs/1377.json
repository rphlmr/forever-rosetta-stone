    "ptBR": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Pilotar um tanque a vapor não é para qualquer um. É preciso ter mãos de ferro e nervos de aço... por sorte, tenho os dois! E você? Tem coragem? Quer provar para mim?",
        "14e53899a2a24d664119": "Treine-me.",
        "3b835b580a97c2aeb0d5": "Quero ver suas mercadorias."
      },
      "name": "Piloto Marchapedra",
