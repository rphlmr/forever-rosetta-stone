    "enUS": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Driving a Steam Tank isn't for everyone.  It takes an iron grip and nerves of steel...lucky I have both!  How about you?  How's your mettle?  Want to prove it to me?",
        "14e53899a2a24d664119": "Train me.",
        "3b835b580a97c2aeb0d5": "I want to browse your goods."
      },
      "name": "Pilot Stonegear",
