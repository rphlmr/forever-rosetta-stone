  "locales": {
    "csCZ": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Řídit parní tank není pro každého. Chce to železný stisk a ocelové nervy... naštěstí mám obojí! A co ty? Máš kuráž? Chceš mi to dokázat?",
        "14e53899a2a24d664119": "Vycvičte mě.",
        "3b835b580a97c2aeb0d5": "Chci si prohlédnout vaše zboží."
      },
      "name": "Pilot Stonegear",
      "translationMetadata": {
        "fields": {
