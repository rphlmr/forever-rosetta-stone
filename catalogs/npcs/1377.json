    "hrHR": {
      "dialogue": {
        "03eeca884ec7047bfa56": "Upravljanje parnim tenkom nije za svakoga. Potrebni su željezni stisak i čelični živci... srećom, imam oboje! A ti? Imaš li hrabrosti? Želiš li mi to dokazati?",
        "14e53899a2a24d664119": "Podučite me.",
        "3b835b580a97c2aeb0d5": "Želim pogledati vašu robu."
      },
      "name": "Pilot Stonegear",
