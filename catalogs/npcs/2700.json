    "enUS": {
      "dialogue": {
        "160f09c0abc46796954f": "I want to browse your goods.",
        "b3d8b0b9101f51ef13ac": "Train me.",
        "f2d6f57cb2656c38d337": "We at Refuge Pointe hold one of the few remaining patches of Stromgarde territory in the Arathi Highlands.  And we're losing ground...$B$BIf you have words for me, then I hope they are good tidings."
      },
