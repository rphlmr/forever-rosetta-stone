  "locales": {
    "csCZ": {
      "dialogue": {
        "160f09c0abc46796954f": "Chci si prohlédnout vaše zboží.",
        "b3d8b0b9101f51ef13ac": "Vycvičte mě.",
        "f2d6f57cb2656c38d337": "My v Refuge Pointe držíme jeden z posledních kousků území Stromgarde v Arathijské vysočině. A ztrácíme půdu...$B$B Jestli mi něco přinášíš, doufám, že jsou to dobré zprávy."
      },
      "name": "Kapitán Nials",
      "translationMetadata": {
        "fields": {
          "dialogue.160f09c0abc46796954f": {
