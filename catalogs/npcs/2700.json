    "daDK": {
      "dialogue": {
        "160f09c0abc46796954f": "Jeg vil gerne se dine varer.",
        "b3d8b0b9101f51ef13ac": "Træn mig.",
        "f2d6f57cb2656c38d337": "Vi ved Refuge Pointe holder et af de få tilbageværende stykker af Stromgardes territorium i Arathi-højlandet. Og vi mister terræn...$B$B Hvis du har noget at fortælle mig, håber jeg, det er godt nyt."
      },
      "name": "Kaptajn Nials",
      "translationMetadata": {
        "fields": {
