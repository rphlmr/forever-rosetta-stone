    "deDE": {
      "dialogue": {
        "160f09c0abc46796954f": "Ich möchte Eure Waren ansehen.",
        "b3d8b0b9101f51ef13ac": "Bildet mich aus.",
        "f2d6f57cb2656c38d337": "Wir in Refuge Pointe halten einen der wenigen verbliebenen Flecken Stromgarde-Territorium im Hochland von Arathi.  Und wir verlieren an Boden...\n\nWenn Ihr Worte für mich habt, dann hoffe ich, dass es gute Nachrichten sind."
      },
      "name": "Captain Nials",
      "translationMetadata": {
