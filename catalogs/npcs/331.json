  "locales": {
    "csCZ": {
      "dialogue": {
        "0539819d4a9b0c7d4952": "Vítej, $c. Poradím ti toto: na cestách světem se měj na pozoru před magií, neboť nezkušené popálí.",
        "154e32e91a57d3e22ce3": "Zdravím, mágu. Mám ti nabídnout hlubší vhled do světa magie?",
        "548407508ebb68a0f1fe": "Přísným přeškolováním jsem musel mnoho studentů zbavit všeho, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto také dražší. Přeješ si, abych tě zbavil talentů, které ses naučil?",
        "65934f592e2fc4b2b19a": "Mám zájem o výcvik mága.",
        "bcd9c518578ee404a5f2": "Mám zájem o výcvik mága."
      },
      "name": "Maginor Dumas",
      "translationMetadata": {
        "fields": {
