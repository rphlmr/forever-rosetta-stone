    "plPL": {
      "dialogue": {
        "0539819d4a9b0c7d4952": "Witaj, $c. Oto moja rada: podróżując po świecie, strzeż się magii, gdyż sparzy niewprawnych.",
        "154e32e91a57d3e22ce3": "Witaj, magu. Czy mam pogłębić twoją wiedzę o świecie magii?",
        "548407508ebb68a0f1fe": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, aby móc uczyć ich od nowa. Ta usługa staje się za każdym razem trudniejsza, a przez to droższa. Czy chcesz, abym oduczył cię poznanych talentów?",
        "65934f592e2fc4b2b19a": "Interesuje mnie szkolenie maga.",
        "bcd9c518578ee404a5f2": "Interesuje mnie szkolenie maga."
      },
      "name": "Maginor Dumas",
