    "ptBR": {
      "dialogue": {
        "75988517342964e4220a": "Quero ver suas mercadorias.",
        "80d10f39d73a10d28b88": "Treine-me.",
        "963fbe4248c0de6c18ca": "Às vezes acho que há uma grande nuvem cinzenta no céu, despejando azar sobre nós. Primeiro, fomos expulsos de nossas terras, e agora nem conseguimos sair de Westfall. Está tudo uma bagunça. Alguém precisa fazer alguma coisa."
      },
      "name": "Vera Taturana",
      "translationMetadata": {
