    "ltLT": {
      "dialogue": {
        "75988517342964e4220a": "Noriu apžiūrėti jūsų prekes.",
        "80d10f39d73a10d28b88": "Išmokykite mane.",
        "963fbe4248c0de6c18ca": "Kartais man atrodo, kad danguje kabo didelis pilkas debesis, kuris beria mums nelaimes.  Pirmiausia mus išvijo iš mūsų žemių, o dabar net iš Westfall negalime ištrūkti.  Viskas sujaukta.  Reikia kažko imtis."
      },
      "name": "Verna Furlbrow",
