    "deDE": {
      "dialogue": {
        "75988517342964e4220a": "Ich möchte Eure Waren ansehen.",
        "80d10f39d73a10d28b88": "Bildet mich aus.",
        "963fbe4248c0de6c18ca": "Manchmal denke ich, eine große dunkle Wolke schwebt über uns, aus der Unglück auf uns herabregnet. Erst werden wir von unserem Land vertrieben und jetzt kommen wir noch nicht einmal aus Westfall weg. Alles liegt im Argen. Es muss etwas geschehen."
      },
      "name": "Verna Furlbrow",
      "translationMetadata": {
        "fields": {
          "dialogue.75988517342964e4220a": {
            "origin": "ai",
