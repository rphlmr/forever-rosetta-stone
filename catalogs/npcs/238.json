    },
    "daDK": {
      "dialogue": {
        "75988517342964e4220a": "Jeg vil gerne se dine varer.",
        "80d10f39d73a10d28b88": "Træn mig.",
        "963fbe4248c0de6c18ca": "Nogle gange tror jeg, der hænger en stor grå sky over os og lader uheld regne ned. Først blev vi drevet fra vores jord, og nu kan vi ikke engang komme væk fra Westfall. Alt er noget rod. Der må gøres noget."
      },
      "name": "Verna Furlbrow",
      "translationMetadata": {
        "fields": {
          "dialogue.75988517342964e4220a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
