  "locales": {
    "csCZ": {
      "dialogue": {
        "75988517342964e4220a": "Chci si prohlédnout vaše zboží.",
        "80d10f39d73a10d28b88": "Vycvičte mě.",
        "963fbe4248c0de6c18ca": "Někdy mám pocit, že nad námi visí velký šedý mrak a prší na nás smůlu. Nejdřív nás vyhnali z naší půdy a teď se ani nemůžeme dostat ze Westfallu. Všechno je vzhůru nohama. Musí se s tím něco udělat."
      },
      "name": "Verna Furlbrow",
      "translationMetadata": {
        "fields": {
