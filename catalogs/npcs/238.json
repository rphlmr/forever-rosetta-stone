    "enUS": {
      "dialogue": {
        "75988517342964e4220a": "I want to browse your goods.",
        "80d10f39d73a10d28b88": "Train me.",
        "963fbe4248c0de6c18ca": "Sometimes I think there's a big gray cloud in the sky, just raining down bad luck upon us.  First, we're driven off our land, and now we can't even get out of Westfall.  Everything's a mess.  Something needs to be done."
      },
      "name": "Verna Furlbrow",
      "translationMetadata": {
