    "itIT": {
      "dialogue": {
        "75988517342964e4220a": "Vorrei vedere la tua merce.",
        "80d10f39d73a10d28b88": "Addestrami.",
        "963fbe4248c0de6c18ca": "A volte penso che in cielo ci sia un nuvolone grigio che non fa che rovesciarci addosso sfortuna. Prima ci cacciano dalla nostra terra, e adesso non riusciamo nemmeno ad andarcene da Westfall. È tutto un disastro. Bisogna fare qualcosa."
      },
      "name": "Verna Furlbrow",
