    "esES": {
      "dialogue": {
        "75988517342964e4220a": "Quiero ver tus mercancías.",
        "80d10f39d73a10d28b88": "Entréname.",
        "963fbe4248c0de6c18ca": "A veces pienso que hay una gran nube gris en el cielo, lloviendo mala suerte sobre nosotros.  Primero, nos expulsan de nuestra tierra, y ahora ni siquiera podemos salir de Westfall.  Todo es un desastre.  Hay que hacer algo."
      },
      "name": "Verna Cejade",
      "translationMetadata": {
