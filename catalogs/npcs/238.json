    "hrHR": {
      "dialogue": {
        "75988517342964e4220a": "Želim pogledati vašu robu.",
        "80d10f39d73a10d28b88": "Podučite me.",
        "963fbe4248c0de6c18ca": "Ponekad mislim da je na nebu velik sivi oblak koji na nas izlijeva nesreću. Najprije su nas otjerali s naše zemlje, a sada ne možemo ni napustiti Westfall. Sve je u rasulu. Nešto se mora poduzeti."
      },
      "name": "Verna Furlbrow",
