    "hrHR": {
      "dialogue": {
        "5d64d6a1db88a5b4e048": "Prodajem samo najbolju čarobnu opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu.",
        "7ef9c5f75b37e058b1d7": "Želim pogledati vašu robu.",
        "8fe4e31e633404d7a39b": "Nakon pada Dalarana i uništenja Quel’Thalasa teško je nabaviti takvu robu. Ali Lucan Cordell i neki drugi naši obrtnici dobro obavljaju posao ispunjavajući narudžbe kvalitetnom robom."
      },
      "name": "Owen Vaughn",
      "translationMetadata": {
