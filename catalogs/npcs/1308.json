  "locales": {
    "csCZ": {
      "dialogue": {
        "5d64d6a1db88a5b4e048": "Prodávám jen to nejlepší magické vybavení vyrobené řemeslníky a mágy zde ve Stormwindu.",
        "7ef9c5f75b37e058b1d7": "Chci si prohlédnout vaše zboží.",
        "8fe4e31e633404d7a39b": "Od pádu Dalaranu a zničení Quel’Thalasu se takové zboží shání těžko. Lucan Cordell a další naši řemeslníci však odvádějí skvělou práci a plní naše objednávky kvalitním zbožím."
      },
      "name": "Owen Vaughn",
      "translationMetadata": {
        "fields": {
          "dialogue.5d64d6a1db88a5b4e048": {
