    },
    "daDK": {
      "dialogue": {
        "5d64d6a1db88a5b4e048": "Jeg sælger kun det fineste magiske udstyr, fremstillet af håndværkere og magikere her i Stormwind.",
        "7ef9c5f75b37e058b1d7": "Jeg vil gerne se dine varer.",
        "8fe4e31e633404d7a39b": "Siden Dalarans fald og ødelæggelsen af Quel’Thalas har den slags varer været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere har gjort et fint arbejde med at levere kvalitetsvarer til vores bestillinger."
      },
      "name": "Owen Vaughn",
      "translationMetadata": {
        "fields": {
          "dialogue.5d64d6a1db88a5b4e048": {
