    "ltLT": {
      "dialogue": {
        "5d64d6a1db88a5b4e048": "Parduodu tik geriausią magišką įrangą, pagamintą čia, Stormwind mieste, amatininkų ir magų.",
        "7ef9c5f75b37e058b1d7": "Norėčiau apžiūrėti jūsų prekes.",
        "8fe4e31e633404d7a39b": "Nuo Dalarano žlugimo ir Quel'Thalas sunaikinimo tokių prekių sunku gauti. Tačiau Lucan Cordell ir kai kurie kiti mūsų prekybininkai puikiai vykdo užsakymus, tiekdami kokybiškas prekes."
      },
      "name": "Owen Vaughn",
      "subName": "Reagentų pardavėjas",
