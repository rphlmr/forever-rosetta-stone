    "enUS": {
      "dialogue": {
        "5d64d6a1db88a5b4e048": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "7ef9c5f75b37e058b1d7": "I want to browse your goods.",
        "8fe4e31e633404d7a39b": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise."
      },
      "name": "Owen Vaughn",
      "subName": "Reagent Vendor",
      "translationMetadata": {
        "fields": {
