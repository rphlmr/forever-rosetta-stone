    "daDK": {
      "dialogue": {
        "692327a25cf3c08d5427": "Jeg har brug for krigertræning.",
        "6a063f23b8f074dda92a": "Jeg træner ikke din slags, $c. Find din egen træner, før du gør mig vred.",
        "da78102bd6a4fea1469f": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?",
        "f0d1c126a908dd1a6bd2": "Er du her for at træne? Eller er du bare kommet for at spilde en krigers tid?"
      },
      "name": "Grezz Ragefist",
      "translationMetadata": {
        "fields": {
          "dialogue.692327a25cf3c08d5427": {
