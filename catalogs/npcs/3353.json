  "locales": {
    "csCZ": {
      "dialogue": {
        "692327a25cf3c08d5427": "Potřebuji výcvik válečníka.",
        "6a063f23b8f074dda92a": "Tvůj druh necvičím, $c. Najdi si vlastního učitele, než mě rozzlobíš.",
        "da78102bd6a4fea1469f": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl vyučit znovu. Tuto službu je pokaždé těžší provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvým talentům?",
        "f0d1c126a908dd1a6bd2": "Jsi tu kvůli výcviku? Nebo jen marníš čas válečníka?"
      },
      "name": "Grezz Ragefist",
      "translationMetadata": {
        "fields": {
          "dialogue.692327a25cf3c08d5427": {
