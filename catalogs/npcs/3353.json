    "plPL": {
      "dialogue": {
        "692327a25cf3c08d5427": "Potrzebuję szkolenia wojownika.",
        "6a063f23b8f074dda92a": "Nie szkolę takich jak ty, $c. Znajdź własnego nauczyciela, zanim mnie rozgniewasz.",
        "da78102bd6a4fea1469f": "Dzięki rygorystycznemu przekwalifikowaniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc uczyć ich od nowa. Z każdym razem ta usługa staje się trudniejsza, a przez to droższa. Czy chcesz, bym pomógł ci zapomnieć poznane talenty?",
        "f0d1c126a908dd1a6bd2": "Przychodzisz na szkolenie? A może tylko marnujesz czas wojownika?"
      },
      "name": "Grezz Ragefist",
      "translationMetadata": {
