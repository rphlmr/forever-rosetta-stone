    "hrHR": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Podučite me.",
        "4fc050857680f08c59b9": "Vrlo dobro, neka tvoje krojačko putovanje započne.",
        "7e07a6e01bb0e7fbbff5": "Život je poput pažljivo istkane tapiserije.",
        "df65aafe2f66e9a26e18": "Hm... ono što trebaš naučiti malo nadilazi moje znanje. Razgovaraj sa Sellandusom u Larson's Clothiersu, malo uz put desno. On me naučio svemu što znam!"
      },
      "name": "Lawrence Schneider",
