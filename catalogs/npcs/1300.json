    "esES": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Entréname.",
        "4fc050857680f08c59b9": "Muy bien, que comience tu viaje al mundo de la sastrería.",
        "7e07a6e01bb0e7fbbff5": "La vida es como un tapiz delicadamente tejido.",
        "df65aafe2f66e9a26e18": "Mmm... Las cosas que necesitas aprender me sobrepasan. Ve a hablar con Sellandus en la Sastrería Larson, en la parte de arriba del camino a la derecha. ¡Él me enseñó todo lo que sé!"
      },
      "name": "Lawrence Schneider",
      "subName": "Oficial de sastrería",
