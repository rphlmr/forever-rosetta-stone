    "enUS": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Train me.",
        "4fc050857680f08c59b9": "Very well, let your journey of tailoring begin.",
        "7e07a6e01bb0e7fbbff5": "Life is like a carefully woven tapestry.",
        "df65aafe2f66e9a26e18": "Hmm... the things you need to learn are a little above my head. Have a talk with Sellandus over at Larson's Clothiers just up the path to the right. He taught me everything I know!"
      },
      "name": "Lawrence Schneider",
      "subName": "Journeyman Tailor",
      "translationMetadata": {
