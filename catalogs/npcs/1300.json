    "daDK": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Træn mig.",
        "4fc050857680f08c59b9": "Godt, lad din rejse som skrædder begynde.",
        "7e07a6e01bb0e7fbbff5": "Livet er som et omhyggeligt vævet billedtæppe.",
        "df65aafe2f66e9a26e18": "Hmm... det, du skal lære, ligger lidt over mit niveau. Tal med Sellandus hos Larson's Clothiers lidt længere oppe ad stien til højre. Han har lært mig alt, hvad jeg kan!"
      },
      "name": "Lawrence Schneider",
      "translationMetadata": {
        "fields": {
