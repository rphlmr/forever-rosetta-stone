    "plPL": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Wyszkol mnie.",
        "4fc050857680f08c59b9": "Dobrze, niech rozpocznie się twoja przygoda z krawiectwem.",
        "7e07a6e01bb0e7fbbff5": "Życie jest jak starannie utkany gobelin.",
        "df65aafe2f66e9a26e18": "Hmm... to, czego musisz się nauczyć, nieco przekracza moje umiejętności. Porozmawiaj z Sellandusem w Larson's Clothiers, kawałek ścieżką na prawo. Nauczył mnie wszystkiego, co umiem!"
      },
      "name": "Lawrence Schneider",
