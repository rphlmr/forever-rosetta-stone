  "locales": {
    "csCZ": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Vycvičte mě.",
        "4fc050857680f08c59b9": "Dobrá, nechť začne tvá cesta krejčovstvím.",
        "7e07a6e01bb0e7fbbff5": "Život je jako pečlivě utkaná tapiserie.",
        "df65aafe2f66e9a26e18": "Hmm... to, co se potřebuješ naučit, už trochu přesahuje mé znalosti. Promluv si se Sellandem v Larsonově oděvnictví, kousek po cestě vpravo. Naučil mě všechno, co umím!"
      },
      "name": "Lawrence Schneider",
      "translationMetadata": {
        "fields": {
