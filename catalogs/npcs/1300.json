    "ptBR": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Treine-me.",
        "4fc050857680f08c59b9": "Muito bem, que se inicie sua jornada pela alfaiataria!",
        "7e07a6e01bb0e7fbbff5": "A vida é como uma tapeçaria minuciosa.",
        "df65aafe2f66e9a26e18": "Hum... as coisas que você precisa aprender estão um pouco além da minha capacidade. Vá conversar com Sellandus na Alfaiataria Galante, logo acima no caminho à direita. Ele me ensinou tudo o que sei!"
      },
      "name": "Lawrence Armarinho",
      "subName": "Alfaiate Profissional",
