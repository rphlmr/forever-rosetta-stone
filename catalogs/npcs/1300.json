    "frFR": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Entraînez-moi.",
        "4fc050857680f08c59b9": "Très bien ! Que commence votre voyage dans l'art du Tailleur !",
        "7e07a6e01bb0e7fbbff5": "La vie ressemble à une tapisserie finement brodée.",
        "df65aafe2f66e9a26e18": "Hmm... Les choses que vous avez besoin d'apprendre me dépassent quelque peu. Parlez à Sellandus, des Drapiers Larson, un peu plus loin sur la droite. Il m'a enseigné tout ce que je sais !"
      },
      "name": "Lawrence Schneider",
      "subName": "Tailleur - Compagnon",
