    "svSE": {
      "dialogue": {
        "025ba0faa5e0b26de707": "Träna mig.",
        "4fc050857680f08c59b9": "Mycket väl, låt din resa inom skrädderiet börja.",
        "7e07a6e01bb0e7fbbff5": "Livet är som en omsorgsfullt vävd gobeläng.",
        "df65aafe2f66e9a26e18": "Hmm... det du behöver lära dig övergår mina kunskaper en aning. Tala med Sellandus på Larson's Clothiers, en bit upp längs stigen till höger. Han lärde mig allt jag kan!"
      },
      "name": "Lawrence Schneider",
      "translationMetadata": {
