    "hrHR": {
      "dialogue": {
        "451875a1c893283bea34": "Podučite me.",
        "45285de0b09c16ec0f3e": "Pozdrav, $C. Teška su vremena, prijatelju, jer naš je grad pod opsadom! Orci Blackrocka napadaju iz utvrde Stonewatch, Shadowhideovi prijete s tornja Ilgalar, a čopor gnolla iz Redridgea prikuplja snage. Nadam se da nisi ovdje na odmoru...",
        "b2eb67d1fd02a211350f": "Želim pogledati vašu robu."
      },
      "name": "Stražar Parker",
      "translationMetadata": {
        "fields": {
