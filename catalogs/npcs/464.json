    "trTR": {
      "dialogue": {
        "451875a1c893283bea34": "Beni eğit.",
        "45285de0b09c16ec0f3e": "Selam, $C. Kötü zamanlardan geçiyoruz dostum, kasabamız kuşatma altında! Blackrock orkları Stonewatch Kalesi'nden saldırıyor, Shadowhide'lar Ilgalar Kulesi'nden tehdit ediyor ve Redridge gnoll sürüsü güç topluyor. Umarım buraya tatile gelmemişsindir...",
        "b2eb67d1fd02a211350f": "Mallarına bakmak istiyorum."
      },
      "name": "Muhafız Parker",
      "translationMetadata": {
        "fields": {
