    "esMX": {
      "dialogue": {
        "451875a1c893283bea34": "Entréname.",
        "45285de0b09c16ec0f3e": "Saludos, $C. Son tiempos difíciles, amigo, ¡nuestra ciudad está sitiada! Los orcos Roca Negra atacan desde el Fuerte Crestagrana, los Pellejo Sombrío acechan sobre la Torre de Ilgalar y la manada de gnolls de Crestagrana cobra fuerza. Espero que no estés aquí de vacaciones...",
        "b2eb67d1fd02a211350f": "Quiero ver tus mercancías."
      },
      "name": "Guardia Parker",
      "translationMetadata": {
