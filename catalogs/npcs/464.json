  "locales": {
    "csCZ": {
      "dialogue": {
        "451875a1c893283bea34": "Vycvičte mě.",
        "45285de0b09c16ec0f3e": "Zdravím, $C. Nastaly zlé časy, příteli, naše město je v obležení! Orkové z Blackrocku útočí z pevnosti Stonewatch, Shadowhideové se stahují kolem věže Ilgalar a gnollská smečka z Redridge nabírá síly. Doufám, že tu nejsi na dovolené...",
        "b2eb67d1fd02a211350f": "Chci si prohlédnout vaše zboží."
      },
      "name": "Strážný Parker",
      "translationMetadata": {
        "fields": {
          "dialogue.451875a1c893283bea34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
