    "plPL": {
      "dialogue": {
        "451875a1c893283bea34": "Wyszkol mnie.",
        "45285de0b09c16ec0f3e": "Witaj, $C. Nastały ciężkie czasy, przyjacielu, nasze miasto jest oblężone! Orkowie Blackrock atakują z twierdzy Stonewatch, Shadowhide zagrażają z wieży Ilgalar, a stado gnolli z Redridge rośnie w siłę. Mam nadzieję, że nie przybywasz tu na urlop...",
        "b2eb67d1fd02a211350f": "Chcę przejrzeć twoje towary."
      },
      "name": "Strażnik Parker",
      "translationMetadata": {
        "fields": {
