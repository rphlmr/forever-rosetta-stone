    "enUS": {
      "dialogue": {
        "451875a1c893283bea34": "Train me.",
        "45285de0b09c16ec0f3e": "Hail, $C.  Ill times these are, my friend, for our town is besieged!  The Blackrock Orcs attack from Stonewatch Keep, the Shadowhides loom over the Tower of Ilgalar, and the Redridge Gnoll Pack gathers strength.  I hope you're not here for a holiday...",
        "b2eb67d1fd02a211350f": "I want to browse your goods."
      },
      "name": "Guard Parker",
      "translationMetadata": {
        "fields": {
