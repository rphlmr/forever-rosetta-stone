            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "451875a1c893283bea34": "Træn mig.",
        "45285de0b09c16ec0f3e": "Vær hilset, $C. Det er onde tider, min ven, for vores by er belejret! Blackrock-orkerne angriber fra Stonewatch Keep, Shadowhides truer fra Ilgalars tårn, og Redridge-gnollflokken samler kræfter. Jeg håber ikke, du er her på ferie...",
        "b2eb67d1fd02a211350f": "Jeg vil gerne se dine varer."
      },
      "name": "Vagt Parker",
      "translationMetadata": {
        "fields": {
          "dialogue.451875a1c893283bea34": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
