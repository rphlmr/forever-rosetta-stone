    "esES": {
      "dialogue": {
        "451875a1c893283bea34": "Entréname.",
        "45285de0b09c16ec0f3e": "Salve, $C.  Corren malos tiempos, amigo mío, pues nuestra ciudad está sitiada.  Los Orcos de Blackrock atacan desde la Fortaleza de Stonewatch, los Shadowhides se ciernen sobre la Torre de Ilgalar, y la Manada de Gnolls de Redridge reúne fuerzas.  Espero que no estés aquí de vacaciones...",
        "b2eb67d1fd02a211350f": "Quiero ver tus mercancías."
      },
      "name": "Guardia Parker",
      "translationMetadata": {
        "fields": {
