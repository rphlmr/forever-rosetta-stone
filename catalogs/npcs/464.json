    "svSE": {
      "dialogue": {
        "451875a1c893283bea34": "Träna mig.",
        "45285de0b09c16ec0f3e": "Var hälsad, $C. Det är svåra tider, min vän, för vår stad är belägrad! Blackrock-orcherna anfaller från Stonewatch Keep, Shadowhides hotar från Ilgalars torn och gnollflocken i Redridge samlar styrka. Jag hoppas att du inte är här på semester...",
        "b2eb67d1fd02a211350f": "Jag vill se dina varor."
      },
      "name": "Vakt Parker",
      "translationMetadata": {
