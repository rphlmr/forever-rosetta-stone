    "hrHR": {
      "dialogue": {
        "48104feb98d090e79225": "Želim pogledati vašu robu.",
        "4a22add2a0298a02cc26": "Pozdrav, putniče. Vid me možda slabo služi, ali korake klase $c mogu osjetiti izdaleka. Godinama sam ponosno branio Stormwind, ali kad me vid izdao, morao sam se povući.",
        "6e760fe462cbf6e326e7": "Podučite me."
      },
      "name": "Maršal Haggard",
