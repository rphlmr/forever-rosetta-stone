    "esES": {
      "dialogue": {
        "48104feb98d090e79225": "Quiero ver tus mercancías.",
        "4a22add2a0298a02cc26": "Salve, viajero.  Mi vista puede ser pobre pero puedo sentir los pasos de un $c a una milla de distancia.  Durante años defendí Stormwind con orgullo, pero cuando me fallaron los ojos, me vi obligado a retirarme.",
        "6e760fe462cbf6e326e7": "Entréname."
      },
      "name": "Alguacil Haggard",
