    "ptBR": {
      "dialogue": {
        "48104feb98d090e79225": "Quero ver suas mercadorias.",
        "4a22add2a0298a02cc26": "Saudações, viajante. Minha visão pode estar ruim, mas reconheço os passos de um $c de longe. Por anos defendi Ventobravo com orgulho, mas quando minha visão falhou, fui obrigado a me aposentar.",
        "6e760fe462cbf6e326e7": "Treine-me."
      },
      "name": "Delegado Fadigas",
