    "daDK": {
      "dialogue": {
        "48104feb98d090e79225": "Jeg vil gerne se dine varer.",
        "4a22add2a0298a02cc26": "Vær hilset, rejsende. Mit syn er måske dårligt, men jeg kan mærke en $c på skridtene på lang afstand. I årevis forsvarede jeg Stormwind med stolthed, men da mit syn svigtede, måtte jeg trække mig tilbage.",
        "6e760fe462cbf6e326e7": "Træn mig."
      },
      "name": "Marskal Haggard",
      "translationMetadata": {
        "fields": {
          "dialogue.48104feb98d090e79225": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
