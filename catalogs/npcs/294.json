    "esMX": {
      "dialogue": {
        "48104feb98d090e79225": "Quiero ver tus mercancías.",
        "4a22add2a0298a02cc26": "Saludos, viajero. Puede que mi vista sea mala, pero puedo reconocer los pasos de un $c a kilómetros de distancia. Durante años defendí Ventormenta con orgullo, pero cuando me falló la vista, tuve que retirarme.",
        "6e760fe462cbf6e326e7": "Entréname."
      },
      "name": "Mariscal Haggard",
