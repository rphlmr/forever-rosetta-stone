  "locales": {
    "csCZ": {
      "dialogue": {
        "48104feb98d090e79225": "Chci si prohlédnout vaše zboží.",
        "4a22add2a0298a02cc26": "Buď zdráv, poutníku. Můj zrak už není nejlepší, ale kroky $c poznám na míli daleko. Po léta jsem hrdě bránil Stormwind, ale když mi oči přestaly sloužit, musel jsem odejít do výslužby.",
        "6e760fe462cbf6e326e7": "Vycvičte mě."
      },
      "name": "Maršál Haggard",
      "translationMetadata": {
        "fields": {
