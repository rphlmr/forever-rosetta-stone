    "plPL": {
      "dialogue": {
        "48104feb98d090e79225": "Chcę przejrzeć twoje towary.",
        "4a22add2a0298a02cc26": "Witaj, wędrowcze. Może i słabo widzę, ale kroki klasy $c rozpoznam z daleka. Przez lata dumnie broniłem Stormwind, lecz gdy wzrok mnie zawiódł, musiałem odejść ze służby.",
        "6e760fe462cbf6e326e7": "Wyszkol mnie."
      },
      "name": "Marszałek Haggard",
