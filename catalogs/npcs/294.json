    "svSE": {
      "dialogue": {
        "48104feb98d090e79225": "Jag vill se dina varor.",
        "4a22add2a0298a02cc26": "Var hälsad, resenär. Min syn är kanske dålig, men jag känner igen stegen från en $c på långt håll. I åratal försvarade jag Stormwind med stolthet, men när synen svek mig tvingades jag dra mig tillbaka.",
        "6e760fe462cbf6e326e7": "Träna mig."
      },
      "name": "Marskalk Haggard",
      "translationMetadata": {
