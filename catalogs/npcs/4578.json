    },
    "deDE": {
      "dialogue": {
        "6838ad4f47711cdb9df5": "Zwischen dem Licht und dem Dunkel liegen Schatten... und diese Schatten verfügen über Kräfte, wie Ihr sie noch nicht gesehen habt.",
        "e57df05349d81d97ae94": "Bildet mich aus."
      },
      "name": "Josephine Lister",
      "subName": "Schattengewebeschneidermeisterin",
