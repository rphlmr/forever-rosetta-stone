    "daDK": {
      "dialogue": {
        "6838ad4f47711cdb9df5": "Mellem lyset og mørket findes skyggen... og de skygger har kræfter, du endnu ikke har set.",
        "e57df05349d81d97ae94": "Træn mig."
      },
      "name": "Josephine Lister",
      "translationMetadata": {
        "fields": {
