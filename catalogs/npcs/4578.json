  "locales": {
    "csCZ": {
      "dialogue": {
        "6838ad4f47711cdb9df5": "Mezi světlem a temnotou leží stín... a tyto stíny mají moc, kterou dosud neznáš.",
        "e57df05349d81d97ae94": "Vycvičte mě."
      },
      "name": "Josephine Lister",
      "translationMetadata": {
        "fields": {
