    },
    "daDK": {
      "dialogue": {
        "c12faf202f8a28dca898": "Det er farlige tider, eventyrer. Træd varsomt.",
        "da321dfbb291914913ea": "Har du brug for en illusion?$B$BSkulle din illusion svigte under din færd, så vend tilbage til mig, og jeg vil genoprette forklædningen.$B$BSkulle dit forehavende mislykkes, så giv ikke op! Vend tilbage til mig. Jeg vil hjælpe dig, indtil du har nået dine mål."
      },
      "name": "Myranda heksen",
      "translationMetadata": {
        "fields": {
          "dialogue.c12faf202f8a28dca898": {
