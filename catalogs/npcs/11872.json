    "svSE": {
      "dialogue": {
        "c12faf202f8a28dca898": "Det är farliga tider, äventyrare. Gå varsamt fram.",
        "da321dfbb291914913ea": "Behöver du en illusion?$B$BOm din illusion sviktar under uppdraget, återvänd till mig så ger jag dig förklädnaden på nytt.$B$BOm du misslyckas, ge inte upp! Återvänd till mig. Jag ska hjälpa dig tills du har nått dina mål."
      },
      "name": "Myranda Häxan",
