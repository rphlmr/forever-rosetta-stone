      }
    },
    "plPL": {
      "dialogue": {
        "c12faf202f8a28dca898": "Nastały niebezpieczne czasy, poszukiwaczu przygód. Stąpaj ostrożnie.",
        "da321dfbb291914913ea": "Potrzebujesz iluzji?$B$BJeśli iluzja osłabnie podczas wyprawy, wróć do mnie, a ponownie nadam ci tę postać.$B$BJeśli twoje wysiłki zawiodą, nie poddawaj się! Wróć do mnie. Będę ci pomagać, aż osiągniesz swoje cele."
      },
      "name": "Myranda Wiedźma",
      "translationMetadata": {
