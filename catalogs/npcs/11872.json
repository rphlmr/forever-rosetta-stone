  "locales": {
    "csCZ": {
      "dialogue": {
        "c12faf202f8a28dca898": "Nastaly nebezpečné časy, dobrodruhu. Kráčej opatrně.",
        "da321dfbb291914913ea": "Potřebuješ iluzi?$B$BPokud tvá iluze během výpravy zeslábne, vrať se ke mně a já ti převlek obnovím.$B$BPokud při svém snažení selžeš, nevzdávej se! Vrať se ke mně. Budu ti pomáhat, dokud nesplníš své cíle."
      },
      "name": "Myranda Ježibaba",
      "translationMetadata": {
        "fields": {
          "dialogue.c12faf202f8a28dca898": {
