    "enUS": {
      "dialogue": {
        "c12faf202f8a28dca898": "These are dangerous times, adventurer. Walk lightly.",
        "da321dfbb291914913ea": "Do you require an illusion?$B$BShould your illusion falter in the midst of your quest, return to me and I shall reapply the guise.$B$BShould you fail in your endeavors, do not give up! Return to me. I shall assist you until you have completed your objectives."
      },
      "name": "Myranda the Hag",
      "translationMetadata": {
        "fields": {
