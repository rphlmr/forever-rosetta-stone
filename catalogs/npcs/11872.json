    },
    "ltLT": {
      "dialogue": {
        "c12faf202f8a28dca898": "Pavojingi laikai, nuotykių ieškotojau. Būk atsargus.",
        "da321dfbb291914913ea": "Ar tau reikia iliuzijos?$B$BJei keliaujant iliuzija išsisklaidys, grįžk pas mane ir vėl tave užmaskuosiu.$B$BJei tau nepasiseks, nepasiduok! Grįžk pas mane. Padėsiu tau, kol pasieksi savo tikslus."
      },
      "name": "Ragana Myranda",
      "translationMetadata": {
        "fields": {
          "dialogue.c12faf202f8a28dca898": {
