    "hrHR": {
      "dialogue": {
        "c12faf202f8a28dca898": "Opasna su vremena, pustolove. Koračaj oprezno.",
        "da321dfbb291914913ea": "Trebaš li iluziju?$B$BAko tvoja iluzija oslabi tijekom potrage, vrati mi se i ponovno ću ti dati prerušavanje.$B$BAko ne uspiješ, ne odustaj! Vrati mi se. Pomagat ću ti dok ne ostvariš svoje ciljeve."
      },
      "name": "Vještica Myranda",
      "translationMetadata": {
