    "enUS": {
      "dialogue": {
        "a0e26b7a61626a4d1e73": "Ehh? You look a little too new to be doing business with me.\n\nCome back once you're a bit more familiar with how they do things around here. Trust me."
      },
      "name": "Kurvelk Shadowhoof",
      "subName": "Uncertified Scribe",
