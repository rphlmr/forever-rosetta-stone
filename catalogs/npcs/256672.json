    "daDK": {
      "dialogue": {
        "a0e26b7a61626a4d1e73": "Hva? Du ser lidt for ny ud til at handle med mig.\n\nKom tilbage, når du kender forholdene her lidt bedre. Tro mig."
      },
      "name": "Kurvelk Shadowhoof",
      "translationMetadata": {
        "fields": {
