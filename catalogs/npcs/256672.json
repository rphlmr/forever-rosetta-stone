    },
    "deDE": {
      "dialogue": {
        "a0e26b7a61626a4d1e73": "Wie bitte? Ihr seht etwas zu unerfahren aus, um mit mir Geschäfte zu machen.\n\nKommt wieder, wenn Ihr besser wisst, wie die Dinge hier laufen. Vertraut mir."
      },
      "name": "Kurvelk Shadowhoof",
      "subName": "Uncertified Scribe",
      "translationMetadata": {
        "fields": {
