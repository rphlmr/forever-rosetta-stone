    "trTR": {
      "dialogue": {
        "a0e26b7a61626a4d1e73": "Ha? Benimle iş yapmak için biraz fazla acemi görünüyorsun.\n\nBuralarda işlerin nasıl yürüdüğünü biraz daha öğrenince geri gel. İnan bana."
      },
      "name": "Kurvelk Shadowhoof",
      "translationMetadata": {
        "fields": {
