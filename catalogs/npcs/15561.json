    "hrHR": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Sada je vrijeme kad je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kad se drevni bude.",
        "08a6279c4455144fc9d7": "Starješina Graveborn boravi blizu Brilla u Tirisfal Gladesu.",
        "0cec4db6b432303b11c0": "Starješina Highpeak bdije nad Hinterlandsom s brda blizu njegova središta.",
        "126cecee1bcae910ffd6": "Starješinu Moonstrikea možeš pronaći u Scholomanceu u Western Plaguelandsu."
      },
      "name": "Starješina Obsidian",
