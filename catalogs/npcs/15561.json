    "plPL": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Nadszedł czas, gdy rok jest nowy, a księżyc jasno świeci.$B$BTo nasz czas... gdy pradawni się budzą.",
        "08a6279c4455144fc9d7": "Starszy Graveborn przebywa niedaleko Brill na Polanach Tirisfal.",
        "0cec4db6b432303b11c0": "Starszy Highpeak czuwa nad Hinterlands ze wzgórza w pobliżu centrum krainy.",
        "126cecee1bcae910ffd6": "Starszego Moonstrike'a można znaleźć w Scholomance na Zachodnich Ziemiach Plagi."
      },
      "name": "Starszy Obsidian",
