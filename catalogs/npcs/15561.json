    "trTR": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Şimdi yılın yeni olduğu ve ayın parlakça ışıldadığı zaman.$B$BBu bizim zamanımız... kadimlerin uyandığı zaman.",
        "08a6279c4455144fc9d7": "Yaşlı Graveborn, Tirisfal Glades'teki Brill yakınlarında vakit geçirir.",
        "0cec4db6b432303b11c0": "Yaşlı Highpeak, Hinterlands'in merkezine yakın bir tepeden bölgeyi gözetler.",
        "126cecee1bcae910ffd6": "Yaşlı Moonstrike, Western Plaguelands'teki Scholomance'ta bulunabilir."
      },
      "name": "Ulu Obsidian",
