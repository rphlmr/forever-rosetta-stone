    "daDK": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Nu er tiden kommet, hvor året er nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "08a6279c4455144fc9d7": "Ældste Graveborn opholder sig nær Brill i Tirisfal Glades.",
        "0cec4db6b432303b11c0": "Ældste Highpeak våger over Hinterlands fra en bakke nær områdets midte.",
        "126cecee1bcae910ffd6": "Ældste Moonstrike findes i Scholomance i Western Plaguelands."
      },
      "name": "Ældste Obsidian",
