    "esES": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten.",
        "08a6279c4455144fc9d7": "El ancestro Sepulnato se encuentra cerca de Rémol en los Claros de Tirisfal.",
        "0cec4db6b432303b11c0": "El ancestro Altacumbre vela por las Tierras del Interior desde una montaña cerca del centro.",
        "126cecee1bcae910ffd6": "Encontrarás al ancestro Lunaplena en Scholomance en las Tierras de la Peste del Oeste."
      },
      "name": "Ancestro Obsidiano",
