    "enUS": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "08a6279c4455144fc9d7": "Elder Graveborn spends time near Brill in Tirisfal Glades.",
        "0cec4db6b432303b11c0": "Elder Highpeak watches over the Hinterlands from a hill near its center.",
        "126cecee1bcae910ffd6": "Elder Moonstrike can be found in the Scholomance in the Western Plaguelands."
      },
      "name": "Elder Obsidian",
