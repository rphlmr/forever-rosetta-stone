  "locales": {
    "csCZ": {
      "dialogue": {
        "031106e34ff98a0beb6e": "Nyní nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... čas, kdy se probouzejí prastarí.",
        "08a6279c4455144fc9d7": "Starší Graveborn pobývá poblíž Brillu v Tirisfalských mýtinách.",
        "0cec4db6b432303b11c0": "Starší Highpeak dohlíží na Hinterlands z kopce poblíž jejich středu.",
        "126cecee1bcae910ffd6": "Starší Moonstrike se nachází ve Scholomance v Západních morových zemích."
      },
      "name": "Starší Obsidian",
      "translationMetadata": {
