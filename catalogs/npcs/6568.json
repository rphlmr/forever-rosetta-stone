  "locales": {
    "csCZ": {
      "dialogue": {
        "52e3446c9312fe08379d": "Sbal si věci, $n! Právě jsem dostal zprávu od Nilith Lokrav v Searing Gorge, že Podtrh zahájil činnost v srdci Kotle. Najdi Nilith Lokrav v Searing Gorge a zjisti podrobnosti!",
        "d73032c2464328038fe3": "Jestli se věnuješ krejčovství, Vizzklick má určitě potřebné zásoby. Rozhlédni se, $n, a dej mi vědět, jestli chceš něco koupit!",
        "ff6e8e66c386084319e6": "Rád bych si prohlédl tvé zboží."
      },
      "name": "Vizzklick",
      "translationMetadata": {
        "fields": {
          "dialogue.52e3446c9312fe08379d": {
