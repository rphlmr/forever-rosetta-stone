    "ptBR": {
      "dialogue": {
        "52e3446c9312fe08379d": "Pegue suas coisas, $n! Soube por Nilith Lokrav, na Garganta Abrasadora, que o Submercado está funcionando no coração do Caldeirão. Procure Nilith Lokrav na Garganta Abrasadora e se inteire da situação!",
        "d73032c2464328038fe3": "Se alfaiataria é o seu negócio, Linhagulha com certeza terá suprimentos para você. Dê uma olhadinha, $n, e me avise se quiser comprar alguma coisa!",
        "ff6e8e66c386084319e6": "Quero ver suas mercadorias."
      },
      "name": "Linhagulha",
      "subName": "Suprimentos de Alfaiataria",
      "translationMetadata": {
        "fields": {
          "dialogue.52e3446c9312fe08379d": {
            "origin": "community",
