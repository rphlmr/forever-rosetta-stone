            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "deed6890b917d445e429": "Hallo und willkommen! Leider ist mein Stand vorerst geschlossen… ich muss noch allerlei Reparaturen durchführen…\n\nUnglücklicherweise bin ich an einen Blutschwur gebunden, welcher mich dazu verpflichtet, Euch ein Lächeln zu entlocken. Also bitte lächelt, tut es für mich oder ich bin gezwungen mir die Hand abzuhacken und solange totes Fleisch zu essen bis es wieder nachwächst..."
      },
      "name": "Rinling",
      "translationMetadata": {
        "fields": {
          "dialogue.deed6890b917d445e429": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
