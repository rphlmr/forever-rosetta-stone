  "locales": {
    "csCZ": {
      "dialogue": {
        "deed6890b917d445e429": "Zdravím a vítej! Obávám se, že můj stánek není otevřený... potřebuje spoustu oprav...$B$BAle stále mě váže krvavá přísaha vykouzlit ti úsměv na tváři. Tak se prosím usměj, jinak si musím useknout ruku a nejíst maso živých tvorů, dokud mi znovu nenaroste..."
      },
      "name": "Rinling",
      "translationMetadata": {
        "fields": {
          "dialogue.deed6890b917d445e429": {
