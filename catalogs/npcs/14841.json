            "source": "questie",
            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "deed6890b917d445e429": "Hello!  And welcome!  I'm afraid my booth is not open... many repairs are needed...$B$BBut I am still bound by blood oath to put a smile on your face.  So please, smile, or I must cut off my hand and consume no living flesh until it regenerates..."
      },
      "name": "Rinling",
      "translationMetadata": {
        "fields": {
          "dialogue.deed6890b917d445e429": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
