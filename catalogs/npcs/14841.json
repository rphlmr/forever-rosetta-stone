    "plPL": {
      "dialogue": {
        "deed6890b917d445e429": "Witaj! Obawiam się, że moje stoisko jest zamknięte... wymaga wielu napraw...$B$BAle wciąż wiąże mnie krwawa przysięga, by wywołać uśmiech na twej twarzy. Uśmiechnij się więc, proszę, albo będę musiał odciąć sobie rękę i nie jeść mięsa żywych stworzeń, dopóki nie odrośnie..."
      },
      "name": "Rinling",
      "translationMetadata": {
        "fields": {
