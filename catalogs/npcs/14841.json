    "hrHR": {
      "dialogue": {
        "deed6890b917d445e429": "Pozdrav i dobro došli! Bojim se da moj štand nije otvoren... potrebno je mnogo popravaka...$B$BAli i dalje me krvna zakletva obvezuje da ti izmamim osmijeh. Zato se, molim te, nasmiješi, ili si moram odsjeći ruku i ne jesti meso živih bića dok mi ponovno ne izraste..."
      },
      "name": "Rinling",
      "translationMetadata": {
