            "sourceBuild": "1.60.1.70938",
            "sourceLocale": "enUS",
            "sourceRevision": "ea970da071079b32e56f349e09648ff0e314b351"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "deed6890b917d445e429": "¡Hola! ¡Bienvenido! Me temo que mi puesto todavía no está abierto... Se necesitan muchas reparaciones...\n\nPero es mi obligación poner una sonrisa en tu cara, así lo he jurado. Así que, sonríe por favor, o tendré que cortarme la mano y no consumir carne viva hasta que se regenere..."
      },
      "name": "Rinling",
      "translationMetadata": {
