    },
    "daDK": {
      "dialogue": {
        "deed6890b917d445e429": "Hej og velkommen! Jeg er bange for, at min bod ikke er åben... der er brug for mange reparationer...$B$BMen jeg er stadig bundet af en blodsed til at få dig til at smile. Så smil venligst, ellers må jeg hugge min hånd af og ikke spise kød fra levende væsner, før den vokser ud igen..."
      },
      "name": "Rinling",
      "translationMetadata": {
        "fields": {
          "dialogue.deed6890b917d445e429": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
