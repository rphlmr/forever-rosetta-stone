    "plPL": {
      "dialogue": {
        "615a254d66c555b0ad35": "Szmaragdowy Krąg stara się uleczyć zranioną ziemię Felwoodu. Choć kraina nosi nazwę od tego, co ją skaziło, mamy nadzieję, że pewnego dnia zdołamy usunąć z niej skażenie."
      },
      "name": "Eridan Bluewind",
