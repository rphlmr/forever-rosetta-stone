    "hrHR": {
      "dialogue": {
        "615a254d66c555b0ad35": "Smaragdni krug nastoji izliječiti ranjenu zemlju Felwooda. Premda je zemlja dobila ime po onome što ju je iskvarilo, nadamo se da ćemo jednog dana moći iskorijeniti tu iskvarenost."
      },
      "name": "Eridan Bluewind",
