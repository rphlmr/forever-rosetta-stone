    "enUS": {
      "dialogue": {
        "615a254d66c555b0ad35": "The Emerald Circle strives to heal the wounded land of Felwood. Although the land is named for the very thing that has corrupted it, we hope that one day we will be able to eradicate the corruption from this land."
      },
      "name": "Eridan Bluewind",
      "subName": "Emerald Circle",
