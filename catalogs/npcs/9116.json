  "locales": {
    "csCZ": {
      "dialogue": {
        "615a254d66c555b0ad35": "Smaragdový kruh usiluje o uzdravení zraněné země Felwoodu. Ačkoli je pojmenována po tom, co ji zkazilo, doufáme, že jednoho dne dokážeme nákazu z této země vymýtit."
      },
      "name": "Eridan Bluewind",
