    "daDK": {
      "dialogue": {
        "615a254d66c555b0ad35": "Smaragdcirklen stræber efter at hele Felwoods sårede land. Selvom landet er opkaldt efter det, der har fordærvet det, håber vi en dag at kunne udrydde fordærvet."
      },
      "name": "Eridan Bluewind",
      "translationMetadata": {
