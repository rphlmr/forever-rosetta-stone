    "trTR": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Umarım beni bölmek için iyi bir nedenin vardır, önemli bir işin ortasındaydım.",
        "78f386456e9d32c331d5": "Beni eğit.",
        "b35e7087e2ef7e658086": "Bir şifalı ot uzmanı daha, hımm. Becerinin benimki kadar iyi olduğundan şüpheliyim, belki sana birkaç doğru teknik öğretebilirim."
      },
      "name": "Tannysa",
