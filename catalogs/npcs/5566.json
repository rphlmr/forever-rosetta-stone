    "daDK": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Jeg håber, du har en god grund til at afbryde mig. Jeg var midt i noget vigtigt arbejde.",
        "78f386456e9d32c331d5": "Træn mig.",
        "b35e7087e2ef7e658086": "Endnu en urtekyndig, hmm. Jeg tvivler på, at dine evner er lige så store som mine, så måske kan jeg lære dig nogle ordentlige teknikker."
      },
      "name": "Tannysa",
      "translationMetadata": {
        "fields": {
