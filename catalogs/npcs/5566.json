    "enUS": {
      "dialogue": {
        "720bb7efdc726f84daaf": "I hope that your interruption is for a good cause, I was in the middle of some important work.",
        "78f386456e9d32c331d5": "Train me.",
        "b35e7087e2ef7e658086": "Another Herbalist, hmm. I doubt your skill is as great as my own so perhaps I can train you in a few proper techniques."
      },
      "name": "Tannysa",
      "subName": "Herbalism Trainer",
