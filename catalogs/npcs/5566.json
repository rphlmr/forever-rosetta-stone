    "frFR": {
      "dialogue": {
        "720bb7efdc726f84daaf": "J'espère que vous ne m'interrompez pas pour rien ; j'étais sur un travail de grande importance.",
        "78f386456e9d32c331d5": "Entraînez-moi.",
        "b35e7087e2ef7e658086": "Un autre herboriste, hum. Je doute que vos compétences égalent les miennes ; je peux par conséquent vous apprendre quelques techniques utiles."
      },
      "name": "Tannysa",
      "subName": "Maître des herboristes",
