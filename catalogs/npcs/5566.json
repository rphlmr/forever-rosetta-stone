    "itIT": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Spero che questa interruzione abbia un buon motivo, ero nel bel mezzo di un lavoro importante.",
        "78f386456e9d32c331d5": "Addestrami.",
        "b35e7087e2ef7e658086": "Un altro erborista, hmm. Dubito che la tua abilità sia pari alla mia, quindi forse posso insegnarti qualche tecnica appropriata."
      },
