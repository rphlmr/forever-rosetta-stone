  "locales": {
    "csCZ": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Doufám, že mě vyrušuješ z dobrého důvodu, právě jsem pracovala na něčem důležitém.",
        "78f386456e9d32c331d5": "Vycvičte mě.",
        "b35e7087e2ef7e658086": "Další bylinkář, hm. Pochybuji, že se tvé umění vyrovná mému, a tak tě možná mohu naučit několika správným technikám."
      },
      "name": "Tannysa",
      "translationMetadata": {
