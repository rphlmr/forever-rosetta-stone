    "hrHR": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Nadam se da imaš dobar razlog što me prekidaš, bila sam usred važnog posla.",
        "78f386456e9d32c331d5": "Podučite me.",
        "b35e7087e2ef7e658086": "Još jedan travar, hm. Sumnjam da je tvoja vještina jednaka mojoj, pa bih te možda mogla naučiti nekoliko pravih tehnika."
      },
      "name": "Tannysa",
