    "plPL": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Mam nadzieję, że masz dobry powód, by mi przeszkadzać. Byłam w trakcie ważnej pracy.",
        "78f386456e9d32c331d5": "Wyszkol mnie.",
        "b35e7087e2ef7e658086": "Kolejny zielarz, hmm. Wątpię, by twoje umiejętności dorównywały moim, więc może nauczę cię kilku właściwych technik."
      },
      "name": "Tannysa",
