    "ltLT": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Tikiuosi, kad sutrukdei mane dėl svarios priežasties. Buvau įpusėjusi svarbų darbą.",
        "78f386456e9d32c331d5": "Pamokyk mane.",
        "b35e7087e2ef7e658086": "Dar vienas žolininkas, hm. Abejoju, ar tavo įgūdžiai prilygsta maniesiems, tad galėčiau išmokyti tave kelių tinkamų technikų."
      },
      "name": "Tannysa",
      "subName": "Žolininkystės mokytoja",
