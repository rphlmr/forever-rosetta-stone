    "svSE": {
      "dialogue": {
        "720bb7efdc726f84daaf": "Jag hoppas att du har ett gott skäl att avbryta mig, jag var mitt uppe i ett viktigt arbete.",
        "78f386456e9d32c331d5": "Träna mig.",
        "b35e7087e2ef7e658086": "Ännu en örtkännare, hmm. Jag tvivlar på att din skicklighet är lika stor som min, så jag kanske kan lära dig några riktiga tekniker."
      },
      "name": "Tannysa",
