    "svSE": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Jag har klätt kungar. Med rätt utbildning kan du också göra det.",
        "c916fb9707239d3669e4": "Träna mig.",
        "d242833d7010e42cc55e": "Jag kan inte hjälpa dig förrän du har lärt dig mer av grunderna. Kom tillbaka när du är redo."
      },
      "name": "Timothy Worthington",
