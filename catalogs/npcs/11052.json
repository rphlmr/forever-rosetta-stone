    "itIT": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Ho vestito dei re. Con l'addestramento giusto, potrai farlo anche tu.",
        "c916fb9707239d3669e4": "Addestrami.",
        "d242833d7010e42cc55e": "Non posso aiutarti finché non avrai imparato di più sulle basi. Torna da me quando sarai pronto."
      },
      "name": "Timothy Worthington",
