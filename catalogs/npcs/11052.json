    "hrHR": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Odijevao sam kraljeve. Uz odgovarajuću obuku možeš i ti.",
        "c916fb9707239d3669e4": "Podučite me.",
        "d242833d7010e42cc55e": "Ne mogu ti pomoći dok bolje ne svladaš osnove. Vrati se kad budeš spreman."
      },
      "name": "Timothy Worthington",
