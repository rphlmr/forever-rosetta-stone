    "enUS": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "I have outfitted kings. With the proper training, you can too.",
        "c916fb9707239d3669e4": "Train me.",
        "d242833d7010e42cc55e": "I cannot help you until you have learned more of the essentials. Come back to me when you are ready."
      },
      "name": "Timothy Worthington",
      "subName": "Master Tailor",
