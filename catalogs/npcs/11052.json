  "locales": {
    "csCZ": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Oblékal jsem krále. S náležitým výcvikem to dokážeš také.",
        "c916fb9707239d3669e4": "Vycvičte mě.",
        "d242833d7010e42cc55e": "Nemohu ti pomoci, dokud si lépe neosvojíš základy. Vrať se, až budeš připraven."
      },
      "name": "Timothy Worthington",
      "translationMetadata": {
        "fields": {
