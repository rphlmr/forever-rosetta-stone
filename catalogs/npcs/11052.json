    "plPL": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Ubierałem królów. Z odpowiednim wyszkoleniem ty też możesz.",
        "c916fb9707239d3669e4": "Wyszkol mnie.",
        "d242833d7010e42cc55e": "Nie mogę ci pomóc, dopóki lepiej nie opanujesz podstaw. Wróć, gdy będziesz gotów."
      },
      "name": "Timothy Worthington",
