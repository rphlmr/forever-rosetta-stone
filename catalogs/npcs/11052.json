    },
    "daDK": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Jeg har klædt konger på. Med den rette træning kan du også.",
        "c916fb9707239d3669e4": "Træn mig.",
        "d242833d7010e42cc55e": "Jeg kan ikke hjælpe dig, før du har lært mere af det grundlæggende. Kom tilbage, når du er klar."
      },
      "name": "Timothy Worthington",
      "translationMetadata": {
        "fields": {
