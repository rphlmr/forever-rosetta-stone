    "deDE": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Ich habe Könige eingekleidet. Mit der richtigen Ausbildung könnt Ihr das auch.",
        "c916fb9707239d3669e4": "Bildet mich aus.",
        "d242833d7010e42cc55e": "Ich kann Euch erst helfen, wenn Ihr mehr Grundlagen gelernt habt. Kommt zu mir zurück, wenn Ihr bereit seid."
      },
      "name": "Timothy Worthington",
      "subName": "Schneidermeister",
