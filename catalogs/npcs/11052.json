    "ltLT": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "Esu siuvęs apdarus karaliams. Tinkamai išmokęs, galėsi ir tu.",
        "c916fb9707239d3669e4": "Išmokyk mane.",
        "d242833d7010e42cc55e": "Negaliu tau padėti, kol geriau neišmokai pagrindų. Sugrįžk, kai būsi pasiruošęs."
      },
      "name": "Timothy Worthington",
      "subName": "Siuvimo meistras",
