    "frFR": {
      "dialogue": {
        "ad402eadbf1ace3a837d": "J'ai équipé des rois. Avec l'entraînement adéquat, vous le pourrez aussi.",
        "c916fb9707239d3669e4": "Entraînez-moi.",
        "d242833d7010e42cc55e": "Je ne peux pas vous aider avant que vous n'ayez appris les bases. Revenez me voir le moment venu."
      },
      "name": "Timothy Worthington",
      "subName": "Tailleur - Maître",
