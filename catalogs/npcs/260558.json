    "frFR": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Je peux vous apprendre à pêcher.",
        "c234f64bfd6c697bd816": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "d792fb9ebd554dcd7c74": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser."
      },
      "name": "Krix",
      "subName": "Excellent pêcheur",
