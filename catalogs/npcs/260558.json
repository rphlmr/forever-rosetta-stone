    "ltLT": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Galiu išmokyti tave žvejoti.",
        "c234f64bfd6c697bd816": "Jei nori tobulėti toliau, turėsi susirasti Nat Pagle Dustwallow Marsh pelkėje.",
        "d792fb9ebd554dcd7c74": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senolis Heming Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau patobulinti savo įgūdžius."
      },
      "name": "Krix",
