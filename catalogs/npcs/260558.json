    "itIT": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Posso insegnarti l'arte della pesca.",
        "c234f64bfd6c697bd816": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "d792fb9ebd554dcd7c74": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità."
      },
      "name": "Krix",
