    "deDE": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "c234f64bfd6c697bd816": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "d792fb9ebd554dcd7c74": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern."
      },
      "name": "Krix",
      "subName": "Überragender Angler",
      "translationMetadata": {
