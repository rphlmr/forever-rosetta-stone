    "daDK": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Jeg kan lære dig at fiske.",
        "c234f64bfd6c697bd816": "Du skal finde Nat Pagle i Dustwallow Marsh for at blive dygtigere.",
        "d792fb9ebd554dcd7c74": "Du er dygtigere end jeg, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af „The Bass and You“. Den vil helt sikkert hjælpe dig med at blive bedre."
      },
      "name": "Krix",
      "translationMetadata": {
