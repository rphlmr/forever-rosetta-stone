    "enUS": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "I can teach you fishing skills.",
        "c234f64bfd6c697bd816": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "d792fb9ebd554dcd7c74": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill."
      },
      "name": "Krix",
      "subName": "Superior Fisherman",
      "translationMetadata": {
