  "locales": {
    "csCZ": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Mohu tě naučit rybařit.",
        "c234f64bfd6c697bd816": "Pokud se chceš dál zdokonalovat, musíš najít Nata Pagla v Dustwallow Marsh.",
        "d792fb9ebd554dcd7c74": "Tvé umění převyšuje mé, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zdokonalit."
      },
      "name": "Krix",
      "translationMetadata": {
