    "hrHR": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Mogu te naučiti pecati.",
        "c234f64bfd6c697bd816": "Moraš pronaći Nata Paglea u Dustwallow Marshu želiš li postati bolji.",
        "d792fb9ebd554dcd7c74": "Tvoja je vještina veća od moje, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige „The Bass and You“. Ona će ti sigurno pomoći da napreduješ."
      },
      "name": "Krix",
