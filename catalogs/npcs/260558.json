    "esES": {
      "dialogue": {
        "6b590b6afd61c94d3de4": "Puedo enseñarte a pescar.",
        "c234f64bfd6c697bd816": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "d792fb9ebd554dcd7c74": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad."
      },
      "name": "Krix",
      "subName": "Pescador superior",
