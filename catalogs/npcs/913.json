    "plPL": {
      "dialogue": {
        "3c0c7866d045c8678992": "Po samej postawie widzę, że nie jesteś wojownikiem.$B$BMoże zajmij się czymś bezpiecznym, na przykład czytaniem?",
        "404e6c181b05f94bc002": "Potrzebuję szkolenia wojownika.",
        "6adba07fa54ec0ac0b92": "Niech Światło cię dziś chroni.",
        "a14d2d0488b3b878fd97": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by uczyć ich na nowo. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz zapomnieć wyuczone talenty?",
        "d3cca132e46f718ee272": "Stormwind jest filarem ludzkiej rasy, utrzymywanym siłą woli i ostrzem mocnego miecza."
      },
      "name": "Lyria Du Lac",
