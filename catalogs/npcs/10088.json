    "csCZ": {
      "dialogue": {
        "02b130d1fced6f1da185": "Ach, příteli, pomáhám jen lovcům a jejich mazlíčkům.",
        "26fb493d3018835e89c9": "Přišel ses vycvičit, abys pak mohl učit své mazlíčky?",
        "33eb455659c3d500576a": "Nauč mě cestám šelmy."
      },
      "name": "Xao'tsu",
