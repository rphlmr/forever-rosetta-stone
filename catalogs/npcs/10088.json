    "daDK": {
      "dialogue": {
        "02b130d1fced6f1da185": "Åh, ven, jeg hjælper kun jægere og deres kæledyr.",
        "26fb493d3018835e89c9": "Er du kommet for at lære, så du kan lære dine kæledyr det samme?",
        "33eb455659c3d500576a": "Lær mig dyrets veje."
      },
      "name": "Xao'tsu",
      "translationMetadata": {
