    "ltLT": {
      "dialogue": {
        "05f78ba03bbd80a68a92": "Šįryt Ravenholdto pasiuntiniai atnešė man šį laišką. Jis skirtas tau, $n.",
        "3fe1ef3750456c08b1a9": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti visa, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Kaskart atlikti šią paslaugą darosi vis sunkiau.  Todėl kiekvienas permokymas ir kainuoja vis daugiau.  Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "8d700ec0ed6360151609": "Tokių kaip tu nemokau, $c.",
        "9d16465581bc015fe286": "Mes tėra tamsa ir šešėliai. Amžini. Nematomi.",
        "caa39628d2bad82114db": "Noriu mokytis.",
        "f69a420cf6958dc1c06c": "Sveikas, jaunasis nenaudėli. Ko ieškai?"
      },
      "name": "Anishar",
      "subName": "Nenaudėlių mokytojas",
      "translationMetadata": {
        "fields": {
          "dialogue.05f78ba03bbd80a68a92": {
