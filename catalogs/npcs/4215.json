    "daDK": {
      "dialogue": {
        "05f78ba03bbd80a68a92": "Budbringere fra Ravenholdt afleverede dette brev til mig i morges. Det er adresseret til dig, $n.",
        "3fe1ef3750456c08b1a9": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "8d700ec0ed6360151609": "Jeg træner ikke din slags, $c.",
        "9d16465581bc015fe286": "Vi er blot mørke og skygger. Evige. Usynlige.",
        "caa39628d2bad82114db": "Jeg søger træning.",
        "f69a420cf6958dc1c06c": "Goddag, unge slyngel. Hvad søger du?"
      },
      "name": "Anishar",
      "translationMetadata": {
