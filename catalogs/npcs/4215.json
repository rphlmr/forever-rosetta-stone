    "enUS": {
      "dialogue": {
        "05f78ba03bbd80a68a92": "Messengers from Ravenholdt delivered this letter to me this morning. It is addressed to you, $n.",
        "3fe1ef3750456c08b1a9": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "8d700ec0ed6360151609": "I don't train your kind $c.",
        "9d16465581bc015fe286": "We are but darkness and shadows. Eternal. Invisible.",
        "caa39628d2bad82114db": "I seek training.",
        "f69a420cf6958dc1c06c": "Greetings young rogue. What do you seek?"
      },
      "name": "Anishar",
      "subName": "Rogue Trainer",
      "translationMetadata": {
