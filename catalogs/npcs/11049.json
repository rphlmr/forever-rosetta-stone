    "daDK": {
      "dialogue": {
        "054cab20119eebc4ec1e": "Skrædderi kan være meget nyttigt. Jeg måtte engang sy min arm på igen.",
        "2214b13c4ef07afda90f": "Træn mig.",
        "3c74329eaf1bd8c3b8cb": "Du har arbejdet dig op... tid til at møde chefen. Gå til Josef og sig, at du er klar.",
        "8c0b552095f13d1acff3": "Godt, du har gåpåmod! Det kan jeg lide. Så lad os komme i gang!",
        "98100a95d8c0a7a00dae": "Hvordan skulle jeg kunne dele mine hemmeligheder med en begynder? Prøv først at tale med Victor Ward."
      },
      "name": "Rhiannon Davis",
      "translationMetadata": {
        "fields": {
