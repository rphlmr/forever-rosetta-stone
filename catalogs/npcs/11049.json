    "ptBR": {
      "dialogue": {
        "054cab20119eebc4ec1e": "A alfaiataria pode ser bastante útil. Certa vez, eu tive que costurar meu braço.",
        "2214b13c4ef07afda90f": "Treine-me.",
        "3c74329eaf1bd8c3b8cb": "Você subiu na organização... é hora de encontrar o chefe. Fale com Josefo e diga a ele que você já está preparado.",
        "8c0b552095f13d1acff3": "Bom, você tem bastante coragem! Gosto disso. Bem, então vamos!",
        "98100a95d8c0a7a00dae": "Como posso compartilhar meus segredos com um novato? Tente falar com Victor Guardia primeiro."
      },
      "name": "Renata Davis",
      "subName": "Alfaiate Perita",
