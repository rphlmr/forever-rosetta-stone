  "locales": {
    "csCZ": {
      "dialogue": {
        "054cab20119eebc4ec1e": "Krejčovství se může hodit. Jednou jsem si musela přišít zpátky ruku.",
        "2214b13c4ef07afda90f": "Vycvičte mě.",
        "3c74329eaf1bd8c3b8cb": "Vypracoval ses... je čas zajít za šéfem. Jdi za Josefem a řekni mu, že jsi připraven.",
        "8c0b552095f13d1acff3": "Dobře, máš kuráž! To se mi líbí. Tak tedy začněme!",
        "98100a95d8c0a7a00dae": "Jak bych mohla svá tajemství svěřit začátečníkovi? Zkus nejdřív promluvit s Victorem Wardem."
      },
      "name": "Rhiannon Davis",
      "translationMetadata": {
        "fields": {
