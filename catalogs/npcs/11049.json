    "ltLT": {
      "dialogue": {
        "054cab20119eebc4ec1e": "Siuvimas gali labai praversti. Kartą man teko prisisiūti savo ranką.",
        "2214b13c4ef07afda90f": "Išmokyk mane.",
        "3c74329eaf1bd8c3b8cb": "Nemažai pasiekei... laikas susitikti su vadovu. Nueik pas Josef ir pasakyk, kad esi pasiruošęs.",
        "8c0b552095f13d1acff3": "Puiku, tau netrūksta ryžto! Man tai patinka. Na ką, pradėkime!",
        "98100a95d8c0a7a00dae": "Kaip galėčiau atskleisti savo paslaptis pradedančiajam? Pirmiausia pasikalbėk su Victor Ward."
      },
      "name": "Rhiannon Davis",
      "subName": "Siuvimo ekspertas",
