    "enUS": {
      "dialogue": {
        "054cab20119eebc4ec1e": "Tailoring can come in very handy. I once had to sew my arm back on.",
        "2214b13c4ef07afda90f": "Train me.",
        "3c74329eaf1bd8c3b8cb": "You have worked your way up... time to see the boss. Go to Josef and tell him you are ready.",
        "8c0b552095f13d1acff3": "Good, you've got some grit! I like that. Well then, let's get going!",
        "98100a95d8c0a7a00dae": "How can I share my secrets with a beginner? Try speaking with Victor Ward first."
      },
      "name": "Rhiannon Davis",
      "subName": "Expert Tailor",
      "translationMetadata": {
        "fields": {
