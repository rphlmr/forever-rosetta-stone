    "hrHR": {
      "dialogue": {
        "054cab20119eebc4ec1e": "Krojenje može biti vrlo korisno. Jednom sam morala ponovno prišiti svoju ruku.",
        "2214b13c4ef07afda90f": "Podučite me.",
        "3c74329eaf1bd8c3b8cb": "Napredovao si... vrijeme je da posjetiš šefa. Idi Josefu i reci mu da si spreman.",
        "8c0b552095f13d1acff3": "Dobro, imaš hrabrosti! To mi se sviđa. Pa onda, krenimo!",
        "98100a95d8c0a7a00dae": "Kako da podijelim svoje tajne s početnikom? Prvo razgovaraj s Victorom Wardom."
      },
      "name": "Rhiannon Davis",
