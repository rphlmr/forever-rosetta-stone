    "plPL": {
      "dialogue": {
        "054cab20119eebc4ec1e": "Krawiectwo bywa bardzo przydatne. Kiedyś musiałam przyszyć sobie rękę.",
        "2214b13c4ef07afda90f": "Wyszkol mnie.",
        "3c74329eaf1bd8c3b8cb": "Zasłużyłeś na awans... czas zobaczyć się z szefem. Idź do Josefa i powiedz mu, że jesteś gotów.",
        "8c0b552095f13d1acff3": "Dobrze, masz charakter! Podoba mi się to. A więc zaczynajmy!",
        "98100a95d8c0a7a00dae": "Jak mam zdradzić swoje sekrety początkującemu? Najpierw porozmawiaj z Victorem Wardem."
      },
      "name": "Rhiannon Davis",
      "translationMetadata": {
