    "enUS": {
      "dialogue": {
        "00053237f3fbfe49546e": "Aww, what rotten luck! My skills aren't good enough to be of any use to you. Oh well. Talk to Fimble Finespindle over there by the loom. He's been working with leather for longer than I have.",
        "0cb33646ce482871df61": "Oh, goody, something else to do while I wait! You're a real life-saver, $N!",
        "a267addb04b26f18c750": "Train me.",
        "febefaa5c5afe645378b": "This hide isn't ready to work with yet. I wish it didn't take so long to make leather. There has to be some way to cut down on all this waiting. It can't be good for my health, you know?"
      },
      "name": "Gretta Finespindle",
      "subName": "Journeyman Leatherworker",
      "translationMetadata": {
        "fields": {
