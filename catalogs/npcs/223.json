  "locales": {
    "csCZ": {
      "dialogue": {
        "22d87b6f57dbb0fb6e29": "Nemohu ti pomoci, tvé dovednosti převyšují mé. Promluv si s Arthurem Moorem u rakví. Ten tě může učit dál.",
        "b036da6e2a90a5f08168": "Když jsem se vyhrabal z hrobu, myslel jsem, že mě rodina přivítá s otevřenou náručí. Místo toho mě vyhnali z vesnice a křičeli jazykem, kterému jsem už nerozuměl.",
        "b38640504edbc9e6b30a": "Zapamatuj si každé mé slovo. Dokud naši nepřátelé nebudou zničeni, nesmíme promarnit příležitost rozšířit své znalosti. Zpevni zbroj a nikdy nepolevuj v ostražitosti.",
        "f94e76f38fc673d4870f": "Vycvičte mě."
      },
      "name": "Dan Golthas",
      "translationMetadata": {
        "fields": {
          "dialogue.22d87b6f57dbb0fb6e29": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
