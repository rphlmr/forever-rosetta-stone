  "locales": {
    "csCZ": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "Myslím, že se starší Splitrock vydal do Mauradonu v Desolace.",
        "9f391be2779d84c386f6": "Staršího Grimtotema najdeš v pavilonu Lariss ve Feralasu.",
        "ab279f86776e298c6361": "Kdysi dávno jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "abefac223c16547d2c0e": "Starší Morningdew pozoruje ruch na závodišti Mirage v Thousand Needles."
      },
      "name": "Starší Mistwalker",
      "translationMetadata": {
        "fields": {
