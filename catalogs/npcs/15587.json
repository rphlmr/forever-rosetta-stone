    "enUS": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "I think Elder Splitrock has traveled to Mauradon in the Desolace.",
        "9f391be2779d84c386f6": "You'll find Elder Grimtotem at the Lariss Pavilion in Feralas.",
        "ab279f86776e298c6361": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "abefac223c16547d2c0e": "Elder Morningdew has taken to watching the commotion at the Mirage Raceway in Thousand Needles."
      },
      "name": "Elder Mistwalker",
      "translationMetadata": {
