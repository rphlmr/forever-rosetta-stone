    "trTR": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "Sanırım Yaşlı Splitrock, Desolace’taki Mauradon’a gitti.",
        "9f391be2779d84c386f6": "Yaşlı Grimtotem’i Feralas’taki Lariss Köşkü’nde bulabilirsin.",
        "ab279f86776e298c6361": "Çok eskiden av için yaşardık. Şan ve onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "abefac223c16547d2c0e": "Yaşlı Morningdew, Thousand Needles’taki Mirage Yarış Pisti’ndeki hareketliliği izliyor."
      },
