    "hrHR": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "Mislim da je starješina Splitrock otputovao u Mauradon u Desolaceu.",
        "9f391be2779d84c386f6": "Starješinu Grimtotema pronaći ćeš u paviljonu Lariss u Feralasu.",
        "ab279f86776e298c6361": "U davna vremena živjeli smo za lov. Lovili smo radi slave i časti...$B$BJe li danas toliko drukčije?",
        "abefac223c16547d2c0e": "Starješina Morningdew promatra vrevu na trkalištu Mirage u Thousand Needlesu."
      },
      "name": "Starješina Mistwalker",
