    "svSE": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "Jag tror att äldste Splitrock har rest till Mauradon i Desolace.",
        "9f391be2779d84c386f6": "Du hittar äldste Grimtotem vid Larisspaviljongen i Feralas.",
        "ab279f86776e298c6361": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "abefac223c16547d2c0e": "Äldste Morningdew har börjat bevaka vimlet vid Mirage Raceway i Thousand Needles."
      },
      "name": "Äldste Mistwalker",
