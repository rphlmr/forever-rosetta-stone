    "plPL": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "Myślę, że starszy Splitrock udał się do Mauradonu w Desolace.",
        "9f391be2779d84c386f6": "Starszego Grimtotema znajdziesz w pawilonie Lariss w Feralas.",
        "ab279f86776e298c6361": "Dawno temu żyliśmy dla polowania. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest aż tak inaczej?",
        "abefac223c16547d2c0e": "Starszy Morningdew obserwuje zamieszanie na torze Mirage w Thousand Needles."
      },
      "name": "Starszy Mistwalker",
