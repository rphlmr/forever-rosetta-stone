    "daDK": {
      "dialogue": {
        "05eaa63b05a7dde84fb9": "Jeg tror, at ældste Splitrock er rejst til Mauradon i Desolace.",
        "9f391be2779d84c386f6": "Du finder ældste Grimtotem ved Lariss-pavillonen i Feralas.",
        "ab279f86776e298c6361": "For længe siden levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "abefac223c16547d2c0e": "Ældste Morningdew holder øje med virakken ved Mirage Raceway i Thousand Needles."
      },
      "name": "Ældste Mistwalker",
      "translationMetadata": {
