    "svSE": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Sök upp Shandrina i Silverwind Refuge. Hon kan sälja dig \"Expertkokboken\".",
        "6725b14ed69da00002c3": "Jag kan lära dig att laga mat!",
        "7ad2837e1c939b2b2c86": "Träna mig.",
        "ef803166521bc7265786": "Dirge Quikcleave i Gadgetzan är en mästare i kokkonsten. För att bli bättre måste du söka upp honom.",
        "f6d132057ca71a7bb17a": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!"
      },
      "name": "Gremlock Pilsnor",
