    "itIT": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Cerca Shandrina al Rifugio di Silverwind. Può venderti il \"Ricettario per Esperti\".",
        "6725b14ed69da00002c3": "Posso insegnarti a cucinare!",
        "7ad2837e1c939b2b2c86": "Addestrami.",
        "ef803166521bc7265786": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "f6d132057ca71a7bb17a": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!"
      },
      "name": "Gremlock Pilsnor",
