    "hrHR": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Potraži Shandrinu u Silverwind Refugeu. Može ti prodati \"Kuharicu za stručnjake\".",
        "6725b14ed69da00002c3": "Mogu te naučiti kuhati!",
        "7ad2837e1c939b2b2c86": "Podučite me.",
        "ef803166521bc7265786": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Moraš ga potražiti želiš li se usavršiti.",
        "f6d132057ca71a7bb17a": "Kuhanje je cjeloživotna strast i vidim da je dijelimo!"
      },
