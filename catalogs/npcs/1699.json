    "frFR": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Allez voir Shandrina au refuge de Vent-argent. Elle pourra vous vendre un livre de cuisine pour experts.",
        "6725b14ed69da00002c3": "Je peux vous apprendre à cuisiner !",
        "7ad2837e1c939b2b2c86": "Entraînez-moi.",
        "ef803166521bc7265786": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "f6d132057ca71a7bb17a": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !"
      },
      "name": "Gremlock Pilsnor",
      "subName": "Maître des cuisiniers",
