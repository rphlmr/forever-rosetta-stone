    "plPL": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Odszukaj Shandrinę w Silverwind Refuge. Może sprzedać ci „Książkę kucharską eksperta”.",
        "6725b14ed69da00002c3": "Mogę nauczyć cię gotować!",
        "7ad2837e1c939b2b2c86": "Wyszkol mnie.",
        "ef803166521bc7265786": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odnaleźć.",
        "f6d132057ca71a7bb17a": "Gotowanie to zajęcie na całe życie i widzę, że podzielamy tę samą pasję!"
      },
      "name": "Gremlock Pilsnor",
