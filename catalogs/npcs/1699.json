    "trTR": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Silverwind Refuge’taki Shandrina’yı bul. Sana \"Uzman Yemek Kitabı\"nı satabilir.",
        "6725b14ed69da00002c3": "Sana yemek yapmayı öğretebilirim!",
        "7ad2837e1c939b2b2c86": "Beni eğit.",
        "ef803166521bc7265786": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarının ustasıdır. Kendini geliştirmek için onu bulmalısın.",
        "f6d132057ca71a7bb17a": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!"
      },
      "name": "Gremlock Pilsnor",
