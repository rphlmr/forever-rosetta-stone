    "enUS": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\".",
        "6725b14ed69da00002c3": "I can teach you how to cook!",
        "7ad2837e1c939b2b2c86": "Train me.",
        "ef803166521bc7265786": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "f6d132057ca71a7bb17a": "Cooking is a life long pursuit and I see we share the same passion!"
      },
      "name": "Gremlock Pilsnor",
      "subName": "Cooking Trainer",
