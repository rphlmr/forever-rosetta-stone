    "ltLT": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Surask Shandrina Silverwind Refuge. Ji gali tau parduoti „Patyrusio virėjo knygą“.",
        "6725b14ed69da00002c3": "Galiu išmokyti tave gaminti maistą!",
        "7ad2837e1c939b2b2c86": "Išmokyk mane.",
        "ef803166521bc7265786": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meno meistras. Jei nori tobulėti, turėsi jį surasti.",
        "f6d132057ca71a7bb17a": "Maisto gaminimas – viso gyvenimo užsiėmimas, ir matau, kad mus sieja ta pati aistra!"
      },
      "name": "Gremlock Pilsnor",
      "subName": "Maisto gaminimo mokytojas",
