  "locales": {
    "csCZ": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Vyhledej Shandrinu v Silverwind Refuge. Může ti prodat „Kuchařku pro experty“.",
        "6725b14ed69da00002c3": "Mohu tě naučit vařit!",
        "7ad2837e1c939b2b2c86": "Vycvičte mě.",
        "ef803166521bc7265786": "Dirge Quikcleave z Gadgetzanu je mistrem kuchařského umění. Pokud se chceš zlepšit, musíš ho vyhledat.",
        "f6d132057ca71a7bb17a": "Vaření je celoživotní záliba a vidím, že sdílíme stejnou vášeň!"
      },
      "name": "Gremlock Pilsnor",
      "translationMetadata": {
