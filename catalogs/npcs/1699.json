    "ptBR": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Encontre Shandrina no Refúgio Brisaprata. Ela pode lhe vender o \"Livro de Receitas do Perito\".",
        "6725b14ed69da00002c3": "Eu posso ensinar você a cozinhar!",
        "7ad2837e1c939b2b2c86": "Treine-me.",
        "ef803166521bc7265786": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "f6d132057ca71a7bb17a": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!"
      },
      "name": "Gremlock Pilsnor",
      "subName": "Treinamento de Culinária",
