    "esES": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Busca a Shandrina en el Refugio Brisa de Plata. Te puede vender el \"Recetario para expertos\".",
        "6725b14ed69da00002c3": "Puedo enseñarte a cocinar.",
        "7ad2837e1c939b2b2c86": "Entréname.",
        "ef803166521bc7265786": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "f6d132057ca71a7bb17a": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión."
      },
      "name": "Gremlock Pilsnor",
      "subName": "Instructor de cocina",
