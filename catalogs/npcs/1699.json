    "daDK": {
      "dialogue": {
        "5e9742ff923ec103a63e": "Find Shandrina i Silverwind Refuge. Hun kan sælge dig \"Ekspertkogebogen\".",
        "6725b14ed69da00002c3": "Jeg kan lære dig at lave mad!",
        "7ad2837e1c939b2b2c86": "Træn mig.",
        "ef803166521bc7265786": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunst. Du må opsøge ham for at blive bedre.",
        "f6d132057ca71a7bb17a": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme lidenskab!"
      },
      "name": "Gremlock Pilsnor",
      "translationMetadata": {
