    "csCZ": {
      "dialogue": {
        "01eb532ab9df9419928e": "Deset tisíc let zaznamenaných vědomostí přitahuje do Athenaea nežádoucí živly. Knihy se tu denně kradou, získávají zpět a znovu kradou."
      },
      "name": "Strážce vědění Javon",
      "translationMetadata": {
        "fields": {
          "dialogue.01eb532ab9df9419928e": {
