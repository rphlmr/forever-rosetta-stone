            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "01eb532ab9df9419928e": "Ti tusind års nedskrevet viden tiltrækker uønskede elementer til Athenaeum. Bøger bliver stjålet, fundet igen og atter stjålet hver eneste dag."
      },
      "name": "Vismand Javon",
      "translationMetadata": {
        "fields": {
          "dialogue.01eb532ab9df9419928e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
