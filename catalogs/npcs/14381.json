    "enUS": {
      "dialogue": {
        "01eb532ab9df9419928e": "10,000 years of recorded knowledge tends to draw the wrong element to the Athenaeum. Books are stolen, recovered and stolen again on a daily basis."
      },
      "name": "Lorekeeper Javon",
      "translationMetadata": {
        "fields": {
