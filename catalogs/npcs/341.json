    "enUS": {
      "dialogue": {
        "11330df128e5b44a8c3a": "I want to browse your goods.",
        "2c2bae96ff90477ca68a": "Train me.",
        "9a6b310358cb08e56087": "I don't have much time for idle talk, $N.  I've got to get this bridge rebuilt before the rains come.  I've finished every project on-time and under budget and I'm not about to start slipping now."
      },
      "name": "Foreman Oslow",
      "translationMetadata": {
