    "hrHR": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Želim pogledati vašu robu.",
        "2c2bae96ff90477ca68a": "Podučite me.",
        "9a6b310358cb08e56087": "Nemam mnogo vremena za prazne priče, $N. Moram obnoviti ovaj most prije nego što stignu kiše. Svaki sam projekt završio na vrijeme i unutar proračuna i ne namjeravam sada posustati."
      },
      "name": "Predradnik Oslow",
      "translationMetadata": {
