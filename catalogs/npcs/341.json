    "esES": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Quiero ver tus mercancías.",
        "2c2bae96ff90477ca68a": "Entréname.",
        "9a6b310358cb08e56087": "No tengo mucho tiempo para charlas ociosas, $N.  Tengo que reconstruir este puente antes de que llueva.  He terminado todos los proyectos a tiempo y por debajo del presupuesto y no voy a empezar a resbalar ahora."
      },
      "name": "Supervisor Olento",
