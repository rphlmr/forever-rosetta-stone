    "svSE": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Jag vill se dina varor.",
        "2c2bae96ff90477ca68a": "Träna mig.",
        "9a6b310358cb08e56087": "Jag har inte mycket tid för tomt prat, $N. Jag måste få bron återuppbyggd innan regnet kommer. Jag har avslutat varje projekt i tid och under budget, och tänker inte börja slarva nu."
      },
      "name": "Förman Oslow",
