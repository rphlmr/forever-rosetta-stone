    "plPL": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Chcę przejrzeć twoje towary.",
        "2c2bae96ff90477ca68a": "Wyszkol mnie.",
        "9a6b310358cb08e56087": "Nie mam czasu na pogawędki, $N. Muszę odbudować ten most, zanim nadejdą deszcze. Każdy projekt kończyłem na czas i poniżej budżetu, i nie zamierzam teraz zawieść."
      },
