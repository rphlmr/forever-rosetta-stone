  "locales": {
    "csCZ": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Rád bych si prohlédl vaše zboží.",
        "2c2bae96ff90477ca68a": "Vycvičte mě.",
        "9a6b310358cb08e56087": "Na plané řeči nemám moc času, $N. Musím ten most opravit, než přijdou deště. Každý projekt jsem dokončil včas a pod rozpočtem a teď s tím nehodlám přestat."
      },
      "name": "Předák Oslow",
      "translationMetadata": {
        "fields": {
          "dialogue.11330df128e5b44a8c3a": {
            "origin": "ai",
