    "ltLT": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Noriu apžiūrėti tavo prekes.",
        "2c2bae96ff90477ca68a": "Išmokyk mane.",
        "9a6b310358cb08e56087": "Neturiu daug laiko tuščioms kalboms, $N. Turiu atstatyti šį tiltą, kol neprasidėjo liūtys. Visus darbus iki šiol baigiau laiku ir neviršydamas biudžeto, tad neketinu apsileisti ir dabar."
      },
