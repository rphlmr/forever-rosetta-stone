    "ptBR": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Quero ver suas mercadorias.",
        "2c2bae96ff90477ca68a": "Treine-me.",
        "9a6b310358cb08e56087": "Não tenho muito tempo para conversa fiada, $N. Preciso reconstruir esta ponte antes que venham as chuvas. Terminei todos os meus projetos no prazo e abaixo do orçamento, e não vou começar a falhar agora."
      },
      "name": "Encarregado Oslow",
