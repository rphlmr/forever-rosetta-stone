      }
    },
    "deDE": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Ich möchte Eure Waren ansehen.",
        "2c2bae96ff90477ca68a": "Bildet mich aus.",
        "9a6b310358cb08e56087": "Ich habe nicht viel Zeit für müßiges Gerede, $N.  Ich muss diese Brücke wiederaufbauen, bevor der Regen kommt.  Ich habe jedes Projekt pünktlich und unter dem Budget abgeschlossen, und ich werde jetzt nicht damit anfangen, nachzulassen."
      },
      "name": "Großknecht Oslow",
      "translationMetadata": {
        "fields": {
          "dialogue.11330df128e5b44a8c3a": {
