    "daDK": {
      "dialogue": {
        "11330df128e5b44a8c3a": "Jeg vil gerne se dine varer.",
        "2c2bae96ff90477ca68a": "Træn mig.",
        "9a6b310358cb08e56087": "Jeg har ikke megen tid til tom snak, $N. Jeg skal have genopbygget broen, før regnen kommer. Jeg har afsluttet alle projekter til tiden og under budget, og det har jeg ikke tænkt mig at ændre på nu."
      },
      "name": "Formand Oslow",
      "translationMetadata": {
        "fields": {
          "dialogue.11330df128e5b44a8c3a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
