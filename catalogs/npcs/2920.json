    "esES": {
      "dialogue": {
        "2b3120968099031e729e": "Entréname.",
        "3713183ab363819482c2": "Hola, $N.\n\nLotwil no es el jefe más perspicaz que he tenido. De hecho se involucra mucho con su trabajo. Tanto que a veces sus criados no comen, ni cobran.\n\n\nBPero eso no significa que debas sufrir.",
        "ce30bc918ebb750d66eb": "Quiero ver tus mercancías."
      },
      "name": "Lucien Tosselramienta",
