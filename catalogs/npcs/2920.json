    "ptBR": {
      "dialogue": {
        "2b3120968099031e729e": "Treine-me.",
        "3713183ab363819482c2": "Olá, $N.$B$BLotwil não é o chefe mais atento que já tive. Ele se envolve tanto no trabalho que às vezes os servos dele ficam sem comer ou receber.$B$B<Lucien olha para Lotwil de cara fechada.>$B$BMas isso não significa que você tenha que sofrer.",
        "ce30bc918ebb750d66eb": "Quero ver suas mercadorias."
      },
      "name": "Lucien Tacachave",
