    "esMX": {
      "dialogue": {
        "2b3120968099031e729e": "Entréname.",
        "3713183ab363819482c2": "Hola, $N.$B$BLotwil no es el jefe más atento que he tenido. Se entrega tanto a su trabajo que a veces sus sirvientes no comemos ni cobramos.$B$B<Lucien mira a Lotwil con el ceño fruncido.>$B$BPero eso no significa que tú debas sufrir.",
        "ce30bc918ebb750d66eb": "Quiero ver tus mercancías."
      },
