  "locales": {
    "csCZ": {
      "dialogue": {
        "2b3120968099031e729e": "Vycvičte mě.",
        "3713183ab363819482c2": "Ahoj, $N.$B$BLotwil není nejvšímavější šéf, jakého jsem měl. Opravdu se zabere do práce. Tak moc, že jeho služebnictvo někdy nedostane najíst ani zaplaceno.$B$B<Lucien se zamračí na Lotwila.>$B$BTo ale neznamená, že musíš trpět i ty.",
        "ce30bc918ebb750d66eb": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Lucien Tosselwrench",
      "translationMetadata": {
        "fields": {
