    "plPL": {
      "dialogue": {
        "2b3120968099031e729e": "Wyszkol mnie.",
        "3713183ab363819482c2": "Witaj, $N.$B$BLotwil nie jest najbardziej spostrzegawczym szefem, jakiego miałem. Potrafi tak pochłonąć się pracą, że czasem jego służba nie dostaje jedzenia ani zapłaty.$B$B<Lucien spogląda na Lotwila z niezadowoleniem.>$B$BAle to nie znaczy, że ty też musisz cierpieć.",
        "ce30bc918ebb750d66eb": "Chcę przejrzeć twoje towary."
      },
      "name": "Lucien Tosselwrench",
      "translationMetadata": {
