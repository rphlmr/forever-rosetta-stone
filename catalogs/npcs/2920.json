    "hrHR": {
      "dialogue": {
        "2b3120968099031e729e": "Podučite me.",
        "3713183ab363819482c2": "Hej, $N.$B$BLotwil nije najpažljiviji šef kojeg sam imao. Doista se uživi u svoj posao. Toliko da njegove sluge katkad ne jedu i ne dobiju plaću.$B$B<Lucien se namršti prema Lotwilu.>$B$BAli to ne znači da ti moraš patiti.",
        "ce30bc918ebb750d66eb": "Želim pogledati vašu robu."
      },
      "name": "Lucien Tosselwrench",
      "translationMetadata": {
