    "enUS": {
      "dialogue": {
        "2b3120968099031e729e": "Train me.",
        "3713183ab363819482c2": "Hey there, $N.$B$BLotwil's not the most perceptive boss I've had. He actually gets really involved with his work. So much so that sometimes his servants don't eat, or get paid.$B$B<Lucien frowns over at Lotwil.>$B$BBut that doesn't mean you should suffer.",
        "ce30bc918ebb750d66eb": "I want to browse your goods."
      },
      "name": "Lucien Tosselwrench",
      "translationMetadata": {
