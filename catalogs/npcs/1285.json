    "enUS": {
      "dialogue": {
        "01f2d3ea1995a84861a6": "I want to browse your goods.",
        "16704fe318ca9e3f0407": "Just browsing my wares or is there something specific I can help you find today?",
        "38191dda428ced796f6b": "Best deals in all of Stormwind my friend, won't find any better. Now, what can I help you with?"
