    "csCZ": {
      "dialogue": {
        "01f2d3ea1995a84861a6": "Rád bych si prohlédl vaše zboží.",
        "16704fe318ca9e3f0407": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "38191dda428ced796f6b": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?"
      },
      "name": "Thurman Mullby",
      "translationMetadata": {
