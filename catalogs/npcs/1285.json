    "daDK": {
      "dialogue": {
        "01f2d3ea1995a84861a6": "Jeg vil gerne se dine varer.",
        "16704fe318ca9e3f0407": "Kigger du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?",
        "38191dda428ced796f6b": "De bedste tilbud i hele Stormwind, min ven, du finder ikke bedre. Hvad kan jeg hjælpe dig med?"
      },
      "name": "Thurman Mullby",
      "translationMetadata": {
