    "deDE": {
      "dialogue": {
        "01f2d3ea1995a84861a6": "Ich möchte Eure Waren ansehen.",
        "16704fe318ca9e3f0407": "Seht Ihr Euch nur um oder kann ich Euch irgendwie helfen?",
        "38191dda428ced796f6b": "Die besten Preise in ganz Stormwind, was Besseres werdet Ihr nicht finden. Womit kann ich Euch denn nun dienen?"
      },
      "name": "Thurman Mullby",
      "subName": "Gemischtwarenverkäufer",
