    "ptBR": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$n! Que bom ver você de novo! Divertindo-se na feira?\n\nQuer disputar uma queda de braço? Se você tem amor ao seu braço, acho melhor não!"
      },
      "name": "Ivete Maguila",
      "subName": "A Mulher Mais Forte do Mundo!",
