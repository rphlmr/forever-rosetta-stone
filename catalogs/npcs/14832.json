    "hrHR": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$n, drago mi je opet te vidjeti! Zabavljaš li se na sajmu?$B$BHoćemo li obarati ruke? Ne, naravno da ne... želiš zadržati ruku!"
      },
      "name": "Kerri Hicks",
