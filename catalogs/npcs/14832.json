    "enUS": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$n, it's good to see you again!  Are you having fun at the Faire?$B$BWant to arm wrestle?  No, of course not... you want to keep your arm!"
      },
      "name": "Kerri Hicks",
      "subName": "The Strongest Woman Alive!",
