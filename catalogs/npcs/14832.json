    "esES": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "¡$n, me alegro de verte de nuevo! ¿Te lo estás pasando bien en la Feria?\n\n¿Quieres echar un pulso? No, claro que no... ¡Seguro que no quieres perder tu brazo!"
      },
      "name": "Kerri Paleto",
      "subName": "¡La mujer con vida más fuerte!",
