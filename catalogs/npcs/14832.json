    "plPL": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$n, dobrze cię znów widzieć! Dobrze się bawisz na jarmarku?$B$BMoże siłowanie na rękę? Nie, oczywiście, że nie... chcesz przecież zachować rękę!"
      },
      "name": "Kerri Hicks",
