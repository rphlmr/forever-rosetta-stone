    "svSE": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$n, kul att se dig igen! Har du roligt på marknaden?$B$BSka vi bryta arm? Nej, förstås inte... du vill ju behålla armen!"
      },
      "name": "Kerri Hicks",
