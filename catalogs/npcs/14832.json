    "frFR": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$N, c'est bon de vous revoir ! Vous vous amusez bien ?\n\nOn se fait un petit bras de fer ? Non, bien sûr que non… vous voulez garder votre bras !"
      },
      "name": "Kerri Hicks",
      "subName": "La femme la plus forte du monde !",
