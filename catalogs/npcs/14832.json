    "ltLT": {
      "dialogue": {
        "7df41d7c6fa3df6a1b0d": "$n, kaip smagu tave vėl matyti!  Ar linksminiesi mugėje?$B$BNori išmėginti rankų lenkimą?  Ne, žinoma, kad ne... juk nori išsaugoti ranką!"
      },
      "name": "Kerri Hicks",
      "subName": "Stipriausia moteris pasaulyje!",
