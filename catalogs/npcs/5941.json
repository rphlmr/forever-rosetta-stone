    "plPL": {
      "dialogue": {
        "5840b139b162a7f5d740": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci doskonalić umiejętności.",
        "5e83787aea0cfb679940": "Mogę nauczyć cię wędkowania.",
        "bad84b75ba41cbe31a46": "Wyszkol mnie.",
        "c4f820ea6a147e875289": "Musisz odnaleźć Nata Pagle'a na bagnach Dustwallow, jeśli chcesz dalej doskonalić swoje umiejętności."
      },
      "name": "Lau'Tiki",
      "translationMetadata": {
