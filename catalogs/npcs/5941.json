    "daDK": {
      "dialogue": {
        "5840b139b162a7f5d740": "Du er dygtigere end mig, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den kan helt sikkert hjælpe dig med at blive bedre.",
        "5e83787aea0cfb679940": "Jeg kan lære dig at fiske.",
        "bad84b75ba41cbe31a46": "Træn mig.",
        "c4f820ea6a147e875289": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu."
      },
      "name": "Lau'Tiki",
      "translationMetadata": {
