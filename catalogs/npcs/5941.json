  "locales": {
    "csCZ": {
      "dialogue": {
        "5840b139b162a7f5d740": "Tvé umění už převyšuje mé. Slyšel jsem však, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti určitě pomůže se zlepšit.",
        "5e83787aea0cfb679940": "Mohu tě naučit rybařit.",
        "bad84b75ba41cbe31a46": "Vycvičte mě.",
        "c4f820ea6a147e875289": "Jestli se chceš dále zlepšit, musíš najít Nata Paglea v Dustwallow Marsh."
      },
      "name": "Lau'Tiki",
      "translationMetadata": {
        "fields": {
