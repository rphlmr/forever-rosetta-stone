    "ltLT": {
      "dialogue": {
        "5840b139b162a7f5d740": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senis Heming iš Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau patobulinti savo įgūdžius.",
        "5e83787aea0cfb679940": "Galiu išmokyti tave žvejoti.",
        "bad84b75ba41cbe31a46": "Išmokyk mane.",
        "c4f820ea6a147e875289": "Jei nori žvejoti dar geriau, turėsi surasti Nat Pagle Dustwallow Marsh pelkėje."
      },
      "name": "Lau'Tiki",
      "subName": "Žvejys",
