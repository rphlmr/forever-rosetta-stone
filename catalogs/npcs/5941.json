    "enUS": {
      "dialogue": {
        "5840b139b162a7f5d740": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "5e83787aea0cfb679940": "I can teach you fishing skills.",
        "bad84b75ba41cbe31a46": "Train me.",
        "c4f820ea6a147e875289": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently."
      },
      "name": "Lau'Tiki",
      "subName": "Fisherman",
