    "hrHR": {
      "dialogue": {
        "5840b139b162a7f5d740": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige „Grgeč i ti“. Ona će ti sigurno pomoći da se usavršiš.",
        "5e83787aea0cfb679940": "Mogu te podučiti ribolovu.",
        "bad84b75ba41cbe31a46": "Podučite me.",
        "c4f820ea6a147e875289": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako želiš postati još bolji."
      },
      "name": "Lau'Tiki",
