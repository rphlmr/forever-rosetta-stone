    "trTR": {
      "dialogue": {
        "26331f94eb57c4018caf": "Hey, sen oradaki! Ironforge cücelerinin saygısını kazanmak istiyorsan değerli kaynaklar bağışlayarak başlayabilirsin! Ironforge'un kumaşı azalıyor; kumaşlar ve bandajlar ağaçta yetişmiyor ya!$B$BMaceralarında bulduğun kumaş parçalarını satmak yerine bağışla! Böylece Ironforge'un cüce halkının takdirini kazanırsın!"
      },
      "name": "Mistina Steelshield",
