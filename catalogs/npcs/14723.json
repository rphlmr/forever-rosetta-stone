  "locales": {
    "csCZ": {
      "dialogue": {
        "26331f94eb57c4018caf": "Hej, ty tam! Chceš-li si získat úctu trpaslíků z Ironforge, můžeš začít tím, že daruješ cenné suroviny! Ironforge dochází látka; textilie a obvazy na stromech nerostou, víš!$B$BRůzné kusy látky, které najdeš na svých dobrodružstvích, raději daruj, než abys je prodal! Získáš si tím uznání trpasličího lidu Ironforge!"
      },
      "name": "Mistina Steelshield",
      "translationMetadata": {
        "fields": {
