    "enUS": {
      "dialogue": {
        "26331f94eb57c4018caf": "Aye, you there!  If you want to earn the respect of the dwarves of Ironforge, then you can start by donating valuable resources!  Ironforge finds itself running low on cloth piece; textiles and bandages don't grow on trees, ya know!$B$BRather than cash in various cloth pieces you find adventuring, donate them!  Doing so will earn you the recognition of the dwarven people of Ironforge!"
      },
      "name": "Mistina Steelshield",
      "subName": "Alliance Cloth Quartermaster",
      "translationMetadata": {
        "fields": {
