    "trTR": {
      "dialogue": {
        "070e565dec95946ce63d": "Becerin benimkini aşıyor, ama Booty Bay'deki İhtiyar Heming'de 'The Bass and You' kitabının kopyaları olduğunu duydum. Bu kitap becerini geliştirmeni mutlaka sağlayacaktır.",
        "a7b0df69f10876eea5a0": "Daha da ilerlemek için Dustwallow Marsh'ta Nat Pagle'ı bulmalısın.",
        "c2fe4f74adf138b8da45": "Beni eğit.",
        "d0e0c0a4d5a3f69ab2e6": "Sana balık tutmayı öğretebilirim."
      },
      "name": "Donald Rabonne",
