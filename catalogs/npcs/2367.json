    "plPL": {
      "dialogue": {
        "070e565dec95946ce63d": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „The Bass and You”. Z pewnością pomoże ci się doskonalić.",
        "a7b0df69f10876eea5a0": "Jeśli chcesz dalej się rozwijać, musisz odnaleźć Nata Pagle'a w Dustwallow Marsh.",
        "c2fe4f74adf138b8da45": "Wyszkol mnie.",
        "d0e0c0a4d5a3f69ab2e6": "Mogę nauczyć cię łowić ryby."
      },
      "name": "Donald Rabonne",
      "translationMetadata": {
