  "locales": {
    "csCZ": {
      "dialogue": {
        "070e565dec95946ce63d": "Tvá dovednost převyšuje mou, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit.",
        "a7b0df69f10876eea5a0": "Abys získal další zkušenosti, musíš najít Nata Pagleho v Dustwallow Marsh.",
        "c2fe4f74adf138b8da45": "Vycvičte mě.",
        "d0e0c0a4d5a3f69ab2e6": "Mohu tě naučit rybařit."
      },
      "name": "Donald Rabonne",
      "translationMetadata": {
