    "svSE": {
      "dialogue": {
        "070e565dec95946ce63d": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av 'The Bass and You'. Den lär hjälpa dig att bli skickligare.",
        "a7b0df69f10876eea5a0": "Du måste hitta Nat Pagle i Dustwallow Marsh för att utvecklas vidare.",
        "c2fe4f74adf138b8da45": "Träna mig.",
        "d0e0c0a4d5a3f69ab2e6": "Jag kan lära dig fiska."
      },
      "name": "Donald Rabonne",
