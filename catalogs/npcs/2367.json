    "deDE": {
      "dialogue": {
        "070e565dec95946ce63d": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern.",
        "a7b0df69f10876eea5a0": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "c2fe4f74adf138b8da45": "Bildet mich aus.",
        "d0e0c0a4d5a3f69ab2e6": "Ihr könnt bei mir Eure Angelfertigkeit verbessern."
      },
      "name": "Donald Rabonne",
      "subName": "Angler",
