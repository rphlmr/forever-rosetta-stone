    "hrHR": {
      "dialogue": {
        "070e565dec95946ce63d": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige 'The Bass and You'. Ona će ti sigurno pomoći da se usavršiš.",
        "a7b0df69f10876eea5a0": "Ako želiš postati još bolji, morat ćeš pronaći Nata Paglea u Dustwallow Marshu.",
        "c2fe4f74adf138b8da45": "Podučite me.",
        "d0e0c0a4d5a3f69ab2e6": "Mogu te podučiti ribolovu."
      },
      "name": "Donald Rabonne",
