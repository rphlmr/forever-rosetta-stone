    "daDK": {
      "dialogue": {
        "070e565dec95946ce63d": "Dine færdigheder overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af 'The Bass and You'. Den vil helt sikkert hjælpe dig med at blive bedre.",
        "a7b0df69f10876eea5a0": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive endnu bedre.",
        "c2fe4f74adf138b8da45": "Træn mig.",
        "d0e0c0a4d5a3f69ab2e6": "Jeg kan lære dig at fiske."
      },
      "name": "Donald Rabonne",
      "translationMetadata": {
