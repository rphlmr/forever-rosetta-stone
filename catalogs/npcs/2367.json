    "ltLT": {
      "dialogue": {
        "070e565dec95946ce63d": "Tavo įgūdžiai pranoksta manuosius, tačiau girdėjau, kad senolis Heming iš Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau tobulėti.",
        "a7b0df69f10876eea5a0": "Jei nori tobulėti toliau, turėsi susirasti Nat Pagle Dustwallow Marsh pelkėje.",
        "c2fe4f74adf138b8da45": "Pamokyk mane.",
        "d0e0c0a4d5a3f69ab2e6": "Galiu išmokyti tave žvejoti."
      },
      "name": "Donald Rabonne",
      "subName": "Žvejys",
