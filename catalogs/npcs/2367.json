    "enUS": {
      "dialogue": {
        "070e565dec95946ce63d": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "a7b0df69f10876eea5a0": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "c2fe4f74adf138b8da45": "Train me.",
        "d0e0c0a4d5a3f69ab2e6": "I can teach you fishing skills."
      },
      "name": "Donald Rabonne",
      "subName": "Fisherman",
