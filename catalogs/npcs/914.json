  "locales": {
    "csCZ": {
      "dialogue": {
        "35c6689d5b77c3e7e64d": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým dalším přeškolením těžší provést. Proto je také pokaždé dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "ac19215245f8b26ac1f3": "Stormwind je oporou lidské rasy, udržovanou silnou vůlí a ostřím pevné čepele.",
        "b72da4f905161237a7e5": "Už podle toho, jak stojíš, poznám, že nejsi válečník.$B$BProč nejdeš dělat něco bezpečného, třeba číst knihu?",
        "d9aa9318427b5fcb2aab": "Potřebuji výcvik válečníka."
      },
      "name": "Ander Germaine",
      "translationMetadata": {
        "fields": {
          "dialogue.35c6689d5b77c3e7e64d": {
