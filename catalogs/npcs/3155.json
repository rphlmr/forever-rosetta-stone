    "csCZ": {
      "dialogue": {
        "1105f7698e5171e6b248": "Tvůj druh necvičím, $c.",
        "34fe035068ba6f366bef": "Roztříštěná ruka navrátí Hordě její někdejší slávu, aniž by jí v tom bránila bázlivost náčelníka.",
        "e41f582b3b448ce0fa47": "Chtěl bych výcvik."
      },
      "name": "Rwag",
      "translationMetadata": {
