    "svSE": {
      "dialogue": {
        "1105f7698e5171e6b248": "Jag tränar inte sådana som du, $c.",
        "34fe035068ba6f366bef": "Den Krossade Handen ska återföra Horden till dess forna glans, utan att hindras av krigshövdingens räddhågsenhet.",
        "e41f582b3b448ce0fa47": "Jag skulle vilja få träning."
      },
      "name": "Rwag",
      "translationMetadata": {
