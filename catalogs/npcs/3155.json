    "daDK": {
      "dialogue": {
        "1105f7698e5171e6b248": "Jeg træner ikke din slags, $c.",
        "34fe035068ba6f366bef": "Den Knuste Hånd vil bringe Horden tilbage til dens tidligere storhed, uhindret af krigshøvdingens frygtsomhed.",
        "e41f582b3b448ce0fa47": "Jeg vil gerne trænes."
      },
      "name": "Rwag",
      "translationMetadata": {
