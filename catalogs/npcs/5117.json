    "ltLT": {
      "dialogue": {
        "1d16e23014032f64a0d7": "Negaliu tavęs mokyti. Turėtum susirasti $c mokytoją.",
        "3269719dd26c9c63a9c2": "Griežtai permokydamas turėjau priversti daugelį mokinių atsisakyti visko, ką jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Kaskart tai padaryti tampa vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "d940959f6e21bca9b02d": "Atėjau mokytis.",
        "e07688d2f6edbb071558": "Kuo galiu tau padėti?"
      },
      "name": "Regnus Thundergranite",
      "subName": "Medžiotojų mokytojas",
