    },
    "daDK": {
      "dialogue": {
        "1d16e23014032f64a0d7": "Jeg kan ikke hjælpe dig med træning. Du bør finde en $c-træner.",
        "3269719dd26c9c63a9c2": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine lærte talenter?",
        "d940959f6e21bca9b02d": "Jeg er her for at træne.",
        "e07688d2f6edbb071558": "Hvad kan jeg gøre for dig?"
      },
      "name": "Regnus Thundergranite",
      "translationMetadata": {
        "fields": {
          "dialogue.1d16e23014032f64a0d7": {
