  "locales": {
    "csCZ": {
      "dialogue": {
        "1d16e23014032f64a0d7": "S výcvikem ti nepomůžu. Najdi si trenéra pro $c.",
        "3269719dd26c9c63a9c2": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto je také dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?",
        "d940959f6e21bca9b02d": "Jsem tu kvůli výcviku.",
        "e07688d2f6edbb071558": "Co pro tebe můžu udělat?"
      },
      "name": "Regnus Thundergranite",
      "translationMetadata": {
        "fields": {
          "dialogue.1d16e23014032f64a0d7": {
            "origin": "ai",
