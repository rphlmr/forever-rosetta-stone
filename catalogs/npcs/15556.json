    "esES": {
      "dialogue": {
        "042351e4484330ae17d8": "El ancestro Caminaniebla disfruta observando las peleas en La Masacre en Feralas.",
        "233bdb720eb9d495c2b9": "Encontrarás al ancestro Tótem Siniestro en el Pabellón Lariss en Feralas.",
        "313f2e60def4902108a6": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten."
      },
      "name": "Ancestro Parterroca",
