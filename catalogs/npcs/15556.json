    "hrHR": {
      "dialogue": {
        "042351e4484330ae17d8": "Starješina Mistwalker uživa gledati borbe u Maulu u Feralasu.",
        "233bdb720eb9d495c2b9": "Starješinu Grimtotema pronaći ćeš u paviljonu Lariss u Feralasu.",
        "313f2e60def4902108a6": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kad se drevni bude."
      },
      "name": "Starješina Splitrock",
