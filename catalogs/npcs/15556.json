    "csCZ": {
      "dialogue": {
        "042351e4484330ae17d8": "Starší Mistwalker rád sleduje zápolení v Maulu ve Feralasu.",
        "233bdb720eb9d495c2b9": "Staršího Grimtotema najdeš v pavilonu Lariss ve Feralasu.",
        "313f2e60def4902108a6": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... kdy se probouzejí prastaří."
      },
      "name": "Starší Splitrock",
