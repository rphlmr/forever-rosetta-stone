    "daDK": {
      "dialogue": {
        "042351e4484330ae17d8": "Elder Mistwalker nyder at se kampene i Maul i Feralas.",
        "233bdb720eb9d495c2b9": "Du finder Elder Grimtotem ved Lariss Pavilion i Feralas.",
        "313f2e60def4902108a6": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de urgamle vågner."
      },
      "name": "Ældste Splitrock",
