    "enUS": {
      "dialogue": {
        "042351e4484330ae17d8": "Elder Mistwalker enjoys watching the struggles at the Maul in Feralas.",
        "233bdb720eb9d495c2b9": "You'll find Elder Grimtotem at the Lariss Pavilion in Feralas.",
        "313f2e60def4902108a6": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake."
      },
      "name": "Elder Splitrock",
