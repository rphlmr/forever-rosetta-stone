    "daDK": {
      "dialogue": {
        "1c562782bb7e25fe6654": "Kan du høre det, fremmede? Summen bliver højere for hver dag. Det må være de krystaller, der driver insekterne til vanvid."
      },
      "name": "Geolog Larksbane",
      "translationMetadata": {
        "fields": {
          "dialogue.1c562782bb7e25fe6654": {
