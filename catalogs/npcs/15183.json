    "deDE": {
      "dialogue": {
        "1c562782bb7e25fe6654": "Könnt Ihr es hören, Fremder? Das Brummen wird mit jedem Tag lauter. Es müssen diese Kristalle sein, die die Käfer so verrückt machen."
      },
      "name": "Geologin Larksbane",
