    "enUS": {
      "dialogue": {
        "1c562782bb7e25fe6654": "Can ye hear it, stranger? The humming is gettin' louder with each passing day. These crystals must be what's driving these bugs crazy."
      },
      "name": "Geologist Larksbane",
