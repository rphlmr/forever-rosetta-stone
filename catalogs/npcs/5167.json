    "itIT": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "Che posso fare per te?",
        "4ea40b8f999c1f23047c": "Non ti posso aiutare, $N. Io addestro solo i ladri.",
        "b2eacadb07984d5402d9": "Con un rigoroso riaddestramento ho dovuto far dimenticare a molti allievi tutto ciò che avevano imparato, per poterli istruire di nuovo. Il servizio che offro diventa sempre più difficile da compiere ogni volta che lo eseguo. Per questo motivo diventa sempre più costoso a ogni riaddestramento. Desideri che ti faccia dimenticare i talenti che hai appreso?",
        "d8a40f8d13f5816f55ae": "Cerco addestramento da ladro.",
        "dff874d9e1298455ad46": "Ho qualcosa per te, $N. Sembra importante."
      },
      "name": "Fenthwick",
