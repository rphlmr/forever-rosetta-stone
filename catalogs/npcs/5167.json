    "deDE": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "Was kann ich für Euch tun?",
        "4ea40b8f999c1f23047c": "Kann Euch nich' helfen, $n. Ich bilde bloß Schurken aus.",
        "b2eacadb07984d5402d9": "Durch rigoroses Abtrainieren musste ich vielen Schülern das abgewöhnen, was sie bisher gelernt hatten, damit ich sie von neuem unterrichten konnte. Der Dienst, den ich anbiete, ist jedes Mal schwieriger durchzuführen. Aus diesem Grunde wird er mit jeder Umschulung teurer. Wünscht Ihr, dass ich Euch die Talente nehme, die Ihr erlernt habt?",
        "d8a40f8d13f5816f55ae": "Ich suche eine Schurkenausbildung.",
        "dff874d9e1298455ad46": "Ich habe etwas für Euch, $n. Könnte wichtig sein."
      },
      "name": "Fenthwick",
      "subName": "Schurkenlehrer",
      "translationMetadata": {
        "fields": {
          "dialogue.08c7c5c35f3b6dc458bf": {
