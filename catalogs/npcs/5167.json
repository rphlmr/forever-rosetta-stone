    "esES": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "¿Qué quieres que haga por ti?",
        "4ea40b8f999c1f23047c": "No puedo ayudarte, $n. Solo instruyo a pícaros.",
        "b2eacadb07984d5402d9": "He tenido que realizar una rigurosa reconversión con muchos estudiantes de todo lo que habían aprendido, para poder enseñarles desde cero. El servicio que ofrezco aumenta de dificultad cada vez que se hace. Por esa razón, también aumenta el precio de cada nueva instrucción. ¿Quieres que elimine todos los talentos que has aprendido?",
        "d8a40f8d13f5816f55ae": "Busco entrenamiento de pícaro.",
        "dff874d9e1298455ad46": "Tengo algo para ti, $n. Parece importante."
      },
      "name": "Fenthwick",
      "subName": "Instructor de pícaros",
      "translationMetadata": {
