  "locales": {
    "csCZ": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "Co pro tebe můžu udělat?",
        "4ea40b8f999c1f23047c": "Nemůžu ti pomoct, $n. Cvičím jen zloděje.",
        "b2eacadb07984d5402d9": "Při důkladném přeškolování jsem musel mnohé žáky zbavit všeho, co se dosud naučili, abych je mohl učit znovu. Pokaždé je tato služba náročnější, a proto je také s každým přeškolením dražší. Chceš, abych tě zbavil naučených talentů?",
        "d8a40f8d13f5816f55ae": "Hledám výcvik pro tuláky.",
        "dff874d9e1298455ad46": "Něco pro tebe mám, $n. Vypadá to důležitě."
      },
      "name": "Fenthwick",
      "translationMetadata": {
        "fields": {
          "dialogue.08c7c5c35f3b6dc458bf": {
