    "daDK": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "Hvad kan jeg gøre for dig?",
        "4ea40b8f999c1f23047c": "Jeg kan ikke hjælpe dig, $n. Jeg træner kun slyngler.",
        "b2eacadb07984d5402d9": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver sværere at udføre hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme dine lærte talenter?",
        "d8a40f8d13f5816f55ae": "Jeg leder efter træning som slyngel.",
        "dff874d9e1298455ad46": "Jeg har noget til dig, $n. Det ser vigtigt ud."
      },
      "name": "Fenthwick",
      "translationMetadata": {
        "fields": {
