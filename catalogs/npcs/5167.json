    "plPL": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "Co mogę dla ciebie zrobić?",
        "4ea40b8f999c1f23047c": "Nie pomogę ci, $n. Szkolę tylko łotrzyków.",
        "b2eacadb07984d5402d9": "Dzięki gruntownemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mógł uczyć ich od nowa. Za każdym razem ta usługa staje się trudniejsza. Dlatego z każdym przeszkoleniem kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć poznane talenty?",
        "d8a40f8d13f5816f55ae": "Szukam szkolenia dla łotrzyków.",
        "dff874d9e1298455ad46": "Mam coś dla ciebie, $n. Wygląda na ważne."
      },
      "name": "Fenthwick",
      "translationMetadata": {
