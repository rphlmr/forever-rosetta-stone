    "hrHR": {
      "dialogue": {
        "08c7c5c35f3b6dc458bf": "Što mogu učiniti za tebe?",
        "4ea40b8f999c1f23047c": "Ne mogu ti pomoći, $n. Obučavam samo lupeže.",
        "b2eacadb07984d5402d9": "Temeljitom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su prethodno naučili kako bih ih mogao poučiti iznova. Tu je uslugu svaki put sve teže pružiti. Zato je svaka prekvalifikacija sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "d8a40f8d13f5816f55ae": "Tražim obuku za lupeže.",
        "dff874d9e1298455ad46": "Imam nešto za tebe, $n. Izgleda važno."
      },
      "name": "Fenthwick",
