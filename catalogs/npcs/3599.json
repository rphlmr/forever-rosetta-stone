    "daDK": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Hej! Jeg er en slyngel, der har brug for træning.",
        "18e143ad6eff8444e015": "Som en kat trukket ind fra regnen kradser og river du, og så gør du det hele igen... Jeg kommer tilbage efter mere...$B$BÅh, jeg så dig ikke komme ind, $n! Hvad kan jeg gøre for dig?",
        "e4251b583c57087b98b6": "Vi er kun mørke og skygger. Evige. Usynlige."
      },
      "name": "Jannok Breezesong",
      "translationMetadata": {
        "fields": {
