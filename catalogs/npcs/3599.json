    "ptBR": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Olá! Sou um ladino e preciso de treinamento.",
        "18e143ad6eff8444e015": "A túnica nas sombras... E um grifo no ar... Um animal que ronda... O céu de Dalanar... Cabeças degoladas... Que rolam pelo chão... Na Legião Ardente... Só tem demente... Sedução... Como uma deeeusaaa, vo- \n\nAh, não vi você entrar, $n! Como posso te ajudar?",
        "e4251b583c57087b98b6": "Nós somos apenas escuridão e sombras. Eternos. Invisíveis."
      },
      "name": "Jannok Brisacanto",
      "subName": "Treinamento de Ladinos",
