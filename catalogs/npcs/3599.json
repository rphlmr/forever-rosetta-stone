    "svSE": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Hej! Jag är en skurk som behöver träning.",
        "18e143ad6eff8444e015": "Som en katt som dragits in från regnet river och klöser du, och sedan gör du om allt igen... Jag kommer tillbaka för mer...$B$BÅh, jag såg dig inte komma in, $n! Vad kan jag göra för dig?",
        "e4251b583c57087b98b6": "Vi är bara mörker och skuggor. Eviga. Osynliga."
      },
      "name": "Jannok Breezesong",
      "translationMetadata": {
