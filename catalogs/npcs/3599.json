  "locales": {
    "csCZ": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Ahoj! Jsem tulák a potřebuji výcvik.",
        "18e143ad6eff8444e015": "Jako kočka vtažená z deště škrábeš a drápeš, pak to uděláš znovu... Vrátím se pro další...$B$BAch, nevšiml jsem si, že jsi vešel, $n! Co pro tebe mohu udělat?",
        "e4251b583c57087b98b6": "Jsme jen tma a stíny. Věční. Neviditelní."
      },
      "name": "Jannok Breezesong",
      "translationMetadata": {
        "fields": {
