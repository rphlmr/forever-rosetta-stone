    "frFR": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Bonjour ! Je suis un voleur à la recherche d'un Maître.",
        "18e143ad6eff8444e015": "Tel un chat chassé par la pluie, vous grattez et griffez encore et encore... Je reviendrai plus tard...\n\nOh, je ne vous ai pas vu entrer, $N ! Que puis-je faire pour vous ?",
        "e4251b583c57087b98b6": "Nous ne sommes qu'ombres et ténèbres. Éternels. Invisibles."
      },
      "name": "Jannok Breezesong",
      "subName": "Maître des voleurs",
