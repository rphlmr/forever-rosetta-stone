    "plPL": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Witaj! Jestem łotrzykiem i potrzebuję szkolenia.",
        "18e143ad6eff8444e015": "Jak kot wciągnięty z deszczu, drapiesz i szarpiesz, a potem robisz to znowu... Wrócę po więcej...$B$BOch, nie zauważyłem, że wchodzisz, $n! Co mogę dla ciebie zrobić?",
        "e4251b583c57087b98b6": "Jesteśmy tylko mrokiem i cieniami. Wieczni. Niewidzialni."
      },
      "name": "Jannok Breezesong",
