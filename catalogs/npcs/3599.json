    "enUS": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Hello! I am a Rogue in need of training.",
        "18e143ad6eff8444e015": "Like a cat dragged in from the rain, you scratch and claw, then do it all over again... I'll be back for more...$B$BOh, I didn't see you enter, $n! What can I do for you?",
        "e4251b583c57087b98b6": "We are but darkness and shadows. Eternal. Invisible."
      },
      "name": "Jannok Breezesong",
      "subName": "Rogue Trainer",
