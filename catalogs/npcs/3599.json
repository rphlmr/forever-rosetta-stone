    "hrHR": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Pozdrav! Ja sam odmetnik kojem treba obuka.",
        "18e143ad6eff8444e015": "Poput mačke uvučene s kiše grebeš i paraš, pa sve ponoviš... Vratit ću se po još...$B$BOh, nisam vidio da si ušao, $n! Što mogu učiniti za tebe?",
        "e4251b583c57087b98b6": "Mi smo tek tama i sjene. Vječni. Nevidljivi."
      },
      "name": "Jannok Breezesong",
