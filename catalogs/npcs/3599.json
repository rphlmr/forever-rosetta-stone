    "itIT": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Salve! Sono un ladro e ho bisogno di addestramento.",
        "18e143ad6eff8444e015": "Come un gatto portato al riparo dalla pioggia, graffi e tiri fuori gli artigli, e poi ricominci da capo... Tornerò per averne ancora...\n\nOh, non ti avevo visto entrare, $N! Cosa posso fare per te?",
        "e4251b583c57087b98b6": "Non siamo che tenebre e ombre. Eterne. Invisibili."
      },
      "name": "Jannok Breezesong",
