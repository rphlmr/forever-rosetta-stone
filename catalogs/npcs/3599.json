    "esES": {
      "dialogue": {
        "0f897ac5eef049a65f48": "¡Hola! Soy un pícaro y necesito instrucción.",
        "18e143ad6eff8444e015": "Como un gato al que arrastran de la lluvia, arañas y clavas las uñas, y luego lo vuelves a hacer... Vendré a buscar más... \n\nOh, ¡no te vi entrar, $n! ¿En qué puedo ayudarte?",
        "e4251b583c57087b98b6": "No somos más que tinieblas y sombras. Eternos. Invisibles."
      },
      "name": "Jannok Brisón",
      "subName": "Instructor de pícaros",
