    "ltLT": {
      "dialogue": {
        "0f897ac5eef049a65f48": "Sveiki! Esu nenaudėlis ir noriu mokytis.",
        "18e143ad6eff8444e015": "Lyg iš lietaus parvilkta katė draskaisi ir kapstaisi, o tada viską kartoji iš naujo... Aš dar grįšiu...$B$BO, nemačiau, kaip įėjai, $n! Kuo galiu tau padėti?",
        "e4251b583c57087b98b6": "Mes esame tik tamsa ir šešėliai. Amžini. Nematomi."
      },
      "name": "Jannok Breezesong",
      "subName": "Nenaudėlių mokytojas",
