  "locales": {
    "csCZ": {
      "dialogue": {
        "22b3896da7090fd6dbff": "Dirge Quikcleave z Gadgetzanu je mistrem kuchařského umění. Chceš-li se zlepšit, musíš ho vyhledat.",
        "51d13b0e43f20a5842b5": "Wulan ve vesnici Shadowprey ti může prodat „Kuchařku pro experty“. Budeš ji potřebovat, chceš-li se zlepšit.",
        "a66f017eb25c577b86db": "Vaření je celoživotní záliba a vidím, že sdílíme stejnou vášeň!"
      },
      "name": "Gorg",
      "translationMetadata": {
