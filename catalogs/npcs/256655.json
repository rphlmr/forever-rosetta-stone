    "hrHR": {
      "dialogue": {
        "22b3896da7090fd6dbff": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Ako se želiš usavršiti, morat ćeš ga potražiti.",
        "51d13b0e43f20a5842b5": "Wulan u selu Shadowprey može ti prodati 'Expert Cookbook'. Trebat će ti želiš li se usavršiti.",
        "a66f017eb25c577b86db": "Kuhanje je cjeloživotni poziv i vidim da dijelimo istu strast!"
      },
