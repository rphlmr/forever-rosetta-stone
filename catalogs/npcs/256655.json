    "enUS": {
      "dialogue": {
        "22b3896da7090fd6dbff": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "51d13b0e43f20a5842b5": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself.",
        "a66f017eb25c577b86db": "Cooking is a life long pursuit and I see we share the same passion!"
      },
      "name": "Gorg",
      "subName": "Cook",
