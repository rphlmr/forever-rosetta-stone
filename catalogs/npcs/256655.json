    "svSE": {
      "dialogue": {
        "22b3896da7090fd6dbff": "Dirge Quikcleave i Gadgetzan är en mästare på matlagning. Du måste söka upp honom om du vill utvecklas.",
        "51d13b0e43f20a5842b5": "Wulan i Shadowprey Village kan sälja dig 'Expert Cookbook'. Du behöver den om du vill utvecklas vidare.",
        "a66f017eb25c577b86db": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!"
      },
      "name": "Gorg",
