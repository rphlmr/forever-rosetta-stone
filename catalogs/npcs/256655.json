    "plPL": {
      "dialogue": {
        "22b3896da7090fd6dbff": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odszukać.",
        "51d13b0e43f20a5842b5": "Wulan w Shadowprey Village może sprzedać ci „Expert Cookbook”. Potrzebujesz jej, by rozwijać swoje umiejętności.",
        "a66f017eb25c577b86db": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!"
      },
