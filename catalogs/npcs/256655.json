    "daDK": {
      "dialogue": {
        "22b3896da7090fd6dbff": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham, hvis du vil blive bedre.",
        "51d13b0e43f20a5842b5": "Wulan i Shadowprey Village kan sælge dig 'Expert Cookbook'. Den får du brug for, hvis du vil blive bedre.",
        "a66f017eb25c577b86db": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme passion!"
      },
      "name": "Gorg",
      "translationMetadata": {
