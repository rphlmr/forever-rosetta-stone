  "locales": {
    "csCZ": {
      "dialogue": {
        "3cf0661d1641d388d483": "Dávej si pozor, $c. Respektuj naše zvyky, jinak na tebe i tvé blízké padne kletba.",
        "9ac0f44eddf4d24b7c96": "Udělám, co mohu, abych tě naučil kněžským cestám, pokud jsi tu kvůli tomu.",
        "9be16defc21856633d0e": "Hledám další výcvik v kněžském umění.",
        "ad2dcf4bb37235bd150e": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl vyučit znovu. Tuto službu je pokaždé těžší provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvým talentům?"
      },
      "name": "Ken'jai",
      "translationMetadata": {
        "fields": {
          "dialogue.3cf0661d1641d388d483": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
