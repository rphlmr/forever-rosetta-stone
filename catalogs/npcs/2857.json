    "hrHR": {
      "dialogue": {
        "13af57eee3ce73946479": "Tko kaže da orci nisu pametni? Treba puno pameti da bi bio inženjer!",
        "2228412992191a9c611c": "Znaš tko je stvarno pametan? Nogg! Čak pametniji od mene. Reci Noggu da te Thund šalje! Naći ćeš ga ondje kod upravljačke ploče.",
        "40176e4adad76f652800": "Podučite me.",
        "6def50429b36eda36937": "Misliš da si dovoljno pametan? Misliš da imaš što je potrebno? Hajdemo saznati!"
      },
      "name": "Thund",
