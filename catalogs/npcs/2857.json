  "locales": {
    "csCZ": {
      "dialogue": {
        "13af57eee3ce73946479": "Kdo říká, že orkové nejsou chytří? Na práci inženýra je potřeba hodně rozumu!",
        "2228412992191a9c611c": "Víš, kdo je opravdu chytrý? Nogg! Dokonce chytřejší než já. Řekni Noggovi, že tě posílá Thund! Najdeš ho támhle u ovládacího panelu.",
        "40176e4adad76f652800": "Vycvičte mě.",
        "6def50429b36eda36937": "Myslíš, že jsi dost chytrý? Že na to máš? Tak to zjistíme!"
      },
      "name": "Thund",
      "translationMetadata": {
        "fields": {
          "dialogue.13af57eee3ce73946479": {
