    "svSE": {
      "dialogue": {
        "13af57eee3ce73946479": "Vem säger att orcher inte är smarta? Det krävs mycket hjärna för att vara ingenjör!",
        "2228412992191a9c611c": "Vet du vem som är riktigt smart? Nogg! Smartare än jag till och med. Säg till Nogg att Thund skickade dig! Du hittar honom vid kontrollpanelen där borta.",
        "40176e4adad76f652800": "Träna mig.",
        "6def50429b36eda36937": "Tror du att du är smart nog? Tror du att du har vad som krävs? Låt oss ta reda på det!"
      },
      "name": "Thund",
      "translationMetadata": {
