    "enUS": {
      "dialogue": {
        "13af57eee3ce73946479": "Who says orcs aren't smart? It takes a lot of brains to be an engineer!",
        "2228412992191a9c611c": "You know who's really smart? Nogg! Smarter than me, even. You go tell Nogg Thund sent you! You can find him by the control panel over there.",
        "40176e4adad76f652800": "Train me.",
        "6def50429b36eda36937": "You think you're smart enough? You think you got what it takes? Let's find out!"
      },
      "name": "Thund",
      "subName": "Journeyman Engineer",
      "translationMetadata": {
        "fields": {
