    "esMX": {
      "dialogue": {
        "13af57eee3ce73946479": "¿Quién dice que los orcos no son listos? ¡Se necesita mucho seso para ser ingeniero!",
        "2228412992191a9c611c": "¿Sabes quién es listo de verdad? ¡Nogg! Es hasta más listo que yo. ¡Ve a decirle que vas de parte de Thund! Podrás encontrarle junto al panel de control de ahí mismo.",
        "40176e4adad76f652800": "Entréname.",
        "6def50429b36eda36937": "¿Crees que eres lo bastante inteligente? ¿Crees que tienes lo que se necesita? ¡Vamos a verlo!"
      },
      "name": "Thund",
      "subName": "Oficial ingeniero",
