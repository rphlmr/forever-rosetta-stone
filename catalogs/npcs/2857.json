    "ptBR": {
      "dialogue": {
        "13af57eee3ce73946479": "Quem disse que os orcs não são espertos? Tem que ter muito miolo pra ser engenheiro!",
        "2228412992191a9c611c": "Você sabe quem é esperto de verdade? Nogg! Mais esperto do que eu, inclusive. Vai falar pro Nogg que Tunda te mandou. Ele tá logo ali no painel de controle.",
        "40176e4adad76f652800": "Treine-me.",
        "6def50429b36eda36937": "Você acha cheio das inteligências? Acha que tem o que precisa? Vamos descobrir!"
      },
      "name": "Tunda",
      "subName": "Engenheiro Profissional",
