    "ltLT": {
      "dialogue": {
        "13af57eee3ce73946479": "Kas sako, kad orkai neprotingi? Kad būtum inžinierius, reikia daug proto!",
        "2228412992191a9c611c": "Žinai, kas iš tiesų protingas? Nogg! Netgi protingesnis už mane. Nueik ir pasakyk Nogg, kad tave atsiuntė Thund! Jį rasi prie valdymo pulto tenai.",
        "40176e4adad76f652800": "Pamokyk mane.",
        "6def50429b36eda36937": "Manai, esi pakankamai protingas? Manai, turi, ko reikia? Tuoj išsiaiškinsime!"
      },
      "name": "Thund",
      "subName": "Patyręs inžinierius",
