    "daDK": {
      "dialogue": {
        "13af57eee3ce73946479": "Hvem siger, at orker ikke er kloge? Det kræver masser af hjerne at være ingeniør!",
        "2228412992191a9c611c": "Ved du, hvem der virkelig er klog? Nogg! Endda klogere end mig. Sig til Nogg, at Thund har sendt dig! Du finder ham ved kontrolpanelet derovre.",
        "40176e4adad76f652800": "Træn mig.",
        "6def50429b36eda36937": "Tror du, du er klog nok? Tror du, du har det, der skal til? Lad os finde ud af det!"
      },
      "name": "Thund",
      "translationMetadata": {
