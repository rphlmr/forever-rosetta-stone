    "daDK": {
      "dialogue": {
        "0d76814d4225f2846605": "Jeg kan ikke hjælpe dig med træning. Du bør finde en træner for $c.",
        "dd2665a0fe07a39ec733": "Jeg søger træning i jægerens kunst.",
        "de0f0565fce0bb36f0c4": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de før havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "deb5f6b6cecfd354ddfa": "Se på dyrets visdom og viden, og du vil se dig selv. Iagttag som uglen, lær kløgt af sabelkatten, og legemliggør ulvens mægtige ånd."
      },
      "name": "Thorfin Stoneshield",
      "translationMetadata": {
        "fields": {
