  "locales": {
    "csCZ": {
      "dialogue": {
        "1b2c748661fa346f4e50": "Zug zug, statečný $c! Mám tu ty nejlépe vyšlechtěné jezdecké vlky, které si můžeš prohlédnout. Nikde nenajdeš jiné zvíře s takovou vytrvalostí a instinktem přežití! Jen si je prohlédni.",
        "3328af76d44d0cbb7841": "Chtěl bych si od vás něco koupit.",
        "e73013e6dc21f02287de": "Své jezdecké vlky nabízím jen těm, kteří si získali nejvyšší úctu Orgrimmaru a orků. Běž nám dokázat svou cenu a pak ti své mocné vlky ukážu."
      },
      "name": "Ogunaro Wolfrunner",
      "translationMetadata": {
        "fields": {
          "dialogue.1b2c748661fa346f4e50": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
