    "svSE": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Träna mig.",
        "376597c498a935b92d68": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av \"The Bass and You\". Den hjälper dig säkert att bli skickligare.",
        "8b93ea8d0e67e799817e": "Du måste hitta Nat Pagle i Dustwallow Marsh för att bli bättre än du är nu.",
        "d1c25b52b0e73178bf74": "Jag kan lära dig att fiska."
      },
      "name": "Kil'Hiwana",
