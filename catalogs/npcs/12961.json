    "daDK": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Træn mig.",
        "376597c498a935b92d68": "Din kunnen overgår min, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"The Bass and You\". Den vil helt sikkert hjælpe dig med at blive bedre.",
        "8b93ea8d0e67e799817e": "Du må finde Nat Pagle i Dustwallow Marsh for at blive bedre, end du er nu.",
        "d1c25b52b0e73178bf74": "Jeg kan lære dig at fiske."
      },
      "name": "Kil'Hiwana",
