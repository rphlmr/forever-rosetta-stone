    "esES": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Entréname.",
        "376597c498a935b92d68": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "8b93ea8d0e67e799817e": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "d1c25b52b0e73178bf74": "Puedo enseñarte a pescar."
      },
      "name": "Kil'Hiwana",
      "subName": "Pescador",
