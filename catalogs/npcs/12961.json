    "deDE": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Bildet mich aus.",
        "376597c498a935b92d68": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern.",
        "8b93ea8d0e67e799817e": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "d1c25b52b0e73178bf74": "Ihr könnt bei mir Eure Angelfertigkeit verbessern."
      },
      "name": "Kil'Hiwana",
      "subName": "Anglerin",
