    "enUS": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Train me.",
        "376597c498a935b92d68": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "8b93ea8d0e67e799817e": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "d1c25b52b0e73178bf74": "I can teach you fishing skills."
      },
      "name": "Kil'Hiwana",
      "subName": "Fisherman",
