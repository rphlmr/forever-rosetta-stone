    "frFR": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Entraînez-moi.",
        "376597c498a935b92d68": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "8b93ea8d0e67e799817e": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "d1c25b52b0e73178bf74": "Je peux vous apprendre à pêcher."
      },
      "name": "Kil'Hiwana",
      "subName": "Pêcheur",
