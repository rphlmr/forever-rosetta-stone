    "itIT": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Addestrami.",
        "376597c498a935b92d68": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità.",
        "8b93ea8d0e67e799817e": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "d1c25b52b0e73178bf74": "Posso insegnarti l'arte della pesca."
      },
      "name": "Kil'Hiwana",
