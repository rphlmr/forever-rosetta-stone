  "locales": {
    "csCZ": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Vycvičte mě.",
        "376597c498a935b92d68": "Tvé schopnosti převyšují mé, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit.",
        "8b93ea8d0e67e799817e": "Pokud se chceš dále zlepšovat, musíš najít Nata Paglea v Dustwallow Marsh.",
        "d1c25b52b0e73178bf74": "Mohu tě naučit rybařit."
      },
      "name": "Kil'Hiwana",
