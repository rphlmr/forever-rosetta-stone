    "hrHR": {
      "dialogue": {
        "10ef1ddba4f771a561fc": "Podučite me.",
        "376597c498a935b92d68": "Tvoja je vještina veća od moje, no čuo sam da stari Heming u Booty Bayu ima primjerke knjige „The Bass and You“. Ona će ti sigurno pomoći da napreduješ.",
        "8b93ea8d0e67e799817e": "Moraš pronaći Nata Paglea u Dustwallow Marshu kako bi napredovao dalje.",
        "d1c25b52b0e73178bf74": "Mogu te podučiti ribolovu."
      },
      "name": "Kil'Hiwana",
