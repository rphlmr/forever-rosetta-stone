    "hrHR": {
      "dialogue": {
        "52b55f8b17ff5d66ffdd": "Tražim daljnju poduku u svećeničkom umijeću.",
        "aff9f2d16e40047d4020": "Da, $c?",
        "bcd14aa4afed684fcbc5": "Što ovaj neznatni sluga može učiniti za tebe, $n? Možda obuka?",
        "c4d5d54d0b6aa18964fe": "Ako želiš, osim obuke mogu ti iz uma izbrisati znanje o tvojim talentima. Imaj na umu da je postupak svaki put sve teže izvesti, pa je zato i sve skuplji.",
        "c85d58e4076b37dd52d9": "Strogom preobukom morao sam mnoge učenike osloboditi svega što su prije naučili kako bih ih mogao poučiti iznova. Ta usluga postaje sve teža svaki put kada je pružim, pa zato postaje i skuplja. Želiš li da te oslobodim talenata koje si naučio?"
      },
      "name": "Malakai Cross",
      "translationMetadata": {
