  "factionTemplateId": 68,
  "locales": {
    "csCZ": {
      "dialogue": {
        "52b55f8b17ff5d66ffdd": "Hledám další výcvik v kněžském umění.",
        "aff9f2d16e40047d4020": "Ano, $c?",
        "bcd14aa4afed684fcbc5": "Co pro tebe může udělat tento nepatrný služebník, $n? Snad výcvik?",
        "c4d5d54d0b6aa18964fe": "Pokud si přeješ, mohu ti kromě výcviku vymazat z mysli znalosti tvých talentů. Varuji tě, že s každým opakováním je tento postup náročnější, a proto i dražší.",
        "c85d58e4076b37dd52d9": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto je také dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?"
      },
      "name": "Malakai Cross",
      "translationMetadata": {
        "fields": {
          "dialogue.52b55f8b17ff5d66ffdd": {
