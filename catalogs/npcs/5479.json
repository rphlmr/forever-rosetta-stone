  "locales": {
    "csCZ": {
      "dialogue": {
        "33f0b6f6ca9c468129b6": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl vyučit znovu. Tuto službu je pokaždé těžší provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvým talentům?",
        "6c04aea14080be2831fb": "Už podle postoje poznám, že nejsi válečník.$B$BProč neděláš něco bezpečného, třeba nečteš knihu?",
        "90949f377bd7a514aa82": "Potřebuji výcvik válečníka.",
        "cbc6603194e0f23f154e": "Stormwind je pilířem lidské rasy, který udržuje síla vůle a ostří pevné čepele."
      },
      "name": "Wu Shen",
      "translationMetadata": {
        "fields": {
          "dialogue.33f0b6f6ca9c468129b6": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
