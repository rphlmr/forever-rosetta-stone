    "plPL": {
      "dialogue": {
        "33f0b6f6ca9c468129b6": "Dzięki rygorystycznemu przekwalifikowaniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc uczyć ich od nowa. Z każdym razem ta usługa staje się trudniejsza, a przez to droższa. Czy chcesz, bym pomógł ci zapomnieć poznane talenty?",
        "6c04aea14080be2831fb": "Już po twojej postawie widzę, że nie jesteś wojownikiem.$B$BCzemu nie zajmiesz się czymś bezpiecznym, na przykład czytaniem książki?",
        "90949f377bd7a514aa82": "Potrzebuję szkolenia wojownika.",
        "cbc6603194e0f23f154e": "Stormwind jest filarem ludzkiej rasy, podtrzymywanym siłą woli i ostrzem solidnego miecza."
      },
      "name": "Wu Shen",
      "translationMetadata": {
        "fields": {
          "dialogue.33f0b6f6ca9c468129b6": {
