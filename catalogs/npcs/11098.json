    "enUS": {
      "dialogue": {
        "57ae2943f4769db16308": "I only wish I had more students like you. Not many will venture so far into enemy territory. I salute your courage.",
        "7003f502d0db7355b3f8": "You have wasted your time and mine by coming to me for training, $n. I have no time to teach basic skills. We're fighting a war here, and this is one of the front lines. Don't return to me until you are more prepared.",
        "78565b05750766c4cd54": "Train me.",
        "c962137348c483be9473": "All requests for my work must be made in person by the buyer. Orwin often asks me to reconsider, but my priorities lie here. Look around you: many of these fighters rely upon me for their armor."
      },
      "name": "Hahrana Ironhide",
      "subName": "Master Leatherworker",
      "translationMetadata": {
        "fields": {
          "dialogue.57ae2943f4769db16308": {
