    "enUS": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Train me.",
        "8e7ec1e494af4af34c91": "Dark forces encroach upon our borders, ancient taints resurface, and new evils emerge to topple the delicate balance of the land. In times of such darkness, we all must be vigilant.",
        "a59b030767390bd6e280": "I want to browse your goods."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
