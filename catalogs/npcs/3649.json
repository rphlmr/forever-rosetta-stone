    "esES": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Entréname.",
        "8e7ec1e494af4af34c91": "Fuerzas oscuras acechan en nuestras fronteras, manchas ancestrales que resurgen y nuevos males emergen para inclinar la balanza del mundo. En tiempos tan oscuros, todos debemos estar atentos.",
        "a59b030767390bd6e280": "Quiero ver tus mercancías."
      },
      "name": "Thundris Tejevientos",
      "translationMetadata": {
