    "frFR": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Entraînez-moi.",
        "8e7ec1e494af4af34c91": "Des forces obscures empiètent sur nos frontières, d'anciennes souillures refont surface et de nouveaux maux apparaissent pour renverser l'équilibre délicat de la terre. En ces temps de ténèbres, nous devons tous être vigilants.",
        "a59b030767390bd6e280": "Je voudrais regarder vos articles."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
