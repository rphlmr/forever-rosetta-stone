      }
    },
    "ptBR": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Treine-me.",
        "8e7ec1e494af4af34c91": "Forças sombrias avançam sobre nossas fronteiras, antigas corrupções ressurgem e novos males ameaçam o delicado equilíbrio da terra. Em tempos tão sombrios, todos devemos permanecer vigilantes.",
        "a59b030767390bd6e280": "Quero ver suas mercadorias."
      },
      "name": "Trovejius Tecevento",
      "translationMetadata": {
        "fields": {
