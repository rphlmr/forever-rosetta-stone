  "locales": {
    "csCZ": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Vycvičte mě.",
        "8e7ec1e494af4af34c91": "Temné síly pronikají k našim hranicím, prastará nákaza se vrací a nová zla ohrožují křehkou rovnováhu této země. V tak temných časech musíme být všichni ostražití.",
        "a59b030767390bd6e280": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
        "fields": {
