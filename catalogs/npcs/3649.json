    },
    "itIT": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Addestrami.",
        "8e7ec1e494af4af34c91": "Forze oscure premono sui nostri confini, antiche corruzioni riaffiorano e nuovi mali sorgono per rovesciare il delicato equilibrio della terra. In tempi così bui dobbiamo essere tutti vigili.",
        "a59b030767390bd6e280": "Vorrei vedere la tua merce."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
        "fields": {
          "dialogue.27c2802bf35723beb2e9": {
