    "daDK": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Træn mig.",
        "8e7ec1e494af4af34c91": "Mørke kræfter trænger ind over vores grænser, ældgamle besmittelser dukker op igen, og nye onder truer landets skrøbelige balance. I så mørke tider må vi alle være på vagt.",
        "a59b030767390bd6e280": "Jeg vil gerne se dine varer."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
        "fields": {
          "dialogue.27c2802bf35723beb2e9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
