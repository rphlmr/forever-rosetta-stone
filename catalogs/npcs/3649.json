    "ruRU": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Обучите меня.",
        "8e7ec1e494af4af34c91": "Темные силы посягают на наши границы, возрождается древняя зараза, появляется новое зло желающее разрушить тонкий баланс земли. В эти темные времена мы все должны быть бдительны.",
        "a59b030767390bd6e280": "Я хочу посмотреть ваши товары."
      },
      "name": "Тандрис Ветропряд",
      "translationMetadata": {
        "fields": {
