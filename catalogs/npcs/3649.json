    "hrHR": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Podučite me.",
        "8e7ec1e494af4af34c91": "Mračne sile približavaju se našim granicama, drevna se kvarenja vraćaju, a nova zla prijete krhkoj ravnoteži zemlje. U tako mračnim vremenima svi moramo biti na oprezu.",
        "a59b030767390bd6e280": "Želim pogledati vašu robu."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
        "fields": {
          "dialogue.27c2802bf35723beb2e9": {
