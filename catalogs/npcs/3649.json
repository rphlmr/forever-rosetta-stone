    "plPL": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Wyszkol mnie.",
        "8e7ec1e494af4af34c91": "Mroczne siły napierają na nasze granice, pradawne skażenia powracają, a nowe zło zagraża delikatnej równowadze tej krainy. W tak mrocznych czasach wszyscy musimy zachować czujność.",
        "a59b030767390bd6e280": "Chcę przejrzeć twoje towary."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
        "fields": {
