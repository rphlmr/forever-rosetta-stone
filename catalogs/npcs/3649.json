    "svSE": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Träna mig.",
        "8e7ec1e494af4af34c91": "Mörka krafter tränger in över våra gränser, uråldriga fördärv återvänder och nya ondskor hotar landets sköra balans. I sådana mörka tider måste vi alla vara vaksamma.",
        "a59b030767390bd6e280": "Jag vill se dina varor."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
