    "trTR": {
      "dialogue": {
        "27c2802bf35723beb2e9": "Beni eğit.",
        "8e7ec1e494af4af34c91": "Karanlık güçler sınırlarımıza dayanıyor, kadim yozlaşmalar yeniden ortaya çıkıyor ve yeni kötülükler diyarın hassas dengesini bozmaya hazırlanıyor. Böylesi karanlık zamanlarda hepimiz tetikte olmalıyız.",
        "a59b030767390bd6e280": "Mallarına bakmak istiyorum."
      },
      "name": "Thundris Windweaver",
      "translationMetadata": {
