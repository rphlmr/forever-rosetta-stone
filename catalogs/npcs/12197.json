    "daDK": {
      "dialogue": {
        "19e18860e13804aaba2c": "$n, aner du, hvad vi står over for i Alterac Valley? Er du klar til at kæmpe mod Frostwolf-klanen?",
        "db8694c735640454a0fb": "Det gør mig ondt, $c, men du skal have mere erfaring, før du kan overleve i Alterac Valley."
      },
      "name": "Glordrum Steelbeard",
      "translationMetadata": {
