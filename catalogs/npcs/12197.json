    "csCZ": {
      "dialogue": {
        "19e18860e13804aaba2c": "$n, máš vůbec ponětí, čemu v Alterac Valley čelíme? Jsi připraven bojovat proti klanu Frostwolf?",
        "db8694c735640454a0fb": "Je mi líto, $c, ale než dokážeš přežít v Alterac Valley, potřebuješ více zkušeností."
      },
      "name": "Glordrum Steelbeard",
      "translationMetadata": {
        "fields": {
