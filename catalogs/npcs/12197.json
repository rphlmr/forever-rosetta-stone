    "enUS": {
      "dialogue": {
        "19e18860e13804aaba2c": "$n, have ye any idea o' what we're up against in Alterac Valley?  Are ye ready to fight the Frostwolf Clan?",
        "db8694c735640454a0fb": "I am sorry $c, but you need to be more experienced before you can survive in Alterac Valley."
      },
      "name": "Glordrum Steelbeard",
      "subName": "Alterac Valley Battlemaster",
