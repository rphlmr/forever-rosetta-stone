    "daDK": {
      "dialogue": {
        "3c9e4cead91482273f78": "Jeg har brug for krigertræning.",
        "774d3098526de17092eb": "Gennem streng genoptræning har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste bliver sværere at udføre hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "89feddc75611a8da64fc": "Vær hilset. Søger du undervisning i krigskunst?",
        "b2257e120457b23d9ab6": "Jeg ser ikke krigerens ånd i dig, barn. Jeg har intet at lære en $c som dig."
      },
      "name": "Kyra Windblade",
      "translationMetadata": {
