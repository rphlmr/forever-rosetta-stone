  "locales": {
    "csCZ": {
      "dialogue": {
        "3c9e4cead91482273f78": "Potřebuji výcvik válečníka.",
        "774d3098526de17092eb": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je při každém dalším použití náročnější, a proto je také pokaždé dražší. Přeješ si, abych tě odnaučila talenty, které ses naučil?",
        "89feddc75611a8da64fc": "Vítej. Hledáš výuku válečného umění?",
        "b2257e120457b23d9ab6": "Nevidím v tobě ducha válečníka, dítě. Nemám učení, které by někomu jako ty, $c, prospělo."
      },
      "name": "Kyra Windblade",
      "translationMetadata": {
        "fields": {
          "dialogue.3c9e4cead91482273f78": {
