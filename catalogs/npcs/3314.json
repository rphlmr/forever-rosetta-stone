      "dialogue": {
        "1b4934229ce7e436e0e3": "Řekni, co chceš, a rychle.",
        "72f96be357f7c520b381": "Chci si prohlédnout vaše zboží.",
        "e9eab97cc0cf357c2b66": "Po tolika letech bojů a otroctví je dobré mít zase domov. "
      },
      "name": "Urtharo",
