            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.a8838e7d87103dfd30e8": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
