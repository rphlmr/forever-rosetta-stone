          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "415f95933be1a1334bc5": "Jeg kan ikke træne en $c som dig.",
        "a5c34b3b25f4e05317a0": "Jeg vil gerne trænes.",
        "a8838e7d87103dfd30e8": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste bliver sværere for hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Alenndaar Lapidaar",
      "translationMetadata": {
        "fields": {
          "dialogue.415f95933be1a1334bc5": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
