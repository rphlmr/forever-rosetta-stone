  "locales": {
    "csCZ": {
      "dialogue": {
        "415f95933be1a1334bc5": "Nemohu vycvičit někoho jako ty, $c.",
        "a5c34b3b25f4e05317a0": "Chtěl bych výcvik.",
        "a8838e7d87103dfd30e8": "Přísným přeškolováním jsem musel mnoho studentů odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvé talenty?"
      },
      "name": "Alenndaar Lapidaar",
      "translationMetadata": {
        "fields": {
          "dialogue.415f95933be1a1334bc5": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.a5c34b3b25f4e05317a0": {
