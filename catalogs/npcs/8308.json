    "plPL": {
      "dialogue": {
        "415f95933be1a1334bc5": "Nie mogę szkolić kogoś takiego jak ty, $c.",
        "a5c34b3b25f4e05317a0": "Chcę się szkolić.",
        "a8838e7d87103dfd30e8": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Z każdym razem wykonanie tej usługi staje się trudniejsze. Dlatego każde kolejne szkolenie kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?"
      },
      "name": "Alenndaar Lapidaar",
