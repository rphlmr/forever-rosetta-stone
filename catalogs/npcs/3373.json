  "locales": {
    "csCZ": {
      "dialogue": {
        "299ae53ccb353dd4b22c": "Jsem ork léčitel, $r. Pokud ses přišel učit, udělám vše pro to, abych tě naučil.",
        "6d57dee4ab7e3d024ab4": "Tvé dovednosti může nyní zlepšit jen proslulý doktor Gregory Victor. Najdeš ho v Hammerfallu v Arathské vysočině.",
        "8fae9d399045fb89b0d5": "Balai Lok'Wein z vesnice Brackenwall v Dustwallow Marsh prodává příručku, kterou musíš prostudovat, abys zlepšil své dovednosti!",
        "b2401be17fe6eac90936": "Potřebuji výcvik, Arnoku."
      },
      "name": "Arnok",
      "translationMetadata": {
        "fields": {
          "dialogue.299ae53ccb353dd4b22c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
