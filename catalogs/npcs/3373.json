    "daDK": {
      "dialogue": {
        "299ae53ccb353dd4b22c": "Jeg er en orkisk læge, $r. Hvis du er kommet for at lære, vil jeg gøre mit bedste for at undervise dig.",
        "6d57dee4ab7e3d024ab4": "Kun den berømte doktor Gregory Victor kan forbedre dine evner nu. Han findes i Hammerfall i Arathi Highlands.",
        "8fae9d399045fb89b0d5": "Balai Lok'Wein i Brackenwall Village i Dustwallow Marsh sælger en håndbog, som du må studere for at forbedre dine evner!",
        "b2401be17fe6eac90936": "Jeg har brug for undervisning, Arnok."
      },
      "name": "Arnok",
      "translationMetadata": {
        "fields": {
          "dialogue.299ae53ccb353dd4b22c": {
            "origin": "ai",
