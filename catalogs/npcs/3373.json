    "plPL": {
      "dialogue": {
        "299ae53ccb353dd4b22c": "Jestem orczym medykiem, $r. Jeśli przybywasz po naukę, zrobię wszystko, by cię nauczyć.",
        "6d57dee4ab7e3d024ab4": "Teraz tylko słynny doktor Gregory Victor może poprawić twoje umiejętności. Znajdziesz go w Hammerfall na Wyżynie Arathi.",
        "8fae9d399045fb89b0d5": "Balai Lok'Wein z wioski Brackenwall na Bagnach Dustwallow sprzedaje podręcznik, który musisz przestudiować, by rozwinąć umiejętności!",
        "b2401be17fe6eac90936": "Potrzebuję szkolenia, Arnoku."
      },
      "name": "Arnok",
      "translationMetadata": {
