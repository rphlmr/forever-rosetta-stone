    "hrHR": {
      "dialogue": {
        "299ae53ccb353dd4b22c": "Ja sam ork iscjelitelj, $r. Ako si došao učiti, dat ću sve od sebe da te podučim.",
        "6d57dee4ab7e3d024ab4": "Sada samo poznati doktor Gregory Victor može unaprijediti tvoju vještinu. Možeš ga pronaći u Hammerfallu u Arathi Highlandsu.",
        "8fae9d399045fb89b0d5": "Balai Lok'Wein iz sela Brackenwall u Dustwallow Marshu prodaje priručnik koji moraš proučiti kako bi unaprijedio svoje vještine!",
        "b2401be17fe6eac90936": "Trebam obuku, Arnoče."
      },
      "name": "Arnok",
