    },
    "hrHR": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, dobro je vidjeti veterane poput tebe na terenu! Nažalost, zalihe su nam trenutačno preslabe za veće kopnene napade na Hordu.$B$BRazgovaraj s našim intendantom; ima zadatke za opskrbu."
      },
      "name": "Kaplar Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
