  "locales": {
    "csCZ": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, rád v poli vidím veterány, jako jsi ty! Bohužel musím oznámit, že máme příliš málo zásob na jakýkoli rozsáhlý pozemní útok proti Hordě.$B$BPromluv si s naším proviantním důstojníkem; má pro tebe zásobovací úkoly."
      },
      "name": "Desátník Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, det er godt at se veteraner som dig i felten! Desværre er vores forsyninger for knappe til at indlede større landangreb mod Horden.$B$BTal med vores kvartermester; han har forsyningsopgaver."
      },
      "name": "Korporal Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, es tut gut, Veteranen wie Euch in der Schlacht zu sehen! Ich muss Euch leider mitteilen, dass unsere Vorräte im Moment zu gering sind, um einen Bodenangriff gegen die Horde starten zu können.\n\nSprecht mit unserem Rüstmeister; er hat Missionen zur Vorratsbeschaffung für Euch."
      },
      "name": "Corporal Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
