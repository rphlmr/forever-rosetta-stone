            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$N, è bello vedere sul campo veterani come te! Sono spiacente di riferire che al momento le nostre scorte sono troppo scarse per lanciare grandi assalti di terra contro l'Orda.\n\nParla con il nostro quartiermastro; ha delle missioni di rifornimento disponibili."
      },
      "name": "Caporale Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "itIT",
