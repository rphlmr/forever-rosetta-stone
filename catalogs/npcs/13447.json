            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, it's good to see veterans like you in the field!  I'm sorry to report that our supplies are currently too low to launch any large ground assaults against the Horde.$B$BSpeak with our quartermaster; he has supply missions available."
      },
      "name": "Corporal Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "¡$n, me alegro de ver a veteranos como tú en el campo! Siento informarte de que nuestros suministros son demasiado escasos para lanzar asaltos terrestres a gran escala contra la Horda.\n\nHabla con nuestro intendente; tiene misiones de suministros disponibles."
      },
      "name": "Cabo Noreg Pico Tormenta",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
