          }
        }
      }
    },
    "zhCN": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n，在战场上看到你这样经验丰富的家伙真好！很抱歉，我们军队的物资过低，无法发动对部落的大规模地面攻击。\n\n跟我们的军需官谈谈，他会给你供给任务的。"
      },
      "name": "诺雷格·雷矛中尉",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "zhCN",
