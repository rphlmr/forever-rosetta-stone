            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ltLT": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, gera matyti tokius veteranus kaip tu mūšio lauke! Deja, šiuo metu mūsų atsargų per mažai, kad galėtume pradėti didesnį sausumos puolimą prieš Ordą.$B$BPasikalbėk su mūsų kvartirmeisteriu. Jis turi atsargų papildymo užduočių."
      },
      "name": "Kapralas Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, dobrze widzieć w polu weteranów takich jak ty! Niestety nasze zapasy są obecnie zbyt skromne, by rozpocząć większe ataki lądowe na Hordę.$B$BPorozmawiaj z naszym kwatermistrzem; ma zadania związane z zaopatrzeniem."
      },
      "name": "Kapral Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, é muito bom ver veteranos como você no campo! Lamento informar que nossos suprimentos não são suficientes para lançar um ataque de infantaria contra a Horda.\n\nFale com nosso intendente pois ele tem missões de abastecimento disponíveis."
      },
      "name": "Cabo Noreg Lançatroz",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ptBR",
            "sourceSha256": "4499628c4271be05580bea7136b76bd490255ac29eb596a9bcd0e879a7e1bf5d"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "ptBR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "Хорошо, что на поле боя есть бывалые бойцы вроде тебя, $n! К сожалению, у нас сейчас слишком мало припасов для серьезного штурма позиций Орды.\n\nПоговори с нашим интендантом – он даст тебе задание насчет снабжения."
      },
      "name": "Капрал Норг Грозовая Вершина",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ruRU",
            "sourceSha256": "6c631198f2820ad1638d95d5c2405c11c90019cbf3afeca9541bb2b70432f7ff"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "ruRU",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, det är gott att se veteraner som du ute i fält! Tyvärr är våra förråd för små för att inleda några större markanfall mot Horden.$B$BTala med vår kvartermästare; han har försörjningsuppdrag."
      },
      "name": "Korpral Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, senin gibi gazileri sahada görmek güzel! Ne yazık ki erzağımız şu anda Horde'a karşı büyük çaplı kara saldırıları başlatmak için çok az.$B$BLevazım subayımızla konuş; onun ikmal görevleri var."
      },
      "name": "Onbaşı Noreg Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "d9ad65f01f01f620ce86": "$n, добре бачити в полі таких ветеранів, як ти! На жаль, наших запасів нині замало, щоб розпочати великий наземний наступ на Орду.$B$BПоговори з нашим квартирмейстером; у нього є завдання на постачання."
      },
      "name": "капрал Нореґ Бурешпиль",
      "translationMetadata": {
        "fields": {
          "dialogue.d9ad65f01f01f620ce86": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
