    "hrHR": {
      "dialogue": {
        "286db03087333f9bb05c": "Vjerujem da si dorastao zadatku... prihvaćaš li izazov?",
        "3af18bc959d90ddfd879": "Odličan posao! Doista zaslužuješ znanje koje ću ti prenijeti!",
        "530f588d997b6b47aa3b": "Podučite me.",
        "8743e0b1a1ef80aa68b5": "Još nisi naučio osnove, putniče. Jesi li razgovarao s mojom pomoćnicom Lalinom Summermoon? Možda bi trebao.",
        "9252b6c5beb9fee4e51b": "Istina je da mogu podučiti svoje vještine onima koji su dostojni. Jesi li ti među njima?",
        "e8ccf6b8c54af9e30617": "Izvanredan si začaravatelj. Bojim se da nadilaziš moje učiteljske sposobnosti. Potraži Kittu Firewind u Azorinoj kuli. Samo te ona sada može podučavati."
      },
      "name": "Taladan",
      "translationMetadata": {
        "fields": {
          "dialogue.286db03087333f9bb05c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.3af18bc959d90ddfd879": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
