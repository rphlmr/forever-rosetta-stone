    "ltLT": {
      "dialogue": {
        "286db03087333f9bb05c": "Tikiu, kad įveiksi šią užduotį... ar priimsi iššūkį?",
        "3af18bc959d90ddfd879": "Puikiai padirbėta! Iš tiesų esi vertas žinių, kurias tau suteiksiu!",
        "530f588d997b6b47aa3b": "Mokyk mane.",
        "8743e0b1a1ef80aa68b5": "Dar neišmokai pagrindų, klajūne. Ar kalbėjaisi su mano padėjėja Lalina Summermoon? Galbūt reikėtų.",
        "9252b6c5beb9fee4e51b": "Tiesa, galiu išmokyti vertus mokinius savo įgūdžių. Ar tu vienas iš jų?",
        "e8ccf6b8c54af9e30617": "Esi išskirtinis kerėtojas. Bijau, kad mano, kaip mokytojo, gebėjimų tau jau nebeužtenka. Surask Kittą Firewind Azoros bokšte. Dabar tik ji gali būti tavo mokytoja."
      },
      "name": "Taladan",
      "subName": "Kerėjimo ekspertas",
      "translationMetadata": {
