  "locales": {
    "csCZ": {
      "dialogue": {
        "286db03087333f9bb05c": "Věřím, že na tento úkol máš... přijmeš výzvu?",
        "3af18bc959d90ddfd879": "Skvělá práce! Opravdu si zasloužíš znalosti, které ti předám!",
        "530f588d997b6b47aa3b": "Vycvičte mě.",
        "8743e0b1a1ef80aa68b5": "Ještě ses nenaučil základy, poutníku. Mluvil jsi s mou asistentkou Lalinou Summermoon? Možná bys měl.",
        "9252b6c5beb9fee4e51b": "Je pravda, že mohu učit své dovednosti ty, kdo jsou toho hodni. Jsi jedním z nich?",
        "e8ccf6b8c54af9e30617": "Jsi výjimečný zaklínač. Obávám se, že už přesahuješ mé učitelské schopnosti. Vyhledej Kittu Firewind ve Věži Azora. Teď může být tvou učitelkou jen ona."
      },
      "name": "Taladan",
      "translationMetadata": {
        "fields": {
