    "esMX": {
      "dialogue": {
        "286db03087333f9bb05c": "Creo que estás a la altura de esta tarea... ¿aceptas el desafío?",
        "3af18bc959d90ddfd879": "¡Buen trabajo! ¡Realmente mereces el saber que puedo transmitirte!",
        "530f588d997b6b47aa3b": "Entréname.",
        "8743e0b1a1ef80aa68b5": "Todavía no has aprendido los principios básicos, trotamundos. ¿Has hablado con mi asistente, Lalina Luna de Verano? Quizás deberías hacerlo.",
        "9252b6c5beb9fee4e51b": "Es cierto que tengo habilidades que enseñar a quienes lo merecen. ¿Lo harás tú?",
        "e8ccf6b8c54af9e30617": "Eres un encantador excepcional. Me temo que superas mi talento como profesor. Busca a Kitta Vientofuego en la Torre de Azora. Ahora es la única que puede servirte de instructora."
      },
      "name": "Taladan",
      "subName": "Experto encantador",
