    "daDK": {
      "dialogue": {
        "286db03087333f9bb05c": "Jeg tror, du kan klare opgaven... tager du imod udfordringen?",
        "3af18bc959d90ddfd879": "Flot arbejde! Du fortjener virkelig den viden, jeg vil give dig!",
        "530f588d997b6b47aa3b": "Træn mig.",
        "8743e0b1a1ef80aa68b5": "Du har endnu ikke lært det grundlæggende, vandrer. Har du talt med min assistent, Lalina Summermoon? Det burde du måske.",
        "9252b6c5beb9fee4e51b": "Det er sandt, at jeg har færdigheder at lære dem, der er værdige. Er du en af dem?",
        "e8ccf6b8c54af9e30617": "Du er en enestående fortryller. Jeg frygter, at dine evner overstiger mine som lærer. Opsøg Kitta Firewind ved Azoras tårn. Kun hun kan undervise dig nu."
      },
      "name": "Taladan",
      "translationMetadata": {
        "fields": {
          "dialogue.286db03087333f9bb05c": {
