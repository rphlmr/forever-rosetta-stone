    "enUS": {
      "dialogue": {
        "286db03087333f9bb05c": "I believe you are up to this task... will you accept the challenge?",
        "3af18bc959d90ddfd879": "Fine work! You are truly deserving of the knowledge I shall bestow upon you!",
        "530f588d997b6b47aa3b": "Train me.",
        "8743e0b1a1ef80aa68b5": "You have not yet learned the basics, wanderer. Have you spoken to my assistant, Lalina Summermoon? Perhaps you should.",
        "9252b6c5beb9fee4e51b": "It is true I have skills to teach to those who are worthy. Would that be you?",
        "e8ccf6b8c54af9e30617": "You are an exceptional enchanter. Beyond my talents as a teacher, I fear. Seek out Kitta Firewind at the Tower of Azora. Only she can qualify as your instructor now."
      },
      "name": "Taladan",
      "subName": "Expert Enchanter",
      "translationMetadata": {
