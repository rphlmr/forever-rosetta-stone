    "plPL": {
      "dialogue": {
        "286db03087333f9bb05c": "Wierzę, że podołasz temu zadaniu... czy przyjmujesz wyzwanie?",
        "3af18bc959d90ddfd879": "Dobra robota! Naprawdę zasługujesz na wiedzę, którą ci przekażę!",
        "530f588d997b6b47aa3b": "Wyszkol mnie.",
        "8743e0b1a1ef80aa68b5": "Nie znasz jeszcze podstaw, wędrowcze. Czy rozmawiałeś z moją asystentką, Laliną Summermoon? Może warto to zrobić.",
        "9252b6c5beb9fee4e51b": "To prawda, mogę uczyć swych umiejętności tych, którzy są tego godni. Czy należysz do nich?",
        "e8ccf6b8c54af9e30617": "Jesteś wyjątkowym zaklinaczem. Obawiam się, że twoje umiejętności przewyższają moje możliwości jako nauczyciela. Odszukaj Kittę Firewind w Wieży Azory. Teraz tylko ona może cię szkolić."
      },
      "name": "Taladan",
      "translationMetadata": {
