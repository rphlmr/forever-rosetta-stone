    "csCZ": {
      "dialogue": {
        "970d688fec56933c2743": "Chceš-li lovit nagy, budeš potřebovat všechnu pomoc, kterou můžeš získat. Hluboko pod vodou najdeš bublající pukliny, které vytvářejí dost vzduchových bublin, abys mohl dýchat pod vodou. Připlav blíž, abys je mohl využít."
      },
      "name": "Drulzegar Skraghook",
      "translationMetadata": {
        "fields": {
