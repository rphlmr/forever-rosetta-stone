    "hrHR": {
      "dialogue": {
        "970d688fec56933c2743": "Ako želiš loviti nage, trebat će ti sva pomoć koju možeš dobiti. Duboko pod vodom nalaze se pukotine koje stvaraju dovoljno mjehurića zraka da možeš disati. Doplivaj blizu kako bi ih iskoristio."
      },
      "name": "Drulzegar Skraghook",
