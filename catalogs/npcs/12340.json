    "enUS": {
      "dialogue": {
        "970d688fec56933c2743": "If you seek to hunt naga, then you will need all the help you can get. Deep in the water you can find bubbly fissures that produce enough air bubbles that will allow you to breath underwater. Swim up close so that you can use the bubbles."
      },
      "name": "Drulzegar Skraghook",
      "translationMetadata": {
        "fields": {
