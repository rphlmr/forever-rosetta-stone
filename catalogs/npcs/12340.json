    },
    "daDK": {
      "dialogue": {
        "970d688fec56933c2743": "Hvis du vil jage nagaer, får du brug for al den hjælp, du kan få. Dybt under vandet findes boblende sprækker, som danner nok luftbobler til, at du kan trække vejret. Svøm tæt på for at bruge dem."
      },
      "name": "Drulzegar Skraghook",
      "translationMetadata": {
        "fields": {
