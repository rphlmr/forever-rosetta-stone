    "ltLT": {
      "dialogue": {
        "85f4c8135a64c2828389": "Ir vėl sveikas, $n!  Nežinau, kiek dar bandysiu įkurti parduotuvę tokioje nuošalioje vietoje.  Bet kadangi anksčiau man padėjai, parodysiu tau kelis dalykus, kurie gali sudominti!",
        "b1d50c6862cdd32cc2a1": "Gal vis dėlto ši vieta parduotuvei nebuvo pati geriausia...",
        "d43c3d1a310075cc2b20": "Turi ką nors įdomaus parduoti, Zorbin?"
      },
      "name": "Zorbin Fandazzle",
      "translationMetadata": {
