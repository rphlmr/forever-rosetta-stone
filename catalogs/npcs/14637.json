  "locales": {
    "csCZ": {
      "dialogue": {
        "85f4c8135a64c2828389": "Ale ahoj, $n! Nevím, jak dlouho se ještě budu pokoušet otevřít obchod uprostřed ničeho. Ale protože jsi mi už pomohl, ukážu ti pár věcí, které by tě mohly zajímat!",
        "b1d50c6862cdd32cc2a1": "Možná to nakonec nebylo nejlepší místo pro obchod...",
        "d43c3d1a310075cc2b20": "Máš na prodej něco zajímavého, Zorbine?"
      },
      "name": "Zorbin Fandazzle",
      "translationMetadata": {
        "fields": {
