    "hrHR": {
      "dialogue": {
        "85f4c8135a64c2828389": "Pa zdravo opet, $n! Ne znam koliko ću još dugo pokušavati otvoriti trgovinu usred ničega. Ali budući da si mi već pomagao, pokazat ću ti neke stvari koje bi ti mogle biti zanimljive!",
        "b1d50c6862cdd32cc2a1": "Možda ovo ipak nije bilo najbolje mjesto za trgovinu...",
        "d43c3d1a310075cc2b20": "Imaš li što zanimljivo na prodaju, Zorbine?"
      },
      "name": "Zorbin Fandazzle",
