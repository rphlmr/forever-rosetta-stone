    "enUS": {
      "dialogue": {
        "85f4c8135a64c2828389": "Well hello again, $n!  I don't know how much longer I'm going to keep on trying to set up a shop out in the middle of nowhere.  Still, since you've helped me out in the past, I'll show you some stuff you may find interesting!",
        "b1d50c6862cdd32cc2a1": "Maybe this wasn't the best place for a shop after all...",
        "d43c3d1a310075cc2b20": "Got anything interesting for sale, Zorbin?"
      },
      "name": "Zorbin Fandazzle",
      "translationMetadata": {
