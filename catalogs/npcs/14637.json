    "plPL": {
      "dialogue": {
        "85f4c8135a64c2828389": "Witaj ponownie, $n! Nie wiem, jak długo jeszcze będę próbował otworzyć sklep na tym pustkowiu. Ale skoro już mi pomogłeś, pokażę ci kilka rzeczy, które mogą cię zainteresować!",
        "b1d50c6862cdd32cc2a1": "Może to jednak nie było najlepsze miejsce na sklep...",
        "d43c3d1a310075cc2b20": "Masz na sprzedaż coś ciekawego, Zorbin?"
      },
      "name": "Zorbin Fandazzle",
