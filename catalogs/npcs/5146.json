    "hrHR": {
      "dialogue": {
        "53ac2c3f2d6057d24199": "Pozdrav, $c. Želiš savjet? Sprijatelji se s magom! Imamo mi nekoliko trikova u rukavu...",
        "630f8fe7f7752eae2990": "Strogom prekvalifikacijom morala sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla učiti iznova. Ta je usluga sve teža svaki put kad je pružim, pa je zato svaka prekvalifikacija sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "bd944fafe3f2de7f1322": "Pozdrav. Ja sam gnomska učiteljica magova, a ti si mag.",
        "ceef78fab49e0566d830": "Zanima me obuka za maga.",
        "fff31d2acc62e39e9510": "Zanima me obuka za maga."
      },
      "name": "Nittlebur Sparkfizzle",
