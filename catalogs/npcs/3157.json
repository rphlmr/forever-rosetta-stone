    "enUS": {
      "dialogue": {
        "082316bc7386c6dc9345": "The spirits have guided you to me. How may I be of service?",
        "2d8a835fdce5b6ad9874": "Teach me the ways of the spirits.",
        "3d7f84be46d7954b35cd": "May the spirits be with you.",
        "d563389d50765e757d69": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Shikrik",
      "subName": "Shaman Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.082316bc7386c6dc9345": {
