    "hrHR": {
      "dialogue": {
        "082316bc7386c6dc9345": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "2d8a835fdce5b6ad9874": "Nauči me putovima duhova.",
        "3d7f84be46d7954b35cd": "Neka duhovi budu s tobom.",
        "d563389d50765e757d69": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Tu je uslugu sve teže pružiti svaki put, pa zato i cijena raste sa svakim preobučavanjem. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Shikrik",
      "translationMetadata": {
