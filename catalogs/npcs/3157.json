    "daDK": {
      "dialogue": {
        "082316bc7386c6dc9345": "Ånderne har ført dig til mig. Hvordan kan jeg hjælpe?",
        "2d8a835fdce5b6ad9874": "Lær mig åndernes veje.",
        "3d7f84be46d7954b35cd": "Må ånderne være med dig.",
        "d563389d50765e757d69": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang og derfor også dyrere ved hver omskoling. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Shikrik",
      "translationMetadata": {
        "fields": {
          "dialogue.082316bc7386c6dc9345": {
