  "locales": {
    "csCZ": {
      "dialogue": {
        "082316bc7386c6dc9345": "Duchové tě ke mně přivedli. Jak ti mohu posloužit?",
        "2d8a835fdce5b6ad9874": "Nauč mě cestám duchů.",
        "3d7f84be46d7954b35cd": "Ať jsou duchové s tebou.",
        "d563389d50765e757d69": "Přísným přecvičením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přecvičení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Shikrik",
      "translationMetadata": {
        "fields": {
          "dialogue.082316bc7386c6dc9345": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
