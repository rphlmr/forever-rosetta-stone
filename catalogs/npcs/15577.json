    "svSE": {
      "dialogue": {
        "23baf5e885c0d2480b19": "Winterhoof? Jag hör att han lever gott i Booty Bay.",
        "36e8f1b9e416e8668826": "Äldste Stormbrow är troligen i byn Goldshire i Elwynn Forest.",
        "3c7c8b96d893864ccd99": "Senast jag hörde var äldste Starsong i det sjunkna templet i Swamp of Sorrows.",
        "48c491b478b60cfec92b": "För länge sedan levde vi för jakten. Vi jagade för ära och heder...$B$BÄr det så annorlunda nu?"
      },
      "name": "Äldste Skychaser",
