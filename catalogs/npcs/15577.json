  "locales": {
    "csCZ": {
      "dialogue": {
        "23baf5e885c0d2480b19": "Winterhoof? Slyšel jsem, že si užívá života v Booty Bay.",
        "36e8f1b9e416e8668826": "Stařešina Stormbrow je nejspíš ve vesnici Goldshire v Elwynnském lese.",
        "3c7c8b96d893864ccd99": "Naposledy jsem slyšel, že stařešina Starsong je v Potopeném chrámu v Bažině žalu.",
        "48c491b478b60cfec92b": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu a čest...$B$BJe to dnes tak jiné?"
      },
      "name": "Starší Skychaser",
      "translationMetadata": {
        "fields": {
