    "hrHR": {
      "dialogue": {
        "23baf5e885c0d2480b19": "Winterhoof? Čujem da uživa u životu u Booty Bayu.",
        "36e8f1b9e416e8668826": "Starješina Stormbrow najvjerojatnije je u selu Goldshire u šumi Elwynn.",
        "3c7c8b96d893864ccd99": "Koliko znam, starješina Starsong bio je u Potopljenom hramu u Močvari tuge.",
        "48c491b478b60cfec92b": "U davna vremena živjeli smo za lov. Lovili smo za slavu i čast...$B$BJe li danas toliko drukčije?"
      },
      "name": "Starješina Skychaser",
