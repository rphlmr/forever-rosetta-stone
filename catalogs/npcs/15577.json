    "plPL": {
      "dialogue": {
        "23baf5e885c0d2480b19": "Winterhoof? Słyszałem, że dobrze się bawi w Booty Bay.",
        "36e8f1b9e416e8668826": "Starszy Stormbrow najpewniej przebywa w wiosce Goldshire w Lesie Elwynn.",
        "3c7c8b96d893864ccd99": "Ostatnio słyszałem, że starszy Starsong jest w Zatopionej Świątyni na Bagnach Smutku.",
        "48c491b478b60cfec92b": "Dawno temu żyliśmy dla polowania. Polowaliśmy dla chwały i honoru...$B$BCzy teraz jest tak inaczej?"
      },
      "name": "Starszy Skychaser",
