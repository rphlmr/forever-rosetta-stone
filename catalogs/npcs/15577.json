    "daDK": {
      "dialogue": {
        "23baf5e885c0d2480b19": "Winterhoof? Jeg hører, at han rigtig lever livet i Booty Bay.",
        "36e8f1b9e416e8668826": "Ældste Stormbrow er sandsynligvis i landsbyen Goldshire i Elwynn Forest.",
        "3c7c8b96d893864ccd99": "Sidst jeg hørte, var ældste Starsong i det sunkne tempel i Swamp of Sorrows.",
        "48c491b478b60cfec92b": "For længe siden levede vi for jagten. Vi jagede for hæder og ære...$B$BEr det så anderledes nu?"
      },
      "name": "Ældste Skychaser",
      "translationMetadata": {
