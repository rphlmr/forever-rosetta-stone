  "locales": {
    "csCZ": {
      "dialogue": {
        "2445c9af26069e00b77a": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se předtím naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější. Proto je také každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "55cbbe6b231e10e5f3a2": "S výcvikem ti nemohu pomoci. Měl bys vyhledat trenéra pro $c.",
        "72422cb352479c39bad3": "Než začneš lovit, je moudré se někoho zeptat, co vlastně hledáš.",
        "7cc37269693b25dc24ec": "Chtěl bych trénovat.",
        "f28846b69ce7ae7c841f": "Co pro tebe mohu udělat?"
      },
      "name": "Grif Wildheart",
      "translationMetadata": {
        "fields": {
          "dialogue.2445c9af26069e00b77a": {
