  "locales": {
    "csCZ": {
      "dialogue": {
        "c98c55aaddb1a3f553fa": "Buď zdráv, dobrodruhu. Jsem Rin’wosho, obchodník ze Zuldazaru. Přicházím z Jižních moří a přináším ze své vlasti mnoho exotického zboží a předmětů.$B$BMožná budu obchodovat, pokud prokážeš svou hodnotu mému kmeni. A pokud máš některé čestné žetony mého kmene, možná budeme obchodovat ještě víc."
      },
      "name": "Rin'wosho Obchodník",
      "translationMetadata": {
        "fields": {
          "dialogue.c98c55aaddb1a3f553fa": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "c98c55aaddb1a3f553fa": "Vær hilset, eventyrer. Jeg er Rin’wosho, handelsmand fra Zuldazar. Jeg kommer fra Sydhavet og bringer mange eksotiske varer og genstande fra mit hjemland.$B$BMåske vil jeg handle, hvis du viser mit folk dit værd. Har du nogen af min stammes ærestegn, kan vi måske handle endnu mere."
      },
      "name": "Rin'wosho handelsmanden",
      "translationMetadata": {
        "fields": {
          "dialogue.c98c55aaddb1a3f553fa": {
