    "ltLT": {
      "dialogue": {
        "04e95e49050ec41551e8": "Kaip manai, ko galėčiau tave išmokyti? Roxxik tai padarytų kur kas geriau. Jį rasi Orgrimmare. O dabar dink!",
        "2d42b0cadbfee7c3a937": "Neturiu laiko tuštiems plepalams, aš esu profesionalas!",
        "4df088e18718a5b71453": "Tai tik mano ir tavo laiko švaistymas! Jei nori pradėti mokytis, eik pas Graham Van Talen! Jis stovi ten, man iš kairės.",
        "8320fb0548cc78257550": "Išmokyk mane.",
        "d07ae79765437ed0f708": "Pažiūrėkime, ką sugebi, gerai? Jei atliksi šią užduotį taip, kaip man patinka, skirsiu laiko tave pamokyti!"
      },
      "name": "Franklin Lloyd",
      "subName": "Patyręs inžinierius",
      "translationMetadata": {
