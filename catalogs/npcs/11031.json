  "locales": {
    "csCZ": {
      "dialogue": {
        "04e95e49050ec41551e8": "Co myslíš, že bych tě mohl naučit? Roxxik by to zvládl mnohem lépe. Najdeš ho v Orgrimmaru. A teď zmiz!",
        "2d42b0cadbfee7c3a937": "Nemám čas na plané řeči, jsem profesionál!",
        "4df088e18718a5b71453": "Tohle je ztráta času, mého i tvého! Chceš-li začít s výukou, zajdi za Grahamem Van Talenem! Stojí tamhle po mé levici.",
        "8320fb0548cc78257550": "Vycvičte mě.",
        "d07ae79765437ed0f708": "Podívejme se, jak jsi schopný, ano? Pokud tento úkol splníš k mé spokojenosti, udělám si čas tě učit!"
      },
      "name": "Franklin Lloyd",
      "translationMetadata": {
        "fields": {
