    "daDK": {
      "dialogue": {
        "04e95e49050ec41551e8": "Hvad tror du, jeg kan lære dig? Roxxik ville gøre det meget bedre. Du kan finde ham i Orgrimmar. Forsvind så!",
        "2d42b0cadbfee7c3a937": "Jeg har ikke tid til tom snak, jeg er professionel!",
        "4df088e18718a5b71453": "Det er spild af både min og din tid! Gå til Graham Van Talen, hvis du vil begynde din oplæring! Han står derovre til venstre for mig.",
        "8320fb0548cc78257550": "Træn mig.",
        "d07ae79765437ed0f708": "Lad os se, hvor dygtig du er, skal vi? Hvis du udfører denne opgave tilfredsstillende, vil jeg bruge tid på at undervise dig!"
      },
      "name": "Franklin Lloyd",
      "translationMetadata": {
        "fields": {
