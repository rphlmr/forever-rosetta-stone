    "hrHR": {
      "dialogue": {
        "229154e6ebb453e643de": "Starješinu Brightspeara možeš pronaći kako luta među ruševinama Kel'Therila u Winterspringu.",
        "2318978c4f498f05e9c1": "U davnim smo danima živjeli za lov. Lovili smo za slavu, za čast...$B$BJe li sada toliko drukčije?",
        "6d2e013ca5ef5b55e9e1": "Starješina Nightwind provodi dane kod svetišta u Jaedenaru u Felwoodu.",
        "9f41b320796c5143cb57": "Selo Astranaar u Ashenvaleu trenutačni je dom starješine Riversonga."
      },
      "name": "Starješina Stonespire",
