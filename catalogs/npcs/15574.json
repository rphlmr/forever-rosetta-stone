    "deDE": {
      "dialogue": {
        "229154e6ebb453e643de": "Urahnin Brightspear wandert in den Ruinen von Kel'Theril in Winterspring umher.",
        "2318978c4f498f05e9c1": "In längst vergangenen Tagen lebten wir für die Jagd. Wir jagten nach Ruhm, nach Ehre…\n\nIst jetzt alles anders?",
        "6d2e013ca5ef5b55e9e1": "Urahne Nightwind verbringt seine Zeit in dem Schrein in Jaedenar im Teufelswald.",
        "9f41b320796c5143cb57": "Das Dorf Astranaar in Ashenvale ist Urahnin Riversongs momentanes Zuhause."
      },
      "name": "Urahne Stonespire",
