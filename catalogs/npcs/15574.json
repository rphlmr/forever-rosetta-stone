  "locales": {
    "csCZ": {
      "dialogue": {
        "229154e6ebb453e643de": "Starší Brightspear se potuluje mezi troskami Kel'Therilu ve Winterspringu.",
        "2318978c4f498f05e9c1": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "6d2e013ca5ef5b55e9e1": "Starší Nightwind tráví své dny u svatyně v Jaedenaru ve Felwoodu.",
        "9f41b320796c5143cb57": "Starší Riversong nyní žije ve vesnici Astranaar v Ashenvale."
      },
      "name": "Starší Stonespire",
      "translationMetadata": {
