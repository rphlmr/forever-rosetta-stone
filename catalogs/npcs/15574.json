    "enUS": {
      "dialogue": {
        "229154e6ebb453e643de": "Elder Brightspear can be found wandering amongst the ruins of Kel'Theril in Winterspring.",
        "2318978c4f498f05e9c1": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "6d2e013ca5ef5b55e9e1": "Elder Nightwind passes the days at the shrine in Jaedenar in Felwood.",
        "9f41b320796c5143cb57": "The village of Astranaar in Ashenvale is Elder Riversong's current home."
      },
      "name": "Elder Stonespire",
