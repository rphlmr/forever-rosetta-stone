    "plPL": {
      "dialogue": {
        "229154e6ebb453e643de": "Starszego Brightspeara można spotkać w ruinach Kel'Theril w Winterspring.",
        "2318978c4f498f05e9c1": "W dawnych czasach żyliśmy dla polowania. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest tak inaczej?",
        "6d2e013ca5ef5b55e9e1": "Starszy Nightwind spędza dni przy świątyni w Jaedenarze w Felwood.",
        "9f41b320796c5143cb57": "Wioska Astranaar w Ashenvale jest obecnie domem starszego Riversonga."
      },
      "name": "Starszy Stonespire",
