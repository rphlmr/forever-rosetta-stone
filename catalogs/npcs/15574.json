    "ltLT": {
      "dialogue": {
        "229154e6ebb453e643de": "Senolį Brightspear rasi klaidžiojantį po Kel'Theril griuvėsius Winterspring krašte.",
        "2318978c4f498f05e9c1": "Senais laikais gyvenome medžiokle.  Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "6d2e013ca5ef5b55e9e1": "Senolis Nightwind leidžia dienas prie šventyklos Jaedenar, Felwood miške.",
        "9f41b320796c5143cb57": "Dabar senolis Riversong gyvena Astranaar kaime, Ashenvale miške."
      },
      "name": "Senolis Stonespire",
