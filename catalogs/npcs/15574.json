    "svSE": {
      "dialogue": {
        "229154e6ebb453e643de": "Äldste Brightspear vandrar bland ruinerna av Kel'Theril i Winterspring.",
        "2318978c4f498f05e9c1": "I svunna tider levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "6d2e013ca5ef5b55e9e1": "Äldste Nightwind tillbringar dagarna vid helgedomen i Jaedenar i Felwood.",
        "9f41b320796c5143cb57": "Byn Astranaar i Ashenvale är äldste Riversongs nuvarande hem."
      },
      "name": "Äldste Stonespire",
