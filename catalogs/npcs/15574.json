    "daDK": {
      "dialogue": {
        "229154e6ebb453e643de": "Ældste Brightspear vandrer omkring i ruinerne af Kel'Theril i Winterspring.",
        "2318978c4f498f05e9c1": "I svundne tider levede vi for jagten. Vi jagede for hæder og ære...$B$BEr det så anderledes nu?",
        "6d2e013ca5ef5b55e9e1": "Ældste Nightwind tilbringer dagene ved helligdommen i Jaedenar i Felwood.",
        "9f41b320796c5143cb57": "Ældste Riversong bor nu i landsbyen Astranaar i Ashenvale."
      },
      "name": "Ældste Stonespire",
      "translationMetadata": {
