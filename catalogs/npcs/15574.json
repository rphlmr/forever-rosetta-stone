    "trTR": {
      "dialogue": {
        "229154e6ebb453e643de": "Yaşlı Brightspear, Winterspring'deki Kel'Theril harabeleri arasında dolaşır.",
        "2318978c4f498f05e9c1": "Çok eskiden av için yaşardık. Şan için, onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "6d2e013ca5ef5b55e9e1": "Yaşlı Nightwind, günlerini Felwood’daki Jaedenar tapınağında geçirir.",
        "9f41b320796c5143cb57": "Yaşlı Riversong şu anda Ashenvale’deki Astranaar köyünde yaşıyor."
      },
      "name": "Ulu Stonespire",
