      "dialogue": {
        "4f0d81549f48901c22c2": "Hello, $n. If you'd like to learn a thing or two about cooking, please visit me at any time.",
        "7b92dc7e96d662caa311": "I'd like to train in cooking.",
        "7bfb10acb09eb7428abd": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\"."
      },
      "name": "Zarrin",
      "subName": "Cook",
