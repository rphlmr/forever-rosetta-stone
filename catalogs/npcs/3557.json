  "locales": {
    "csCZ": {
      "dialogue": {
        "2593e042bdc03b572431": "Ach ano, další, kdo bude rozdmýchávat výhně a kovat válečné zbraně. Samozřejmě tě to naučím.",
        "4b904265915addb1d23c": "Vycvičte mě.",
        "5156d666416e6ccc12ae": "Tvým vyrušováním ztrácím drahocenný čas, tak ať to stojí za to.",
        "83f7dee36b36e968bbc1": "Učil ses dobře, dítě. Jdi do Undercity a najdi kováře jménem James Van Brunt. Naučí tě mnoho z toho, co já nemohu. Pokud vím, tráví čas poblíž výcvikové síně válečníků a kuje jim zbraně a zbroje."
      },
      "name": "Guillaume Sorouy",
      "translationMetadata": {
        "fields": {
          "dialogue.2593e042bdc03b572431": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
