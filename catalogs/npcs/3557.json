    },
    "daDK": {
      "dialogue": {
        "2593e042bdc03b572431": "Ah ja, endnu en, der vil holde ilden i gang og smede krigens våben. Selvfølgelig vil jeg lære dig hvordan.",
        "4b904265915addb1d23c": "Træn mig.",
        "5156d666416e6ccc12ae": "Din afbrydelse koster mig værdifuld tid, så det må hellere være vigtigt.",
        "83f7dee36b36e968bbc1": "Du har lært godt, mit barn. Tag til Undercity og find en smed ved navn James Van Brunt. Han kan lære dig meget, som jeg ikke kan. Jeg har hørt, at han holder til nær krigernes træningssal og smeder deres våben og rustninger."
      },
      "name": "Guillaume Sorouy",
      "translationMetadata": {
        "fields": {
          "dialogue.2593e042bdc03b572431": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
