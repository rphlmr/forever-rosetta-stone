    },
    "ltLT": {
      "dialogue": {
        "86895468816d32712a05": "Nuo šios prieplaukos gali nuplaukti į Theramore.  Įsidėmėk mano žodžius: Aljanso žmonėms keliauti po tas žemes retai būna saugu.  Žiūrėk po kojomis ir saugok savo nugarą."
      },
      "name": "Adam Lind",
      "translationMetadata": {
