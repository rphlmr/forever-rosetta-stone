    "hrHR": {
      "dialogue": {
        "86895468816d32712a05": "S ovog pristaništa možeš otputovati u Theramore. Poslušaj me: te su zemlje rijetko sigurne za putnike iz Saveza. Pazi kamo staješ i čuvaj leđa."
      },
      "name": "Adam Lind",
      "translationMetadata": {
        "fields": {
