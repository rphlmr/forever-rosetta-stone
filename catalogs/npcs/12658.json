    "enUS": {
      "dialogue": {
        "86895468816d32712a05": "You can find passage to Theramore from this dock.  Heed my words, those lands are rarely safe to travel for people of the Alliance.  Watch your step and your back."
      },
      "name": "Adam Lind",
      "translationMetadata": {
        "fields": {
          "dialogue.86895468816d32712a05": {
