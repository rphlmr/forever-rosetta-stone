    },
    "trTR": {
      "dialogue": {
        "86895468816d32712a05": "Bu iskeleden Theramore’a ulaşabilirsin. Sözümü dinle: O topraklarda yolculuk etmek İttifak halkı için nadiren güvenlidir. Adımlarına dikkat et ve arkana göz kulak ol."
      },
      "name": "Adam Lind",
      "translationMetadata": {
