    },
    "ptBR": {
      "dialogue": {
        "86895468816d32712a05": "Você pode embarcar para Theramore nesta doca. Preste atenção em minhas palavras, aquelas terras raramente são seguras para os membros da Aliança. Todo cuidado é pouco."
      },
      "name": "Adão Lind",
      "translationMetadata": {
