    },
    "esES": {
      "dialogue": {
        "86895468816d32712a05": "En este embarcadero puedes encontrar un pasaje a Theramore. Haz caso de lo que digo, esas tierras no son un lugar seguro para la Alianza. Cuidado con dónde pisas y vigila tu espalda."
      },
      "name": "Adam Lind",
      "translationMetadata": {
