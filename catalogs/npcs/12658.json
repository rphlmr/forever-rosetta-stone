    },
    "plPL": {
      "dialogue": {
        "86895468816d32712a05": "Z tego nabrzeża możesz dostać się do Theramore. Posłuchaj mnie: podróżowanie po tamtych ziemiach rzadko bywa bezpieczne dla członków Przymierza. Uważaj na każdy krok i strzeż swoich pleców."
      },
      "name": "Adam Lind",
      "translationMetadata": {
        "fields": {
