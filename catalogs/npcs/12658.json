    "frFR": {
      "dialogue": {
        "86895468816d32712a05": "Vous trouverez un passage vers Theramore depuis ce dock. Mais écoutez-moi bien : il est dangereux de traverser ces terres pour les membres de l'Alliance. Protégez vos arrières."
      },
      "name": "Adam Lind",
      "translationMetadata": {
        "fields": {
