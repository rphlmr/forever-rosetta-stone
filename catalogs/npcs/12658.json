            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "86895468816d32712a05": "Fra denne kaj kan du komme til Theramore. Hør mine ord: Det er sjældent sikkert for Alliancens folk at rejse i de egne. Se dig godt for og pas på din ryg."
      },
      "name": "Adam Lind",
      "translationMetadata": {
        "fields": {
          "dialogue.86895468816d32712a05": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
