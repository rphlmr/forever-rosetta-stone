  "locales": {
    "csCZ": {
      "dialogue": {
        "86895468816d32712a05": "Z tohoto přístaviště se můžeš dostat do Theramore. Poslechni mou radu: pro lidi z Aliance je cestování těmito kraji jen málokdy bezpečné. Dávej si pozor na každý krok i na svá záda."
      },
      "name": "Adam Lind",
      "translationMetadata": {
        "fields": {
          "dialogue.86895468816d32712a05": {
