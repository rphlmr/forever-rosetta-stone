    "plPL": {
      "dialogue": {
        "710c32714f348a01cae9": "Gwiazdy tych czasów podążają nowymi ścieżkami, będąc latarniami nadziei i siły dla nadchodzących epok.",
        "78d9ea1e0fde9522a209": "Ostatnio słyszałem, że starszy Stonespire przebywał w Everlook w Winterspring.",
        "a3ac900307511f43fc8a": "Starszy Nightwind spędza dni w sanktuarium w Jaedenar w Felwood."
      },
      "name": "Starsza Brightspear",
