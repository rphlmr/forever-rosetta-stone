  "locales": {
    "csCZ": {
      "dialogue": {
        "710c32714f348a01cae9": "Hvězdy tohoto času se vydávají novými cestami, jsou majáky naděje a síly pro nadcházející věky.",
        "78d9ea1e0fde9522a209": "Naposledy jsem slyšel, že starší Stonespire je v Everlooku ve Winterspringu.",
        "a3ac900307511f43fc8a": "Starší Nightwind tráví dny ve svatyni v Jaedenaru ve Felwoodu."
      },
      "name": "Starší Brightspear",
      "translationMetadata": {
        "fields": {
          "dialogue.710c32714f348a01cae9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
