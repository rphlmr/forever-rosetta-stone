    "enUS": {
      "dialogue": {
        "710c32714f348a01cae9": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "78d9ea1e0fde9522a209": "Last I knew, Elder Stonespire was at Everlook in Winterspring.",
        "a3ac900307511f43fc8a": "Elder Nightwind passes the days at the shrine in Jaedenar in Felwood."
      },
      "name": "Elder Brightspear",
      "translationMetadata": {
