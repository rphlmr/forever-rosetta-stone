    "hrHR": {
      "dialogue": {
        "710c32714f348a01cae9": "Zvijezde ovog doba kreću novim putovima, svjetionici nade i snage za nadolazeća vremena.",
        "78d9ea1e0fde9522a209": "Koliko znam, starješina Stonespire bio je u Everlooku u Winterspringu.",
        "a3ac900307511f43fc8a": "Starješina Nightwind provodi dane u svetištu u Jaedenaru u Felwoodu."
