      }
    },
    "daDK": {
      "dialogue": {
        "710c32714f348a01cae9": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "78d9ea1e0fde9522a209": "Sidst jeg hørte, var Elder Stonespire i Everlook i Winterspring.",
        "a3ac900307511f43fc8a": "Elder Nightwind tilbringer dagene ved helligdommen i Jaedenar i Felwood."
      },
      "name": "Ældste Brightspear",
      "translationMetadata": {
        "fields": {
