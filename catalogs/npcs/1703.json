    "ptBR": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Excelente! Tava querendo mesmo um novo aluno. Bem, vamos começar já!",
        "18bef3556139dcff40c8": "Bem-vindo à minha loja. O que posso fazer por ti?",
        "4632542a6ce5316cfb83": "Calma aí, sou apenas um assistente. Se tu quer aprender coisas caprichadas, fale com o velho Cervapétrea logo ali.",
        "9b02b1d738c95794c28f": "Treine-me."
      },
      "name": "Uthrar Threx",
      "subName": "Alfaiate Profissional",
