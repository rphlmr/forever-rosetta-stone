    "itIT": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Eccellente! Speravo proprio in un nuovo allievo. Bene, cominciamo subito!",
        "18bef3556139dcff40c8": "Benvenuto nella mia bottega. Cosa posso fare per te?",
        "4632542a6ce5316cfb83": "Piano, piano, io sono solo un assistente. Se vuoi cominciare a imparare la roba fina, parla col vecchio Stonebrew, laggiù.",
        "9b02b1d738c95794c28f": "Addestrami."
      },
      "name": "Uthrar Threx",
