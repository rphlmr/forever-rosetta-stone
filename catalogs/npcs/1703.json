  "locales": {
    "csCZ": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Výborně! Už jsem doufal v nového žáka. Tak se do toho hned pustíme!",
        "18bef3556139dcff40c8": "Vítej v mém obchodě. Co pro tebe mohu udělat?",
        "4632542a6ce5316cfb83": "Počkej, jsem jen pomocník. Jestli se chceš naučit pokročilé věci, promluv si s tamhle starým Stonebrewem.",
        "9b02b1d738c95794c28f": "Vycvičte mě."
      },
      "name": "Uthrar Threx",
      "translationMetadata": {
        "fields": {
