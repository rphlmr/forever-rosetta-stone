    "enUS": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Excellent! I've been hopin' for a new student. Well, let's get started right away then!",
        "18bef3556139dcff40c8": "Welcome to me shop. What can I do for ye'?",
        "4632542a6ce5316cfb83": "Hold on there, I'm just an assistant. If ye want to start learnin' the fancy stuff, talk to old Stonebrew over there.",
        "9b02b1d738c95794c28f": "Train me."
      },
      "name": "Uthrar Threx",
      "subName": "Journeyman Tailor",
      "translationMetadata": {
