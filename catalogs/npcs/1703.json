    "ltLT": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Puiku! Kaip tik laukiau naujo mokinio. Na, tada iškart ir pradėkime!",
        "18bef3556139dcff40c8": "Sveiki atvykę į mano krautuvę. Kuo galiu padėti?",
        "4632542a6ce5316cfb83": "Palaukite, aš tik padėjėjas. Jei norite išmokti sudėtingesnių dalykų, pasikalbėkite su senuoju Stonebrew tenai.",
        "9b02b1d738c95794c28f": "Pamokyk mane."
      },
      "name": "Uthrar Threx",
      "subName": "Siuvėjo meistras",
