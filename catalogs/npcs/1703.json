    "trTR": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Harika! Yeni bir öğrenci bekliyordum. Öyleyse hemen başlayalım!",
        "18bef3556139dcff40c8": "Dükkânıma hoş geldin. Senin için ne yapabilirim?",
        "4632542a6ce5316cfb83": "Dur bakalım, ben sadece bir yardımcıyım. İleri şeyleri öğrenmek istiyorsan şuradaki ihtiyar Stonebrew ile konuş.",
        "9b02b1d738c95794c28f": "Beni eğit."
      },
      "name": "Uthrar Threx",
