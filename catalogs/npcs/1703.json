    "daDK": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Fremragende! Jeg har håbet på en ny elev. Lad os komme i gang med det samme!",
        "18bef3556139dcff40c8": "Velkommen til min butik. Hvad kan jeg gøre for dig?",
        "4632542a6ce5316cfb83": "Vent lidt, jeg er kun assistent. Hvis du vil lære de avancerede ting, så tal med gamle Stonebrew derovre.",
        "9b02b1d738c95794c28f": "Træn mig."
      },
      "name": "Uthrar Threx",
      "translationMetadata": {
        "fields": {
