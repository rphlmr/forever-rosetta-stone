    "plPL": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Doskonale! Liczyłem na nowego ucznia. No to zaczynajmy od razu!",
        "18bef3556139dcff40c8": "Witaj w moim sklepie. Co mogę dla ciebie zrobić?",
        "4632542a6ce5316cfb83": "Chwileczkę, jestem tylko pomocnikiem. Jeśli chcesz poznać bardziej zaawansowane rzeczy, porozmawiaj ze starym Stonebrewem tam.",
        "9b02b1d738c95794c28f": "Wyszkol mnie."
      },
