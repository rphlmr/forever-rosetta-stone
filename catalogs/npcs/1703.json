    "svSE": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Utmärkt! Jag har hoppats på en ny elev. Då sätter vi igång genast!",
        "18bef3556139dcff40c8": "Välkommen till min butik. Vad kan jag göra för dig?",
        "4632542a6ce5316cfb83": "Vänta lite, jag är bara assistent. Om du vill lära dig de mer avancerade sakerna får du prata med gamle Stonebrew där borta.",
        "9b02b1d738c95794c28f": "Träna mig."
      },
      "name": "Uthrar Threx",
