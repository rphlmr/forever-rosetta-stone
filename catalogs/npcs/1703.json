    "esES": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "¡Fantástico! Estaba esperando que llegase un nuevo estudiante. ¡Bueno, pues comencemos ahora mismo!",
        "18bef3556139dcff40c8": "Encantado de tenerte en mi tienda. ¿Qué puedo hacer por ti?",
        "4632542a6ce5316cfb83": "Espera, solo soy un ayudante. Si quieres empezar a aprender las cosas elegantes, habla con Stonebrew, está ahí.",
        "9b02b1d738c95794c28f": "Entréname."
      },
      "name": "Uthrar Threx",
      "subName": "Oficial de sastrería",
