    "hrHR": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Izvrsno! Nadao sam se novom učeniku. Onda krenimo odmah!",
        "18bef3556139dcff40c8": "Dobro došao u moju trgovinu. Kako ti mogu pomoći?",
        "4632542a6ce5316cfb83": "Čekaj malo, ja sam samo pomoćnik. Ako želiš naučiti napredne stvari, razgovaraj sa starim Stonebrewom tamo.",
        "9b02b1d738c95794c28f": "Podučite me."
      },
      "name": "Uthrar Threx",
