    "frFR": {
      "dialogue": {
        "0aa381584ef40b9bc2c3": "Excellent ! J'attendais un nouvel apprenti. Commençons sans plus tarder !",
        "18bef3556139dcff40c8": "Bienvenue dans mon échoppe ! Que puis-je faire pour vous ?",
        "4632542a6ce5316cfb83": "Attendez, je ne suis qu'un assistant. Si vous voulez commencer à apprendre des choses un peu plus élaborées, adressez-vous au vieux Stonebrew, là-bas.",
        "9b02b1d738c95794c28f": "Entraînez-moi."
      },
      "name": "Uthrar Threx",
      "subName": "Tailleur - Compagnon",
