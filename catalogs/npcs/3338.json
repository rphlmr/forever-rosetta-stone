    "daDK": {
      "dialogue": {
        "80b0d7cfe4d770e1226a": "Jeg vil gerne se dine varer.",
        "bd5c2e47b045331a1983": "Træn mig.",
        "decbac78a33815840d83": "Landet, vandet og himlen er ét. Det er dine øjne, der bedrager dig og får dig til at se dem som adskilte. Jordmoderen er alt dette og mere til."
