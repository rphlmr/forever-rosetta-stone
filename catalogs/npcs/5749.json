    "deDE": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "abde286d0f19562641e7": "Zeigt mir Eure Auswahl an Grimoires.",
        "f0618f42790a371837ad": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!"
      },
      "name": "Kayla Smithe",
      "subName": "Dämonenausbilderin",
