    "frFR": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Vous voulez que vos démons soient plus puissants ? Cela vous coûtera cher, mais vous êtes au bon endroit.",
        "abde286d0f19562641e7": "Montrez-moi vos grimoires.",
        "f0618f42790a371837ad": "Vous n'êtes pas démoniste et je n'ai pas de temps pour vous. Filez !"
      },
      "name": "Kayla Smithe",
      "subName": "Maître des démons",
