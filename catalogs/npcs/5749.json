    "hrHR": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Želiš ojačati svoje demone? To će te koštati, ali na pravom si mjestu.",
        "abde286d0f19562641e7": "Pokažite mi svoj izbor grimoara.",
        "f0618f42790a371837ad": "Nisi čarobnjak i nemam vremena za tebe. Gubi se!"
