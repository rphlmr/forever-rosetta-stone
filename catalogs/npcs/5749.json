  "locales": {
    "csCZ": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě.",
        "abde286d0f19562641e7": "Ukažte mi svou nabídku grimoárů.",
        "f0618f42790a371837ad": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!"
      },
      "name": "Kayla Smithe",
      "translationMetadata": {
        "fields": {
          "dialogue.571131f0cf4ac18c3347": {
