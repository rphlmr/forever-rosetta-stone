    "ltLT": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Nori sustiprinti savo demonus? Tai kainuos, bet atėjai ten, kur reikia.",
        "abde286d0f19562641e7": "Parodyk man savo grimuarus.",
        "f0618f42790a371837ad": "Tu ne kerėtojas, ir aš neturiu tau laiko. Nešdinkis!"
