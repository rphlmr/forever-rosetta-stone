    "svSE": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Vill du göra dina demoner starkare? Det kommer att kosta, men du har kommit till rätt ställe.",
        "abde286d0f19562641e7": "Visa mig ditt utbud av grimorier.",
        "f0618f42790a371837ad": "Du är ingen häxmästare och jag har inte tid med dig. Försvinn!"
      },
      "name": "Kayla Smithe",
