    },
    "daDK": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted.",
        "abde286d0f19562641e7": "Vis mig dit udvalg af grimoirer.",
        "f0618f42790a371837ad": "Du er ikke en troldmand, og jeg har ikke tid til dig. Forsvind!"
      },
      "name": "Kayla Smithe",
      "translationMetadata": {
        "fields": {
          "dialogue.571131f0cf4ac18c3347": {
