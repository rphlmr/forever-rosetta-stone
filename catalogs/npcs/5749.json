    "trTR": {
      "dialogue": {
        "571131f0cf4ac18c3347": "İblislerini güçlendirmek mi istiyorsun? Sana pahalıya mal olur ama doğru yerdesin.",
        "abde286d0f19562641e7": "Bana büyü kitabı seçkini göster.",
        "f0618f42790a371837ad": "Sen bir kara büyücü değilsin ve sana ayıracak vaktim yok. Defol!"
      },
      "name": "Kayla Smithe",
      "translationMetadata": {
