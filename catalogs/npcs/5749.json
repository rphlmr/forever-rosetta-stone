    "plPL": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Chcesz wzmocnić swoje demony? Będzie cię to kosztować, ale dobrze trafiasz.",
        "abde286d0f19562641e7": "Pokaż mi swoją ofertę grymuarów.",
        "f0618f42790a371837ad": "Nie jesteś czarnoksiężnikiem i nie mam dla ciebie czasu. Precz!"
