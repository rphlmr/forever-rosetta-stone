    "enUS": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place.",
        "abde286d0f19562641e7": "Show me your selection of grimoires.",
        "f0618f42790a371837ad": "You're no warlock and I've no time for you.  Begone!"
      },
      "name": "Kayla Smithe",
      "subName": "Demon Trainer",
