    "itIT": {
      "dialogue": {
        "571131f0cf4ac18c3347": "Vuoi rendere più potenti i tuoi demoni? Ti costerà, ma sei nel posto giusto.",
        "abde286d0f19562641e7": "Mostrami la tua selezione di grimori.",
        "f0618f42790a371837ad": "Non sei uno stregone e non ho tempo per te. Vattene!"
