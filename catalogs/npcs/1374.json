    "daDK": {
      "dialogue": {
        "8ac832e54d93d4d365b7": "Træn mig.",
        "cace29254894e41d5612": "Jeg vil gerne se dine varer.",
        "f16c19ca5f23324372ed": "Forbandede Bryggerlaug! De har adgang til alle de bedste ingredienser, mens vi må slide for at finde korn og humle!$B$BJeg ville gerne give dem en smagsprøve på bitter retfærdighed..."
      },
      "name": "Rejold Barleybrew",
      "translationMetadata": {
