    "csCZ": {
      "dialogue": {
        "8ac832e54d93d4d365b7": "Vycvičte mě.",
        "cace29254894e41d5612": "Rád bych si prohlédl vaše zboží.",
        "f16c19ca5f23324372ed": "Prokletá Liga pivovarníků! Mají přístup ke všem nejlepším přísadám, zatímco my tu sháníme obilí a chmel!$B$BRád bych jim dopřál trochu hořké spravedlnosti..."
      },
      "name": "Rejold Barleybrew",
