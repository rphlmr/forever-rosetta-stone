    "deDE": {
      "dialogue": {
        "8ac832e54d93d4d365b7": "Bildet mich aus.",
        "cace29254894e41d5612": "Ich möchte Eure Waren ansehen.",
        "f16c19ca5f23324372ed": "Verflucht sei der Brauereiverband!  Sie haben Zugang zu all den besten Zutaten, während wir hier festsitzen und für Getreide und Hopfen schuften müssen!\n\nIch würde ihnen wirklich gerne etwas bitter schmeckendes zukommen lassen..."
      },
      "name": "Rejold Gerstenbräu",
      "translationMetadata": {
