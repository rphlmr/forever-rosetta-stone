    "daDK": {
      "dialogue": {
        "18cde09bb66744e18a7d": "Dine evner er fremragende! Du er virkelig inspireret. Hvis du vil fortsætte din søgen efter viden, så tal med Georgio Bolero i Stormwind. Han er højt anset og kan undervise dig videre.",
        "2dac935f077e3a95f088": "Sikke en dejlig dag! Den inspirerer mig til at skabe et nyt design.",
        "394253365648a6ed8442": "Du har klaret dig godt, rejsende. Jeg er stolt af at kalde dig min elev!",
        "e2ed08dbda04395b2f1b": "Der er grundlæggende ting, du må lære. Trianna står lige i nærheden; tal med hende og kom tilbage til mig senere.",
        "e44c4d935f6225734015": "Træn mig."
      },
      "name": "Me'lynn",
      "translationMetadata": {
        "fields": {
