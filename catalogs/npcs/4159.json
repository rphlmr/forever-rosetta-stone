    "plPL": {
      "dialogue": {
        "18cde09bb66744e18a7d": "Twój talent jest niezwykły! Naprawdę przepełnia cię natchnienie. Aby dalej zdobywać wiedzę, porozmawiaj z Georgiem Bolero w Stormwind. Jest bardzo szanowany i może kontynuować twoją naukę.",
        "2dac935f077e3a95f088": "Co za piękny dzień! Inspiruje mnie do stworzenia nowego projektu.",
        "394253365648a6ed8442": "Dobra robota, podróżniku. Jestem dumna, że mogę nazwać cię swoim uczniem!",
        "e2ed08dbda04395b2f1b": "Najpierw trzeba poznać podstawy. Trianna stoi niedaleko, porozmawiaj z nią i wróć do mnie później.",
        "e44c4d935f6225734015": "Wyszkol mnie."
      },
      "name": "Me'lynn",
