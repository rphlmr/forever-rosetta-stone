    "enUS": {
      "dialogue": {
        "18cde09bb66744e18a7d": "Your talents excel! You are truly inspired. To continue your pursuit of knowledge, speak with Georgio Bolero in Stormwind. He is held in high regard, and will be able to further your instruction.",
        "2dac935f077e3a95f088": "What a fine day! It inspires me to create a new design.",
        "394253365648a6ed8442": "You have done well, traveler. I am proud to call you my student!",
        "e2ed08dbda04395b2f1b": "There are basics that must be learned. Trianna is standing nearby, speak with her and return to me later.",
        "e44c4d935f6225734015": "Train me."
      },
      "name": "Me'lynn",
      "subName": "Expert Tailor",
      "translationMetadata": {
