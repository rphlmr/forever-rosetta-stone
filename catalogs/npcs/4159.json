    "ltLT": {
      "dialogue": {
        "18cde09bb66744e18a7d": "Tavo gabumai nepaprasti! Esi tikrai įkvėptas. Norėdamas toliau gilinti žinias, pasikalbėk su Georgio Bolero Stormwind mieste. Jis labai gerbiamas ir galės tave mokyti toliau.",
        "2dac935f077e3a95f088": "Kokia graži diena! Ji įkvepia mane sukurti naują dizainą.",
        "394253365648a6ed8442": "Puikiai padirbėjai, keliautojau. Didžiuojuosi galėdama vadinti tave savo mokiniu!",
        "e2ed08dbda04395b2f1b": "Pirmiausia reikia išmokti pagrindus. Netoliese stovi Trianna, pasikalbėk su ja ir vėliau sugrįžk pas mane.",
        "e44c4d935f6225734015": "Mokyk mane."
      },
      "name": "Me'lynn",
      "subName": "Siuvimo ekspertas",
