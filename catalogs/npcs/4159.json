    "hrHR": {
      "dialogue": {
        "18cde09bb66744e18a7d": "Tvoj talent je izvanredan! Doista si nadahnut. Za nastavak potrage za znanjem razgovaraj s Georgiom Bolerom u Stormwindu. Vrlo je cijenjen i može te dalje podučavati.",
        "2dac935f077e3a95f088": "Kakav divan dan! Nadahnjuje me da stvorim novi dizajn.",
        "394253365648a6ed8442": "Dobro si postupio, putniče. Ponosna sam što te mogu zvati svojim učenikom!",
        "e2ed08dbda04395b2f1b": "Moraš naučiti osnove. Trianna stoji u blizini, razgovaraj s njom pa mi se kasnije vrati.",
        "e44c4d935f6225734015": "Podučite me."
      },
      "name": "Me'lynn",
