  "locales": {
    "csCZ": {
      "dialogue": {
        "18cde09bb66744e18a7d": "Tvůj talent vyniká! Jsi opravdu plný inspirace. Chceš-li pokračovat v hledání vědomostí, promluv si s Georgiem Bolerem ve Stormwindu. Je velmi uznávaný a může tě dále učit.",
        "2dac935f077e3a95f088": "Jak krásný den! Inspiruje mě k vytvoření nového návrhu.",
        "394253365648a6ed8442": "Vedl sis dobře, poutníku. Jsem hrdá, že tě mohu nazývat svým žákem!",
        "e2ed08dbda04395b2f1b": "Nejprve se musíš naučit základy. Trianna stojí nedaleko, promluv si s ní a později se ke mně vrať.",
        "e44c4d935f6225734015": "Vycvičte mě."
      },
      "name": "Me'lynn",
      "translationMetadata": {
        "fields": {
