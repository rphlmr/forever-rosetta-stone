    "enUS": {
      "dialogue": {
        "8a932d064dd2ad4a0fa4": "The Carevin family fights for victory under the Light. My duty under the Light is to give my life in their battle against against the undead. Master Carevin has tasked me with the extermination of the vile worgen in Duskwood. Perhaps you would assit me?",
        "919df01f4e329f8b4543": "I want to browse your goods.",
        "a051b53af201cc838f16": "Train me."
      },
      "name": "Calor",
