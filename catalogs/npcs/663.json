  "locales": {
    "csCZ": {
      "dialogue": {
        "8a932d064dd2ad4a0fa4": "Rodina Carevinů bojuje za vítězství pod Světlem. Mou povinností vůči Světlu je položit život v jejich boji proti nemrtvým. Mistr Carevin mě pověřil vyhlazením odporných worgenů v Duskwoodu. Možná bys mi mohl pomoci?",
        "919df01f4e329f8b4543": "Rád bych si prohlédl vaše zboží.",
        "a051b53af201cc838f16": "Vycvičte mě."
      },
      "name": "Calor",
      "translationMetadata": {
