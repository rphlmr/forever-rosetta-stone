    "hrHR": {
      "dialogue": {
        "8a932d064dd2ad4a0fa4": "Obitelj Carevin bori se za pobjedu pod Svjetlom. Moja je dužnost pod Svjetlom dati život u njihovoj borbi protiv nemrtvih. Gospodar Carevin zadužio me da istrijebim podle worgene u Duskwoodu. Možda bi mi mogao pomoći?",
        "919df01f4e329f8b4543": "Želim pogledati vašu robu.",
        "a051b53af201cc838f16": "Podučite me."
      },
      "name": "Calor",
