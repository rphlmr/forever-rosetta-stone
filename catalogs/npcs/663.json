    "daDK": {
      "dialogue": {
        "8a932d064dd2ad4a0fa4": "Familien Carevin kæmper for sejr under Lyset. Min pligt under Lyset er at give mit liv i deres kamp mod de udøde. Mester Carevin har pålagt mig at udrydde de modbydelige worgen i Duskwood. Vil du måske hjælpe mig?",
        "919df01f4e329f8b4543": "Jeg vil gerne se dine varer.",
        "a051b53af201cc838f16": "Træn mig."
      },
      "name": "Calor",
      "translationMetadata": {
        "fields": {
