    "enUS": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\".",
        "176ac016802307bcda27": "I can teach you how to cook!",
        "ac43b1c95427547c5f7f": "Train me.",
        "d208401a5a99b05fa820": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "f69337c7c72bd38c9a14": "Cooking is a life long pursuit and I see we share the same passion!"
      },
      "name": "Tomas",
      "subName": "Cook",
