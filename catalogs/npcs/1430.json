    "frFR": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Allez voir Shandrina au refuge de Vent-argent. Elle pourra vous vendre un livre de cuisine pour experts.",
        "176ac016802307bcda27": "Je peux vous apprendre à cuisiner !",
        "ac43b1c95427547c5f7f": "Entraînez-moi.",
        "d208401a5a99b05fa820": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "f69337c7c72bd38c9a14": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !"
      },
      "name": "Tomas",
      "subName": "Cuisinier",
