    "trTR": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Silverwind Refuge’ta Shandrina’yı bul. Sana “Uzman Yemek Kitabı”nı satabilir.",
        "176ac016802307bcda27": "Sana yemek yapmayı öğretebilirim!",
        "ac43b1c95427547c5f7f": "Beni eğit.",
        "d208401a5a99b05fa820": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarında ustadır. Kendini geliştirmek için onu bulmalısın.",
        "f69337c7c72bd38c9a14": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!"
      },
      "name": "Tomas",
