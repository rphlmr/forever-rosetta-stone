    "ptBR": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Encontre Shandrina no Refúgio Brisaprata. Ela pode lhe vender o \"Livro de Receitas do Perito\".",
        "176ac016802307bcda27": "Eu posso ensinar você a cozinhar!",
        "ac43b1c95427547c5f7f": "Treine-me.",
        "d208401a5a99b05fa820": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "f69337c7c72bd38c9a14": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!"
      },
      "name": "Tomas",
      "subName": "Cozinheiro",
