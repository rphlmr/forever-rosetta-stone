    "plPL": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Odszukaj Shandrinę w Silverwind Refuge. Może ci sprzedać „Książkę kucharską eksperta”.",
        "176ac016802307bcda27": "Mogę nauczyć cię gotować!",
        "ac43b1c95427547c5f7f": "Wyszkol mnie.",
        "d208401a5a99b05fa820": "Dirge Quikcleave z Gadgetzanu jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odnaleźć.",
        "f69337c7c72bd38c9a14": "Gotowanie to zajęcie na całe życie i widzę, że dzielimy tę samą pasję!"
      },
      "name": "Tomas",
