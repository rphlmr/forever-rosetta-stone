  "locales": {
    "csCZ": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Vyhledej Shandrinu v Silverwind Refuge. Může ti prodat „Kuchařku experta“.",
        "176ac016802307bcda27": "Mohu tě naučit vařit!",
        "ac43b1c95427547c5f7f": "Vycvičte mě.",
        "d208401a5a99b05fa820": "Dirge Quikcleave z Gadgetzanu je mistrem kuchařského umění. Chceš-li se zlepšit, musíš ho vyhledat.",
        "f69337c7c72bd38c9a14": "Vaření je celoživotní poslání a vidím, že sdílíme stejnou vášeň!"
      },
      "name": "Tomas",
      "translationMetadata": {
