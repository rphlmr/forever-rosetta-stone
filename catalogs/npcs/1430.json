    "esES": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Busca a Shandrina en el Refugio Brisa de Plata. Te puede vender el \"Recetario para expertos\".",
        "176ac016802307bcda27": "Puedo enseñarte a cocinar.",
        "ac43b1c95427547c5f7f": "Entréname.",
        "d208401a5a99b05fa820": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "f69337c7c72bd38c9a14": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión."
      },
      "name": "Tomas",
      "subName": "Cocinero",
