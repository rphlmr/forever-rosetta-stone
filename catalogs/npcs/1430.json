    "itIT": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Cerca Shandrina al Rifugio di Silverwind. Può venderti il \"Ricettario per Esperti\".",
        "176ac016802307bcda27": "Posso insegnarti a cucinare!",
        "ac43b1c95427547c5f7f": "Addestrami.",
        "d208401a5a99b05fa820": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "f69337c7c72bd38c9a14": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!"
      },
      "name": "Tomas",
