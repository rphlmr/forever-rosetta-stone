    "hrHR": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Pronađi Shandrinu u Silverwind Refugeu. Može ti prodati „Kuharicu za stručnjake”.",
        "176ac016802307bcda27": "Mogu te naučiti kuhati!",
        "ac43b1c95427547c5f7f": "Podučite me.",
        "d208401a5a99b05fa820": "Dirge Quikcleave iz Gadgetzana majstor je kulinarskog umijeća. Potraži ga želiš li napredovati.",
        "f69337c7c72bd38c9a14": "Kuhanje je životni poziv i vidim da dijelimo istu strast!"
      },
