    "svSE": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Sök upp Shandrina i Silverwind Refuge. Hon kan sälja dig ”Expertens kokbok”.",
        "176ac016802307bcda27": "Jag kan lära dig laga mat!",
        "ac43b1c95427547c5f7f": "Träna mig.",
        "d208401a5a99b05fa820": "Dirge Quikcleave i Gadgetzan är en mästare på kokkonst. Du måste söka upp honom för att bli bättre.",
        "f69337c7c72bd38c9a14": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!"
      },
      "name": "Tomas",
