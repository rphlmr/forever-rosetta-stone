    "daDK": {
      "dialogue": {
        "16e456d0185d1a02e84f": "Find Shandrina i Silverwind Refuge. Hun kan sælge dig „Ekspertens kogebog“.",
        "176ac016802307bcda27": "Jeg kan lære dig at lave mad!",
        "ac43b1c95427547c5f7f": "Træn mig.",
        "d208401a5a99b05fa820": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham for at blive bedre.",
        "f69337c7c72bd38c9a14": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler samme passion!"
      },
      "name": "Tomas",
      "translationMetadata": {
