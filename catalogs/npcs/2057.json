  "locales": {
    "csCZ": {
      "dialogue": {
        "3685e022cdb176da2e1f": "Přišel jsi pomoci s dodávkou? Miran už je skoro připraven.",
        "dc06caf118f377fcfaa8": "Dopravit tyto sudy na vykopávky je těžká práce, ale tolik lidí spoléhá na to, že tam dopravíme trhavý prach.$B$BMusíme proti Dark Ironům udělat, co můžeme!"
      },
      "name": "Huldar",
      "translationMetadata": {
        "fields": {
