    "enUS": {
      "dialogue": {
        "3685e022cdb176da2e1f": "Are you here to help with the delivery? Miran's just about ready.",
        "dc06caf118f377fcfaa8": "Delivering these barrels to the excavation site is hard work, but there are so many depending on us to get the blast powder there.$B$BWe must do what we can against the Dark Irons!"
      },
      "name": "Huldar",
      "translationMetadata": {
