    },
    "daDK": {
      "dialogue": {
        "3685e022cdb176da2e1f": "Er du her for at hjælpe med leveringen? Miran er næsten klar.",
        "dc06caf118f377fcfaa8": "Det er hårdt arbejde at bringe disse tønder til udgravningen, men mange er afhængige af, at vi får sprængkrudtet derhen.$B$BVi må gøre, hvad vi kan mod Dark Iron-dværgene!"
      },
      "name": "Huldar",
      "translationMetadata": {
        "fields": {
