    "plPL": {
      "dialogue": {
        "850c11afefe8c9f25768": "Wyszkol mnie.",
        "8e9d07f96251f5f97657": "Chcę przejrzeć twoje towary.",
        "910d5131de0f51214ea6": "Choć prace w tych ruinach toczą się teraz powoli, jestem pewien, że nie potrwa to długo. Tymczasem przydałby mi się ktoś taki jak ty. Chcesz pomóc Gildii Krasnoludzkich Odkrywców?"
      },
      "name": "Poszukiwacz Ironband",
