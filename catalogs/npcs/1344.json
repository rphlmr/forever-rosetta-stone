    "itIT": {
      "dialogue": {
        "850c11afefe8c9f25768": "Addestrami.",
        "8e9d07f96251f5f97657": "Vorrei vedere la tua merce.",
        "910d5131de0f51214ea6": "Anche se stiamo attraversando un periodo lento in queste rovine, sono certo che non durerà a lungo. Nel frattempo, però, mi farebbe comodo qualcuno come te. Ti piacerebbe aiutare la Gilda degli Esploratori Nani?"
      },
      "name": "Prospettore Ironband",
      "translationMetadata": {
