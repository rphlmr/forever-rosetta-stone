    "svSE": {
      "dialogue": {
        "850c11afefe8c9f25768": "Träna mig.",
        "8e9d07f96251f5f97657": "Jag vill se dina varor.",
        "910d5131de0f51214ea6": "Även om arbetet vid ruinerna går trögt just nu är jag säker på att det inte varar länge. Under tiden skulle jag behöva någon som du. Vill du hjälpa dvärgarnas upptäckargille?"
      },
      "name": "Prospektör Ironband",
