    "ltLT": {
      "dialogue": {
        "850c11afefe8c9f25768": "Išmokyk mane.",
        "8e9d07f96251f5f97657": "Noriu apžiūrėti tavo prekes.",
        "910d5131de0f51214ea6": "Nors šiuose griuvėsiuose dabar darbuojamės lėtai, esu tikras, kad tai ilgai netruks. O kol kas man praverstų toks pagalbininkas kaip tu. Ar norėtum padėti Nykštukų tyrinėtojų gildijai?"
      },
      "name": "Žvalgas Ironband",
      "translationMetadata": {
