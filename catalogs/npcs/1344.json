  "locales": {
    "csCZ": {
      "dialogue": {
        "850c11afefe8c9f25768": "Vycvičte mě.",
        "8e9d07f96251f5f97657": "Chci si prohlédnout vaše zboží.",
        "910d5131de0f51214ea6": "Ačkoli teď vykopávky v těchto ruinách postupují pomalu, věřím, že to nebude trvat dlouho. Mezitím by se mi ale hodil někdo jako ty. Nechceš pomoci Cechu trpasličích průzkumníků?"
      },
      "name": "Prospektor Ironband",
      "translationMetadata": {
        "fields": {
          "dialogue.850c11afefe8c9f25768": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.8e9d07f96251f5f97657": {
