    "hrHR": {
      "dialogue": {
        "850c11afefe8c9f25768": "Podučite me.",
        "8e9d07f96251f5f97657": "Želim pogledati vašu robu.",
        "910d5131de0f51214ea6": "Iako radovi na ovim ruševinama trenutačno sporo napreduju, siguran sam da to neće dugo trajati. U međuvremenu bi mi dobro došao netko poput tebe. Želiš li pomoći cehu patuljastih istraživača?"
      },
      "name": "Tragač Ironband",
      "translationMetadata": {
