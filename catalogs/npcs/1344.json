    "esES": {
      "dialogue": {
        "850c11afefe8c9f25768": "Entréname.",
        "8e9d07f96251f5f97657": "Quiero ver tus mercancías.",
        "910d5131de0f51214ea6": "Aunque estamos atravesando un periodo lento en estas ruinas, confío en que no dure mucho.  Pero mientras tanto, me vendría bien alguien como tú.  ¿Te gustaría ayudar al Gremio de Exploradores Enanos?"
      },
      "name": "Prospector Vetaferro",
      "translationMetadata": {
