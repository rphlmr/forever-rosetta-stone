    "frFR": {
      "dialogue": {
        "850c11afefe8c9f25768": "Entraînez-moi.",
        "8e9d07f96251f5f97657": "Je voudrais regarder vos articles.",
        "910d5131de0f51214ea6": "Bien que nous traversions une période creuse dans ces ruines, je suis persuadé que cela ne durera pas longtemps.  Mais en attendant, j'ai besoin de quelqu'un comme vous.  Voulez-vous aider la Guilde des explorateurs nains ?"
      },
      "name": "Prospecteur Ironband",
      "translationMetadata": {
