    "ptBR": {
      "dialogue": {
        "850c11afefe8c9f25768": "Treine-me.",
        "8e9d07f96251f5f97657": "Quero ver suas mercadorias.",
        "910d5131de0f51214ea6": "Embora estejamos passando por um período lento nestas ruínas, tenho certeza de que não vai durar muito. Enquanto isso, eu poderia contar com alguém como você. Gostaria de ajudar a Guilda dos Exploradores Anões?"
      },
      "name": "Prospector Bandaferro",
      "translationMetadata": {
        "fields": {
