            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "850c11afefe8c9f25768": "Træn mig.",
        "8e9d07f96251f5f97657": "Jeg vil gerne se dine varer.",
        "910d5131de0f51214ea6": "Selvom arbejdet ved ruinerne går langsomt for tiden, er jeg sikker på, at det snart ændrer sig. Indtil da kunne jeg bruge en som dig. Vil du hjælpe dværgenes opdagelsesrejsendes laug?"
      },
      "name": "Prospektør Ironband",
      "translationMetadata": {
        "fields": {
          "dialogue.850c11afefe8c9f25768": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.8e9d07f96251f5f97657": {
            "origin": "ai",
