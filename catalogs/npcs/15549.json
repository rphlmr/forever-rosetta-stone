    "deDE": {
      "dialogue": {
        "5383731c6a4991ddc652": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "59b68a737c470bd63de8": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht."
      },
      "name": "Urahne Morndeep",
