    "daDK": {
      "dialogue": {
        "7a5345a96db2684ce311": "Feralas' land har været meget igennem, $r. Jorden, træerne og skabningerne forandrer alle det, Feralas er og vil blive.$B$BDe to kolosser over os står dog uforandrede gennem alt, hvad der er sket her..."
      },
      "name": "Marli Wishrunner",
      "translationMetadata": {
        "fields": {
