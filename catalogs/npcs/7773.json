    "hrHR": {
      "dialogue": {
        "7a5345a96db2684ce311": "Zemlja Feralasa mnogo je toga proživjela, $r. Tlo, drveće i stvorenja mijenjaju ono što Feralas jest i što će postati.$B$BIpak, dva kolosa iznad nas ostaju nepromijenjena unatoč svemu što se ovdje zbilo..."
      },
      "name": "Marli Wishrunner",
