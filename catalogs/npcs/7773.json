    "enUS": {
      "dialogue": {
        "7a5345a96db2684ce311": "The land of Feralas has been through much, $r. The earth, the trees, the creatures; they are all changing what Feralas is and will be.$B$BThe Twin Colossals above us remain as a constant, though, throughout all that has happened here..."
      },
      "name": "Marli Wishrunner",
      "translationMetadata": {
        "fields": {
          "dialogue.7a5345a96db2684ce311": {
            "origin": "community",
            "source": "Spoken",
