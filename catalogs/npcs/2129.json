    },
    "daDK": {
      "dialogue": {
        "1db909ece0bb2aea2aa7": "Hvad kan denne ubetydelige tjener gøre for dig, $n? Træning måske?",
        "621eeff8180e2a2a5f3e": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de før havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "bbb12c600b54d90211f8": "Ja, $c?",
        "dbe0e601f32a3d062a23": "Jeg søger mere træning i præsternes kunst."
      },
      "name": "Mørkepræst Beryl",
      "translationMetadata": {
        "fields": {
          "dialogue.1db909ece0bb2aea2aa7": {
