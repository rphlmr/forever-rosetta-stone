  "locales": {
    "csCZ": {
      "dialogue": {
        "1db909ece0bb2aea2aa7": "Co pro tebe může tento bezvýznamný služebník udělat, $n? Snad výcvik?",
        "621eeff8180e2a2a5f3e": "Při přísném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto také dražší. Přeješ si, abych tě odnaučil talenty, které sis osvojil?",
        "bbb12c600b54d90211f8": "Ano, $c?",
        "dbe0e601f32a3d062a23": "Hledám další výcvik v kněžském umění."
      },
      "name": "Temný kněz Beryl",
      "translationMetadata": {
        "fields": {
          "dialogue.1db909ece0bb2aea2aa7": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
