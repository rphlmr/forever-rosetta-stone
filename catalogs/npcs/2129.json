    "ptBR": {
      "dialogue": {
        "1db909ece0bb2aea2aa7": "O que este insignificante criado pode fazer por você, $n? Talvez um treinamento?",
        "621eeff8180e2a2a5f3e": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "bbb12c600b54d90211f8": "Pois não, $c?",
        "dbe0e601f32a3d062a23": "Busco mais treinamento nos caminhos dos sacerdotes."
      },
      "name": "Clérigo das Trevas Beryl",
      "subName": "Treinamento de Sacerdotes",
