    "plPL": {
      "dialogue": {
        "1db909ece0bb2aea2aa7": "Co ten nieznaczący sługa może dla ciebie uczynić, $n? Może szkolenie?",
        "621eeff8180e2a2a5f3e": "Poprzez surowe przeszkolenie musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, abym mógł uczyć ich od nowa. Z każdym razem usługa ta staje się trudniejsza, a przez to droższa. Czy chcesz, abym oduczył cię poznanych talentów?",
        "bbb12c600b54d90211f8": "Tak, $c?",
        "dbe0e601f32a3d062a23": "Szukam dalszego szkolenia w sztuce kapłańskiej."
      },
      "name": "Mroczny kapłan Beryl",
