      }
    },
    "trTR": {
      "dialogue": {
        "4065ade28b19220a734e": "Kervanlarımız günde yaklaşık iki kez yola çıkıyor ama Bela, Didier ile katırlarının cepheye sevkiyat ulaştırmasını engellemek için elinden geleni yapıyor. Gördüğüm en çılgınca şey. Keşke sevkiyatları koruyacak kahraman maceracılarımız olsa..."
      },
      "name": "Sürü Ustası Stonebruiser",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
