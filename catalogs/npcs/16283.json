    },
    "enUS": {
      "dialogue": {
        "4065ade28b19220a734e": "Our caravans go out 'bout twice a day, but I'll be damned if the Scourge haven't gone out of their way to stop Didier and his mules from getting shipments to the front lines. Craziest thing I've ever seen. If only we had the heroic adventurin' types to help protect the shipments..."
      },
      "name": "Packmaster Stonebruiser",
      "subName": "Brotherhood of the Light",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
