      }
    },
    "plPL": {
      "dialogue": {
        "4065ade28b19220a734e": "Nasze karawany wyruszają mniej więcej dwa razy dziennie, ale Plaga robi wszystko, by Didier i jego muły nie dostarczyli zaopatrzenia na front. To najdziwniejsza rzecz, jaką widziałem. Gdyby tylko znaleźli się bohaterscy poszukiwacze przygód, którzy ochronią dostawy..."
      },
      "name": "Mistrz stada Stonebruiser",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
