          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "4065ade28b19220a734e": "Наші каравани вирушають приблизно двічі на день, але Бич докладає всіх зусиль, щоб Дідьє та його мули не доставили вантажі на фронт. Найбожевільніше, що я бачив. От якби знайшлися героїчні шукачі пригод, які допомогли б захистити вантажі..."
      },
      "name": "в'юнник Камнелуп",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
