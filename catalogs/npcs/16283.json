  "locales": {
    "csCZ": {
      "dialogue": {
        "4065ade28b19220a734e": "Naše karavany vyrážejí asi dvakrát denně, ale Pohroma dělá všechno pro to, aby Didier a jeho muly nedopravili zásilky na frontu. Nic šílenějšího jsem neviděl. Kéž bychom měli nějaké hrdinské dobrodruhy, kteří by zásilky ochránili..."
      },
      "name": "Mistr smečky Stonebruiser",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "4065ade28b19220a734e": "Vores karavaner drager ud omkring to gange om dagen, men Svøben gør alt for at forhindre Didier og hans muldyr i at levere forsyninger til fronten. Det skøreste, jeg nogensinde har set. Hvis bare vi havde nogle heltemodige eventyrere til at beskytte leverancerne..."
      },
      "name": "Pakmester Stonebruiser",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "4065ade28b19220a734e": "Unsere Karawanen verkehren zweimal am Tag zwischen hier und der Front und ich will verdammt sein, aber wenn ich mich nicht täusche, schmeißt die Geißel ihnen alles entgegen was sie hat, nur um Didier und seine Lasttiere daran zu hindern, unsere Fronttruppen mit Nachschub zu versorgen. So etwas Verrücktes habe ich noch nie erlebt. Wenn wir doch nur genug abenteuerlustige Helden hätten, die Didiers Lieferungen eskortieren könnten..."
      },
      "name": "Rottenkommandant Stonebruiser",
      "subName": "Bruderschaft des Lichts",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
