    "hrHR": {
      "dialogue": {
        "4065ade28b19220a734e": "Naše karavane kreću otprilike dvaput dnevno, ali Pošast čini sve da spriječi Didiera i njegove mazge da dostave pošiljke na bojišnicu. Najluđa stvar koju sam vidio. Kad bismo barem imali junačke pustolove da štite pošiljke..."
      },
      "name": "Gospodar čopora Stonebruiser",
      "translationMetadata": {
        "fields": {
          "dialogue.4065ade28b19220a734e": {
