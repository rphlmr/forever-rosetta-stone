    "csCZ": {
      "dialogue": {
        "02fe226537a2403406b5": "Jsem ten, kdo bez otázek plní rozkazy náčelníka. Jsem Horda.",
        "e76539b800f52f0b51ef": "Pohleď na nepřítele, $r. Podívej, co moc Hordy dokáže udělat i s tím nejmocnějším drakem! Všechny, kdo se nám postaví, čeká podobný osud!"
      },
      "name": "Vládce Runthak",
      "translationMetadata": {
        "fields": {
          "dialogue.02fe226537a2403406b5": {
