    },
    "daDK": {
      "dialogue": {
        "02fe226537a2403406b5": "Jeg er den, der udfører krigshøvdingens ordrer uden spørgsmål. Jeg er Horden.",
        "e76539b800f52f0b51ef": "Se på fjenden, $r. Se, hvad Hordens magt gør selv ved de mægtigste drager! Alle, der står os imod, skal møde en lignende skæbne!"
      },
      "name": "Overherre Runthak",
      "translationMetadata": {
        "fields": {
