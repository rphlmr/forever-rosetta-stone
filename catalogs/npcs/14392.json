    "ptBR": {
      "dialogue": {
        "02fe226537a2403406b5": "Eu sou aquele que executa sem questionamento as ordens do Chefe Guerreiro. Eu sou Horda.",
        "e76539b800f52f0b51ef": "Olhe para o inimigo, $r. Veja a que o poder da Horda reduz até os mais poderosos dragões! Todos os que se nos opuserem sofrerão o mesmo destino!"
      },
