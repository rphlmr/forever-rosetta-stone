    "hrHR": {
      "dialogue": {
        "02fe226537a2403406b5": "Ja sam onaj koji bez pitanja izvršava zapovijedi ratnog poglavara. Ja sam Horda.",
        "e76539b800f52f0b51ef": "Pogledaj neprijatelja, $r. Pogledaj što moć Horde učini i najmoćnijim zmajevima! Sve koji nam se suprotstave čeka slična sudbina!"
      },
      "name": "Vrhovni gospodar Runthak",
