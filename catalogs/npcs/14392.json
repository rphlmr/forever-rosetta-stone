    "frFR": {
      "dialogue": {
        "02fe226537a2403406b5": "Je suis celui qui porte les ordres du chef de guerre. Je suis Horde.",
        "e76539b800f52f0b51ef": "Contemplez l’ennemi, $r. Voyez à quoi la puissance de la Horde a réduit le plus puissant des dragons ! Tous ceux qui s’opposent à nous connaîtront le même destin !"
      },
      "name": "Seigneur Runthak",
