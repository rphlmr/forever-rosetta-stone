    "enUS": {
      "dialogue": {
        "02fe226537a2403406b5": "I am he that carries out the Warchief's commands without question. I am Horde.",
        "e76539b800f52f0b51ef": "Gaze upon the enemy, $r. See what the might of the Horde reduces even the most powerful of dragons to! All that oppose us shall meet a similar fate!"
      },
      "name": "Overlord Runthak",
      "translationMetadata": {
        "fields": {
