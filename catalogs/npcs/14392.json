    "ltLT": {
      "dialogue": {
        "02fe226537a2403406b5": "Aš esu tas, kuris be išlygų vykdo karo vado įsakymus. Aš esu Orda.",
        "e76539b800f52f0b51ef": "Pažvelk į priešą, $r. Pamatyk, ką Ordos galybė padaro net galingiausiems drakonams! Visų, kurie mums priešinasi, laukia panašus likimas!"
      },
      "name": "Valdovas Runthak",
