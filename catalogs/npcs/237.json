    "plPL": {
      "dialogue": {
        "674028d0c235893e0b55": "W tych stronach same kłopoty. Próbowałem powiedzieć temu głupcowi Saldeanowi, żeby wyjechał, póki może, ale nie chce słuchać. Ja nie jestem głupcem. Verna i ja ruszymy stąd, gdy tylko naprawimy wóz.",
        "7e4606a296082d3347c6": "Chcę przejrzeć twoje towary.",
        "994e8322f88d1d01adb7": "Wyszkol mnie."
      },
      "name": "Farmer Furlbrow",
      "translationMetadata": {
        "fields": {
          "dialogue.674028d0c235893e0b55": {
