  "locales": {
    "csCZ": {
      "dialogue": {
        "674028d0c235893e0b55": "V tomhle kraji jsou jen samé potíže. Snažil jsem se tomu hlupákovi Saldeanovi říct, ať odejde, dokud může, ale nechce o tom ani slyšet. Já ale hlupák nejsem. S Vernou se odtud vytratíme, jen co opravíme tenhle vůz.",
        "7e4606a296082d3347c6": "Rád bych si prohlédl vaše zboží.",
        "994e8322f88d1d01adb7": "Vycvičte mě."
      },
      "name": "Farmář Furlbrow",
      "translationMetadata": {
        "fields": {
          "dialogue.674028d0c235893e0b55": {
