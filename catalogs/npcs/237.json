    "esMX": {
      "dialogue": {
        "674028d0c235893e0b55": "Por aquí no hay más que problemas. Intenté decirle al necio de Saldean que se fuera mientras pudiera, pero no quiso escuchar. Yo no soy ningún necio. Verna y yo nos marcharemos en cuanto reparemos esta carreta.",
        "7e4606a296082d3347c6": "Quiero ver tus mercancías.",
        "994e8322f88d1d01adb7": "Entréname."
      },
      "name": "Granjero Cejade",
      "translationMetadata": {
