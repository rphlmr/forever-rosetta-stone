    "hrHR": {
      "dialogue": {
        "674028d0c235893e0b55": "U ovim krajevima ima samo nevolja. Pokušao sam reći onoj budali Saldeanu da ode dok još može, ali ne želi ni čuti. No ja nisam budala. Verna i ja odlazimo čim popravimo ova kola.",
        "7e4606a296082d3347c6": "Želim pogledati vašu robu.",
        "994e8322f88d1d01adb7": "Podučite me."
      },
      "name": "Farmer Furlbrow",
      "translationMetadata": {
