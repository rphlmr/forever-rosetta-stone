        }
      }
    },
    "ptBR": {
      "dialogue": {
        "674028d0c235893e0b55": "Só há problemas por estas bandas. Tentei dizer àquele tolo do Saldean que fosse embora enquanto ainda podia, mas ele não quis ouvir. Eu não sou tolo. Verna e eu vamos partir assim que consertarmos esta carroça.",
        "7e4606a296082d3347c6": "Quero ver suas mercadorias.",
        "994e8322f88d1d01adb7": "Treine-me."
      },
      "name": "Fazendeiro Taturana",
      "translationMetadata": {
