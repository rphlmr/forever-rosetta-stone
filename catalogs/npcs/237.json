    "esES": {
      "dialogue": {
        "674028d0c235893e0b55": "Sólo hay problemas por aquí.  Intenté decirle a ese tonto de Saldean que se fuera mientras pudiera, pero no me escuchó.  Pero yo no soy tonto.  Verna y yo nos iremos en cuanto arreglemos la carreta.",
        "7e4606a296082d3347c6": "Quiero ver tus mercancías.",
        "994e8322f88d1d01adb7": "Entréname."
      },
      "name": "Granjero Cejade",
