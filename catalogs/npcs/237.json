      }
    },
    "daDK": {
      "dialogue": {
        "674028d0c235893e0b55": "Der er kun problemer her på egnen. Jeg prøvede at sige til fjolset Saldean, at han skulle rejse, mens han kunne, men han vil ikke høre på det. Jeg er ikke noget fjols. Verna og jeg smutter, så snart vi har repareret vognen.",
        "7e4606a296082d3347c6": "Jeg vil gerne se dine varer.",
        "994e8322f88d1d01adb7": "Træn mig."
      },
      "name": "Landmand Furlbrow",
      "translationMetadata": {
        "fields": {
          "dialogue.674028d0c235893e0b55": {
            "origin": "ai",
