    "enUS": {
      "dialogue": {
        "674028d0c235893e0b55": "Nothing but trouble in these parts.  I tried to tell that fool Saldean to get out while he still could be he won't hear of it.  But I ain't no fool.  Verna and I are gonna mosey on out as soon as we get this wagon fixed.",
        "7e4606a296082d3347c6": "I want to browse your goods.",
        "994e8322f88d1d01adb7": "Train me."
      },
      "name": "Farmer Furlbrow",
      "translationMetadata": {
        "fields": {
