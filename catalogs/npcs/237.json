    "trTR": {
      "dialogue": {
        "674028d0c235893e0b55": "Buralarda beladan başka bir şey yok. Şu aptal Saldean'a hâlâ fırsatı varken gitmesini söylemeye çalıştım ama dinlemiyor. Ben aptal değilim. Verna'yla şu arabayı onarır onarmaz çekip gideceğiz.",
        "7e4606a296082d3347c6": "Mallarına bakmak istiyorum.",
        "994e8322f88d1d01adb7": "Beni eğit."
      },
      "name": "Çiftçi Furlbrow",
      "translationMetadata": {
