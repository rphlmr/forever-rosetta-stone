    "ltLT": {
      "dialogue": {
        "465121398d5cd045427d": "Akmuo ir žemė byloja teisingiau už bet kurį liežuvį, jei tik pakankamai ilgam nutildai širdies klegesį, kad juos išgirstum.\n\nJei turi šamano gyslelę, aš tave išmokysiu."
      },
      "name": "Teo Hammerstorm",
