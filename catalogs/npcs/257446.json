    "enUS": {
      "dialogue": {
        "465121398d5cd045427d": "The stone an' soil speak truer than any tongue, if ye quiet the clatter in yer heart long enough to hear 'em.\n\nIf ye've the makings of a shaman, I'll teach ye."
      },
      "name": "Teo Hammerstorm",
      "subName": "Shaman Trainer",
      "translationMetadata": {
        "fields": {
