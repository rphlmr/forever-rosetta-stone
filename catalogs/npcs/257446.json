    "csCZ": {
      "dialogue": {
        "465121398d5cd045427d": "Kámen a půda mluví pravdivěji než jakýkoli jazyk, když utišíš hluk ve svém srdci natolik, abys je slyšel.\n\nMáš-li předpoklady stát se šamanem, budu tě učit."
      },
      "name": "Teo Hammerstorm",
      "translationMetadata": {
        "fields": {
