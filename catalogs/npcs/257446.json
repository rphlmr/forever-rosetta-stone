    "plPL": {
      "dialogue": {
        "465121398d5cd045427d": "Kamień i ziemia mówią prawdziwiej niż jakikolwiek język, jeśli uciszysz zgiełk w sercu na tyle długo, by je usłyszeć.\n\nJeśli masz zadatki na szamana, nauczę cię."
      },
      "name": "Teo Hammerstorm",
      "translationMetadata": {
