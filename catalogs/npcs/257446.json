    "hrHR": {
      "dialogue": {
        "465121398d5cd045427d": "Kamen i zemlja govore istinitije od svakog jezika, ako dovoljno dugo utišaš buku u srcu da ih čuješ.\n\nImaš li ono što treba šamanu, podučit ću te."
      },
      "name": "Teo Hammerstorm",
      "translationMetadata": {
