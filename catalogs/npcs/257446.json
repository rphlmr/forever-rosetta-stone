    "daDK": {
      "dialogue": {
        "465121398d5cd045427d": "Sten og jord taler sandere end nogen tunge, hvis du dæmper larmen i dit hjerte længe nok til at høre dem.\n\nHar du anlæg for at blive shaman, vil jeg lære dig op."
      },
      "name": "Teo Hammerstorm",
      "translationMetadata": {
        "fields": {
