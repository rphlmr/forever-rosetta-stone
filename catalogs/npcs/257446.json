    "ptBR": {
      "dialogue": {
        "465121398d5cd045427d": "A pedra e a terra falam mais verdades que qualquer língua, se tu aquietar o barulho do teu coração a ponto de pra ouvir.\n\nSe tiver o dom do xamanismo, eu te ensino."
      },
      "name": "Teo Tempestelo",
      "subName": "Treinamento de Xamãs",
