    "enUS": {
      "dialogue": {
        "06face88bffb97feed4a": "I seek training in the ways of the Hunter.",
        "3b85e9b61826345437fe": "I do not have the knowledge you seek.",
        "9b9372f8f4d7d35c35c2": "Do you prefer guns or bows?",
        "b3d6342cf6a7f2005edf": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Lanka Farshot",
      "subName": "Hunter Trainer",
      "translationMetadata": {
