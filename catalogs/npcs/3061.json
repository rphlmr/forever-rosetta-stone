          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "06face88bffb97feed4a": "Jeg søger træning i jægerens kunst.",
        "3b85e9b61826345437fe": "Jeg besidder ikke den viden, du søger.",
        "9b9372f8f4d7d35c35c2": "Foretrækker du geværer eller buer?",
        "b3d6342cf6a7f2005edf": "Gennem streng genoptræning har jeg måttet få mange elever til at aflære alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre for hver gang. Derfor bliver hver genoptræning også dyrere. Ønsker du, at jeg skal få dig til at aflære de talenter, du har lært?"
      },
      "name": "Lanka Farshot",
      "translationMetadata": {
        "fields": {
          "dialogue.06face88bffb97feed4a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
