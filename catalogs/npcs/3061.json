    "hrHR": {
      "dialogue": {
        "06face88bffb97feed4a": "Tražim obuku u lovačkim vještinama.",
        "3b85e9b61826345437fe": "Nemam znanje koje tražiš.",
        "9b9372f8f4d7d35c35c2": "Više voliš puške ili lukove?",
        "b3d6342cf6a7f2005edf": "Strogim preobučavanjem morala sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogla podučiti iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako preobučavanje stoji sve više. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Lanka Farshot",
      "translationMetadata": {
