    "ltLT": {
      "dialogue": {
        "06face88bffb97feed4a": "Noriu išmokti medžiotojo amato.",
        "3b85e9b61826345437fe": "Neturiu žinių, kurių ieškai.",
        "9b9372f8f4d7d35c35c2": "Kas tau labiau patinka: šaunamieji ginklai ar lankai?",
        "b3d6342cf6a7f2005edf": "Griežtai permokydamas turėjau padėti daugeliui mokinių pamiršti visa, ko jie anksčiau išmoko, kad galėčiau juos išmokyti iš naujo.  Kaskart tai padaryti tampa vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar nori, kad padėčiau tau pamiršti išmoktus talentus?"
      },
      "name": "Lanka Farshot",
      "subName": "Medžiotojų mokytojas",
      "translationMetadata": {
