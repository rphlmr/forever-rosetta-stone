    "svSE": {
      "dialogue": {
        "06face88bffb97feed4a": "Jag söker träning i jägarens konst.",
        "3b85e9b61826345437fe": "Jag besitter inte kunskapen du söker.",
        "9b9372f8f4d7d35c35c2": "Föredrar du gevär eller bågar?",
        "b3d6342cf6a7f2005edf": "Genom hård omskolning har jag fått många elever att glömma allt de tidigare lärt sig, så att jag kunnat undervisa dem på nytt. Tjänsten blir svårare att utföra varje gång. Därför blir den också dyrare för varje omskolning. Vill du att jag ska hjälpa dig att glömma de talanger du lärt dig?"
      },
      "name": "Lanka Farshot",
      "translationMetadata": {
