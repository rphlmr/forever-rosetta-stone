    "plPL": {
      "dialogue": {
        "06face88bffb97feed4a": "Szukam szkolenia w sztuce łowcy.",
        "3b85e9b61826345437fe": "Nie posiadam wiedzy, której szukasz.",
        "9b9372f8f4d7d35c35c2": "Wolisz broń palną czy łuki?",
        "b3d6342cf6a7f2005edf": "Dzięki surowemu przeszkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc szkolić ich na nowo. Za każdym razem wykonanie tej usługi staje się coraz trudniejsze. Dlatego też każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym pomogła ci zapomnieć poznane talenty?"
      },
      "name": "Lanka Farshot",
      "translationMetadata": {
