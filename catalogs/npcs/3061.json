  "locales": {
    "csCZ": {
      "dialogue": {
        "06face88bffb97feed4a": "Hledám výcvik v umění lovce.",
        "3b85e9b61826345437fe": "Nemám znalosti, které hledáš.",
        "9b9372f8f4d7d35c35c2": "Dáváš přednost puškám, nebo lukům?",
        "b3d6342cf6a7f2005edf": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talenty, které sis osvojil?"
      },
      "name": "Lanka Farshot",
      "translationMetadata": {
        "fields": {
          "dialogue.06face88bffb97feed4a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.3b85e9b61826345437fe": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.9b9372f8f4d7d35c35c2": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.b3d6342cf6a7f2005edf": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
