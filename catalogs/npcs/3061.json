    "trTR": {
      "dialogue": {
        "06face88bffb97feed4a": "Avcılığın yollarını öğrenmek istiyorum.",
        "3b85e9b61826345437fe": "Aradığın bilgiye sahip değilim.",
        "9b9372f8f4d7d35c35c2": "Tüfekleri mi yoksa yayları mı tercih edersin?",
        "b3d6342cf6a7f2005edf": "Birçok öğrencime yeniden öğretebilmek için sıkı bir eğitimle daha önce öğrendikleri her şeyi unutturmam gerekti. Bu hizmeti her tekrarlayışımda uygulamak daha da zorlaşıyor. Bu yüzden her yeniden eğitimde ücret artıyor. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?"
      },
      "name": "Lanka Farshot",
      "translationMetadata": {
