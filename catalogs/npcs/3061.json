    "esES": {
      "dialogue": {
        "06face88bffb97feed4a": "Busco entrenamiento en las artes del cazador.",
        "3b85e9b61826345437fe": "No tengo el saber que buscas.",
        "9b9372f8f4d7d35c35c2": "¿Te gustan más los arcos o las armas de fuego?",
        "b3d6342cf6a7f2005edf": "He tenido que realizar una rigurosa reconversión con muchos estudiantes de todo lo que habían aprendido, para poder enseñarles desde cero. El servicio que ofrezco aumenta de dificultad cada vez que se hace. Por esa razón, también aumenta el precio de cada nueva instrucción. ¿Quieres que elimine todos los talentos que has aprendido?"
      },
      "name": "Lanka Tirolargo",
      "subName": "Instructor de caza",
