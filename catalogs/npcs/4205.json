    "enUS": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "I'd like to train.",
        "5d2d8175094cc7fa4e19": "Welcome to the Cenarion Circle, $c.  How may I assist you?",
        "927877a906e52ed5113b": "I cannot train a $c such as yourself.",
        "fcd1f4966e131dc98ec5": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Dorion",
      "subName": "Hunter Trainer",
      "translationMetadata": {
