  "locales": {
    "csCZ": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "Chtěl bych trénovat.",
        "5d2d8175094cc7fa4e19": "Vítej v Cenarijském kruhu, $c. Jak ti mohu pomoci?",
        "927877a906e52ed5113b": "Nemohu vycvičit $c, jako jsi ty.",
        "fcd1f4966e131dc98ec5": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl učit znovu. Tato služba je pokaždé obtížnější, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil získané talenty?"
      },
      "name": "Dorion",
      "translationMetadata": {
        "fields": {
          "dialogue.59e3a504ff6ab80b9c7d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
