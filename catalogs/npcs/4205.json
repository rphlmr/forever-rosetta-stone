    "hrHR": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "Želim trenirati.",
        "5d2d8175094cc7fa4e19": "Dobro došao u Cenarionski krug, $c. Kako ti mogu pomoći?",
        "927877a906e52ed5113b": "Ne mogu podučavati $c poput tebe.",
        "fcd1f4966e131dc98ec5": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Ta usluga svakim je izvođenjem sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Dorion",
