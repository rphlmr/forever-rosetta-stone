    "daDK": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "Jeg vil gerne trænes.",
        "5d2d8175094cc7fa4e19": "Velkommen til Cenarion Circle, $c. Hvordan kan jeg hjælpe dig?",
        "927877a906e52ed5113b": "Jeg kan ikke træne en $c som dig.",
        "fcd1f4966e131dc98ec5": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de før havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver vanskeligere hver gang og derfor også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme dine lærte talenter?"
      },
      "name": "Dorion",
      "translationMetadata": {
        "fields": {
          "dialogue.59e3a504ff6ab80b9c7d": {
