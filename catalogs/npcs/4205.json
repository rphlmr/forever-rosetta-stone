    "ltLT": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "Norėčiau pasimokyti.",
        "5d2d8175094cc7fa4e19": "Sveiki atvykę į Cenarion Circle, $c. Kaip galiu jums padėti?",
        "927877a906e52ed5113b": "Negaliu mokyti tokios klasės kaip $c.",
        "fcd1f4966e131dc98ec5": "Griežtai permokydamas turėjau priversti daugybę mokinių pamiršti viską, ko jie anksčiau išmoko, kad galėčiau juos mokyti iš naujo. Kaskart tai padaryti tampa vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar norite, kad priversčiau jus pamiršti išmoktus talentus?"
      },
      "name": "Dorion",
      "subName": "Medžiotojų mokytojas",
