    "trTR": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "Eğitim almak istiyorum.",
        "5d2d8175094cc7fa4e19": "Cenarion Çemberi’ne hoş geldin, $c. Sana nasıl yardımcı olabilirim?",
        "927877a906e52ed5113b": "Senin gibi bir $c eğitemem.",
        "fcd1f4966e131dc98ec5": "Titiz bir yeniden eğitimle birçok öğrenciye daha önce öğrendiklerini unutturup onları baştan eğitmem gerekti. Sunduğum hizmet her seferinde zorlaşıyor. Bu yüzden her yeniden eğitimde ücreti de artıyor. Öğrendiğin yetenekleri sana unutturmamı ister misin?"
      },
      "name": "Dorion",
      "translationMetadata": {
