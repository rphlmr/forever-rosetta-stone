    "plPL": {
      "dialogue": {
        "59e3a504ff6ab80b9c7d": "Chcę się szkolić.",
        "5d2d8175094cc7fa4e19": "Witaj w Kręgu Cenariona, $c. Jak mogę ci pomóc?",
        "927877a906e52ed5113b": "Nie mogę szkolić kogoś takiego jak ty, $c.",
        "fcd1f4966e131dc98ec5": "Dzięki surowemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Ta usługa staje się coraz trudniejsza przy każdym wykonaniu, dlatego każde kolejne przeszkolenie jest droższe. Czy chcesz, abym oduczył cię poznanych talentów?"
      },
      "name": "Dorion",
      "translationMetadata": {
