    },
    "daDK": {
      "dialogue": {
        "469414062c53f8b2d507": "Min visdom og min viden er din. Hvad kan jeg gøre for dig, $n?",
        "5c5cc6ad6e0ce23daec1": "Elune være med dig, $c.",
        "8a53373126653e820ac1": "Gennem streng genoptræning har jeg måttet få mange elever til at aflære alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre for hver gang. Derfor bliver hver genoptræning også dyrere. Ønsker du, at jeg skal få dig til at aflære de talenter, du har lært?",
        "c999d7f6bf139e6bc4a7": "Jeg søger mere træning i præsternes kunst."
      },
      "name": "Laurna Morninglight",
      "translationMetadata": {
        "fields": {
