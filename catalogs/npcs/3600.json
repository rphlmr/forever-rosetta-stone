    "enUS": {
      "dialogue": {
        "469414062c53f8b2d507": "My wisdom is yours, as is my knowledge. What can I do for you, $n?",
        "5c5cc6ad6e0ce23daec1": "Elune be with you, $c.",
        "8a53373126653e820ac1": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "c999d7f6bf139e6bc4a7": "I seek more training in the priestly ways."
      },
      "name": "Laurna Morninglight",
      "subName": "Priest Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.469414062c53f8b2d507": {
            "origin": "community",
