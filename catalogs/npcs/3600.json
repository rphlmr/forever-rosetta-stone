  "locales": {
    "csCZ": {
      "dialogue": {
        "469414062c53f8b2d507": "Má moudrost i mé znalosti jsou ti k službám. Co pro tebe mohu udělat, $n?",
        "5c5cc6ad6e0ce23daec1": "Elune s tebou, $c.",
        "8a53373126653e820ac1": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talenty, které sis osvojil?",
        "c999d7f6bf139e6bc4a7": "Hledám další výcvik v kněžském umění."
      },
      "name": "Laurna Morninglight",
      "translationMetadata": {
        "fields": {
          "dialogue.469414062c53f8b2d507": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
