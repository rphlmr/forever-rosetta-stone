  "locales": {
    "csCZ": {
      "dialogue": {
        "39a10e6da68c68c3d0ab": "Chtěl bych si od vás něco koupit.",
        "85de99e34f489326d7e1": "Co mě můžeš naučit?",
        "93eac6a0f78dedc17364": "Rybaření je tak příjemné, kámo. Víš? Za svou blaženost vděčím svému učiteli, nejlepšímu rybáři na celém světě — Natu Paglovi. Slyšel jsi o něm, kámo?$B$BHledáš-li osvícení, Nat Pagle ti ukáže cestu."
      },
      "name": "Rybář Katoom",
      "translationMetadata": {
        "fields": {
          "dialogue.39a10e6da68c68c3d0ab": {
            "origin": "ai",
