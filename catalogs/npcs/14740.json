    "plPL": {
      "dialogue": {
        "39a10e6da68c68c3d0ab": "Chcę coś od ciebie kupić.",
        "85de99e34f489326d7e1": "Czego możesz mnie nauczyć?",
        "93eac6a0f78dedc17364": "Wędkowanie jest takie przyjemne, stary. Wiesz? Swój błogi stan zawdzięczam mentorowi, najlepszemu wędkarzowi na świecie, Natowi Pagle’owi. Słyszałeś o nim, stary?$B$BJeśli szukasz oświecenia, Nat Pagle wskaże ci drogę."
      },
      "name": "Katoom Wędkarz",
