          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "39a10e6da68c68c3d0ab": "Jeg vil gerne købe noget af dig.",
        "85de99e34f489326d7e1": "Hvad kan du lære mig?",
        "93eac6a0f78dedc17364": "Fiskeri er så dejligt, ven. Ved du det? Jeg skylder min lyksalighed min læremester, den bedste fisker i hele verden, Nat Pagle. Har du hørt om ham, ven?$B$BHvis du søger oplysning, er Nat Pagle den, der viser dig vejen."
      },
      "name": "Fiskeren Katoom",
      "translationMetadata": {
        "fields": {
