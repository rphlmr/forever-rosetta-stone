    "enUS": {
      "dialogue": {
        "39a10e6da68c68c3d0ab": "I would like to buy from you.",
        "85de99e34f489326d7e1": "What can you teach me?",
        "93eac6a0f78dedc17364": "Fishing is just so pleasant, mon. You know? I owe my state of bliss to my mentor, the greatest angler in the whole world - Nat Pagle. Have you heard of him, mon?$B$BIf you be looking for enlightenment, Nat Pagle be the one who gonna show you the way. "
      },
      "name": "Katoom the Angler",
      "subName": "Fishing Trainer & Supplies",
