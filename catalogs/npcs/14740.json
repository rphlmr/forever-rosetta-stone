    "esES": {
      "dialogue": {
        "39a10e6da68c68c3d0ab": "Me gustaría comprarte algo.",
        "85de99e34f489326d7e1": "¿Qué puedes enseñarme?",
        "93eac6a0f78dedc17364": "Pescar es guay, colega. ¿Sabes? Debo mi felicidad a mi mentor, el mejor pescador de to'l mundo, Nat Pagle. ¿Has oído hablar de él, colega?\n\nSi tás buscando la felicidad, Nat Pagle puede enseñarte el camino."
      },
      "name": "Katoom el Pescador",
