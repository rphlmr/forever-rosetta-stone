    "ltLT": {
      "dialogue": {
        "39a10e6da68c68c3d0ab": "Norėčiau iš jūsų nusipirkti.",
        "85de99e34f489326d7e1": "Ko galite mane išmokyti?",
        "93eac6a0f78dedc17364": "Žvejoti taip malonu, bičiuli. Supranti? Už šią palaimą esu dėkingas savo mokytojui, geriausiam žvejui visame pasaulyje - Nat Pagle. Ar esi apie jį girdėjęs, bičiuli?$B$BJei ieškai nušvitimo, Nat Pagle parodys tau kelią. "
      },
      "name": "Žvejys Katoom",
      "subName": "Žvejybos mokytojas ir reikmenų pardavėjas",
