    "daDK": {
      "dialogue": {
        "263760f1eaad7f9e6a3b": "Jeg har brug for krigertræning.",
        "6911d9f866e13b127f7f": "Spild ikke min tid, $c.",
        "b6d95358cc95cdacf03e": "Gennem grundig omskoling har jeg måttet få mange elever til at aflære alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre for hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at aflære dine talenter?",
        "c040501546a17dd7b42c": "En krigers rolle er at beskytte. Ligesom vi beskytter vores landsmænd i kamp, må vi også beskytte de Forsagtes interesser."
      },
      "name": "Christoph Walker",
      "translationMetadata": {
        "fields": {
          "dialogue.263760f1eaad7f9e6a3b": {
