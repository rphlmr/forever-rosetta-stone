    "hrHR": {
      "dialogue": {
        "263760f1eaad7f9e6a3b": "Trebam ratničku obuku.",
        "6911d9f866e13b127f7f": "Ne troši moje vrijeme, $c.",
        "b6d95358cc95cdacf03e": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao poučiti iznova. Uslugu koju nudim sve je teže obaviti svaki put kad se ponovi. Zato je svaka preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "c040501546a17dd7b42c": "Uloga ratnika jest štititi. Kao što štitimo svoje sunarodnjake u bitci, moramo štititi i interese Odbačenih."
      },
      "name": "Christoph Walker",
      "translationMetadata": {
