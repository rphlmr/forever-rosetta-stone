    "enUS": {
      "dialogue": {
        "263760f1eaad7f9e6a3b": "I require warrior training.",
        "6911d9f866e13b127f7f": "Do not waste my time, $c.",
        "b6d95358cc95cdacf03e": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "c040501546a17dd7b42c": "The warrior's role is one of protection.  Just as we protect our compatriots in battle, we must also protect the interests of the Forsaken."
      },
      "name": "Christoph Walker",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
