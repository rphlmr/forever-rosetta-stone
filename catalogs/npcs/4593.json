  "locales": {
    "csCZ": {
      "dialogue": {
        "263760f1eaad7f9e6a3b": "Potřebuji výcvik válečníka.",
        "6911d9f866e13b127f7f": "Neplýtvej mým časem, $c.",
        "b6d95358cc95cdacf03e": "Při důkladném přeškolování jsem musel mnohé žáky odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším opakování obtížnější. Proto je každé další přeškolení také dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "c040501546a17dd7b42c": "Úlohou válečníka je chránit. Stejně jako v bitvě chráníme své druhy, musíme chránit i zájmy Opuštěných."
      },
      "name": "Christoph Walker",
      "translationMetadata": {
        "fields": {
          "dialogue.263760f1eaad7f9e6a3b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
