    "frFR": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Entraînez-moi.",
        "1ef348428f0e83ee0aa0": "Ah, un pêcheur. Avez-vous besoin d'un peu d'entraînement ? Peut-être puis-je vous montrer une chose ou deux ?",
        "5c9338af401b752b07d5": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "982589a64588720c4c68": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "fa111e14bb561b56b613": "Bienvenue à Stormwind. La reconstruction fut longue, mais nécessaire. Vous venez pour visiter ou pour affaires ?"
      },
      "name": "Arnold Leland",
      "subName": "Maître des pêcheurs",
