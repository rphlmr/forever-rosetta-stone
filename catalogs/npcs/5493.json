    "ltLT": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Pamokyk mane.",
        "1ef348428f0e83ee0aa0": "Ak, kolega žvejys. Gal norėtum šiek tiek pasimokyti? Galėčiau šio to tave išmokyti?",
        "5c9338af401b752b07d5": "Jei nori tapti dar geresniu žveju, turėsi susirasti Nat Pagle Dustwallow pelkėje.",
        "982589a64588720c4c68": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senis Hemingas Booty Bay turi knygos „Ešerys ir tu“ egzempliorių.  Ji tikrai padės tau pagerinti savo įgūdžius.",
        "fa111e14bb561b56b613": "Sveikas atvykęs į Stormwind. Miestą atstatyti užtruko ilgai, bet buvo verta. Tai ar atvykai pasisvečiuoti, ar turi čia reikalų?"
      },
      "name": "Arnoldas Lelandas",
      "subName": "Žvejybos mokytojas",
      "translationMetadata": {
