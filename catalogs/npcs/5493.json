    "daDK": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Træn mig.",
        "1ef348428f0e83ee0aa0": "Nå, en fiskerkollega. Har du måske brug for lidt træning? Måske kan jeg lære dig et og andet?",
        "5c9338af401b752b07d5": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu.",
        "982589a64588720c4c68": "Du er dygtigere end mig, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den kan helt sikkert hjælpe dig med at blive bedre.",
        "fa111e14bb561b56b613": "Velkommen til Stormwind. Det tog lang tid at genopbygge byen, men det var bestemt umagen værd. Er du på besøg, eller er du her i forretninger?"
      },
      "name": "Arnold Leland",
      "translationMetadata": {
        "fields": {
