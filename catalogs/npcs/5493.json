    "plPL": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Wyszkol mnie.",
        "1ef348428f0e83ee0aa0": "Ach, kolega po wędce. Potrzebujesz może trochę nauki? Może zdołam pokazać ci to i owo?",
        "5c9338af401b752b07d5": "Musisz odnaleźć Nata Pagle'a na bagnach Dustwallow, jeśli chcesz dalej doskonalić swoje umiejętności.",
        "982589a64588720c4c68": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci doskonalić umiejętności.",
        "fa111e14bb561b56b613": "Witaj w Stormwind. Odbudowa miasta trwała długo, ale było warto. Przybywasz w odwiedziny czy w interesach?"
      },
      "name": "Arnold Leland",
      "translationMetadata": {
