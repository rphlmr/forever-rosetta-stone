    "enUS": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Train me.",
        "1ef348428f0e83ee0aa0": "Ah, a fellow Fisherman. Are you perhaps in need of a little training? Maybe I can show you a thing or two?",
        "5c9338af401b752b07d5": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "982589a64588720c4c68": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "fa111e14bb561b56b613": "Welcome to Stormwind. Took a long time to rebuild her but it was well worth it. So are you visiting, or are you here on business?"
      },
      "name": "Arnold Leland",
      "subName": "Fishing Trainer",
      "translationMetadata": {
