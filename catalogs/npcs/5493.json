    "hrHR": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Podučite me.",
        "1ef348428f0e83ee0aa0": "Ah, kolega ribar. Trebaš li možda malo obuke? Možda ti mogu nešto pokazati?",
        "5c9338af401b752b07d5": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako želiš postati još bolji.",
        "982589a64588720c4c68": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige „Grgeč i ti“. Ona će ti sigurno pomoći da se usavršiš.",
        "fa111e14bb561b56b613": "Dobro došao u Stormwind. Obnova grada dugo je trajala, ali vrijedila je truda. Jesi li u posjetu ili si ovdje poslom?"
      },
      "name": "Arnold Leland",
      "translationMetadata": {
