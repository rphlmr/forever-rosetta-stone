  "locales": {
    "csCZ": {
      "dialogue": {
        "17f3bcc44fba65c9e003": "Vycvičte mě.",
        "1ef348428f0e83ee0aa0": "Á, kolega rybář. Nepotřebuješ trochu výcviku? Možná bych ti mohl něco ukázat?",
        "5c9338af401b752b07d5": "Jestli se chceš dále zlepšit, musíš najít Nata Paglea v Dustwallow Marsh.",
        "982589a64588720c4c68": "Tvé umění už převyšuje mé. Slyšel jsem však, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti určitě pomůže se zlepšit.",
        "fa111e14bb561b56b613": "Vítej ve Stormwindu. Jeho obnova trvala dlouho, ale rozhodně stála za to. Jsi tu na návštěvě, nebo pracovně?"
      },
      "name": "Arnold Leland",
      "translationMetadata": {
        "fields": {
