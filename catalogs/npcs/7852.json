          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "56df30c8349fde0152b7": "Jeg vil gerne købe noget af dig.",
        "6360b48d95436a45c1b5": "Velkommen, $c. Hvis du leder efter lædervarer og forsyninger til læderarbejde, er du kommet til den rette halvpensionerede paladin.",
        "f9b56bcf1da0828f30d1": "Jeg sværger... hvis Quint prøver at lægge endnu en fiskemadding på mig, fælder jeg hans træ med mit knap så rustne sværd."
      },
      "name": "Pratt McGrubben",
      "translationMetadata": {
        "fields": {
          "dialogue.56df30c8349fde0152b7": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
