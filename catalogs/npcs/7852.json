    "enUS": {
      "dialogue": {
        "56df30c8349fde0152b7": "I would like to buy from you.",
        "6360b48d95436a45c1b5": "Greetings $c -- if you're looking for leather goods and leatherworking supplies, you've come to the right semi-retired Paladin.",
        "f9b56bcf1da0828f30d1": "I swear... if Quint tries to plant one more fishing grub on me, I'm going to hack down his tree with my not-so-rusty sword."
      },
      "name": "Pratt McGrubben",
      "subName": "Leatherworking Supplies",
