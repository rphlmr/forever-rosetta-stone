    "esES": {
      "dialogue": {
        "56df30c8349fde0152b7": "Me gustaría comprarte algo.",
        "6360b48d95436a45c1b5": "Saludos, $c. Si buscas artículos de cuero y suministros de peletería, has venido a ver a la persona adecuada, un paladín casi retirado.",
        "f9b56bcf1da0828f30d1": "Te lo juro... Si Quint intenta colocarme un cebo de peces más, ¡voy a cargarme a golpetazos este árbol con mi espada no tan oxidada!"
      },
      "name": "Pratt McGrubben",
      "subName": "Suministros de peletería",
