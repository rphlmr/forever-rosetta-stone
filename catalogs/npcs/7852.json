  "locales": {
    "csCZ": {
      "dialogue": {
        "56df30c8349fde0152b7": "Chtěl bych si od vás něco koupit.",
        "6360b48d95436a45c1b5": "Vítej, $c. Jestli hledáš kožené zboží a potřeby pro kožedělce, našel jsi toho pravého napůl vysloužilého paladina.",
        "f9b56bcf1da0828f30d1": "Přísahám... jestli se mi Quint ještě jednou pokusí podstrčit rybářského červa, pokácím mu strom svým ne až tak rezavým mečem."
      },
      "name": "Pratt McGrubben",
      "translationMetadata": {
        "fields": {
          "dialogue.56df30c8349fde0152b7": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.6360b48d95436a45c1b5": {
            "origin": "ai",
