    "ptBR": {
      "dialogue": {
        "56df30c8349fde0152b7": "Gostaria de comprar algo de você.",
        "6360b48d95436a45c1b5": "Saudações, $c, se você estiver procurando por mercadorias de couro e suprimentos de couraria, veio ao paladino semi-aposentado certo.",
        "f9b56bcf1da0828f30d1": "Eu juro que se o Quim tentar colocar mais uma minhoca em mim, eu vou derrubar a árvore dele com a minha espada – e olha que ela é afiada."
      },
      "name": "Pradal McGrubben",
      "subName": "Suprimentos de Couraria",
