    "hrHR": {
      "dialogue": {
        "56df30c8349fde0152b7": "Želim nešto kupiti od tebe.",
        "6360b48d95436a45c1b5": "Pozdrav, $c. Ako tražiš kožnu robu i potrepštine za obradu kože, došao si pravom poluumirovljenom paladinu.",
        "f9b56bcf1da0828f30d1": "Kunem se... ako mi Quint pokuša podmetnuti još jednog crva za pecanje, posjeći ću mu stablo svojim ne baš zahrđalim mačem."
      },
      "name": "Pratt McGrubben",
      "translationMetadata": {
