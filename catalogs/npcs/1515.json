    "ltLT": {
      "dialogue": {
        "0ce32a872be02fee0a11": "Scarlet Crusade braunasi į mūsų tėvynę.  Kvaili fanatikai nesupranta, kad ištikimi Tamsiosios Valdovės tarnai pasirūpins jų žūtimi.",
        "1efd09a136abf5dc9fde": "Išmokyk mane.",
