  "locales": {
    "csCZ": {
      "dialogue": {
        "0ce32a872be02fee0a11": "Šarlatová křížová výprava proniká do naší domoviny. Ti pošetilí fanatici netuší, že věrní služebníci Temné paní se postarají o jejich záhubu.",
        "1efd09a136abf5dc9fde": "Vycvičte mě.",
        "9d66d8ee69ca4ade1382": "Chci si prohlédnout vaše zboží."
      },
      "name": "Vykonavatel Zygand",
      "translationMetadata": {
        "fields": {
