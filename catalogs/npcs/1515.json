    "plPL": {
      "dialogue": {
        "0ce32a872be02fee0a11": "Szkarłatna Krucjata wkracza do naszej ojczyzny. Ci głupi fanatycy nie rozumieją, że wierni słudzy Mrocznej Pani dopilnują ich zagłady.",
        "1efd09a136abf5dc9fde": "Wyszkol mnie.",
        "9d66d8ee69ca4ade1382": "Chcę przejrzeć twoje towary."
