    "daDK": {
      "dialogue": {
        "0ce32a872be02fee0a11": "Det Skarlagenrøde Korstog trænger ind i vores hjemland. De tåbelige fanatikere indser ikke, at Den Mørke Frues tro tjenere vil sørge for deres undergang.",
        "1efd09a136abf5dc9fde": "Træn mig.",
        "9d66d8ee69ca4ade1382": "Jeg vil gerne se dine varer."
      },
      "name": "Eksekutor Zygand",
      "translationMetadata": {
        "fields": {
