    "hrHR": {
      "dialogue": {
        "0ce32a872be02fee0a11": "Grimizni križarski pohod prodire u našu domovinu. Ti budalasti fanatici ne shvaćaju da će se vjerne sluge Mračne Gospe pobrinuti za njihovu propast.",
        "1efd09a136abf5dc9fde": "Podučite me.",
