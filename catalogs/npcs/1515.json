    "enUS": {
      "dialogue": {
        "0ce32a872be02fee0a11": "The Scarlet Crusade is encroaching on our homeland.  The foolish zealots do not realize that the loyal servants of The Dark Lady shall see to their demise.",
        "1efd09a136abf5dc9fde": "Train me.",
        "9d66d8ee69ca4ade1382": "I want to browse your goods."
