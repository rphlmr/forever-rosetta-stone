    "ltLT": {
      "dialogue": {
        "c105c459227717364a3a": "Nukauta Lunaclaw dvasia įdėmiai į tave žvelgia, tarsi kažko iš tavęs norėtų.",
        "zephras:d34a65dbbeffe975b812": "Tu narsiai kovojai, dvasia. Prašau suteikti man savo kūno ir širdies stiprybės."
      },
      "name": "Lunaclaw dvasia",
