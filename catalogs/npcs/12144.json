    "hrHR": {
      "dialogue": {
        "c105c459227717364a3a": "Duh ubijenog Lunaclawa netremice zuri u tebe, kao da nešto želi od tebe.",
        "zephras:d34a65dbbeffe975b812": "Dobro si se borio, duše. Molim te da mi podariš snagu svojega tijela i snagu svojega srca."
      },
      "name": "Duh Lunaclawa",
