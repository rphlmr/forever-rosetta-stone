    "trTR": {
      "dialogue": {
        "c105c459227717364a3a": "Öldürülmüş Lunaclaw’un ruhu, senden bir şey istiyormuş gibi gözlerini sana dikmiş bakıyor.",
        "zephras:d34a65dbbeffe975b812": "İyi dövüştün, ruh. Bana bedeninin gücünü ve yüreğinin gücünü bahşetmeni istiyorum."
      },
      "name": "Lunaclaw Ruhu",
