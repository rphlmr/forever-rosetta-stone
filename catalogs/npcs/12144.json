    "enUS": {
      "dialogue": {
        "c105c459227717364a3a": "The slain spirit of Lunaclaw stares at you intently, as though wanting something from you.",
        "zephras:d34a65dbbeffe975b812": "You have fought well, spirit.  I ask you to grant me the strength of your body and the stength of your heart."
      },
      "name": "Lunaclaw Spirit",
