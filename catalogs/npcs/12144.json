    "csCZ": {
      "dialogue": {
        "c105c459227717364a3a": "Duch zabitého Lunaclawa na tebe upřeně hledí, jako by od tebe něco chtěl.",
        "zephras:d34a65dbbeffe975b812": "Bojoval jsi dobře, duchu. Žádám tě, abys mi propůjčil sílu svého těla a sílu svého srdce."
      },
      "name": "Duch Lunaclaw",
      "translationMetadata": {
