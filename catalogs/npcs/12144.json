    "daDK": {
      "dialogue": {
        "c105c459227717364a3a": "Den dræbte Lunaclaws ånd stirrer intenst på dig, som om den ønsker noget af dig.",
        "zephras:d34a65dbbeffe975b812": "Du har kæmpet godt, ånd. Jeg beder dig om at skænke mig din krops styrke og dit hjertes styrke."
      },
      "name": "Lunaclaws ånd",
      "translationMetadata": {
        "fields": {
