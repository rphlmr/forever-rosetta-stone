    "hrHR": {
      "dialogue": {
        "a51de58e6dc8b0963707": "Voliš li više puške ili lukove?",
        "d43d57300ab518c3cc5a": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Usluga koju nudim svakim je izvođenjem sve teža. Zato je svako preobučavanje sve skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "f92ff5282199fc52575a": "Tražim obuku u lovačkim vještinama.",
        "fe93b97d65bd813d4e04": "Nemam znanje koje tražiš."
      },
      "name": "Urek Thunderhorn",
      "translationMetadata": {
