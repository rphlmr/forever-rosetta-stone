  "locales": {
    "csCZ": {
      "dialogue": {
        "a51de58e6dc8b0963707": "Dáváš přednost puškám, nebo lukům?",
        "d43d57300ab518c3cc5a": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "f92ff5282199fc52575a": "Hledám výcvik v umění lovce.",
        "fe93b97d65bd813d4e04": "Nemám znalosti, které hledáš."
      },
      "name": "Urek Thunderhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.a51de58e6dc8b0963707": {
