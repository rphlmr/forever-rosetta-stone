    "daDK": {
      "dialogue": {
        "a51de58e6dc8b0963707": "Foretrækker du skydevåben eller buer?",
        "d43d57300ab518c3cc5a": "Gennem grundig genoptræning har jeg måttet få mange elever til at glemme alt, hvad de før havde lært, så jeg kunne lære dem det på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre hver gang. Derfor bliver hver genoptræning også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "f92ff5282199fc52575a": "Jeg søger træning i jægerens kunst.",
        "fe93b97d65bd813d4e04": "Jeg har ikke den viden, du søger."
      },
      "name": "Urek Thunderhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.a51de58e6dc8b0963707": {
