    "plPL": {
      "dialogue": {
        "a51de58e6dc8b0963707": "Wolisz broń palną czy łuki?",
        "d43d57300ab518c3cc5a": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, by móc szkolić ich na nowo. Z każdym razem ta usługa staje się trudniejsza do wykonania. Dlatego każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "f92ff5282199fc52575a": "Szukam szkolenia w sztuce łowcy.",
        "fe93b97d65bd813d4e04": "Nie posiadam wiedzy, której szukasz."
      },
      "name": "Urek Thunderhorn",
