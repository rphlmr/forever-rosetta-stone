          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "4d107b09b27775c063b3": "Nå, om det ikke er en ung, kampklar $c, uden tvivl lokket hertil af fortællinger om mine bedrifter på slagmarken!$B$BDer er ikke tid til historier nu, for store og vigtige bedrifter venter! Søger du ære, er lykken med dig i dag...",
        "7aae45d1368801d5864f": "Jeg vil gerne se dine varer.",
        "ac028712f5930466dda1": "Træn mig."
      },
      "name": "Bjergvagt Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.4d107b09b27775c063b3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
