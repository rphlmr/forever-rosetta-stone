    "hrHR": {
      "dialogue": {
        "4d107b09b27775c063b3": "Gle, mladi i borbeni $c, zacijelo privučen pričama o mojim podvizima na bojištu!$B$BSada nema vremena za priče, čekaju nas velika i važna djela! Ako tražiš slavu, sreća ti se danas smiješi...",
        "7aae45d1368801d5864f": "Želim pogledati vašu robu.",
        "ac028712f5930466dda1": "Podučite me."
      },
      "name": "Gorštak Stormpike",
