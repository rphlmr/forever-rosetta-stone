  "locales": {
    "csCZ": {
      "dialogue": {
        "4d107b09b27775c063b3": "Ale copak to tu nemáme mladého, bojovného $c? Nepochybně tě sem přivedly zvěsti o mých činech na bitevním poli!$B$BNa příběhy teď není čas, čekají nás velké a důležité skutky! Hledáš-li slávu, dnes se na tebe usmálo štěstí...",
        "7aae45d1368801d5864f": "Rád bych si prohlédl vaše zboží.",
        "ac028712f5930466dda1": "Vycvičte mě."
      },
      "name": "Horal Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.4d107b09b27775c063b3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.7aae45d1368801d5864f": {
            "origin": "ai",
