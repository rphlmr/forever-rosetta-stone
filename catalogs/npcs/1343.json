    "enUS": {
      "dialogue": {
        "4d107b09b27775c063b3": "Well, if it isn't a young, bristling $c, no doubt drawn here by talk of my exploits in fields of battle!$B$BNo time for stories now, for there are great, important deeds that need doing!  So if you're looking for glory, then luck shines on you today...",
        "7aae45d1368801d5864f": "I want to browse your goods.",
        "ac028712f5930466dda1": "Train me."
      },
      "name": "Mountaineer Stormpike",
