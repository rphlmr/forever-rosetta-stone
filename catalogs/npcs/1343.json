    "plPL": {
      "dialogue": {
        "4d107b09b27775c063b3": "Proszę, oto młody, bojowy $c, którego niewątpliwie przywiodły tu opowieści o moich czynach na polach bitew!$B$BTeraz nie czas na opowieści, czekają nas wielkie i ważne czyny! Jeśli szukasz chwały, szczęście ci dziś sprzyja...",
        "7aae45d1368801d5864f": "Chcę przejrzeć twoje towary.",
        "ac028712f5930466dda1": "Wyszkol mnie."
      },
