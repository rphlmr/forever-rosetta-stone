    "plPL": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Musisz zdobyć uwielbienie taurenów z Thunder Bluff, zanim nauczę cię jeździectwa, $c.",
        "d1934eae08d51253e5a3": "Mogę nauczyć cię tajników jazdy na kodo, o ile masz dość złota, by zapłacić za lekcję!",
        "eef0673dee07f64a2140": "Szukam szkolenia w jeździe na wierzchowcu."
      },
      "name": "Kar Stormsinger",
