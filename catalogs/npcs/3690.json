    "ltLT": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Kad išmokyčiau jus joti, $c, turite pasiekti aukštinamo asmens reputaciją tarp Thunder Bluff taurenų.",
        "d1934eae08d51253e5a3": "Galiu išmokyti jus jojimo kodais subtilybių, jei turite pakankamai aukso pamokai apmokėti!",
        "eef0673dee07f64a2140": "Noriu išmokti joti."
      },
      "name": "Kar Stormsinger",
      "subName": "Jojimo kodais instruktorius",
