  "locales": {
    "csCZ": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Než tě naučím jezdit, musíš si u taurenů z Thunder Bluff vydobýt pověst na stupni Uctívaný, $c.",
        "d1934eae08d51253e5a3": "Mohu tě naučit umění jízdy na kodovi, pokud máš dost zlata na zaplacení lekce!",
        "eef0673dee07f64a2140": "Hledám výcvik v jízdě na jezdeckém zvířeti."
      },
      "name": "Kar Stormsinger",
      "translationMetadata": {
        "fields": {
          "dialogue.58e4a3a7b65513471d23": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
