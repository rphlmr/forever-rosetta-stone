    "esES": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Necesitas ser exaltado con los tauren de Cima del Trueno antes de que pueda enseñarte a montar, $c.",
        "d1934eae08d51253e5a3": "Puedo enseñarte los mejores trucos para montar un kodo, ¡siempre que tengas suficiente oro para pagar la lección!",
        "eef0673dee07f64a2140": "Busco instrucción para aprender a montar."
      },
      "name": "Kar Tormensón",
      "subName": "Instructor de jinetes de kodos",
