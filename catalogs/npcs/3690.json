    "enUS": {
      "dialogue": {
        "58e4a3a7b65513471d23": "You need to be exalted with the tauren of Thunder Bluff before I will teach you a riding skill, $c.",
        "d1934eae08d51253e5a3": "I can teach you the finer points of Kodo Riding, provided you have enough gold to cover the lesson!",
        "eef0673dee07f64a2140": "I seek training to ride a steed."
      },
      "name": "Kar Stormsinger",
      "subName": "Kodo Riding Instructor",
      "translationMetadata": {
