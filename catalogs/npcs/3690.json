    "daDK": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Du skal have opnået ophøjet omdømme hos taurenerne fra Thunder Bluff, før jeg vil lære dig at ride, $c.",
        "d1934eae08d51253e5a3": "Jeg kan lære dig de finere detaljer i at ride på kodo, hvis du har nok guld til at betale for lektionen!",
        "eef0673dee07f64a2140": "Jeg søger undervisning i at ride på et ridedyr."
      },
      "name": "Kar Stormsinger",
      "translationMetadata": {
        "fields": {
          "dialogue.58e4a3a7b65513471d23": {
