    "trTR": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Sana binicilik öğretmeden önce Thunder Bluff taurenleri nezdinde Yüce itibarına ulaşmalısın, $c.",
        "d1934eae08d51253e5a3": "Dersin ücretini karşılayacak kadar altının varsa sana kodo biniciliğinin inceliklerini öğretebilirim!",
        "eef0673dee07f64a2140": "Bir bineğe binmeyi öğrenmek istiyorum."
      },
      "name": "Kar Stormsinger",
