    "hrHR": {
      "dialogue": {
        "58e4a3a7b65513471d23": "Moraš steći uzvišeni ugled među taurenima iz Thunder Bluffa prije nego što te naučim jahati, $c.",
        "d1934eae08d51253e5a3": "Mogu te naučiti svim pojedinostima jahanja kodoa, pod uvjetom da imaš dovoljno zlata za lekciju!",
        "eef0673dee07f64a2140": "Želim naučiti jahati jahaću životinju."
      },
      "name": "Kar Stormsinger",
