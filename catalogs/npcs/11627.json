    "enUS": {
      "dialogue": {
        "3c13e2d4d503a3ae5846": "Why is it that small creatures such as goblins are always fascinated with larger creatures?",
        "768918dd95f6bebd6d9c": "This kodo sure looks nothing like the beast I originally lured!  I wonder if the kombobulator can be used on me."
      },
      "name": "Tamed Kodo",
