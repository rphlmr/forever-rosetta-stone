    "csCZ": {
      "dialogue": {
        "3c13e2d4d503a3ae5846": "Proč jsou malí tvorové, jako jsou goblini, vždycky fascinováni většími tvory?",
        "768918dd95f6bebd6d9c": "Tohle kodo se vůbec nepodobá tomu zvířeti, které jsem původně nalákal! Zajímalo by mě, jestli by se kombobulátor dal použít i na mě."
      },
      "name": "Ochočený kodo",
