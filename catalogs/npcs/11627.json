    "daDK": {
      "dialogue": {
        "3c13e2d4d503a3ae5846": "Hvorfor er små væsner som gobliner altid fascinerede af større væsner?",
        "768918dd95f6bebd6d9c": "Denne kodo ligner slet ikke det dyr, jeg oprindeligt lokkede til mig! Mon kombobulatoren også kan bruges på mig?"
      },
      "name": "Tæmmet kodo",
