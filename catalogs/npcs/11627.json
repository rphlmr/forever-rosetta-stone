    "hrHR": {
      "dialogue": {
        "3c13e2d4d503a3ae5846": "Zašto su mala stvorenja poput goblina uvijek očarana većim stvorenjima?",
        "768918dd95f6bebd6d9c": "Ovaj kodo nimalo ne nalikuje zvijeri koju sam prvotno namamio! Pitam se može li se kombobulator upotrijebiti i na meni."
