          }
        }
      }
    },
    "esMX": {
      "dialogue": {
        "61906f21bba13a845807": "No pareces gran cosa, pero algo me dice que tienes razón. Creo que me quedaré sentado un rato más. Gracias por la charla, desconocido."
      },
      "name": "Bandido contemplativo",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
