          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "61906f21bba13a845807": "С виду ты неказист, но что-то подсказывает мне, что ты прав. Посижу-ка я здесь ещё немного. Спасибо за беседу, незнакомец."
      },
      "name": "Задумчивый бандит",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
