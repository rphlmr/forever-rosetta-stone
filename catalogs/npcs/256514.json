    "ltLT": {
      "dialogue": {
        "61906f21bba13a845807": "Neatrodai ypatingai, bet kažkas man sako, kad esi teisus. Manau, dar truputį čia pasėdėsiu. Ačiū už pokalbį, nepažįstamasis."
      },
      "name": "Susimąstęs banditas",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
