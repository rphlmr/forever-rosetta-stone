            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "61906f21bba13a845807": "Du ser ikke ud af meget, men noget siger mig, at du har ret. Jeg bliver siddende lidt endnu. Tak for snakken, fremmede."
      },
      "name": "Tankefuld bandit",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "61906f21bba13a845807": "Ihr seht nicht nach viel aus, aber irgendetwas sagt mir, dass Ihr recht habt. Ich bleibe noch eine Weile sitzen. Danke für das Gespräch, Fremde."
      },
      "name": "Nachdenklicher Bandit",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
