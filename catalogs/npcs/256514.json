            "sourceLocale": "ruRU",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "61906f21bba13a845807": "Du ser inte mycket ut för världen, men något säger mig att du har rätt. Jag sitter nog kvar en stund till. Tack för pratstunden, främling."
      },
      "name": "Eftertänksam bandit",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "61906f21bba13a845807": "Pek bir şeye benzemiyorsun ama bir şey bana haklı olduğunu söylüyor. Sanırım biraz daha burada oturacağım. Sohbet için sağ ol, yabancı."
      },
      "name": "Düşünceli Haydut",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "61906f21bba13a845807": "На вигляд ти не бозна-хто, але щось підказує, що ти маєш рацію. Посиджу тут ще трохи. Дякую за розмову, незнайомцю."
      },
      "name": "задумливий бандит",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
