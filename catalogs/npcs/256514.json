          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "61906f21bba13a845807": "No pareces gran cosa, pero algo me dice que tienes razón. Creo que me quedaré aquí un rato más. Gracias por la charla, forastera."
      },
      "name": "Bandido contemplativo",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "esES",
