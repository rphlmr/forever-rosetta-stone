        }
      }
    },
    "zhCN": {
      "dialogue": {
        "61906f21bba13a845807": "你看起来不怎么样，但直觉告诉我你是对的。我想再在这里坐一会儿。谢谢你陪我聊天，陌生人。"
      },
      "name": "沉思的强盗",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
