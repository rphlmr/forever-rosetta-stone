            "sourceLocale": "enUS"
          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "61906f21bba13a845807": "Nie wyglądasz imponująco, ale coś mi mówi, że masz rację. Posiedzę tu jeszcze trochę. Dzięki za rozmowę, nieznajomy."
      },
      "name": "Zamyślony bandyta",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "61906f21bba13a845807": "Você não parece grande coisa, mas algo me diz que tem razão. Acho que vou ficar aqui mais um pouco. Obrigado pela conversa, desconhecido."
      },
      "name": "Bandido Contemplativo",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
