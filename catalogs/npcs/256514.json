  "locales": {
    "csCZ": {
      "dialogue": {
        "61906f21bba13a845807": "Nevypadáš nijak zvláštně, ale něco mi říká, že máš pravdu. Ještě tu chvíli posedím. Díky za rozhovor, cizinče."
      },
      "name": "Rozjímavý bandita",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
