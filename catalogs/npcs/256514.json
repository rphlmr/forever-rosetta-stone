        }
      }
    },
    "itIT": {
      "dialogue": {
        "61906f21bba13a845807": "Non sembri un granché, ma qualcosa mi dice che hai ragione. Credo che resterò seduto qui ancora un po'. Grazie per la chiacchierata, straniero."
      },
      "name": "Bandito pensieroso",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
