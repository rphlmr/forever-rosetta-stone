        }
      }
    },
    "enUS": {
      "dialogue": {
        "61906f21bba13a845807": "You don't look like much, but something tells me you are right. I think I'll just sit here a bit longer. Thanks for the chat, stranger."
      },
      "name": "Contemplative Bandit",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
