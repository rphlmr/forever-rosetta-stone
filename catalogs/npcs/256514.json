    "hrHR": {
      "dialogue": {
        "61906f21bba13a845807": "Ne izgledaš kao netko poseban, ali nešto mi govori da si u pravu. Još ću malo sjediti ovdje. Hvala na razgovoru, stranče."
      },
      "name": "Zamišljeni razbojnik",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
