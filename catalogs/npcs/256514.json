          }
        }
      }
    },
    "frFR": {
      "dialogue": {
        "61906f21bba13a845807": "On ne dirait pas, à vous regarder, mais quelque chose me dit que vous avez raison. Je vais rester assis là encore un peu. Merci de vous être arrêté pour bavarder."
      },
      "name": "Bandit contemplatif",
      "translationMetadata": {
        "fields": {
          "dialogue.61906f21bba13a845807": {
