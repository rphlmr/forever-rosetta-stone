          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "38d203f89cb0a0726aff": "Gennem streng genoplæring har jeg måttet få mange elever til at glemme alt, hvad de før havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre for hver gang. Derfor bliver den også dyrere ved hver genoplæring. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "4e09138823cf3e8e1fcb": "Vend ikke Lyset ryggen, $c. Det kan en dag være det eneste, der redder dig.",
        "5b9782a8d7bd0441d277": "Jeg stoler på, at Lyset er med dig, $n. Er der noget, jeg kan hjælpe dig med?",
        "d16eb8865d604c2c5c27": "Jeg søger mere træning i præsternes kunst."
      },
      "name": "Præstinde Anetta",
      "translationMetadata": {
        "fields": {
