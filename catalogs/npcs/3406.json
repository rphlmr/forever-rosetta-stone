    "enUS": {
      "dialogue": {
        "23f25bd12025f2930445": "Hey mon, you be needin' to head on over to da $c trainer.",
        "2a6493b9af169ff5aaf0": "What kin I do for ya, mon?",
        "47724e1f5a79e74930f2": "I seek training in the ways of the Hunter.",
        "8f1cda7edd18ae120053": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Xor'juul",
      "subName": "Hunter Trainer",
      "translationMetadata": {
        "fields": {
