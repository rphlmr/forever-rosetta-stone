    "hrHR": {
      "dialogue": {
        "23f25bd12025f2930445": "Hej, prijatelju, moraš otići do učitelja za $c.",
        "2a6493b9af169ff5aaf0": "Što mogu učiniti za tebe, prijatelju?",
        "47724e1f5a79e74930f2": "Tražim obuku u lovačkim vještinama.",
        "8f1cda7edd18ae120053": "Temeljitim prekvalificiranjem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao podučiti iznova. Tu je uslugu sve teže pružiti svaki put kad se obavi. Zato je svako sljedeće prekvalificiranje sve skuplje. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Xor'juul",
