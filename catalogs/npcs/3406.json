    "plPL": {
      "dialogue": {
        "23f25bd12025f2930445": "Hej, przyjacielu, musisz udać się do trenera klasy $c.",
        "2a6493b9af169ff5aaf0": "Co mogę dla ciebie zrobić, przyjacielu?",
        "47724e1f5a79e74930f2": "Szukam szkolenia w sztuce łowcy.",
        "8f1cda7edd18ae120053": "Podczas gruntownego przekwalifikowania musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, aby móc uczyć ich od nowa. Ta usługa staje się coraz trudniejsza przy każdym powtórzeniu. Dlatego każde kolejne przekwalifikowanie kosztuje więcej. Czy mam sprawić, że zapomnisz poznane talenty?"
      },
      "name": "Xor'juul",
      "translationMetadata": {
        "fields": {
          "dialogue.23f25bd12025f2930445": {
