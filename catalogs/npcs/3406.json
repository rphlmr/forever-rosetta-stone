    },
    "daDK": {
      "dialogue": {
        "23f25bd12025f2930445": "Hey, ven, du skal hen til $c-træneren.",
        "2a6493b9af169ff5aaf0": "Hvad kan jeg gøre for dig, ven?",
        "47724e1f5a79e74930f2": "Jeg søger træning i jægerens kunst.",
        "8f1cda7edd18ae120053": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre for hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Xor'juul",
      "translationMetadata": {
        "fields": {
          "dialogue.23f25bd12025f2930445": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
