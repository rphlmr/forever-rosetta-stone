    "trTR": {
      "dialogue": {
        "23f25bd12025f2930445": "Hey dostum, $c eğitmenine gitmelisin.",
        "2a6493b9af169ff5aaf0": "Senin için ne yapabilirim, dostum?",
        "47724e1f5a79e74930f2": "Avcılığın yollarını öğrenmek istiyorum.",
        "8f1cda7edd18ae120053": "Titiz bir yeniden eğitimle birçok öğrenciye önceden öğrendikleri her şeyi unutturmak zorunda kaldım ki onlara yeniden öğretebileyim. Sunduğum bu hizmet her tekrarlandığında daha zorlaşıyor. Bu nedenle her yeniden eğitimde ücreti artıyor. Öğrendiğin yetenekleri sana unutturmamı ister misin?"
      },
      "name": "Xor'juul",
      "translationMetadata": {
