  "locales": {
    "csCZ": {
      "dialogue": {
        "23f25bd12025f2930445": "Hej, kámo, musíš zajít za trenérem $c.",
        "2a6493b9af169ff5aaf0": "Co pro tebe můžu udělat, kámo?",
        "47724e1f5a79e74930f2": "Hledám výcvik v umění lovce.",
        "8f1cda7edd18ae120053": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým opakováním těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které sis osvojil?"
      },
      "name": "Xor'juul",
      "translationMetadata": {
        "fields": {
          "dialogue.23f25bd12025f2930445": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
