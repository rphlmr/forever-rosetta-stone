    "csCZ": {
      "dialogue": {
        "61982d47f01d9d3d0790": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "90474698bc18f80ea7f9": "Rád bych si prohlédl vaše zboží.",
        "b1c21be0feceffc6e03a": "Nejlepší ceny v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?"
      },
      "name": "Lisbeth Schneider",
