    "daDK": {
      "dialogue": {
        "61982d47f01d9d3d0790": "Ser du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?",
        "90474698bc18f80ea7f9": "Jeg vil gerne se dine varer.",
        "b1c21be0feceffc6e03a": "De bedste tilbud i hele Stormwind, min ven, du finder ikke bedre. Hvad kan jeg hjælpe dig med?"
      },
      "name": "Lisbeth Schneider",
