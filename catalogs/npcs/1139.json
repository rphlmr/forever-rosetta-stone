    "itIT": {
      "dialogue": {
        "03afa06d08f7c734f756": "Addestrami.",
        "5ad2632d02318e8ae3a7": "Salve, cittadino. Mi chiamo Bluntnose, magistrato Bluntnose, per la precisione. Sono incaricato di vigilare sul benessere di Thelsamar e, credimi, un altro paio di braccia forti ci farebbe sempre comodo!",
        "f0bcbdd8d71cd1284f00": "Vorrei vedere la tua merce."
      },
      "name": "Magistrato Bluntnose",
