    },
    "daDK": {
      "dialogue": {
        "03afa06d08f7c734f756": "Træn mig.",
        "5ad2632d02318e8ae3a7": "Goddag, borger. Navnet er Bluntnose, magistrat Bluntnose, for at være præcis. Jeg skal sørge for Thelsamars velfærd, og tro mig, vi kan altid bruge endnu et par stærke arme her!",
        "f0bcbdd8d71cd1284f00": "Jeg vil gerne se dine varer."
      },
      "name": "Magistrat Bluntnose",
      "translationMetadata": {
        "fields": {
