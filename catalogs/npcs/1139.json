    "csCZ": {
      "dialogue": {
        "03afa06d08f7c734f756": "Vycvičte mě.",
        "5ad2632d02318e8ae3a7": "Zdravím tě, občane. Jmenuji se Bluntnose, přesněji magistrát Bluntnose. Dohlížím na blaho Thelsamaru a věř mi, další pár silných rukou by se nám tu vždycky hodil!",
        "f0bcbdd8d71cd1284f00": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Rychtář Bluntnose",
      "translationMetadata": {
        "fields": {
