    "esMX": {
      "dialogue": {
        "03afa06d08f7c734f756": "Entréname.",
        "5ad2632d02318e8ae3a7": "Bueno, hola, ciudadano. El nombre es Narizroma, Magistrado Narizroma para ser precisos. Estoy encargado de supervisar el bienestar de Thelsamar, y créeme, ¡siempre podríamos usar otro par de brazos fuertes por aquí!",
        "f0bcbdd8d71cd1284f00": "Quiero ver tus mercancías."
      },
