    "plPL": {
      "dialogue": {
        "03afa06d08f7c734f756": "Wyszkol mnie.",
        "5ad2632d02318e8ae3a7": "Witaj, obywatelu. Nazywam się Bluntnose, a dokładniej magistrat Bluntnose. Dbam o dobrobyt Thelsamaru i uwierz mi, kolejna para silnych rąk zawsze się tu przyda!",
        "f0bcbdd8d71cd1284f00": "Chcę przejrzeć twoje towary."
      },
