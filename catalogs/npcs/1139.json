    "esES": {
      "dialogue": {
        "03afa06d08f7c734f756": "Entréname.",
        "5ad2632d02318e8ae3a7": "Hola, ciudadano. Me llamo Bluntnose, Magistrado Bluntnose, para ser exactos. Estoy encargado de supervisar el bienestar de Thelsamar, y créeme, ¡siempre nos vendría bien otro par de brazos fuertes por aquí!",
        "f0bcbdd8d71cd1284f00": "Quiero ver tus mercancías."
      },
      "name": "Magistrado Romonariz",
