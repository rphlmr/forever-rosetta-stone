    "hrHR": {
      "dialogue": {
        "03afa06d08f7c734f756": "Podučite me.",
        "5ad2632d02318e8ae3a7": "Pozdrav, građanine. Zovem se Bluntnose, točnije magistrat Bluntnose. Zadužen sam za dobrobit Thelsamara i vjeruj mi, još jedan par snažnih ruku uvijek je dobrodošao!",
        "f0bcbdd8d71cd1284f00": "Želim pogledati vašu robu."
      },
      "name": "Sudac Bluntnose",
