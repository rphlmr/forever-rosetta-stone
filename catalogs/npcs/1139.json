    "enUS": {
      "dialogue": {
        "03afa06d08f7c734f756": "Train me.",
        "5ad2632d02318e8ae3a7": "Well hello there, citizen. The name's Bluntnose, Magistrate Bluntnose, to be precise. I'm charged with overseeing the well-being of Thelsamar, and believe you me, we could always use another strong set of arms around here!",
        "f0bcbdd8d71cd1284f00": "I want to browse your goods."
      },
      "name": "Magistrate Bluntnose",
