    "frFR": {
      "dialogue": {
        "03afa06d08f7c734f756": "Entraînez-moi.",
        "5ad2632d02318e8ae3a7": "Bonjour, citoyen. Je m'appelle Bluntnose, le magistrat Bluntnose, pour être précis. Je suis chargé de veiller au bien-être du Thelsamar, et croyez-moi, nous avons toujours besoin d'une autre paire de bras solides par ici !",
        "f0bcbdd8d71cd1284f00": "Je voudrais regarder vos articles."
      },
      "name": "Magistrat Bluntnose",
