    "ptBR": {
      "dialogue": {
        "03afa06d08f7c734f756": "Treine-me.",
        "5ad2632d02318e8ae3a7": "Olá, cidadão. Meu nome é Bluntnose, magistrado Bluntnose, para ser exato. Sou responsável pelo bem-estar de Thelsamar e, acredite, sempre precisamos de mais um par de braços fortes por aqui!",
        "f0bcbdd8d71cd1284f00": "Quero ver suas mercadorias."
      },
      "name": "Magistrado Grã-narina",
