    "trTR": {
      "dialogue": {
        "03afa06d08f7c734f756": "Beni eğit.",
        "5ad2632d02318e8ae3a7": "Merhaba vatandaş. Adım Bluntnose, daha doğrusu Yargıç Bluntnose. Thelsamar’ın refahını gözetmekle görevliyim ve inan bana, buralarda bir çift güçlü kola her zaman ihtiyaç var!",
        "f0bcbdd8d71cd1284f00": "Mallarına bakmak istiyorum."
      },
      "name": "Yargıç Bluntnose",
