    "deDE": {
      "dialogue": {
        "03afa06d08f7c734f756": "Bildet mich aus.",
        "5ad2632d02318e8ae3a7": "Guten Tag, Bürger. Mein Name ist Bluntnose, Magistrat Bluntnose, um genau zu sein. Ich bin damit beauftragt, das Wohlergehen von Thelsamar zu überwachen, und glauben Sie mir, wir können hier immer ein weiteres starkes Paar Arme gebrauchen!",
        "f0bcbdd8d71cd1284f00": "Ich möchte Eure Waren ansehen."
      },
      "name": "Magistrat Bluntnose",
      "translationMetadata": {
        "fields": {
