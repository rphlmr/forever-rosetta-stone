    "svSE": {
      "dialogue": {
        "03afa06d08f7c734f756": "Träna mig.",
        "5ad2632d02318e8ae3a7": "Goddag, medborgare. Namnet är Bluntnose, magistrat Bluntnose, närmare bestämt. Jag ansvarar för Thelsamars välbefinnande och tro mig, vi kan alltid använda ännu ett par starka armar här!",
        "f0bcbdd8d71cd1284f00": "Jag vill se dina varor."
      },
      "name": "Magistrat Bluntnose",
