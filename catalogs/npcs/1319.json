    "csCZ": {
      "dialogue": {
        "7f31d95102cf442cf4d7": "Prodávám jen tu nejlepší, osvědčenou výstroj. Ceny jsou pevné, takže jestli chceš smlouvat, najdi si goblina.",
        "ef16813e7f9019fa639c": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Bryan Cross",
