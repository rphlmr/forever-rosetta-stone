    "hrHR": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Posvuda su bili lopovi! $b$bBilo je užasno. Špilja se urušila na nas. Mislim da je cijela rudarska družina mrtva, uključujući mog brata, predradnika.",
        "2c02f869b632c0637ec2": "Podučite me.",
        "b6ba599a0d885269c80b": "Želim pogledati vašu robu."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
