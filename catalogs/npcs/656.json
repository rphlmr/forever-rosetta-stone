    "plPL": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Wszędzie byli złodzieje! $b$bTo było straszne. Jaskinia zawaliła się na nas. Chyba cała załoga górnicza zginęła, razem z moim bratem, sztygarem.",
        "2c02f869b632c0637ec2": "Wyszkol mnie.",
        "b6ba599a0d885269c80b": "Chcę przejrzeć twoje towary."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
        "fields": {
