    "trTR": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Her yerde hırsızlar vardı! $b$bKorkunçtu. Mağara üzerimize çöktü. Sanırım ustabaşı olan kardeşim de dahil bütün madenciler öldü.",
        "2c02f869b632c0637ec2": "Beni eğit.",
        "b6ba599a0d885269c80b": "Mallarına bakmak istiyorum."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
