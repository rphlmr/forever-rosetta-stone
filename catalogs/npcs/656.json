          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Überall gab es Diebe!\n\nEs war furchtbar.  Die Höhle stürzte auf uns ein.  Ich glaube, die Minengesellschaft ist tot, auch mein Bruder, der Vorarbeiter.",
        "2c02f869b632c0637ec2": "Bildet mich aus.",
        "b6ba599a0d885269c80b": "Ich möchte Eure Waren ansehen."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
        "fields": {
          "dialogue.0f72385b88cb49f6b494": {
