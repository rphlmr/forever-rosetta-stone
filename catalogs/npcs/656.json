  "locales": {
    "csCZ": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Všude byli zloději! $b$bBylo to strašné. Jeskyně se na nás zřítila. Myslím, že celá těžařská výprava zahynula, včetně mého bratra, předáka.",
        "2c02f869b632c0637ec2": "Vycvičte mě.",
        "b6ba599a0d885269c80b": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
        "fields": {
          "dialogue.0f72385b88cb49f6b494": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
