    "esMX": {
      "dialogue": {
        "0f72385b88cb49f6b494": "¡Había ladrones por todas partes!\n\nFue horrible. La cueva cayó sobre nosotros. Creo que la compañía minera está muerta, incluido mi hermano, el Capataz.",
        "2c02f869b632c0637ec2": "Entréname.",
        "b6ba599a0d885269c80b": "Quiero ver tus mercancías."
      },
      "name": "Wilder Cardortiga",
