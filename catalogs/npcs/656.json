    "svSE": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Det var tjuvar överallt! $b$bDet var hemskt. Grottan rasade in över oss. Jag tror att hela gruvlaget är dött, inklusive min bror, förmannen.",
        "2c02f869b632c0637ec2": "Träna mig.",
        "b6ba599a0d885269c80b": "Jag vill se dina varor."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
        "fields": {
