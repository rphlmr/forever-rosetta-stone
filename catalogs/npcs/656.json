    "itIT": {
      "dialogue": {
        "0f72385b88cb49f6b494": "C'erano ladri dappertutto!\n\nÈ stato orribile. La grotta ci è crollata addosso. Credo che quelli della compagnia mineraria siano tutti morti, compreso mio fratello, il Caposquadra.",
        "2c02f869b632c0637ec2": "Addestrami.",
        "b6ba599a0d885269c80b": "Vorrei vedere la tua merce."
      },
      "name": "Wilder Thistlenettle",
