    "ptBR": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Havia ladrões por toda parte! $b$bFoi horrível. A caverna desabou sobre nós. Acho que toda a equipe de mineração morreu, incluindo meu irmão, o encarregado.",
        "2c02f869b632c0637ec2": "Treine-me.",
        "b6ba599a0d885269c80b": "Quero ver suas mercadorias."
      },
      "name": "Wilder Urtigão",
      "translationMetadata": {
        "fields": {
