    "esES": {
      "dialogue": {
        "0f72385b88cb49f6b494": "¡Había ladrones por todas partes! Fue horrible.  La cueva se nos vino encima.  Creo que toda la compañía minera está muerta, incluido mi hermano, el capataz.",
        "2c02f869b632c0637ec2": "Entréname.",
        "b6ba599a0d885269c80b": "Quiero ver tus mercancías."
      },
      "name": "Wilder Cardortiga",
