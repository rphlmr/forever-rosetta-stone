    "daDK": {
      "dialogue": {
        "0f72385b88cb49f6b494": "Der var tyve overalt! $b$bDet var forfærdeligt. Hulen styrtede sammen over os. Jeg tror, at hele mineholdet er dødt, inklusive min bror, formanden.",
        "2c02f869b632c0637ec2": "Træn mig.",
        "b6ba599a0d885269c80b": "Jeg vil gerne se dine varer."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
        "fields": {
          "dialogue.0f72385b88cb49f6b494": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
