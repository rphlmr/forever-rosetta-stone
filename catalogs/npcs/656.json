    "enUS": {
      "dialogue": {
        "0f72385b88cb49f6b494": "There were thieves everywhere! $b$bIt was horrible.  The cave came down on us.  I think the mining company is all dead, including my brother, the Foreman.",
        "2c02f869b632c0637ec2": "Train me.",
        "b6ba599a0d885269c80b": "I want to browse your goods."
      },
      "name": "Wilder Thistlenettle",
      "translationMetadata": {
        "fields": {
