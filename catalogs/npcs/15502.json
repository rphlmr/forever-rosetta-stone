    "enUS": {
      "dialogue": {
        "16ae7d1421fa5fe9bec2": "With the Emperors slain, the magical protection blocking teleportation within the temple has been greatly weakened. If you desire, I am able to translocate you to the Emperors' lair.",
        "bd53a562963cf7afcf1d": "With Ouro slain the way is clear to the final chamber. I am able to transport you there, if you desire.",
        "ffb2cd60e0e8e158e1a7": "Step carefully mortal.  You tread where mightier beings have met their fate."
      },
      "name": "Andorgos",
      "subName": "Brood of Malygos",
      "translationMetadata": {
        "fields": {
