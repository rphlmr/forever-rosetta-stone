    "plPL": {
      "dialogue": {
        "16ae7d1421fa5fe9bec2": "Po śmierci cesarzy magiczna ochrona blokująca teleportację w świątyni znacznie osłabła. Jeśli chcesz, mogę przenieść cię do ich legowiska.",
        "bd53a562963cf7afcf1d": "Ouro nie żyje, a droga do ostatniej komnaty jest wolna. Jeśli chcesz, mogę cię tam przenieść.",
        "ffb2cd60e0e8e158e1a7": "Stąpaj ostrożnie, śmiertelniku. Kroczysz tam, gdzie potężniejsze istoty spotkał ich los."
      },
      "name": "Andorgos",
