    "hrHR": {
      "dialogue": {
        "16ae7d1421fa5fe9bec2": "Smrću careva čarobna zaštita koja sprječava teleportaciju unutar hrama znatno je oslabila. Ako želiš, mogu te premjestiti u njihovu jazbinu.",
        "bd53a562963cf7afcf1d": "Ouro je ubijen i put do posljednje odaje je slobodan. Mogu te onamo prenijeti ako želiš.",
        "ffb2cd60e0e8e158e1a7": "Koračaj oprezno, smrtniče. Hodaš ondje gdje su moćnija bića dočekala svoju sudbinu."
      },
      "name": "Andorgos",
