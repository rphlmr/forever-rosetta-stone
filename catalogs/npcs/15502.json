      }
    },
    "daDK": {
      "dialogue": {
        "16ae7d1421fa5fe9bec2": "Med kejsernes død er den magiske beskyttelse, der blokerer teleportation i templet, blevet stærkt svækket. Hvis du ønsker det, kan jeg flytte dig til kejsernes hule.",
        "bd53a562963cf7afcf1d": "Ouro er dræbt, og vejen til det sidste kammer er fri. Jeg kan transportere dig derhen, hvis du ønsker det.",
        "ffb2cd60e0e8e158e1a7": "Træd varsomt, dødelige. Du færdes, hvor mægtigere væsener har mødt deres skæbne."
      },
      "name": "Andorgos",
      "translationMetadata": {
        "fields": {
          "dialogue.16ae7d1421fa5fe9bec2": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
