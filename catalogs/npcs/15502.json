  "locales": {
    "csCZ": {
      "dialogue": {
        "16ae7d1421fa5fe9bec2": "Smrtí císařů byla magická ochrana bránící teleportaci v chrámu značně oslabena. Pokud si přeješ, mohu tě přemístit do jejich doupěte.",
        "bd53a562963cf7afcf1d": "Ouro je mrtev a cesta do poslední komnaty je volná. Pokud si přeješ, mohu tě tam přemístit.",
        "ffb2cd60e0e8e158e1a7": "Našlapuj opatrně, smrtelníku. Kráčíš tam, kde mocnější bytosti našly svůj konec."
      },
      "name": "Andorgos",
      "translationMetadata": {
        "fields": {
          "dialogue.16ae7d1421fa5fe9bec2": {
