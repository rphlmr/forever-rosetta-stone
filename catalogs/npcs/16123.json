            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "3b41be77ddc2aae038dc": "Det var vist en dårlig investering!$B$BLord Valthalaks mørke tryllebog indbragte en pæn sum på det sorte marked. Ærgerligt, at han ikke tog særlig pænt imod, at hans ejendele blev stjålet. Den slyngel fik ram på os, selvom han havde været død i månedsvis!"
      },
      "name": "Gremnik Rizzlesprang",
      "translationMetadata": {
        "fields": {
          "dialogue.3b41be77ddc2aae038dc": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
