          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "3b41be77ddc2aae038dc": "Talk about making the wrong investment!$B$BLord Valthalak's dark book of spells fetched a pretty penny in the black market.  It's too bad he didn't take too kindly to getting his possessions stolen.  That stinker got us even after he'd been dead for months!"
      },
      "name": "Gremnik Rizzlesprang",
      "translationMetadata": {
        "fields": {
          "dialogue.3b41be77ddc2aae038dc": {
            "origin": "community",
