  "locales": {
    "csCZ": {
      "dialogue": {
        "3b41be77ddc2aae038dc": "Tomu říkám špatná investice!$B$BTemná kniha kouzel lorda Valthalaka vynesla na černém trhu pěkný balík. Škoda, že se mu krádež jeho majetku vůbec nelíbila. Ten prevít nás dostal, i když už byl několik měsíců po smrti!"
      },
      "name": "Gremnik Rizzlesprang",
      "translationMetadata": {
        "fields": {
          "dialogue.3b41be77ddc2aae038dc": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
