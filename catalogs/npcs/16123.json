          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "3b41be77ddc2aae038dc": "Snacka om en dålig investering!$B$BLord Valthalaks mörka trollformelbok inbringade en rejäl slant på svarta marknaden. Synd bara att han inte uppskattade att få sina ägodelar stulna. Den rackaren kom åt oss trots att han hade varit död i flera månader!"
      },
      "name": "Gremnik Rizzlesprang",
      "translationMetadata": {
        "fields": {
