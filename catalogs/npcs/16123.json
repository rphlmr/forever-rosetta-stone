            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "3b41be77ddc2aae038dc": "Man kann wohl sagen, dass das keine gute Investition war!\n\nLord Valthalaks Zauberbuch erzielte zwar einen guten Preis auf dem Schwarzmarkt, allerdings reagierte er nicht besonders gut darauf, bestohlen zu werden. Sein verdammter Geist hat uns noch drangekriegt, nachdem er schon Monate tot war!"
      },
      "name": "Gremnik Rizzlesprang",
      "translationMetadata": {
        "fields": {
          "dialogue.3b41be77ddc2aae038dc": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
