    "ltLT": {
      "dialogue": {
        "1122530836591fbd2b91": "Mes su Glyx esame sutarę: jis mane aprūpina, o aš jį turtinu. Tikrai! Kiek tas piratas iš manęs lupa už menką maišelį suglamžytų karaliakraujių... net suaugęs goblinas apsiverktų.",
        "3220b173241d7522a024": "Tu šį amatą išmanai geriau už mane! Tau reikia ko nors dar labiau patyrusio. Kreipkis į Ainethil, naktinę elfę, gyvenančią Darnassuso Amatininkų terasoje.",
        "3ca553dc9fac345c22f6": "Išmokyk mane.",
        "4b43c59430705e578fb6": "Turiu daugybę puikių receptų, kuriuos gali apžiūrėti, ir dar su nuolaida!",
        "e1ac436011c8e65c5043": "Tu šį amatą išmanai geriau už mane! Tau reikia ko nors dar labiau patyrusio. Kreipkis į daktarą Herbertą Halsey, nemirėlį, dirbantį Undercity vaistinėje."
      },
      "name": "Jaxin Chong",
      "subName": "Alchemijos ekspertas",
      "translationMetadata": {
        "fields": {
