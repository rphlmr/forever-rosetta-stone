    "csCZ": {
      "dialogue": {
        "43353988c7f2a0888ee1": "Mám na tebe otázku, $c:$BKterý z Aspektů stvořených titány se stal ničemným tvorem známým jako Deathwing?",
        "74ecf1077cb2af7aac99": "Zdravím tě, $c. Mohu ti s něčím pomoci?",
        "zephras:03fb93e625b9164817b9": "Moje odpověď je Ysera.",
        "zephras:349a93b50d714070631b": "Má odpověď je Malygos.",
        "zephras:acf33e8e7ee014202435": "Má odpověď je Neltharion.",
        "zephras:f161aea118324490080d": "Alexstrasza je má odpověď."
      },
      "name": "Braug Dimspirit",
