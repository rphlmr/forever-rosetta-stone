    "daDK": {
      "dialogue": {
        "43353988c7f2a0888ee1": "Mit spørgsmål til dig er, $c:$BHvilket af Aspekterne, som titanerne skabte, blev til det onde væsen kendt som Deathwing?",
        "74ecf1077cb2af7aac99": "Hilsner, $c. Er der noget, jeg kan hjælpe dig med?",
        "zephras:03fb93e625b9164817b9": "Mit svar er Ysera.",
        "zephras:349a93b50d714070631b": "Malygos er mit svar.",
        "zephras:acf33e8e7ee014202435": "Mit svar er Neltharion.",
        "zephras:f161aea118324490080d": "Alexstrasza er mit svar."
      },
      "name": "Braug Dimspirit",
