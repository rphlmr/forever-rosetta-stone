    "plPL": {
      "dialogue": {
        "43353988c7f2a0888ee1": "Oto moje pytanie, $c:$BKtóry z Aspektów stworzonych przez tytanów stał się nikczemną istotą znaną jako Deathwing?",
        "74ecf1077cb2af7aac99": "Witaj, $c. Czy mogę ci w czymś pomóc?",
        "zephras:03fb93e625b9164817b9": "Moją odpowiedzią jest Ysera.",
        "zephras:349a93b50d714070631b": "Moją odpowiedzią jest Malygos.",
