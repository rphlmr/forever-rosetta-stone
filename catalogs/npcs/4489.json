    "deDE": {
      "dialogue": {
        "43353988c7f2a0888ee1": "Meine Frage an Euch, $C, ist diese:\nAus welchem der Aspekte, die von den Titanen geschaffen wurden, wurde die schändliche Kreatur erschaffen, die als Deathwing bekannt ist?",
        "74ecf1077cb2af7aac99": "Seid gegrüßt, $C. Kann ich Euch irgendwie helfen?",
        "zephras:03fb93e625b9164817b9": "Meine Antwort ist Ysera.",
        "zephras:349a93b50d714070631b": "Meine Antwort ist Malygos.",
        "zephras:acf33e8e7ee014202435": "Meine Antwort ist Neltharion.",
        "zephras:f161aea118324490080d": "Meine Antwort ist Alexstrasza."
      },
      "name": "Braug Dimspirit",
