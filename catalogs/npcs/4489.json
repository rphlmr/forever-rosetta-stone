    "ptBR": {
      "dialogue": {
        "43353988c7f2a0888ee1": "Minha pergunta para você é a seguinte, $c:\n\nQual dos Aspectos criados pelos titãs se tornou a criatura abominável conhecida como Asa da Morte?",
        "74ecf1077cb2af7aac99": "Saudações, $c. Há algo em que eu possa lhe ajudar?",
        "zephras:03fb93e625b9164817b9": "Minha resposta é Ysera.",
        "zephras:349a93b50d714070631b": "Minha resposta é Malygos.",
        "zephras:acf33e8e7ee014202435": "Minha resposta é Neltharion.",
        "zephras:f161aea118324490080d": "Minha resposta é Alexstrasza."
      },
