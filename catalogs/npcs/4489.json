    "koKR": {
      "dialogue": {
        "43353988c7f2a0888ee1": "내가 그대에게 할 질문은 이것일세.\n티탄이 창조한 위상 중 데스윙이라는 사악한 존재가 된 것은 무엇인가?",
        "74ecf1077cb2af7aac99": "어서 오게, $c. 내가 도울 일이라도 있나?",
        "zephras:03fb93e625b9164817b9": "이세라입니다.",
        "zephras:349a93b50d714070631b": "말리고스입니다.",
        "zephras:acf33e8e7ee014202435": "넬타리온입니다.",
        "zephras:f161aea118324490080d": "알렉스트라자입니다."
      },
      "name": "브라우그 딤스피릿",
