    "hrHR": {
      "dialogue": {
        "e071632439c0ed2de647": "Pozdrav, $c, i dobro došao na prvu crtu našeg osvajanja Ashenvalea! Ako tražiš posao, na pravom si mjestu. Uvijek tražim sposobne ljude koji će donijeti slavu Hordi!"
      },
      "name": "Karang Amakkar",
      "translationMetadata": {
