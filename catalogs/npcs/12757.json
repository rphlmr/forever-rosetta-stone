    "enUS": {
      "dialogue": {
        "e071632439c0ed2de647": "Greeting $c - welcome to the front lines in our conquest of Ashenvale!  If you are looking for something to do, then you've come to the right place.  I'm always looking for able-bodied individuals to help bring glory to the Horde!"
      },
      "name": "Karang Amakkar",
      "translationMetadata": {
        "fields": {
          "dialogue.e071632439c0ed2de647": {
