    "ltLT": {
      "dialogue": {
        "e071632439c0ed2de647": "Sveikinu, $c, atvykus į mūsų Ashenvale užkariavimo fronto linijas!  Jei ieškai, kuo užsiimti, atėjai ten, kur reikia.  Man visada reikia stiprių žmonių, kurie padėtų pelnyti šlovę Ordai!"
      },
      "name": "Karang Amakkar",
