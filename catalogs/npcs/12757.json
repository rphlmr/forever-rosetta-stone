    "plPL": {
      "dialogue": {
        "e071632439c0ed2de647": "Witaj, $c, na pierwszej linii naszego podboju Ashenvale! Jeśli szukasz zajęcia, trafiasz we właściwe miejsce. Zawsze szukam zdolnych osób, które pomogą przysporzyć Hordzie chwały!"
      },
      "name": "Karang Amakkar",
