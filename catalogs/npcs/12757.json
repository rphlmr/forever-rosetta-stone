    "daDK": {
      "dialogue": {
        "e071632439c0ed2de647": "Hilsner, $c, og velkommen til frontlinjen i vores erobring af Ashenvale! Hvis du leder efter noget at lave, er du kommet til det rette sted. Jeg søger altid dygtige folk, der vil bringe Horden ære!"
      },
      "name": "Karang Amakkar",
      "translationMetadata": {
