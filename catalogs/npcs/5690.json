    "frFR": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Je peux vous apprendre à pêcher.",
        "5fd300d0335f42290493": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "9d89df4d41d73cd2a64e": "Entraînez-moi.",
        "d19267a7ac8e9a7ac0ae": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange."
      },
      "name": "Clyde Kellen",
      "subName": "Pêcheur",
