    "ltLT": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Galiu išmokyti tave žvejoti.",
        "5fd300d0335f42290493": "Tavo įgūdžiai pranoksta manuosius, tačiau girdėjau, kad senolis Heming Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau patobulinti įgūdžius.",
        "9d89df4d41d73cd2a64e": "Išmokyk mane.",
        "d19267a7ac8e9a7ac0ae": "Jei nori dar labiau patobulėti, turėsi surasti Nat Pagle Dustwallow Marsh pelkėse."
      },
      "name": "Clyde Kellen",
      "subName": "Žvejys",
