    "deDE": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "5fd300d0335f42290493": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern.",
        "9d89df4d41d73cd2a64e": "Bildet mich aus.",
        "d19267a7ac8e9a7ac0ae": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können."
      },
      "name": "Clyde Kellen",
      "subName": "Angler",
      "translationMetadata": {
