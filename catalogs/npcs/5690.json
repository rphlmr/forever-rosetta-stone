    "esES": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Puedo enseñarte a pescar.",
        "5fd300d0335f42290493": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "9d89df4d41d73cd2a64e": "Entréname.",
        "d19267a7ac8e9a7ac0ae": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades."
      },
      "name": "Clyde Kellen",
      "subName": "Pescador",
