    "enUS": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "I can teach you fishing skills.",
        "5fd300d0335f42290493": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "9d89df4d41d73cd2a64e": "Train me.",
        "d19267a7ac8e9a7ac0ae": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently."
      },
      "name": "Clyde Kellen",
      "subName": "Fisherman",
