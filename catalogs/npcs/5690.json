    "itIT": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Posso insegnarti l'arte della pesca.",
        "5fd300d0335f42290493": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità.",
        "9d89df4d41d73cd2a64e": "Addestrami.",
        "d19267a7ac8e9a7ac0ae": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh."
      },
      "name": "Clyde Kellen",
