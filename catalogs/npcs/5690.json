    "trTR": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Sana balık tutmayı öğretebilirim.",
        "5fd300d0335f42290493": "Becerin benimkini aşıyor, ama Booty Baydeki İhtiyar Hemingin \"Levrek ve Sen\" kitabının kopyalarına sahip olduğunu duydum. Bu kesinlikle becerini geliştirmene yardımcı olacaktır.",
        "9d89df4d41d73cd2a64e": "Beni eğit.",
        "d19267a7ac8e9a7ac0ae": "Şimdikinden daha iyi olmak için Dustwallow Marshta Nat Pagleı bulmalısın."
      },
      "name": "Clyde Kellen",
