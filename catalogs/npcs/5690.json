    "daDK": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Jeg kan lære dig at fiske.",
        "5fd300d0335f42290493": "Du er dygtigere end mig, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den vil helt sikkert hjælpe dig med at blive bedre.",
        "9d89df4d41d73cd2a64e": "Træn mig.",
        "d19267a7ac8e9a7ac0ae": "Du skal finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu."
      },
      "name": "Clyde Kellen",
      "translationMetadata": {
        "fields": {
          "dialogue.4e23e989b29d7f26fc28": {
