  "locales": {
    "csCZ": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Mohu tě naučit rybařit.",
        "5fd300d0335f42290493": "Tvá dovednost převyšuje mou, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit.",
        "9d89df4d41d73cd2a64e": "Vycvičte mě.",
        "d19267a7ac8e9a7ac0ae": "Pokud se chceš zlepšit nad svou současnou úroveň, musíš najít Nata Pagla v Dustwallow Marsh."
      },
      "name": "Clyde Kellen",
      "translationMetadata": {
