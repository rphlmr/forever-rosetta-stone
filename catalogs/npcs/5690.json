    "plPL": {
      "dialogue": {
        "4e23e989b29d7f26fc28": "Mogę nauczyć cię wędkować.",
        "5fd300d0335f42290493": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci ona doskonalić umiejętności.",
        "9d89df4d41d73cd2a64e": "Wyszkol mnie.",
        "d19267a7ac8e9a7ac0ae": "Jeśli chcesz wznieść się na wyższy poziom, musisz odnaleźć Nata Pagle’a w Dustwallow Marsh."
      },
      "name": "Clyde Kellen",
      "translationMetadata": {
