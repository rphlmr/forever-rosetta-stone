    },
    "daDK": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Du er ingen troldmand, og jeg har ikke tid til dig. Forsvind!",
        "2626038edeb9f6abf1ad": "Vil du gøre dine dæmoner stærkere? Det koster dig noget, men du er kommet til det rette sted.",
        "88c2d2b80b24eef70ad7": "Vis mig dit udvalg af grimoirer."
      },
      "name": "Jubahl Corpseseeker",
      "translationMetadata": {
        "fields": {
