    "plPL": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Nie jesteś czarnoksiężnikiem i nie mam dla ciebie czasu. Precz!",
        "2626038edeb9f6abf1ad": "Chcesz wzmocnić swoje demony? Będzie cię to kosztować, ale trafiasz we właściwe miejsce.",
        "88c2d2b80b24eef70ad7": "Pokaż mi swoją ofertę grymuarów."
      },
      "name": "Jubahl Corpseseeker",
