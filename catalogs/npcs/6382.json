    "enUS": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "You're no warlock and I've no time for you.  Begone!",
        "2626038edeb9f6abf1ad": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place.",
        "88c2d2b80b24eef70ad7": "Show me your selection of grimoires."
      },
      "name": "Jubahl Corpseseeker",
      "subName": "Demon Trainer",
