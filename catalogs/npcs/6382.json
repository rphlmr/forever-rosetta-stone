    "ptBR": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Você não é bruxo e eu não tenho tempo para você. Suma!",
        "2626038edeb9f6abf1ad": "Quer tornar seus demônios mais poderosos? Isso não vai sair de graça, mas você veio ao lugar certo.",
        "88c2d2b80b24eef70ad7": "Mostre-me sua seleção de grimórios."
      },
