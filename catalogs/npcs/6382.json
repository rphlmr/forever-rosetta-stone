    "ltLT": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Tu ne demonologas, ir aš neturiu tau laiko.  Nešdinkis!",
        "2626038edeb9f6abf1ad": "Nori sustiprinti savo demonus?  Tai kainuos, bet pataikei ten, kur reikia.",
        "88c2d2b80b24eef70ad7": "Parodyk man savo grimuarus."
      },
      "name": "Jubahl Corpseseeker",
      "subName": "Demonų dresuotojas",
