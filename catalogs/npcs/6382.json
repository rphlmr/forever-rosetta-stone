    "hrHR": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Nisi vještac i nemam vremena za tebe. Odlazi!",
        "2626038edeb9f6abf1ad": "Želiš ojačati svoje demone? To će te koštati, ali na pravom si mjestu.",
        "88c2d2b80b24eef70ad7": "Pokažite mi svoj izbor grimoara."
      },
      "name": "Jubahl Corpseseeker",
