    "itIT": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Non sei uno stregone e non ho tempo per te. Vattene!",
        "2626038edeb9f6abf1ad": "Vuoi rendere più potenti i tuoi demoni? Ti costerà, ma sei nel posto giusto.",
        "88c2d2b80b24eef70ad7": "Mostrami la tua selezione di grimori."
      },
      "name": "Jubahl Corpseseeker",
