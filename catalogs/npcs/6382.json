  "locales": {
    "csCZ": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "2626038edeb9f6abf1ad": "Chceš posílit své démony? Bude tě to něco stát, ale jsi na správném místě.",
        "88c2d2b80b24eef70ad7": "Ukažte mi svou nabídku grimoárů."
      },
      "name": "Jubahl Corpseseeker",
      "translationMetadata": {
        "fields": {
          "dialogue.1d93b1fc415eb6be20a2": {
