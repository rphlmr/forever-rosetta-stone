    "deDE": {
      "dialogue": {
        "1d93b1fc415eb6be20a2": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "2626038edeb9f6abf1ad": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "88c2d2b80b24eef70ad7": "Zeigt mir Eure Auswahl an Grimoires."
      },
      "name": "Jubaal Corpseseeker",
      "subName": "Dämonenausbilder",
