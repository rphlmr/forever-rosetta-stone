    "enUS": {
      "dialogue": {
        "37f77ecb68995ad4c636": "Of course there's no danger in everything catching flames and exploding like a huge helium bomb. This baby will get you to Undercity faster and safer than any boat, and the view is truly breathtaking. Speaking of breath, smoking is not allowed while on board the zeppelin, and fire spells are banned from being cast during the trip."
      },
      "name": "Frezza",
      "subName": "Zeppelin Master",
      "translationMetadata": {
        "fields": {
          "dialogue.37f77ecb68995ad4c636": {
            "origin": "community",
