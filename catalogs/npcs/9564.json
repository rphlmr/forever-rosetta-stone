  "locales": {
    "csCZ": {
      "dialogue": {
        "37f77ecb68995ad4c636": "Samozřejmě nehrozí, že by všechno vzplálo a vybuchlo jako obrovská heliová bomba. Tahle kráska tě dopraví do Undercity rychleji a bezpečněji než jakákoli loď a výhled ti opravdu vyrazí dech. Když už mluvíme o dechu, na palubě zeppelinu je zakázáno kouřit a během letu sesílat ohnivá kouzla."
      },
      "name": "Frezza",
      "translationMetadata": {
        "fields": {
          "dialogue.37f77ecb68995ad4c636": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "37f77ecb68995ad4c636": "Der er selvfølgelig ingen fare for, at det hele bryder i brand og eksploderer som en kæmpemæssig heliumbombe. Denne skønhed bringer dig til Undercity hurtigere og sikrere end nogen båd, og udsigten er virkelig betagende. Apropos åndedræt er rygning forbudt om bord på zeppelineren, og ildbesværgelser må ikke kastes under turen."
      },
      "name": "Frezza",
      "translationMetadata": {
        "fields": {
          "dialogue.37f77ecb68995ad4c636": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "37f77ecb68995ad4c636": "Natürlich besteht keine Gefahr, dass alles Feuer fängt und explodiert wie eine riesige Heliumbombe. Dieses Schmuckstück reist schneller und sicherer als jedes Boot nach Undercity und die Aussicht ist wahrhaft atemberaubend. Und da wir gerade vom Atmen sprechen: Rauchen ist an Bord des Zeppelins nicht gestattet, und während der Reise dürfen auch keine Feuerzauber gewirkt werden."
      },
      "name": "Frezza",
      "subName": "Zeppelinmeister",
      "translationMetadata": {
        "fields": {
          "dialogue.37f77ecb68995ad4c636": {
