  "locales": {
    "csCZ": {
      "dialogue": {
        "48154d50a338f3772057": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl vyučit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto i dražší. Přeješ si zapomenout naučené talenty?",
        "a125940446b56df25756": "Zdravím. Hledáš výcvik ve válečném umění?",
        "a82900f27938c33cc26b": "Potřebuji výcvik válečníka.",
        "c8d9fbacafbf67f3fd8c": "Nevidím v tobě ducha válečníka, dítě. Nemám nic, co by mohlo pomoci někomu jako ty, $c."
      },
      "name": "Darnath Bladesinger",
      "translationMetadata": {
        "fields": {
          "dialogue.48154d50a338f3772057": {
