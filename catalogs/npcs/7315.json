    "plPL": {
      "dialogue": {
        "48154d50a338f3772057": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by uczyć ich na nowo. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz zapomnieć wyuczone talenty?",
        "a125940446b56df25756": "Witaj. Szukasz nauki sztuki wojennej?",
        "a82900f27938c33cc26b": "Potrzebuję szkolenia wojownika.",
        "c8d9fbacafbf67f3fd8c": "Nie widzę w tobie ducha wojownika, dziecko. Nie mam nauk przydatnych dla kogoś takiego jak ty, $c."
      },
      "name": "Darnath Bladesinger",
