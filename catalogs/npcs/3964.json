    "ltLT": {
      "dialogue": {
        "6a34186144f5d2259db0": "Išmokyk mane.",
        "8daf409842788df32d03": "Atsiprašau, $n, bet naujokų nemokau. Pasikalbėk su Milla Fairancora Darnassus Amatininkų terasoje. Ji padės tau pasivyti kitus.",
        "a6e2b2cf10a2534701df": "Nors man malonu, kad taip pasitiki mano gebėjimais, mokyti tavęs jau nebegaliu. Keliauk į Darnassus Amatininkų terasą ir pasikalbėk su nakties elfe Ainethil. Ji galės tau padėti.",
        "d58eb2bb80d7f4942d2c": "Mokymas nėra vienpusis darbas, $n. Mokydama tave ir pati sužinau daugiau, o mano supratimas gilėja.",
        "f37503cae2ac6ccb8db8": "Ishnu-dal-dieb, $n. Ar atėjai ieškoti žinių?"
      },
      "name": "Kylanna",
      "subName": "Alchemijos ekspertas",
      "translationMetadata": {
