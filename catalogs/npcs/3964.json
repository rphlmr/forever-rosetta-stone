    "plPL": {
      "dialogue": {
        "6a34186144f5d2259db0": "Wyszkol mnie.",
        "8daf409842788df32d03": "Wybacz, $n, ale nie uczę początkujących. Porozmawiaj z Millą Fairancorą na Craftsmen’s Terrace w Darnassus. Pomoże ci nadrobić stracony czas.",
        "a6e2b2cf10a2534701df": "Choć schlebia mi twoja wiara w moje umiejętności, nauczanie cię przekracza moje możliwości. Idź na Craftsmen’s Terrace w Darnassus i porozmawiaj z nocną elfką Ainethil. Ona ci pomoże.",
        "d58eb2bb80d7f4942d2c": "Nauczanie nie jest jednostronne, $n. Ucząc ciebie, sama dowiaduję się więcej i pogłębiam swoje zrozumienie.",
        "f37503cae2ac6ccb8db8": "Ishnu-dal-dieb, $n. Czy przybywasz tu w poszukiwaniu wiedzy?"
      },
      "name": "Kylanna",
      "translationMetadata": {
