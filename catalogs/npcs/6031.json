    "plPL": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Niektórzy nie znoszą żaru Wielkiej Kuźni, ale moim zdaniem jest w sam raz. To najlepsze miejsce do porządnej kowalskiej roboty.",
        "914466ea8e5d1792f2dc": "Chcę przejrzeć twoje towary.",
        "e4ff313c6ffd2c58e860": "Wyszkol mnie."
      },
      "name": "Tormus Deepforge",
