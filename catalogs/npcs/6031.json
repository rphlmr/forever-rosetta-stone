    "trTR": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Bazıları Büyük Demirhane’nin sıcağına dayanamaz ama bence sıcaklık tam kararında. Ayrıca ciddi demircilik işleri için en iyi yer burası.",
        "914466ea8e5d1792f2dc": "Mallarına bakmak istiyorum.",
        "e4ff313c6ffd2c58e860": "Beni eğit."
      },
      "name": "Tormus Deepforge",
