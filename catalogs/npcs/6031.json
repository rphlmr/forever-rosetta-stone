    "enUS": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Some can't stand the heat of the Great Forge, but I think the heat is just right.  And it's the best place to do some serious smithwork.",
        "914466ea8e5d1792f2dc": "I want to browse your goods.",
        "e4ff313c6ffd2c58e860": "Train me."
      },
      "name": "Tormus Deepforge",
