    "hrHR": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Neki ne mogu podnijeti vrućinu Velike kovačnice, ali meni je baš kako treba. A to je najbolje mjesto za ozbiljan kovački posao.",
        "914466ea8e5d1792f2dc": "Želim pogledati vašu robu.",
        "e4ff313c6ffd2c58e860": "Podučite me."
