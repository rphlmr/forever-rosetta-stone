    "esES": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Algunos no soportan el calor de la Gran Fragua, pero yo creo que es el adecuado.  Y es el mejor lugar para trabajar en serio.",
        "914466ea8e5d1792f2dc": "Quiero ver tus mercancías.",
