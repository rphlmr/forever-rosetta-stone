    "ptBR": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Alguns não suportam o calor da Grande Forja, mas para mim ele é perfeito. E este é o melhor lugar para um trabalho sério de ferraria.",
        "914466ea8e5d1792f2dc": "Quero ver suas mercadorias.",
        "e4ff313c6ffd2c58e860": "Treine-me."
      },
      "name": "Tormus Baixaforja",
