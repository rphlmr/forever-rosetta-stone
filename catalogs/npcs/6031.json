    "svSE": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "En del står inte ut med hettan i den stora smedjan, men jag tycker att den är precis lagom. Och det är den bästa platsen för riktigt smidesarbete.",
        "914466ea8e5d1792f2dc": "Jag vill se dina varor.",
        "e4ff313c6ffd2c58e860": "Träna mig."
      },
      "name": "Tormus Deepforge",
