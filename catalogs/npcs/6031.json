    "itIT": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "C'è chi non sopporta il caldo della Grande Forgia, ma per me è il caldo giusto. Ed è il posto migliore per fare un lavoro da fabbro come si deve.",
        "914466ea8e5d1792f2dc": "Vorrei vedere la tua merce.",
        "e4ff313c6ffd2c58e860": "Addestrami."
      },
      "name": "Tormus Deepforge",
