  "locales": {
    "csCZ": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Někteří nesnesou žár Velké kovárny, ale mně připadá tak akorát. A je to nejlepší místo pro pořádnou kovářskou práci.",
        "914466ea8e5d1792f2dc": "Rád bych si prohlédl vaše zboží.",
        "e4ff313c6ffd2c58e860": "Vycvičte mě."
      },
      "name": "Tormus Deepforge",
      "translationMetadata": {
        "fields": {
