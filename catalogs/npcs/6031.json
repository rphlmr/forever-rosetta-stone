    },
    "daDK": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Nogle kan ikke holde varmen i Den Store Smedje ud, men jeg synes, den er lige tilpas. Og det er det bedste sted til seriøst smedearbejde.",
        "914466ea8e5d1792f2dc": "Jeg vil gerne se dine varer.",
        "e4ff313c6ffd2c58e860": "Træn mig."
      },
      "name": "Tormus Deepforge",
      "translationMetadata": {
        "fields": {
