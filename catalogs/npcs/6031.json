    "ltLT": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Kai kurie negali pakęsti Didžiosios kalvės kaitros, bet man ji kaip tik.  O ir vietos rimtam kalvio darbui geresnės nerasi.",
        "914466ea8e5d1792f2dc": "Noriu apžiūrėti tavo prekes.",
        "e4ff313c6ffd2c58e860": "Išmokyk mane."
