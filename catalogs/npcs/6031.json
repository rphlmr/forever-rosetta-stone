    "frFR": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Certains ne supportent pas la chaleur de la Grande Forge, mais je pense qu'elle est juste ce qu'il faut.  Et c'est le meilleur endroit pour travailler sérieusement la forge.",
        "914466ea8e5d1792f2dc": "Je voudrais regarder vos articles.",
        "e4ff313c6ffd2c58e860": "Entraînez-moi."
      },
      "name": "Tormus Deepforge",
