    "deDE": {
      "dialogue": {
        "681d02c258e3a01aa1c5": "Manche können die Hitze in der Großen Schmiede nicht ertragen, aber ich finde die Hitze genau richtig.  Und es ist der beste Ort, um ernsthafte Schmiedearbeiten zu verrichten.",
        "914466ea8e5d1792f2dc": "Ich möchte Eure Waren ansehen.",
        "e4ff313c6ffd2c58e860": "Bildet mich aus."
      },
      "name": "Tormus Deepforge",
      "translationMetadata": {
