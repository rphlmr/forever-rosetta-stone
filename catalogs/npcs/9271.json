    "plPL": {
      "dialogue": {
        "9ab5c74d8e89a7c45300": "Och, witaj! Jestem Hol’anyee, główna naukowczyni i biolożka ekspedycji Marshalów. Wraz z bratem i towarzyszami podróżuję po Azeroth, badając jego dzikie, nieokiełznane piękno. To ekscytujące... ale, hm... chyba tym razem emocji jest trochę za dużo!"
      },
      "name": "Hol'anyee Marshal",
      "translationMetadata": {
