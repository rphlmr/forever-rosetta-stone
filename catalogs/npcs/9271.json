    },
    "deDE": {
      "dialogue": {
        "9ab5c74d8e89a7c45300": "Oh, hallo! Ich bin Hol'anyee, Chefwissenschaftler und Biologe bei 'Marshals Expeditionen'. Mein Bruder und ich reisen mit unseren Gefährten durch Azeroth und erforschen seine majestätische, ungezähmte Wildnis. Es ist aufregend... aber, ähm... Ich glaube, diesmal ist es ein bisschen zu aufregend für uns!"
      },
      "name": "Hol'anyee Marshal",
      "translationMetadata": {
