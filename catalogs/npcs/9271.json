    "hrHR": {
      "dialogue": {
        "9ab5c74d8e89a7c45300": "Oh, pozdrav! Ja sam Hol’anyee, glavna znanstvenica i biologinja ekspedicija Marshal. Moj brat i ja sa svojim suputnicima putujemo Azerothom i istražujemo njegovu divlju i neukroćenu veličanstvenost. Uzbudljivo je... ali, ovaj... mislim da smo ovaj put doživjeli malo previše uzbuđenja!"
      },
      "name": "Hol'anyee Marshal",
      "translationMetadata": {
