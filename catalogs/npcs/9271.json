    "enUS": {
      "dialogue": {
        "9ab5c74d8e89a7c45300": "Oh, hello there!  I'm Hol'anyee, the chief scientist and biologist of Marshal Expeditions.  My brother and I, along with our companions, travel Azeroth exploring the wild and untamed majesty.  It is exciting... but, um... I think we got ourselves into a little too much excitement this time!"
      },
      "name": "Hol'anyee Marshal",
      "translationMetadata": {
        "fields": {
          "dialogue.9ab5c74d8e89a7c45300": {
