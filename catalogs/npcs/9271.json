    },
    "daDK": {
      "dialogue": {
        "9ab5c74d8e89a7c45300": "Åh, halløj! Jeg er Hol’anyee, chefforsker og biolog for Marshal Expeditions. Min bror og jeg rejser sammen med vores ledsagere rundt i Azeroth og udforsker den vilde og utæmmede pragt. Det er spændende... men øh... jeg tror, vi har fået lidt for meget spænding denne gang!"
      },
      "name": "Hol'anyee Marshal",
      "translationMetadata": {
        "fields": {
