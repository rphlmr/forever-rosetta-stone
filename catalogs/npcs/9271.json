  "locales": {
    "csCZ": {
      "dialogue": {
        "9ab5c74d8e89a7c45300": "Ach, vítej! Jsem Hol’anyee, hlavní vědkyně a bioložka expedic Marshalových. Spolu s bratrem a našimi druhy cestujeme Azerothem a zkoumáme jeho divokou, nespoutanou nádheru. Je to vzrušující... ale, ehm... myslím, že tentokrát jsme si toho vzrušení dopřáli až příliš!"
      },
      "name": "Hol'anyee Marshal",
      "translationMetadata": {
        "fields": {
