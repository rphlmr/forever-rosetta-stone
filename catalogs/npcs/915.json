    "enUS": {
      "dialogue": {
        "94c8068671bede84191b": "Can you train me how to use rogue skills?",
        "b7e214aba8cefa77c507": "I don't think you want to learn anything I can teach. Might want to find a $c trainer to help you out.",
        "c70f01b43ae1feaba10d": "You look like the type I should watch my coin purse around. Something I can help you with?"
      },
      "name": "Jorik Kerridan",
      "subName": "Rogue Trainer",
