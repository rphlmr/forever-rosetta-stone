    "ltLT": {
      "dialogue": {
        "94c8068671bede84191b": "Ar gali išmokyti mane niekšo įgūdžių?",
        "b7e214aba8cefa77c507": "Nemanau, kad norėtum išmokti to, ko galiu tave išmokyti. Geriau susirask $c mokytoją, kuris tau padėtų.",
        "c70f01b43ae1feaba10d": "Atrodai kaip žmogus, šalia kurio turėčiau saugoti savo piniginę. Gal galiu kuo nors padėti?"
