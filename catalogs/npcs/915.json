    "daDK": {
      "dialogue": {
        "94c8068671bede84191b": "Kan du lære mig at bruge slynglens evner?",
        "b7e214aba8cefa77c507": "Jeg tror ikke, du vil lære noget af det, jeg kan undervise i. Du bør nok finde en træner for $c, der kan hjælpe dig.",
        "c70f01b43ae1feaba10d": "Du ligner typen, jeg bør holde øje med min pung omkring. Er der noget, jeg kan hjælpe dig med?"
      },
      "name": "Jorik Kerridan",
      "translationMetadata": {
