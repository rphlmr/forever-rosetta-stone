  "locales": {
    "csCZ": {
      "dialogue": {
        "94c8068671bede84191b": "Můžeš mě naučit používat schopnosti tuláka?",
        "b7e214aba8cefa77c507": "Nemyslím, že by ses chtěl naučit něco z toho, co učím. Raději si najdi učitele pro $c, který ti pomůže.",
        "c70f01b43ae1feaba10d": "Vypadáš jako někdo, před kým bych si měl hlídat měšec. Potřebuješ s něčím pomoct?"
      },
      "name": "Jorik Kerridan",
      "translationMetadata": {
