    "hrHR": {
      "dialogue": {
        "94c8068671bede84191b": "Možeš li me naučiti kako koristiti vještine odmetnika?",
        "b7e214aba8cefa77c507": "Ne vjerujem da želiš naučiti išta što ti mogu podučiti. Bolje potraži učitelja za $c koji ti može pomoći.",
        "c70f01b43ae1feaba10d": "Izgledaš kao netko pred kim bih trebao pripaziti na svoju kesu. Mogu li ti kako pomoći?"
