    "hrHR": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "Mogu te naučiti ribolovu.",
        "ae42911b3d9f6ded6dab": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako želiš dalje napredovati.",
        "e89ea53e146c1f06988a": "Podučite me.",
        "eff92560c883c17aa352": "Tvoja je vještina veća od moje, ali čula sam da stari Heming u Booty Bayu ima primjerke knjige „The Bass and You“. Ona će ti zasigurno pomoći da napreduješ."
      },
      "name": "Lui'Mala",
