    "enUS": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "I can teach you fishing skills.",
        "ae42911b3d9f6ded6dab": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "e89ea53e146c1f06988a": "Train me.",
        "eff92560c883c17aa352": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill."
      },
      "name": "Lui'Mala",
      "subName": "Fisherman",
