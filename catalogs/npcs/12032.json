    "esES": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "Puedo enseñarte a pescar.",
        "ae42911b3d9f6ded6dab": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "e89ea53e146c1f06988a": "Entréname.",
        "eff92560c883c17aa352": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad."
      },
      "name": "Lui'Mala",
      "subName": "Pescador",
