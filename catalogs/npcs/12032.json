  "locales": {
    "csCZ": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "Mohu tě naučit rybařit.",
        "ae42911b3d9f6ded6dab": "Pokud se chceš dále zlepšit, musíš najít Nata Pagleho v Dustwallow Marsh.",
        "e89ea53e146c1f06988a": "Vycvičte mě.",
        "eff92560c883c17aa352": "Tvá dovednost překonává mou, ale slyšela jsem, že starý Heming v Booty Bay má výtisky knihy „The Bass and You“. Ta ti jistě pomůže se zlepšit."
      },
      "name": "Lui'Mala",
      "translationMetadata": {
