    "daDK": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "Jeg kan lære dig at fiske.",
        "ae42911b3d9f6ded6dab": "Du må finde Nat Pagle i Dustwallow Marsh for at blive bedre, end du er nu.",
        "e89ea53e146c1f06988a": "Træn mig.",
        "eff92560c883c17aa352": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af “The Bass and You”. Den vil helt sikkert hjælpe dig med at blive bedre."
      },
      "name": "Lui'Mala",
      "translationMetadata": {
