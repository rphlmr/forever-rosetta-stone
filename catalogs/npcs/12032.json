    "itIT": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "Posso insegnarti l'arte della pesca.",
        "ae42911b3d9f6ded6dab": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "e89ea53e146c1f06988a": "Addestrami.",
        "eff92560c883c17aa352": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità."
      },
      "name": "Lui'Mala",
