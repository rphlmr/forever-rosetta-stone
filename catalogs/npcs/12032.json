    "deDE": {
      "dialogue": {
        "2c19dbd875c4fd09d496": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "ae42911b3d9f6ded6dab": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "e89ea53e146c1f06988a": "Bildet mich aus.",
        "eff92560c883c17aa352": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern."
      },
      "name": "Lui'Mala",
      "subName": "Anglerin",
