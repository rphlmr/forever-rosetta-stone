    "enUS": {
      "dialogue": {
        "2085e06920248d1a0d30": "Greetings, $c.  I pity your kind, for the secrets of true magic are beyond you...",
        "4cecdc5159e62f50d933": "Greetings, $c.  Are you here to learn of the hidden arts?",
        "70446c58c126a976006f": "I am interested in mage training.",
        "7a51141420f45b8836f6": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "f96a20954c8c8b83df23": "I am interested in mage training."
      },
      "name": "Un'Thuwa",
      "subName": "Mage Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.2085e06920248d1a0d30": {
            "origin": "community",
