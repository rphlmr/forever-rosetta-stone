    "plPL": {
      "dialogue": {
        "2085e06920248d1a0d30": "Witaj, $c. Współczuję twojemu rodzajowi, gdyż sekrety prawdziwej magii są poza waszym zasięgiem...",
        "4cecdc5159e62f50d933": "Witaj, $c. Czy przybywasz, by poznać tajemne sztuki?",
        "70446c58c126a976006f": "Interesuje mnie szkolenie maga.",
        "7a51141420f45b8836f6": "Dzięki surowemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, abym mógł nauczyć ich na nowo. Usługa ta staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym pozwolił ci zapomnieć poznane talenty?",
        "f96a20954c8c8b83df23": "Interesuje mnie szkolenie maga."
      },
      "name": "Un'Thuwa",
      "translationMetadata": {
