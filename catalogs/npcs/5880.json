    "trTR": {
      "dialogue": {
        "2085e06920248d1a0d30": "Selam, $c. Türüne acıyorum, çünkü gerçek büyünün sırları sizin erişiminizin ötesinde...",
        "4cecdc5159e62f50d933": "Selam, $c. Gizli sanatları öğrenmeye mi geldin?",
        "70446c58c126a976006f": "Büyücü eğitimi almak istiyorum.",
        "7a51141420f45b8836f6": "Sıkı bir yeniden eğitimle, birçok öğrencime yeniden öğretebilmek için daha önce öğrendikleri her şeyi unutturmak zorunda kaldım. Bu hizmeti yerine getirmek her seferinde daha zorlaşıyor. Bu nedenle her yeniden eğitimde bedeli artıyor. Öğrendiğin yetenekleri sana unutturmamı ister misin?",
        "f96a20954c8c8b83df23": "Büyücü eğitimi almak istiyorum."
      },
      "name": "Un'Thuwa",
      "translationMetadata": {
