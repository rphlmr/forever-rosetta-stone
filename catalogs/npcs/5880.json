  "locales": {
    "csCZ": {
      "dialogue": {
        "2085e06920248d1a0d30": "Zdravím, $c. Lituji tvého druhu, neboť tajemství pravé magie jsou vám nedostupná...",
        "4cecdc5159e62f50d933": "Zdravím, $c. Přišel ses naučit skrytým uměním?",
        "70446c58c126a976006f": "Mám zájem o výcvik mága.",
        "7a51141420f45b8836f6": "Přísným přeškolením jsem musel mnohé studenty odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je pokaždé obtížnější. Proto je každé další přeškolení dražší. Chceš, abych tě odnaučil tvým talentům?",
        "f96a20954c8c8b83df23": "Mám zájem o výcvik mága."
      },
      "name": "Un'Thuwa",
      "translationMetadata": {
        "fields": {
          "dialogue.2085e06920248d1a0d30": {
