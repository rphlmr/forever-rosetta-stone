    "hrHR": {
      "dialogue": {
        "2085e06920248d1a0d30": "Pozdrav, $c. Žalim tvoju vrstu, jer tajne prave magije izvan su vašeg dosega...",
        "4cecdc5159e62f50d933": "Pozdrav, $c. Jesi li došao učiti skrivene vještine?",
        "70446c58c126a976006f": "Zanima me obuka za maga.",
        "7a51141420f45b8836f6": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prethodno naučili kako bih ih mogao poučiti iznova. Ovu je uslugu svaki put sve teže pružiti. Zato je svako sljedeće preobučavanje skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "f96a20954c8c8b83df23": "Zanima me obuka za maga."
      },
      "name": "Un'Thuwa",
      "translationMetadata": {
