    "daDK": {
      "dialogue": {
        "09aa31073c9eb70b6efe": "Hvis mine beregninger er korrekte, er hjulet snart forældet!",
        "535aa158709d81c04961": "De ting, jeg kunne lære dig, ville gøre din hjerne til gele! Kom tilbage, når du har lært nok!",
        "98bf7f27ea63860ca7eb": "Fremragende, du har bevist dit værd! Nu til næste fase af din undervisning...",
        "d29b9e5d2e39c8df50b0": "Du er bestemt nået langt i din uddannelse. Der er kun én instruktør, der kan lære dig mere. Find Buzzek Bracketswing i Gadgetzan!",
        "d88ae02b33f90f9245ae": "Træn mig."
      },
      "name": "Springspindle Fizzlegear",
      "translationMetadata": {
        "fields": {
