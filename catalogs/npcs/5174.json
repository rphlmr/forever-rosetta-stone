    "hrHR": {
      "dialogue": {
        "09aa31073c9eb70b6efe": "Ako su moji izračuni točni, kotač će uskoro biti zastario!",
        "535aa158709d81c04961": "Ono čemu bih te mogao naučiti pretvorilo bi ti mozak u žele! Vrati se kad dovoljno naučiš!",
        "98bf7f27ea63860ca7eb": "Izvrsno, dokazao si da si dostojan! A sada sljedeća faza tvoje obuke...",
        "d29b9e5d2e39c8df50b0": "Doista si daleko dogurao u obuci. Samo te jedan instruktor može dalje podučavati. Pronađi Buzzeka Bracketswinga u Gadgetzanu!",
        "d88ae02b33f90f9245ae": "Podučite me."
      },
      "name": "Springspindle Fizzlegear",
