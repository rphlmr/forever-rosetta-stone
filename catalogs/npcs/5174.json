    "enUS": {
      "dialogue": {
        "09aa31073c9eb70b6efe": "If my calculations are correct, the wheel will soon be obsolete!",
        "535aa158709d81c04961": "The things I would teach you would turn your brain to jelly! Come back when you've learned sufficiently!",
        "98bf7f27ea63860ca7eb": "Excellent, you have proven yourself worthy! Now for the next phase of your instruction...",
        "d29b9e5d2e39c8df50b0": "You have certainly come a long way in your training. There is only one instructor who can train you further. Find Buzzek Bracketswing in Gadgetzan!",
        "d88ae02b33f90f9245ae": "Train me."
      },
      "name": "Springspindle Fizzlegear",
      "subName": "Artisan Engineer",
