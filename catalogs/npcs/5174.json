    "ltLT": {
      "dialogue": {
        "09aa31073c9eb70b6efe": "Jei mano skaičiavimai teisingi, ratas greitai bus atgyvena!",
        "535aa158709d81c04961": "Tai, ko galėčiau tave išmokyti, paverstų tavo smegenis drebučiais! Sugrįžk, kai būsi pakankamai išmokęs!",
        "98bf7f27ea63860ca7eb": "Puiku, įrodei, kad esi vertas! Dabar pereikime prie kito tavo mokymo etapo...",
        "d29b9e5d2e39c8df50b0": "Mokydamasis tikrai toli pažengei. Yra tik vienas mokytojas, galintis tave mokyti toliau. Surask Buzzek Bracketswing Gadgetzane!",
        "d88ae02b33f90f9245ae": "Išmokyk mane."
      },
      "name": "Springspindle Fizzlegear",
      "subName": "Inžinerijos meistras",
