    "svSE": {
      "dialogue": {
        "09aa31073c9eb70b6efe": "Om mina beräkningar stämmer kommer hjulet snart att vara föråldrat!",
        "535aa158709d81c04961": "Det jag skulle lära dig skulle förvandla din hjärna till gelé! Kom tillbaka när du har lärt dig tillräckligt!",
        "98bf7f27ea63860ca7eb": "Utmärkt, du har visat dig värdig! Nu till nästa fas av din utbildning...",
        "d29b9e5d2e39c8df50b0": "Du har verkligen kommit långt i din utbildning. Det finns bara en instruktör som kan lära dig mer. Hitta Buzzek Bracketswing i Gadgetzan!",
        "d88ae02b33f90f9245ae": "Träna mig."
      },
      "name": "Springspindle Fizzlegear",
