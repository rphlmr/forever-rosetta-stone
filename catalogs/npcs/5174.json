  "locales": {
    "csCZ": {
      "dialogue": {
        "09aa31073c9eb70b6efe": "Pokud jsou mé výpočty správné, kolo bude brzy zastaralé!",
        "535aa158709d81c04961": "Věci, které bych tě naučil, by ti proměnily mozek v rosol! Vrať se, až budeš mít dost znalostí!",
        "98bf7f27ea63860ca7eb": "Výborně, prokázal jsi, že jsi toho hoden! A teď k další fázi tvého výcviku...",
        "d29b9e5d2e39c8df50b0": "Ve výcviku jsi už ušel pořádný kus cesty. Jen jediný instruktor tě může naučit víc. Najdi Buzzka Bracketswinga v Gadgetzanu!",
        "d88ae02b33f90f9245ae": "Vycvičte mě."
      },
      "name": "Springspindle Fizzlegear",
      "translationMetadata": {
