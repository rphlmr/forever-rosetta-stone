    "enUS": {
      "dialogue": {
        "9a05a1ed73cac32b88eb": "I cannot teach you anything you don't already know. However, the knowledge of my father far surpasses my own. Go inside and speak to him. Good luck!",
        "a1599194f4e12733f36d": "There are many secrets that may be unlocked with patience and determination. Now, let us begin...",
        "f0b525df45e67626da68": "What I wouldn't give to be out on the open plains on a day like this... but, my duty binds me.",
        "f19d98876292fe6a51f3": "Train me."
      },
      "name": "Mot Dawnstrider",
      "subName": "Journeyman Enchanter",
      "translationMetadata": {
        "fields": {
          "dialogue.9a05a1ed73cac32b88eb": {
