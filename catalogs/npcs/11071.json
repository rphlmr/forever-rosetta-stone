    "daDK": {
      "dialogue": {
        "9a05a1ed73cac32b88eb": "Jeg kan ikke lære dig noget, du ikke allerede ved. Men min fars viden overgår langt min egen. Gå ind og tal med ham. Held og lykke!",
        "a1599194f4e12733f36d": "Der er mange hemmeligheder, der kan afsløres med tålmodighed og beslutsomhed. Lad os nu begynde...",
        "f0b525df45e67626da68": "Hvad jeg ikke ville give for at være ude på de åbne sletter på en dag som denne... men min pligt holder mig her.",
        "f19d98876292fe6a51f3": "Træn mig."
      },
      "name": "Mot Dawnstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.9a05a1ed73cac32b88eb": {
