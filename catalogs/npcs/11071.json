  "locales": {
    "csCZ": {
      "dialogue": {
        "9a05a1ed73cac32b88eb": "Nemohu tě naučit nic, co už neznáš. Znalosti mého otce však daleko přesahují ty mé. Vejdi dovnitř a promluv si s ním. Hodně štěstí!",
        "a1599194f4e12733f36d": "Existuje mnoho tajemství, která lze odhalit trpělivostí a odhodláním. A teď začněme...",
        "f0b525df45e67626da68": "Co bych dal za to, být v takový den na širých pláních... ale povinnost mě drží zde.",
        "f19d98876292fe6a51f3": "Vycvičte mě."
      },
      "name": "Mot Dawnstrider",
      "translationMetadata": {
        "fields": {
          "dialogue.9a05a1ed73cac32b88eb": {
            "origin": "ai",
