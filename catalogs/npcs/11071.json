    "hrHR": {
      "dialogue": {
        "9a05a1ed73cac32b88eb": "Ne mogu te naučiti ničemu što već ne znaš. Međutim, znanje mog oca daleko nadmašuje moje. Uđi i razgovaraj s njim. Sretno!",
        "a1599194f4e12733f36d": "Mnoge se tajne mogu otkriti strpljenjem i odlučnošću. A sada, počnimo...",
        "f0b525df45e67626da68": "Što sve ne bih dao da sam na otvorenim ravnicama ovakvog dana... ali dužnost me veže ovdje.",
        "f19d98876292fe6a51f3": "Podučite me."
      },
      "name": "Mot Dawnstrider",
