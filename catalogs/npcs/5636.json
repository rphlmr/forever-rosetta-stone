    "csCZ": {
      "dialogue": {
        "5c577a8e3dfbdab008b6": "Vycvičte mě.",
        "ad82a83ee34f867c6341": "Co chceš? Mnohem radši bych teď byl ve vzduchu, než abych trčel na zemi a žvanil s někým jako $r.$b$bAsi nemůžeme všichni dostat, co chceme.",
        "af27e1e5410ef0ef58a0": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Mistr gryfů Talonaxe",
