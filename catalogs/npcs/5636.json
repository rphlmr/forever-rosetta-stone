    "enUS": {
      "dialogue": {
        "5c577a8e3dfbdab008b6": "Train me.",
        "ad82a83ee34f867c6341": "What do you want? I'd be a whole lot happier up in the skies than grounded and yapping with a $r right now.$b$bGuess we can't all get what we want.",
        "af27e1e5410ef0ef58a0": "I want to browse your goods."
      },
      "name": "Gryphon Master Talonaxe",
