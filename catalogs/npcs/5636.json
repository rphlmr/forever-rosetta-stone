    "daDK": {
      "dialogue": {
        "5c577a8e3dfbdab008b6": "Træn mig.",
        "ad82a83ee34f867c6341": "Hvad vil du? Jeg ville langt hellere være oppe i luften end stå på jorden og sludre med en $r lige nu.$b$bVi kan vel ikke alle få, hvad vi vil have.",
        "af27e1e5410ef0ef58a0": "Jeg vil gerne se dine varer."
      },
      "name": "Gryffemester Talonaxe",
      "translationMetadata": {
