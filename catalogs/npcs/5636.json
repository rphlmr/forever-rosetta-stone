    "esMX": {
      "dialogue": {
        "5c577a8e3dfbdab008b6": "Entréname.",
        "ad82a83ee34f867c6341": "¿Qué quieres? Preferiría estar en los cielos antes que aquí en tierra, parloteando con alguien de la raza $r.$b$bSupongo que no todos podemos conseguir lo que queremos.",
