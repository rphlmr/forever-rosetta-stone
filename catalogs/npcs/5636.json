    "hrHR": {
      "dialogue": {
        "5c577a8e3dfbdab008b6": "Podučite me.",
        "ad82a83ee34f867c6341": "Što želiš? Puno bih radije bio na nebu nego ovdje na zemlji čavrljao s nekim poput tebe, $r.$b$bValjda ne možemo svi dobiti što želimo.",
        "af27e1e5410ef0ef58a0": "Želim pogledati vašu robu."
      },
      "name": "Gospodar grifona Talonaxe",
