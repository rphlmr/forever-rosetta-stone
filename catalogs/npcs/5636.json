    "esES": {
      "dialogue": {
        "5c577a8e3dfbdab008b6": "Entréname.",
        "ad82a83ee34f867c6341": "¿Qué deseas? Sería mucho más feliz en los cielos que en tierra y gritando con una $r en este momento.\n\n Supongo que no todos podemos conseguir lo que queremos.",
        "af27e1e5410ef0ef58a0": "Quiero ver tus mercancías."
      },
      "name": "Maestro de grifos Garracha",
