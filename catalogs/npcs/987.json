    "plPL": {
      "dialogue": {
        "25516082ebf90721fb5d": "Co?",
        "6272e39dedf80f5d7a0d": "Szukam szkolenia w sztuce łowcy.",
        "ce62fdad6170272e4d40": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "e5901b34326f9ef13c94": "Nie marnuj mojego czasu."
      },
      "name": "Ogromm",
      "translationMetadata": {
