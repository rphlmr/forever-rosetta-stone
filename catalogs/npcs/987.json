  "locales": {
    "csCZ": {
      "dialogue": {
        "25516082ebf90721fb5d": "Co?",
        "6272e39dedf80f5d7a0d": "Hledám výcvik v umění lovce.",
        "ce62fdad6170272e4d40": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "e5901b34326f9ef13c94": "Neztrácej můj čas."
      },
      "name": "Ogromm",
      "translationMetadata": {
        "fields": {
