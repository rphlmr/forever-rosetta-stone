    "trTR": {
      "dialogue": {
        "25516082ebf90721fb5d": "Ne?",
        "6272e39dedf80f5d7a0d": "Avcılığın yollarını öğrenmek istiyorum.",
        "ce62fdad6170272e4d40": "Sıkı bir yeniden eğitimle pek çok öğrencime daha önce öğrendiklerini unutturup onları baştan eğittim. Bu hizmet her tekrarlandığında zorlaşır ve bu yüzden pahalılaşır. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?",
        "e5901b34326f9ef13c94": "Zamanımı boşa harcama."
      },
      "name": "Ogromm",
