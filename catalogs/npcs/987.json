    "ltLT": {
      "dialogue": {
        "25516082ebf90721fb5d": "Ko?",
        "6272e39dedf80f5d7a0d": "Noriu išmokti medžiotojo amato.",
        "ce62fdad6170272e4d40": "Per griežtą perauklėjimą man teko priversti ne vieną mokinį atsisakyti visko, ką jis anksčiau išmoko, kad galėčiau jį mokyti iš naujo. Kaskart suteikti šią paslaugą darosi vis sunkiau. Todėl ir jos kaina su kiekvienu permokymu kyla. Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "e5901b34326f9ef13c94": "Negaišk mano laiko."
      },
      "name": "Ogromm",
      "subName": "Medžiotojų mokytojas",
      "translationMetadata": {
        "fields": {
          "dialogue.25516082ebf90721fb5d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
