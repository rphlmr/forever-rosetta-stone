    "esES": {
      "dialogue": {
        "25516082ebf90721fb5d": "¿Qué?",
        "6272e39dedf80f5d7a0d": "Busco entrenamiento en las artes del cazador.",
        "ce62fdad6170272e4d40": "He tenido que realizar una rigurosa reconversión con muchos estudiantes de todo lo que habían aprendido, para poder enseñarles desde cero. El servicio que ofrezco aumenta de dificultad cada vez que se hace. Por esa razón, también aumenta el precio de cada nueva instrucción. ¿Quieres que elimine todos los talentos que has aprendido?",
        "e5901b34326f9ef13c94": "No me hagas perder el tiempo."
      },
      "name": "Ogromm",
      "subName": "Instructor de cazadores",
