    "ptBR": {
      "dialogue": {
        "25516082ebf90721fb5d": "O quê?",
        "6272e39dedf80f5d7a0d": "Procuro treinamento nos caminhos do caçador.",
        "ce62fdad6170272e4d40": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "e5901b34326f9ef13c94": "Não me faça perder tempo!"
      },
      "name": "Ogromm",
      "subName": "Treinamento de Caçadores",
