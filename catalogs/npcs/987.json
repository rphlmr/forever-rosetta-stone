    "hrHR": {
      "dialogue": {
        "25516082ebf90721fb5d": "Što?",
        "6272e39dedf80f5d7a0d": "Tražim obuku u lovačkim vještinama.",
        "ce62fdad6170272e4d40": "Strogom sam preobukom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Svaka sljedeća preobuka sve je teža, pa je zato i skuplja. Želiš li da te odviknem od talenata koje poznaješ?",
        "e5901b34326f9ef13c94": "Ne gubi moje vrijeme."
      },
      "name": "Ogromm",
