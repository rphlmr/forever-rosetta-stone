    "daDK": {
      "dialogue": {
        "25516082ebf90721fb5d": "Hvad?",
        "6272e39dedf80f5d7a0d": "Jeg søger træning i jægerens kunst.",
        "ce62fdad6170272e4d40": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "e5901b34326f9ef13c94": "Spild ikke min tid."
      },
      "name": "Ogromm",
      "translationMetadata": {
        "fields": {
          "dialogue.25516082ebf90721fb5d": {
            "origin": "ai",
