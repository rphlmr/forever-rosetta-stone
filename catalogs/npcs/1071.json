    "hrHR": {
      "dialogue": {
        "0bfdd4dfd4dae7092d64": "Želim pogledati vašu robu.",
        "518435fd1173008d687c": "Podučite me.",
        "ed6e25fdc706a2e8a8c0": "Ako me vrijeme ičemu naučilo, onda je to da nijedan zadatak nije dosadan. Zaštita mosta Thandol trebala je biti laka. Ali dok se glavnina vojske borila uz Savez, ovdje su nas nadjačali i Dun Modr je pao."
      },
      "name": "Longbraid Mračni",
      "translationMetadata": {
