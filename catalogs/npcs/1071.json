  "locales": {
    "csCZ": {
      "dialogue": {
        "0bfdd4dfd4dae7092d64": "Chci si prohlédnout vaše zboží.",
        "518435fd1173008d687c": "Vycvičte mě.",
        "ed6e25fdc706a2e8a8c0": "Jestli mě čas něco naučil, pak to, že žádný úkol není nudný. Ochrana Thandolského mostu měla být snadná. Jenže většina armády bojovala po boku Aliance, a tak nás zde přemohli a Dun Modr padl."
      },
      "name": "Longbraid Ponurý",
      "translationMetadata": {
        "fields": {
          "dialogue.0bfdd4dfd4dae7092d64": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
