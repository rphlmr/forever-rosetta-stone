    "ltLT": {
      "dialogue": {
        "0bfdd4dfd4dae7092d64": "Noriu apžiūrėti tavo prekes.",
        "518435fd1173008d687c": "Apmokyk mane.",
        "ed6e25fdc706a2e8a8c0": "Jei laikas mane ko nors išmokė, tai kad nebūna nuobodžių užduočių. Saugoti Thandol tiltą turėjo būti lengva. Tačiau didžiajai kariuomenės daliai kovojant Aljanso gretose, čia mus užgriuvo priešų gausa ir Dun Modr krito."
      },
      "name": "Longbraid Rūstusis",
