      }
    },
    "daDK": {
      "dialogue": {
        "0bfdd4dfd4dae7092d64": "Jeg vil gerne se dine varer.",
        "518435fd1173008d687c": "Træn mig.",
        "ed6e25fdc706a2e8a8c0": "Hvis tiden har lært mig én ting, er det, at ingen opgave er kedelig. Det burde have været let at beskytte Thandol-broen. Men da størstedelen af hæren kæmpede sammen med Alliancen, blev vi overmandet her, og Dun Modr faldt."
      },
      "name": "Longbraid den Barske",
      "translationMetadata": {
        "fields": {
          "dialogue.0bfdd4dfd4dae7092d64": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.518435fd1173008d687c": {
            "origin": "ai",
