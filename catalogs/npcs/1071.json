    "enUS": {
      "dialogue": {
        "0bfdd4dfd4dae7092d64": "I want to browse your goods.",
        "518435fd1173008d687c": "Train me.",
        "ed6e25fdc706a2e8a8c0": "If there's one thing time has taught me it's that no assignment is a dull one.  Protecting the Thandol Span should have been an easy task.  But with the brunt of the army fighting alongside the alliance, we were overwhelmed here and Dun Modr has fallen."
      },
      "name": "Longbraid the Grim",
      "translationMetadata": {
        "fields": {
          "dialogue.0bfdd4dfd4dae7092d64": {
            "origin": "community",
