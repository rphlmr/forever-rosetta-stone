    "plPL": {
      "dialogue": {
        "15e26beb8ca21aba8a8b": "Witaj, magu. Czy mam pomóc ci lepiej poznać świat magii?",
        "a63874172a4d1b8d400a": "Witaj, $c. Oto moja rada: podróżując po świecie, strzeż się magii, bo może ona spalić niewyszkolonych.",
        "a8f2bbde37f6d8db5255": "Interesuje mnie szkolenie maga.",
        "cbf775dcda35c44fd3fb": "Interesuje mnie szkolenie maga.",
        "edb21a5b543eb6cd6e17": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego się wcześniej nauczyli, abym mógł uczyć ich od nowa. Usługa, którą oferuję, staje się coraz trudniejsza za każdym razem, gdy ją wykonuję. Dlatego też każde kolejne przeszkolenie jest droższe. Czy chcesz, abym oduczył cię poznanych talentów?"
      },
      "name": "Khelden Bremen",
      "translationMetadata": {
