    "enUS": {
      "dialogue": {
        "15e26beb8ca21aba8a8b": "Greetings mage.  Shall I provide you with further insight into the world of magic?",
        "a63874172a4d1b8d400a": "Well met, $c.  My advice to you is this: As you travel the world, be wary of magic for it will burn the untrained.",
        "a8f2bbde37f6d8db5255": "I am interested in mage training.",
        "cbf775dcda35c44fd3fb": "I am interested in mage training.",
        "edb21a5b543eb6cd6e17": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Khelden Bremen",
      "subName": "Mage Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.15e26beb8ca21aba8a8b": {
