  "locales": {
    "csCZ": {
      "dialogue": {
        "15e26beb8ca21aba8a8b": "Zdravím tě, mágu. Mám ti pomoci hlouběji proniknout do světa magie?",
        "a63874172a4d1b8d400a": "Vítej, $c. Poradím ti toto: až budeš cestovat světem, měj se před magií na pozoru, neboť nevycvičené spálí.",
        "a8f2bbde37f6d8db5255": "Mám zájem o výcvik mága.",
        "cbf775dcda35c44fd3fb": "Mám zájem o výcvik mága.",
        "edb21a5b543eb6cd6e17": "Důkladným přeškolením jsem musel mnohé studenty odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?"
      },
      "name": "Khelden Bremen",
      "translationMetadata": {
        "fields": {
          "dialogue.15e26beb8ca21aba8a8b": {
