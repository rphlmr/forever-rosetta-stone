    "csCZ": {
      "dialogue": {
        "c60367f99040124cf447": "Všichni jsme byli svědky strašlivých tragédií, ale nesmíme dopustit, aby nás uvrhly do zoufalství.$B$BUchovávejme si ty vzpomínky, abychom jednou mohli zjednat nápravu."
      },
      "name": "Carlin Redpath",
