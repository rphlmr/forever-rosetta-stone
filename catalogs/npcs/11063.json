    "enUS": {
      "dialogue": {
        "c60367f99040124cf447": "We have all been witness to terrible tragedies, but we must not let them drag us to despair.$B$BInstead, hold those memories close so that one day, we might find a reckoning."
      },
      "name": "Carlin Redpath",
      "subName": "The Argent Dawn",
