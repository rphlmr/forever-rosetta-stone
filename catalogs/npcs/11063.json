    "daDK": {
      "dialogue": {
        "c60367f99040124cf447": "Vi har alle været vidner til frygtelige tragedier, men vi må ikke lade dem kaste os ud i fortvivlelse.$B$BHold i stedet fast i minderne, så vi en dag kan kræve oprejsning."
      },
      "name": "Carlin Redpath",
      "translationMetadata": {
