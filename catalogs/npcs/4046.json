    "frFR": {
      "dialogue": {
        "0a2584767cb7f89828d4": "Tu dois écouter, jeune $c.  Écoutez les chuchotements dans l'obscurité, car ils vous guident en ces temps troublés.",
        "816be75be87b9d3b3bce": "Je voudrais regarder vos articles.",
        "9b79fbdf0ca1fa51417a": "Entraînez-moi."
