    "deDE": {
      "dialogue": {
        "0a2584767cb7f89828d4": "Du musst zuhören, junger $c.  Höre auf das Flüstern in der Dunkelheit, denn es bietet dir Orientierung in diesen unruhigen Zeiten.",
        "816be75be87b9d3b3bce": "Ich möchte Eure Waren ansehen.",
        "9b79fbdf0ca1fa51417a": "Bildet mich aus."
      },
      "name": "Magatha Grimmtotem",
      "subName": "Ältestengreisin",
