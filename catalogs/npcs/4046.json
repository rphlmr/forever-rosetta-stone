  "locales": {
    "csCZ": {
      "dialogue": {
        "0a2584767cb7f89828d4": "Musíš naslouchat, mladý $c. Naslouchej šepotu v temnotě, neboť v těchto neklidných časech nabízí vedení.",
        "816be75be87b9d3b3bce": "Chci si prohlédnout vaše zboží.",
        "9b79fbdf0ca1fa51417a": "Vycvičte mě."
      },
      "name": "Magatha Grimtotem",
