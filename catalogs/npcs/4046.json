    "plPL": {
      "dialogue": {
        "0a2584767cb7f89828d4": "Musisz słuchać, młody $c. Wsłuchaj się w szepty w ciemności, gdyż wskazują drogę w tych niespokojnych czasach.",
        "816be75be87b9d3b3bce": "Chcę przejrzeć twoje towary.",
        "9b79fbdf0ca1fa51417a": "Wyszkol mnie."
