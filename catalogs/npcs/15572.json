    "hrHR": {
      "dialogue": {
        "068de15e1df215f3fdbf": "U davna vremena živjeli smo za lov. Lovili smo radi slave i časti...$B$BJe li danas toliko drukčije?",
        "62fca7f8213c426b1c26": "Starješina Moonwarden promatra Crossroads u Barrensu.",
        "88f29e4ff63107c66426": "Starješinu Darkhorna možeš pronaći među crvenim stijenama Orgrimmara.",
        "9f268f802530a216e5cf": "Starješina Windtotem druži se s goblinima Ratcheta na obali Barrensa.",
        "b181360ff9d709254486": "Starješina High Mountain nalazi se u Camp Tauraju u Barrensu."
      },
      "name": "Starješina Runetotem",
