    "enUS": {
      "dialogue": {
        "068de15e1df215f3fdbf": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "62fca7f8213c426b1c26": "Elder Moonwarden is observing the Crossroads in the Barrens.",
        "88f29e4ff63107c66426": "Elder Darkhorn can be found among the red rocks of Orgrimmar.",
        "9f268f802530a216e5cf": "Elder Windtotem is keeping company with the goblins of Ratchet on the coast of the Barrens.",
        "b181360ff9d709254486": "Elder High Mountain is at Camp Taurajo in the Barrens."
      },
      "name": "Elder Runetotem",
