    "frFR": {
      "dialogue": {
        "068de15e1df215f3fdbf": "Dans les temps anciens, nous vivions pour la chasse.  Nous chassions pour la gloire, pour l’honneur…\n\nEst-ce si différent maintenant ?",
        "62fca7f8213c426b1c26": "L'Ancien Moonwarden observe la Croisée des Tarides.",
        "88f29e4ff63107c66426": "L'Ancienne Darkhorn arpente les rochers rouges d'Orgrimmar.",
        "9f268f802530a216e5cf": "L'Ancienne Windtotem s'est installée chez les gobelins de Ratchet, sur la côte des Tarides.",
        "b181360ff9d709254486": "L'Ancien High Mountain se trouve au camp Taurajo, dans les Tarides."
      },
      "name": "Ancienne Runetotem",
