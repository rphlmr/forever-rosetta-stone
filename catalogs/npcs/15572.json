    "daDK": {
      "dialogue": {
        "068de15e1df215f3fdbf": "For længe siden levede vi for jagten. Vi jagede for hæder og ære...$B$BEr det så anderledes nu?",
        "62fca7f8213c426b1c26": "Ældste Moonwarden holder øje med Crossroads i Barrens.",
        "88f29e4ff63107c66426": "Ældste Darkhorn findes blandt Orgrimmars røde klipper.",
        "9f268f802530a216e5cf": "Ældste Windtotem holder goblinerne i Ratchet med selskab ved Barrens' kyst.",
        "b181360ff9d709254486": "Ældste High Mountain er ved Camp Taurajo i Barrens."
      },
      "name": "Ældste Runetotem",
