    "ltLT": {
      "dialogue": {
        "068de15e1df215f3fdbf": "Seniai seniai gyvenome dėl medžioklės. Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "62fca7f8213c426b1c26": "Vyresnysis Moonwarden stebi Crossroads gyvenvietę Barrens krašte.",
        "88f29e4ff63107c66426": "Vyresnįjį Darkhorn galima rasti tarp raudonųjų Orgrimmar uolų.",
        "9f268f802530a216e5cf": "Vyresnysis Windtotem leidžia laiką su Ratchet goblinais Barrens pakrantėje.",
        "b181360ff9d709254486": "Vyresnysis High Mountain yra Camp Taurajo stovykloje Barrens krašte."
      },
      "name": "Vyresnysis Runetotem",
