    "trTR": {
      "dialogue": {
        "068de15e1df215f3fdbf": "Çok eskiden av için yaşardık. Şan için, onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "62fca7f8213c426b1c26": "Yaşlı Moonwarden, Barrens'taki Crossroads'u gözetliyor.",
        "88f29e4ff63107c66426": "Yaşlı Darkhorn, Orgrimmar'ın kızıl kayalıkları arasında bulunabilir.",
        "9f268f802530a216e5cf": "Yaşlı Windtotem, Barrens kıyısındaki Ratchet goblinlerine eşlik ediyor.",
        "b181360ff9d709254486": "Yaşlı High Mountain, Barrens'taki Camp Taurajo'da."
