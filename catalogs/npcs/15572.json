    "itIT": {
      "dialogue": {
        "068de15e1df215f3fdbf": "In tempi ormai lontani, vivevamo per la caccia. Cacciavamo per la gloria, per l'onore...\n\nÈ poi così diverso, adesso?",
        "62fca7f8213c426b1c26": "L'Anziano Moonwarden sta tenendo d'occhio Crossroads, nelle Barrens.",
        "88f29e4ff63107c66426": "L'Anziana Darkhorn la trovi fra le rocce rosse di Orgrimmar.",
        "9f268f802530a216e5cf": "L'Anziana Windtotem se ne sta in compagnia dei goblin di Ratchet, sulla costa delle Barrens.",
        "b181360ff9d709254486": "L'Anziano High Mountain si trova a Camp Taurajo, nelle Barrens."
      },
      "name": "Anziano Runetotem",
