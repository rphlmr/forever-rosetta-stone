  "locales": {
    "csCZ": {
      "dialogue": {
        "068de15e1df215f3fdbf": "V dávných dobách jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to teď tak jiné?",
        "62fca7f8213c426b1c26": "Starší Moonwarden dohlíží na Crossroads v Barrens.",
        "88f29e4ff63107c66426": "Staršího Darkhorna najdeš mezi rudými skalami Orgrimmaru.",
        "9f268f802530a216e5cf": "Starší Windtotem pobývá mezi gobliny v Ratchetu na pobřeží Barrens.",
        "b181360ff9d709254486": "Starší High Mountain je v Camp Taurajo v Barrens."
      },
      "name": "Starší Runetotem",
