    "plPL": {
      "dialogue": {
        "068de15e1df215f3fdbf": "Dawno temu żyliśmy dla łowów. Polowaliśmy dla chwały i honoru...$B$BCzy teraz jest aż tak inaczej?",
        "62fca7f8213c426b1c26": "Starszy Moonwarden obserwuje Crossroads w Barrens.",
        "88f29e4ff63107c66426": "Starszego Darkhorna znajdziesz wśród czerwonych skał Orgrimmaru.",
        "9f268f802530a216e5cf": "Starszy Windtotem dotrzymuje towarzystwa goblinom w Ratchet na wybrzeżu Barrens.",
        "b181360ff9d709254486": "Starszy High Mountain przebywa w Camp Taurajo w Barrens."
      },
      "name": "Starszy Runetotem",
      "translationMetadata": {
