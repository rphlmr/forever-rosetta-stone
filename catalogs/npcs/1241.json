    "enUS": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Train me.",
        "2c158ec6a4a2e48003bd": "Here for training eh? Just began my training meself, but I would be glad ta teach ye what I can.",
        "585f377e73227f03de32": "Ye learn fast $g lad : lass;, much faster than I can keep up with. If ye want ta continue yer training, I suggest ye see my teacher. His name's Rotgath, Rotgath Stonebeard and ye'll find him in Ironforge at The Great Forge.",
        "75153126e22e5d6fb73f": "Ye learn fast $g lad : lass;, much faster than I can keep up with. If ye want ta continue yer training, I suggest ye see my teacher. His name's Rotgath, Rotgath Stonebeard and ye'll find him in Ironforge at The Great Forge.",
        "82e003095e15813100cd": "Good day to ye $g lad : lass;. Can I be of service?",
        "bda9c798a33723893e55": "Good day to ye $g lad : lass;. Can I be of service?"
      },
      "name": "Tognus Flintfire",
      "subName": "Journeyman Blacksmith",
