    "hrHR": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Podučite me.",
        "2c158ec6a4a2e48003bd": "Došao si na obuku, a? I sam sam tek počeo, ali rado ću te naučiti što mogu.",
        "585f377e73227f03de32": "Brzo učiš, $g momče : djevojko;, mnogo brže nego što mogu pratiti. Ako želiš nastaviti obuku, posjeti mog učitelja. Zove se Rotgath Stonebeard i naći ćeš ga u Velikoj kovačnici u Ironforgeu.",
        "75153126e22e5d6fb73f": "Brzo učiš, $g momče : djevojko;, mnogo brže nego što mogu pratiti. Ako želiš nastaviti obuku, posjeti mog učitelja. Zove se Rotgath Stonebeard i naći ćeš ga u Velikoj kovačnici u Ironforgeu.",
        "82e003095e15813100cd": "Dobar dan, $g momče : djevojko;. Mogu li pomoći?",
        "bda9c798a33723893e55": "Dobar dan, $g momče : djevojko;. Mogu li pomoći?"
      },
