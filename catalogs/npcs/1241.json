    "frFR": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Entraînez-moi.",
        "2c158ec6a4a2e48003bd": "Vous êtes là pour l'entraînement, hein ? Je commence ma formation moi-même, mais je veux bien vous enseigner ce que je sais.",
        "585f377e73227f03de32": "Vous apprenez vite, jeune homme, trop vite pour moi. Si vous voulez poursuivre votre formation, je vous suggère de rencontrer mon maître. Son nom est Rotgath, Rotgath Stonebeard, et vous le trouverez dans Ironforge, à la Grande Forge.",
        "75153126e22e5d6fb73f": "Vous apprenez vite, jeune fille, trop vite pour moi. Si vous voulez poursuivre votre formation, je vous suggère de rencontrer mon maître. Son nom est Rotgath, Rotgath Stonebeard, et vous le trouverez dans Ironforge, à la Grande Forge.",
        "82e003095e15813100cd": "Bien le bonjour jeune fille. En quoi puis-je vous être utile ?",
        "bda9c798a33723893e55": "Bien le bonjour jeune homme. En quoi puis-je vous être utile ?"
      },
      "name": "Tognus Flintfire",
      "subName": "Forgeron - Compagnon",
