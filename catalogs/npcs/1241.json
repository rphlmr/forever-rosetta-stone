    "ltLT": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Mokyk mane.",
        "2c158ec6a4a2e48003bd": "Atėjai mokytis, a? Pats tik neseniai pradėjau mokytis, bet mielai tave pamokysiu, kiek galiu.",
        "585f377e73227f03de32": "Greitai mokaisi, $g vaikinai : mergina;, daug greičiau, nei spėju mokyti. Jei nori tęsti mokslus, siūlau kreiptis į mano mokytoją. Jo vardas Rotgath, Rotgath Stonebeard, ir jį rasi Ironforge, Didžiojoje kalvėje.",
        "75153126e22e5d6fb73f": "Greitai mokaisi, $g vaikinai : mergina;, daug greičiau, nei spėju mokyti. Jei nori tęsti mokslus, siūlau kreiptis į mano mokytoją. Jo vardas Rotgath, Rotgath Stonebeard, ir jį rasi Ironforge, Didžiojoje kalvėje.",
        "82e003095e15813100cd": "Laba diena, $g vaikinai : mergina;. Ar galiu kuo padėti?",
        "bda9c798a33723893e55": "Laba diena, $g vaikinai : mergina;. Ar galiu kuo padėti?"
      },
      "name": "Tognus Flintfire",
      "subName": "Patyręs kalvis",
