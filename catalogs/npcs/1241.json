    "esES": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Entréname.",
        "2c158ec6a4a2e48003bd": "¿Estás aquí para instruirte, eh? Yo mismo acabo de empezar mi instrucción, pero me gustaría enseñarte lo que puedo hacer.",
        "585f377e73227f03de32": "Aprendes rápido muchacho, tan rápido que no puedo seguirte el paso. Si quieres seguir tu instrucción te sugiero visitar a mi maestro. Su nombre es Rotgath, Rotgath Barbapétrea, lo encontrarás en Forjaz, en La Gran Fundición.",
        "75153126e22e5d6fb73f": "Aprendes rápido muchacha, tan rápido que no puedo seguirte el paso. Si quieres seguir tu instrucción te sugiero visitar a mi maestro. Su nombre es Rotgath, Rotgath Barbapétrea, lo encontrarás en Forjaz, en La Gran Fundición.",
        "82e003095e15813100cd": "Buenos días muchacha. ¿Puedo ayudarte?",
        "bda9c798a33723893e55": "Buenos días muchacho. ¿Puedo ayudarte?"
      },
