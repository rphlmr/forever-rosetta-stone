  "locales": {
    "csCZ": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Vycvičte mě.",
        "2c158ec6a4a2e48003bd": "Jsi tu kvůli výcviku, co? Sám jsem teprve začal, ale rád tě naučím, co umím.",
        "585f377e73227f03de32": "Učíš se rychle, $g chlapče : děvče;, mnohem rychleji, než stačím držet krok. Chceš-li pokračovat ve výcviku, navštiv mého učitele. Jmenuje se Rotgath Stonebeard a najdeš ho ve Velké kovárně v Ironforge.",
        "75153126e22e5d6fb73f": "Učíš se rychle, $g chlapče : děvče;, mnohem rychleji, než stačím držet krok. Chceš-li pokračovat ve výcviku, navštiv mého učitele. Jmenuje se Rotgath Stonebeard a najdeš ho ve Velké kovárně v Ironforge.",
        "82e003095e15813100cd": "Dobrý den, $g chlapče : děvče;. Mohu ti posloužit?",
        "bda9c798a33723893e55": "Dobrý den, $g chlapče : děvče;. Mohu ti posloužit?"
      },
      "name": "Tognus Flintfire",
