    "plPL": {
      "dialogue": {
        "1dc02ce2d433b59d8150": "Wyszkol mnie.",
        "2c158ec6a4a2e48003bd": "Na szkolenie, co? Sam dopiero zacząłem naukę, ale chętnie nauczę cię tego, co potrafię.",
        "585f377e73227f03de32": "Uczysz się szybko, $g chłopcze : dziewczyno;, znacznie szybciej, niż mogę nadążyć. Jeśli chcesz kontynuować naukę, odwiedź mojego nauczyciela. Nazywa się Rotgath Stonebeard i znajdziesz go w Wielkiej Kuźni w Ironforge.",
        "75153126e22e5d6fb73f": "Uczysz się szybko, $g chłopcze : dziewczyno;, znacznie szybciej, niż mogę nadążyć. Jeśli chcesz kontynuować naukę, odwiedź mojego nauczyciela. Nazywa się Rotgath Stonebeard i znajdziesz go w Wielkiej Kuźni w Ironforge.",
        "82e003095e15813100cd": "Dzień dobry, $g chłopcze : dziewczyno;. Mogę w czymś pomóc?",
        "bda9c798a33723893e55": "Dzień dobry, $g chłopcze : dziewczyno;. Mogę w czymś pomóc?"
      },
