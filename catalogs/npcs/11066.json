    "itIT": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Addestrami.",
        "12f641535dc7df465bec": "Tu venuto in posto sbagliato. Parla con esperto Godan laggiù. Tu impari di più da lui.",
        "985bb2c56c2624d29d62": "Non sei pronto ad addestrarti con me, straniero. Passa un po' di tempo con il mio assistente Jhag laggiù.",
        "ad929f46c5746dc2c00d": "Morire in battaglia è glorioso! Ma con quello che io ti insegno, forse tu non muori così presto, mh?",
        "b358518aa715af8fcb46": "Throm-ka! Che cosa cerchi, straniero?"
      },
      "name": "Jhag",
