    "deDE": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Bildet mich aus.",
        "12f641535dc7df465bec": "Ihr seid hier falsch. Sprecht mit dem Experten Godan dort drüben. Von ihm werdet Ihr mehr erfahren.",
        "985bb2c56c2624d29d62": "Ihr seid nicht geeignet, um bei mir zu lernen, Fremdling. Wendet Euch an meinen Assistenten Jhag dort drüben.",
        "ad929f46c5746dc2c00d": "Es ist glorreich, im Kampf zu sterben! Aber mit dem, was ich Euch lehre, sterbt Ihr vielleicht nicht so schnell, hm?",
        "b358518aa715af8fcb46": "Throm-ka! Was sucht Ihr denn, Fremdling?"
      },
      "name": "Jhag",
      "subName": "Verzauberkunstgeselle",
      "translationMetadata": {
        "fields": {
