    "ltLT": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Pamokyk mane.",
        "12f641535dc7df465bec": "Ne ten atėjai. Kalbėk su žinovu Godan, tenai. Iš jo daugiau išmoksi.",
        "985bb2c56c2624d29d62": "Tu dar nepasirengęs pas mane mokytis, svetimšali. Praleisk šiek tiek laiko su mano padėjėju Jhag, tenai. ",
        "ad929f46c5746dc2c00d": "Mirti mūšyje garbinga! Bet jei mokysiu tave, gal ne taip greitai mirsi, hm?  ",
        "b358518aa715af8fcb46": "Throm-ka! Ko ieškai, svetimšali?"
      },
      "name": "Jhag",
      "subName": "Kerėtojas pameistrys",
