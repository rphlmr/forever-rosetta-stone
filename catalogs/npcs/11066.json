    "ptBR": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Treine-me.",
        "12f641535dc7df465bec": "Você veio lugar errado. Fala com especialista Godan. Você aprende mais com ele.",
        "985bb2c56c2624d29d62": "Você não está pronto para treinar comigo, estranho. Passe um tempo com meu assistente Jhag ali.",
        "ad929f46c5746dc2c00d": "Morrer em batalha é glorioso! Mas talvez você não morra tão rápido depois da minha lição, hum?",
        "b358518aa715af8fcb46": "Throm-ka! O que você procura, estranho?"
      },
      "name": "Jhag",
      "subName": "Encantador Profissional",
