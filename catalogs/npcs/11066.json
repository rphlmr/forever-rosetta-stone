    "plPL": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Wyszkol mnie.",
        "12f641535dc7df465bec": "Źle trafiłeś. Porozmawiaj z ekspertem Godanem tam. Od niego nauczysz się więcej.",
        "985bb2c56c2624d29d62": "Nie nadajesz się jeszcze do treningu ze mną, nieznajomy. Spędź trochę czasu z moim pomocnikiem Jhagiem, tam.",
        "ad929f46c5746dc2c00d": "Śmierć w walce to chwała! Ale dzięki temu, czego cię nauczę, może nie zginiesz tak szybko, co?",
        "b358518aa715af8fcb46": "Throm-ka! Czego szukasz, nieznajomy?"
      },
      "name": "Jhag",
      "translationMetadata": {
