    "trTR": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Beni eğit.",
        "12f641535dc7df465bec": "Yanlış yere geldin. Şuradaki uzman Godan'la konuş. Ondan daha çok şey öğrenirsin.",
        "985bb2c56c2624d29d62": "Benimle eğitim görmeye uygun değilsin, yabancı. Şuradaki yardımcım Jhag ile biraz vakit geçir.",
        "ad929f46c5746dc2c00d": "Savaşta ölmek şereflidir! Ama sana öğreteceklerimle belki o kadar çabuk ölmezsin, ha?",
        "b358518aa715af8fcb46": "Throm-ka! Ne arıyorsun, yabancı?"
      },
      "name": "Jhag",
      "translationMetadata": {
