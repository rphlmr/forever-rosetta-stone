    "svSE": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Träna mig.",
        "12f641535dc7df465bec": "Du har kommit fel. Tala med experten Godan där borta. Du lär dig mer av honom.",
        "985bb2c56c2624d29d62": "Du är inte redo att träna med mig, främling. Tillbringa lite tid med min assistent Jhag där borta.",
        "ad929f46c5746dc2c00d": "Att dö i strid är ärofullt! Men med det jag lär dig kanske du inte dör så snabbt, hm?",
        "b358518aa715af8fcb46": "Throm-ka! Vad söker du, främling?"
      },
      "name": "Jhag",
