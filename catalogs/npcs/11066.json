    "esES": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Entréname.",
        "12f641535dc7df465bec": "Has venido al lugar equivocado. Habla con el experto Godan. Aprenderás más con él.",
        "985bb2c56c2624d29d62": "No estás listo para instruirte conmigo, forastero. Antes deberás pasar un tiempo con mi ayudante Jhag, ahí lo tienes.",
        "ad929f46c5746dc2c00d": "¡Morir en la batalla es glorioso! Pero, con lo que voy a enseñarte, puede que no mueras tan rápido, ¿umm?",
        "b358518aa715af8fcb46": "¡Throm-ka! ¿Qué estás buscando, forastero?"
      },
      "name": "Jhag",
      "subName": "Oficial encantador",
