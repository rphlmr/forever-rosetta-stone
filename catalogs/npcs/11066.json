    "frFR": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Entraînez-moi.",
        "12f641535dc7df465bec": "Vous n'êtes pas là où vous devriez. Voyez l'expert Godan, là-bas. Il saura vous en apprendre plus que moi.",
        "985bb2c56c2624d29d62": "Vous ne pouvez suivre mon enseignement. Passez d'abord un peu de temps avec mon assistant, Jhag, qui se trouve là.",
        "ad929f46c5746dc2c00d": "Il est glorieux de mourir au combat ! Mais avec ce que je vais vous enseigner, peut-être que vous ne mourrez pas si vite !",
        "b358518aa715af8fcb46": "Throm-ka ! Que cherchez-vous, étranger ?"
      },
      "name": "Jhag",
      "subName": "Enchanteur - Compagnon",
