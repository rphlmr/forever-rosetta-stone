    "daDK": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Træn mig.",
        "12f641535dc7df465bec": "Du er kommet til det forkerte sted. Tal med eksperten Godan derovre. Du lærer mere af ham.",
        "985bb2c56c2624d29d62": "Du er ikke klar til at træne med mig, fremmede. Brug lidt tid hos min assistent Jhag derovre.",
        "ad929f46c5746dc2c00d": "Det er ærefuldt at dø i kamp! Men med det, jeg lærer dig, dør du måske ikke så hurtigt, hva'?",
        "b358518aa715af8fcb46": "Throm-ka! Hvad søger du, fremmede?"
      },
      "name": "Jhag",
      "translationMetadata": {
        "fields": {
