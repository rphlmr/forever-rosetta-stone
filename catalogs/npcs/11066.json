    "enUS": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Train me.",
        "12f641535dc7df465bec": "You come to wrong place. Talk to the expert Godan over there. You learn more from him.",
        "985bb2c56c2624d29d62": "You are unfit to train with me, stranger. Spend some time with my assistant Jhag over there. ",
        "ad929f46c5746dc2c00d": "To die in battle is glorious! But, with what I teach you, maybe you not die so quickly, hm?  ",
        "b358518aa715af8fcb46": "Throm-ka! What you looking for, stranger?"
      },
      "name": "Jhag",
      "subName": "Journeyman Enchanter",
