    "hrHR": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Podučite me.",
        "12f641535dc7df465bec": "Došao si na pogrešno mjesto. Razgovaraj sa stručnjakom Godanom ondje. Od njega ćeš više naučiti.",
        "985bb2c56c2624d29d62": "Nisi spreman trenirati sa mnom, stranče. Provedi neko vrijeme s mojim pomoćnikom Jhagom ondje.",
        "ad929f46c5746dc2c00d": "Slavno je poginuti u bitci! Ali uz ono što te naučim možda nećeš tako brzo umrijeti, ha?",
        "b358518aa715af8fcb46": "Throm-ka! Što tražiš, stranče?"
      },
      "name": "Jhag",
