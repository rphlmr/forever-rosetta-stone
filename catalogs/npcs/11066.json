  "locales": {
    "csCZ": {
      "dialogue": {
        "0253b579477ed2f9ea8f": "Vycvičte mě.",
        "12f641535dc7df465bec": "Přišel jsi na špatné místo. Promluv si s odborníkem Godanem támhle. Od něj se naučíš víc.",
        "985bb2c56c2624d29d62": "Nejsi způsobilý cvičit se mnou, cizinče. Věnuj nějaký čas mému pomocníkovi Jhagovi támhle.",
        "ad929f46c5746dc2c00d": "Zemřít v bitvě je slavné! Ale díky tomu, co tě naučím, možná nezemřeš tak rychle, hm?",
        "b358518aa715af8fcb46": "Throm-ka! Co hledáš, cizinče?"
      },
      "name": "Jhag",
      "translationMetadata": {
        "fields": {
          "dialogue.0253b579477ed2f9ea8f": {
