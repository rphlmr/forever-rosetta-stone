    "csCZ": {
      "dialogue": {
        "d29e861d4314d74a0cf4": "Tvůj čas ještě nenastal. Pomohu ti vrátit se do říše živých... za určitou cenu.",
        "zephras:9fc02f34282467c24870": "Vrať mě zpět k životu."
      },
      "name": "Léčitel duchů",
