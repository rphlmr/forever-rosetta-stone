    "deDE": {
      "dialogue": {
        "d29e861d4314d74a0cf4": "Für Euch ist die Zeit noch nicht reif. Ich werde Euch bei der Reise zurück in die Welt der Lebenden behilflich sein... gegen Bezahlung.",
        "zephras:9fc02f34282467c24870": "Bringt mich ins Leben zurück."
      },
      "name": "Geistheilerin",
