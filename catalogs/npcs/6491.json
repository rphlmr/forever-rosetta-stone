      "dialogue": {
        "d29e861d4314d74a0cf4": "Twój czas jeszcze nie nadszedł. Pomogę ci wrócić do krainy żywych... za pewną cenę.",
        "zephras:9fc02f34282467c24870": "Przywróć mnie do życia."
