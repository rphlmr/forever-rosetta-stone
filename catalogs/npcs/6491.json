    "daDK": {
      "dialogue": {
        "d29e861d4314d74a0cf4": "Din tid er endnu ikke kommet. Jeg vil hjælpe dig tilbage til de levendes rige... mod en pris.",
        "zephras:9fc02f34282467c24870": "Bring mig tilbage til livet."
      },
      "name": "Åndehelbreder",
