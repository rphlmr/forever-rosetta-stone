  "locales": {
    "csCZ": {
      "dialogue": {
        "0d222b829c44a2ff9ba5": "Hledám výcvik v umění lovce.",
        "a279b741cd71eb1f09fa": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Pokaždé je tato služba obtížnější, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvé naučené talenty?",
        "dbf8346274e8792fd252": "S výcvikem ti nemohu pomoci. Vyhledej trenéra pro $c.",
        "f57b725c8931a489dcbb": "Co pro tebe mohu udělat?"
      },
      "name": "Dargh Trueaim",
      "translationMetadata": {
        "fields": {
          "dialogue.0d222b829c44a2ff9ba5": {
            "origin": "ai",
