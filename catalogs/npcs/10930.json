    "daDK": {
      "dialogue": {
        "0d222b829c44a2ff9ba5": "Jeg søger træning i jægerens kunst.",
        "a279b741cd71eb1f09fa": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "dbf8346274e8792fd252": "Jeg kan ikke hjælpe dig med træningen. Du bør finde en træner for $c.",
        "f57b725c8931a489dcbb": "Hvad kan jeg gøre for dig?"
      },
      "name": "Dargh Trueaim",
      "translationMetadata": {
        "fields": {
          "dialogue.0d222b829c44a2ff9ba5": {
