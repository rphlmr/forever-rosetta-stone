            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "1a8be9fbdab69dd41cba": "Jeg vil gerne se dine varer.",
        "295c0a607a5526e247c3": "Siden Dalarans fald og Quel'Thalas' ødelæggelse har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere har gjort et fremragende stykke arbejde med at opfylde vores bestillinger med kvalitetsvarer.",
        "38e430300c38dc02f17d": "Jeg sælger kun det fineste arkanudstyr, fremstillet af håndværkerne og magikerne her i Stormwind."
      },
      "name": "Charys Yserian",
      "translationMetadata": {
        "fields": {
          "dialogue.1a8be9fbdab69dd41cba": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
