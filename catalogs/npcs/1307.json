    "hrHR": {
      "dialogue": {
        "1a8be9fbdab69dd41cba": "Želim pogledati vašu robu.",
        "295c0a607a5526e247c3": "Od pada Dalarana i uništenja Quel'Thalasa teško je nabaviti takvu robu. No Lucan Cordell i neki od naših drugih obrtnika odlično ispunjavaju naše narudžbe kvalitetnom robom.",
        "38e430300c38dc02f17d": "Prodajem samo najbolju arkansku opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu."
      },
      "name": "Charys Yserian",
      "translationMetadata": {
