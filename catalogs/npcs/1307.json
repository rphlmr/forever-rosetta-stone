    "svSE": {
      "dialogue": {
        "1a8be9fbdab69dd41cba": "Jag vill se dina varor.",
        "295c0a607a5526e247c3": "Sedan Dalarans fall och Quel'Thalas förstörelse har varor av det här slaget varit svåra att få tag på. Men Lucan Cordell och några av våra andra hantverkare har gjort ett utmärkt arbete med att fylla våra beställningar med kvalitetsvaror.",
        "38e430300c38dc02f17d": "Jag säljer bara den finaste arkana utrustningen, tillverkad av hantverkarna och magikerna här i Stormwind."
      },
      "name": "Charys Yserian",
      "translationMetadata": {
        "fields": {
          "dialogue.1a8be9fbdab69dd41cba": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
