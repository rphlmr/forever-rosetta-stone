  "locales": {
    "csCZ": {
      "dialogue": {
        "1a8be9fbdab69dd41cba": "Rád bych si prohlédl vaše zboží.",
        "295c0a607a5526e247c3": "Od pádu Dalaranu a zničení Quel'Thalasu je těžké takové zboží sehnat. Lucan Cordell a někteří naši další řemeslníci však odvádějí skvělou práci a vyřizují naše objednávky kvalitním zbožím.",
        "38e430300c38dc02f17d": "Prodávám jen to nejlepší magické vybavení, vyrobené řemeslníky a mágy zde ve Stormwindu."
      },
      "name": "Charys Yserian",
      "translationMetadata": {
        "fields": {
          "dialogue.1a8be9fbdab69dd41cba": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.295c0a607a5526e247c3": {
