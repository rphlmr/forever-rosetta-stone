    "enUS": {
      "dialogue": {
        "1a8be9fbdab69dd41cba": "I want to browse your goods.",
        "295c0a607a5526e247c3": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise.",
        "38e430300c38dc02f17d": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind."
      },
      "name": "Charys Yserian",
      "subName": "Arcane Trinkets Vendor",
      "translationMetadata": {
