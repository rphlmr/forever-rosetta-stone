    "daDK": {
      "dialogue": {
        "167465e6b32fdac40304": "Jeg vil gerne se dine varer.",
        "8af269bbf2cedd818b9b": "Træn mig.",
        "aab758125dcb4eea0ba5": "Denne svinesti er ikke ligefrem hyggelig, men den har historie, så Stonard må være vigtig for nogen. Jeg vil vædde på, at det er derfor, vi bliver her. Det er bestemt ikke på grund af udsigten; det ligner ikke engang hjemmet."
      },
      "name": "Dar",
      "translationMetadata": {
