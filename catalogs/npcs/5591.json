  "locales": {
    "csCZ": {
      "dialogue": {
        "167465e6b32fdac40304": "Rád bych si prohlédl vaše zboží.",
        "8af269bbf2cedd818b9b": "Vycvičte mě.",
        "aab758125dcb4eea0ba5": "Tenhle chlív má k pohodlí daleko, ale má svou historii, takže pro někoho musí být Stonard důležitý. Vsadil bych se, že proto tu zůstáváme. Kvůli výhledu to určitě není, ani to tu nevypadá jako doma."
      },
      "name": "Dar",
      "translationMetadata": {
