    "esES": {
      "dialogue": {
        "167465e6b32fdac40304": "Quiero ver tus mercancías.",
        "8af269bbf2cedd818b9b": "Entréname.",
        "aab758125dcb4eea0ba5": "Esta pocilga es poco cómoda, pero tiene historia, así que Stonard debe ser importante para alguien. Apostaría que por eso nos quedamos aquí. Seguro que no es por las vistas... ni siquiera parece un hogar."
      },
      "name": "Dar",
