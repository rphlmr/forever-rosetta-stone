    "deDE": {
      "dialogue": {
        "167465e6b32fdac40304": "Ich möchte Eure Waren ansehen.",
        "8af269bbf2cedd818b9b": "Bildet mich aus.",
        "aab758125dcb4eea0ba5": "Dieser Stall ist ein bisschen ungemütlich, aber er hat Geschichte, also muss Stonard für jemanden wichtig sein. Ich würde wetten, dass wir deshalb hier bleiben. Es ist sicher nicht wegen der Aussicht, es sieht nicht mal wie ein Zuhause aus."
      },
      "name": "Dar",
      "translationMetadata": {
