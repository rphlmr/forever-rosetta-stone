          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "4a888163456f87ba6614": "Bildet mich aus.",
        "5dbf7ace511ed34712ae": "Ave, $c. In meinen Jahren habe ich viele eifrige Tauren gesehen, die ihren Wert für den Stamm beweisen wollen. Es sollte nicht vergessen werden, dass Eifer kein Ersatz für Weisheit und Erfahrung ist.",
        "b504e1eb6d7aeaaf5343": "Ich möchte Eure Waren ansehen."
      },
      "name": "Häuptling Hawkwind",
      "translationMetadata": {
        "fields": {
          "dialogue.4a888163456f87ba6614": {
