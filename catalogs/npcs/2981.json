    "esMX": {
      "dialogue": {
        "4a888163456f87ba6614": "Entréname.",
        "5dbf7ace511ed34712ae": "Saludos, $c. En mis años he visto a muchos tauren entusiastas que desean demostrar su valía a la tribu. No debemos olvidar que el entusiasmo no sustituye a la sabiduría y la experiencia.",
        "b504e1eb6d7aeaaf5343": "Quiero ver tus mercancías."
      },
      "name": "Jefe Viento de Halcón",
      "translationMetadata": {
