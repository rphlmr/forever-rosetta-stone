    "plPL": {
      "dialogue": {
        "4a888163456f87ba6614": "Wyszkol mnie.",
        "5dbf7ace511ed34712ae": "Witaj, $c. Przez lata widziałem wielu gorliwych taurenów pragnących dowieść swej wartości plemieniu. Nie wolno zapominać, że gorliwość nie zastąpi mądrości i doświadczenia.",
        "b504e1eb6d7aeaaf5343": "Chcę przejrzeć twoje towary."
      },
      "name": "Wódz Hawkwind",
      "translationMetadata": {
