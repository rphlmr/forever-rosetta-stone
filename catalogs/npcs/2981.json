    "itIT": {
      "dialogue": {
        "4a888163456f87ba6614": "Addestrami.",
        "5dbf7ace511ed34712ae": "Salute, $C. Negli anni ho visto molti tauren pieni di entusiasmo che desiderano dimostrare il proprio valore alla tribù. Non va dimenticato che l'entusiasmo non può sostituire la saggezza e l'esperienza.",
        "b504e1eb6d7aeaaf5343": "Vorrei vedere la tua merce."
      },
      "name": "Capo Hawkwind",
      "translationMetadata": {
        "fields": {
