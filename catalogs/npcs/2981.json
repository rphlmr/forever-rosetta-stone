          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "4a888163456f87ba6614": "Træn mig.",
        "5dbf7ace511ed34712ae": "Hil dig, $c. I årenes løb har jeg set mange ivrige taurener, der ønsker at bevise deres værd for stammen. Vi må ikke glemme, at iver ikke kan erstatte visdom og erfaring.",
        "b504e1eb6d7aeaaf5343": "Jeg vil gerne se dine varer."
      },
      "name": "Høvding Hawkwind",
      "translationMetadata": {
        "fields": {
          "dialogue.4a888163456f87ba6614": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
