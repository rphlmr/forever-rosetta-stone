    "ptBR": {
      "dialogue": {
        "4a888163456f87ba6614": "Treine-me.",
        "5dbf7ace511ed34712ae": "Saudações, $c. Ao longo dos anos, vi muitos taurens ansiosos para provar seu valor à tribo. Não devemos esquecer que o entusiasmo não substitui a sabedoria e a experiência.",
        "b504e1eb6d7aeaaf5343": "Quero ver suas mercadorias."
      },
      "name": "Chefe Vento do Falcão",
      "translationMetadata": {
        "fields": {
