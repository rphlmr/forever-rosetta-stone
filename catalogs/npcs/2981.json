    "svSE": {
      "dialogue": {
        "4a888163456f87ba6614": "Träna mig.",
        "5dbf7ace511ed34712ae": "Var hälsad, $c. Under mina år har jag sett många ivriga taurener som vill bevisa sitt värde för stammen. Vi får inte glömma att iver inte ersätter visdom och erfarenhet.",
        "b504e1eb6d7aeaaf5343": "Jag vill se dina varor."
      },
      "name": "Hövding Hawkwind",
