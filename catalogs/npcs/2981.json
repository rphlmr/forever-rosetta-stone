    "esES": {
      "dialogue": {
        "4a888163456f87ba6614": "Entréname.",
        "5dbf7ace511ed34712ae": "Salve, $c. En mis años he visto muchos tauren ansiosos que desean demostrar su valía a la tribu. No hay que olvidar que el afán no sustituye a la sabiduría y la experiencia.",
        "b504e1eb6d7aeaaf5343": "Quiero ver tus mercancías."
      },
      "name": "Jefe Vientaguilar",
      "translationMetadata": {
        "fields": {
          "dialogue.4a888163456f87ba6614": {
