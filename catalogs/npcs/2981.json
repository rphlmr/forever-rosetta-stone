  "locales": {
    "csCZ": {
      "dialogue": {
        "4a888163456f87ba6614": "Vycvičte mě.",
        "5dbf7ace511ed34712ae": "Buď zdráv, $c. Za svá léta jsem viděl mnoho horlivých taurenů, kteří chtěli prokázat svou cenu kmeni. Nesmíme zapomínat, že horlivost nenahradí moudrost a zkušenosti.",
        "b504e1eb6d7aeaaf5343": "Chci si prohlédnout vaše zboží."
      },
      "name": "Náčelník Hawkwind",
      "translationMetadata": {
        "fields": {
          "dialogue.4a888163456f87ba6614": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
