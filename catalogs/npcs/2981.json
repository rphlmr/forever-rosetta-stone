    "hrHR": {
      "dialogue": {
        "4a888163456f87ba6614": "Podučite me.",
        "5dbf7ace511ed34712ae": "Pozdrav, $c. Tijekom godina vidio sam mnoge gorljive taurene koji žele dokazati svoju vrijednost plemenu. Ne smijemo zaboraviti da gorljivost ne može zamijeniti mudrost i iskustvo.",
        "b504e1eb6d7aeaaf5343": "Želim pogledati vašu robu."
      },
      "name": "Poglavica Hawkwind",
      "translationMetadata": {
        "fields": {
          "dialogue.4a888163456f87ba6614": {
