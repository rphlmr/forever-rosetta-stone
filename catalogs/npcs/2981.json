    "frFR": {
      "dialogue": {
        "4a888163456f87ba6614": "Entraînez-moi.",
        "5dbf7ace511ed34712ae": "Salut, $c. Au fil des ans, j'ai vu de nombreux taurens désireux de prouver leur valeur au sein de la tribu. Il ne faut pas oublier que l'ardeur ne remplace pas la sagesse et l'expérience.",
        "b504e1eb6d7aeaaf5343": "Je voudrais regarder vos articles."
      },
      "name": "Chef Hawkwind",
      "translationMetadata": {
        "fields": {
