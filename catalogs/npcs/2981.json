    "enUS": {
      "dialogue": {
        "4a888163456f87ba6614": "Train me.",
        "5dbf7ace511ed34712ae": "Hail, $c. In my years I have seen many eager tauren who wish to prove their worth to the tribe. It should not be forgotten that eagerness is no substitute for wisdom and experience.",
        "b504e1eb6d7aeaaf5343": "I want to browse your goods."
      },
      "name": "Chief Hawkwind",
      "translationMetadata": {
        "fields": {
