    "trTR": {
      "dialogue": {
        "4a888163456f87ba6614": "Beni eğit.",
        "5dbf7ace511ed34712ae": "Selam, $c. Yıllar boyunca kabileye değerini kanıtlamak isteyen pek çok hevesli tauren gördüm. Hevesin, bilgeliğin ve deneyimin yerini tutmadığı unutulmamalı.",
        "b504e1eb6d7aeaaf5343": "Mallarına bakmak istiyorum."
      },
      "name": "Reis Hawkwind",
