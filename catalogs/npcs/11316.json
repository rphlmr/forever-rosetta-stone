    "enUS": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ah, my sweet Brandy, I miss her so!",
        "56aac563bffd4951eb9a": "My job title is Waste Management Specialist.",
        "920fc2700bf38d4b4d89": "The Barov house sure does keep me busy. Always some sort of refuse coming out of there.",
        "b7d5dfcec30381418089": "Perhaps you should speak into these sound enhancing devices attached to my FISTS OF FURY."
      },
      "name": "Joseph Dirte",
      "subName": "Waste Management",
