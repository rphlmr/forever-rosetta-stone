    "esES": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ah, mi dulce Brandy, ¡la echo tanto de menos!",
        "56aac563bffd4951eb9a": "Mi título es el de Especialista en Administración de Desechos.",
        "920fc2700bf38d4b4d89": "La casa Barov se encarga de mantenerme ocupado. Siempre sale de ahí algún tipo de basura.",
        "b7d5dfcec30381418089": "quizás deberías hablar hacia estos amplificadores de sonido que tengo sujetos a mis PUÑOS DE FURIA."
      },
      "name": "Joseph Dirte",
      "subName": "Gestión de residuos",
