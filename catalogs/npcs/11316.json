    "hrHR": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ah, moja slatka Brandy, tako mi nedostaje!",
        "56aac563bffd4951eb9a": "Moje radno mjesto zove se stručnjak za gospodarenje otpadom.",
        "920fc2700bf38d4b4d89": "Kuća Barovovih doista me drži zaposlenim. Uvijek odande izlazi nekakav otpad.",
        "b7d5dfcec30381418089": "Možda bi trebao govoriti u ove uređaje za pojačavanje zvuka pričvršćene na moje ŠAKE BIJESA."
      },
      "name": "Joseph Dirte",
