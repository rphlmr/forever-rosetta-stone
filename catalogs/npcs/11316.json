    "frFR": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ah, ma douce Brandy, elle me manque tellement !",
        "56aac563bffd4951eb9a": "En fait, je suis officiellement Spécialiste de la Gestion des Déchets.",
        "920fc2700bf38d4b4d89": "La maison Barov me donne beaucoup de travail. Il en sort toujours des détritus quelconques.",
        "b7d5dfcec30381418089": "Vous devriez peut-être parler à ces outils de propagation du son attachés à mes POINGS DE FURIE."
      },
      "name": "Joseph Dirte",
      "subName": "Gestion des déchets",
