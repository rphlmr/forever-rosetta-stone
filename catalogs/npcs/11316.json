    "plPL": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ach, moja słodka Brandy, tak bardzo za nią tęsknię!",
        "56aac563bffd4951eb9a": "Moje stanowisko to specjalista do spraw gospodarowania odpadami.",
        "920fc2700bf38d4b4d89": "Dom Barovów naprawdę daje mi sporo pracy. Ciągle wynoszą stamtąd jakieś odpadki.",
        "b7d5dfcec30381418089": "Może powinieneś mówić do tych urządzeń wzmacniających dźwięk, przymocowanych do moich PIĘŚCI GNIEWU."
      },
      "name": "Joseph Dirte",
      "translationMetadata": {
