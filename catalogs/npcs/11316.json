  "locales": {
    "csCZ": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ach, má sladká Brandy, tak moc mi chybí!",
        "56aac563bffd4951eb9a": "Má pracovní pozice je specialista na nakládání s odpady.",
        "920fc2700bf38d4b4d89": "Dům Barovů mě rozhodně zaměstnává. Pořád odtamtud vynášejí nějaký odpad.",
        "b7d5dfcec30381418089": "Možná bys měl mluvit do těchto zařízení pro zesílení zvuku připevněných k mým PĚSTEM HNĚVU."
      },
      "name": "Joseph Dirte",
      "translationMetadata": {
