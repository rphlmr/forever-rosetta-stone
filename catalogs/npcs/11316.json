    "deDE": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ach, meine süße Brandy, ich vermisse sie so!",
        "56aac563bffd4951eb9a": "Meine genaue Arbeitsplatzbeschreibung lautet 'Spezialist für Abfallentsorgung'.",
        "920fc2700bf38d4b4d89": "Das Haus Barov hält mich ganz schön auf Trab. Ständig kommt da irgenwelcher Müll raus...",
        "b7d5dfcec30381418089": "Vielleicht solltet Ihr in diese Schall verstärkenden Geräte hineinsprechen, die an meinen FURORFÄUSTEN befestigt sind!"
      },
      "name": "Joseph Dirte",
      "subName": "Abfallentsorgung",
