    "daDK": {
      "dialogue": {
        "41595d1c200ca55157b4": "Åh, min søde Brandy, hvor jeg savner hende!",
        "56aac563bffd4951eb9a": "Min stillingsbetegnelse er affaldshåndteringsspecialist.",
        "920fc2700bf38d4b4d89": "Barovs hus holder mig bestemt beskæftiget. Der kommer altid en eller anden slags affald derfra.",
        "b7d5dfcec30381418089": "Måske skulle du tale ind i disse lydforstærkende anordninger, der sidder fast på mine RASERIETS NÆVER."
      },
      "name": "Joseph Dirte",
      "translationMetadata": {
