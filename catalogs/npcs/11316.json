    "ptBR": {
      "dialogue": {
        "41595d1c200ca55157b4": "Ah, minha doce Brandy, como sinto falta dela!",
        "56aac563bffd4951eb9a": "Minha profissão é Especialista em Gerenciamento de Resíduos.",
        "920fc2700bf38d4b4d89": "A casa Barov realmente me mantém ocupado. Tem sempre algum tipo de refugo saindo de lá.",
        "b7d5dfcec30381418089": "Talvez você devesse falar através destes aparelhos amplificadores de som embutidos nos meus PUNHOS DA FÚRIA."
      },
      "name": "José Gary",
      "subName": "Tratamento de Resíduos",
