  "locales": {
    "csCZ": {
      "dialogue": {
        "bf17d383a7ccdecb0496": "Lovíš Deathclasp, $n? To na mě dělá dojem. Jen tento týden jsem kvůli ní přišel o dva muže. Doufejme, že budeš mít větší štěstí než oni.",
        "d93b7cb83d958f944222": "Velitel se v poslední době nechová jako obvykle. Jeho milenka zmizela při archeologických vykopávkách v jižní poušti, beze stopy! Opravdu velmi zvláštní.$B$BPředpokládám, že hledáš práci? Mám ti to snad vtĺct do hlavy?"
      },
      "name": "Vish Kozus",
      "translationMetadata": {
        "fields": {
          "dialogue.bf17d383a7ccdecb0496": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d93b7cb83d958f944222": {
