            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "bf17d383a7ccdecb0496": "Du jager Deathclasp, $n? Jeg er imponeret. Jeg har mistet to af mine mænd til hende alene i denne uge. Lad os håbe, at du har mere held end dem.",
        "d93b7cb83d958f944222": "Kommandøren har ikke været sig selv på det seneste. Hans elskerinde forsvandt under en arkæologisk udgravning i den sydlige ørken, sporløst! Meget mærkeligt.$B$BJeg går ud fra, at du søger arbejde? Skal jeg virkelig skære det ud i pap for dig?"
      },
      "name": "Vish Kozus",
      "translationMetadata": {
        "fields": {
          "dialogue.bf17d383a7ccdecb0496": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d93b7cb83d958f944222": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
