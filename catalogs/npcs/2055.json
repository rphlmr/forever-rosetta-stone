  "locales": {
    "csCZ": {
      "dialogue": {
        "14317750b49dab91d245": "Královská lékárnická společnost vyslyší volání Temné paní, odhalí Nový mor a jednou provždy vyžene Arthase a jeho bezbožnou armádu Pohromy ze světa.",
        "bfe8308e661362984164": "Vycvičte mě.",
        "e7d9a60a483fe3309ec6": "Chci si prohlédnout vaše zboží."
      },
      "name": "Mistr lékárník Faranell",
