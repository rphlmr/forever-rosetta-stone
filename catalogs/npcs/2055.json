    "hrHR": {
      "dialogue": {
        "14317750b49dab91d245": "Kraljevsko društvo ljekarnika odazvat će se pozivu Mračne Gospe, otkriti Novu kugu i jednom zauvijek protjerati Arthasa i njegovu bezbožnu vojsku Pošasti sa svijeta.",
        "bfe8308e661362984164": "Podučite me.",
