    "daDK": {
      "dialogue": {
        "14317750b49dab91d245": "Det Kongelige Apotekerlaug vil følge Den Mørke Frues kald, afdække Den Nye Pest og én gang for alle fordrive Arthas og hans gudløse Svøbe fra verden.",
        "bfe8308e661362984164": "Træn mig.",
        "e7d9a60a483fe3309ec6": "Jeg vil gerne se dine varer."
      },
      "name": "Mesterapoteker Faranell",
      "translationMetadata": {
