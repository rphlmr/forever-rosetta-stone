    "deDE": {
      "dialogue": {
        "14317750b49dab91d245": "Die Königliche Apothekergesellschaft soll dem Ruf der Dunklen Dame folgen, um die Neue Seuche aufzudecken und Arthas und seine heidnische Geißelarmee ein für alle Mal aus der Welt zu vertreiben.",
        "bfe8308e661362984164": "Bildet mich aus.",
        "e7d9a60a483fe3309ec6": "Ich möchte Eure Waren ansehen."
      },
      "name": "Apothekermeister Faranell",
      "subName": "Königliche Apothekervereinigung",
