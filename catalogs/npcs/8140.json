          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "193214e6383fcb40ccd0": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Min tjeneste bliver sværere at udføre hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "9afaab4bd667c89889d0": "Jeg vil gerne videreuddanne mig i Lysets veje.",
        "d70fd818625af4f8560e": "Må Lyset beskytte dig i dag."
      },
      "name": "Broder Karman",
      "translationMetadata": {
        "fields": {
          "dialogue.193214e6383fcb40ccd0": {
            "origin": "ai",
