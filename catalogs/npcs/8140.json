  "locales": {
    "csCZ": {
      "dialogue": {
        "193214e6383fcb40ccd0": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "9afaab4bd667c89889d0": "Chci se dále zdokonalovat v cestách Světla.",
        "d70fd818625af4f8560e": "Nechť tě dnes Světlo ochraňuje."
      },
      "name": "Bratr Karman",
      "translationMetadata": {
        "fields": {
          "dialogue.193214e6383fcb40ccd0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.9afaab4bd667c89889d0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d70fd818625af4f8560e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
