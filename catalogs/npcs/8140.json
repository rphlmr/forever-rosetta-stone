    "hrHR": {
      "dialogue": {
        "193214e6383fcb40ccd0": "Strogom sam preobukom mnoge učenike morao odviknuti od svega što su prethodno naučili kako bih ih mogao poučiti iznova. Uslugu koju nudim svaki je put sve teže izvršiti, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "9afaab4bd667c89889d0": "Želim nastaviti obuku na putevima Svjetlosti.",
        "d70fd818625af4f8560e": "Neka te Svjetlost danas čuva."
      },
      "name": "Brat Karman",
      "translationMetadata": {
