  "locales": {
    "csCZ": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Vycvičte mě.",
        "56aaa24a80fe1b7f3018": "Tvá dovednost překonává mou, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže zlepšit se.",
        "b69df38de7876fecabd8": "Mohu tě naučit rybařit.",
        "e390ba87f45506613e06": "Chceš-li se dále zlepšit, musíš najít Nata Paglea v Dustwallow Marsh."
      },
      "name": "Androl Oakhand",
      "translationMetadata": {
        "fields": {
          "dialogue.41d6a478f91d0c2b0328": {
