    "ltLT": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Išmokyk mane.",
        "56aaa24a80fe1b7f3018": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senasis Hemingas iš Booty Bay turi „Ešerys ir tu“ egzempliorių. Ši knyga tikrai padės tau tobulėti.",
        "b69df38de7876fecabd8": "Galiu išmokyti tave žvejoti.",
        "e390ba87f45506613e06": "Jei nori tapti geresniu žveju, turėsi surasti Nat Pagle Dustwallow Marsh pelkėje."
      },
      "name": "Androl Oakhand",
      "subName": "Žvejys",
