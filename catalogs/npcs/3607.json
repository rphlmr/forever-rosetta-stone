    "esES": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Entréname.",
        "56aaa24a80fe1b7f3018": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "b69df38de7876fecabd8": "Puedo enseñarte a pescar.",
        "e390ba87f45506613e06": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades."
      },
      "name": "Androl Manorroble",
      "subName": "Pescador",
