    "daDK": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Træn mig.",
        "56aaa24a80fe1b7f3018": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den vil helt sikkert hjælpe dig med at forbedre dine evner.",
        "b69df38de7876fecabd8": "Jeg kan lære dig at fiske.",
        "e390ba87f45506613e06": "Du må finde Nat Pagle i Dustwallow Marsh for at blive bedre, end du er nu."
      },
      "name": "Androl Oakhand",
      "translationMetadata": {
        "fields": {
          "dialogue.41d6a478f91d0c2b0328": {
