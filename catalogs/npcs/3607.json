    "hrHR": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Podučite me.",
        "56aaa24a80fe1b7f3018": "Tvoja je vještina veća od moje, no čuo sam da starac Heming u Booty Bayu ima primjerke knjige „Grgeč i ti”. Ona će ti zasigurno pomoći da unaprijediš svoju vještinu.",
        "b69df38de7876fecabd8": "Mogu te naučiti pecati.",
        "e390ba87f45506613e06": "Moraš pronaći Nata Paglea u Dustwallow Marshu kako bi postao bolji nego što si sada."
      },
      "name": "Androl Oakhand",
