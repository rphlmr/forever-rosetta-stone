    "plPL": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Wyszkol mnie.",
        "56aaa24a80fe1b7f3018": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci ona rozwinąć umiejętności.",
        "b69df38de7876fecabd8": "Mogę nauczyć cię wędkarstwa.",
        "e390ba87f45506613e06": "Musisz znaleźć Nata Pagle’a w Dustwallow Marsh, aby stać się jeszcze lepszym."
      },
      "name": "Androl Oakhand",
      "translationMetadata": {
