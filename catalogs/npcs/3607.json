    "enUS": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Train me.",
        "56aaa24a80fe1b7f3018": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "b69df38de7876fecabd8": "I can teach you fishing skills.",
        "e390ba87f45506613e06": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently."
      },
      "name": "Androl Oakhand",
      "subName": "Fisherman",
