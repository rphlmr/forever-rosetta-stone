    "frFR": {
      "dialogue": {
        "41d6a478f91d0c2b0328": "Entraînez-moi.",
        "56aaa24a80fe1b7f3018": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "b69df38de7876fecabd8": "Je peux vous apprendre à pêcher.",
        "e390ba87f45506613e06": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange."
      },
      "name": "Androl Oakhand",
      "subName": "Pêcheur",
