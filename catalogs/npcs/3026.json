  "locales": {
    "csCZ": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Vycvičte mě.",
        "064bf6fdc4eff47a3049": "Vaření je celoživotní záležitost a vidím, že sdílíme stejnou vášeň!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Chceš-li se zlepšit, musíš ho vyhledat.",
        "29cfe9c0901bbbbf8f6c": "Wulan ve Shadowprey Village ti může prodat „Expertní kuchařku“. Budeš ji potřebovat, chceš-li se zlepšit.",
        "583449d49c033c511e49": "Mohu tě naučit vařit!"
      },
      "name": "Aska Mistrunner",
      "translationMetadata": {
        "fields": {
