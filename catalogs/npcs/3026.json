    "hrHR": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Podučite me.",
        "064bf6fdc4eff47a3049": "Kuhanje je životni poziv i vidim da dijelimo istu strast!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave iz Gadgetzana majstor je kulinarskog umijeća. Moraš ga potražiti kako bi se usavršio.",
        "29cfe9c0901bbbbf8f6c": "Wulan u Shadowprey Villageu može ti prodati „Stručnu kuharicu”. Trebat će ti ako se želiš usavršiti.",
        "583449d49c033c511e49": "Mogu te naučiti kuhati!"
      },
      "name": "Aska Mistrunner",
