    "daDK": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Træn mig.",
        "064bf6fdc4eff47a3049": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme lidenskab!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham for at blive bedre.",
        "29cfe9c0901bbbbf8f6c": "Wulan i Shadowprey Village kan sælge dig \"Ekspertkogebogen\". Den får du brug for, hvis du vil blive bedre.",
        "583449d49c033c511e49": "Jeg kan lære dig at lave mad!"
      },
      "name": "Aska Mistrunner",
      "translationMetadata": {
        "fields": {
