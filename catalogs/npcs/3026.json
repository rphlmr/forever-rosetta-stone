    "itIT": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Addestrami.",
        "064bf6fdc4eff47a3049": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "29cfe9c0901bbbbf8f6c": "Wulan, a Shadowprey Village, può venderti il \"Ricettario dell'Esperto\". Ti servirà, se vuoi migliorarti.",
        "583449d49c033c511e49": "Posso insegnarti a cucinare!"
      },
      "name": "Aska Mistrunner",
