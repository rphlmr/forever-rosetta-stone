    "esES": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Entréname.",
        "064bf6fdc4eff47a3049": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión.",
        "18c7014b23d95e796b3f": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "29cfe9c0901bbbbf8f6c": "Wulan, en la Aldea Cazasombras, puede venderte el \"Recetario para expertos\". Lo necesitarás si quieres mejorar.",
        "583449d49c033c511e49": "Puedo enseñarte a cocinar."
      },
      "name": "Aska Correbruma",
      "subName": "Instructor de cocina",
