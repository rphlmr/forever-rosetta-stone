    "frFR": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Entraînez-moi.",
        "064bf6fdc4eff47a3049": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "18c7014b23d95e796b3f": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "29cfe9c0901bbbbf8f6c": "Wuland du village de Proie-de-l'Ombre peut vous vendre un livre de cuisine pour experts. Il vous faudra bien ça si vous voulez vous améliorer.",
        "583449d49c033c511e49": "Je peux vous apprendre à cuisiner !"
      },
      "name": "Aska Mistrunner",
      "subName": "Maître des cuisiniers",
