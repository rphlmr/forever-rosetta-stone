    "enUS": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Train me.",
        "064bf6fdc4eff47a3049": "Cooking is a life long pursuit and I see we share the same passion!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "29cfe9c0901bbbbf8f6c": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself.",
        "583449d49c033c511e49": "I can teach you how to cook!"
      },
      "name": "Aska Mistrunner",
      "subName": "Cooking Trainer",
