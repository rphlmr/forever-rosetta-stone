    "trTR": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Beni eğit.",
        "064bf6fdc4eff47a3049": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "18c7014b23d95e796b3f": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarının ustasıdır. Kendini geliştirmek için onu bulmalısın.",
        "29cfe9c0901bbbbf8f6c": "Shadowprey Village’daki Wulan sana \"Uzman Yemek Kitabı\"nı satabilir. Kendini geliştirmek için ona ihtiyacın olacak.",
        "583449d49c033c511e49": "Sana yemek yapmayı öğretebilirim!"
      },
      "name": "Aska Mistrunner",
