    "svSE": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Träna mig.",
        "064bf6fdc4eff47a3049": "Matlagning är en livslång syssla och jag ser att vi delar samma passion!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave från Gadgetzan är en mästare i kokkonst. Du måste söka upp honom för att bli bättre.",
        "29cfe9c0901bbbbf8f6c": "Wulan i Shadowprey Village kan sälja dig \"Expertkokboken\". Du behöver den om du vill bli bättre.",
        "583449d49c033c511e49": "Jag kan lära dig laga mat!"
      },
      "name": "Aska Mistrunner",
