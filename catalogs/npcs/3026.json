    "ltLT": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Pamokyk mane.",
        "064bf6fdc4eff47a3049": "Maisto gaminimas – viso gyvenimo užsiėmimas, ir matau, kad mus sieja ta pati aistra!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meno meistras. Jei nori tobulėti, turėsi jį susirasti.",
        "29cfe9c0901bbbbf8f6c": "Wulan iš Shadowprey Village gali tau parduoti „Eksperto kulinarijos knygą“. Jei nori tobulėti, jos tau reikės.",
        "583449d49c033c511e49": "Galiu išmokyti tave gaminti maistą!"
      },
      "name": "Aska Mistrunner",
      "subName": "Maisto gaminimo mokytojas",
