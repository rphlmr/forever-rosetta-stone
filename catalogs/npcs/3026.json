    "deDE": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Bildet mich aus.",
        "064bf6fdc4eff47a3049": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen.",
        "29cfe9c0901bbbbf8f6c": "Wulan in Shadowprey kann Euch das \"Expertenkochbuch\" verkaufen. Ihr werdet es brauchen, wenn Ihr Euch verbessern wollt.",
        "583449d49c033c511e49": "Ich kann Euch das Kochen beibringen!"
      },
      "name": "Aska Mistrunner",
      "subName": "Kochkunstlehrerin",
      "translationMetadata": {
