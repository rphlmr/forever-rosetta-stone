    "plPL": {
      "dialogue": {
        "01018d01b3be4d6848a8": "Wyszkol mnie.",
        "064bf6fdc4eff47a3049": "Gotowanie to zajęcie na całe życie i widzę, że podzielamy tę samą pasję!",
        "18c7014b23d95e796b3f": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Musisz go odszukać, by się doskonalić.",
        "29cfe9c0901bbbbf8f6c": "Wulan w Shadowprey Village może sprzedać ci „Książkę kucharską eksperta”. Będzie ci potrzebna, jeśli chcesz się doskonalić.",
        "583449d49c033c511e49": "Mogę nauczyć cię gotować!"
      },
      "name": "Aska Mistrunner",
      "translationMetadata": {
