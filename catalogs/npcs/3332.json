  "locales": {
    "csCZ": {
      "dialogue": {
        "0e2787a01e5d6797cf60": "Ve schopnostech mě předčíš, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit.",
        "86da7699bc89f8aad14e": "Chceš-li se dále zlepšovat, musíš najít Nata Pagla v Dustwallow Marsh.",
        "9db65265928f11b19e4f": "Jo, můžu tě naučit rybařit.",
        "ac4041be85b2f935f120": "Potřebuji výcvik, Lumaku.",
        "ee83d89895eb7a76d45a": "Ryba moc dobrá. Ty přijít učit rybařit? Jíst rybu? Mmmm..."
      },
      "name": "Lumak",
      "translationMetadata": {
        "fields": {
