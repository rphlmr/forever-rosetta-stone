    "trTR": {
      "dialogue": {
        "0e2787a01e5d6797cf60": "Beceri bakımından beni aştın ama Booty Bay’deki Yaşlı Heming’in “Levrek ve Sen” kitabından kopyaları olduğunu duydum. Bu kitap kesinlikle ilerlemene yardımcı olur.",
        "86da7699bc89f8aad14e": "Daha da gelişmek için Dustwallow Marsh’ta Nat Pagle’ı bulmalısın.",
        "9db65265928f11b19e4f": "Evet, sana balık tutmayı öğretebilirim.",
        "ac4041be85b2f935f120": "Eğitime ihtiyacım var, Lumak.",
        "ee83d89895eb7a76d45a": "Balık çok lezzetli. Sen balık tutmayı öğrenmeye mi geldin? Balık yemek? Mmmm..."
      },
      "name": "Lumak",
