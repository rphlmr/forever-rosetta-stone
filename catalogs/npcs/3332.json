    "enUS": {
      "dialogue": {
        "0e2787a01e5d6797cf60": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "86da7699bc89f8aad14e": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "9db65265928f11b19e4f": "Yap, I can teach ye to fish.",
        "ac4041be85b2f935f120": "I require training, Lumak.",
        "ee83d89895eb7a76d45a": "Fish so delicious. You come learn fish? Eat fish? Mmmmm..."
      },
      "name": "Lumak",
      "subName": "Fishing Trainer",
      "translationMetadata": {
