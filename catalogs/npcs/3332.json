    "daDK": {
      "dialogue": {
        "0e2787a01e5d6797cf60": "Du er dygtigere end mig, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af „Aborren og dig“. Den vil sikkert hjælpe dig videre.",
        "86da7699bc89f8aad14e": "Du må finde Nat Pagle i Dustwallow Marsh for at blive bedre.",
        "9db65265928f11b19e4f": "Jep, jeg kan lære dig at fiske.",
        "ac4041be85b2f935f120": "Jeg har brug for træning, Lumak.",
        "ee83d89895eb7a76d45a": "Fisk så lækker. Du komme lære fiske? Spise fisk? Mmmm..."
      },
      "name": "Lumak",
      "translationMetadata": {
