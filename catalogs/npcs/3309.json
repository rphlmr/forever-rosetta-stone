    "hrHR": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Je li ti draže povjeriti svoju robu goblinu?",
        "2252a18910629077d5f0": "Osim ratnika vani, moja braća i ja borili smo se u bitci za Hyjal. Tko god pokuša opljačkati banku, prvo se mora suočiti s nama.",
        "f235aed2f821911f9557": "Svojom krvlju jamčim sigurnost ove banke. Je li ti to dovoljno?",
        "zephras:54fef075e1b4e38f411e": "Želim pogledati svoj bankovni sef."
      },
      "name": "Karus",
