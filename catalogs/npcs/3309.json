    "svSE": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Skulle du hellre anförtro dina varor åt en goblin?",
        "2252a18910629077d5f0": "Förutom soldaterna utanför stred mina bröder och jag i slaget vid Hyjal. Den som vill stjäla från banken måste först möta oss.",
        "f235aed2f821911f9557": "Jag garanterar bankens säkerhet med mitt eget blod. Duger det åt dig?",
        "zephras:54fef075e1b4e38f411e": "Jag skulle vilja titta i mitt bankfack."
      },
      "name": "Karus",
      "translationMetadata": {
