    },
    "deDE": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Würdet Ihr Eure Waren lieber einem Goblin anvertrauen?",
        "2252a18910629077d5f0": "Außer gegen die Grunzer da draußen kämpften meine Brüder und ich in der Schlacht von Hyjal. Alle, die die Bank bestehlen wollen, bekommen es zuerst mit uns zu tun.",
        "f235aed2f821911f9557": "Ich garantiere mit meinem Blut für die Sicherheit dieser Bank, genügt Euch das?",
        "zephras:54fef075e1b4e38f411e": "Ich möchte einen Blick in mein Schließfach werfen."
      },
      "name": "Karus",
      "subName": "Bankier",
