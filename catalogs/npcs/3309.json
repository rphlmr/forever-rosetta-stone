    "enUS": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Would you rather trust your goods with a goblin?",
        "2252a18910629077d5f0": "Besides the Grunts outside, my brothers and I fought at the battle of Hyjal. Any who seek to steal from the bank must face us first.",
        "f235aed2f821911f9557": "I guarantee this bank's security with my own blood, is that good enough for you?",
        "zephras:54fef075e1b4e38f411e": "I would like to check my deposit box."
      },
      "name": "Karus",
      "subName": "Banker",
