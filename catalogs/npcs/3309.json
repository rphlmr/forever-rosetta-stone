    "ptBR": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Você prefere deixar seus bens com um goblin?",
        "2252a18910629077d5f0": "Além da presença dos Brutos lá fora, meus irmãos e eu lutamos na batalha de Hyjal. Qualquer um que queira assaltar o banco vai ter que nos enfrentar antes.",
        "f235aed2f821911f9557": "Garanto a segurança deste banco com meu próprio sangue, para você basta?",
        "zephras:54fef075e1b4e38f411e": "Gostaria de conferir meu cofre."
      },
      "name": "Karus",
      "subName": "Caixa do Banco",
