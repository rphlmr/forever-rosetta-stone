    "esES": {
      "dialogue": {
        "10a7b0b27e98852087a6": "¿Preferirías confiar tus cosas a un goblin?",
        "2252a18910629077d5f0": "Además de los Brutos, mis hermanos y yo luchamos en la batalla de Hyjal. Y el que intente robar el banco tendrá que vérselas primero con nosotros.",
        "f235aed2f821911f9557": "Protejo la seguridad de este banco con mi propia sangre, ¿es eso suficiente para ti?",
        "zephras:54fef075e1b4e38f411e": "Desearía revisar mi caja fuerte."
      },
      "name": "Karus",
      "subName": "Banquero",
