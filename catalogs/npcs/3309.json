          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Vil du hellere betro dine varer til en goblin?",
        "2252a18910629077d5f0": "Ud over gruntstyrkerne udenfor kæmpede mine brødre og jeg i slaget ved Hyjal. Enhver, der vil stjæle fra banken, må først møde os.",
        "f235aed2f821911f9557": "Jeg garanterer bankens sikkerhed med mit eget blod. Er det godt nok til dig?",
        "zephras:54fef075e1b4e38f411e": "Jeg vil gerne se i min bankboks."
      },
      "name": "Karus",
      "translationMetadata": {
        "fields": {
          "dialogue.10a7b0b27e98852087a6": {
            "origin": "ai",
