    "frFR": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Vous préférez confier vos biens à un gobelin ?",
        "2252a18910629077d5f0": "En plus des grunts, dehors, mes frères et moi avons combattu à la bataille de Hyjal. Quiconque cherche à voler la banque devra d'abord nous affronter.",
        "f235aed2f821911f9557": "Je garantis la sécurité de cette banque avec mon propre sang. Ça vous suffit ?",
        "zephras:54fef075e1b4e38f411e": "J'aimerais regarder le contenu de mon coffre."
      },
      "name": "Karus",
      "subName": "Banquier",
