    "trTR": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Eşyalarını bir gobline emanet etmeyi mi tercih edersin?",
        "2252a18910629077d5f0": "Dışarıdaki askerlerin yanı sıra kardeşlerimle ben de Hyjal Muharebesi’nde savaştık. Bankayı soymak isteyen önce bizimle yüzleşmeli.",
        "f235aed2f821911f9557": "Bu bankanın güvenliğine kendi kanımla kefilim. Bu sana yeter mi?",
        "zephras:54fef075e1b4e38f411e": "Kasamı kontrol etmek istiyorum."
      },
      "name": "Karus",
      "translationMetadata": {
