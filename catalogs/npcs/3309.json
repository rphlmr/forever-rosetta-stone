    "ltLT": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Ar mieliau patikėtum savo turtą goblinui?",
        "2252a18910629077d5f0": "Be lauke stovinčių karių, mano broliai ir aš kovėmės Hyjal mūšyje. Kiekvienas, kuris mėgins apiplėšti banką, pirmiausia turės susidurti su mumis.",
        "f235aed2f821911f9557": "Už šio banko saugumą laiduoju savo krauju. Ar tau to gana?",
        "zephras:54fef075e1b4e38f411e": "Norėčiau patikrinti savo seifą."
      },
      "name": "Karus",
      "subName": "Bankininkas",
