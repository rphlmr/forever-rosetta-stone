  "locales": {
    "csCZ": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Svěřil bys své zboží raději goblinovi?",
        "2252a18910629077d5f0": "Kromě sekáčů venku jsem já a mí bratři bojovali v bitvě o Hyjal. Každý, kdo chce vykrást banku, se musí nejprve postavit nám.",
        "f235aed2f821911f9557": "Za bezpečnost této banky ručím vlastní krví. Stačí ti to?",
        "zephras:54fef075e1b4e38f411e": "Chtěl bych se podívat do své bezpečnostní schránky."
      },
      "name": "Karus",
      "translationMetadata": {
        "fields": {
          "dialogue.10a7b0b27e98852087a6": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
