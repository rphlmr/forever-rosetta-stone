    "plPL": {
      "dialogue": {
        "10a7b0b27e98852087a6": "Wolisz powierzyć swoje dobra goblinowi?",
        "2252a18910629077d5f0": "Poza siepaczami na zewnątrz moi bracia i ja walczyliśmy w bitwie o Hyjal. Każdy, kto zechce okraść bank, najpierw musi zmierzyć się z nami.",
        "f235aed2f821911f9557": "Własną krwią ręczę za bezpieczeństwo tego banku. Czy to ci wystarczy?",
        "zephras:54fef075e1b4e38f411e": "Chcę zajrzeć do swojej skrytki bankowej."
      },
      "name": "Karus",
      "translationMetadata": {
