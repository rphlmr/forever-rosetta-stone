    "trTR": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Evet? Sözümü kestin, umarım bunun için lanet olası iyi bir nedenin vardır.",
        "83714a21e1b0235dafe6": "Beni eğit.",
        "ce8013d2cc5809bf2314": "Buradaki yeniden inşaya yardım etmek için Ironforge'dan geldim. Yeterince kişiye becerilerimi öğretebilirsem belki işi size bırakıp eve dönebilirim."
      },
      "name": "Gelman Stonehand",
      "translationMetadata": {
