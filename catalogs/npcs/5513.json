    "hrHR": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Da? Prekidaš me, pa ti je bolje da za to imaš prokleto dobar razlog.",
        "83714a21e1b0235dafe6": "Podučite me.",
        "ce8013d2cc5809bf2314": "Došao sam iz Ironforgea pomoći pri obnovi. Ako dovoljno vas naučim svom zanatu, možda vam mogu prepustiti posao i vratiti se kući."
      },
      "name": "Gelman Stonehand",
      "translationMetadata": {
