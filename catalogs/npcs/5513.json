        }
      }
    },
    "daDK": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Ja? Du afbrød mig, så du må hellere have en forbandet god grund.",
        "83714a21e1b0235dafe6": "Træn mig.",
        "ce8013d2cc5809bf2314": "Jeg kom fra Ironforge for at hjælpe med genopbygningen her. Hvis jeg kan lære nok af jer mine færdigheder, kan jeg måske overlade det til jer og tage hjem igen."
      },
      "name": "Gelman Stonehand",
      "translationMetadata": {
        "fields": {
          "dialogue.6fb6e1605ff8894d6eeb": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
