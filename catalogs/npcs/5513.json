  "locales": {
    "csCZ": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "No? Vyrušuješ mě, tak k tomu koukej mít zatraceně dobrý důvod.",
        "83714a21e1b0235dafe6": "Vycvičte mě.",
        "ce8013d2cc5809bf2314": "Přišel jsem z Ironforge pomoct s místní obnovou. Když svým dovednostem naučím dost z vás, snad vám to budu moci přenechat a vrátit se domů."
      },
      "name": "Gelman Stonehand",
      "translationMetadata": {
        "fields": {
          "dialogue.6fb6e1605ff8894d6eeb": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
