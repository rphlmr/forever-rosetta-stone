    "plPL": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Tak? Przerywasz mi, więc lepiej miej ku temu cholernie dobry powód.",
        "83714a21e1b0235dafe6": "Wyszkol mnie.",
        "ce8013d2cc5809bf2314": "Przybyłem z Ironforge, by pomóc w odbudowie. Jeśli nauczę dość was mojego fachu, może będę mógł zostawić to wam i wrócić do domu."
      },
      "name": "Gelman Stonehand",
      "translationMetadata": {
