    "enUS": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Yeah? Ye interrupted me, so ye better have a blasted good reason to do so.",
        "83714a21e1b0235dafe6": "Train me.",
        "ce8013d2cc5809bf2314": "I came from Ironforge to help out with the rebuilding effort here. If I can teach enough of ye my skills then maybe I can leave it to ye and take myself back home."
      },
      "name": "Gelman Stonehand",
      "subName": "Mining Trainer",
      "translationMetadata": {
