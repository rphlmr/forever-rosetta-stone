    "svSE": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Ja? Du avbröt mig, så du bör ha en förbaskat bra anledning.",
        "83714a21e1b0235dafe6": "Träna mig.",
        "ce8013d2cc5809bf2314": "Jag kom från Ironforge för att hjälpa till med återuppbyggnaden här. Om jag lär tillräckligt många av er mitt hantverk kanske jag kan lämna över arbetet och återvända hem."
      },
      "name": "Gelman Stonehand",
