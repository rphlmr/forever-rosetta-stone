    "frFR": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Ouais ? J'espère pour vous qu'vous avez une bonne raison d'me déranger !",
        "83714a21e1b0235dafe6": "Entraînez-moi.",
        "ce8013d2cc5809bf2314": "Je suis d'Ironforge, volontaire pour participer à l'effort de reconstruction. Si je peux vous apprendre ce que je sais, peut-être que je pourrai vous demander de me relayer dans cette tâche et rentrer chez moi."
      },
      "name": "Gelman Stonehand",
      "subName": "Maître des mineurs",
