    "itIT": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Be'? M'hai interrotto, perciò vedi d'avere un motivo dannatamente buono.",
        "83714a21e1b0235dafe6": "Addestrami.",
        "ce8013d2cc5809bf2314": "Sono venuto da Ironforge per dare una mano alla ricostruzione. Se riesco a insegnare le mie arti a un bel po' di voi, magari potrò lasciare tutto in mano vostra e tornarmene a casa."
      },
      "name": "Gelman Stonehand",
