    "ltLT": {
      "dialogue": {
        "6fb6e1605ff8894d6eeb": "Na? Sutrukdei man, tad geriau turėk velniškai gerą priežastį.",
        "83714a21e1b0235dafe6": "Išmokyk mane.",
        "ce8013d2cc5809bf2314": "Atvykau iš Ironforge padėti čia viską atstatyti. Jei išmokysiu pakankamai jūsų savo amato, galėsiu palikti darbą jums ir grįžti namo."
      },
      "name": "Gelman Stonehand",
      "subName": "Kasybos mokytojas",
      "translationMetadata": {
