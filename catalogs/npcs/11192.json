    "enUS": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, a seasoned veteran you once were. Kilram can make you this again. I know you are capable, you merely need to ask and I shall teach you the way of the axesmith.",
        "c0e8929776efd80d78f7": "I am Kilram, master of the axe."
      },
      "name": "Kilram",
      "translationMetadata": {
        "fields": {
