    "esES": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, una vez fuiste un veterano. Kilram puede hacer que te conviertas en eso de nuevo. Sé que eres capaz, solo tienes que pedírmelo y te enseñaré a forjar hachas.",
        "c0e8929776efd80d78f7": "Soy Kilram, maestro del hacha."
      },
      "name": "Kilram",
