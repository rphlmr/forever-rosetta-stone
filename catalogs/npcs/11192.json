  "locales": {
    "csCZ": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ach, kdysi jsi byl zkušeným veteránem. Kilram ti může pomoci jím znovu být. Vím, že na to máš, stačí požádat a naučím tě umění kováře seker.",
        "c0e8929776efd80d78f7": "Jsem Kilram, mistr sekery."
      },
      "name": "Kilram",
      "translationMetadata": {
        "fields": {
