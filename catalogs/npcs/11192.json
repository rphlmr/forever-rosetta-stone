    "plPL": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ach, niegdyś był z ciebie doświadczony weteran. Kilram może sprawić, że znów nim będziesz. Wiem, że potrafisz, wystarczy poprosić, a nauczę cię sztuki płatnerza toporów.",
        "c0e8929776efd80d78f7": "Jestem Kilram, mistrz topora."
      },
      "name": "Kilram",
      "translationMetadata": {
        "fields": {
