    "svSE": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, en gång var du en erfaren veteran. Kilram kan göra dig till det igen. Jag vet att du klarar det; be bara så lär jag dig yxsmedens konst.",
        "c0e8929776efd80d78f7": "Jag är Kilram, yxans mästare."
      },
      "name": "Kilram",
