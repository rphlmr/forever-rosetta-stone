    "daDK": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, engang var du en erfaren veteran. Kilram kan gøre dig til det igen. Jeg ved, du kan klare det; du skal blot spørge, så lærer jeg dig øksesmedens vej.",
        "c0e8929776efd80d78f7": "Jeg er Kilram, øksens mester."
      },
      "name": "Kilram",
      "translationMetadata": {
        "fields": {
          "dialogue.b9faa5a4746688debe21": {
