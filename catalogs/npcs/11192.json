    "trTR": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, bir zamanlar tecrübeli bir gaziydin. Kilram seni yeniden öyle yapabilir. Bunu başarabileceğini biliyorum; tek yapman gereken istemek, sana balta demirciliğinin yolunu öğreteceğim.",
        "c0e8929776efd80d78f7": "Ben Kilram, baltanın ustasıyım."
      },
      "name": "Kilram",
      "translationMetadata": {
        "fields": {
          "dialogue.b9faa5a4746688debe21": {
