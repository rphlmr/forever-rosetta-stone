    "hrHR": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, nekoć si bio iskusan veteran. Kilram ti može pomoći da to opet postaneš. Znam da možeš, samo zamoli i naučit ću te umijeću kovanja sjekira.",
        "c0e8929776efd80d78f7": "Ja sam Kilram, majstor sjekire."
      },
      "name": "Kilram",
      "translationMetadata": {
