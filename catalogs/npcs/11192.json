    "ptBR": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah! Um experiente veterano, você foi outrora. Sei que você é capaz, é só pedir que eu lhe ensinarei o caminho da forja de machados.",
        "c0e8929776efd80d78f7": "Eu sou Kilram, mestre do machado."
      },
      "name": "Kilram",
