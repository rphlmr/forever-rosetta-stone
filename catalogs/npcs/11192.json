    "itIT": {
      "dialogue": {
        "b9faa5a4746688debe21": "Ah, un tempo eri un veterano esperto. Kilram può farti tornare tale. So che ne sei capace: devi solo chiedere e ti insegnerò la via del fabbro d’asce.",
        "c0e8929776efd80d78f7": "Sono Kilram, maestro dell'ascia."
      },
      "name": "Kilram",
