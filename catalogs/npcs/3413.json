    "daDK": {
      "dialogue": {
        "1a0a4bdd2353612cd2d5": "Jeg vil gerne se dine varer.",
        "7c46b720dc06a8b04175": "Hej, $n! Hvis du ikke ser det i min butik, kan jeg sikkert skaffe det!",
        "zephras:60d6e58b60eb5b1db68b": "Hej Sovik, jeg vil gerne se på dine varer.",
        "zephras:84b6e2d63abcee9f7cdd": "Hvad har du ellers at sige?"
      },
      "name": "Sovik",
      "translationMetadata": {
