    "enUS": {
      "dialogue": {
        "1a0a4bdd2353612cd2d5": "I want to browse your goods.",
        "7c46b720dc06a8b04175": "Hello, $n! If you don't see it in my shop, chances are good I can get it!",
        "zephras:60d6e58b60eb5b1db68b": "Hello Sovik, I wish to browse your goods.",
        "zephras:84b6e2d63abcee9f7cdd": "What else do you have to say?"
