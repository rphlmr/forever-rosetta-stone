  "locales": {
    "csCZ": {
      "dialogue": {
        "1a0a4bdd2353612cd2d5": "Chci si prohlédnout vaše zboží.",
        "7c46b720dc06a8b04175": "Zdravím, $n! Pokud to v mém obchodě nevidíš, nejspíš to dokážu sehnat!",
        "zephras:60d6e58b60eb5b1db68b": "Zdravím, Soviku, rád bych si prohlédl tvé zboží.",
        "zephras:84b6e2d63abcee9f7cdd": "Co dalšího mi chceš říct?"
      },
      "name": "Sovik",
      "translationMetadata": {
