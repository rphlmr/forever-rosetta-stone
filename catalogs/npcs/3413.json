        "zephras:60d6e58b60eb5b1db68b": "Hallo, Sovik. Ich sehe mich nur mal um.",
        "zephras:84b6e2d63abcee9f7cdd": "Habt Ihr sonst noch etwas zu sagen?"
      },
      "name": "Sovik",
      "subName": "Ingenieursbedarf",
