  "locales": {
    "csCZ": {
      "dialogue": {
        "17853a2797edc8ed7180": "Svět je zavázán tobě a tvým spojencům, $n.",
        "df4f1a8c918f11488e76": "Jsem svědkem zázraku, který stojí přede mnou! Za tisíc let zajetí jsem neviděl do těchto komnat vstoupit jediného ŽIVÉHO tvora kromě těch odporných qirajiů a silithidů."
      },
      "name": "Arygos",
      "translationMetadata": {
        "fields": {
