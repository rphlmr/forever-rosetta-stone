    "trTR": {
      "dialogue": {
        "17853a2797edc8ed7180": "Dünya sana ve müttefiklerine minnettar, $n.",
        "df4f1a8c918f11488e76": "Karşımda duran bir mucizeye tanıklık ediyorum! Bin yıllık esaretimde, o iğrenç Qirajiler ve silithidler dışında bu odalara giren tek bir CANLI görmedim."
      },
      "name": "Arygos",
