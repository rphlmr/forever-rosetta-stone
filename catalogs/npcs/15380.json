    "enUS": {
      "dialogue": {
        "17853a2797edc8ed7180": "The world is indebted to you and your allies, $n.",
        "df4f1a8c918f11488e76": "I bear witness to a miracle that stands before me! In one thousand years of captivity, I have not seen a single LIVING specimen - other than those foul Qiraji and silithid - enter these chambers."
      },
      "name": "Arygos",
      "translationMetadata": {
        "fields": {
