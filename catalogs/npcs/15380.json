    },
    "daDK": {
      "dialogue": {
        "17853a2797edc8ed7180": "Verden står i gæld til dig og dine allierede, $n.",
        "df4f1a8c918f11488e76": "Jeg er vidne til et mirakel, der står foran mig! I tusind års fangenskab har jeg ikke set et eneste LEVENDE væsen, bortset fra de modbydelige qirajier og silithider, træde ind i disse kamre."
      },
      "name": "Arygos",
      "translationMetadata": {
        "fields": {
          "dialogue.17853a2797edc8ed7180": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
