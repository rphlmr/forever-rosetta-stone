    "enUS": {
      "dialogue": {
        "3961e20973607ffaa6ae": "I want to browse your goods.",
        "701a41aa6269a0d4c3c3": "Train me.",
        "e2fb073d54714b5eebbb": "A foul corruption has crept into Westfall.  While I was upholding my duty on the battlefields of Lordaeron these honest farms were overrun and made into hide-outs for thugs and murderers. The People's Militia needs your help."
      },
      "name": "Gryan Stoutmantle",
      "subName": "The People's Militia",
