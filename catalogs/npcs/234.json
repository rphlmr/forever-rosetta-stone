    "esES": {
      "dialogue": {
        "3961e20973607ffaa6ae": "Quiero ver tus mercancías.",
        "701a41aa6269a0d4c3c3": "Entréname.",
        "e2fb073d54714b5eebbb": "Una asquerosa corrupción se ha colado en Westfall.  Mientras yo cumplía con mi deber en los campos de batalla de Lordaeron, estas granjas honradas fueron invadidas y convertidas en escondites de matones y asesinos. La Milicia Popular necesita tu ayuda."
      },
      "name": "Gryan Mantorrecio",
      "subName": "La Milicia Popular",
