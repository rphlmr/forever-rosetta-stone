    "hrHR": {
      "dialogue": {
        "3961e20973607ffaa6ae": "Želim pogledati vašu robu.",
        "701a41aa6269a0d4c3c3": "Podučite me.",
        "e2fb073d54714b5eebbb": "Opaka pokvarenost uvukla se u Westfall. Dok sam izvršavao dužnost na bojištima Lordaerona, ova poštena imanja bila su pregažena i pretvorena u skrovišta nasilnika i ubojica. Narodnoj miliciji treba tvoja pomoć."
      },
      "name": "Gryan Stoutmantle",
