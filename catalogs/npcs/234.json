    "ltLT": {
      "dialogue": {
        "3961e20973607ffaa6ae": "Noriu apžiūrėti jūsų prekes.",
        "701a41aa6269a0d4c3c3": "Išmokyk mane.",
        "e2fb073d54714b5eebbb": "Į Westfall įsiskverbė bjaurus blogis. Kol vykdžiau savo pareigą Lordaeron mūšio laukuose, šiuos dorų žmonių ūkius užplūdo galvažudžiai ir žudikai, pavertę juos savo slėptuvėmis. Liaudies milicijai reikia tavo pagalbos."
      },
      "name": "Gryan Stoutmantle",
      "subName": "Liaudies milicija",
