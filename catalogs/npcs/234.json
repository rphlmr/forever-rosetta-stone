    "plPL": {
      "dialogue": {
        "3961e20973607ffaa6ae": "Chcę przejrzeć twoje towary.",
        "701a41aa6269a0d4c3c3": "Wyszkol mnie.",
        "e2fb073d54714b5eebbb": "Podła zgnilizna wkradła się do Westfall. Gdy wypełniałem swój obowiązek na polach bitew Lordaeronu, te uczciwe gospodarstwa zostały najechane i zamienione w kryjówki zbirów i morderców. Milicja Ludowa potrzebuje twojej pomocy."
      },
      "name": "Gryan Stoutmantle",
