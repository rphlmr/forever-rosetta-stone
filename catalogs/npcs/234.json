  "locales": {
    "csCZ": {
      "dialogue": {
        "3961e20973607ffaa6ae": "Rád bych si prohlédl vaše zboží.",
        "701a41aa6269a0d4c3c3": "Vycvičte mě.",
        "e2fb073d54714b5eebbb": "Do Westfallu se vkradla odporná zkaženost. Zatímco jsem plnil své povinnosti na bojištích Lordaeronu, tyto poctivé statky byly přepadeny a proměněny v úkryty násilníků a vrahů. Lidové milice potřebují tvou pomoc."
      },
      "name": "Gryan Stoutmantle",
      "translationMetadata": {
        "fields": {
          "dialogue.3961e20973607ffaa6ae": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
