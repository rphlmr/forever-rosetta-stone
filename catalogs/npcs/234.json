    },
    "daDK": {
      "dialogue": {
        "3961e20973607ffaa6ae": "Jeg vil gerne se dine varer.",
        "701a41aa6269a0d4c3c3": "Træn mig.",
        "e2fb073d54714b5eebbb": "En ond fordærvelse har sneget sig ind i Westfall. Mens jeg gjorde min pligt på Lordaerons slagmarker, blev disse hæderlige gårde overrendt og gjort til skjulesteder for bøller og mordere. Folkets Milits har brug for din hjælp."
      },
      "name": "Gryan Stoutmantle",
      "translationMetadata": {
        "fields": {
          "dialogue.3961e20973607ffaa6ae": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
