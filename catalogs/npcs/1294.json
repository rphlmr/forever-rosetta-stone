    "hrHR": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "Najbolje ponude u cijelom Stormwindu, prijatelju, bolje nećeš naći. Kako ti mogu pomoći?",
        "aeb32b2f9a1878688892": "Želim pogledati vašu robu.",
        "cb3eeb886935a4367b9d": "Samo razgledavaš moju robu ili ti mogu pomoći pronaći nešto posebno?"
