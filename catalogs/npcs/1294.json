    "deDE": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "Die besten Preise in ganz Stormwind, was Besseres werdet Ihr nicht finden. Womit kann ich Euch denn nun dienen?",
        "aeb32b2f9a1878688892": "Ich möchte Eure Waren ansehen.",
        "cb3eeb886935a4367b9d": "Seht Ihr Euch nur um oder kann ich Euch irgendwie helfen?"
      },
      "name": "Aldric Moore",
      "subName": "Panzerrüstungshändler",
