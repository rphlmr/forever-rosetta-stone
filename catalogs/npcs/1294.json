    "svSE": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "Bästa priserna i hela Stormwind, min vän. Du hittar inga bättre. Vad kan jag hjälpa dig med?",
        "aeb32b2f9a1878688892": "Jag vill se dina varor.",
        "cb3eeb886935a4367b9d": "Tittar du bara på mina varor eller kan jag hjälpa dig att hitta något särskilt i dag?"
