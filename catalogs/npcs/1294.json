    "plPL": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "Najlepsze oferty w całym Stormwind, przyjacielu, lepszych nie znajdziesz. W czym mogę pomóc?",
        "aeb32b2f9a1878688892": "Chcę przejrzeć twoje towary.",
        "cb3eeb886935a4367b9d": "Tylko oglądasz moje towary, czy mogę pomóc ci znaleźć coś konkretnego?"
