    "daDK": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe dig med?",
        "aeb32b2f9a1878688892": "Jeg vil gerne se dine varer.",
        "cb3eeb886935a4367b9d": "Ser du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?"
      },
      "name": "Aldric Moore",
      "translationMetadata": {
