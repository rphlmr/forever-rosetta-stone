    "csCZ": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?",
        "aeb32b2f9a1878688892": "Rád bych si prohlédl vaše zboží.",
        "cb3eeb886935a4367b9d": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?"
      },
      "name": "Aldric Moore",
      "translationMetadata": {
