    "enUS": {
      "dialogue": {
        "4922fd1fbf1124bc25e5": "Best deals in all of Stormwind my friend, won't find any better. Now, what can I help you with?",
        "aeb32b2f9a1878688892": "I want to browse your goods.",
        "cb3eeb886935a4367b9d": "Just browsing my wares or is there something specific I can help you find today?"
      },
      "name": "Aldric Moore",
      "subName": "Mail Armor Merchant",
