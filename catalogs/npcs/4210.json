  "locales": {
    "csCZ": {
      "dialogue": {
        "387b62440fd25750dc10": "Vyhledej Shandrinu v Silverwind Refuge. Může ti prodat „Expert Cookbook“.",
        "4362cfc2213e3b0183c5": "Vycvičte mě.",
        "adb5f73b2351f81395ea": "Mohu tě naučit vařit!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Pokud se chceš zlepšit, musíš ho vyhledat.",
        "f4dda9e4961bc0818d42": "Vaření je celoživotní poslání a vidím, že nás spojuje stejná vášeň!"
      },
      "name": "Alegorn",
      "translationMetadata": {
