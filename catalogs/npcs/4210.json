    "hrHR": {
      "dialogue": {
        "387b62440fd25750dc10": "Potraži Shandrinu u Silverwind Refugeu. Ona ti može prodati „Expert Cookbook“.",
        "4362cfc2213e3b0183c5": "Podučite me.",
        "adb5f73b2351f81395ea": "Mogu te naučiti kuhati!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Ako želiš napredovati, moraš ga potražiti.",
        "f4dda9e4961bc0818d42": "Kuhanje je cjeloživotni poziv i vidim da dijelimo istu strast!"
      },
      "name": "Alegorn",
