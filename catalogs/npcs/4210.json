    "ltLT": {
      "dialogue": {
        "387b62440fd25750dc10": "Susirask Shandrina Silverwind Refuge.  Ji gali tau parduoti „Expert Cookbook“.",
        "4362cfc2213e3b0183c5": "Išmokyk mane.",
        "adb5f73b2351f81395ea": "Galiu išmokyti tave gaminti maistą!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meno meistras.  Jei nori tobulėti, turi jį susirasti.",
        "f4dda9e4961bc0818d42": "Maisto gaminimas yra viso gyvenimo užsiėmimas, ir matau, kad mus sieja ta pati aistra!"
      },
      "name": "Alegorn",
      "subName": "Maisto gaminimo mokytojas",
