    "esES": {
      "dialogue": {
        "387b62440fd25750dc10": "Busca a Shandrina en el Refugio Brisa de Plata. Te puede vender el \"Recetario para expertos\".",
        "4362cfc2213e3b0183c5": "Entréname.",
        "adb5f73b2351f81395ea": "Puedo enseñarte a cocinar.",
        "e033e4dd6d2446a97a13": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "f4dda9e4961bc0818d42": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión."
      },
      "name": "Alegorn",
      "subName": "Instructor de cocina",
