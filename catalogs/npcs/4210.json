    "itIT": {
      "dialogue": {
        "387b62440fd25750dc10": "Cerca Shandrina al Rifugio di Silverwind. Può venderti il \"Ricettario per Esperti\".",
        "4362cfc2213e3b0183c5": "Addestrami.",
        "adb5f73b2351f81395ea": "Posso insegnarti a cucinare!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "f4dda9e4961bc0818d42": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!"
      },
      "name": "Alegorn",
