    "daDK": {
      "dialogue": {
        "387b62440fd25750dc10": "Find Shandrina i Silverwind Refuge. Hun kan sælge dig “Expert Cookbook”.",
        "4362cfc2213e3b0183c5": "Træn mig.",
        "adb5f73b2351f81395ea": "Jeg kan lære dig at lave mad!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunst. Hvis du vil blive bedre, må du opsøge ham.",
        "f4dda9e4961bc0818d42": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme passion!"
      },
      "name": "Alegorn",
      "translationMetadata": {
