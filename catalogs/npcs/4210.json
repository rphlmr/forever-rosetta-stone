    "deDE": {
      "dialogue": {
        "387b62440fd25750dc10": "Sucht nach Shandrina in der Silberwindzuflucht. Sie kann Euch das \"Expertenkochbuch\" verkaufen.",
        "4362cfc2213e3b0183c5": "Bildet mich aus.",
        "adb5f73b2351f81395ea": "Ich kann Euch das Kochen beibringen!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen.",
        "f4dda9e4961bc0818d42": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!"
      },
      "name": "Alegorn",
      "subName": "Kochkunstlehrer",
