    "ptBR": {
      "dialogue": {
        "387b62440fd25750dc10": "Encontre Shandrina no Refúgio Brisaprata. Ela pode lhe vender o \"Livro de Receitas do Perito\".",
        "4362cfc2213e3b0183c5": "Treine-me.",
        "adb5f73b2351f81395ea": "Eu posso ensinar você a cozinhar!",
        "e033e4dd6d2446a97a13": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "f4dda9e4961bc0818d42": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!"
      },
      "name": "Alegorn",
      "subName": "Treinamento de Culinária",
