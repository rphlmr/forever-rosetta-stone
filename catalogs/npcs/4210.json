    "plPL": {
      "dialogue": {
        "387b62440fd25750dc10": "Odszukaj Shandrinę w Silverwind Refuge. Może ci sprzedać „Expert Cookbook”.",
        "4362cfc2213e3b0183c5": "Wyszkol mnie.",
        "adb5f73b2351f81395ea": "Mogę nauczyć cię gotować!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odszukać.",
        "f4dda9e4961bc0818d42": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!"
      },
      "name": "Alegorn",
