    "frFR": {
      "dialogue": {
        "387b62440fd25750dc10": "Allez voir Shandrina au refuge de Vent-argent. Elle pourra vous vendre un livre de cuisine pour experts.",
        "4362cfc2213e3b0183c5": "Entraînez-moi.",
        "adb5f73b2351f81395ea": "Je peux vous apprendre à cuisiner !",
        "e033e4dd6d2446a97a13": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "f4dda9e4961bc0818d42": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !"
      },
      "name": "Alegorn",
      "subName": "Maître des cuisiniers",
