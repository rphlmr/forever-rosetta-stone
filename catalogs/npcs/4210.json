    "enUS": {
      "dialogue": {
        "387b62440fd25750dc10": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\".",
        "4362cfc2213e3b0183c5": "Train me.",
        "adb5f73b2351f81395ea": "I can teach you how to cook!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "f4dda9e4961bc0818d42": "Cooking is a life long pursuit and I see we share the same passion!"
      },
      "name": "Alegorn",
      "subName": "Cooking Trainer",
