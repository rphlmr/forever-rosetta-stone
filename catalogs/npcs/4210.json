    "trTR": {
      "dialogue": {
        "387b62440fd25750dc10": "Silverwind Refuge’ta Shandrina’yı bul. Sana “Expert Cookbook” satabilir.",
        "4362cfc2213e3b0183c5": "Beni eğit.",
        "adb5f73b2351f81395ea": "Sana yemek yapmayı öğretebilirim!",
        "e033e4dd6d2446a97a13": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarında ustadır. Kendini geliştirmek için onu bulmalısın.",
        "f4dda9e4961bc0818d42": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!"
