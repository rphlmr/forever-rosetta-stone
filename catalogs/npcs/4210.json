    "svSE": {
      "dialogue": {
        "387b62440fd25750dc10": "Sök upp Shandrina i Silverwind Refuge. Hon kan sälja dig “Expert Cookbook”.",
        "4362cfc2213e3b0183c5": "Träna mig.",
        "adb5f73b2351f81395ea": "Jag kan lära dig laga mat!",
        "e033e4dd6d2446a97a13": "Dirge Quikcleave från Gadgetzan är en mästare i kokkonsten. För att bli bättre måste du söka upp honom.",
        "f4dda9e4961bc0818d42": "Matlagning är en livslång syssla och jag ser att vi delar samma passion!"
      },
