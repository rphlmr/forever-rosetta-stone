    "daDK": {
      "dialogue": {
        "845af0c73c7e365ea944": "Du er nået ud over mit ekspertiseniveau. Georgio Bolero, mesteren hos Duncan’s Textiles om hjørnet, kan hjælpe dig med at udvikle dine færdigheder.",
        "ae941797ec2125906360": "Goddag til dig.",
        "c19e9eb2e642016325b1": "En flot demonstration af din værdighed. Din undervisning kan nu fortsætte.",
        "c1b1cca5e4d6f68ed75a": "Tal med Lawrence Shneider hos Duncan’s Textiles rundt om hjørnet til venstre. Han er dygtig til at hjælpe begyndere.",
        "ef6dd4b28e25daa42c03": "Træn mig."
      },
      "name": "Sellandus",
