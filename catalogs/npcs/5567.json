    "plPL": {
      "dialogue": {
        "845af0c73c7e365ea944": "Przewyższasz już moje umiejętności. Georgio Bolero, mistrz w Duncan’s Textiles za rogiem, pomoże ci dalej się rozwijać.",
        "ae941797ec2125906360": "Dzień dobry.",
        "c19e9eb2e642016325b1": "Pięknie dowiodłeś swojej wartości. Twoja nauka może teraz trwać dalej.",
        "c1b1cca5e4d6f68ed75a": "Porozmawiaj z Lawrencem Shneiderem w Duncan’s Textiles za rogiem po lewej. Dobrze radzi sobie z początkującymi.",
        "ef6dd4b28e25daa42c03": "Wyszkol mnie."
      },
      "name": "Sellandus",
