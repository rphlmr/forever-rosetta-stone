  "locales": {
    "csCZ": {
      "dialogue": {
        "845af0c73c7e365ea944": "Přerostl jsi mé odborné znalosti. Georgio Bolero, mistr v Duncanových textiliích za rohem, ti může pomoci rozvíjet dovednosti.",
        "ae941797ec2125906360": "Přeji ti dobrý den.",
        "c19e9eb2e642016325b1": "Pěkně jsi prokázal svou způsobilost. Tvůj výcvik může pokračovat.",
        "c1b1cca5e4d6f68ed75a": "Promluv si s Lawrencem Shneiderem v Duncanových textiliích za rohem vlevo. Umí dobře pracovat se začátečníky.",
        "ef6dd4b28e25daa42c03": "Vycvičte mě."
      },
      "name": "Sellandus",
      "translationMetadata": {
        "fields": {
