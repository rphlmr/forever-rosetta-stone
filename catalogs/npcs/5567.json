    "esES": {
      "dialogue": {
        "845af0c73c7e365ea944": "Superas mi nivel de experiencia. Georgio Bolero, el maestro de Tejidos Duncan, al doblar la esquina, podría ayudarte a progresar en tus habilidades.",
        "ae941797ec2125906360": "Que tengas un buen día.",
        "c19e9eb2e642016325b1": "Una buena demostración. Tu instrucción puede continuar.",
        "c1b1cca5e4d6f68ed75a": "Habla con Lawrence Shneider en Textiles Duncan, a la vuelta de la esquina a la izquierda. Es hábil para tratar con principiantes.",
        "ef6dd4b28e25daa42c03": "Entréname."
      },
      "name": "Sellandus",
      "subName": "Experto sastre",
