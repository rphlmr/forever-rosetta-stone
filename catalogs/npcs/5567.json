    "trTR": {
      "dialogue": {
        "845af0c73c7e365ea944": "Bilgi düzeyimi aştın. Köşedeki Duncan’s Textilesın ustası Georgio Bolero becerilerini geliştirmene yardımcı olabilir.",
        "ae941797ec2125906360": "İyi günler.",
        "c19e9eb2e642016325b1": "Değerini güzelce gösterdin. Eğitimin artık devam edebilir.",
        "c1b1cca5e4d6f68ed75a": "Sol köşedeki Duncan’s Textilesta Lawrence Shneider ile konuş. Yeni başlayanlara yardımcı olmakta ustadır.",
        "ef6dd4b28e25daa42c03": "Beni eğit."
      },
      "name": "Sellandus",
