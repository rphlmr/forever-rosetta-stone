    "deDE": {
      "dialogue": {
        "845af0c73c7e365ea944": "Ihr seid meinem Kenntnisstand weit überlegen. Vielleicht kann Euch Georgio Bolero, der Meister von Duncans Textilien um die Ecke, beim Verbessern Eurer Fertigkeiten helfen.",
        "ae941797ec2125906360": "Schönen guten Tag.",
        "c19e9eb2e642016325b1": "Ihr habt Euren Wert wohl gezeigt. Eure Unterweisung kann nun fortgesetzt werden.",
        "c1b1cca5e4d6f68ed75a": "Sprecht mit Lawrence Shneider bei Duncans Textilien, links um die Ecke. Er ist bewandert im Umgang mit Anfängern.",
        "ef6dd4b28e25daa42c03": "Bildet mich aus."
      },
      "name": "Sellandus",
      "subName": "Schneiderexperte",
