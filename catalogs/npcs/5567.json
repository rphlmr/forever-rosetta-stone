    "svSE": {
      "dialogue": {
        "845af0c73c7e365ea944": "Du har passerat min kunskapsnivå. Georgio Bolero, mästaren på Duncan’s Textiles runt hörnet, kan hjälpa dig att utveckla dina färdigheter.",
        "ae941797ec2125906360": "God dag på dig.",
        "c19e9eb2e642016325b1": "Ett fint bevis på din värdighet. Din undervisning kan nu fortsätta.",
        "c1b1cca5e4d6f68ed75a": "Tala med Lawrence Shneider på Duncan’s Textiles runt hörnet till vänster. Han är skicklig på att hjälpa nybörjare.",
        "ef6dd4b28e25daa42c03": "Träna mig."
      },
      "name": "Sellandus",
