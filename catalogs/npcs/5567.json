    "hrHR": {
      "dialogue": {
        "845af0c73c7e365ea944": "Nadmašio si moju razinu stručnosti. Georgio Bolero, majstor u Duncanovoj tekstilnoj trgovini iza ugla, može ti pomoći unaprijediti vještine.",
        "ae941797ec2125906360": "Dobar ti dan.",
        "c19e9eb2e642016325b1": "Lijepo si pokazao svoju vrijednost. Tvoja se poduka sada može nastaviti.",
        "c1b1cca5e4d6f68ed75a": "Razgovaraj s Lawrenceom Shneiderom u Duncanovoj tekstilnoj trgovini iza ugla lijevo. On se dobro snalazi s početnicima.",
        "ef6dd4b28e25daa42c03": "Podučite me."
      },
      "name": "Sellandus",
