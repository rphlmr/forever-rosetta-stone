  "locales": {
    "csCZ": {
      "dialogue": {
        "10599663b640cc066696": "Přísným přeškolením jsem musela mnohé studenty odnaučit všemu, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Chceš, abych tě odnaučila talentům, které ses naučil?",
        "43be7944e68b0d8bdf7a": "Vítej, $c. Chceš poradit? Spřátel se s mágem! Máme v rukávu pár triků...",
        "4a1059eb44fd642b7aba": "Mám zájem o výcvik mága.",
        "e1cbfa40f1a72eceb020": "Mám zájem o výcvik mága.",
        "fb72abab4d7100c5121f": "Zdravím. Jsem gnómská trenérka mágů a ty jsi mág."
      },
      "name": "Juli Stormkettle",
      "translationMetadata": {
        "fields": {
