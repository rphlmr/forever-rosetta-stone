    "hrHR": {
      "dialogue": {
        "10599663b640cc066696": "Strogom prekvalifikacijom morala sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla učiti iznova. Ta je usluga sve teža svaki put kad je pružim, pa je zato svaka prekvalifikacija sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "43be7944e68b0d8bdf7a": "Pozdrav, $c. Želiš savjet? Sprijatelji se s magom! Imamo mi nekoliko trikova u rukavu...",
        "4a1059eb44fd642b7aba": "Zanima me obuka za maga.",
        "e1cbfa40f1a72eceb020": "Zanima me obuka za maga.",
        "fb72abab4d7100c5121f": "Pozdrav. Ja sam gnomska učiteljica magova, a ti si mag."
      },
      "name": "Juli Stormkettle",
      "translationMetadata": {
