    "daDK": {
      "dialogue": {
        "10599663b640cc066696": "Gennem grundig omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere ved hver omskoling. Ønsker du, at jeg aflærer dig de talenter, du har lært?",
        "43be7944e68b0d8bdf7a": "Godt mødt, $c. Vil du have et råd? Bliv ven med en magiker! Vi har et par tricks i ærmet...",
        "4a1059eb44fd642b7aba": "Jeg er interesseret i magikertræning.",
        "e1cbfa40f1a72eceb020": "Jeg er interesseret i magikertræning.",
        "fb72abab4d7100c5121f": "Hilsner. Jeg er gnomisk magikertræner, og du er magiker."
      },
      "name": "Juli Stormkettle",
      "translationMetadata": {
