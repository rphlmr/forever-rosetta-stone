    "csCZ": {
      "dialogue": {
        "593b13385eb63477ff82": "Moc stahovačů kůže sem za výcvikem nechodí, ale pokud jsi připraven, mohla bych tě něco naučit.",
        "c41c6466ef143805cdf1": "Vycvičte mě."
