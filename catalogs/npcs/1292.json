    "hrHR": {
      "dialogue": {
        "593b13385eb63477ff82": "Ne dolazi mi mnogo guljača kože na obuku, ali mislim da te mogu nečemu naučiti ako si spreman.",
        "c41c6466ef143805cdf1": "Podučite me."
