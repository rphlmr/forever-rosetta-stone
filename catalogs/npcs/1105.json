    "csCZ": {
      "dialogue": {
        "73d21db772c498116151": "Vycvičte mě.",
        "9d02ebd5ee8c84255bdf": "Rád bych si prohlédl vaše zboží.",
        "e0f015443f965b21977a": "Víš, vždycky jsem chtěl být prospektorem, ale narodil jsem se s nadáním pro čísla a cech rozhodl, že se nejlépe hodím k vedení účetních knih! Učení, učení, každý den mého mládí..."
      },
      "name": "Jern Hornhelm",
      "translationMetadata": {
