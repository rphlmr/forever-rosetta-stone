    "deDE": {
      "dialogue": {
        "73d21db772c498116151": "Bildet mich aus.",
        "9d02ebd5ee8c84255bdf": "Ich möchte Eure Waren ansehen.",
        "e0f015443f965b21977a": "Wissen Sie, ich wollte immer Goldsucher werden, aber ich wurde mit einem Kopf für Zahlen geboren, und die Gilde entschied, dass ich am besten geeignet wäre, die Bücher zu führen! Studieren, studieren, jeden Tag meiner Jugend..."
      },
      "name": "Jern Hornhelm",
      "subName": "Forscherliga",
