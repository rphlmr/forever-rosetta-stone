    "ltLT": {
      "dialogue": {
        "73d21db772c498116151": "Išmokyk mane.",
        "9d02ebd5ee8c84255bdf": "Noriu apžiūrėti tavo prekes.",
        "e0f015443f965b21977a": "Žinai, visada norėjau būti žvalgytoju, bet gimiau su gabumais skaičiams, todėl Lyga nusprendė, kad man geriausia tvarkyti apskaitą! Mokslai, mokslai, kasdien per visą mano jaunystę..."
      },
