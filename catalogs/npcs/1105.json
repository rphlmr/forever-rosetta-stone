    "enUS": {
      "dialogue": {
        "73d21db772c498116151": "Train me.",
        "9d02ebd5ee8c84255bdf": "I want to browse your goods.",
        "e0f015443f965b21977a": "You know, I always wanted to be a Prospector, but I was born with a head for numbers and the Guild decided I would be best suited to keep the books! Studying, studying, every day of my youth..."
      },
