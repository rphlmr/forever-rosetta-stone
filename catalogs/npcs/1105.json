    "daDK": {
      "dialogue": {
        "73d21db772c498116151": "Træn mig.",
        "9d02ebd5ee8c84255bdf": "Jeg vil gerne se dine varer.",
        "e0f015443f965b21977a": "Du ved, jeg ville altid være prospektør, men jeg blev født med sans for tal, og lauget besluttede, at jeg var bedst egnet til at føre regnskaber! Studier, studier, hver dag i min ungdom..."
      },
      "name": "Jern Hornhelm",
      "translationMetadata": {
