    "enUS": {
      "dialogue": {
        "6e2c4796aff391416267": "I hope that you're here to help us take back Arathi Basin from The Defilers.  What do you say $n?",
        "e004b4f7717f288842e3": "I am sorry $c, but you need to be more powerful before I can allow you to enter Arathi Basin."
      },
      "name": "Keras Wolfheart",
      "subName": "Arathi Basin Battlemaster",
