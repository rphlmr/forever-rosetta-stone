    "daDK": {
      "dialogue": {
        "6e2c4796aff391416267": "Jeg håber, du er her for at hjælpe os med at tage Arathi Basin tilbage fra Defilers. Hvad siger du, $n?",
        "e004b4f7717f288842e3": "Beklager, $c, men du skal være stærkere, før jeg kan lade dig komme ind i Arathi Basin."
      },
      "name": "Keras Wolfheart",
      "translationMetadata": {
