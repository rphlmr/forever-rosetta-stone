    "csCZ": {
      "dialogue": {
        "6e2c4796aff391416267": "Doufám, že nám pomůžeš získat Arathskou pánev zpět od Defilerů. Co ty na to, $n?",
        "e004b4f7717f288842e3": "Promiň, $c, ale než tě pustím do Arathské pánve, musíš být silnější."
      },
      "name": "Keras Wolfheart",
