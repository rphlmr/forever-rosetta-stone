    "daDK": {
      "dialogue": {
        "0999338afb8e52bf48af": "Magi fordærver kun de svage. Fortsæt din træning, ellers kan samme skæbne ramme dig.",
        "2c8f9a7789f413d4125a": "Jeg er interesseret i træning som troldmand.",
        "2e5e36da218e1bb2f1dd": "Jeg er interesseret i træning som troldmand.",
        "719d03c9cd6b4b1e5e8b": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "db9d881aa9b431316ab1": "Mørket omfavner dig ikke, $c. Hold op med at plapre, og forsvind fra mit åsyn! Af sted!"
      },
      "name": "Maximillian Crowe",
      "translationMetadata": {
