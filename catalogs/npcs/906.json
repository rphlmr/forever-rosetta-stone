    "enUS": {
      "dialogue": {
        "0999338afb8e52bf48af": "The arcane only corrupts those who are weak. Keep up on your training, or you may find a similar fate.",
        "2c8f9a7789f413d4125a": "I am interested in warlock training.",
        "2e5e36da218e1bb2f1dd": "I am interested in warlock training.",
        "719d03c9cd6b4b1e5e8b": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "db9d881aa9b431316ab1": "The darkness does not embrace you, $c.  Cease your prattle and remove yourself from my sight!  Be gone!"
      },
      "name": "Maximillian Crowe",
      "subName": "Warlock Trainer",
      "translationMetadata": {
