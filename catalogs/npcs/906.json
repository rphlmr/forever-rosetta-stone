    "plPL": {
      "dialogue": {
        "0999338afb8e52bf48af": "Magia tajemna deprawuje jedynie słabych. Kontynuuj trening, bo inaczej może spotkać cię podobny los.",
        "2c8f9a7789f413d4125a": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "2e5e36da218e1bb2f1dd": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "719d03c9cd6b4b1e5e8b": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "db9d881aa9b431316ab1": "Ciemność cię nie obejmuje, $c. Skończ tę paplaninę i zejdź mi z oczu! Precz!"
      },
      "name": "Maximillian Crowe",
