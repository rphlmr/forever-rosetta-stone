  "locales": {
    "csCZ": {
      "dialogue": {
        "0999338afb8e52bf48af": "Magie kazí jen slabé. Pokračuj ve výcviku, jinak tě může potkat stejný osud.",
        "2c8f9a7789f413d4125a": "Mám zájem o výcvik v umění černokněžníků.",
        "2e5e36da218e1bb2f1dd": "Mám zájem o výcvik v umění černokněžníků.",
        "719d03c9cd6b4b1e5e8b": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "db9d881aa9b431316ab1": "Temnota tě nepřijímá, $c. Přestaň žvanit a zmiz mi z očí! Pryč!"
      },
      "name": "Maximillian Crowe",
      "translationMetadata": {
        "fields": {
