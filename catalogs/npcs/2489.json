    "hrHR": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Molim te, poduči me.",
        "3efc6becd40c0764a9a9": "Kao mag pripadaš odabranoj skupini koja može prizvati portal natrag na ovo mjesto. Mogu te poučiti ako si spreman.",
        "7193fd54ead5f75a57a6": "Ne vjerujem da imaš dovoljno oštar um da shvatiš prirodu portalske magije."
      },
      "name": "Milstaff Stormeye",
      "translationMetadata": {
