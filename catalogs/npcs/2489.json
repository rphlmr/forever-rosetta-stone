    "ptBR": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Por favor, ensine-me.",
        "3efc6becd40c0764a9a9": "Como um mago, você pertence ao seleto grupo que consegue conjurar um portal que lhe transportará de volta a este mesmo local. Posso lhe ensinar como, se você estiver pronto.",
        "7193fd54ead5f75a57a6": "Creio que você não possua a acuidade mental para compreender os mistérios da magia dos portais."
      },
      "name": "Milstaff Intempestivus",
      "subName": "Treinamento de Portais",
