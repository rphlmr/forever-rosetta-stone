            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Bitte unterrichtet mich.",
        "3efc6becd40c0764a9a9": "Als Magier gehört Ihr zu einer auserwählten Gruppe, die ein Portal herbeizaubern kann, das Euch zurück zu diesem Ort transportiert. Ich kann Euch unterrichten, wenn Ihr bereit seid.",
        "7193fd54ead5f75a57a6": "Ich glaube nicht, dass Ihr die geistige Schärfe besitzt, um die Natur der Portalmagie zu verstehen."
      },
      "name": "Milstaff Stormeye",
      "subName": "Portallehrer",
      "translationMetadata": {
        "fields": {
          "dialogue.05f9ac437f5c97c8ed18": {
