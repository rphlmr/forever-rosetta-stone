    "frFR": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Veuillez m'apprendre.",
        "3efc6becd40c0764a9a9": "En tant que mage, vous faites partie d'une élite qui peut invoquer un portail capable de vous ramener ici même. Je peux vous apprendre comment si vous avez les compétences requises.",
        "7193fd54ead5f75a57a6": "Je ne pense pas que vous possédiez la finesse mentale requise pour comprendre la nature de la magie des portails."
      },
      "name": "Milstaff Stormeye",
      "subName": "Maître des portails",
