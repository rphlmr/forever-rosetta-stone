    "svSE": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Lär mig, tack.",
        "3efc6becd40c0764a9a9": "Som magiker tillhör du en utvald grupp som kan frammana en portal tillbaka till just denna plats. Jag kan lära dig om du är redo.",
        "7193fd54ead5f75a57a6": "Jag tror inte att du har den mentala skärpa som krävs för att förstå portalmagins natur."
      },
      "name": "Milstaff Stormeye",
      "translationMetadata": {
