    "esES": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Por favor, enséñame.",
        "3efc6becd40c0764a9a9": "Como mago, perteneces a un grupo selecto que puede conjurar un portal para transportarte de nuevo a este lugar. Puedo enseñarte si eres capaz de aprender.",
        "7193fd54ead5f75a57a6": "No puedo creerme que poseas la agudeza mental necesaria para comprender la naturaleza de la magia del portal."
      },
      "name": "Milstaff Ojotrueno",
      "subName": "Instructor de portal",
