  "locales": {
    "csCZ": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Prosím, učte mě.",
        "3efc6becd40c0764a9a9": "Jako mág patříš k vyvolené skupině, která dokáže vyčarovat portál zpět na toto místo. Pokud jsi připraven, mohu tě to naučit.",
        "7193fd54ead5f75a57a6": "Nemyslím si, že máš dostatečně bystrou mysl, abys pochopil podstatu portálové magie."
      },
      "name": "Milstaff Stormeye",
      "translationMetadata": {
        "fields": {
          "dialogue.05f9ac437f5c97c8ed18": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.3efc6becd40c0764a9a9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.7193fd54ead5f75a57a6": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Lær mig det, tak.",
        "3efc6becd40c0764a9a9": "Som magiker tilhører du en udvalgt gruppe, der kan fremmane en portal tilbage til netop dette sted. Jeg kan lære dig det, hvis du er klar.",
        "7193fd54ead5f75a57a6": "Jeg tror ikke, du har den mentale skarphed til at forstå portalmagiens natur."
      },
      "name": "Milstaff Stormeye",
      "translationMetadata": {
        "fields": {
          "dialogue.05f9ac437f5c97c8ed18": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
