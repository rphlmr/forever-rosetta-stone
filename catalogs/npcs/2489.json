    "enUS": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Please teach me.",
        "3efc6becd40c0764a9a9": "As a mage, you are one of a select group that can conjure a portal to transport you back to this very place.  I can teach you if you are ready.",
        "7193fd54ead5f75a57a6": "I do not believe you possess the mental acuity to grasp the nature of portal magic."
      },
      "name": "Milstaff Stormeye",
      "subName": "Portal Trainer",
