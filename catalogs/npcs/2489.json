    "plPL": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Proszę, naucz mnie.",
        "3efc6becd40c0764a9a9": "Jako mag należysz do wybranej grupy, która potrafi wyczarować portal prowadzący z powrotem w to miejsce. Mogę cię tego nauczyć, jeśli jesteś gotów.",
        "7193fd54ead5f75a57a6": "Nie sądzę, by twój umysł był dość bystry, by pojąć naturę magii portali."
      },
      "name": "Milstaff Stormeye",
      "translationMetadata": {
        "fields": {
