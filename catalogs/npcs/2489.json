    "ltLT": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Prašau, pamokyk mane.",
        "3efc6becd40c0764a9a9": "Kaip magas, priklausai nedidelei grupei, galinčiai sukurti portalą, kuris pargabentų tave į šią vietą. Galiu tave pamokyti, jei esi pasirengęs.",
        "7193fd54ead5f75a57a6": "Nemanau, kad esi pakankamai įžvalgus suprasti portalų magijos prigimtį."
      },
      "name": "Milstaff Stormeye",
      "subName": "Portalų mokytojas",
      "translationMetadata": {
        "fields": {
