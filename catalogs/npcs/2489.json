    "trTR": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Lütfen bana öğret.",
        "3efc6becd40c0764a9a9": "Bir büyücü olarak, tam da bu yere dönmeni sağlayacak bir geçit açabilen seçkin bir grubun üyesisin. Hazırsan sana öğretebilirim.",
        "7193fd54ead5f75a57a6": "Geçit büyüsünün doğasını kavrayacak zihinsel keskinliğe sahip olduğuna inanmıyorum."
      },
      "name": "Milstaff Stormeye",
