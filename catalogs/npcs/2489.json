    "itIT": {
      "dialogue": {
        "05f9ac437f5c97c8ed18": "Ti prego, insegnami.",
        "3efc6becd40c0764a9a9": "Come mago, fai parte di un gruppo scelto capace di evocare un portale per tornare proprio qui. Posso insegnartelo, se sei pronto.",
        "7193fd54ead5f75a57a6": "Non credo che tu abbia l'acume necessario per comprendere la natura della magia dei portali."
      },
      "name": "Milstaff Stormeye",
      "translationMetadata": {
