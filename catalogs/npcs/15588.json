    "frFR": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "L'Ancien Bloodhoof se trouve au village Bloodhoof de Mulgore.",
        "68dc8b0a00fe9a07f03f": "Aux dernières nouvelles, l'Ancienne Runetotem était en route pour Tranchecolline, en Durotar.",
        "75ddbf17995041be0429": "L'Ancien Moonwarden observe la Croisée des Tarides.",
        "804bfb1b7bd4451dfa41": "Dans les temps anciens, nous vivions pour la chasse.  Nous chassions pour la gloire, pour l’honneur…\n\nEst-ce si différent maintenant ?",
        "9b2bd68f67abafee2dbd": "L'Ancienne Windtotem s'est installée chez les gobelins de Ratchet, sur la côte des Tarides.",
        "bd613cf7a66648e20602": "L'Ancienne Morningdew a choisi d'observer le désordre de la piste des Mirages, dans les Mille pointes."
      },
      "name": "Ancien High Mountain",
