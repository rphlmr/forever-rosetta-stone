  "locales": {
    "csCZ": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Starší Bloodhoof se nachází ve vesnici Bloodhoof v Mulgore.",
        "68dc8b0a00fe9a07f03f": "Naposledy jsem slyšel, že starší Runetotem cestoval do Razor Hillu v Durotaru.",
        "75ddbf17995041be0429": "Starší Moonwarden sleduje Crossroads v Pustinách.",
        "804bfb1b7bd4451dfa41": "Za dávných dnů jsme žili pro lov. Lovili jsme pro slávu a čest...$B$BJe to dnes tak jiné?",
        "9b2bd68f67abafee2dbd": "Starší Windtotem dělá společnost goblinům z Ratchetu na pobřeží Pustin.",
        "bd613cf7a66648e20602": "Starší Morningdew sleduje ruch na závodišti Mirage v Thousand Needles."
      },
      "name": "Starší High Mountain",
      "translationMetadata": {
