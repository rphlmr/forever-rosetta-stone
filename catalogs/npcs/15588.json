    "svSE": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Äldste Bloodhoof finns i Bloodhoof Village i Mulgore.",
        "68dc8b0a00fe9a07f03f": "Senast jag hörde var äldste Runetotem på väg till Razor Hill i Durotar.",
        "75ddbf17995041be0429": "Äldste Moonwarden håller uppsikt över Crossroads i Barrens.",
        "804bfb1b7bd4451dfa41": "För länge sedan levde vi för jakten. Vi jagade för ära och heder...$B$BÄr det så annorlunda nu?",
        "9b2bd68f67abafee2dbd": "Äldste Windtotem håller goblinerna i Ratchet på Barrens kust sällskap.",
        "bd613cf7a66648e20602": "Äldste Morningdew har börjat titta på uppståndelsen vid Mirage Raceway i Thousand Needles."
      },
      "name": "Äldste High Mountain",
