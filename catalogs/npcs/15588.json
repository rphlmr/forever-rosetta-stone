    "daDK": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Ældste Bloodhoof findes i Bloodhoof Village i Mulgore.",
        "68dc8b0a00fe9a07f03f": "Sidst jeg hørte, var ældste Runetotem på vej til Razor Hill i Durotar.",
        "75ddbf17995041be0429": "Ældste Moonwarden holder øje med Crossroads i Barrens.",
        "804bfb1b7bd4451dfa41": "I gamle dage levede vi for jagten. Vi jagede for hæder og ære...$B$BEr det så anderledes nu?",
        "9b2bd68f67abafee2dbd": "Ældste Windtotem holder goblinerne i Ratchet på Barrens’ kyst med selskab.",
        "bd613cf7a66648e20602": "Ældste Morningdew er begyndt at betragte virakken ved Mirage Raceway i Thousand Needles."
      },
      "name": "Ældste High Mountain",
      "translationMetadata": {
