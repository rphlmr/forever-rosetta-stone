    "itIT": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "L'Anziano Bloodhoof si trova a Bloodhoof Village, in Mulgore.",
        "68dc8b0a00fe9a07f03f": "Le ultime voci dicevano che l'Anziana Runetotem era in viaggio verso Razor Hill, in Durotar.",
        "75ddbf17995041be0429": "L'Anziano Moonwarden sta tenendo d'occhio Crossroads, nelle Barrens.",
        "804bfb1b7bd4451dfa41": "In tempi ormai lontani, vivevamo per la caccia. Cacciavamo per la gloria, per l'onore...\n\nÈ poi così diverso, adesso?",
        "9b2bd68f67abafee2dbd": "L'Anziana Windtotem se ne sta in compagnia dei goblin di Ratchet, sulla costa delle Barrens.",
        "bd613cf7a66648e20602": "L'Anziana Morningdew ha preso l'abitudine di osservare il trambusto alla Pista dei Miraggi, nelle Thousand Needles."
      },
      "name": "Anziano High Mountain",
      "translationMetadata": {
