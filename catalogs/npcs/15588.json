    "ltLT": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Vyresnįjį Bloodhoof galima rasti Bloodhoof Village, Mulgore.",
        "68dc8b0a00fe9a07f03f": "Paskutinį kartą girdėjau, kad vyresnysis Runetotem keliavo į Razor Hill, Durotar.",
        "75ddbf17995041be0429": "Vyresnysis Moonwarden stebi Crossroads gyvenvietę Barrens krašte.",
        "804bfb1b7bd4451dfa41": "Seniai seniai gyvenome dėl medžioklės. Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "9b2bd68f67abafee2dbd": "Vyresnysis Windtotem leidžia laiką su Ratchet goblinais Barrens pakrantėje.",
        "bd613cf7a66648e20602": "Vyresnysis Morningdew stebi šurmulį Mirage Raceway trasoje, Thousand Needles krašte."
      },
      "name": "Vyresnysis High Mountain",
