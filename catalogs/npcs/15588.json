    "trTR": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Yaşlı Bloodhoof, Mulgore’daki Bloodhoof Köyü’nde bulunabilir.",
        "68dc8b0a00fe9a07f03f": "Son duyduğuma göre Yaşlı Runetotem, Durotar’daki Razor Hill’e gidiyordu.",
        "75ddbf17995041be0429": "Yaşlı Moonwarden, Barrens’taki Crossroads’u gözlemliyor.",
        "804bfb1b7bd4451dfa41": "Çok eski günlerde av için yaşardık. Şan ve onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "9b2bd68f67abafee2dbd": "Yaşlı Windtotem, Barrens kıyısındaki Ratchet goblinlerine eşlik ediyor.",
        "bd613cf7a66648e20602": "Yaşlı Morningdew, Thousand Needles’taki Mirage Yarış Pisti’ndeki hareketliliği izliyor."
      },
      "name": "Ulu High Mountain",
