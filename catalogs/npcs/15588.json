    "plPL": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Starszego Bloodhoofa można znaleźć w wiosce Bloodhoof w Mulgore.",
        "68dc8b0a00fe9a07f03f": "Ostatnio słyszałem, że starszy Runetotem podróżował do Razor Hill w Durotarze.",
        "75ddbf17995041be0429": "Starszy Moonwarden obserwuje Crossroads na Pustkowiach.",
        "804bfb1b7bd4451dfa41": "Dawno temu żyliśmy dla łowów. Polowaliśmy dla chwały i honoru...$B$BCzy teraz jest tak inaczej?",
        "9b2bd68f67abafee2dbd": "Starszy Windtotem dotrzymuje towarzystwa goblinom z Ratchet na wybrzeżu Pustkowi.",
        "bd613cf7a66648e20602": "Starszy Morningdew obserwuje zamieszanie na torze Mirage w Thousand Needles."
      },
      "name": "Starszy High Mountain",
