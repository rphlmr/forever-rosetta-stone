    "hrHR": {
      "dialogue": {
        "4b9755d5baa456bf02c8": "Starješina Bloodhoof nalazi se u selu Bloodhoof u Mulgoreu.",
        "68dc8b0a00fe9a07f03f": "Posljednje što sam čuo, starješina Runetotem putovao je u Razor Hill u Durotaru.",
        "75ddbf17995041be0429": "Starješina Moonwarden promatra Crossroads u Barrensu.",
        "804bfb1b7bd4451dfa41": "U davna vremena živjeli smo za lov. Lovili smo za slavu i čast...$B$BJe li danas toliko drukčije?",
        "9b2bd68f67abafee2dbd": "Starješina Windtotem druži se s goblinima Ratcheta na obali Barrensa.",
        "bd613cf7a66648e20602": "Starješina Morningdew promatra vrevu na trkalištu Mirage u Thousand Needlesu."
      },
      "name": "Starješina High Mountain",
