      "dialogue": {
        "2fd255d3e7c8e4c216b7": "Od dawna przeczuwałam twoje przybycie, $n. Było zapisane w układzie gwiazd.",
        "4da9b06aaa1f99cee2d4": "Wyszkol mnie.",
