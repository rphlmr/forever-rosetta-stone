    "ptBR": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "Há muito tempo sinto sua chegada, $n. Ela estava escrita no desenho das estrelas.",
        "4da9b06aaa1f99cee2d4": "Treine-me.",
