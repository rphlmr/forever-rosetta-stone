    "enUS": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "I have sensed your coming for quite some time, $n.  It was written in the pattern of the stars.",
        "4da9b06aaa1f99cee2d4": "Train me.",
        "a002216f691a9d65a156": "I want to browse your goods."
