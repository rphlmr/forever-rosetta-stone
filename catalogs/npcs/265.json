    "deDE": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "Ich habe dein Kommen schon seit geraumer Zeit geahnt, $n.  Es war im Muster der Sterne geschrieben.",
        "4da9b06aaa1f99cee2d4": "Bildet mich aus.",
        "a002216f691a9d65a156": "Ich möchte Eure Waren ansehen."
      },
      "name": "Madame Eva",
