    "csCZ": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "Už dlouho jsem cítila tvůj příchod, $n. Byl vepsán do obrazců hvězd.",
        "4da9b06aaa1f99cee2d4": "Vycvičte mě.",
