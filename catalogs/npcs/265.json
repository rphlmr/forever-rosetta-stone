    "trTR": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "Gelişini uzun zamandır hissediyordum, $n. Yıldızların dizilişinde yazılıydı.",
        "4da9b06aaa1f99cee2d4": "Beni eğit.",
