    "daDK": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "Jeg har længe fornemmet din ankomst, $n. Den stod skrevet i stjernernes mønster.",
        "4da9b06aaa1f99cee2d4": "Træn mig.",
        "a002216f691a9d65a156": "Jeg vil gerne se dine varer."
