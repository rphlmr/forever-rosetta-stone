    "itIT": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "È da molto tempo che avverto il tuo arrivo, $N. Era scritto nel disegno delle stelle.",
        "4da9b06aaa1f99cee2d4": "Addestrami.",
