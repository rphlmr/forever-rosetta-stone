    "zhTW": {
      "dialogue": {
        "2fd255d3e7c8e4c216b7": "我早就已經預感到你要來了，$n，星像已經很明確地告訴我。",
        "4da9b06aaa1f99cee2d4": "訓練我。",
        "a002216f691a9d65a156": "我想看看你的貨物。"
