    "frFR": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Je regrette, $c, mais vous devez gagner en force avant que je vous permette d'entrer dans le bassin d'Arathi.",
        "a1f6a65e3906ce2e26b2": "Le bassin d’Arathi était notre foyer, et avec votre aide, il le redeviendra ! Nous aiderez-vous, $c ?"
      },
      "name": "Donal Bongoulot",
      "subName": "Maître de guerre du bassin d'Arathi",
