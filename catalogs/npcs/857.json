            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Es tut mir leid, $C, aber Ihr müsst mächtiger und stärker sein, bevor ich Euch Zutritt zum Arathibecken gewähren kann.",
        "a1f6a65e3906ce2e26b2": "Das Arathibecken war einst unser Zuhause und wird es mit Eurer Hilfe wieder sein! Werdet Ihr uns helfen $C?"
      },
      "name": "Donal Osgood",
      "subName": "Kampfmeister des Arathibeckens",
      "translationMetadata": {
        "fields": {
          "dialogue.89563abf4ddb12c2369c": {
