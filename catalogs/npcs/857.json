  "locales": {
    "csCZ": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Je mi líto, $c, ale než ti dovolím vstoupit do Arathijské pánve, musíš zesílit.",
        "a1f6a65e3906ce2e26b2": "Arathijská pánev kdysi bývala naším domovem a s tvou pomocí jím opět bude! Pomůžeš nám, $c?"
      },
      "name": "Donal Osgood",
      "translationMetadata": {
        "fields": {
          "dialogue.89563abf4ddb12c2369c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
