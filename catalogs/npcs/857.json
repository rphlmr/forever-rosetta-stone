    "plPL": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Przykro mi, $c, ale musisz nabrać sił, zanim pozwolę ci wejść do Kotliny Arathi.",
        "a1f6a65e3906ce2e26b2": "Kotlina Arathi była niegdyś naszym domem i z twoją pomocą znów nim będzie! Pomożesz nam, $c?"
      },
      "name": "Donal Osgood",
      "translationMetadata": {
