    "ptBR": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Sinto muito, $c, mas você tem de estar mais poderoso para que eu o deixe entrar na Bacia Arathi.",
        "a1f6a65e3906ce2e26b2": "A Bacia Arathi foi outrora o nosso lar, e será novamente com a sua ajuda! Você vai nos ajudar, $c?"
      },
      "name": "Donal Obom",
      "subName": "Mestre de Batalha da Bacia Arathi",
