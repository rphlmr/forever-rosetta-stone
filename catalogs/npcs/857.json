    "enUS": {
      "dialogue": {
        "89563abf4ddb12c2369c": "I am sorry $c, but you need to be more powerful before I can allow you to enter Arathi Basin.",
        "a1f6a65e3906ce2e26b2": "Arathi Basin was once our home, and will be again with your aid!  Will you help us $c?"
      },
      "name": "Donal Osgood",
      "subName": "Arathi Basin Battlemaster",
      "translationMetadata": {
