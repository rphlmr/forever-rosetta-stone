    "hrHR": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Žao mi je, $c, ali moraš biti snažniji prije nego što ti dopustim ulazak u Arathi Basin.",
        "a1f6a65e3906ce2e26b2": "Arathi Basin nekoć je bio naš dom, a uz tvoju će pomoć to opet biti! Hoćeš li nam pomoći, $c?"
      },
      "name": "Donal Osgood",
      "translationMetadata": {
