    "trTR": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Üzgünüm $c, ama Arathi Havzası'na girmene izin verebilmem için daha güçlü olmalısın.",
        "a1f6a65e3906ce2e26b2": "Arathi Havzası bir zamanlar yuvamızdı ve senin yardımınla yeniden öyle olacak! Bize yardım eder misin $c?"
      },
      "name": "Donal Osgood",
      "translationMetadata": {
