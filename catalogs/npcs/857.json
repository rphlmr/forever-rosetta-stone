    "svSE": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Jag beklagar, $c, men du måste bli starkare innan jag kan släppa in dig i Arathi Basin.",
        "a1f6a65e3906ce2e26b2": "Arathi Basin var en gång vårt hem, och med din hjälp ska det bli det igen! Vill du hjälpa oss, $c?"
      },
      "name": "Donal Osgood",
