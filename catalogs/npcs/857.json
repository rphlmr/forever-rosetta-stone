    "itIT": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Mi dispiace, $C, ma devi diventare più potente prima che io possa lasciarti entrare ad Arathi Basin.",
        "a1f6a65e3906ce2e26b2": "Arathi Basin un tempo era casa nostra, e lo sarà di nuovo con il tuo aiuto! Ci aiuterai, $C?"
      },
      "name": "Donal Osgood",
