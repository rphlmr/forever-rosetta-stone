    },
    "daDK": {
      "dialogue": {
        "89563abf4ddb12c2369c": "Beklager, $c, men du må blive stærkere, før jeg kan lade dig komme ind i Arathi Basin.",
        "a1f6a65e3906ce2e26b2": "Arathi Basin var engang vores hjem, og med din hjælp bliver det vores igen! Vil du hjælpe os, $c?"
      },
      "name": "Donal Osgood",
      "translationMetadata": {
        "fields": {
          "dialogue.89563abf4ddb12c2369c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
