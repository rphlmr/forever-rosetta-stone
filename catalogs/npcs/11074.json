    "plPL": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Wyszkol mnie.",
        "26e5e579e5031e186e9b": "Czy przybywasz po wiedzę Hgartha?",
        "5421715824d116e1843c": "Osiągnąłeś nowe wyżyny na drodze do mistrzostwa. Zobaczmy, czy możemy zaprowadzić cię jeszcze dalej...",
        "d5c5d451793e93eae432": "Trenuj ciężko, trenuj każdego dnia. Gdy udoskonalisz swe umiejętności, wróć do mnie.",
        "df3942f109288bf706fd": "Jest tylko jedna osoba, której umiejętności przewyższają moje. Jesteś gotów przyjąć jej wiedzę. To Annora, a znajdziesz ją... w Uldamanie."
      },
      "name": "Hgarth",
