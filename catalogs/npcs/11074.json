    "deDE": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Bildet mich aus.",
        "26e5e579e5031e186e9b": "Seid Ihr gekommen, das Wissen von Hgarth zu suchen?",
        "5421715824d116e1843c": "Ihr habt neue Höhen auf Eurem Weg zur Meisterschaft erreicht. Lasst uns sehen, ob wir Euch noch weiter bringen können.",
        "d5c5d451793e93eae432": "Trainiert hart, trainiert jeden Tag. Und wenn Ihr Eure Fertigkeiten perfektioniert habt, dann kehrt zu mir zurück.",
        "df3942f109288bf706fd": "Es gibt nur eine, deren Wissen das meine übersteigt. Ihr seid bereit, ihr Wissen zu empfangen. Sie heißt Annora und Ihr findet sie... in Uldaman."
      },
      "name": "Hgarth",
      "subName": "Verzauberkunstfachmann",
      "translationMetadata": {
        "fields": {
