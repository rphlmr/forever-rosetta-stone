    "trTR": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Beni eğit.",
        "26e5e579e5031e186e9b": "Hgarth'ın bilgisini aramaya mı geldin?",
        "5421715824d116e1843c": "Ustalık yolunda yeni zirvelere ulaştın. Bakalım seni daha da ileri götürebilecek miyiz...",
        "d5c5d451793e93eae432": "Sıkı çalış, her gün çalış. Becerilerini mükemmelleştirdiğinde bana dön.",
        "df3942f109288bf706fd": "Becerileri benimkileri aşan tek bir kişi var. Onun bilgisini almaya hazırsın. Adı Annora ve onu... Uldaman'da bulabilirsin."
      },
      "name": "Hgarth",
