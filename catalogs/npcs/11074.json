    "daDK": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Træn mig.",
        "26e5e579e5031e186e9b": "Er du kommet for at søge Hgarths viden?",
        "5421715824d116e1843c": "Du har nået nye højder på din vej mod mesterskab. Lad os se, om vi kan føre dig endnu videre...",
        "d5c5d451793e93eae432": "Træn hårdt, træn hver dag. Når du har fuldendt dine evner, så vend tilbage til mig.",
        "df3942f109288bf706fd": "Der er kun én, hvis evner overgår mine. Du er klar til at modtage hendes viden. Hun hedder Annora, og du finder hende... i Uldaman."
      },
      "name": "Hgarth",
      "translationMetadata": {
        "fields": {
