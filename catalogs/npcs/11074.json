    "enUS": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Train me.",
        "26e5e579e5031e186e9b": "Have you come to seek the knowledge of Hgarth?",
        "5421715824d116e1843c": "You have reached new heights in your path to mastery. Let us see if we can take you even further...",
        "d5c5d451793e93eae432": "Train hard, train every day. And when you have perfected your skills, return to me.",
        "df3942f109288bf706fd": "There is only one whose skills exceed my own. You are ready to receive her knowledge. She is Annora, and you may find her... in Uldaman."
      },
      "name": "Hgarth",
      "subName": "Artisan Enchanter",
      "translationMetadata": {
