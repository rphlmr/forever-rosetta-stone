    "hrHR": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Podučite me.",
        "26e5e579e5031e186e9b": "Jesi li došao potražiti Hgarthovo znanje?",
        "5421715824d116e1843c": "Dosegao si nove visine na putu prema majstorstvu. Pogledajmo možemo li te odvesti još dalje...",
        "d5c5d451793e93eae432": "Treniraj marljivo, treniraj svaki dan. Kad usavršiš svoje vještine, vrati mi se.",
        "df3942f109288bf706fd": "Samo jedna osoba ima veće vještine od mene. Spreman si primiti njezino znanje. Zove se Annora i možeš je pronaći... u Uldamanu."
      },
      "name": "Hgarth",
