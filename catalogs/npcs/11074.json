  "locales": {
    "csCZ": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Vycvičte mě.",
        "26e5e579e5031e186e9b": "Přišel jsi hledat Hgarthovy znalosti?",
        "5421715824d116e1843c": "Na své cestě k mistrovství jsi dosáhl nových výšin. Podívejme se, zda tě můžeme posunout ještě dál...",
        "d5c5d451793e93eae432": "Cvič tvrdě a každý den. Až zdokonalíš své dovednosti, vrať se ke mně.",
        "df3942f109288bf706fd": "Jen jedna osoba má větší schopnosti než já. Jsi připraven přijmout její znalosti. Jmenuje se Annora a najdeš ji... v Uldamanu."
      },
      "name": "Hgarth",
      "translationMetadata": {
