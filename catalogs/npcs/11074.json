    "svSE": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Träna mig.",
        "26e5e579e5031e186e9b": "Har du kommit för att söka Hgarths kunskap?",
        "5421715824d116e1843c": "Du har nått nya höjder på din väg mot mästerskap. Låt oss se om vi kan föra dig ännu längre...",
        "d5c5d451793e93eae432": "Träna hårt, träna varje dag. När du har fulländat dina färdigheter, återvänd till mig.",
        "df3942f109288bf706fd": "Det finns bara en vars färdigheter överträffar mina. Du är redo att ta emot hennes kunskap. Hon heter Annora och du hittar henne... i Uldaman."
      },
      "name": "Hgarth",
