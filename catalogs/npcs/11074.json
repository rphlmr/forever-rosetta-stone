    "ltLT": {
      "dialogue": {
        "0f975116a493d8c6ef2f": "Išmokyk mane.",
        "26e5e579e5031e186e9b": "Ar atėjai pasisemti Hgartho žinių?",
        "5421715824d116e1843c": "Savo kelyje į meistriškumą pasiekei naujų aukštumų. Pažiūrėkime, ar galime tave nuvesti dar toliau...",
        "d5c5d451793e93eae432": "Uoliai mokykis, mokykis kasdien. O kai ištobulinsi savo įgūdžius, sugrįžk pas mane.",
        "df3942f109288bf706fd": "Yra tik viena, kurios įgūdžiai pranoksta manuosius. Esi pasirengęs perimti jos žinias. Jos vardas Annora, o ją rasi... Uldamane."
      },
      "name": "Hgarth",
      "subName": "Kerėjimo amatininkas",
