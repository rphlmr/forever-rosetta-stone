    "deDE": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Bildet mich aus.",
        "4b184ee240cc02451102": "Wenn Ihr lernen möchtet, Eure eigenen Waffen und Rüstungen zu schmieden, helfe ich Euch gerne.",
        "798e86ae3544c7f67e5c": "Natürlich kann ich Euch bei der Ausbildung helfen. Ich bin zwar selbst noch Geselle, aber ein paar Sachen kann ich Euch sicher zeigen.",
        "cdff8c928d360b8a0fb7": "Es tut mir Leid, ich bin gerade mit Hufeisen für Verner Osgood in Seenhain beschäftigt."
      },
      "name": "Schmied Argus",
      "subName": "Schmiedekunstgeselle",
