    "svSE": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Träna mig.",
        "4b184ee240cc02451102": "Om ni vill lära er att smida egna vapen och rustningar hjälper jag gärna till.",
        "798e86ae3544c7f67e5c": "Självklart kan jag hjälpa dig med träning. Jag är bara gesäll själv, men jag är säker på att jag kan visa dig något.",
        "cdff8c928d360b8a0fb7": "Förlåt, jag är lite upptagen med att göra hästskor åt Verner Osgood i Lakeshire just nu. "
      },
      "name": "Smed Argus",
