    "ptBR": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Treine-me.",
        "4b184ee240cc02451102": "Se quiser aprender a forjar suas próprias armas e armaduras, terei prazer em ajudar.",
        "798e86ae3544c7f67e5c": "Claro que posso ajudar você com o treinamento. Eu mesmo sou apenas um artífice, mas certamente posso lhe ensinar alguma coisa.",
        "cdff8c928d360b8a0fb7": "Sinto muito, estou muito ocupado no momento fazendo ferraduras para Vervo Obom de Vila Plácida."
      },
      "name": "Ferreiro Argus",
      "subName": "Ferreiro Profissional",
