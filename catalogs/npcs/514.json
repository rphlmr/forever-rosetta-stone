    "plPL": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Wyszkol mnie.",
        "4b184ee240cc02451102": "Jeśli chcecie nauczyć się kuć własną broń i zbroje, chętnie wam pomogę.",
        "798e86ae3544c7f67e5c": "Oczywiście mogę pomóc ci w szkoleniu. Sam jestem tylko czeladnikiem, ale z pewnością mogę ci coś pokazać.",
        "cdff8c928d360b8a0fb7": "Przepraszam, jestem teraz trochę zajęty robieniem podków dla Vernera Osgooda z Lakeshire. "
      },
