    "frFR": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Entraînez-moi.",
        "4b184ee240cc02451102": "Si vous voulez apprendre à forger vos propres armes et armures, je serais content de vous aider.",
        "798e86ae3544c7f67e5c": "Bien sûr que je peux vous aider à vous former. Je ne suis que compagnon, mais je suis sûr qu'il y a des choses que je peux vous montrer.",
        "cdff8c928d360b8a0fb7": "Je n'ai guère de temps pour le moment, je fais des fers à cheval pour Verner Osgood de Lakeshire."
      },
      "name": "Argus le forgeron",
      "subName": "Forgeron - Compagnon",
