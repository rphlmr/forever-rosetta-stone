  "locales": {
    "csCZ": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Vycvičte mě.",
        "4b184ee240cc02451102": "Pokud se chcete naučit kovat vlastní zbraně a zbroj, rád vám pomohu.",
        "798e86ae3544c7f67e5c": "Samozřejmě ti mohu pomoci s výcvikem. Sám jsem jen tovaryš, ale určitě ti něco ukážu.",
        "cdff8c928d360b8a0fb7": "Promiň, teď mám trochu napilno. Vyrábím podkovy pro Vernera Osgooda z Lakeshiru. "
      },
      "name": "Kovář Argus",
      "translationMetadata": {
