    "enUS": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Train me.",
        "4b184ee240cc02451102": "If you want to learn how to forge your own weapons and armor, I'd be happy to help.",
        "798e86ae3544c7f67e5c": "Of course I can help you with training. I'm just a journeyman myself, but I'm sure there's something I can show you.",
        "cdff8c928d360b8a0fb7": "I'm sorry, I'm a bit busy right now making horseshoes for Verner Osgood in Lakeshire. "
      },
      "name": "Smith Argus",
      "subName": "Journeyman Blacksmith",
