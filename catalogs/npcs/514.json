    "hrHR": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Podučite me.",
        "4b184ee240cc02451102": "Ako želite naučiti kovati vlastito oružje i oklope, rado ću vam pomoći.",
        "798e86ae3544c7f67e5c": "Naravno da ti mogu pomoći s obukom. I sam sam samo kalfa, ali sigurno te mogu nečemu naučiti.",
        "cdff8c928d360b8a0fb7": "Oprosti, trenutno sam zauzet izradom potkova za Vernera Osgooda u Lakeshireu. "
      },
      "name": "Kovač Argus",
