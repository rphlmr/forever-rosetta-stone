    "daDK": {
      "dialogue": {
        "03ca3dc00f467edf06d0": "Træn mig.",
        "4b184ee240cc02451102": "Hvis De vil lære at smede Deres egne våben og rustninger, hjælper jeg Dem gerne.",
        "798e86ae3544c7f67e5c": "Selvfølgelig kan jeg hjælpe dig med træning. Jeg er selv kun svend, men jeg er sikker på, at jeg kan vise dig noget.",
        "cdff8c928d360b8a0fb7": "Undskyld, jeg har lidt travlt med at lave hestesko til Verner Osgood i Lakeshire lige nu. "
      },
      "name": "Smed Argus",
      "translationMetadata": {
