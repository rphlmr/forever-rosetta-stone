  "locales": {
    "csCZ": {
      "dialogue": {
        "9f867d52b3c4dd3bc622": "Vítej, $c. Chceš radu? Spřátel se s mágem! Máme v rukávu pár triků...",
        "a27533530d43e0e63283": "Mám zájem o výcvik mága.",
        "b7bf12e308ef74ab9fc3": "Přísným přeučováním jsem musel mnohé žáky odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým opakováním náročnější. Proto je každé další přeučení dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?",
        "e42b7fe709ff1214058d": "Mám zájem o výcvik mága.",
        "eff0b98d9ccb4847bba3": "Zdravím. Jsem gnómský učitel mágů a ty jsi mág."
      },
      "name": "Bink",
      "translationMetadata": {
        "fields": {
          "dialogue.9f867d52b3c4dd3bc622": {
