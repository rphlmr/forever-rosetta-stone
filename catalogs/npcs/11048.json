    "plPL": {
      "dialogue": {
        "31ff391703840736b8a0": "Niewielu mamy tu gości. Czy mogę cię czymś zainteresować?",
        "46d8d7517aef1c41af97": "Sam jestem właściwie tylko uczniem. Rhiannon jest ekspertką. Stoi tam przy skrzyniach. Możesz się od niej wiele nauczyć.",
        "92271548cd1d0197d626": "Tak, sądzę, że masz potencjał. Może uda mi się czegoś cię nauczyć.",
        "d359a3de65990c14f638": "Wyszkol mnie."
      },
      "name": "Victor Ward",
