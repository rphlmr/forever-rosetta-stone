    "ltLT": {
      "dialogue": {
        "31ff391703840736b8a0": "Nelabai daug lankytojų čia užsuka. Gal galiu kuo nors sudominti?",
        "46d8d7517aef1c41af97": "Tiesą sakant, aš ir pats dar tik mokausi. Rhiannon yra tikroji žinovė. Ji stovi ten, prie dėžių. Iš jos gali daug ko išmokti.",
        "92271548cd1d0197d626": "Taip, manau, kad turi gabumų. Galėčiau šio bei to pamokyti.",
        "d359a3de65990c14f638": "Pamokyk mane."
      },
      "name": "Victor Ward",
      "subName": "Siuvėjas pameistrys",
