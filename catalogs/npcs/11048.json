    "hrHR": {
      "dialogue": {
        "31ff391703840736b8a0": "Ne dolazi nam mnogo posjetitelja ovamo. Mogu li te nečim zainteresirati?",
        "46d8d7517aef1c41af97": "Zapravo sam i sam samo učenik. Rhiannon je stručnjakinja. Stoji ondje kraj sanduka. Od nje možeš mnogo naučiti.",
        "92271548cd1d0197d626": "Da, mislim da imaš potencijala. Možda te mogu naučiti pokoju stvar.",
        "d359a3de65990c14f638": "Podučite me."
      },
      "name": "Victor Ward",
      "translationMetadata": {
