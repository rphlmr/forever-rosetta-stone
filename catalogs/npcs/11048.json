    "daDK": {
      "dialogue": {
        "31ff391703840736b8a0": "Vi får ikke mange besøgende herude. Kan jeg friste dig med noget?",
        "46d8d7517aef1c41af97": "Jeg er faktisk selv bare elev. Rhiannon er eksperten. Hun står ved kasserne derovre. Du kan lære meget af hende.",
        "92271548cd1d0197d626": "Ja, jeg tror, du har potentiale. Måske kan jeg lære dig et par ting.",
        "d359a3de65990c14f638": "Træn mig."
      },
      "name": "Victor Ward",
      "translationMetadata": {
