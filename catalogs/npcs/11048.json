    "esES": {
      "dialogue": {
        "31ff391703840736b8a0": "No solemos recibir muchos visitantes aquí. ¿Te interesa algo?",
        "46d8d7517aef1c41af97": "En realidad yo soy solo un estudiante. Rhiannon es la experta. Está ahí, al lado de las cajas. Podrás aprender mucho de ella.",
        "92271548cd1d0197d626": "Sí, creo que tienes potencial. Quizás pueda enseñarte un par de cosas.",
        "d359a3de65990c14f638": "Entréname."
      },
      "name": "Víctor Tutor",
      "subName": "Oficial de sastrería",
