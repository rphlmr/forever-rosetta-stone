    "ptBR": {
      "dialogue": {
        "31ff391703840736b8a0": "Não recebemos muitas visitas aqui. Há algo que lhe interesse?",
        "46d8d7517aef1c41af97": "Eu mesmo sou apenas um aluno. Renata é a especialista. Ela está ali perto dos caixotes. Você pode aprender muito com ela.",
        "92271548cd1d0197d626": "Sim, creio que você tem potencial. Talvez eu possa lhe mostrar alguma coisa.",
        "d359a3de65990c14f638": "Treine-me."
      },
      "name": "Victor Guardia",
      "subName": "Alfaiate Profissional",
