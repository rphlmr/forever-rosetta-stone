    "trTR": {
      "dialogue": {
        "31ff391703840736b8a0": "Buralara pek ziyaretçi gelmez. Bir şeyle ilgilenir misin?",
        "46d8d7517aef1c41af97": "Aslında ben de sadece bir öğrenciyim. Uzman Rhiannon. Şurada, sandıkların yanında duruyor. Ondan çok şey öğrenebilirsin.",
        "92271548cd1d0197d626": "Evet, potansiyelin olduğunu düşünüyorum. Belki sana birkaç şey gösterebilirim.",
        "d359a3de65990c14f638": "Beni eğit."
      },
      "name": "Victor Ward",
      "translationMetadata": {
