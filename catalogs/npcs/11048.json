    "itIT": {
      "dialogue": {
        "31ff391703840736b8a0": "Da queste parti non passano molti visitatori. Ti interessa qualcosa?",
        "46d8d7517aef1c41af97": "In realtà sono solo uno studente anch'io. L'esperta è Rhiannon. È laggiù, vicino alle casse. Da lei puoi imparare molto.",
        "92271548cd1d0197d626": "Sì, credo che tu abbia del potenziale. Forse posso insegnarti un paio di cose.",
        "d359a3de65990c14f638": "Addestrami."
      },
      "name": "Victor Ward",
