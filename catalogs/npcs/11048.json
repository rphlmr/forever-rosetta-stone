  "locales": {
    "csCZ": {
      "dialogue": {
        "31ff391703840736b8a0": "Moc návštěvníků sem nechodí. Mohu ti něco nabídnout?",
        "46d8d7517aef1c41af97": "Já jsem vlastně také jen student. Odbornicí je Rhiannon. Stojí tamhle u beden. Můžeš se od ní hodně naučit.",
        "92271548cd1d0197d626": "Ano, myslím, že máš nadání. Možná tě mohu něco naučit.",
        "d359a3de65990c14f638": "Vycvičte mě."
      },
      "name": "Victor Ward",
      "translationMetadata": {
        "fields": {
