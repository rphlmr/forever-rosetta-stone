    "enUS": {
      "dialogue": {
        "31ff391703840736b8a0": "We don't get many visitors out here. May I interest you in something?",
        "46d8d7517aef1c41af97": "I'm just a student myself, really. Rhiannon's the expert. She's standing by the crates over there. You can learn a lot from her.",
        "92271548cd1d0197d626": "Yes, I think you have potential. Maybe I can show you a thing or two.",
        "d359a3de65990c14f638": "Train me."
      },
      "name": "Victor Ward",
      "subName": "Journeyman Tailor",
      "translationMetadata": {
