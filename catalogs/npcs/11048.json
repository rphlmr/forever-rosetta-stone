    "svSE": {
      "dialogue": {
        "31ff391703840736b8a0": "Vi får inte många besökare här ute. Kan jag intressera dig för något?",
        "46d8d7517aef1c41af97": "Jag är egentligen bara elev själv. Rhiannon är experten. Hon står vid lådorna där borta. Du kan lära dig mycket av henne.",
        "92271548cd1d0197d626": "Ja, jag tror att du har potential. Jag kanske kan lära dig ett och annat.",
        "d359a3de65990c14f638": "Träna mig."
      },
      "name": "Victor Ward",
      "translationMetadata": {
