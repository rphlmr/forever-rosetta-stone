    "ltLT": {
      "dialogue": {
        "23b796bbeaff02cee122": "Senolį Moonstrike galima rasti Scholomance, Western Plaguelands.",
        "2ded022f19ca5ce185bf": "Senolis Graveborn leidžia laiką netoli Brill, Tirisfal Glades.",
        "323e7b7904a3d8cb9ec2": "Atėjo metas, kai metai nauji, o mėnulis šviečia skaisčiai.$B$BTai mūsų metas... kai senoliai pabunda.",
        "55aeea9fc027a7d6747f": "Senolis Ironband gyvena Blackchar urve, Searing Gorge.",
        "8fdd86d241328ecce43d": "Senolį Darkhorn galima rasti tarp raudonų Orgrimmar uolų.",
        "9d7c4e5eaee2419783d6": "Senolis Proudhorn grožisi Mulgore vaizdais nuo Thunder Bluff."
