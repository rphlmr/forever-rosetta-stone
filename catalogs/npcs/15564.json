  "locales": {
    "csCZ": {
      "dialogue": {
        "23b796bbeaff02cee122": "Starší Moonstrike se nachází ve Scholomance v Západních morových zemích.",
        "2ded022f19ca5ce185bf": "Starší Graveborn tráví čas poblíž Brillu v Tirisfalských pasekách.",
        "323e7b7904a3d8cb9ec2": "Nyní začíná nový rok a měsíc jasně září.$B$BJe to náš čas... čas, kdy se probouzejí prastaří.",
        "55aeea9fc027a7d6747f": "Starší Ironband žije v jeskyni Blackchar v Searing Gorge.",
        "8fdd86d241328ecce43d": "Starší Darkhorn se nachází mezi rudými skalami Orgrimmaru.",
        "9d7c4e5eaee2419783d6": "Starší Proudhorn si užívá výhled na Mulgore z Thunder Bluffu."
      },
      "name": "Starší Darkcore",
