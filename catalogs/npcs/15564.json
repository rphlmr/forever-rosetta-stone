    "enUS": {
      "dialogue": {
        "23b796bbeaff02cee122": "Elder Moonstrike can be found in the Scholomance in the Western Plaguelands.",
        "2ded022f19ca5ce185bf": "Elder Graveborn spends time near Brill in Tirisfal Glades.",
        "323e7b7904a3d8cb9ec2": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "55aeea9fc027a7d6747f": "Elder Ironband lives in Blackchar Cave in Searing Gorge.",
        "8fdd86d241328ecce43d": "Elder Darkhorn can be found among the red rocks of Orgrimmar.",
        "9d7c4e5eaee2419783d6": "Elder Proudhorn is enjoying the vistas above Mulgore at Thunder Bluff."
      },
      "name": "Elder Darkcore",
