    "svSE": {
      "dialogue": {
        "23b796bbeaff02cee122": "Äldste Moonstrike finns i Scholomance i Western Plaguelands.",
        "2ded022f19ca5ce185bf": "Äldste Graveborn håller till nära Brill i Tirisfal Glades.",
        "323e7b7904a3d8cb9ec2": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "55aeea9fc027a7d6747f": "Äldste Ironband bor i Blackchar Cave i Searing Gorge.",
        "8fdd86d241328ecce43d": "Äldste Darkhorn finns bland Orgrimmars röda klippor.",
        "9d7c4e5eaee2419783d6": "Äldste Proudhorn njuter av utsikten över Mulgore från Thunder Bluff."
      },
      "name": "Äldste Darkcore",
