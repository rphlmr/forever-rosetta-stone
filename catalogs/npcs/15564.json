    "plPL": {
      "dialogue": {
        "23b796bbeaff02cee122": "Starszego Moonstrike’a znajdziesz w Scholomance w Zachodnich Ziemiach Plagi.",
        "2ded022f19ca5ce185bf": "Starszy Graveborn przebywa w pobliżu Brill na Polanach Tirisfal.",
        "323e7b7904a3d8cb9ec2": "Teraz zaczyna się nowy rok, a księżyc świeci jasno.$B$BTo nasz czas... czas przebudzenia pradawnych.",
        "55aeea9fc027a7d6747f": "Starszy Ironband mieszka w jaskini Blackchar w Searing Gorge.",
        "8fdd86d241328ecce43d": "Starszego Darkhorna znajdziesz wśród czerwonych skał Orgrimmaru.",
        "9d7c4e5eaee2419783d6": "Starszy Proudhorn podziwia widoki na Mulgore z Thunder Bluff."
