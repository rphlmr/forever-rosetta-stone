    "trTR": {
      "dialogue": {
        "23b796bbeaff02cee122": "Yaşlı Moonstrike, Western Plaguelands’teki Scholomance’ta bulunabilir.",
        "2ded022f19ca5ce185bf": "Yaşlı Graveborn, Tirisfal Glades’te Brill yakınlarında vakit geçirir.",
        "323e7b7904a3d8cb9ec2": "Şimdi yılın yenilendiği ve ayın parlakça ışıldadığı zaman.$B$BBu bizim zamanımız... kadimlerin uyandığı zaman.",
        "55aeea9fc027a7d6747f": "Yaşlı Ironband, Searing Gorge’daki Blackchar Mağarası’nda yaşar.",
        "8fdd86d241328ecce43d": "Yaşlı Darkhorn, Orgrimmar’ın kızıl kayaları arasında bulunabilir.",
        "9d7c4e5eaee2419783d6": "Yaşlı Proudhorn, Thunder Bluff’tan Mulgore manzarasının tadını çıkarıyor."
      },
      "name": "Ulu Darkcore",
