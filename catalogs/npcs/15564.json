    "daDK": {
      "dialogue": {
        "23b796bbeaff02cee122": "Ældste Moonstrike findes i Scholomance i Western Plaguelands.",
        "2ded022f19ca5ce185bf": "Ældste Graveborn opholder sig nær Brill i Tirisfal Glades.",
        "323e7b7904a3d8cb9ec2": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de gamle vågner.",
        "55aeea9fc027a7d6747f": "Ældste Ironband bor i Blackchar Cave i Searing Gorge.",
        "8fdd86d241328ecce43d": "Ældste Darkhorn findes blandt Orgrimmars røde klipper.",
        "9d7c4e5eaee2419783d6": "Ældste Proudhorn nyder udsigten over Mulgore fra Thunder Bluff."
      },
      "name": "Ældste Darkcore",
