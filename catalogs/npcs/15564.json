    "hrHR": {
      "dialogue": {
        "23b796bbeaff02cee122": "Starješinu Moonstrikea možeš pronaći u Scholomanceu u Zapadnim okuženim zemljama.",
        "2ded022f19ca5ce185bf": "Starješina Graveborn boravi blizu Brilla u Tirisfalskim proplancima.",
        "323e7b7904a3d8cb9ec2": "Sada je godina nova, a mjesec sjajno sja.$B$BOvo je naše vrijeme... kada se drevni bude.",
        "55aeea9fc027a7d6747f": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu.",
        "8fdd86d241328ecce43d": "Starješinu Darkhorna možeš pronaći među crvenim stijenama Orgrimmara.",
        "9d7c4e5eaee2419783d6": "Starješina Proudhorn uživa u pogledu na Mulgore s Thunder Bluffa."
