    "deDE": {
      "dialogue": {
        "98d9c4efc60ec434f933": "Einem Tauren kann ich nicht beibringen einen Raptor zu reiten.",
        "9ce7033feefd1d87534a": "Ich kann Euch die Feinheiten des Raptorreitens beibringen, vorausgesetzt, Ihr habt genug Gold in der Tasche, um die Stunde bezahlen zu können!",
        "a697ed64b63a5965becf": "Die Trolle des Darkspearstamms müssen Euch mit Ehrfurcht begegnen, bevor ich Euch eine Reitfertigkeit lehre, $C.",
        "cfd7db128fc4f90bfd3b": "Ich suche eine Ausbildung im Reiten."
      },
      "name": "Xar'Ti",
      "subName": "Raptorreitlehrerin",
      "translationMetadata": {
