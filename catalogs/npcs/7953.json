    "esES": {
      "dialogue": {
        "98d9c4efc60ec434f933": "No puedo enseñarle a un tauren a montar un raptor.",
        "9ce7033feefd1d87534a": "Puedo enseñarte los mejores trucos para montar un raptor, ¡siempre que tengas suficiente oro para pagar la lección!",
        "a697ed64b63a5965becf": "Es necesario que los trols Lanza Negra te consideren un exaltado para que te pueda enseñar la habilidad de montar.",
        "cfd7db128fc4f90bfd3b": "Busco instrucción para aprender a montar."
      },
      "name": "Xar'Ti",
      "subName": "Instructor de jinetes de raptor",
