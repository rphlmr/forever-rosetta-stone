    "itIT": {
      "dialogue": {
        "98d9c4efc60ec434f933": "Io non posso mettermi a insegnare a un Tauren a cavalcare un Raptor.",
        "9ce7033feefd1d87534a": "Posso insegnarti i segreti di Raptor Riding, purché tu abbia abbastanza oro per pagare la lezione!",
        "a697ed64b63a5965becf": "Devi essere exalted con i troll della tribù Darkspear prima che io ti insegni a cavalcare, $C.",
        "cfd7db128fc4f90bfd3b": "Cerco un addestramento per cavalcare una cavalcatura."
      },
      "name": "Xar'Ti",
