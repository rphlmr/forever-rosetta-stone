  "locales": {
    "csCZ": {
      "dialogue": {
        "98d9c4efc60ec434f933": "Taurena nemohu naučit jezdit na raptorovi.",
        "9ce7033feefd1d87534a": "Mohu tě naučit jemnostem jízdy na raptorovi, pokud máš dost zlata na zaplacení lekce!",
        "a697ed64b63a5965becf": "Než tě naučím jezdit, musíš mít u trollů kmene Darkspear vznešenou pověst, $c.",
        "cfd7db128fc4f90bfd3b": "Hledám výcvik v jízdě na jezdeckém zvířeti."
      },
      "name": "Xar'Ti",
      "translationMetadata": {
        "fields": {
