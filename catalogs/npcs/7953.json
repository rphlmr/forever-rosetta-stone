    "daDK": {
      "dialogue": {
        "98d9c4efc60ec434f933": "Jeg kan ikke lære en tauren at ride på en raptor.",
        "9ce7033feefd1d87534a": "Jeg kan lære dig kunsten at ride på raptor, hvis du har nok guld til undervisningen!",
        "a697ed64b63a5965becf": "Du skal være ophøjet hos Darkspear-troldene, før jeg vil lære dig at ride, $c.",
        "cfd7db128fc4f90bfd3b": "Jeg søger undervisning i at ride på et ridedyr."
      },
      "name": "Xar'Ti",
      "translationMetadata": {
