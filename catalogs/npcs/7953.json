    "ltLT": {
      "dialogue": {
        "98d9c4efc60ec434f933": "Negaliu mokyti taureno joti raptoriumi.",
        "9ce7033feefd1d87534a": "Galiu išmokyti tave jojimo raptoriais subtilybių, jei turi pakankamai aukso pamokai apmokėti!",
        "a697ed64b63a5965becf": "Turi pelnyti Darkspear genties trolių išaukštinimą, kad išmokyčiau tave joti, $c.",
        "cfd7db128fc4f90bfd3b": "Noriu išmokti joti."
      },
      "name": "Xar'Ti",
      "subName": "Jojimo raptoriais mokytojas",
