    "enUS": {
      "dialogue": {
        "98d9c4efc60ec434f933": "I cannot be teachin' a Tauren to ride a Raptor.",
        "9ce7033feefd1d87534a": "I can teach you the finer points of Raptor Riding, provided you have enough gold to cover the lesson!",
        "a697ed64b63a5965becf": "You need to be exalted with the trolls of the Darkspear tribe before I will teach you a riding skill, $c.",
        "cfd7db128fc4f90bfd3b": "I seek training to ride a steed."
      },
      "name": "Xar'Ti",
      "subName": "Raptor Riding Trainer",
      "translationMetadata": {
