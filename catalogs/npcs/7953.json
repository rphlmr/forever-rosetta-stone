    "hrHR": {
      "dialogue": {
        "98d9c4efc60ec434f933": "Ne mogu taurena učiti jahati raptora.",
        "9ce7033feefd1d87534a": "Mogu te naučiti vještini jahanja raptora, ako imaš dovoljno zlata za poduku!",
        "a697ed64b63a5965becf": "Moraš biti uzvišen među trolovima plemena Darkspear prije nego što te naučim jahati, $c.",
        "cfd7db128fc4f90bfd3b": "Želim naučiti jahati jahaću životinju."
      },
      "name": "Xar'Ti",
