    "daDK": {
      "dialogue": {
        "6cfcc290833bdf2d23f8": "Hilsen, soldat. Er du her for at støtte vores sag?",
        "963ecb753e72e0735b47": "Godt klaret, soldat. Et par stykker mere, så bugner vores stalde af ridedyr til kavaleriet i kamp!"
      },
      "name": "Frostwolf-staldmester",
