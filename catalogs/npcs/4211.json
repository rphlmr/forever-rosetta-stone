    "deDE": {
      "dialogue": {
        "21e0a9d55732d2802119": "Der angesehene Doktor Gustav VanHowzen kann Euch weiter ausbilden. Ihr findet ihn in Theramore, er versorgt die Verwundeten in der dort ansässigen Kaserne.",
        "2b8d60b4ef99aa35010b": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "ac79886a1799c562fc92": "Ich benötige Ausbildung.",
        "de3fd8131de2f857c596": "Ich habe gehört, dass Deneb Walker sich momentan in Stromgarde aufhält. Er ist im Besitz eines Buchs, das Euch helfen wird, Eure Techniken der Ersten Hilfe zu verbessern."
      },
      "name": "Dannelor",
      "subName": "Lehrer für Erste Hilfe",
