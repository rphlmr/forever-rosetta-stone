    "enUS": {
      "dialogue": {
        "21e0a9d55732d2802119": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks.",
        "2b8d60b4ef99aa35010b": "I can train you in First Aid techniques.",
        "ac79886a1799c562fc92": "I require training.",
        "de3fd8131de2f857c596": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques."
      },
      "name": "Dannelor",
      "subName": "First Aid Trainer",
      "translationMetadata": {
