  "locales": {
    "csCZ": {
      "dialogue": {
        "21e0a9d55732d2802119": "Vážený doktor Gustaf VanHowzen tě může dále vycvičit. Najdeš ho v Theramore, kde v kasárnách ošetřuje raněné.",
        "2b8d60b4ef99aa35010b": "Mohu tě naučit techniky první pomoci.",
        "ac79886a1799c562fc92": "Potřebuji výcvik.",
        "de3fd8131de2f857c596": "Slyšel jsem, že Deneb Walker, který se ukrývá ve Stromgarde, má knihu, která ti určitě pomůže zdokonalit první pomoc."
      },
      "name": "Dannelor",
      "translationMetadata": {
