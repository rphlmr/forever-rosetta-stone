    "hrHR": {
      "dialogue": {
        "21e0a9d55732d2802119": "Cijenjeni doktor Gustaf VanHowzen može te dalje podučavati. Naći ćeš ga u Theramoreu, gdje liječi ranjene u vojarni.",
        "2b8d60b4ef99aa35010b": "Mogu te naučiti tehnikama prve pomoći.",
        "ac79886a1799c562fc92": "Trebam obuku.",
        "de3fd8131de2f857c596": "Čuo sam da Deneb Walker, koji se sklonio u Stromgardeu, ima knjigu koja će ti sigurno pomoći da poboljšaš svoje vještine prve pomoći."
      },
      "name": "Dannelor",
