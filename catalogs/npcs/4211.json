    "daDK": {
      "dialogue": {
        "21e0a9d55732d2802119": "Den højt ansete doktor Gustaf VanHowzen kan træne dig videre. Du finder ham i Theramore, hvor han behandler sårede i kasernen.",
        "2b8d60b4ef99aa35010b": "Jeg kan lære dig førstehjælpsteknikker.",
        "ac79886a1799c562fc92": "Jeg har brug for træning.",
        "de3fd8131de2f857c596": "Jeg har hørt, at Deneb Walker, som holder til i Stromgarde, har en bog, der helt sikkert kan forbedre dine førstehjælpsevner."
      },
      "name": "Dannelor",
      "translationMetadata": {
