      }
    },
    "daDK": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Træn mig.",
        "601ce09503dc765b9fc4": "Hvis du er her for at tigge om privilegiet at arbejde for mig, er du hjerteligt velkommen. Ellers er der ringe chance for, at du kan være mig til nytte.",
        "ad1c8e46fbb6b7fdf9ea": "Jeg vil gerne se dine varer."
      },
      "name": "Ærkemagiker Xylem",
      "translationMetadata": {
        "fields": {
          "dialogue.4f6b3618fb7b6eec0fd3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
