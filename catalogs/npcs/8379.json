  "locales": {
    "csCZ": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Vycvičte mě.",
        "601ce09503dc765b9fc4": "Jsi-li tu, abys žebral o výsadu pracovat pro mě, pak jsi velmi vítán. Jinak je jen malá šance, že mi budeš k něčemu užitečný.",
        "ad1c8e46fbb6b7fdf9ea": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Arcimág Xylem",
      "translationMetadata": {
        "fields": {
