    "trTR": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Beni eğit.",
        "601ce09503dc765b9fc4": "Benim için çalışma ayrıcalığına yalvarmaya geldiysen, burada olmandan memnuniyet duyarım. Aksi hâlde bana bir yararın dokunması pek olası değil.",
        "ad1c8e46fbb6b7fdf9ea": "Mallarına bakmak istiyorum."
      },
      "name": "Başbüyücü Xylem",
      "translationMetadata": {
