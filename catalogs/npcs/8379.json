    "plPL": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Wyszkol mnie.",
        "601ce09503dc765b9fc4": "Jeśli przybywasz błagać o zaszczyt pracy dla mnie, twoje towarzystwo jest mile widziane. W przeciwnym razie raczej nie będziesz mi do niczego przydatny.",
        "ad1c8e46fbb6b7fdf9ea": "Chcę przejrzeć twoje towary."
      },
      "name": "Arcymag Xylem",
      "translationMetadata": {
