    "svSE": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Träna mig.",
        "601ce09503dc765b9fc4": "Om du är här för att be om privilegiet att arbeta för mig är ditt sällskap mycket välkommet. Annars är chansen liten att du kan vara mig till någon nytta.",
        "ad1c8e46fbb6b7fdf9ea": "Jag vill se dina varor."
      },
      "name": "Ärkemagiker Xylem",
      "translationMetadata": {
