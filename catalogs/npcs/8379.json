    "itIT": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Addestrami.",
        "601ce09503dc765b9fc4": "Se sei qui per implorare il privilegio di lavorare per me, allora la tua compagnia è più che gradita. Altrimenti, è ben difficile che tu possa essermi di qualche utilità.",
        "ad1c8e46fbb6b7fdf9ea": "Vorrei vedere la tua merce."
      },
      "name": "Arcimago Xylem",
      "translationMetadata": {
        "fields": {
