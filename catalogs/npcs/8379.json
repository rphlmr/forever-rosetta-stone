    "esES": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Entréname.",
        "601ce09503dc765b9fc4": "Si ha venido a mendigar el privilegio de trabajar para mí, su compañía será bienvenida. De lo contrario, hay pocas posibilidades de que me seas útil.",
        "ad1c8e46fbb6b7fdf9ea": "Quiero ver tus mercancías."
      },
      "name": "Archimago Xylem",
      "translationMetadata": {
        "fields": {
