    "esMX": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Entréname.",
        "601ce09503dc765b9fc4": "Si estás aquí para suplicar el privilegio de trabajar para mí, tu compañía es muy bienvenida. De lo contrario, es poco probable que me seas de utilidad.",
        "ad1c8e46fbb6b7fdf9ea": "Quiero ver tus mercancías."
      },
      "name": "Archimago Xylem",
