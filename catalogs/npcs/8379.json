          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Bildet mich aus.",
        "601ce09503dc765b9fc4": "Wenn Sie hier sind, um um das Privileg zu betteln, für mich arbeiten zu dürfen, dann ist Ihre Gesellschaft durchaus willkommen. Andernfalls ist es unwahrscheinlich, dass Sie mir von Nutzen sind.",
        "ad1c8e46fbb6b7fdf9ea": "Ich möchte Eure Waren ansehen."
      },
      "name": "Erzmagier Xylem",
      "translationMetadata": {
        "fields": {
          "dialogue.4f6b3618fb7b6eec0fd3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
