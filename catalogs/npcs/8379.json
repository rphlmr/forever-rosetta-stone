    "frFR": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Entraînez-moi.",
        "601ce09503dc765b9fc4": "Si vous êtes ici pour mendier le privilège de travailler pour moi, alors votre compagnie est la bienvenue. Sinon, il y a peu de chances que vous me soyez utile.",
        "ad1c8e46fbb6b7fdf9ea": "Je voudrais regarder vos articles."
      },
      "name": "Archimage Xylem",
      "translationMetadata": {
        "fields": {
