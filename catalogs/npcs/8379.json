    "enUS": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Train me.",
        "601ce09503dc765b9fc4": "If you are here to beg for the privilege of working for me, then your company is quite welcome. Otherwise, there is little chance you are of any use to me.",
        "ad1c8e46fbb6b7fdf9ea": "I want to browse your goods."
      },
      "name": "Archmage Xylem",
      "translationMetadata": {
        "fields": {
          "dialogue.4f6b3618fb7b6eec0fd3": {
