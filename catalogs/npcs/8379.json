    "hrHR": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Podučite me.",
        "601ce09503dc765b9fc4": "Ako si ovdje da moliš za povlasticu rada za mene, tvoje je društvo itekako dobrodošlo. Inače su male šanse da mi možeš biti od koristi.",
        "ad1c8e46fbb6b7fdf9ea": "Želim pogledati vašu robu."
      },
      "name": "Nadmag Xylem",
      "translationMetadata": {
        "fields": {
