    "ptBR": {
      "dialogue": {
        "4f6b3618fb7b6eec0fd3": "Treine-me.",
        "601ce09503dc765b9fc4": "Se veio implorar pelo privilégio de trabalhar para mim, sua companhia é muito bem-vinda. Caso contrário, é pouco provável que me seja útil.",
        "ad1c8e46fbb6b7fdf9ea": "Quero ver suas mercadorias."
      },
      "name": "Arquimago Tauriel",
      "translationMetadata": {
