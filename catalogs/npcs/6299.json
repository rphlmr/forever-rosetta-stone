  "locales": {
    "csCZ": {
      "dialogue": {
        "1b966e21fd29e40c09b2": "Tak to je kus oceli, který stojí za nošení. Krása i účelnost, hochu či děvče, to mě ohromilo. Rovný kus jsem viděl jen jednou, u mistra ve Velké kovárně jménem Grumnus Steelshaper. Vsadím se, že se od té doby přiučil a mohl by něco naučit i tebe.",
        "45018026d1d163661a3f": "Tak daleko od Ironforge moc kovářů nevídám. Co pro tebe mohu udělat?",
        "6cd1b2cd201afa6a5259": "Vycvičte mě.",
        "7909e0556a13006adc37": "Bez pevného žulového stropu nad hlavou se prostě nedokážu cítit pohodlně. Tolik hvězd tam nahoře, až z toho člověka mrazí."
      },
      "name": "Delfrum Flintbeard",
      "translationMetadata": {
        "fields": {
          "dialogue.1b966e21fd29e40c09b2": {
