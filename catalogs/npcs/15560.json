    "hrHR": {
      "dialogue": {
        "f416e54e58862a63e7ff": "Sada je vrijeme kada je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude.",
        "f5dfbd1bf820f087a8e4": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu."
