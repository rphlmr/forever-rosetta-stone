    "deDE": {
      "dialogue": {
        "f416e54e58862a63e7ff": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "f5dfbd1bf820f087a8e4": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht."
      },
      "name": "Urahne Stonefort",
