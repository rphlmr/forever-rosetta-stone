    "csCZ": {
      "dialogue": {
        "f416e54e58862a63e7ff": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... čas, kdy se prastaré bytosti probouzejí.",
        "f5dfbd1bf820f087a8e4": "Prastařec Ironband žije v jeskyni Blackchar v Searing Gorge."
      },
      "name": "Starší Stonefort",
