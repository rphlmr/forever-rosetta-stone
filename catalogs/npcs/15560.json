    "daDK": {
      "dialogue": {
        "f416e54e58862a63e7ff": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "f5dfbd1bf820f087a8e4": "Ældste Ironband bor i Blackchar Cave i Searing Gorge."
      },
      "name": "Ældste Stonefort",
