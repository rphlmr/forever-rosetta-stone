    "enUS": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "A far better blacksmith than I am, that's for sure. Though I'll deny it if you tell anyone I said that. You should go speak with Therum Deepforge. If anyone can teach you more, it's him.",
        "ee4d0be8a90c641725a3": "You're not bad, but let me show you a few tricks you might find handy."
      },
      "name": "Daeann Steelwind",
      "subName": "Blacksmith",
      "translationMetadata": {
