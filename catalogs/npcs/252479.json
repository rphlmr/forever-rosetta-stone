      }
    },
    "svSE": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "Han är en mycket bättre smed än jag, det är säkert. Men jag kommer att förneka det om du berättar för någon att jag sa det. Tala med Therum Deepforge. Om någon kan lära dig mer är det han.",
        "ee4d0be8a90c641725a3": "Du är inte dålig, men låt mig visa dig några knep som kan komma till nytta."
      },
      "name": "Daeann Steelwind",
      "translationMetadata": {
        "fields": {
          "dialogue.c36d05b8ec1836a06bb2": {
