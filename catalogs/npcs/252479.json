        }
      }
    },
    "ptBR": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "É um ferreiro muito melhor do que eu, isso é certo. Mas vou negar se você contar a alguém que eu disse isso. Vá falar com Therum Forjafunda. Se alguém pode ensinar mais a você, é ele.",
        "ee4d0be8a90c641725a3": "Você não é ruim, mas deixe-me mostrar alguns truques que podem ser úteis."
      },
      "name": "Daeann Ventaço",
      "subName": "Blacksmith",
      "translationMetadata": {
