    "hrHR": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "Puno je bolji kovač od mene, to je sigurno. No poreći ću ako ikome kažeš da sam to rekla. Razgovaraj s Therumom Deepforgeom. Ako te itko može naučiti više, to je on.",
        "ee4d0be8a90c641725a3": "Nisi loš, ali dopusti da ti pokažem nekoliko trikova koji bi ti mogli koristiti."
      },
      "name": "Daeann Steelwind",
      "translationMetadata": {
        "fields": {
          "dialogue.c36d05b8ec1836a06bb2": {
