          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "En langt bedre smed end mig, det er sikkert. Men jeg vil benægte det, hvis du siger til nogen, at jeg sagde det. Tal med Therum Deepforge. Hvis nogen kan lære dig mere, er det ham.",
        "ee4d0be8a90c641725a3": "Du er ikke dårlig, men lad mig vise dig et par tricks, du måske får brug for."
      },
      "name": "Daeann Steelwind",
      "translationMetadata": {
        "fields": {
          "dialogue.c36d05b8ec1836a06bb2": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
