  "locales": {
    "csCZ": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "Rozhodně je mnohem lepší kovář než já. Ale jestli někomu řekneš, že jsem to řekla, zapřu to. Promluv si s Therumem Deepforgem. Jestli tě někdo může naučit víc, je to on.",
        "ee4d0be8a90c641725a3": "Nejsi špatný, ale ukážu ti pár triků, které by se ti mohly hodit."
      },
      "name": "Daeann Steelwind",
      "translationMetadata": {
        "fields": {
          "dialogue.c36d05b8ec1836a06bb2": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.ee4d0be8a90c641725a3": {
