            "sourceLocale": "enUS"
          }
        }
      }
    },
    "zhCN": {
      "dialogue": {
        "c36d05b8ec1836a06bb2": "他肯定是个比我好得多的铁匠。不过，要是你告诉别人我这么说过，我可不会承认。你应该去找瑟鲁姆·深炉谈谈。要是有人能教你更多，那一定是他。",
        "ee4d0be8a90c641725a3": "你干得不错，不过让我教你几个可能用得上的诀窍。"
      },
      "name": "戴安·钢风",
      "subName": "Blacksmith",
      "translationMetadata": {
        "fields": {
          "dialogue.c36d05b8ec1836a06bb2": {
