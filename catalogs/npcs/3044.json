    "ltLT": {
      "dialogue": {
        "34617d550e2a197acda8": "Griežtai permokydamas turėjau priversti daugelį mokinių atsisakyti visko, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Šią paslaugą kaskart atlikti darosi vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis daugiau.  Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "5194dbd466a173733265": "Noriu daugiau sužinoti apie žynio kelią.",
        "76aa6d8885b51080afda": "Taip, $c?",
        "7b28252c2c483288111a": "Leisk apžiūrėti tavo prekes.",
        "e09720a8dd2fbc0cd9e6": "Ak, tai tu radai tą laišką. Ačiū už... naujienas apie mano šeimą, nors ir sunku jas taip pavadinti. Gali pasiimti maisto ir gėrimų, kuriuos galiu pasiūlyti.",
        "ed7e9a0477748e5e14d4": "Kuo šis menkas tarnas gali tau padėti, $n? Gal nori pasimokyti?"
      },
      "name": "Miles Welsh",
      "subName": "Žynių mokytojas",
      "translationMetadata": {
