    "ptBR": {
      "dialogue": {
        "34d9d964080c4a93577b": "Treine-me.",
        "73394aa81b5136ec2e5a": "Olá, amigo. Meu nome é Remy. Sou de Redridge, a leste, e vim procurar negócios, procurar negócios. Você tem algum... tem algum??",
        "ace7ceee60c20250eeaa": "Quero ver suas mercadorias."
