    "hrHR": {
      "dialogue": {
        "34d9d964080c4a93577b": "Podučite me.",
        "73394aa81b5136ec2e5a": "Bok, prijatelju. Zovem se Remy. Dolazim iz Redridgea na istoku i došao sam ovamo tražiti posao, tražiti posao. Imaš li kakvog... imaš li??",
        "ace7ceee60c20250eeaa": "Želim pogledati vašu robu."
