      "dialogue": {
        "34d9d964080c4a93577b": "Train me.",
        "73394aa81b5136ec2e5a": "Hey there, friend.  My name's Remy.  I'm from Redridge to the east, and came here looking for business, looking for business.  You got any...got any??",
        "ace7ceee60c20250eeaa": "I want to browse your goods."
      },
      "name": "Remy \"Two Times\"",
