    "deDE": {
      "dialogue": {
        "34d9d964080c4a93577b": "Bildet mich aus.",
        "73394aa81b5136ec2e5a": "He, mein Freund. Man nennt mich Remy. Ich komme aus dem Rotkammgebirge im Osten und bin auf der Suche nach interessanten... Geschäften. Interessanten... Geschäften. Habt Ihr vielleicht welche... vielleicht welche?",
        "ace7ceee60c20250eeaa": "Ich möchte Eure Waren ansehen."
      },
      "name": "Remy \"Zweifach\"",
