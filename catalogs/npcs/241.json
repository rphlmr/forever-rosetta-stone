    "ltLT": {
      "dialogue": {
        "34d9d964080c4a93577b": "Išmokyk mane.",
        "73394aa81b5136ec2e5a": "Sveikas, bičiuli. Mano vardas Remy. Esu iš Redridge rytuose ir atvykau čia ieškoti verslo, ieškoti verslo. Gal turi kokio... turi kokio nors??",
        "ace7ceee60c20250eeaa": "Noriu apžiūrėti tavo prekes."
