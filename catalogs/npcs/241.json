    "plPL": {
      "dialogue": {
        "34d9d964080c4a93577b": "Wyszkol mnie.",
        "73394aa81b5136ec2e5a": "Witaj, przyjacielu. Nazywam się Remy. Pochodzę z Redridge na wschodzie i przybyłem tu szukać interesów, szukać interesów. Masz jakieś... masz jakieś??",
        "ace7ceee60c20250eeaa": "Chcę przejrzeć twoje towary."
