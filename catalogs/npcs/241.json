    "frFR": {
      "dialogue": {
        "34d9d964080c4a93577b": "Entraînez-moi.",
        "73394aa81b5136ec2e5a": "Salut, mon ami.  Je m'appelle Remy.  Je viens de Redridge, à l'est, et je suis venu ici pour faire des affaires, pour faire des affaires.  Vous en avez... vous en avez ? ?",
        "ace7ceee60c20250eeaa": "Je voudrais regarder vos articles."
