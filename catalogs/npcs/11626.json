    "hrHR": {
      "dialogue": {
        "15210011bba54f73a34a": "Danas je tvoj sretan dan; upravo sam završio održavanje Super-Sellera 680. Prodaje hrpu predmeta po izvrsnim niskim cijenama. Samo pogledaj... moj brat Cork misli da će njegov Vendor-Tron 1000 prodati više od mog robota."
      },
      "name": "Rigger Gizelton",
