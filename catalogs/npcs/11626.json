    "enUS": {
      "dialogue": {
        "15210011bba54f73a34a": "This just happens to be your lucky day; I just completed Super-Seller 680's maintenance. There are tons of items for sell at great low-low prices. Go ahead and see for yourself... my brother Cork thinks his Vendor-Tron 1000 will out sell my bot."
      },
      "name": "Rigger Gizelton",
      "translationMetadata": {
        "fields": {
          "dialogue.15210011bba54f73a34a": {
