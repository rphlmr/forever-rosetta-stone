    "daDK": {
      "dialogue": {
        "3ac204ba83e40fb691a8": "Jeg vil gerne se dine varer.",
        "780f890f11415b835998": "Nå, halløj. Du ligner en, der ikke ville have noget imod at tjene lidt mønt, hmm? Jeg kan se det i dine øjne. Jeg er mogul Kebok, ansvarlig for operationerne i Azeroth, og hvis du søger rigdom, kan jeg måske arrangere noget.",
        "d86b1ab21cdeeddcd33e": "Træn mig."
      },
      "name": "Kebok",
