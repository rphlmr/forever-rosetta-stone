  "locales": {
    "csCZ": {
      "dialogue": {
        "3ac204ba83e40fb691a8": "Rád bych si prohlédl vaše zboží.",
        "780f890f11415b835998": "Ale, zdravím tě. Vypadáš jako někdo, komu by nevadilo si přivydělat, hm? Vidím ti to na očích. Jsem Mogul Kebok, dohlížitel na operace v Azerothu, a pokud hledáš bohatství, možná se můžeme domluvit.",
        "d86b1ab21cdeeddcd33e": "Vycvičte mě."
      },
      "name": "Kebok",
