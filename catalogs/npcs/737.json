    "svSE": {
      "dialogue": {
        "3ac204ba83e40fb691a8": "Jag vill se dina varor.",
        "780f890f11415b835998": "Nå, hej där. Du ser ut som någon som inte skulle ha något emot att tjäna lite mynt, hmm? Jag ser det i dina ögon. Jag är mogul Kebok, ansvarig för verksamheten i Azeroth, och om du söker rikedom kanske jag kan ordna något.",
        "d86b1ab21cdeeddcd33e": "Träna mig."
      },
      "name": "Kebok",
