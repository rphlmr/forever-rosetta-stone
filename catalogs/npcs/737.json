    "deDE": {
      "dialogue": {
        "3ac204ba83e40fb691a8": "Ich möchte Eure Waren ansehen.",
        "780f890f11415b835998": "Nun, hallo. Du scheinst nicht abgeneigt zu sein, etwas Geld zu verdienen, hm? Das sehe ich an Eurem Blick. Ich bin Mogul Kebok, Aufseher über Operationen in Azeroth, und wenn Ihr Reichtümer sucht, kann ich vielleicht etwas arrangieren.",
        "d86b1ab21cdeeddcd33e": "Bildet mich aus."
      },
      "name": "Kebok",
