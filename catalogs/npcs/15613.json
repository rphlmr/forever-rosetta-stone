    "daDK": {
      "dialogue": {
        "44861a9e185ed9cda329": "Hvor dødelige silithiderne end virker, er de tamme skabninger sammenlignet med deres Qiraji-herrer."
      },
      "name": "Merok Longstride",
      "translationMetadata": {
        "fields": {
