    "plPL": {
      "dialogue": {
        "16c6f522d83d4d5245e1": "Dzięki rygorystycznemu przekwalifikowaniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Za każdym razem jest to coraz trudniejsze, dlatego kolejne przekwalifikowania kosztują coraz więcej. Czy chcesz, abym oduczył cię zdobytych talentów?",
        "4f9fb6fe308d617ba834": "Przybyłem na szkolenie.",
        "527141b3eed8036e3c21": "Nie mogę cię szkolić.",
        "5c6d015bc93ffbe6592d": "Przybyłem na szkolenie.",
        "dc74067ab73b1c96253c": "Mam ci do przekazania wiele wiedzy, $c. Musisz nauczyć się polować z honorem."
      },
      "name": "Ormak Grimshot",
