    "hrHR": {
      "dialogue": {
        "16c6f522d83d4d5245e1": "Strogim preobučavanjem mnoge sam učenike morao odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Tu je uslugu svaki put sve teže pružiti, pa zato svakim preobučavanjem postaje sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "4f9fb6fe308d617ba834": "Došao sam na obuku.",
        "527141b3eed8036e3c21": "Ne mogu te podučavati.",
        "5c6d015bc93ffbe6592d": "Došao sam na obuku.",
        "dc74067ab73b1c96253c": "Imam ti mnogo znanja prenijeti, $c. Moraš naučiti loviti časno."
      },
      "name": "Ormak Grimshot",
