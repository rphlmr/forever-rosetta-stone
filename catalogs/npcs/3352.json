    "ltLT": {
      "dialogue": {
        "16c6f522d83d4d5245e1": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti visa, ką jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart suteikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad priversčiau tave pamiršti išmoktus talentus?",
        "4f9fb6fe308d617ba834": "Atėjau mokytis.",
        "527141b3eed8036e3c21": "Negaliu tavęs mokyti.",
        "5c6d015bc93ffbe6592d": "Atėjau mokytis.",
        "dc74067ab73b1c96253c": "Turiu daug žinių, kurias noriu tau perduoti, $c. Turi išmokti medžioti garbingai."
      },
      "name": "Ormak Grimshot",
      "subName": "Medžiotojų mokytojas",
