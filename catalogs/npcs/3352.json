  "locales": {
    "csCZ": {
      "dialogue": {
        "16c6f522d83d4d5245e1": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dosud naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "4f9fb6fe308d617ba834": "Přišel jsem se cvičit.",
        "527141b3eed8036e3c21": "Nemohu tě cvičit.",
        "5c6d015bc93ffbe6592d": "Přišel jsem se cvičit.",
        "dc74067ab73b1c96253c": "Mohu ti předat mnoho znalostí, $c. Musíš se naučit lovit se ctí."
      },
      "name": "Ormak Grimshot",
      "translationMetadata": {
        "fields": {
