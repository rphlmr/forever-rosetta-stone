    "ltLT": {
      "dialogue": {
        "2138ba3d82c9ecdc3402": "Nori tapti kalviu? Kalti geležtes, kuriomis galėtum išdoroti priešą? Kūjus, kuriais sutraiškytum jo kaukolę? Taip, galiu padėti, ir mielai, jei dėl to liesis kraujas.",
        "5d3e91f533662f5a3e87": "Tu gaišini mano laiką, eik pasikalbėti su mano mokiniu Basil.",
        "d0de9f6cae9da2010e9d": "Išmokyk mane.",
        "d12adfc65e552f9f93df": "Koks tavo plieno aštrumas? Ar pakankamas perrėžti priešo pilvą? Parodysiu tau keletą dalykų, kad jis taptų dar aštresnis."
      },
      "name": "James Van Brunt",
      "subName": "Kalvystės ekspertas",
      "translationMetadata": {
