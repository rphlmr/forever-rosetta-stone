    "enUS": {
      "dialogue": {
        "2138ba3d82c9ecdc3402": "Want to be a smith? Want to forge blades to gut your foe? Hammers to crush his skull? Aye I can help, and gladly too if there is blood to be shed from it.",
        "5d3e91f533662f5a3e87": "You waste my time, go talk with my student Basil.",
        "d0de9f6cae9da2010e9d": "Train me.",
        "d12adfc65e552f9f93df": "How is the edge of your steel? Good enough to cut through the belly of your enemy? Let me show you some things to make it even sharper."
      },
      "name": "James Van Brunt",
      "subName": "Expert Blacksmith",
      "translationMetadata": {
        "fields": {
          "dialogue.2138ba3d82c9ecdc3402": {
