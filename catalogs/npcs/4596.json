    "daDK": {
      "dialogue": {
        "2138ba3d82c9ecdc3402": "Vil du være smed? Smede klinger til at flænse din fjende? Hamre til at knuse hans kranium? Ja, jeg hjælper gerne, hvis det får blodet til at flyde.",
        "5d3e91f533662f5a3e87": "Du spilder min tid. Tal med min elev Basil.",
        "d0de9f6cae9da2010e9d": "Træn mig.",
        "d12adfc65e552f9f93df": "Hvordan er æggen på dit stål? Skarp nok til at skære gennem din fjendes mave? Lad mig vise dig, hvordan du gør den endnu skarpere."
      },
      "name": "James Van Brunt",
      "translationMetadata": {
        "fields": {
          "dialogue.2138ba3d82c9ecdc3402": {
            "origin": "ai",
