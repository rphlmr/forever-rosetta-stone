  "locales": {
    "csCZ": {
      "dialogue": {
        "2138ba3d82c9ecdc3402": "Chceš být kovářem? Kovat čepele, kterými vykucháš nepřítele? Kladiva, kterými mu rozdrtíš lebku? Ano, rád ti pomohu, pokud při tom poteče krev.",
        "5d3e91f533662f5a3e87": "Ztrácíš můj čas, běž si promluvit s mým žákem Basilem.",
        "d0de9f6cae9da2010e9d": "Vycvičte mě.",
        "d12adfc65e552f9f93df": "Jak ostrá je tvá ocel? Dost na to, aby rozřízla břicho nepřítele? Ukážu ti pár věcí, díky nimž bude ještě ostřejší."
      },
      "name": "James Van Brunt",
      "translationMetadata": {
        "fields": {
          "dialogue.2138ba3d82c9ecdc3402": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
