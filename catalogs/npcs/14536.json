    "plPL": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Co roku o tej porze przybywam do Silithus. Pogoda wspaniale działa na moje haluksy.$B$BPowinieneś wybrać się ze mną na spacer, przyjacielu. Podziwiać widoki i tak dalej."
      },
      "name": "Nelson Miły",
      "translationMetadata": {
        "fields": {
          "dialogue.3c9956640623c0f81ccb": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
