            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Щороку приблизно цієї пори я приїжджаю до Силітуса. Тутешня погода чудово діє на мої ґулі на ногах.$B$BХодімо зі мною на прогулянку, друже. Помилуємося краєвидами й таке інше."
      },
      "name": "Нельсон Милий",
      "translationMetadata": {
        "fields": {
          "dialogue.3c9956640623c0f81ccb": {
