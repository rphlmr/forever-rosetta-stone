    "hrHR": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Svake godine u ovo vrijeme dolazim u Silithus. Vrijeme je izvrsno za moje čukljeve.$B$BTrebao bi prošetati sa mnom, prijatelju. Uživati u prizorima i slično."
      },
      "name": "Dobri Nelson",
      "translationMetadata": {
