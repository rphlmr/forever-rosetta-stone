            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Jeg kommer til Silithus hvert år på denne tid. Vejret er fantastisk for mine knyster.$B$BDu burde gå en tur med mig, ven. Nyde udsigten og den slags."
      },
      "name": "Nelson den rare",
      "translationMetadata": {
        "fields": {
          "dialogue.3c9956640623c0f81ccb": {
