    },
    "svSE": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Jag kommer till Silithus varje år vid den här tiden. Vädret gör underverk för mina knölar på fötterna.$B$BDu borde ta en promenad med mig, vännen. Njuta av utsikten och sådant."
      },
      "name": "Nelson den snälle",
      "translationMetadata": {
        "fields": {
