          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Venho pra Silithus todo ano nessa mesma época. O clima daqui é ótimo para os meus joanetes.\n\nPor que você não dá uma volta comigo, aproveita a vista e tudo mais?"
      },
      "name": "Nelson, o Simpático",
      "translationMetadata": {
        "fields": {
