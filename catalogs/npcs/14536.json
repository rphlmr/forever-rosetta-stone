  "locales": {
    "csCZ": {
      "dialogue": {
        "3c9956640623c0f81ccb": "Každý rok touto dobou přijíždím do Silithu. To počasí dělá mým vbočeným palcům ohromně dobře.$B$BMěl by ses se mnou projít, příteli. Pokochat se krajinou a tak."
      },
      "name": "Nelson Milý",
      "translationMetadata": {
        "fields": {
          "dialogue.3c9956640623c0f81ccb": {
