    "enUS": {
      "dialogue": {
        "3c9956640623c0f81ccb": "I come to Silithus every year around this time. The weather is phenomenal for my bunions.$B$BYou should take a stroll with me, friend. Enjoy the sights and what not."
      },
      "name": "Nelson the Nice",
      "translationMetadata": {
        "fields": {
          "dialogue.3c9956640623c0f81ccb": {
