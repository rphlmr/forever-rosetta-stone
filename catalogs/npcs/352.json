    "ltLT": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Kur norėtum nukeliauti, $g vaikinai : mergina;? Už kelias monetas mano grifai nuskraidins tave greičiau nei pats sparčiausias žirgas.",
        "7ab95997c68fc1f05442": "Šie didingi žvėrys žino kelius, kurių pėsčias nerastum. Jie greitai tave nuskraidins ir galbūt pakeliui parodys ką nors naujo.",
        "d3f000544a7e3b98cf63": "Kur norėtum nukeliauti, $g vaikinai : mergina;? Už kelias monetas mano grifai nuskraidins tave greičiau nei pats sparčiausias žirgas.",
        "zephras:98797742440707d71822": "Man reikia paskristi."
      },
      "name": "Dungar Longdrink",
      "subName": "Grifų meistras",
