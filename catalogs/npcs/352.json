    "itIT": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Dov'è che vuoi andare, ragazzo? Per poche monete i miei Grifoni ti ci portano più in fretta perfino del cavallo più veloce.",
        "7ab95997c68fc1f05442": "Queste grandi bestie conoscono vie che a piedi non trovi, ti portano là in fretta e magari intanto ti fanno pure vedere qualcosa di nuovo.",
        "d3f000544a7e3b98cf63": "Dov'è che vuoi andare, ragazza? Per poche monete i miei Grifoni ti ci portano più in fretta perfino del cavallo più veloce.",
        "zephras:98797742440707d71822": "Ho bisogno di un passaggio."
      },
      "name": "Dungar Longdrink",
