    "daDK": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Hvor vil du gerne hen, $gknægt:pige;? For blot et par mønter kan mine griffer bringe dig derhen hurtigere end selv den hurtigste hest.",
        "7ab95997c68fc1f05442": "Disse store dyr kender veje, du ikke finder til fods. De bringer dig hurtigt frem og viser dig måske noget nyt undervejs.",
        "d3f000544a7e3b98cf63": "Hvor vil du gerne hen, $gknægt:pige;? For blot et par mønter kan mine griffer bringe dig derhen hurtigere end selv den hurtigste hest.",
        "zephras:98797742440707d71822": "Jeg har brug for et lift."
      },
      "name": "Dungar Longdrink",
