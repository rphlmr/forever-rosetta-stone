  "locales": {
    "csCZ": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Kam se chceš vydat, $gchlapče:děvče;? Za pár mincí tě mí gryfové dopraví rychleji než i ten nejrychlejší kůň.",
        "7ab95997c68fc1f05442": "Tato ohromná zvířata znají cesty, které pěšky nenajdeš. Dopraví tě rychle a možná ti cestou ukážou něco nového.",
        "d3f000544a7e3b98cf63": "Kam se chceš vydat, $gchlapče:děvče;? Za pár mincí tě mí gryfové dopraví rychleji než i ten nejrychlejší kůň.",
        "zephras:98797742440707d71822": "Potřebuji odvoz."
      },
      "name": "Dungar Longdrink",
