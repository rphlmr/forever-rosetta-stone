    "enUS": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Where is it ye would like to go $g lad : lass;? For just a few coin my Gryphons can get ye there faster than even the swiftest horse.",
        "7ab95997c68fc1f05442": "These great beasts know paths that ye can't find on foot, they'll get ye there fast and maybe show ye something new at the same time.",
        "d3f000544a7e3b98cf63": "Where is it ye would like to go $g lad : lass;? For just a few coin my Gryphons can get ye there faster than even the swiftest horse.",
        "zephras:98797742440707d71822": "I need a ride."
      },
      "name": "Dungar Longdrink",
      "subName": "Gryphon Master",
      "translationMetadata": {
        "fields": {
