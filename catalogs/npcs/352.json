    "hrHR": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Kamo želiš ići, $gdečko:djevojko;? Za samo nekoliko novčića moji će te grifoni odvesti brže od najbržeg konja.",
        "7ab95997c68fc1f05442": "Ove velike zvijeri poznaju putove koje ne možeš naći pješice. Brzo će te odvesti i možda ti usput pokazati nešto novo.",
        "d3f000544a7e3b98cf63": "Kamo želiš ići, $gdečko:djevojko;? Za samo nekoliko novčića moji će te grifoni odvesti brže od najbržeg konja.",
        "zephras:98797742440707d71822": "Trebam prijevoz."
      },
      "name": "Dungar Longdrink",
