    "plPL": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Dokąd chcesz się udać, $gchłopcze:dziewczyno;? Za kilka monet moje gryfy zabiorą cię tam szybciej niż najprędszy koń.",
        "7ab95997c68fc1f05442": "Te wielkie stworzenia znają szlaki, których nie znajdziesz pieszo. Zabiorą cię szybko i może przy okazji pokażą ci coś nowego.",
        "d3f000544a7e3b98cf63": "Dokąd chcesz się udać, $gchłopcze:dziewczyno;? Za kilka monet moje gryfy zabiorą cię tam szybciej niż najprędszy koń.",
        "zephras:98797742440707d71822": "Potrzebuję transportu."
      },
      "name": "Dungar Longdrink",
      "translationMetadata": {
