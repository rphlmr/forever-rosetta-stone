    "trTR": {
      "dialogue": {
        "5a685ee5a6099fc508b5": "Nereye gitmek istersin $gdelikanlı:kızım;? Birkaç sikkeye grifonlarım seni en hızlı attan bile daha hızlı götürür.",
        "7ab95997c68fc1f05442": "Bu büyük yaratıklar yürüyerek bulamayacağın yolları bilir; seni hızla götürür, belki de yol boyunca yeni bir şey gösterirler.",
        "d3f000544a7e3b98cf63": "Nereye gitmek istersin $gdelikanlı:kızım;? Birkaç sikkeye grifonlarım seni en hızlı attan bile daha hızlı götürür.",
        "zephras:98797742440707d71822": "Bir yere gitmem gerekiyor."
      },
      "name": "Dungar Longdrink",
