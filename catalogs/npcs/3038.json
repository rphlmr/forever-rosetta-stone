  "locales": {
    "csCZ": {
      "dialogue": {
        "29f67c27d2bbc6afc230": "Potřebuji výcvik.",
        "37b0f5b47936af8f64eb": "Cvičím lovce ve způsobech a tradicích našich předků.",
        "42d9e3129c628826d00b": "Nemám znalosti, které hledáš.",
        "72fd0db2350cf7e53281": "Při náročném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým dalším přeškolením těžší provést. Proto je také pokaždé dražší. Přeješ si, abych tě odnaučil tvé naučené talenty?"
      },
      "name": "Kary Thunderhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.29f67c27d2bbc6afc230": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.37b0f5b47936af8f64eb": {
