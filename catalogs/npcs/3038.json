    "trTR": {
      "dialogue": {
        "29f67c27d2bbc6afc230": "Eğitime ihtiyacım var.",
        "37b0f5b47936af8f64eb": "Avcıları atalarımızın usulleri ve gelenekleri konusunda eğitirim.",
        "42d9e3129c628826d00b": "Aradığın bilgiye sahip değilim.",
        "72fd0db2350cf7e53281": "Sıkı bir yeniden eğitimle birçok öğrenciye daha önce öğrendikleri her şeyi unutturmam gerekti, böylece onlara yeniden öğretebildim. Sunduğum hizmet her tekrarlandığında daha da zorlaşıyor. Bu nedenle her yeniden eğitimde ücreti artıyor. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?"
      },
      "name": "Kary Thunderhorn",
      "translationMetadata": {
