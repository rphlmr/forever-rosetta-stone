        }
      }
    },
    "daDK": {
      "dialogue": {
        "29f67c27d2bbc6afc230": "Jeg har brug for træning.",
        "37b0f5b47936af8f64eb": "Jeg træner jægere i vores forfædres skikke og traditioner.",
        "42d9e3129c628826d00b": "Jeg har ikke den viden, du søger.",
        "72fd0db2350cf7e53281": "Gennem grundig genoptræning har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem op på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre for hver gang. Derfor bliver den også dyrere ved hver genoptræning. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?"
      },
      "name": "Kary Thunderhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.29f67c27d2bbc6afc230": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
