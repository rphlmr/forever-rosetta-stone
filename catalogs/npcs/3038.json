    "hrHR": {
      "dialogue": {
        "29f67c27d2bbc6afc230": "Potrebna mi je obuka.",
        "37b0f5b47936af8f64eb": "Podučavam lovce običajima i tradicijama naših predaka.",
        "42d9e3129c628826d00b": "Nemam znanje koje tražiš.",
        "72fd0db2350cf7e53281": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučavati. Uslugu koju nudim sve je teže izvesti svaki put kad se ponovi. Zbog toga je svaka preobuka skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Kary Thunderhorn",
      "translationMetadata": {
