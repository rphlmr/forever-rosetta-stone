          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, przybyłem zbadać, jak rozległe są skutki działania Fel Moss w Darkshore. Skażenie Teldrassilu i okolicznych ziem bardzo niepokoi druidów z Cenarian Circle oraz wszystkie nocne elfy.$B$BChcę odkryć przyczynę i położyć temu kres."
      },
      "name": "Terenthis",
      "translationMetadata": {
        "fields": {
