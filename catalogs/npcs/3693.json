          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, Fel Moss’un Darkshore boyunca etkilerinin ne kadar yayıldığını öğrenmeye geldim. Teldrassil’in ve çevre topraklarımızın yozlaşması Cenarian Circle druidlerini ve tüm gece elflerini çok endişelendiriyor.$B$BAmacım bunun neden olduğunu bulmak ve buna son vermek."
      },
      "name": "Terenthis",
      "translationMetadata": {
        "fields": {
