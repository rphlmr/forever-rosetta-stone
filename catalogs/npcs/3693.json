    "hrHR": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, došao sam saznati koliko su učinci Fel Mossa rašireni diljem Darkshorea. Iskvarenost Teldrassila i okolnih zemalja jako zabrinjava druide Cenarian Circlea i sve noćne vilenjake.$B$BMoj je cilj otkriti zašto se to dogodilo i stati tome na kraj."
      },
      "name": "Terenthis",
      "translationMetadata": {
