          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, jag har kommit för att ta reda på hur utbredda effekterna av Fel Moss är i Darkshore. Fördärvet i Teldrassil och våra omgivande länder oroar druiderna i Cenarian Circle och alla nattalver djupt.$B$BMitt mål är att ta reda på varför det har hänt och sätta stopp för det."
      },
      "name": "Terenthis",
      "translationMetadata": {
