  "locales": {
    "csCZ": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, přišel jsem zjistit, jak rozsáhlé jsou účinky Fel Moss na Darkshore. Zkaženost Teldrassilu a okolních zemí velmi znepokojuje druidy Cenarian Circle i všechny noční elfy.$B$BMým cílem je zjistit, proč se to stalo, a skoncovat s tím."
      },
      "name": "Terenthis",
      "translationMetadata": {
        "fields": {
          "dialogue.70009f26aecc5a951f5e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
