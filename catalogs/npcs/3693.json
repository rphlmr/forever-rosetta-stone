            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, jeg er kommet for at finde ud af, hvor udbredt Fel Moss’ virkninger er i Darkshore. Fordærvet i Teldrassil og de omkringliggende lande bekymrer druiderne i Cenarian Circle og alle natelvere dybt.$B$BMit mål er at finde årsagen og gøre en ende på det."
      },
      "name": "Terenthis",
      "translationMetadata": {
        "fields": {
          "dialogue.70009f26aecc5a951f5e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, ich kam hierher, um herauszufinden, wie bedrohlich die Auswirkungen von Teufelsmoos in Dunkelküste sind. Die Verderbnis von Teldrassil und den umliegenden Ländern erfüllt die Druiden des Zirkels des Cenarius und alle Nachtelfen mit Besorgnis.\n\nMein Ziel ist, herauszufinden, warum es dazu gekommen ist, und dem ein Ende zu bereiten."
      },
      "name": "Terenthis",
      "translationMetadata": {
        "fields": {
          "dialogue.70009f26aecc5a951f5e": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
