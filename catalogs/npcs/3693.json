          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, eu vim aqui descobrir até que ponto o Limo Vil se espalhou pela Costa Negra. A corrupção de Teldrassil e dos arredores realmente preocupa os druidas do Círculo Cenariano e todos os elfos noturnos.\n\nQuero descobrir porque isso aconteceu e acabar com o problema."
      },
      "name": "Terenthis",
      "translationMetadata": {
        "fields": {
          "dialogue.70009f26aecc5a951f5e": {
