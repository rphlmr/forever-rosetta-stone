    },
    "ltLT": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, atvykau išsiaiškinti, kaip plačiai Darkshore paplitęs Fel Moss poveikis. Teldrassil ir aplinkinių žemių sugedimas kelia didelį nerimą Cenarian Circle druidams ir visiems nakties elfams.$B$BTrokštu sužinoti, kodėl taip nutiko, ir padaryti tam galą."
      },
      "name": "Terenthis",
      "translationMetadata": {
