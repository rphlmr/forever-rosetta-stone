            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "70009f26aecc5a951f5e": "$N, мне нужно выяснить, насколько сильно Мох Скверны распространился на Темном берегу. Состояние Тельдрассила и близлежащих земель очень сильно беспокоит друидов Круга Кенариуса и всех ночных эльфов.\n\nЯ должен узнать, почему это случилось, и положить этому конец."
      },
      "name": "Терентис",
      "translationMetadata": {
        "fields": {
          "dialogue.70009f26aecc5a951f5e": {
