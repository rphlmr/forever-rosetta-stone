    "enUS": {
      "dialogue": {
        "2d2bc01a5e4f19d43785": "Being part of the Explorers' League, I've been hunting for artifacts in the area. Winterspring is said to contain very magical items... Most are highly guarded."
      },
      "name": "Jaron Stoneshaper",
      "subName": "Explorers' League",
