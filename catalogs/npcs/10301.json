    "daDK": {
      "dialogue": {
        "2d2bc01a5e4f19d43785": "Som medlem af Explorers’ League har jeg ledt efter artefakter her i området. Winterspring siges at rumme meget magiske genstande... De fleste er stærkt bevogtede."
      },
      "name": "Jaron Stoneshaper",
      "translationMetadata": {
