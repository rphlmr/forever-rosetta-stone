    "daDK": {
      "dialogue": {
        "289d2b2336ef2bd1b32f": "Jeg håber, Lyset er med dig, $n. Er der noget, jeg kan gøre for dig i dag?",
        "2fbc4262705deb94b543": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?",
        "5e0ae96de957825ce1f8": "Må Lyset beskytte dig, $c.",
        "a945de44d7e388793dd0": "Jeg søger mere træning i præsternes kunst."
      },
      "name": "Theodrus Frostbeard",
      "translationMetadata": {
        "fields": {
