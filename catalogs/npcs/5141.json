  "locales": {
    "csCZ": {
      "dialogue": {
        "289d2b2336ef2bd1b32f": "Doufám, že je Světlo s tebou, $n. Mohu pro tebe dnes něco udělat?",
        "2fbc4262705deb94b543": "Při důkladném přeškolování jsem musel mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým opakováním těžší provést. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "5e0ae96de957825ce1f8": "Nechť tě Světlo chrání, $c.",
        "a945de44d7e388793dd0": "Hledám další výcvik v kněžském umění."
      },
      "name": "Theodrus Frostbeard",
      "translationMetadata": {
        "fields": {
          "dialogue.289d2b2336ef2bd1b32f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
