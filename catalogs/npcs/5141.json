    "enUS": {
      "dialogue": {
        "289d2b2336ef2bd1b32f": "I hope the Light is with you, $n. Is there anything I can do for you today?",
        "2fbc4262705deb94b543": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "5e0ae96de957825ce1f8": "The Light protect you, $c.",
        "a945de44d7e388793dd0": "I seek more training in the priestly ways."
      },
      "name": "Theodrus Frostbeard",
      "subName": "Priest Trainer",
      "translationMetadata": {
        "fields": {
