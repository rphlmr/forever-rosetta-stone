    "hrHR": {
      "dialogue": {
        "2258c842a91dd02c56e1": "Dobro došao u Bonegripove Rune i Propast, $c. Možeš gledati, ali ne diraj.$B$BDio znanja ovdje nije namijenjen... neupućenima.",
        "26a5f4a0a411a96c09ae": "Podučite me.",
