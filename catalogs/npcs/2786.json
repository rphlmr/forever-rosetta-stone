    "daDK": {
      "dialogue": {
        "2258c842a91dd02c56e1": "Velkommen til Bonegrips Runer og Undergang, $c. Du må se, men ikke røre.$B$BNoget af kundskaben her er ikke for... uindviede.",
        "26a5f4a0a411a96c09ae": "Træn mig.",
        "7d279d626b6188924459": "Jeg vil gerne se dine varer."
