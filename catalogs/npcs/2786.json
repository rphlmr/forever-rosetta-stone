    "plPL": {
      "dialogue": {
        "2258c842a91dd02c56e1": "Witaj w Runach i Zagładach Bonegripa, $c. Możesz patrzeć, ale niczego nie dotykaj.$B$BCzęść tutejszej wiedzy nie jest przeznaczona dla... niewtajemniczonych.",
        "26a5f4a0a411a96c09ae": "Wyszkol mnie.",
        "7d279d626b6188924459": "Chcę przejrzeć twoje towary."
