    "csCZ": {
      "dialogue": {
        "2258c842a91dd02c56e1": "Vítej v Kostistiskových runách a záhubách, $c. Můžeš se dívat, ale ničeho se nedotýkej.$B$BNěkteré zdejší vědomosti nejsou určeny... nezasvěceným.",
        "26a5f4a0a411a96c09ae": "Vycvičte mě.",
        "7d279d626b6188924459": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Gerrig Bonegrip",
      "translationMetadata": {
