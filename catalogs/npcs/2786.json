    "enUS": {
      "dialogue": {
        "2258c842a91dd02c56e1": "Welcome to Bonegrip's Runes and Dooms, $c.  You may look, but do not touch.$B$BSome of the knowledge here is not meant for the...uninitiated.",
        "26a5f4a0a411a96c09ae": "Train me.",
        "7d279d626b6188924459": "I want to browse your goods."
