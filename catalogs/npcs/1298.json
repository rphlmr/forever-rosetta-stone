    "trTR": {
      "dialogue": {
        "b42410b48ea8f6dacf14": "Sadece mallarıma mı bakıyorsun, yoksa bugün belirli bir şey bulmana yardım edebilir miyim?",
        "e3c21e3edb6afb7ec37e": "Mallarına bakmak istiyorum.",
        "fafb6fa29a931dbdb328": "Tüm Stormwind'deki en iyi fırsatlar burada dostum, daha iyisini bulamazsın. Sana nasıl yardımcı olabilirim?"
      },
      "name": "Frederick Stover",
