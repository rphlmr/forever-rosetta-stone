    "svSE": {
      "dialogue": {
        "b42410b48ea8f6dacf14": "Tittar du bara på mina varor, eller kan jag hjälpa dig att hitta något särskilt i dag?",
        "e3c21e3edb6afb7ec37e": "Jag vill se dina varor.",
        "fafb6fa29a931dbdb328": "De bästa erbjudandena i hela Stormwind, min vän. Du hittar inga bättre. Vad kan jag hjälpa dig med?"
      },
      "name": "Frederick Stover",
