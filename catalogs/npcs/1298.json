    "csCZ": {
      "dialogue": {
        "b42410b48ea8f6dacf14": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "e3c21e3edb6afb7ec37e": "Rád bych si prohlédl vaše zboží.",
        "fafb6fa29a931dbdb328": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?"
      },
      "name": "Frederick Stover",
