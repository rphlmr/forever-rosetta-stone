    "daDK": {
      "dialogue": {
        "b42410b48ea8f6dacf14": "Kigger du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?",
        "e3c21e3edb6afb7ec37e": "Jeg vil gerne se dine varer.",
        "fafb6fa29a931dbdb328": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe dig med?"
      },
      "name": "Frederick Stover",
