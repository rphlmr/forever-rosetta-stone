    "daDK": {
      "dialogue": {
        "1198c34f9599f8f04495": "Jeg kan lære dig detaljerne i at ride på skeletlig hest, hvis du har nok guld til undervisningen!",
        "83c52a648724254aa0b6": "Jeg søger undervisning i at ride på et ridedyr.",
        "a6f7bf5c51f6bce543aa": "Du skal være ophøjet hos De Forsagtes folk i Undercity, før jeg lærer dig at ride, $c.",
        "b6d995e1b59214dcb6fd": "Jeg kan ikke lære en tauren at ride på et skeletisk ridedyr. Beklager, men jeg kan ikke gøre noget for dig."
      },
      "name": "Velma Warnam",
      "translationMetadata": {
        "fields": {
