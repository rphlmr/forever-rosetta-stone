  "locales": {
    "csCZ": {
      "dialogue": {
        "1198c34f9599f8f04495": "Mohu tě naučit jemnostem jízdy na kostěném koni, pokud máš dost zlata na zaplacení lekce!",
        "83c52a648724254aa0b6": "Hledám výcvik v jízdě na jezdeckém zvířeti.",
        "a6f7bf5c51f6bce543aa": "Než tě naučím jezdit, musíš si získat nejvyšší přízeň Opuštěných z Undercity, $c.",
        "b6d995e1b59214dcb6fd": "Taurena nedokážu naučit jezdit na kostěném oři. Je mi líto, ale nemohu pro tebe nic udělat."
      },
      "name": "Velma Warnam",
      "translationMetadata": {
        "fields": {
          "dialogue.1198c34f9599f8f04495": {
