    "trTR": {
      "dialogue": {
        "1198c34f9599f8f04495": "Dersin ücretini karşılayacak kadar altının varsa sana iskelet ata binmenin inceliklerini öğretebilirim!",
        "83c52a648724254aa0b6": "Bir bineğe binmeyi öğrenmek istiyorum.",
        "a6f7bf5c51f6bce543aa": "Sana binicilik öğretmeden önce Undercity’nin Forsaken halkı arasında yüce bir itibara ulaşmalısın, $c.",
        "b6d995e1b59214dcb6fd": "Bir Tauren’e iskelet bineğe binmeyi öğretemem. Üzgünüm ama senin için yapabileceğim bir şey yok."
      },
      "name": "Velma Warnam",
