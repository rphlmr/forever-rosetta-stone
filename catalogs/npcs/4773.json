    "hrHR": {
      "dialogue": {
        "1198c34f9599f8f04495": "Mogu te podučiti umijeću jahanja kosturnog konja, pod uvjetom da imaš dovoljno zlata za lekciju!",
        "83c52a648724254aa0b6": "Želim naučiti jahati jahaću životinju.",
        "a6f7bf5c51f6bce543aa": "Moraš uživati najveći ugled među Napuštenima iz Undercityja prije nego što te naučim jahati, $c.",
        "b6d995e1b59214dcb6fd": "Ne mogu naučiti taurena jahati kosturnog jahaćeg konja. Žao mi je, ali ne mogu ti pomoći."
      },
      "name": "Velma Warnam",
