    "plPL": {
      "dialogue": {
        "1198c34f9599f8f04495": "Mogę nauczyć cię tajników jazdy na szkielecie konia, jeśli masz dość złota, by zapłacić za lekcję!",
        "83c52a648724254aa0b6": "Szukam szkolenia w jeździe na wierzchowcu.",
        "a6f7bf5c51f6bce543aa": "Musisz cieszyć się najwyższym uznaniem Opuszczonych z Undercity, zanim nauczę cię jazdy, $c.",
        "b6d995e1b59214dcb6fd": "Nie mogę nauczyć taurena jazdy na szkieletowym wierzchowcu. Przykro mi, ale nic nie mogę dla ciebie zrobić."
      },
      "name": "Velma Warnam",
