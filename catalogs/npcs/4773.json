    "enUS": {
      "dialogue": {
        "1198c34f9599f8f04495": "I can teach you the finer points of Skeletal Horse Riding, provided you have enough gold to cover the lesson!",
        "83c52a648724254aa0b6": "I seek training to ride a steed.",
        "a6f7bf5c51f6bce543aa": "You need to be exalted with the Forsaken of the Undercity before I will teach you a riding skill, $c.",
        "b6d995e1b59214dcb6fd": "I am unable to teach a Tauren to ride a Skeletal Mount.  I am sorry but there is nothing I can do for you."
      },
      "name": "Velma Warnam",
      "subName": "Undead Horse Riding Instructor",
      "translationMetadata": {
