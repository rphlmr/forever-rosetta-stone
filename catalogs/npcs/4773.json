    "itIT": {
      "dialogue": {
        "1198c34f9599f8f04495": "Posso insegnarti i segreti dello Skeletal Horse Riding, se hai abbastanza oro per pagare la lezione!",
        "83c52a648724254aa0b6": "Cerco un addestramento per cavalcare una cavalcatura.",
        "a6f7bf5c51f6bce543aa": "Devi essere exalted con i Reietti di Undercity prima che io ti insegni a cavalcare, $C.",
        "b6d995e1b59214dcb6fd": "Non posso insegnare a un Tauren a cavalcare una Cavalcatura Scheletrica. Mi dispiace, ma non posso fare niente per te."
      },
      "name": "Velma Warnam",
