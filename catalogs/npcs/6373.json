  "locales": {
    "csCZ": {
      "dialogue": {
        "0b8141481cc38cde4646": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "33e0548263d89689f76b": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě.",
        "4cd03a9664a76b971f2f": "Ukažte mi svou nabídku grimoárů."
      },
      "name": "Dane Winslow",
      "translationMetadata": {
        "fields": {
          "dialogue.0b8141481cc38cde4646": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
