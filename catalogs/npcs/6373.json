    },
    "daDK": {
      "dialogue": {
        "0b8141481cc38cde4646": "Du er ikke troldmand, og jeg har ikke tid til dig. Forsvind!",
        "33e0548263d89689f76b": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted.",
        "4cd03a9664a76b971f2f": "Vis mig dit udvalg af grimoirer."
      },
      "name": "Dane Winslow",
      "translationMetadata": {
        "fields": {
