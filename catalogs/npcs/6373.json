    "enUS": {
      "dialogue": {
        "0b8141481cc38cde4646": "You're no warlock and I've no time for you.  Begone!",
        "33e0548263d89689f76b": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place.",
        "4cd03a9664a76b971f2f": "Show me your selection of grimoires."
      },
      "name": "Dane Winslow",
      "subName": "Demon Trainer",
