    "hrHR": {
      "dialogue": {
        "0b8141481cc38cde4646": "Nisi vještac i nemam vremena za tebe. Gubi se!",
        "33e0548263d89689f76b": "Želiš osnažiti svoje demone? To će te stajati, ali na pravom si mjestu.",
        "4cd03a9664a76b971f2f": "Pokažite mi svoj izbor grimoara."
      },
      "name": "Dane Winslow",
