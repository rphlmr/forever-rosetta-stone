    "plPL": {
      "dialogue": {
        "0b8141481cc38cde4646": "Nie jesteś czarnoksiężnikiem i nie mam dla ciebie czasu. Precz!",
        "33e0548263d89689f76b": "Chcesz wzmocnić swoje demony? Będzie cię to kosztować, ale jesteś we właściwym miejscu.",
        "4cd03a9664a76b971f2f": "Pokaż mi swoją ofertę grymuarów."
