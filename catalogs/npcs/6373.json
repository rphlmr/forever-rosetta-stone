    "deDE": {
      "dialogue": {
        "0b8141481cc38cde4646": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "33e0548263d89689f76b": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "4cd03a9664a76b971f2f": "Zeigt mir Eure Auswahl an Grimoires."
      },
      "name": "Dane Winslow",
      "subName": "Dämonenausbilder",
