  "locales": {
    "csCZ": {
      "dialogue": {
        "41cecf87ebd88a4f7ebf": "Je mi ctí tě poznat, $n, ale tvé dovednosti v přípravě lektvarů převyšují mé. Navštiv doktora Herberta Halseyho, nemrtvého v Apothecarium v Undercity. Odteď ti může pomoci on.",
        "520199d6e7907f0a660f": "Mám práci, $n. Řekni Whuutovi, ať to vyřídí, ať už je to cokoli. Ten mladý kluk se celý den užírá. Jestli v tom bude pokračovat, něco si udělá.",
        "65c30c3965d7829221ce": "Mluvíš s nesprávným orkem. Nováčky necvičím. Promluv si s mladým Whuutem tamhle... a používej jednoduchá slova.",
        "f825122ea8e42665e202": "Další žák, co? Dobře. Uvidím, jak ti mohu pomoci.",
        "fe180029c1a25689cc50": "Vycvičte mě."
      },
      "name": "Yelmak",
      "translationMetadata": {
        "fields": {
          "dialogue.41cecf87ebd88a4f7ebf": {
