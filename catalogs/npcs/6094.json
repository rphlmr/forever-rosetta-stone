    "enUS": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "I can train you in First Aid techniques.",
        "2de9b58a81c51be004fa": "I've heard it said that Deneb Walker, holed up in Stromgarde, has a book that is sure to help improve your First Aid techniques.",
        "7a1997936c70c6acba5e": "The esteemed Doctor Gustaf VanHowzen can train you further.  He can be found in Theramore treating the wounded at the barracks.",
        "9c4b71af3e8cb3e9a607": "I require training.",
        "zephras:7f16c2578883279f1933": "Train me."
      },
      "name": "Byancie",
      "subName": "First Aid Trainer",
      "translationMetadata": {
