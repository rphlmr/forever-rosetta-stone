    "trTR": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Sana ilk yardım tekniklerini öğretebilirim.",
        "2de9b58a81c51be004fa": "Stromgarde'da saklanan Deneb Walker'ın ilk yardım becerilerini geliştirmene kesinlikle yardımcı olacak bir kitabı olduğunu duydum.",
        "7a1997936c70c6acba5e": "Saygın Doktor Gustaf VanHowzen sana daha fazlasını öğretebilir. Onu Theramore'da, kışlada yaralıları tedavi ederken bulabilirsin.",
        "9c4b71af3e8cb3e9a607": "Eğitime ihtiyacım var.",
        "zephras:7f16c2578883279f1933": "Beni eğit."
      },
      "name": "Byancie",
      "translationMetadata": {
        "fields": {
