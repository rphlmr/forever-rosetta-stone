    "hrHR": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Mogu te podučiti tehnikama prve pomoći.",
        "2de9b58a81c51be004fa": "Čula sam da Deneb Walker, koja se skriva u Stromgardeu, ima knjigu koja će ti sigurno pomoći da poboljšaš vještine prve pomoći.",
        "7a1997936c70c6acba5e": "Uvaženi doktor Gustaf VanHowzen može te dalje podučavati. Možeš ga pronaći u Theramoreu, gdje liječi ranjenike u vojarni.",
        "9c4b71af3e8cb3e9a607": "Trebam obuku.",
        "zephras:7f16c2578883279f1933": "Podučite me."
      },
      "name": "Byancie",
