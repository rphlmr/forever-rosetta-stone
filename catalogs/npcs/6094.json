    "daDK": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Jeg kan lære dig førstehjælpsteknikker.",
        "2de9b58a81c51be004fa": "Jeg har hørt, at Deneb Walker, som har forskanset sig i Stromgarde, har en bog, der helt sikkert kan forbedre dine førstehjælpsfærdigheder.",
        "7a1997936c70c6acba5e": "Den ansete doktor Gustaf VanHowzen kan lære dig mere. Han behandler sårede i kasernen i Theramore.",
        "9c4b71af3e8cb3e9a607": "Jeg har brug for træning.",
        "zephras:7f16c2578883279f1933": "Træn mig."
      },
      "name": "Byancie",
      "translationMetadata": {
        "fields": {
