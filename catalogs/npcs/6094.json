    "deDE": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "2de9b58a81c51be004fa": "Ich habe gehört, dass Deneb Walker sich momentan in Stromgarde aufhält. Er ist im Besitz eines Buchs, das Euch helfen wird Eure Techniken der Ersten Hilfe zu verbessern.",
        "7a1997936c70c6acba5e": "Der angesehene Doktor Gustav VanHowzen kann Euch weiter ausbilden. Ihr findet ihn in Theramore, er versorgt die Verwundeten in der ansässigen Kaserne.",
        "9c4b71af3e8cb3e9a607": "Ich benötige Ausbildung.",
        "zephras:7f16c2578883279f1933": "Bildet mich aus."
      },
      "name": "Byancie",
      "subName": "Lehrerin für Erste Hilfe",
      "translationMetadata": {
