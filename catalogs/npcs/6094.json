    "ltLT": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Galiu tave išmokyti pirmosios pagalbos būdų.",
        "2de9b58a81c51be004fa": "Girdėjau, kad Stromgarde įsikūrusi Deneb Walker turi knygą, kuri tikrai padės tau patobulinti pirmosios pagalbos įgūdžius.",
        "7a1997936c70c6acba5e": "Gerbiamas daktaras Gustaf VanHowzen gali tave mokyti toliau. Jį rasi Theramore kareivinėse, gydantį sužeistuosius.",
        "9c4b71af3e8cb3e9a607": "Man reikia pamokų.",
        "zephras:7f16c2578883279f1933": "Mokyk mane."
      },
      "name": "Byancie",
      "subName": "Pirmosios pagalbos mokytoja",
