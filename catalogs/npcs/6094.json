    "plPL": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Mogę nauczyć cię technik pierwszej pomocy.",
        "2de9b58a81c51be004fa": "Słyszałam, że Deneb Walker, ukrywająca się w Stromgarde, ma książkę, która z pewnością pomoże ci doskonalić pierwszą pomoc.",
        "7a1997936c70c6acba5e": "Szanowany doktor Gustaf VanHowzen może cię dalej szkolić. Znajdziesz go w Theramore, gdzie opatruje rannych w koszarach.",
        "9c4b71af3e8cb3e9a607": "Potrzebuję szkolenia.",
        "zephras:7f16c2578883279f1933": "Wyszkol mnie."
      },
      "name": "Byancie",
      "translationMetadata": {
