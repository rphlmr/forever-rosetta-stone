  "locales": {
    "csCZ": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Mohu tě naučit techniky první pomoci.",
        "2de9b58a81c51be004fa": "Slyšela jsem, že Deneb Walkerová, která se ukrývá ve Stromgarde, má knihu, jež ti určitě pomůže zlepšit se v první pomoci.",
        "7a1997936c70c6acba5e": "Vážený doktor Gustaf VanHowzen tě může naučit víc. Najdeš ho v Theramore, kde v kasárnách ošetřuje raněné.",
        "9c4b71af3e8cb3e9a607": "Potřebuji výcvik.",
        "zephras:7f16c2578883279f1933": "Vycvičte mě."
      },
      "name": "Byancie",
      "translationMetadata": {
        "fields": {
