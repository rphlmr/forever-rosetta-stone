    "esES": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Puedo enseñarte las técnicas de primeros auxilios.",
        "2de9b58a81c51be004fa": "He oído decir que Deneb Camino, en Stromgarde, tiene un libro que podría ayudarte a mejorar tus técnicas de primeros auxilios.",
        "7a1997936c70c6acba5e": "El estimado doctor Gustav VanHowzen, puede darte una instrucción mejor. Puedes encontrarle en Theramore, cuidando a los enfermos en el cuartel.",
        "9c4b71af3e8cb3e9a607": "Necesito entrenamiento.",
        "zephras:7f16c2578883279f1933": "Entréname."
      },
