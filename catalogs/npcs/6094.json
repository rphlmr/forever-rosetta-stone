    "svSE": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Jag kan lära dig första hjälpen.",
        "2de9b58a81c51be004fa": "Jag har hört att Deneb Walker, som håller till i Stromgarde, har en bok som säkert kan förbättra dina kunskaper i första hjälpen.",
        "7a1997936c70c6acba5e": "Den aktade doktor Gustaf VanHowzen kan lära dig mer. Han finns i Theramore, där han vårdar sårade i kasernen.",
        "9c4b71af3e8cb3e9a607": "Jag behöver träning.",
        "zephras:7f16c2578883279f1933": "Träna mig."
      },
      "name": "Byancie",
      "translationMetadata": {
