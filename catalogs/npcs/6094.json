    "itIT": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Posso insegnarti le tecniche di Primo Soccorso.",
        "2de9b58a81c51be004fa": "Ho sentito dire che Deneb Walker, rintanato a Stromgarde, ha un libro che ti aiuterà di sicuro a migliorare le tue tecniche di primo soccorso.",
        "7a1997936c70c6acba5e": "L'illustre Dottor Gustaf VanHowzen può portare avanti il tuo addestramento. Lo trovi a Theramore, alla caserma, dove cura i feriti.",
        "9c4b71af3e8cb3e9a607": "Ho bisogno di addestramento.",
        "zephras:7f16c2578883279f1933": "Addestrami."
      },
      "name": "Byancie",
