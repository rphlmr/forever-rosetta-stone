    "ptBR": {
      "dialogue": {
        "0555ab9fb22d7cc794ad": "Eu posso lhe ensinar as técnicas de Primeiros Socorros.",
        "2de9b58a81c51be004fa": "Ouvi dizer que Deneb Walker tem um livro que com certeza vai te ajudar a aperfeiçoar sua técnica de Primeiros Socorros. Ele está escondido em Stromgarde.",
        "7a1997936c70c6acba5e": "O estimado Doutor Gregório Casagrande pode prosseguir com o seu treinamento. Ele fica em Theramore, cuidando dos feridos no quartel.",
        "9c4b71af3e8cb3e9a607": "Preciso de treinamento.",
        "zephras:7f16c2578883279f1933": "Treine-me."
      },
      "name": "Byonsa",
      "subName": "Treinamento de Primeiros Socorros",
