  "locales": {
    "csCZ": {
      "dialogue": {
        "72dea1f82e4172aa513b": "Buď zdráv, $r! Jsem poručík Haggerdin, důstojník pověřený náborem do Stormpikeské stráže.$B$BAž si mezi Stormpiky získáš větší věhlas a prestiž, vrať se ke mně a postarám se o vylepšení tvého odznaku. Pokud svůj odznak někdy ztratíš, mohu ti také opatřit náhradní."
      },
      "name": "Poručík Haggerdin",
