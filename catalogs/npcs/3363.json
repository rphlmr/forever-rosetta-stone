    "enUS": {
      "dialogue": {
        "2089bb8e8ad70c252d5e": "You need to learn from someone who knows more than I do. Go talk to Josef Gregorian in Undercity. Well, what are you still doing here?",
        "320eb744f860ba5e6910": "Train me.",
        "45624c7c7dfcfb5cdb80": "I made a lot of the things you see in the store. What do you think? Answer carefully, your life may depend on it.",
        "664041e1b61c15539ce0": "What? Why are you bothering me? Why, I bet you can't even create a high quality robe! Go talk to Snang and come back when you're worthy of my talents!",
        "970c7ac59d59ffe0c6ab": "About time you showed me some results! Now I'll show you results!"
      },
      "name": "Magar",
      "subName": "Expert Tailor",
