  "locales": {
    "csCZ": {
      "dialogue": {
        "2089bb8e8ad70c252d5e": "Musíš se učit od někoho, kdo ví víc než já. Promluv si s Josefem Gregorianem v Undercity. Tak co tu ještě děláš?",
        "320eb744f860ba5e6910": "Vycvičte mě.",
        "45624c7c7dfcfb5cdb80": "Spoustu věcí, které vidíš v obchodě, jsem vyrobil já. Co si myslíš? Odpovídej opatrně, může na tom záviset tvůj život.",
        "664041e1b61c15539ce0": "Co? Proč mě obtěžuješ? Vsadím se, že ani nedokážeš vyrobit kvalitní róbu! Běž za Snangem a vrať se, až budeš hoden mého talentu!",
        "970c7ac59d59ffe0c6ab": "Už bylo načase, abys mi ukázal nějaké výsledky! Teď já ukážu výsledky tobě!"
      },
      "name": "Magar",
      "translationMetadata": {
        "fields": {
          "dialogue.2089bb8e8ad70c252d5e": {
