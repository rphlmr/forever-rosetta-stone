    "frFR": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "987f97d43a6637316bc9": "Je peux vous apprendre à pêcher.",
        "f085f89f018f3b5d2801": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "fe5fe9d5ac51042ca2e1": "Entraînez-moi."
      },
      "name": "Warg Deepwater",
      "subName": "Pêcheur",
