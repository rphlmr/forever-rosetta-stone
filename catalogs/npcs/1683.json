    "deDE": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "987f97d43a6637316bc9": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "f085f89f018f3b5d2801": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern.",
        "fe5fe9d5ac51042ca2e1": "Bildet mich aus."
      },
      "name": "Warg Deepwater",
      "subName": "Angler",
