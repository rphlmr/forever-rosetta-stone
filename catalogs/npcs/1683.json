    "itIT": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "987f97d43a6637316bc9": "Posso insegnarti l'arte della pesca.",
        "f085f89f018f3b5d2801": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità.",
        "fe5fe9d5ac51042ca2e1": "Addestrami."
      },
