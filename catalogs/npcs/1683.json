    "hrHR": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Ako želiš napredovati, moraš pronaći Nata Paglea u Dustwallow Marshu.",
        "987f97d43a6637316bc9": "Mogu te podučiti ribolovu.",
        "f085f89f018f3b5d2801": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige \"The Bass and You\". Ona će ti sigurno pomoći da napreduješ.",
        "fe5fe9d5ac51042ca2e1": "Podučite me."
      },
      "name": "Warg Deepwater",
