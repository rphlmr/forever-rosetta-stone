    "svSE": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Du måste hitta Nat Pagle i Dustwallow Marsh om du vill bli bättre än du är nu.",
        "987f97d43a6637316bc9": "Jag kan lära dig att fiska.",
        "f085f89f018f3b5d2801": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av \"The Bass and You\". Den hjälper dig säkert att bli bättre.",
        "fe5fe9d5ac51042ca2e1": "Träna mig."
      },
      "name": "Warg Deepwater",
