    "enUS": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "987f97d43a6637316bc9": "I can teach you fishing skills.",
        "f085f89f018f3b5d2801": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "fe5fe9d5ac51042ca2e1": "Train me."
      },
      "name": "Warg Deepwater",
      "subName": "Fisherman",
