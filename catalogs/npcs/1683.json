    "trTR": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Daha iyi olmak istiyorsan Dustwallow Marsh’ta Nat Pagle’ı bulmalısın.",
        "987f97d43a6637316bc9": "Sana balık tutmayı öğretebilirim.",
        "f085f89f018f3b5d2801": "Becerin benimkini aşıyor ama Booty Bay’deki Yaşlı Heming’in \"The Bass and You\" kitabının kopyalarına sahip olduğunu duydum. Bu kitap gelişmene mutlaka yardımcı olur.",
        "fe5fe9d5ac51042ca2e1": "Beni eğit."
      },
