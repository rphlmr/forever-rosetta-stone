    "daDK": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre.",
        "987f97d43a6637316bc9": "Jeg kan lære dig at fiske.",
        "f085f89f018f3b5d2801": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"The Bass and You\". Den vil sikkert hjælpe dig med at blive bedre.",
        "fe5fe9d5ac51042ca2e1": "Træn mig."
      },
      "name": "Warg Deepwater",
      "translationMetadata": {
