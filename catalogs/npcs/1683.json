  "locales": {
    "csCZ": {
      "dialogue": {
        "5f290fbb1637f4fd586c": "Pokud se chceš dále zlepšit, musíš najít Nata Paglea v Dustwallow Marsh.",
        "987f97d43a6637316bc9": "Mohu tě naučit rybařit.",
        "f085f89f018f3b5d2801": "Tvá dovednost předčí mou, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „The Bass and You“. Ta ti jistě pomůže se zlepšit.",
        "fe5fe9d5ac51042ca2e1": "Vycvičte mě."
      },
      "name": "Warg Deepwater",
      "translationMetadata": {
