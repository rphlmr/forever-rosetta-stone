    "hrHR": {
      "dialogue": {
        "30881bb033ab50a1a65c": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "3a3c580f3fd36626b433": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prethodno naučili kako bih ih mogao poučiti iznova. Ovu je uslugu svaki put sve teže pružiti. Zato je svako sljedeće preobučavanje skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "634ec006f8bf03a01796": "Neka duhovi budu s tobom.",
        "8c73bb997d3bf4b32fe0": "Ako želiš, osim podučavanja mogu izbrisati znanje o tvojim talentima iz tvojeg uma. Znaj da je postupak svaki put teže izvesti te zbog toga postaje skuplji.",
        "abbb45fc5e9884772435": "Nauči me putovima duhova."
      },
      "name": "Beram Skychaser",
