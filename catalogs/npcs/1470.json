    "ltLT": {
      "dialogue": {
        "6d268a4771462dc5e40d": "Mokyk mane.",
        "7978ebb04717f379a925": "Nemanau, kad atėjai pasikalbėti apie mano mieląją Kali. Na gerai. Vadinasi, eliksyrai. Ar kas nors tau yra sakęs, kad tematai tik vieną dalyką?",
        "962a0e44edff25e941ee": "Nebeturiu ko tavęs išmokyti, $n. Eik įkyrėti Tally Berryfizz; ji yra gnomė, gyvenanti Ironforge išradėjų miestelyje. O kadangi vis tiek ten keliausi, perduok Kali mano meilę.",
        "d3649ae373f2ba5dc69a": "Ar mano mieloji Kali atsiuntė tave pas mane? Ji mano akies obuolėlis."
      },
      "name": "Ghak Healtouch",
      "subName": "Alchemikas pameistrys",
      "translationMetadata": {
