      }
    },
    "daDK": {
      "dialogue": {
        "6d268a4771462dc5e40d": "Træn mig.",
        "7978ebb04717f379a925": "Jeg går ikke ud fra, at du er her for at tale om min dejlige Kali. Nå, så bliver det eliksirer. Har nogen nogensinde sagt, at du kun tænker på én ting?",
        "962a0e44edff25e941ee": "Dine evner overgår, hvad jeg kan lære dig, $n. Gå hen og plag Tally Berryfizz. Hun er en gnom, der bor i Tinker Town i Ironforge. Og nu du alligevel skal derop, så hils Kali kærligt fra mig.",
        "d3649ae373f2ba5dc69a": "Sendte min søde Kali dig ned til mig? Hun er mit øjesten."
      },
      "name": "Ghak Healtouch",
      "translationMetadata": {
        "fields": {
          "dialogue.6d268a4771462dc5e40d": {
            "origin": "ai",
