  "locales": {
    "csCZ": {
      "dialogue": {
        "6d268a4771462dc5e40d": "Vycvičte mě.",
        "7978ebb04717f379a925": "Předpokládám, že o mé milované Kali mluvit nechceš. Dobrá tedy. Lektvary. Řekl ti někdy někdo, že myslíš jen na jednu věc?",
        "962a0e44edff25e941ee": "Už tě nemám co naučit, $n. Jdi otravovat Tally Berryfizz, gnómku žijící v Tinker Townu v Ironforge. A když už tam půjdeš, pozdravuj ode mě Kali.",
        "d3649ae373f2ba5dc69a": "Poslala tě za mnou moje milá Kali? Je to zlatíčko, opravdu."
      },
      "name": "Ghak Healtouch",
      "translationMetadata": {
        "fields": {
          "dialogue.6d268a4771462dc5e40d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
