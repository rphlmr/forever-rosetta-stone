    "trTR": {
      "dialogue": {
        "6d268a4771462dc5e40d": "Beni eğit.",
        "7978ebb04717f379a925": "Sanırım sevgili Kali’m hakkında konuşmaya gelmedin. Peki öyleyse. İksirler olsun. Kimse sana tek bir şeye kafayı taktığını söyledi mi?",
        "962a0e44edff25e941ee": "Sana öğretebileceklerimin ötesindesin, $n. Git Tally Berryfizz’i rahatsız et; Ironforge’daki Tinker Town’da yaşayan bir gnomdur. Madem oraya gidiyorsun, Kali’ye sevgilerimi ilet.",
        "d3649ae373f2ba5dc69a": "Tatlı Kali’m mi seni bana gönderdi? O benim gözbebeğimdir."
      },
      "name": "Ghak Healtouch",
      "translationMetadata": {
