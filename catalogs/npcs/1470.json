    "enUS": {
      "dialogue": {
        "6d268a4771462dc5e40d": "Train me.",
        "7978ebb04717f379a925": "I don't suppose you're here to talk about my lovely Kali. Fine, then. Potions it is. Anyone ever tell ye you've got a one-track mind?",
        "962a0e44edff25e941ee": "Ye're beyond my skill to teach, $n. Go pester Tally Berryfizz; she's a gnome living in Tinker Town of Ironforge. Oh, and since you're headed up anyway, give Kali my love.",
        "d3649ae373f2ba5dc69a": "Did my sweet lass Kali send you down to me? The apple of my eye, she is."
      },
      "name": "Ghak Healtouch",
      "subName": "Journeyman Alchemist",
      "translationMetadata": {
        "fields": {
