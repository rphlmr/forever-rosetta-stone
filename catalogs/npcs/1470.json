    "hrHR": {
      "dialogue": {
        "6d268a4771462dc5e40d": "Podučite me.",
        "7978ebb04717f379a925": "Pretpostavljam da nisi ovdje razgovarati o mojoj dragoj Kali. Dobro onda. Napici. Je li ti itko rekao da misliš samo na jedno?",
        "962a0e44edff25e941ee": "Više te nemam čemu naučiti, $n. Idi dosađivati Tally Berryfizz, gnomicu koja živi u Tinker Townu u Ironforgeu. A kad već ideš gore, pozdravi Kali od mene.",
        "d3649ae373f2ba5dc69a": "Je li te moja draga Kali poslala k meni? Ona je moje zlato."
      },
      "name": "Ghak Healtouch",
      "translationMetadata": {
