    "hrHR": {
      "dialogue": {
        "4151a7bb3aad47d03f64": "Prodajem samo najbolju arkansku opremu koju izrađuju obrtnici i magovi ovdje u gradu Stormwindu.",
        "b170bf70c8d57f4c1742": "Želim pogledati vašu robu.",
        "de1c5359ed7c432c57cd": "Od pada Dalarana i uništenja Quel'Thalasa teško je nabaviti takvu robu. No Lucan Cordell i neki naši drugi obrtnici izvrsno ispunjavaju naše narudžbe kvalitetnom robom."
      },
      "name": "Duncan Cullen",
      "translationMetadata": {
