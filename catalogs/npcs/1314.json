    "ltLT": {
      "dialogue": {
        "4151a7bb3aad47d03f64": "Parduodu tik geriausią magišką įrangą, pagamintą čia, Stormwind mieste, mūsų amatininkų ir magų.",
        "b170bf70c8d57f4c1742": "Noriu apžiūrėti tavo prekes.",
        "de1c5359ed7c432c57cd": "Žlugus Dalaranui ir sunaikinus Quel'Thalasą, tokių prekių sunku gauti. Bet Lucan Cordell ir kai kurie kiti mūsų amatininkai puikiai vykdo užsakymus ir tiekia kokybiškas prekes."
      },
      "name": "Duncan Cullen",
      "subName": "Lengvųjų šarvų prekeivis",
