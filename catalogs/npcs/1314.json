    "enUS": {
      "dialogue": {
        "4151a7bb3aad47d03f64": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "b170bf70c8d57f4c1742": "I want to browse your goods.",
        "de1c5359ed7c432c57cd": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise."
      },
      "name": "Duncan Cullen",
      "subName": "Light Armor Merchant",
      "translationMetadata": {
        "fields": {
