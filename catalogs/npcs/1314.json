  "locales": {
    "csCZ": {
      "dialogue": {
        "4151a7bb3aad47d03f64": "Prodávám jen to nejlepší magické vybavení, vyrobené řemeslníky a mágy zde ve městě Stormwind.",
        "b170bf70c8d57f4c1742": "Chci si prohlédnout vaše zboží.",
        "de1c5359ed7c432c57cd": "Od pádu Dalaranu a zničení Quel'Thalasu je takové zboží těžké sehnat. Lucan Cordell a někteří naši další řemeslníci si však vedou skvěle a plní naše objednávky kvalitním zbožím."
      },
      "name": "Duncan Cullen",
      "translationMetadata": {
        "fields": {
          "dialogue.4151a7bb3aad47d03f64": {
