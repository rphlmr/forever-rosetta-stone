    },
    "daDK": {
      "dialogue": {
        "4151a7bb3aad47d03f64": "Jeg sælger kun det fineste arkanudstyr, fremstillet af håndværkere og magikere her i Stormwind.",
        "b170bf70c8d57f4c1742": "Jeg vil gerne se dine varer.",
        "de1c5359ed7c432c57cd": "Siden Dalarans fald og Quel'Thalas' ødelæggelse har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere har gjort et fremragende arbejde med at fylde vores ordrer med kvalitetsvarer."
      },
      "name": "Duncan Cullen",
      "translationMetadata": {
        "fields": {
          "dialogue.4151a7bb3aad47d03f64": {
