  "locales": {
    "csCZ": {
      "dialogue": {
        "114619af58df46dd626f": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým dalším provedením obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "95aa134b6476acbce45d": "Prosím, vycvič mě.",
        "f67477db7f76822a44c4": "Cvičím a vedu mladé lovce v tradicích předávaných po mnoho generací."
      },
      "name": "Thotar",
      "translationMetadata": {
        "fields": {
          "dialogue.114619af58df46dd626f": {
