        }
      }
    },
    "daDK": {
      "dialogue": {
        "114619af58df46dd626f": "Gennem streng omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang, den udføres. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg aflærer dig de talenter, du har lært?",
        "95aa134b6476acbce45d": "Undervis mig venligst.",
        "f67477db7f76822a44c4": "Jeg træner og vejleder unge jægere i traditioner, der er overleveret gennem mange generationer."
      },
      "name": "Thotar",
      "translationMetadata": {
        "fields": {
          "dialogue.114619af58df46dd626f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
