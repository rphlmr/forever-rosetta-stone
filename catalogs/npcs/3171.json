    "hrHR": {
      "dialogue": {
        "114619af58df46dd626f": "Strogim prekvalificiranjem morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Usluga koju nudim svaki put postaje sve teža. Zato je svaka sljedeća prekvalifikacija skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "95aa134b6476acbce45d": "Molim te, obučavaj me.",
        "f67477db7f76822a44c4": "Obučavam i vodim mlade lovce u tradicijama koje se prenose mnogim naraštajima."
      },
      "name": "Thotar",
      "translationMetadata": {
