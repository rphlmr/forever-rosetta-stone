    "enUS": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "I am knowledgable, but I am not an expert. You know who you should talk to? Rhiannon! She's not far. Ask around for her in Undercity",
        "2ce8bdadaef67e41e169": "Train me.",
        "3c5c7062d3a06599dbe4": "So... you want to be a tailor? Very well, we'll see if you have what it takes.",
        "c0cf7a8cbc93bef3da22": "Pleased to make you acquaintance. May I help you?"
      },
      "name": "Bowen Brisboise",
      "subName": "Journeyman Tailor",
      "translationMetadata": {
        "fields": {
