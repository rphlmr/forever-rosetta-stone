  "locales": {
    "csCZ": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "Něco vím, ale nejsem odborník. Víš, s kým bys měl promluvit? S Rhiannon! Není daleko. Poptej se po ní v Undercity.",
        "2ce8bdadaef67e41e169": "Vycvičte mě.",
        "3c5c7062d3a06599dbe4": "Takže... chceš být krejčím? Dobrá, uvidíme, jestli na to máš.",
        "c0cf7a8cbc93bef3da22": "Těší mě. Mohu ti pomoci?"
      },
      "name": "Bowen Brisboise",
      "translationMetadata": {
