    "esES": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "Estoy bastante informado, pero no soy un experto. ¿Sabes con quién deberías hablar? ¡Rhiannon! No está lejos. Pregunta por ella en Entrañas.",
        "2ce8bdadaef67e41e169": "Entréname.",
        "3c5c7062d3a06599dbe4": "Así que... ¿Quieres ser un sastre? Muy bien, veamos si tienes lo que se necesita.",
        "c0cf7a8cbc93bef3da22": "Es un placer conocerte. ¿Puedo ayudarte?"
      },
      "name": "Bowen Bribuesa",
      "subName": "Oficial de sastrería",
