    "hrHR": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "Znam ponešto, ali nisam stručnjak. Znaš s kim trebaš razgovarati? S Rhiannon! Nije daleko. Raspitaj se za nju u Undercityju.",
        "2ce8bdadaef67e41e169": "Podučite me.",
        "3c5c7062d3a06599dbe4": "Dakle... želiš biti krojač? Dobro, vidjet ćemo imaš li što treba.",
        "c0cf7a8cbc93bef3da22": "Drago mi je. Mogu li pomoći?"
      },
      "name": "Bowen Brisboise",
