    "ltLT": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "Šį tą išmanau, bet nesu ekspertas. Žinai, su kuo turėtum pasikalbėti? Su Rhiannon! Ji netoli. Pasiklausinėk apie ją Undercity.",
        "2ce8bdadaef67e41e169": "Pamokyk mane.",
        "3c5c7062d3a06599dbe4": "Taigi... nori tapti siuvėju? Gerai, pažiūrėsime, ar turi tam gabumų.",
        "c0cf7a8cbc93bef3da22": "Malonu susipažinti. Ar galiu padėti?"
      },
      "name": "Bowen Brisboise",
      "subName": "Siuvėjo pameistrys",
