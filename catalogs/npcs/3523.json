    "daDK": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "Jeg ved en del, men jeg er ikke ekspert. Ved du, hvem du bør tale med? Rhiannon! Hun er ikke langt væk. Spørg efter hende i Undercity.",
        "2ce8bdadaef67e41e169": "Træn mig.",
        "3c5c7062d3a06599dbe4": "Så... du vil være skrædder? Udmærket, så ser vi, om du har evnerne.",
        "c0cf7a8cbc93bef3da22": "Hyggeligt at møde dig. Kan jeg hjælpe dig?"
      },
      "name": "Bowen Brisboise",
      "translationMetadata": {
