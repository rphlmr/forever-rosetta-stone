    "svSE": {
      "dialogue": {
        "125aadbfaaa01dbe963d": "Jag kan en del, men jag är ingen expert. Vet du vem du borde tala med? Rhiannon! Hon är inte långt borta. Fråga efter henne i Undercity.",
        "2ce8bdadaef67e41e169": "Träna mig.",
        "3c5c7062d3a06599dbe4": "Så... du vill bli skräddare? Nåväl, vi får se om du har vad som krävs.",
        "c0cf7a8cbc93bef3da22": "Trevligt att träffas. Kan jag hjälpa dig?"
      },
      "name": "Bowen Brisboise",
