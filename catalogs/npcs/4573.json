  "locales": {
    "csCZ": {
      "dialogue": {
        "3eb1779dd7763c882482": "Tvé dovednosti převyšují mé, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit.",
        "42f64b4d716d087c140b": "Chceš-li se zlepšit, musíš najít Nata Pagla v Bažině prachu.",
        "5562aae4e1042f2ec8e2": "Vycvičte mě.",
        "d779a5c32d9f7527c036": "Mohu tě naučit rybařit."
      },
      "name": "Armand Cromwell",
      "translationMetadata": {
