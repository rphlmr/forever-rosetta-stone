    "ltLT": {
      "dialogue": {
        "3eb1779dd7763c882482": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senis Hemingas iš Booty Bay turi knygos „Ešerys ir tu“ kopijų. Ji tikrai padės tau pagerinti įgūdžius.",
        "42f64b4d716d087c140b": "Norėdamas tobulėti toliau, turėsi surasti Nat Pagle Dustwallow Marsh pelkėje.",
        "5562aae4e1042f2ec8e2": "Pamokyk mane.",
        "d779a5c32d9f7527c036": "Galiu tave išmokyti žvejoti."
      },
      "name": "Armand Cromwell",
      "subName": "Žvejybos mokytojas",
