    "daDK": {
      "dialogue": {
        "3eb1779dd7763c882482": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den vil sikkert hjælpe dig med at blive bedre.",
        "42f64b4d716d087c140b": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu.",
        "5562aae4e1042f2ec8e2": "Træn mig.",
        "d779a5c32d9f7527c036": "Jeg kan lære dig at fiske."
      },
      "name": "Armand Cromwell",
      "translationMetadata": {
