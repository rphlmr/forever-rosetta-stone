    "enUS": {
      "dialogue": {
        "3eb1779dd7763c882482": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "42f64b4d716d087c140b": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "5562aae4e1042f2ec8e2": "Train me.",
        "d779a5c32d9f7527c036": "I can teach you fishing skills."
      },
      "name": "Armand Cromwell",
      "subName": "Fishing Trainer",
      "translationMetadata": {
