  "locales": {
    "csCZ": {
      "dialogue": {
        "616eb7d29d99fdbbbc62": "Nemohu tě cvičit, $c.",
        "939b5d888f3b2e903817": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "cd00d08ed815b709b79c": "Ať se člověk naučí jakkoli mnoho, vždy je co dalšího poznávat.",
        "ffbd5697ffea86d2449e": "Potřebuji výcvik válečníka."
      },
      "name": "Ker Ragetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.616eb7d29d99fdbbbc62": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
