    "plPL": {
      "dialogue": {
        "616eb7d29d99fdbbbc62": "Nie mogę cię szkolić, $c.",
        "939b5d888f3b2e903817": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "cd00d08ed815b709b79c": "Nieważne, jak wiele się nauczysz, zawsze pozostaje coś jeszcze do poznania.",
        "ffbd5697ffea86d2449e": "Potrzebuję szkolenia wojownika."
      },
      "name": "Ker Ragetotem",
