      }
    },
    "daDK": {
      "dialogue": {
        "616eb7d29d99fdbbbc62": "Jeg kan ikke træne dig, $c.",
        "939b5d888f3b2e903817": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "cd00d08ed815b709b79c": "Uanset hvor meget man lærer, er der altid mere at vide.",
        "ffbd5697ffea86d2449e": "Jeg har brug for krigertræning."
      },
      "name": "Ker Ragetotem",
      "translationMetadata": {
        "fields": {
          "dialogue.616eb7d29d99fdbbbc62": {
            "origin": "ai",
