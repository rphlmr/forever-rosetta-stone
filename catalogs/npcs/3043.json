    "ltLT": {
      "dialogue": {
        "616eb7d29d99fdbbbc62": "Negaliu tavęs mokyti, $c.",
        "939b5d888f3b2e903817": "Griežtai permokydamas ne vieną mokinį turėjau priversti pamiršti viską, ką jie buvo išmokę, kad galėčiau mokyti juos iš naujo. Kaskart teikti šią paslaugą darosi vis sunkiau. Todėl su kiekvienu permokymu ji vis brangsta. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "cd00d08ed815b709b79c": "Kad ir kiek išmoktum, visada yra ką sužinoti.",
        "ffbd5697ffea86d2449e": "Noriu mokytis kario meno."
      },
      "name": "Ker Ragetotem",
      "subName": "Karių mokytojas",
