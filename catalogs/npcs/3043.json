    "ptBR": {
      "dialogue": {
        "616eb7d29d99fdbbbc62": "Não posso treinar você, $c.",
        "939b5d888f3b2e903817": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "cd00d08ed815b709b79c": "Não importa o quanto alguém já saiba, há sempre mais coisa a aprender.",
        "ffbd5697ffea86d2449e": "Preciso de treinamento de guerreiro."
      },
      "name": "Ker Totem da Fúria",
      "subName": "Treinamento de Guerreiros",
