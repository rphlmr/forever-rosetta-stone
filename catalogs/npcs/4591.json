    "daDK": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Jeg kan lære dig førstehjælpsteknikker.",
        "83e3b4b4fab213d7af2f": "Balai Lok’Wein i Brackenwall Village i Dustwallow Marsh sælger en håndbog, du skal studere for at forbedre dine færdigheder!",
        "99d964c2a69b12317196": "Kun den berømte doktor Gregory Victor kan forbedre dine færdigheder nu. Han findes i Hammerfall i Arathi Highlands.",
        "af04a3cfe85936a8e37b": "Træn mig."
      },
      "name": "Mary Edras",
      "translationMetadata": {
