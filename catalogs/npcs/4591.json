    "trTR": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Sana İlk Yardım tekniklerini öğretebilirim.",
        "83e3b4b4fab213d7af2f": "Dustwallow Bataklığı’ndaki Brackenwall Köyü’nde yaşayan Balai Lok’Wein, becerilerini geliştirmek için çalışman gereken bir kılavuz satıyor!",
        "99d964c2a69b12317196": "Artık becerini yalnızca ünlü Doktor Gregory Victor geliştirebilir. Onu Arathi Yaylaları’ndaki Hammerfall’da bulabilirsin.",
        "af04a3cfe85936a8e37b": "Beni eğit."
      },
