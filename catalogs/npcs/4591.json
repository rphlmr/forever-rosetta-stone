    "plPL": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Mogę nauczyć cię technik pierwszej pomocy.",
        "83e3b4b4fab213d7af2f": "Balai Lok’Wein z wioski Brackenwall na bagnach Dustwallow sprzedaje podręcznik, który musisz przestudiować, aby rozwinąć swoje umiejętności!",
        "99d964c2a69b12317196": "Teraz tylko słynny doktor Gregory Victor może rozwinąć twoją umiejętność. Znajdziesz go w Hammerfall w Arathi Highlands.",
        "af04a3cfe85936a8e37b": "Wyszkol mnie."
