    "deDE": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "83e3b4b4fab213d7af2f": "Balai Lok'Wein aus Brackenwall in den Marschen von Dustwallow verkauft ein Buch, das Ihr studieren solltet, um Eure Fähigkeiten zu verbessern!",
        "99d964c2a69b12317196": "Einzig der berühmte Doktor Gregory Victor kann Euch jetzt noch helfen, Eure Fertigkeiten zu verbessern. Ihr findet ihn im Arathihochland, in Hammerfall.",
        "af04a3cfe85936a8e37b": "Bildet mich aus."
      },
      "name": "Mary Edras",
      "subName": "Lehrerin für Erste Hilfe",
      "translationMetadata": {
