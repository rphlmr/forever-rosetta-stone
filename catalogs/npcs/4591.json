    "ptBR": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Eu posso lhe ensinar as técnicas de Primeiros Socorros.",
        "83e3b4b4fab213d7af2f": "Balai Lok'Wein, da Aldeia Muralha Verde, que fica no Pântano Vadeoso, vende um manual que vai ajudá-lo a aperfeiçoar suas habilidades.",
        "99d964c2a69b12317196": "Somente o renomado Doutor Victor Zerbini será capaz de aperfeiçoar as suas habilidades agora. Ele fica no Planalto Arathi, na Ruína do Martelo.",
        "af04a3cfe85936a8e37b": "Treine-me."
      },
      "name": "Maria do Socorro",
      "subName": "Treinamento de Primeiros Socorros",
