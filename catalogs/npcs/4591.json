    "hrHR": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Mogu te podučiti tehnikama prve pomoći.",
        "83e3b4b4fab213d7af2f": "Balai Lok’Wein iz sela Brackenwall u močvari Dustwallow prodaje priručnik koji moraš proučiti kako bi poboljšao svoje vještine!",
        "99d964c2a69b12317196": "Sada samo poznati doktor Gregory Victor može unaprijediti tvoju vještinu. Možeš ga pronaći u Hammerfallu u Arathi Highlandsu.",
        "af04a3cfe85936a8e37b": "Podučite me."
      },
      "name": "Mary Edras",
