    "frFR": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Je peux vous enseigner des techniques de Premiers soins.",
        "83e3b4b4fab213d7af2f": "Balai Lok'Wein du village de Mur-de-Fougères dans le marécage d'Âprefange vend un manuel que vous devriez étudier pour améliorer vos compétences !",
        "99d964c2a69b12317196": "Le fameux docteur Gregory Victor est seul à pouvoir vous faire progresser. On le trouve au Trépas-d'Orgrim, dans les hautes-terres d’Arathi.",
        "af04a3cfe85936a8e37b": "Entraînez-moi."
      },
      "name": "Mary Edras",
      "subName": "Maître des premiers soins",
