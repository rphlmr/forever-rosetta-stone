  "locales": {
    "csCZ": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Mohu tě naučit technikám první pomoci.",
        "83e3b4b4fab213d7af2f": "Balai Lok’Wein z vesnice Brackenwall v močálu Dustwallow prodává příručku, kterou musíš prostudovat, abys zlepšil své dovednosti!",
        "99d964c2a69b12317196": "Nyní může tvou dovednost zlepšit jen proslulý doktor Gregory Victor. Najdeš ho v Hammerfallu v Arathské vysočině.",
        "af04a3cfe85936a8e37b": "Vycvičte mě."
      },
      "name": "Mary Edras",
      "translationMetadata": {
