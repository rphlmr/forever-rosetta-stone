    "ltLT": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Galiu išmokyti tave pirmosios pagalbos būdų.",
        "83e3b4b4fab213d7af2f": "Balai Lok'Wein, gyvenantis Brackenwall kaime, Dustwallow pelkėje, parduoda vadovėlį, kurį turėsi išstudijuoti, kad patobulintum savo įgūdžius!",
        "99d964c2a69b12317196": "Dabar tavo įgūdžius gali patobulinti tik garsusis gydytojas Gregory Victor.  Jį rasi Hammerfall gyvenvietėje, Arathi aukštumose.",
        "af04a3cfe85936a8e37b": "Išmokyk mane."
      },
      "name": "Mary Edras",
      "subName": "Pirmosios pagalbos mokytoja",
