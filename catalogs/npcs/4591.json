    "itIT": {
      "dialogue": {
        "1ea73aaaf1f06f15d158": "Posso insegnarti le tecniche di Primo Soccorso.",
        "83e3b4b4fab213d7af2f": "Balai Lok'Wein di Brackenwall Village, nel Dustwallow Marsh, vende un manuale che dovrai studiare per migliorare le tue abilità!",
        "99d964c2a69b12317196": "Ormai solo il celebre Dottor Gregory Victor può migliorare la tua abilità. Lo trovi negli Arathi Highlands, a Hammerfall.",
        "af04a3cfe85936a8e37b": "Addestrami."
      },
      "name": "Mary Edras",
