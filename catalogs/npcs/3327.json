    "daDK": {
      "dialogue": {
        "067b81220cd62df7e7f9": "Jeg træner ikke din slags, $c.",
        "13503c5cc482b58d3ee1": "Jeg vil gerne trænes.",
        "5622901d104d7b53bff9": "Gennem streng omskoling har jeg måttet få mange elever til at aflære alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre for hver gang. Derfor bliver den også dyrere med hver omskoling. Ønsker du, at jeg får dig til at aflære dine talenter?",
        "65aeb98b7f0b12806a5d": "Jeg har noget til dig, $n. Det ser vigtigt ud.",
        "c4966fa0b5d69d8486e4": "Shattered Hand vil føre Horden tilbage til dens tidligere storhed uden at blive hindret af krigshøvdingens frygtsomhed."
      },
      "name": "Gest",
      "translationMetadata": {
