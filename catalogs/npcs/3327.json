    "plPL": {
      "dialogue": {
        "067b81220cd62df7e7f9": "Nie szkolę takich jak ty, $c.",
        "13503c5cc482b58d3ee1": "Chcę się szkolić.",
        "5622901d104d7b53bff9": "Dzięki rygorystycznemu przekwalifikowaniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Za każdym razem jest to coraz trudniejsze, dlatego kolejne przekwalifikowania kosztują coraz więcej. Czy chcesz, abym oduczył cię zdobytych talentów?",
        "65aeb98b7f0b12806a5d": "Mam coś dla ciebie, $n. Wygląda na ważne.",
        "c4966fa0b5d69d8486e4": "Shattered Hand przywróci Hordzie dawną chwałę, nie zważając na bojaźliwość wodza wojennego."
      },
      "name": "Gest",
      "translationMetadata": {
