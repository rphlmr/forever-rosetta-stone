  "locales": {
    "csCZ": {
      "dialogue": {
        "067b81220cd62df7e7f9": "Tvůj druh necvičím, $c.",
        "13503c5cc482b58d3ee1": "Chci absolvovat výcvik.",
        "5622901d104d7b53bff9": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dosud naučili, abych je mohl učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "65aeb98b7f0b12806a5d": "Něco tu pro tebe mám, $n. Vypadá to důležitě.",
        "c4966fa0b5d69d8486e4": "Shattered Hand navrátí Hordě její bývalou slávu, aniž by jí bránila náčelníkova bázlivost."
      },
      "name": "Gest",
      "translationMetadata": {
        "fields": {
