    "enUS": {
      "dialogue": {
        "067b81220cd62df7e7f9": "I don't train your kind $c.",
        "13503c5cc482b58d3ee1": "I would like training.",
        "5622901d104d7b53bff9": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "65aeb98b7f0b12806a5d": "I got something for you, $n. Looks important.",
        "c4966fa0b5d69d8486e4": "The Shattered Hand will see the Horde to their former glory, unhindered by the timidness of the Warchief."
      },
      "name": "Gest",
      "subName": "Rogue Trainer",
      "translationMetadata": {
