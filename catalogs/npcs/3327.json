    "hrHR": {
      "dialogue": {
        "067b81220cd62df7e7f9": "Ne podučavam tvoju vrstu, $c.",
        "13503c5cc482b58d3ee1": "Želim obuku.",
        "5622901d104d7b53bff9": "Strogim preobučavanjem mnoge sam učenike morao odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Tu je uslugu svaki put sve teže pružiti, pa zato svakim preobučavanjem postaje sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "65aeb98b7f0b12806a5d": "Imam nešto za tebe, $n. Izgleda važno.",
        "c4966fa0b5d69d8486e4": "Shattered Hand vratit će Hordi nekadašnju slavu, bez prepreka koje stvara bojažljivost ratnog poglavice."
      },
      "name": "Gest",
      "translationMetadata": {
