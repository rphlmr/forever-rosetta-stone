    "esES": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Entréname.",
        "2bd125367f23e37cec7a": "Thrall nos pagó bien a mí y a mis chicos por ayudar en la construcción de Orgrimmar, así que decidí establecer un puerto aquí. Hacemos la mayor parte de nuestros negocios a través de la Bahía del Botín y el Barón Revilgaz.",
        "2df76131cb9dca5ff545": "Quiero ver tus mercancías."
      },
      "name": "Gazlowe",
