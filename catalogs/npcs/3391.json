    "itIT": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Addestrami.",
        "2bd125367f23e37cec7a": "Thrall ha pagato bene me e i miei ragazzi per l'aiuto nella costruzione di Orgrimmar, così ho deciso di aprire un porto qui. Facciamo quasi tutti i nostri affari tramite Booty Bay e il Barone Revilgaz.",
        "2df76131cb9dca5ff545": "Vorrei vedere la tua merce."
      },
      "name": "Gazlowe",
