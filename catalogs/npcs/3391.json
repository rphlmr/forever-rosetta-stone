    "hrHR": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Podučite me.",
        "2bd125367f23e37cec7a": "Thrall je meni i mojim momcima dobro platio pomoć pri gradnji Orgrimmara, pa sam odlučio ovdje osnovati luku. Većinu poslova obavljamo preko Booty Baya i baruna Revilgaza.",
        "2df76131cb9dca5ff545": "Želim pogledati vašu robu."
      },
      "name": "Gazlowe",
