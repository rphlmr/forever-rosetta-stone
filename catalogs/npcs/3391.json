    "ltLT": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Išmokyk mane.",
        "2bd125367f23e37cec7a": "Thrall gerai sumokėjo man ir mano vyrukams už pagalbą statant Orgrimmar, todėl nusprendžiau čia įkurti uostą. Didžiąją dalį reikalų tvarkome per Booty Bay ir baroną Revilgaz.",
        "2df76131cb9dca5ff545": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Gazlowe",
      "translationMetadata": {
