  "locales": {
    "csCZ": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Vycvičte mě.",
        "2bd125367f23e37cec7a": "Thrall mně a mým chlapům dobře zaplatil za pomoc se stavbou Orgrimmaru, a tak jsem se rozhodl založit tu přístav. Většinu obchodů vedeme přes Kořistnou zátoku a barona Revilgaze.",
        "2df76131cb9dca5ff545": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Gazlowe",
      "translationMetadata": {
        "fields": {
