    },
    "daDK": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Træn mig.",
        "2bd125367f23e37cec7a": "Thrall betalte mig og mine folk godt for at hjælpe med at bygge Orgrimmar, så jeg besluttede at oprette en havn her. Det meste af vores handel går gennem Booty Bay og baron Revilgaz.",
        "2df76131cb9dca5ff545": "Jeg vil gerne se dine varer."
      },
      "name": "Gazlowe",
      "translationMetadata": {
        "fields": {
