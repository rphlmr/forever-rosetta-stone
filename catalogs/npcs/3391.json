    "trTR": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Beni eğit.",
        "2bd125367f23e37cec7a": "Thrall, Orgrimmar'ın inşasına yardım ettiğimiz için bana ve adamlarıma iyi para ödedi. Ben de burada bir liman kurmaya karar verdim. İşlerimizin çoğunu Booty Bay ve Baron Revilgaz aracılığıyla yapıyoruz.",
        "2df76131cb9dca5ff545": "Mallarına bakmak istiyorum."
      },
      "name": "Gazlowe",
