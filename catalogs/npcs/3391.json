    "ptBR": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Treine-me.",
        "2bd125367f23e37cec7a": "Thrall pagou bem a mim e aos meus homens pela ajuda na construção de Orgrimmar, então decidi estabelecer um porto aqui. Fazemos a maior parte dos negócios por meio de Angra do Butim e do barão Revilgaz.",
        "2df76131cb9dca5ff545": "Quero ver suas mercadorias."
      },
      "name": "Gasganete",
