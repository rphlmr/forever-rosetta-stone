    "plPL": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Wyszkol mnie.",
        "2bd125367f23e37cec7a": "Thrall dobrze zapłacił mnie i moim chłopakom za pomoc przy budowie Orgrimmaru, więc postanowiłem założyć tu port. Większość interesów prowadzimy przez Zatokę Łupów i barona Revilgaza.",
        "2df76131cb9dca5ff545": "Chcę przejrzeć twoje towary."
      },
      "name": "Gazlowe",
