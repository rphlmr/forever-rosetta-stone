    "enUS": {
      "dialogue": {
        "16a1c4a0466a00c14010": "Train me.",
        "2bd125367f23e37cec7a": "Thrall paid me and my boys well for helping out with the construction of Orgrimmar, so I decided to set up a port here. We do most of our business through Booty Bay and Baron Revilgaz.",
        "2df76131cb9dca5ff545": "I want to browse your goods."
      },
      "name": "Gazlowe",
      "translationMetadata": {
