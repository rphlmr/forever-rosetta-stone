  "locales": {
    "csCZ": {
      "dialogue": {
        "176862e68a81e4581b3d": "Prodávám jen to nejlepší magické vybavení, které vyrábějí řemeslníci a mágové zde ve Stormwindu.",
        "5c9657f2f832cd9acfb9": "Od pádu Dalaranu a zničení Quel’Thalasu je těžké takové zboží sehnat. Lucan Cordell a někteří další naši řemeslníci však odvádějí skvělou práci a dodávají nám kvalitní zboží.",
        "b59144c077840069e0c9": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Evan Larson",
      "translationMetadata": {
        "fields": {
          "dialogue.176862e68a81e4581b3d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.5c9657f2f832cd9acfb9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.b59144c077840069e0c9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "176862e68a81e4581b3d": "Jeg sælger kun det fineste arkane udstyr, fremstillet af håndværkere og magikere her i Stormwind.",
        "5c9657f2f832cd9acfb9": "Siden Dalarans fald og Quel’Thalas’ ødelæggelse har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere gør et godt stykke arbejde med at fylde vores bestillinger med kvalitetsvarer.",
        "b59144c077840069e0c9": "Jeg vil gerne se dine varer."
      },
      "name": "Evan Larson",
      "translationMetadata": {
        "fields": {
          "dialogue.176862e68a81e4581b3d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
