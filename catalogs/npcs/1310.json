    "hrHR": {
      "dialogue": {
        "176862e68a81e4581b3d": "Prodajem samo najbolju tajanstvenu opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu.",
        "5c9657f2f832cd9acfb9": "Od pada Dalarana i uništenja Quel’Thalasa teško je nabaviti ovakvu robu. No Lucan Cordell i neki drugi naši obrtnici izvrsno ispunjavaju naše narudžbe kvalitetnom robom.",
        "b59144c077840069e0c9": "Želim pogledati vašu robu."
      },
      "name": "Evan Larson",
      "translationMetadata": {
