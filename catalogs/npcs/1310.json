            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "176862e68a81e4581b3d": "Yalnızca burada, Stormwind şehrindeki zanaatkârların ve büyücülerin yaptığı en iyi gizemli teçhizatı satarım.",
        "5c9657f2f832cd9acfb9": "Dalaran’ın düşüşünden ve Quel’Thalas’ın yıkılışından beri bu tür malları bulmak zor. Ama Lucan Cordell ve diğer bazı zanaatkârlarımız siparişlerimizi kaliteli ürünlerle karşılamakta çok başarılı.",
        "b59144c077840069e0c9": "Mallarına bakmak istiyorum."
      },
      "name": "Evan Larson",
      "translationMetadata": {
        "fields": {
          "dialogue.176862e68a81e4581b3d": {
