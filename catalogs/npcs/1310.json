    "plPL": {
      "dialogue": {
        "176862e68a81e4581b3d": "Sprzedaję tylko najlepszy magiczny ekwipunek, wytwarzany przez rzemieślników i magów tutaj, w Stormwind.",
        "5c9657f2f832cd9acfb9": "Od upadku Dalaranu i zniszczenia Quel’Thalas trudno zdobyć takie towary. Ale Lucan Cordell i inni nasi rzemieślnicy świetnie radzą sobie z realizacją zamówień na produkty wysokiej jakości.",
        "b59144c077840069e0c9": "Chcę przejrzeć twoje towary."
      },
      "name": "Evan Larson",
      "translationMetadata": {
