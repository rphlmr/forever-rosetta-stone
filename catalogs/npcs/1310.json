    "enUS": {
      "dialogue": {
        "176862e68a81e4581b3d": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "5c9657f2f832cd9acfb9": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise.",
        "b59144c077840069e0c9": "I want to browse your goods."
      },
      "name": "Evan Larson",
      "subName": "Hatter",
      "translationMetadata": {
        "fields": {
          "dialogue.176862e68a81e4581b3d": {
