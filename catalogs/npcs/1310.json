            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "176862e68a81e4581b3d": "Ich verkaufe nur die beste arkane Ausrüstung, gemacht von den Handwerkern und Magiern hier in Stormwind.",
        "5c9657f2f832cd9acfb9": "Seit dem Fall von Dalaran und der Zerstörung von Quel'Thalas sind solche Waren schwer zu bekommen. Aber Lucan Cordell und einige andere unserer Handwerker haben es geschafft, für unsere Bestellungen erstklassige Handelsware zu besorgen.",
        "b59144c077840069e0c9": "Ich möchte Eure Waren ansehen."
      },
      "name": "Evan Larson",
      "subName": "Hutmacher",
      "translationMetadata": {
        "fields": {
          "dialogue.176862e68a81e4581b3d": {
