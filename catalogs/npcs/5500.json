    "enUS": {
      "dialogue": {
        "151748987e36366d574f": "I am honored to share my knowledge with you, $n. See that you use it well.",
        "1b60e2ffdb9141b26c7f": "Ishnu-alah, $gbrother:sister;. Have you any tidings from abroad? My heart yearns for news of Teldrassil.",
        "855d7be56cf260273c87": "Train me.",
        "bf9477e361d7d9b4ce4b": "Ishnu-alah, $gbrother:sister;. Have you any tidings from abroad? My heart yearns for news of Teldrassil.",
        "cd061acf6e5ca2da6e5d": "You must choose a more experienced teacher, for you have surpassed my abilities. I advise you to speak with Lilyssia Nightbreeze here: she has much knowledge to offer."
      },
      "name": "Tel'Athir",
      "subName": "Journeyman Alchemist",
