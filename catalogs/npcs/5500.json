  "locales": {
    "csCZ": {
      "dialogue": {
        "151748987e36366d574f": "Je mi ctí podělit se s tebou o své znalosti, $n. Využij je dobře.",
        "1b60e2ffdb9141b26c7f": "Ishnu-alah, $gbratře:sestro;. Máš nějaké zprávy z ciziny? Mé srdce touží po zprávách z Teldrassilu.",
        "855d7be56cf260273c87": "Vycvičte mě.",
        "bf9477e361d7d9b4ce4b": "Ishnu-alah, $gbratře:sestro;. Máš nějaké zprávy z ciziny? Mé srdce touží po zprávách z Teldrassilu.",
        "cd061acf6e5ca2da6e5d": "Musíš si vybrat zkušenějšího učitele, neboť tvé schopnosti převyšují mé. Doporučuji ti promluvit si zde s Lilyssií Nightbreeze: má mnoho znalostí, o které se může podělit."
      },
      "name": "Tel'Athir",
      "translationMetadata": {
