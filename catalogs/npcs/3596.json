          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "2b4bdc262b903e342432": "Jeg kan ikke træne en $c som dig.",
        "66f8623b433d10b9dc0a": "Gennem streng genoptræning har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste bliver sværere at udføre hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "812b5b91da54e32ffe0b": "Velkommen til Cenarioncirklen, $c.",
        "c9de8592e064948910c5": "Jeg vil gerne trænes."
      },
      "name": "Ayanna Everstride",
      "translationMetadata": {
        "fields": {
          "dialogue.2b4bdc262b903e342432": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
