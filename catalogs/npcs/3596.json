    "plPL": {
      "dialogue": {
        "2b4bdc262b903e342432": "Nie mogę szkolić kogoś takiego jak ty, $c.",
        "66f8623b433d10b9dc0a": "Dzięki surowemu przeszkoleniu musiałam sprawić, by wielu uczniów zapomniało wszystkiego, czego się wcześniej nauczyli, abym mogła uczyć ich od nowa. Ta usługa staje się coraz trudniejsza za każdym razem, dlatego też kosztuje coraz więcej. Czy mam sprawić, by zapomniałeś wyuczonych talentów?",
        "812b5b91da54e32ffe0b": "Witaj w Kręgu Cenariusa, $c.",
        "c9de8592e064948910c5": "Chcę się szkolić."
      },
      "name": "Ayanna Everstride",
