    "enUS": {
      "dialogue": {
        "2b4bdc262b903e342432": "I cannot train a $c such as yourself.",
        "66f8623b433d10b9dc0a": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "812b5b91da54e32ffe0b": "Welcome to the Cenarion Circle, $c.",
        "c9de8592e064948910c5": "I'd like to train."
      },
      "name": "Ayanna Everstride",
      "subName": "Hunter Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.2b4bdc262b903e342432": {
