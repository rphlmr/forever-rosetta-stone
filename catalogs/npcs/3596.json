  "locales": {
    "csCZ": {
      "dialogue": {
        "2b4bdc262b903e342432": "Nemohu učit někoho takového jako ty, $c.",
        "66f8623b433d10b9dc0a": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je při každém dalším použití náročnější, a proto je také pokaždé dražší. Přeješ si, abych tě odnaučila talenty, které ses naučil?",
        "812b5b91da54e32ffe0b": "Vítej v Cenarionském kruhu, $c.",
        "c9de8592e064948910c5": "Chtěl bych trénovat."
      },
      "name": "Ayanna Everstride",
      "translationMetadata": {
        "fields": {
          "dialogue.2b4bdc262b903e342432": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
