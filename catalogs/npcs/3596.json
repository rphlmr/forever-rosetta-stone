    "ltLT": {
      "dialogue": {
        "2b4bdc262b903e342432": "Negaliu mokyti tokio kaip tu, $c.",
        "66f8623b433d10b9dc0a": "Griežtai permokydamas turėjau priversti daugelį mokinių atsisakyti visko, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart teikti šią paslaugą darosi vis sunkiau, todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "812b5b91da54e32ffe0b": "Sveikas atvykęs į Cenarion ratą, $c.",
        "c9de8592e064948910c5": "Norėčiau pasimokyti."
      },
      "name": "Ayanna Everstride",
      "subName": "Medžiotojų mokytojas",
