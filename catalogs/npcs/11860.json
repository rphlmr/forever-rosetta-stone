      }
    },
    "trTR": {
      "dialogue": {
        "2a63ddf55183021a6f14": "Korkarım artık ne yumuşak huyluyum ne de alçakgönüllü. Yaşım ve sayısız savaş, tenimi de ruhumu da sertleştirdi. Belki de Cairne beni bu yüzden Sun Rock Retreat’e gönderdi... hafif rüzgârlar ve sıcak güneş gerçekten acıyı hafifletiyor."
      },
      "name": "Maggran Earthbinder",
      "translationMetadata": {
        "fields": {
