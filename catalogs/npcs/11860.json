  "locales": {
    "csCZ": {
      "dialogue": {
        "2a63ddf55183021a6f14": "Obávám se, že už nejsem mírný ani pokorný. Věk a nesčetné bitvy zocelily mou kůži i duši. Snad proto mě Cairne poslal do Sun Rock Retreat... jemný vítr a hřejivé slunce tu bolest skutečně mírní."
      },
      "name": "Maggran Earthbinder",
      "translationMetadata": {
        "fields": {
          "dialogue.2a63ddf55183021a6f14": {
