            "sourceLocale": "enUS",
            "sourceRevision": "164bd1e2d89579ada4ee5e2de7e5fd4db684a9f1"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "2a63ddf55183021a6f14": "Me temo que ya no soy moderado ni modesto. La edad y las innumerables batallas han endurecido tanto mi piel como mi alma. Quizás por eso Cairne me envió al Refugio Roca de Sol... los suaves vientos y el cálido sol sirven para calmar el dolor."
      },
      "name": "Ligaterra Maggram",
      "translationMetadata": {
        "fields": {
