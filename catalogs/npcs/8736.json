  "locales": {
    "csCZ": {
      "dialogue": {
        "1cacb7d195986a98321e": "Ukaž, co umíš! Nebudeš litovat, slibuji!",
        "5fcafa71eb89829bd892": "Pracuji na způsobu, jak přepravovat ropu mezi velkými městy pod zemí, ale všichni říkají, že je to jen sen o potrubí.",
        "67f56ef316906d623bd6": "Nikdy bych neodmítl někoho, kdo je připraven se u mě učit. Bohužel ty ještě nejsi! Máš před sebou ještě kus cesty, mládě!",
        "a006ef706a88bf0acd87": "Vycvičte mě."
      },
      "name": "Buzzek Bracketswing",
      "translationMetadata": {
