    "hrHR": {
      "dialogue": {
        "1cacb7d195986a98321e": "Pokaži što znaš! Nećeš požaliti, obećavam!",
        "5fcafa71eb89829bd892": "Radim na načinu da pod zemljom prenosim naftu između velikih gradova, ali svi mi govore da su to pusti snovi o cijevima.",
        "67f56ef316906d623bd6": "Nikad ne bih odbio nekoga tko je spreman učiti kod mene. Nažalost, ti još nisi! Pred tobom je još mnogo posla, mali!",
        "a006ef706a88bf0acd87": "Podučite me."
      },
      "name": "Buzzek Bracketswing",
