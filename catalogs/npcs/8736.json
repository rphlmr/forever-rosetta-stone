    "daDK": {
      "dialogue": {
        "1cacb7d195986a98321e": "Vis mig, hvad du kan! Du vil ikke fortryde det, det lover jeg!",
        "5fcafa71eb89829bd892": "Jeg har arbejdet på en måde at transportere olie under jorden mellem storbyer, men alle siger, at det er en rørdrøm.",
        "67f56ef316906d623bd6": "Jeg ville aldrig afvise nogen, der er klar til at træne hos mig. Desværre er du det ikke! Du har stadig et stykke vej endnu, knægt!",
        "a006ef706a88bf0acd87": "Træn mig."
      },
      "name": "Buzzek Bracketswing",
      "translationMetadata": {
        "fields": {
