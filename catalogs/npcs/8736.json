    "plPL": {
      "dialogue": {
        "1cacb7d195986a98321e": "Pokaż, co potrafisz! Nie pożałujesz, obiecuję!",
        "5fcafa71eb89829bd892": "Pracuję nad sposobem transportowania ropy pod ziemią między wielkimi miastami, ale wszyscy mówią, że to mrzonki o rurach.",
        "67f56ef316906d623bd6": "Nigdy nie odprawiłbym nikogo, kto jest gotów u mnie trenować. Niestety, ty jeszcze nie jesteś! Przed tobą długa droga, młody!",
        "a006ef706a88bf0acd87": "Wyszkol mnie."
      },
      "name": "Buzzek Bracketswing",
