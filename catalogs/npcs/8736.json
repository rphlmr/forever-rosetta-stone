    "enUS": {
      "dialogue": {
        "1cacb7d195986a98321e": "Show me what you got! You won't be sorry, I promise!",
        "5fcafa71eb89829bd892": "I've been working on a way to transport oil underground between major cities, but everyone tells me it's a pipe dream.",
        "67f56ef316906d623bd6": "I would never turn away someone who's ready to train with me. Unfortunately, you're not! You've still got a ways to go kid!",
        "a006ef706a88bf0acd87": "Train me."
      },
      "name": "Buzzek Bracketswing",
      "subName": "Master Engineer",
      "translationMetadata": {
        "fields": {
          "dialogue.1cacb7d195986a98321e": {
