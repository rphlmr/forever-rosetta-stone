    "ltLT": {
      "dialogue": {
        "1cacb7d195986a98321e": "Parodyk, ką moki! Pažadu, nepasigailėsi!",
        "5fcafa71eb89829bd892": "Kuriu būdą, kaip naftą po žeme transportuoti tarp didžiųjų miestų, bet visi sako, kad tai tik tuščios svajonės apie vamzdyną.",
        "67f56ef316906d623bd6": "Niekada neatstumčiau žmogaus, pasiruošusio mokytis pas mane. Deja, tu dar nepasiruošei! Tau dar yra kur tobulėti, vaikeli!",
        "a006ef706a88bf0acd87": "Išmokyk mane."
      },
      "name": "Buzzekas Bracketswingas",
      "subName": "Inžinerijos meistras",
