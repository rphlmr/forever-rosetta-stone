    "esES": {
      "dialogue": {
        "1cacb7d195986a98321e": "¡Enséñame lo que tienes! No te arrepentirás, ¡lo prometo!",
        "5fcafa71eb89829bd892": "He estado trabajando en una forma de transportar petróleo bajo tierra entre las ciudades más importantes, pero todos dicen que son castillos en el aire.",
        "67f56ef316906d623bd6": "Nunca daría la espalda a alguien que está listo para instruirse conmigo. Por desgracia ¡tú no lo estás! ¡Todavía te queda un largo camino chiquillo!",
        "a006ef706a88bf0acd87": "Entréname."
      },
      "name": "Buzzek Giracorchete",
      "subName": "Maestro ingeniero",
