    "daDK": {
      "dialogue": {
        "32904d806b10e88f277c": "Træn mig.",
        "54f482a877b6e1ee93bf": "Jeg vil gerne se dine varer.",
        "df745da14c64f07b78a8": "Velkommen til vores beskedne hjem! Det er altid dejligt at se et venligt ansigt. Og sikke stærke arme du har. Min mand og jeg søger altid hjælp på gården. Nu hvor de fleste gode folk er rejst, er det svært at finde nogen, der kan hjælpe."
      },
      "name": "Salma Saldean",
      "translationMetadata": {
        "fields": {
          "dialogue.32904d806b10e88f277c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
