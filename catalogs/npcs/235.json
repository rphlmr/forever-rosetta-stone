    "ptBR": {
      "dialogue": {
        "32904d806b10e88f277c": "Treine-me.",
        "54f482a877b6e1ee93bf": "Quero ver suas mercadorias.",
        "df745da14c64f07b78a8": "Boas-vindas à nossa humilde morada! É sempre bom ver um rosto amigo. E que braços fortes você tem! Meu marido e eu estamos sempre procurando ajuda na fazenda. Agora que a maioria das pessoas de bem foi embora, é difícil encontrar alguém capaz de ajudar."
      },
      "name": "Salma Saldanha",
