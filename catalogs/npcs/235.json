    "trTR": {
      "dialogue": {
        "32904d806b10e88f277c": "Beni eğit.",
        "54f482a877b6e1ee93bf": "Mallarına bakmak istiyorum.",
        "df745da14c64f07b78a8": "Mütevazı evimize hoş geldin! Dost bir yüz görmek her zaman güzeldir. Kolların da ne kadar güçlüymüş. Kocamla ben çiftlikte yardım edecek birilerini hep ararız. İyi insanların çoğu gittiğinden beri yardım edecek güçlü birini bulmak zor."
      },
      "name": "Salma Saldean",
