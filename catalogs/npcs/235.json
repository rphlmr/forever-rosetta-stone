    "ruRU": {
      "dialogue": {
        "32904d806b10e88f277c": "Обучите меня.",
        "54f482a877b6e1ee93bf": "Я хочу посмотреть ваши товары.",
        "df745da14c64f07b78a8": "Добро пожаловать в наш скромный обитель! Всегда приятно видеть дружелюбное лицо. Какое у тебя крепкое оружие, а нам с мужем всегда нужна помощь в округе нашей фермы, ведь теперь, когда большинство людей ушло, сложно найти кого-то, кто способен помочь."
      },
      "name": "Сальма Сальден",
