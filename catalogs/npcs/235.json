  "locales": {
    "csCZ": {
      "dialogue": {
        "32904d806b10e88f277c": "Vycvičte mě.",
        "54f482a877b6e1ee93bf": "Chci si prohlédnout vaše zboží.",
        "df745da14c64f07b78a8": "Vítej v našem skromném příbytku! Vždycky ráda vidím přátelskou tvář. A jak silné máš paže! S manželem stále hledáme pomoc na farmě. Teď, když většina dobrých lidí odešla, je těžké najít někoho schopného, kdo by pomohl."
      },
      "name": "Salma Saldean",
      "translationMetadata": {
        "fields": {
