    "enUS": {
      "dialogue": {
        "32904d806b10e88f277c": "Train me.",
        "54f482a877b6e1ee93bf": "I want to browse your goods.",
        "df745da14c64f07b78a8": "Welcome to our humble abode!  It's always nice to see a friendly face.  And what strong arms you have.  My husband and I are always looking for help around the farm.  Now that most the good folk have left, it's hard to find an able body to help out."
      },
      "name": "Salma Saldean",
      "translationMetadata": {
