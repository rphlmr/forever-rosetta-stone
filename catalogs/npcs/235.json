    "hrHR": {
      "dialogue": {
        "32904d806b10e88f277c": "Podučite me.",
        "54f482a877b6e1ee93bf": "Želim pogledati vašu robu.",
        "df745da14c64f07b78a8": "Dobro došao u naš skromni dom! Uvijek je lijepo vidjeti prijateljsko lice. A kakve snažne ruke imaš! Suprug i ja uvijek tražimo pomoć na farmi. Sada kad je većina dobrih ljudi otišla, teško je pronaći sposobnu osobu koja bi pomogla."
      },
      "name": "Salma Saldean",
      "translationMetadata": {
