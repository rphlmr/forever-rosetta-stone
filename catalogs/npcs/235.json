    "esES": {
      "dialogue": {
        "32904d806b10e88f277c": "Entréname.",
        "54f482a877b6e1ee93bf": "Quiero ver tus mercancías.",
        "df745da14c64f07b78a8": "¡Bienvenido a nuestra humilde morada!  Siempre es agradable ver una cara amiga.  Y qué brazos tan fuertes tienes.  Mi marido y yo siempre estamos buscando ayuda en la granja.  Ahora que la mayoría de la buena gente se ha ido, es difícil encontrar un cuerpo capaz de ayudar."
      },
      "name": "Salma Saldean",
