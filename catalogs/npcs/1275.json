    "csCZ": {
      "dialogue": {
        "48fcbbe4b03a39b39337": "Rád bych si prohlédl vaše zboží.",
        "7360eab46553d48117d7": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "bd14ff9124c450c52b77": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?"
      },
      "name": "Kyra Boucher",
      "translationMetadata": {
