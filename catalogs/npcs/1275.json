    "daDK": {
      "dialogue": {
        "48fcbbe4b03a39b39337": "Jeg vil gerne se dine varer.",
        "7360eab46553d48117d7": "Kigger du bare på mine varer, eller kan jeg hjælpe dig med at finde noget bestemt i dag?",
        "bd14ff9124c450c52b77": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe dig med?"
      },
      "name": "Kyra Boucher",
      "translationMetadata": {
