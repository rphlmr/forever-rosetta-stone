      "dialogue": {
        "48fcbbe4b03a39b39337": "I want to browse your goods.",
        "7360eab46553d48117d7": "Just browsing my wares or is there something specific I can help you find today?",
        "bd14ff9124c450c52b77": "Best deals in all of Stormwind my friend, won't find any better. Now, what can I help you with?"
      },
