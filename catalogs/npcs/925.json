    "plPL": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Niech Światłość cię dziś chroni.",
        "b4b79d9a9a1d21740f2d": "Chcę dalej szkolić się na ścieżkach Światłości.",
        "defa41c7e3f48ecd9dac": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, by móc uczyć ich od nowa. Usługa ta staje się coraz trudniejsza za każdym razem, gdy ją wykonuję. Dlatego każde kolejne szkolenie kosztuje więcej. Czy pragniesz, abym oduczył cię poznanych talentów?"
      },
      "name": "Brat Sammuel",
      "translationMetadata": {
