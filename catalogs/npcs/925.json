    "trTR": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Işık bugün seni korusun.",
        "b4b79d9a9a1d21740f2d": "Işık’ın yollarında eğitimime devam etmek istiyorum.",
        "defa41c7e3f48ecd9dac": "Sıkı bir yeniden eğitimle pek çok öğrenciye daha önce öğrendikleri her şeyi unutturmam gerekti ki onlara baştan öğretebileyim. Sunduğum bu hizmeti her seferinde gerçekleştirmek daha da zorlaşıyor. Bu yüzden her yeniden eğitimde ücret artıyor. Öğrendiğin yetenekleri sana unutturmamı ister misin?"
      },
      "name": "Birader Sammuel",
      "translationMetadata": {
        "fields": {
