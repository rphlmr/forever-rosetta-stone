    "ltLT": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Tegul Šviesa saugo tave šią dieną.",
        "b4b79d9a9a1d21740f2d": "Norėčiau toliau mokytis Šviesos kelio.",
        "defa41c7e3f48ecd9dac": "Griežtai perkvalifikuodamas turėjau priversti daugybę mokinių pamiršti viską, ką jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Kaskart suteikti šią paslaugą darosi vis sunkiau.  Todėl kiekvienas perkvalifikavimas kainuoja vis brangiau.  Ar nori, kad padėčiau tau pamiršti išmoktus talentus?"
      },
      "name": "Brolis Sammuel",
      "subName": "Paladinų mokytojas",
      "translationMetadata": {
