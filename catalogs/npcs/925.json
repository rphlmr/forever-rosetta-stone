  "locales": {
    "csCZ": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Nechť tě dnes Světlo chrání.",
        "b4b79d9a9a1d21740f2d": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "defa41c7e3f48ecd9dac": "Při důkladném přeškolování jsem musel mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým opakováním těžší provést. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?"
      },
      "name": "Bratr Sammuel",
      "translationMetadata": {
        "fields": {
          "dialogue.4d4612fd3f24efa98e91": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
