            "sourceLocale": "enUS"
          },
          "dialogue.defa41c7e3f48ecd9dac": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Möge das Licht Euch heute beschützen.",
        "b4b79d9a9a1d21740f2d": "Ich möchte mich weiter in den Wegen des Lichts ausbilden lassen.",
        "defa41c7e3f48ecd9dac": "Durch rigoroses Abtrainieren musste ich vielen Schülern das abgewöhnen, was sie bisher gelernt hatten, damit ich sie von neuem unterrichten konnte. Der Dienst, den ich anbiete, ist jedes Mal schwieriger durchzuführen. Aus diesem Grunde wird er mit jeder Umschulung teurer. Wünscht Ihr, dass ich Euch die Talente nehme, die Ihr erlernt habt?"
      },
      "name": "Bruder Sammuel",
      "subName": "Paladinlehrer",
      "translationMetadata": {
        "fields": {
          "dialogue.4d4612fd3f24efa98e91": {
