            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.defa41c7e3f48ecd9dac": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Må Lyset beskytte dig i dag.",
        "b4b79d9a9a1d21740f2d": "Jeg vil gerne videreuddanne mig i Lysets veje.",
        "defa41c7e3f48ecd9dac": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?"
      },
      "name": "Broder Sammuel",
      "translationMetadata": {
        "fields": {
          "dialogue.4d4612fd3f24efa98e91": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.b4b79d9a9a1d21740f2d": {
            "origin": "ai",
