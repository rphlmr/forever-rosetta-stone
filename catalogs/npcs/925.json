    "hrHR": {
      "dialogue": {
        "4d4612fd3f24efa98e91": "Neka te Svjetlost danas štiti.",
        "b4b79d9a9a1d21740f2d": "Želio bih nastaviti obuku na putevima Svjetlosti.",
        "defa41c7e3f48ecd9dac": "Temeljitom sam preobukom morao mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao poučiti iznova. Ovu je uslugu svakim ponavljanjem sve teže pružiti. Zato svaka sljedeća preobuka stoji više. Želiš li da te oslobodim talenata koje si naučio?"
      },
      "name": "Brat Sammuel",
      "translationMetadata": {
