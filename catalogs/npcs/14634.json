    "trTR": {
      "dialogue": {
        "9f4e4d031596901891b9": "Evet, doğru, yarasa gibi körüm! Ve bir... şey, sarhoş olan bir şey kadar sarhoşum.$B$BSana bir şey söyleyeyim, $r. Duyularımı keskin tutan içki. Bir duyunu kaybedince diğerlerinin keskinleştiği herkesçe bilinir. Sarhoşluk duyum bugünlerde inanılmaz."
      },
      "name": "Gözcü Kaptan Lolo Longstriker",
      "translationMetadata": {
        "fields": {
          "dialogue.9f4e4d031596901891b9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
