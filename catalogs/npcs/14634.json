  "locales": {
    "csCZ": {
      "dialogue": {
        "9f4e4d031596901891b9": "Ano, je to tak, jsem slepý jako netopýr! A opilý jako... ehm, jako něco, co se opíjí.$B$BŘeknu ti něco, $r. Pití udržuje moje smysly ostré. Každý ví, že když přijdeš o jeden smysl, ostatní se zostří. Můj opilecký smysl je v poslední době neuvěřitelný."
      },
      "name": "Kapitán hlídky Lolo Longstriker",
      "translationMetadata": {
        "fields": {
          "dialogue.9f4e4d031596901891b9": {
