    "daDK": {
      "dialogue": {
        "18759f6b6a5141050c17": "Ældste Rumblerock tilbringer årene i en hule på toppen af Dreadmaul Rock i Burning Steppes.",
        "3157c8e37309aa72034c": "Nu er tiden, hvor året er nyt, og månen skinner klart.$B$BDet er vores tid... når de gamle vågner.",
        "6796a72389c58533ea59": "Sidst jeg hørte, var ældste Starsong i det sunkne tempel i Swamp of Sorrows.",
        "7eb3bec45a1e2df51258": "Ældste Hammershout findes inden for Stormwinds mure.",
        "b631aca343ee3c73cfc9": "Ældste Skychaser skuer ud over Westfall fra toppen af Sentinel Hill."
      },
      "name": "Ældste Stormbrow",
      "translationMetadata": {
