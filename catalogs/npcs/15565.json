    "trTR": {
      "dialogue": {
        "18759f6b6a5141050c17": "Yaşlı Rumblerock yıllarını Burning Steppes'teki Dreadmaul Rock'ın tepesinde bir mağarada geçiriyor.",
        "3157c8e37309aa72034c": "Şimdi yılın yeni olduğu ve ayın parlakça ışıldadığı zaman.$B$BBu bizim zamanımız... kadimler uyandığında.",
        "6796a72389c58533ea59": "Son bildiğim kadarıyla Yaşlı Starsong, Swamp of Sorrows'taki Batık Tapınak'taydı.",
        "7eb3bec45a1e2df51258": "Yaşlı Hammershout'u Stormwind surları içinde bulabilirsin.",
        "b631aca343ee3c73cfc9": "Yaşlı Skychaser, Sentinel Hill'in tepesinden Westfall'a bakıyor."
      },
      "name": "Ulu Stormbrow",
      "translationMetadata": {
