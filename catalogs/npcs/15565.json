    "ltLT": {
      "dialogue": {
        "18759f6b6a5141050c17": "Vyresnysis Rumblerock leidžia savo metus oloje ant Dreadmaul Rock viršūnės Burning Steppes krašte.",
        "3157c8e37309aa72034c": "Dabar atėjo metas, kai metai nauji, o mėnulis ryškiai šviečia.$B$BTai mūsų metas... kai pabunda senoliai.",
        "6796a72389c58533ea59": "Kiek žinau, vyresnioji Starsong buvo Sunken Temple šventykloje Swamp of Sorrows pelkėje.",
        "7eb3bec45a1e2df51258": "Vyresnįjį Hammershout galima rasti už Stormwind sienų.",
        "b631aca343ee3c73cfc9": "Vyresnysis Skychaser nuo Sentinel Hill viršūnės žvelgia į Westfall."
      },
      "name": "Vyresnysis Stormbrow",
