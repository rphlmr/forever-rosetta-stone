  "locales": {
    "csCZ": {
      "dialogue": {
        "18759f6b6a5141050c17": "Starší Rumblerock tráví léta v jeskyni na vrcholu Dreadmaul Rock v Burning Steppes.",
        "3157c8e37309aa72034c": "Nyní nastává čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... když se probouzejí prastaří.",
        "6796a72389c58533ea59": "Pokud vím, starší Starsong byl v Potopeném chrámu v Swamp of Sorrows.",
        "7eb3bec45a1e2df51258": "Staršího Hammershouta najdeš za hradbami Stormwindu.",
        "b631aca343ee3c73cfc9": "Starší Skychaser shlíží na Westfall z vrcholu Sentinel Hillu."
      },
      "name": "Starší Stormbrow",
