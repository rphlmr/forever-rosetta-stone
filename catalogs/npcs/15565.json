    "enUS": {
      "dialogue": {
        "18759f6b6a5141050c17": "Elder Rumblerock passes the years in a cave atop Dreadmaul Rock in the Burning Steppes.",
        "3157c8e37309aa72034c": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "6796a72389c58533ea59": "Last I knew, Elder Starsong was in the Sunken Temple of the Swamp of Sorrows.",
        "7eb3bec45a1e2df51258": "Elder Hammershout can be found within the walls of Stormwind.",
        "b631aca343ee3c73cfc9": "Elder Skychaser looks out over Westfall from atop Sentinel Hill."
      },
      "name": "Elder Stormbrow",
      "translationMetadata": {
        "fields": {
