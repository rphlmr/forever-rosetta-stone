    "deDE": {
      "dialogue": {
        "18759f6b6a5141050c17": "Urahne Rumblerock verbringt die Jahre in einer Höhle am Gipfel des Schreckensfelsens in der brennenden Steppe.",
        "3157c8e37309aa72034c": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "6796a72389c58533ea59": "Soweit ich weiß, hält sich Urahnin Starsong im Versunkenen Tempel in den Sümpfen des Elends auf.",
        "7eb3bec45a1e2df51258": "Urahne Hammershout hält sich innerhalb der Mauern von Stormwind auf.",
        "b631aca343ee3c73cfc9": "Urahnin Skychaser wacht von der Späherkuppe aus über Westfall."
      },
      "name": "Urahne Stormbrow",
