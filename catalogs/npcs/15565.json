    "svSE": {
      "dialogue": {
        "18759f6b6a5141050c17": "Äldste Rumblerock tillbringar åren i en grotta på toppen av Dreadmaul Rock i Burning Steppes.",
        "3157c8e37309aa72034c": "Nu är tiden då året är nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "6796a72389c58533ea59": "Senast jag hörde var äldste Starsong i det sjunkna templet i Swamp of Sorrows.",
        "7eb3bec45a1e2df51258": "Äldste Hammershout finns innanför Stormwinds murar.",
        "b631aca343ee3c73cfc9": "Äldste Skychaser blickar ut över Westfall från toppen av Sentinel Hill."
      },
      "name": "Äldste Stormbrow",
