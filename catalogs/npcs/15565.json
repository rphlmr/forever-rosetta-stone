    "hrHR": {
      "dialogue": {
        "18759f6b6a5141050c17": "Starješina Rumblerock provodi godine u špilji na vrhu Dreadmaul Rocka u Burning Steppesima.",
        "3157c8e37309aa72034c": "Sada je vrijeme kad je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kad se drevni bude.",
        "6796a72389c58533ea59": "Koliko znam, starješina Starsong bio je u Potopljenom hramu u Swamp of Sorrowsu.",
        "7eb3bec45a1e2df51258": "Starješinu Hammershouta možeš pronaći unutar zidina Stormwinda.",
        "b631aca343ee3c73cfc9": "Starješina Skychaser promatra Westfall s vrha Sentinel Hilla."
      },
      "name": "Starješina Stormbrow",
