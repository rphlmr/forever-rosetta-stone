    "plPL": {
      "dialogue": {
        "18759f6b6a5141050c17": "Starszy Rumblerock spędza lata w jaskini na szczycie Dreadmaul Rock w Burning Steppes.",
        "3157c8e37309aa72034c": "Nadszedł czas, gdy rok jest nowy, a księżyc świeci jasno.$B$BTo nasz czas... gdy pradawni się budzą.",
        "6796a72389c58533ea59": "O ile wiem, starszy Starsong był w Zatopionej Świątyni na Swamp of Sorrows.",
        "7eb3bec45a1e2df51258": "Starszego Hammershouta znajdziesz w murach Stormwind.",
        "b631aca343ee3c73cfc9": "Starszy Skychaser spogląda na Westfall ze szczytu Sentinel Hill."
      },
      "name": "Starszy Stormbrow",
      "translationMetadata": {
