    "ptBR": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "O ancião Laureaneve se encontra na Capela Esperança da Luz, que fica nas Terras Pestilentas Orientais.",
        "54dd7e9bde0e0fd3af1f": "As estrelas desta época iluminam outros caminhos – raios de força e esperança para as eras vindouras.",
        "ac83258c32feae4f9a1a": "O ancião Nascitumba passa seu tempo perto de Montalvo, em Clareiras de Tirisfal.",
        "c8ac9691aaecec6a05c6": "A anciã Raioluna se encontra em Scolomântia, nas Terras Pestilentas Ocidentais.",
        "e2a79bf4e672204d04b9": "O ancião Andavento mora na Torre da Coroa, que fica nas Terras Pestilentas Orientais."
      },
      "name": "Anciã Correcampo",
