  "locales": {
    "csCZ": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Starší Snowcrown se nachází v kapli Light’s Hope ve Východních morových zemích.",
        "54dd7e9bde0e0fd3af1f": "Hvězdy této doby se vydávají novými cestami, jsou majáky naděje a síly pro nadcházející věky.",
        "ac83258c32feae4f9a1a": "Starší Graveborn tráví čas poblíž Brillu v Tirisfalských pasekách.",
        "c8ac9691aaecec6a05c6": "Starší Moonstrike se nachází ve Scholomance v Západních morových zemích.",
        "e2a79bf4e672204d04b9": "Starší Windrun sídlí ve věži Crown Guard ve Východních morových zemích."
      },
      "name": "Starší Meadowrun",
