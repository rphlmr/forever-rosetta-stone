    "ltLT": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Vyresnįjį Snowcrown galima rasti Light's Hope koplyčioje Rytų maro žemėse.",
        "54dd7e9bde0e0fd3af1f": "Šių laikų žvaigždės suka naujais keliais, tapdamos vilties ir stiprybės švyturiais ateinantiems amžiams.",
        "ac83258c32feae4f9a1a": "Vyresnysis Graveborn leidžia laiką netoli Brill, Tirisfalio proskynose.",
        "c8ac9691aaecec6a05c6": "Vyresnįjį Moonstrike galima rasti Scholomance Vakarų maro žemėse.",
        "e2a79bf4e672204d04b9": "Vyresnysis Windrun gyvena Crown Guard bokšte Rytų maro žemėse."
      },
      "name": "Vyresnysis Meadowrun",
