    "enUS": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Elder Snowcrown can be found in Light's Hope Chapel in the Eastern Plaguelands.",
        "54dd7e9bde0e0fd3af1f": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "ac83258c32feae4f9a1a": "Elder Graveborn spends time near Brill in Tirisfal Glades.",
        "c8ac9691aaecec6a05c6": "Elder Moonstrike can be found in the Scholomance in the Western Plaguelands.",
        "e2a79bf4e672204d04b9": "Elder Windrun resides in the Crown Guard Tower in the Eastern Plaguelands."
      },
      "name": "Elder Meadowrun",
