    "plPL": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Starszego Snowcrowna można znaleźć w Kaplicy Światłości we Wschodnich Ziemiach Plagi.",
        "54dd7e9bde0e0fd3af1f": "Gwiazdy tych czasów podążają nowymi drogami, będąc latarniami nadziei i siły dla nadchodzących epok.",
        "ac83258c32feae4f9a1a": "Starszy Graveborn przebywa w pobliżu Brill na Polanach Tirisfal.",
        "c8ac9691aaecec6a05c6": "Starszego Moonstrike’a można znaleźć w Scholomance w Zachodnich Ziemiach Plagi.",
        "e2a79bf4e672204d04b9": "Starszy Windrun przebywa w wieży Crown Guard we Wschodnich Ziemiach Plagi."
      },
      "name": "Starsza Meadowrun",
