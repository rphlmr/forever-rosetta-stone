    "daDK": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Ældste Snowcrown findes i Light’s Hope Chapel i Eastern Plaguelands.",
        "54dd7e9bde0e0fd3af1f": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "ac83258c32feae4f9a1a": "Ældste Graveborn opholder sig nær Brill i Tirisfal Glades.",
        "c8ac9691aaecec6a05c6": "Ældste Moonstrike findes i Scholomance i Western Plaguelands.",
        "e2a79bf4e672204d04b9": "Ældste Windrun opholder sig i Crown Guard Tower i Eastern Plaguelands."
      },
      "name": "Ældste Meadowrun",
