    "hrHR": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Starješina Snowcrown nalazi se u kapelici Light’s Hope u Istočnim okuženim zemljama.",
        "54dd7e9bde0e0fd3af1f": "Zvijezde ovog doba kreću novim putovima, svjetionici nade i snage za nadolazeća doba.",
        "ac83258c32feae4f9a1a": "Starješina Graveborn provodi vrijeme blizu Brilla na Proplancima Tirisfala.",
        "c8ac9691aaecec6a05c6": "Starješina Moonstrike nalazi se u Scholomanceu u Zapadnim okuženim zemljama.",
        "e2a79bf4e672204d04b9": "Starješina Windrun boravi u tornju Crown Guard u Istočnim okuženim zemljama."
      },
