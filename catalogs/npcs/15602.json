    "svSE": {
      "dialogue": {
        "1e288e9ac3560dff3a0d": "Äldste Snowcrown finns i Light’s Hope Chapel i Eastern Plaguelands.",
        "54dd7e9bde0e0fd3af1f": "Denna tids stjärnor följer nya banor, ljus av hopp och styrka för kommande tidsåldrar.",
        "ac83258c32feae4f9a1a": "Äldste Graveborn håller till nära Brill i Tirisfal Glades.",
        "c8ac9691aaecec6a05c6": "Äldste Moonstrike finns i Scholomance i Western Plaguelands.",
        "e2a79bf4e672204d04b9": "Äldste Windrun bor i Crown Guard Tower i Eastern Plaguelands."
