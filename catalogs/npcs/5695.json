    "esES": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Entréname.",
        "3a6a1629c0531bf377c8": "¡Saludos, viajero! ¿Quieres sumergirte en los misterios de la magia Arcana? ¿Um?",
        "9a3bbd0f53b643c1ebdd": "No está mal... Supongo que todavía puedes recibir más instrucción. ¡Muy bien! Comencemos...",
        "c6bfa9bf2f05442bd72d": "¡Incluso yo tengo limitaciones! Ve a hablar con Lavinia Crowe en Entrañas si deseas recibir más instrucción."
      },
      "name": "Vance Bajopenumbra",
      "subName": "Oficial encantador",
