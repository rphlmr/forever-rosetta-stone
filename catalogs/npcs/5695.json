    "svSE": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Träna mig.",
        "3a6a1629c0531bf377c8": "Var hälsad, resande! Vill du utforska den arkana magins mysterier? Hm?",
        "9a3bbd0f53b643c1ebdd": "Inte illa... Jag antar att det inte är uteslutet att träna dig. Nåväl! Låt oss börja...",
        "c6bfa9bf2f05442bd72d": "Även jag har mina begränsningar! Tala med Lavinia Crowe i Undercity om du vill fortsätta din träning."
      },
      "name": "Vance Undergloom",
