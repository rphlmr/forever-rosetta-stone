    "enUS": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Train me.",
        "3a6a1629c0531bf377c8": "Greetings, traveler! Care to delve into the mysteries of the arcane? Hm?",
        "9a3bbd0f53b643c1ebdd": "Not bad... I suppose training you is not out of the question. Very well! Let's begin...",
        "c6bfa9bf2f05442bd72d": "Even I have my limitations! Go talk to Lavinia Crowe in Undercity if you wish to further your training."
      },
      "name": "Vance Undergloom",
      "subName": "Journeyman Enchanter",
