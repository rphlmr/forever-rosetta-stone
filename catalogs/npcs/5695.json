  "locales": {
    "csCZ": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Vycvičte mě.",
        "3a6a1629c0531bf377c8": "Zdravím, poutníku! Chceš proniknout do tajů arkánní magie? Hm?",
        "9a3bbd0f53b643c1ebdd": "Není to špatné... Myslím, že tvůj výcvik není vyloučený. Dobrá! Začněme...",
        "c6bfa9bf2f05442bd72d": "I já mám své hranice! Pokud chceš pokračovat ve výcviku, promluv si s Lavinií Crowe v Undercity."
      },
      "name": "Vance Undergloom",
      "translationMetadata": {
        "fields": {
