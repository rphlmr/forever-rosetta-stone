    "hrHR": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Podučite me.",
        "3a6a1629c0531bf377c8": "Pozdrav, putniče! Želiš li istražiti tajne arkane? Hm?",
        "9a3bbd0f53b643c1ebdd": "Nije loše... Pretpostavljam da bih te mogao podučavati. Vrlo dobro! Počnimo...",
        "c6bfa9bf2f05442bd72d": "Čak i ja imam svoje granice! Razgovaraj s Laviniom Crowe u Undercityju ako želiš nastaviti obuku."
      },
      "name": "Vance Undergloom",
