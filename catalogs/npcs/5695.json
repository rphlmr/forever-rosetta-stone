    "daDK": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Træn mig.",
        "3a6a1629c0531bf377c8": "Vel mødt, rejsende! Har du lyst til at udforske den arkane magis mysterier? Hm?",
        "9a3bbd0f53b643c1ebdd": "Ikke dårligt... Jeg kan vel godt overveje at træne dig. Udmærket! Lad os begynde...",
        "c6bfa9bf2f05442bd72d": "Selv jeg har mine begrænsninger! Tal med Lavinia Crowe i Undercity, hvis du vil fortsætte din træning."
      },
      "name": "Vance Undergloom",
      "translationMetadata": {
