    "ptBR": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Treine-me.",
        "3a6a1629c0531bf377c8": "Saudações, viajante! Você tem interesse em pesquisar os mistérios do arcano? Hein?",
        "9a3bbd0f53b643c1ebdd": "Nada mal... suponho que treinar você não esteja fora de questão. Muito bem! Vamos começar...",
        "c6bfa9bf2f05442bd72d": "Até eu tenho minhas limitações! Vá falar com Lavínia Queiroz, na Cidade Baixa, se quiser aprofundar seu treinamento."
      },
      "name": "Vance Merencório",
      "subName": "Encantador Profissional",
