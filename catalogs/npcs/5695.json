    "trTR": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Beni eğit.",
        "3a6a1629c0531bf377c8": "Selamlar, yolcu! Gizemli büyünün sırlarını araştırmak ister misin? Hı?",
        "9a3bbd0f53b643c1ebdd": "Fena değil... Sanırım seni eğitmem söz konusu olabilir. Pekâlâ! Başlayalım...",
        "c6bfa9bf2f05442bd72d": "Benim bile sınırlarım var! Eğitimine devam etmek istiyorsan Undercity'deki Lavinia Crowe ile konuş."
      },
      "name": "Vance Undergloom",
