    "frFR": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Entraînez-moi.",
        "3a6a1629c0531bf377c8": "Salutations ! Vous voulez vous immerger dans les mystères des arcanes ? Hum ?",
        "9a3bbd0f53b643c1ebdd": "Pas mal... Je suppose que vous apprendre mes secrets n'est pas exclu... Alors très bien ! Commençons !",
        "c6bfa9bf2f05442bd72d": "Même moi, j'ai mes limites ! Allez parler à Lavinia Crowe, dans Undercity, si vous voulez poursuivre votre entraînement."
      },
      "name": "Vance Undergloom",
      "subName": "Enchanteur - Compagnon",
