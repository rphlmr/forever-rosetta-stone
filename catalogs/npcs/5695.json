    "itIT": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Addestrami.",
        "3a6a1629c0531bf377c8": "Salve, viandante! Ti va di addentrarti nei misteri dell'arcano? Eh?",
        "9a3bbd0f53b643c1ebdd": "Niente male... Immagino che addestrarti non sia fuori discussione. Molto bene! Cominciamo...",
        "c6bfa9bf2f05442bd72d": "Persino io ho i miei limiti! Va' a parlare con Lavinia Crowe a Undercity, se vuoi proseguire il tuo addestramento."
      },
      "name": "Vance Undergloom",
