    "plPL": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Wyszkol mnie.",
        "3a6a1629c0531bf377c8": "Witaj, wędrowcze! Chcesz zgłębić tajemnice magii tajemnej? Hm?",
        "9a3bbd0f53b643c1ebdd": "Nieźle... Sądzę, że mogę rozważyć szkolenie cię. Bardzo dobrze! Zaczynajmy...",
        "c6bfa9bf2f05442bd72d": "Nawet ja mam swoje ograniczenia! Porozmawiaj z Lavinią Crowe w Undercity, jeśli chcesz kontynuować naukę."
      },
      "name": "Vance Undergloom",
      "translationMetadata": {
