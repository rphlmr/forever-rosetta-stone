    "ltLT": {
      "dialogue": {
        "2c377f830cc17a9c21a8": "Apmokyk mane.",
        "3a6a1629c0531bf377c8": "Sveikas, keliautojau! Norėtum pasinerti į magijos paslaptis? Hm?",
        "9a3bbd0f53b643c1ebdd": "Neblogai... Manau, galėčiau tave apmokyti. Ką gi! Pradėkime...",
        "c6bfa9bf2f05442bd72d": "Net ir mano galimybės ribotos! Jei nori mokytis toliau, pasikalbėk su Lavinia Crowe Undercity mieste."
      },
      "name": "Vance Undergloom",
      "subName": "Kerėtojas, pažengęs mokinys",
