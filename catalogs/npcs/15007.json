    "enUS": {
      "dialogue": {
        "0e4f9cc98f83875f1d00": "I am sorry $c, but you need to be more powerful before I can allow you to enter Arathi Basin.",
        "1f2cb4c78fab0da04c97": "Look around you $c.  You are in rare company to be certain, yet still I think you need to prove yourself.  Hmm, perhaps I shall allow you to aid us in our cause at Arathi Basin.  Would you like that?"
      },
      "name": "Sir Malory Wheeler",
      "subName": "Arathi Basin Battlemaster",
      "translationMetadata": {
