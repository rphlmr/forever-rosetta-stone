  "locales": {
    "csCZ": {
      "dialogue": {
        "0e4f9cc98f83875f1d00": "Je mi líto, $c, ale než ti dovolím vstoupit do Arathijské pánve, musíš zesílit.",
        "1f2cb4c78fab0da04c97": "Rozhlédni se kolem, $c. Jsi ve vybrané společnosti, o tom není pochyb, přesto si myslím, že se ještě musíš osvědčit. Hmm, možná ti dovolím pomoci nám v Arathijské pánvi. Chtěl bys?"
      },
      "name": "Sir Malory Wheeler",
      "translationMetadata": {
        "fields": {
          "dialogue.0e4f9cc98f83875f1d00": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.1f2cb4c78fab0da04c97": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
