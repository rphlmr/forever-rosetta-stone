            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "0e4f9cc98f83875f1d00": "Det beklager jeg, $c, men du skal være stærkere, før jeg kan lade dig komme ind i Arathi Basin.",
        "1f2cb4c78fab0da04c97": "Se dig omkring, $c. Du er bestemt i fornemt selskab, men jeg mener stadig, at du må bevise dit værd. Hmm, måske vil jeg lade dig hjælpe vores sag i Arathi Basin. Kunne du tænke dig det?"
      },
      "name": "Sir Malory Wheeler",
      "translationMetadata": {
        "fields": {
          "dialogue.0e4f9cc98f83875f1d00": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.1f2cb4c78fab0da04c97": {
