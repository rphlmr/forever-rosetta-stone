    "itIT": {
      "dialogue": {
        "0f913472ebbe6072267e": "Addestrami.",
        "3d55facc4ff2b3e5d64e": "Vuoi addestrarti? Con me? Fantastico! L'unica cosa più bella che montare proiettili e ordigni esplosivi è insegnare a farlo a qualcun altro! Cominciamo!",
        "8bc9a68937308cc42b80": "Ciao! Mi chiamo Jenna! E tu?",
        "8e5b8f110e87484c0ad6": "Oh, hai ancora un sacco di cose da imparare. Ti insegnerei tutto se potessi, ma sto ancora imparando anch'io! Perché non vai a parlare con Trixie Quickswitch a Ironforge? Ti aiuterà a proseguire la tua formazione!"
      },
      "name": "Jenna Lemkenilli",
      "translationMetadata": {
