    "esES": {
      "dialogue": {
        "0f913472ebbe6072267e": "Entréname.",
        "3d55facc4ff2b3e5d64e": "¿Quieres instruirte? ¿Conmigo¿ ¡Fantástico! Solo hay una cosa mejor que fabricar balas y explosivos: compartir ese conocimiento con alguien más. ¡Vamos a empezar!",
        "8bc9a68937308cc42b80": "¡Hola! ¡Me llamo Jenna! ¿Y tú?",
        "8e5b8f110e87484c0ad6": "Oh, aún tienes muchas cosas que aprender. Te enseñaría todo si pudiera, ¡pero yo también sigo aprendiendo! ¿Por qué no vas a hablar con Trixie Chispaveloz en Forjaz? ¡Te ayudará a seguir adelante con tu educación!"
      },
      "name": "Jenna Lemkenilli",
      "subName": "Oficial de ingeniería",
