    "hrHR": {
      "dialogue": {
        "0f913472ebbe6072267e": "Podučite me.",
        "3d55facc4ff2b3e5d64e": "Želiš učiti? Od mene? Fantastično! Jedino bolje od sastavljanja metaka i eksplozivnih naprava jest podijeliti to znanje s nekim drugim! Krenimo!",
        "8bc9a68937308cc42b80": "Bok! Zovem se Jenna! A ti? ",
        "8e5b8f110e87484c0ad6": "Oh, još mnogo toga moraš naučiti. Naučila bih te svemu kad bih mogla, ali i sama još učim! Razgovaraj s Trixie Quickswitch u Ironforgeu, ona će ti pomoći nastaviti školovanje!"
      },
      "name": "Jenna Lemkenilli",
      "translationMetadata": {
