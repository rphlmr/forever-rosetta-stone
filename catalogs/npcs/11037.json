  "locales": {
    "csCZ": {
      "dialogue": {
        "0f913472ebbe6072267e": "Vycvičte mě.",
        "3d55facc4ff2b3e5d64e": "Chceš se učit? Ode mě? Báječné! Jediná věc lepší než sestavování nábojů a výbušnin je sdílet tyto znalosti s někým dalším! Pusťme se do toho!",
        "8bc9a68937308cc42b80": "Ahoj! Jmenuji se Jenna! A ty? ",
        "8e5b8f110e87484c0ad6": "Ach, ještě se toho musíš spoustu naučit. Naučila bych tě všechno, kdybych mohla, ale sama se stále učím! Promluv si s Trixie Quickswitch v Ironforge, pomůže ti s dalším vzděláváním!"
      },
      "name": "Jenna Lemkenilli",
      "translationMetadata": {
        "fields": {
          "dialogue.0f913472ebbe6072267e": {
