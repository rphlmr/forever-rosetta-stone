    },
    "plPL": {
      "dialogue": {
        "00cdefd315f95edec9b6": "Dziś nie ma walk, kolego. Horda i Przymierze są zbyt zajęte zabijaniem się na polach, choć mogliby zarobić niezłą monetę, robiąc to na mojej arenie! Zrozum ich.\n\nWróć, kiedy uruchomię to miejsce."
      },
      "name": "Jazzle Cheapshot",
      "translationMetadata": {
        "fields": {
          "dialogue.00cdefd315f95edec9b6": {
