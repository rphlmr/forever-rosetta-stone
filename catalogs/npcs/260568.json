  "locales": {
    "csCZ": {
      "dialogue": {
        "00cdefd315f95edec9b6": "Dneska žádné zápasy nejsou, kámo. Horda a Aliance jsou moc zaměstnané vzájemným zabíjením venku na polích, přitom by si za to samé mohly v mojí aréně pěkně vydělat! To člověk nepochopí.\n\nVrať se, až to tu zase rozjedu."
      },
      "name": "Jazzle Cheapshot",
      "translationMetadata": {
        "fields": {
          "dialogue.00cdefd315f95edec9b6": {
