    },
    "enUS": {
      "dialogue": {
        "00cdefd315f95edec9b6": "No fights goin' on today, pal. The Horde and the Alliance are too busy killin' each other out in the fields when there's perfectly good coin to be made doin' that in my arena! Go figure.\n\nCome back when I get this place up and runnin'."
      },
      "name": "Jazzle Cheapshot",
      "translationMetadata": {
        "fields": {
          "dialogue.00cdefd315f95edec9b6": {
