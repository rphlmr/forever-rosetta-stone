    "hrHR": {
      "dialogue": {
        "00cdefd315f95edec9b6": "Danas nema borbi, prijatelju. Horda i Savez prezauzeti su međusobnim ubijanjem na poljima, a mogli bi dobro zaraditi radeći isto u mojoj areni! Tko bi ih razumio.\n\nVrati se kad pokrenem ovo mjesto."
      },
      "name": "Jazzle Cheapshot",
      "translationMetadata": {
        "fields": {
          "dialogue.00cdefd315f95edec9b6": {
