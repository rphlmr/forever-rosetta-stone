    "enUS": {
      "dialogue": {
        "6ab36070328fe3f7dca4": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes."
      },
      "name": "Aramis Hammerhand",
      "subName": "Paladin Trainer",
