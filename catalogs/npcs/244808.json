    },
    "daDK": {
      "dialogue": {
        "6ab36070328fe3f7dca4": "Hvis du ønsker det, kan jeg ud over træning også fjerne kendskabet til dine talenter fra dit sind. Vær advaret: Proceduren bliver sværere at udføre hver gang og derfor også dyrere."
      },
      "name": "Aramis Hammerhand",
      "translationMetadata": {
