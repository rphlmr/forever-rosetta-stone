  "locales": {
    "csCZ": {
      "dialogue": {
        "6ab36070328fe3f7dca4": "Budeš-li si přát, mohu ti kromě výcviku také vymazat znalost tvých talentů z mysli. Věz, že každé další provedení tohoto postupu je obtížnější, a proto i dražší."
      },
      "name": "Aramis Hammerhand",
      "translationMetadata": {
        "fields": {
