    "plPL": {
      "dialogue": {
        "fc3680a08786539a19a3": "Odpowiadam za funkcjonowanie wioski Shen’dar i muszę mieć tu oko na wiele spraw. Bandyci, kultyści i inne nieprzewidziane zdarzenia sprawiają, że utrzymanie wioski wymaga mnóstwa pracy."
      },
      "name": "Teeri Wellwind",
      "translationMetadata": {
