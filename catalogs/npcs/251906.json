    "enUS": {
      "dialogue": {
        "fc3680a08786539a19a3": "I'm in charge of Shen'dar Village operations, and there's a lot of things to keep track of around here. Between bandits, cultists, and other random incidents that pop up, keeping this village afloat is a lot of work."
      },
      "name": "Teeri Wellwind",
      "translationMetadata": {
        "fields": {
