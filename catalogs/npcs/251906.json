    "daDK": {
      "dialogue": {
        "fc3680a08786539a19a3": "Jeg har ansvaret for driften af Shen’dar Village, og der er meget at holde styr på her. Med banditter, kultister og andre uventede hændelser kræver det meget arbejde at holde landsbyen kørende."
      },
      "name": "Teeri Wellwind",
      "translationMetadata": {
