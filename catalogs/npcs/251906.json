    "hrHR": {
      "dialogue": {
        "fc3680a08786539a19a3": "Zadužena sam za rad sela Shen’dar i ovdje treba pratiti mnogo toga. Uz razbojnike, kultiste i druge nepredviđene događaje, održavanje sela na životu zahtijeva mnogo rada."
      },
      "name": "Teeri Wellwind",
