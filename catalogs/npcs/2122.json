    "enUS": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "I can not train you. You need to talk to your class trainer.",
        "627e63e9538122b4df25": "With the sanction of Lord Varimathras, the Deathstalkers' numbers grow. More blades to strike at our enemies when they least expect it.",
        "d87ef3e75df8360cdbb4": "I would like to train."
      },
      "name": "David Trias",
      "subName": "Rogue Trainer",
