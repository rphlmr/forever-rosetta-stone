    "trTR": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Seni eğitemem. Sınıf eğitmeninle konuşmalısın.",
        "627e63e9538122b4df25": "Lord Varimathras'ın onayıyla Ölüm Avcılarının sayısı artıyor. Düşmanlarımıza en az bekledikleri anda saldıracak daha fazla kılıç.",
        "d87ef3e75df8360cdbb4": "Eğitim almak istiyorum."
      },
      "name": "David Trias",
