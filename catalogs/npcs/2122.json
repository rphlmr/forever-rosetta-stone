        }
      }
    },
    "deDE": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Ich kann Euch nicht ausbilden. Da müsst Ihr mit dem Lehrer für Eure Klasse sprechen.",
        "627e63e9538122b4df25": "Mit Zustimmung von Lord Varimathras steigt die Anzahl der Todespirscher an. Mehr Klingen, die unsere Feinde treffen, wenn sie es am wenigsten erwarten.",
        "d87ef3e75df8360cdbb4": "Ich möchte ausgebildet werden."
      },
      "name": "David Trias",
      "subName": "Schurkenlehrer",
      "translationMetadata": {
