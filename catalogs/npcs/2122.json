    "svSE": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Jag kan inte träna dig. Du måste tala med din klasstränare.",
        "627e63e9538122b4df25": "Med lord Varimathras godkännande växer Dödssmygarnas skara. Fler klingor som kan slå till mot våra fiender när de minst anar det.",
        "d87ef3e75df8360cdbb4": "Jag vill träna."
