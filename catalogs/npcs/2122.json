    "hrHR": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Ne mogu te obučavati. Moraš razgovarati s učiteljem svoje klase.",
        "627e63e9538122b4df25": "Uz odobrenje lorda Varimathrasa, redovi Smrtonosaca rastu. Više oštrica za udar na naše neprijatelje kad se najmanje nadaju.",
        "d87ef3e75df8360cdbb4": "Želim trenirati."
