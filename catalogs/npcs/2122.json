    "frFR": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Je ne peux pas vous aider, vous devez vous adresser à votre maître de classe.",
        "627e63e9538122b4df25": "Avec le consentement du seigneur Varimathras, l’effectif des Traqueurs noirs augmente. Cela représente plus de gaillards pour frapper nos ennemis quand ils s'y attendront le moins.",
        "d87ef3e75df8360cdbb4": "J’aimerais m'entraîner."
      },
