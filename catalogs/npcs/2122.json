      }
    },
    "daDK": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Jeg kan ikke træne dig. Du skal tale med din klassetræner.",
        "627e63e9538122b4df25": "Med lord Varimathras' velsignelse vokser Dødsspejdernes rækker. Flere klinger til at ramme vores fjender, når de mindst venter det.",
        "d87ef3e75df8360cdbb4": "Jeg vil gerne trænes."
      },
      "name": "David Trias",
      "translationMetadata": {
        "fields": {
          "dialogue.03dc5d1f7c6c810ad691": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
