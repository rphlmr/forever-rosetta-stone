  "locales": {
    "csCZ": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Nemohu tě cvičit. Musíš si promluvit s trenérem svého povolání.",
        "627e63e9538122b4df25": "Se svolením lorda Varimathrase se řady Smrtistopů rozrůstají. Více čepelí udeří na naše nepřátele, až to budou nejméně čekat.",
        "d87ef3e75df8360cdbb4": "Chci se vycvičit."
      },
      "name": "David Trias",
      "translationMetadata": {
        "fields": {
          "dialogue.03dc5d1f7c6c810ad691": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
