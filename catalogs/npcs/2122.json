    "ltLT": {
      "dialogue": {
        "03dc5d1f7c6c810ad691": "Negaliu tavęs mokyti. Tau reikia pasikalbėti su savo klasės mokytoju.",
        "627e63e9538122b4df25": "Lordui Varimathras pritarus, Deathstalkers gretos auga. Daugiau ašmenų smogs mūsų priešams tada, kai jie mažiausiai to tikėsis.",
        "d87ef3e75df8360cdbb4": "Norėčiau pasimokyti."
      },
      "name": "David Trias",
      "subName": "Nesąžiningųjų mokytojas",
