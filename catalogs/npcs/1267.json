    "itIT": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Addestrami.",
        "c077be1a020b199b168c": "Benvenuto alla Distilleria Thunderbrew, fondata dal caro vecchio papà Arkilus Thunderbrew. Porto avanti l’attività da quando mio fratello maggiore Grimbooze è sparito in una sbornia qualche raccolto fa.",
        "dbad0f808e15423d4ae5": "Vorrei vedere la tua merce."
      },
      "name": "Ragnar Thunderbrew",
