    "trTR": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Beni eğit.",
        "c077be1a020b199b168c": "Sevgili yaşlı babam Arkilus Thunderbrew’un kurduğu Thunderbrew İçki Fabrikası’na hoş geldin. Ağabeyim Grimbooze birkaç hasat önce sarhoşluk sisi içinde kaybolduğundan beri burayı ben işletiyorum.",
        "dbad0f808e15423d4ae5": "Mallarına bakmak istiyorum."
      },
      "name": "Ragnar Thunderbrew",
