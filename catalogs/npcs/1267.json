  "locales": {
    "csCZ": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Vycvičte mě.",
        "c077be1a020b199b168c": "Vítej v palírně Thunderbrew, kterou založil drahý starý táta Arkilus Thunderbrew. Vedu to tu od té doby, co se můj starší bratr Grimbooze před několika sklizněmi ztratil v opileckém oparu.",
        "dbad0f808e15423d4ae5": "Chci si prohlédnout vaše zboží."
      },
      "name": "Ragnar Thunderbrew",
      "translationMetadata": {
