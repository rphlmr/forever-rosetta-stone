    "esES": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Entréname.",
        "c077be1a020b199b168c": "Bienvenidos a la Destilería Thunderbrew, fundada por mi querido padre, Arkilus Thunderbrew.  He mantenido el lugar en funcionamiento desde que mi hermano mayor, Grimbooze, desapareció en una borrachera hace unas cosechas.",
        "dbad0f808e15423d4ae5": "Quiero ver tus mercancías."
      },
