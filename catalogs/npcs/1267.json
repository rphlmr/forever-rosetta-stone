    "enUS": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Train me.",
        "c077be1a020b199b168c": "Welcome to the Thunderbrew Distillery, founded by dear ol' pappy, Arkilus Thunderbrew.  I've been keeping the place running ever since my older brother, Grimbooze, disappeared in a drunken haze a few harvests ago.",
        "dbad0f808e15423d4ae5": "I want to browse your goods."
      },
      "name": "Ragnar Thunderbrew",
