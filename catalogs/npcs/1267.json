    "deDE": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Bildet mich aus.",
        "c077be1a020b199b168c": "Willkommen in der Thunderbrew Distillery, gegründet vom guten alten Papa, Arkilus Thunderbrew.  Ich halte den Laden am Laufen, seit mein älterer Bruder Grimbooze vor ein paar Ernten in einem betrunkenen Dunst verschwunden ist.",
        "dbad0f808e15423d4ae5": "Ich möchte Eure Waren ansehen."
      },
      "name": "Ragnar Donnerbräu",
