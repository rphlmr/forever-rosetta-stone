    "ptBR": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Treine-me.",
        "c077be1a020b199b168c": "Boas-vindas à Destilaria Thunderbrew, fundada pelo querido e velho papai Arkilus Thunderbrew. Cuido deste lugar desde que meu irmão mais velho, Grimbooze, desapareceu numa bebedeira algumas colheitas atrás.",
        "dbad0f808e15423d4ae5": "Quero ver suas mercadorias."
      },
