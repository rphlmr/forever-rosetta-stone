    "plPL": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Wyszkol mnie.",
        "c077be1a020b199b168c": "Witaj w gorzelni Thunderbrew, założonej przez kochanego starego tatę, Arkilusa Thunderbrewa. Prowadzę to miejsce, odkąd mój starszy brat Grimbooze zniknął w pijackim zamroczeniu kilka zbiorów temu.",
        "dbad0f808e15423d4ae5": "Chcę przejrzeć twoje towary."
      },
      "name": "Ragnar Thunderbrew",
