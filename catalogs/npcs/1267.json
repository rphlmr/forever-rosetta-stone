    "svSE": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Träna mig.",
        "c077be1a020b199b168c": "Välkommen till Thunderbrew Distillery, grundat av käre gamle far, Arkilus Thunderbrew. Jag har hållit stället igång sedan min äldre bror Grimbooze försvann i ett berusat töcken för några skördar sedan.",
        "dbad0f808e15423d4ae5": "Jag vill se dina varor."
      },
