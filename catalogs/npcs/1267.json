    "hrHR": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Podučite me.",
        "c077be1a020b199b168c": "Dobro došao u destileriju Thunderbrew, koju je osnovao dragi stari tata Arkilus Thunderbrew. Održavam je otkako je moj stariji brat Grimbooze nestao u pijanoj izmaglici prije nekoliko žetvi.",
        "dbad0f808e15423d4ae5": "Želim pogledati vašu robu."
      },
      "name": "Ragnar Thunderbrew",
