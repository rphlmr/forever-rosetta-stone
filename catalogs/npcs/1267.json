    "daDK": {
      "dialogue": {
        "23b06cdeb2854cf35e56": "Træn mig.",
        "c077be1a020b199b168c": "Velkommen til Thunderbrew Distillery, grundlagt af min kære gamle far, Arkilus Thunderbrew. Jeg har holdt stedet kørende, siden min storebror Grimbooze forsvandt i en beruset tåge for nogle høster siden.",
        "dbad0f808e15423d4ae5": "Jeg vil gerne se dine varer."
      },
      "name": "Ragnar Thunderbrew",
      "translationMetadata": {
        "fields": {
