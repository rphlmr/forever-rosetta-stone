    },
    "svSE": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Fältmarskalk Chambers morrar.>$B$BSå du är det slödder som hjälpte Didier att få hit förnödenheterna i ett stycke? Var är resten av er? Jag vet att ni måste vara fler. Fegisar som du brukar röra sig i stora flockar.$B$BÄh, ge mig det förbannade dokumentet så att jag kan skriva under.\n"
      },
      "name": "Fältmarskalk Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
