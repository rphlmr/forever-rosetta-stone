            "sourceLocale": "enUS"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Mareşal Chambers hırlar.>$B$BDemek Didier’in malzemeleri buraya sağlam getirmesine yardım eden serseri sensin? Diğerleri nerede? Daha fazla olduğunuzu biliyorum. Senin gibi korkaklar genelde büyük sürüler hâlinde dolaşır.$B$BBah, şu lanet belgeyi ver de imzalayayım.\n"
      },
      "name": "Sahra Mareşali Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
