    "ltLT": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Feldmaršalas Chambers suurzgia.>$B$BTai tu iš tų valkatų, kurie padėjo Didier atgabenti atsargas sveikas ir nepažeistas? Kur likusieji? Žinau, kad jūsų turi būti daugiau. Tokie bailiai kaip jūs paprastai bastosi didžiuliais būriais.$B$BBaikim, tiesiog duok man tą prakeiktą raštą, kad galėčiau jį pasirašyti.\n"
      },
      "name": "Feldmaršalas Chambers",
      "subName": "Sidabrinė aušra",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
