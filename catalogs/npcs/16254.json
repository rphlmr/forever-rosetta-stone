  "locales": {
    "csCZ": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Polní maršál Chambers zavrčí.>$B$BTak ty jsi ta chamraď, která pomohla Didierovi dopravit zásoby vcelku? Kde máte ostatní? Určitě vás je víc. Takoví zbabělci jako ty se obvykle potulují ve velkých hejnech.$B$BBah, dej mi ten zatracený dokument, ať ho můžu podepsat.\n"
      },
      "name": "Polní maršál Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Feltmarskal Chambers knurrer.>$B$BSå du er det pak, der hjalp Didier med at få forsyningerne hertil i ét stykke? Hvor er resten af jer? Jeg ved, der må være flere. Kyllinger som dig færdes som regel i store flokke.$B$BBah, giv mig det forbandede dokument, så jeg kan underskrive det.\n"
      },
      "name": "Feltmarskal Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
