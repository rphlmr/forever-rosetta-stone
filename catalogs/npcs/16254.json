            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "\nAllora sei tu la marmaglia che ha aiutato Didier a portare qui i rifornimenti tutti interi? E gli altri dove sono? So che dev'essercene altri. I conigli come te di solito girano in branchi enormi.\n\nBah, dammi quel dannato documento, così ci metto la firma."
      },
      "name": "Maresciallo Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
