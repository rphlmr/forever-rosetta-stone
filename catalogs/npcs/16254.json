    "enUS": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Field Marshal Chambers growls.>$B$BSo you're the riff-raff that assisted Didier in getting the supplies here in one piece? Where are the rest of you? I know there's gotta be more. Chickens like you generally roam in huge packs.$B$BBah, just give me the damned writ so I can sign off on it.\n"
      },
      "name": "Field Marshal Chambers",
      "subName": "The Argent Dawn",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
