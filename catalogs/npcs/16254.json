            "sourceLocale": "enUS"
          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Marszałek polny Chambers warczy.>$B$BWięc to ty jesteś tym łachudrą, który pomógł Didierowi dostarczyć zapasy w jednym kawałku? Gdzie reszta? Wiem, że musi być was więcej. Takie tchórze jak ty zwykle włóczą się wielkimi stadami.$B$BBah, daj mi ten przeklęty dokument, żebym mógł go podpisać.\n"
      },
      "name": "Marszałek polowy Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
