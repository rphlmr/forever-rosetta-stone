    "hrHR": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Feldmaršal Chambers zareži.>$B$BDakle, ti si onaj ološ koji je pomogao Didieru dopremiti zalihe u jednom komadu? Gdje su ostali? Znam da vas mora biti više. Kukavice poput tebe obično se kreću u velikim skupinama.$B$BBah, daj mi taj prokleti nalog da ga potpišem.\n"
      },
      "name": "Feldmaršal Chambers",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
