            "origin": "ai",
            "source": "foreverTR",
            "sourceLocale": "trTR",
            "sourceRevision": "0.1.0-beta.1"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "<Фельдмаршал Чемберс гарчить.>$B$BТо це ти з тієї наволочі, що допомогла Дідьє доставити припаси цілими? Де решта? Знаю, вас має бути більше. Такі боягузи, як ти, зазвичай ходять великими зграями.$B$BБах, дай мені той клятий документ, щоб я його підписав.\n"
      },
      "name": "фельдмаршал Чамберс",
      "translationMetadata": {
        "fields": {
