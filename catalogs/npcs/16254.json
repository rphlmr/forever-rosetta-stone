            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "cfb9b36c8af8bb0f02f0": "\nIhr seid also das Gesindel, das Didier dabei geholfen hat, die Vorräte in einem Stück hierher zu bringen. Wo ist der Rest von Euch? Da müssen doch noch mehr von Euch sein! Rumtreiber wie Ihr kommen doch selten alleine daher.\n\nBah, gebt mir diesen verdammten Wisch und ich unterschreibe ihn für Euch."
      },
      "name": "Feldmarschall Chambers",
      "subName": "Die Argentumdämmerung",
      "translationMetadata": {
        "fields": {
          "dialogue.cfb9b36c8af8bb0f02f0": {
