    "csCZ": {
      "dialogue": {
        "161c37faac2f6d9117b0": "Ukažte mi svou nabídku grimoárů.",
        "21a6d04f9b3243c2313f": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě.",
        "90bb56a2ef1c7ae6c3fe": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!"
      },
      "name": "Wren Darkspring",
      "translationMetadata": {
        "fields": {
