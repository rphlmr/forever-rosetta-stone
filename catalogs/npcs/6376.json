    "daDK": {
      "dialogue": {
        "161c37faac2f6d9117b0": "Vis mig dit udvalg af grimoirer.",
        "21a6d04f9b3243c2313f": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted.",
        "90bb56a2ef1c7ae6c3fe": "Du er ikke troldmand, og jeg har ikke tid til dig. Forsvind!"
      },
      "name": "Wren Darkspring",
      "translationMetadata": {
        "fields": {
