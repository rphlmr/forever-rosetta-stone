    "enUS": {
      "dialogue": {
        "161c37faac2f6d9117b0": "Show me your selection of grimoires.",
        "21a6d04f9b3243c2313f": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place.",
        "90bb56a2ef1c7ae6c3fe": "You're no warlock and I've no time for you.  Begone!"
      },
      "name": "Wren Darkspring",
      "subName": "Demon Trainer",
