    "deDE": {
      "dialogue": {
        "161c37faac2f6d9117b0": "Zeigt mir Eure Auswahl an Grimoires.",
        "21a6d04f9b3243c2313f": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "90bb56a2ef1c7ae6c3fe": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!"
      },
      "name": "Wren Darkspring",
      "subName": "Dämonenausbilderin",
