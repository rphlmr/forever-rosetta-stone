    "hrHR": {
      "dialogue": {
        "2bd3bbc28aba82165b72": "Dobro došao, $c. Savjetujem ti ovo: dok putuješ svijetom, čuvaj se magije jer će opeći neupućene.",
        "7ce83482c21a6bf773aa": "Zanima me obuka za maga.",
        "9567a49143a9f4889620": "Zanima me obuka za maga.",
        "b1742c85ede9a26cfdbb": "Pozdrav. Ja sam učitelj magova, a ti si mag.",
        "d91d730c80125b0724ba": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao poučiti iznova. Uslugu koju nudim sve je teže obaviti svaki put kad se ponovi. Zato je svaka preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Magis Sparkmantle",
