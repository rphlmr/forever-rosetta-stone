  "locales": {
    "csCZ": {
      "dialogue": {
        "2bd3bbc28aba82165b72": "Buď zdráv, $c. Poradím ti toto: při cestách světem se měj na pozoru před magií, neboť nevycvičené spálí.",
        "7ce83482c21a6bf773aa": "Mám zájem o výcvik mága.",
        "9567a49143a9f4889620": "Mám zájem o výcvik mága.",
        "b1742c85ede9a26cfdbb": "Zdravím. Jsem učitel mágů a ty jsi mág.",
        "d91d730c80125b0724ba": "Při důkladném přeškolování jsem musel mnohé žáky odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším opakování obtížnější. Proto je každé další přeškolení také dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Magis Sparkmantle",
      "translationMetadata": {
        "fields": {
