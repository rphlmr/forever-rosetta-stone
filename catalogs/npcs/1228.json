    "plPL": {
      "dialogue": {
        "2bd3bbc28aba82165b72": "Witaj, $c. Mam dla ciebie radę: podróżując po świecie, strzeż się magii, bo potrafi sparzyć niewyszkolonych.",
        "7ce83482c21a6bf773aa": "Interesuje mnie szkolenie maga.",
        "9567a49143a9f4889620": "Interesuje mnie szkolenie maga.",
        "b1742c85ede9a26cfdbb": "Witaj. Jestem nauczycielem magów, a ty jesteś magiem.",
        "d91d730c80125b0724ba": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc szkolić ich od nowa. Ta usługa staje się trudniejsza przy każdym kolejnym razie. Dlatego każde kolejne przeszkolenie jest droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?"
      },
      "name": "Magis Sparkmantle",
      "translationMetadata": {
        "fields": {
