    "daDK": {
      "dialogue": {
        "46ef28d0e8b90f8dfaf9": "Træn mig.",
        "a0f3a244437a930b62ad": "Din forståelse af læder er dybere end min. Måske skulle du besøge tauren Krulmoo Fullmoon i Camp Taurajo i Barrens. Han har megen viden at tilbyde en elev med dine evner.",
        "f227b3ac012aa3b8f0e7": "Hulerne under os er en kilde til mærkelige og forunderlige huder, men vær forsigtig, hvis du vover dig ned i dybet, $n. Husk, at dit eget skind er langt mere værdifuldt."
      },
      "name": "Waldor",
      "translationMetadata": {
        "fields": {
          "dialogue.46ef28d0e8b90f8dfaf9": {
