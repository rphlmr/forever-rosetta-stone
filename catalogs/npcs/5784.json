    "enUS": {
      "dialogue": {
        "46ef28d0e8b90f8dfaf9": "Train me.",
        "a0f3a244437a930b62ad": "Your understanding of leather is deeper than my own. Perhaps you should visit the tauren Krulmoo Fullmoon in Camp Taurajo of the Barrens. He has much knowledge to offer a student of your talents.",
        "f227b3ac012aa3b8f0e7": "The caverns below us are a source of strange and wondrous hides, but you must take care if you venture into their depths, $n. Remember that your own skin is far more valuable."
      },
      "name": "Waldor",
      "subName": "Journeyman Leatherworker",
      "translationMetadata": {
