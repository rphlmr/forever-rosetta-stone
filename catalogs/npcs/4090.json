  "locales": {
    "csCZ": {
      "dialogue": {
        "7ae057b42489fb6271ed": "Hledám další výcvik v kněžském umění.",
        "8667c4edd13933b97db3": "Má moudrost i znalosti jsou ti k dispozici. Co pro tebe mohu udělat, $n?",
        "a54baabfe54877080175": "Důkladným přeškolením jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl učit znovu. Tato služba je pokaždé obtížnější, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil získané talenty?",
        "abee6c788d65cba1feaa": "Elune s tebou, $c."
      },
      "name": "Astarii Starseeker",
      "translationMetadata": {
        "fields": {
