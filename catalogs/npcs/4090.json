    "daDK": {
      "dialogue": {
        "7ae057b42489fb6271ed": "Jeg søger mere træning i præsternes kunst.",
        "8667c4edd13933b97db3": "Min visdom og viden står til din rådighed. Hvad kan jeg gøre for dig, $n?",
        "a54baabfe54877080175": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de før havde lært, så jeg kunne undervise dem på ny. Tjenesten bliver vanskeligere hver gang og derfor også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme dine lærte talenter?",
        "abee6c788d65cba1feaa": "Elune være med dig, $c."
      },
      "name": "Astarii Starseeker",
      "translationMetadata": {
        "fields": {
