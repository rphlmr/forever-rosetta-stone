    "plPL": {
      "dialogue": {
        "7ae057b42489fb6271ed": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "8667c4edd13933b97db3": "Moja mądrość i wiedza są do twojej dyspozycji. Co mogę dla ciebie zrobić, $n?",
        "a54baabfe54877080175": "Dzięki surowemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, aby móc uczyć ich od nowa. Ta usługa staje się coraz trudniejsza przy każdym wykonaniu, dlatego każde kolejne przeszkolenie jest droższe. Czy chcesz, abym oduczył cię poznanych talentów?",
        "abee6c788d65cba1feaa": "Niech Elune będzie z tobą, $c."
      },
      "name": "Astarii Starseeker",
      "translationMetadata": {
