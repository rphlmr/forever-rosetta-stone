    "hrHR": {
      "dialogue": {
        "7ae057b42489fb6271ed": "Tražim daljnju poduku u svećeničkom umijeću.",
        "8667c4edd13933b97db3": "Moja mudrost i znanje na raspolaganju su ti. Što mogu učiniti za tebe, $n?",
        "a54baabfe54877080175": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno poučiti. Ta usluga svakim je izvođenjem sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "abee6c788d65cba1feaa": "Elune bila s tobom, $c."
      },
      "name": "Astarii Starseeker",
