    "ltLT": {
      "dialogue": {
        "7ae057b42489fb6271ed": "Noriu daugiau sužinoti apie kunigo kelią.",
        "8667c4edd13933b97db3": "Mano išmintis ir žinios priklauso tau. Kuo galiu tau padėti, $n?",
        "a54baabfe54877080175": "Griežtai permokydama turėjau priversti daugelį mokinių atsisakyti visko, ką jie buvo išmokę, kad galėčiau mokyti juos iš naujo. Kaskart tai padaryti darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?",
        "abee6c788d65cba1feaa": "Tegul Elune būna su tavimi, $c."
      },
      "name": "Astarii Starseeker",
      "subName": "Kunigų mokytoja",
