  "locales": {
    "csCZ": {
      "dialogue": {
        "110a289da8ec6a5709d9": "Mám zájem o výcvik mága.",
        "6ff17e140113c6dc21d7": "Mám zájem o výcvik mága.",
        "a90654dc7cf7977ed85c": "Vítej, $c. Chceš radu? Spřátel se s mágem! Máme v rukávu pár triků...",
        "b754d2d13a5c87e0dc1b": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým dalším provedením obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talentům, které ses naučil?",
        "d90ca2e45d059d7ada93": "Zdravím. Jsem gnómský učitel mágů a ty jsi mág.",
        "f92e5ef78d4099dc8c08": "Pokud chceš, mohu ti kromě výcviku vymazat znalost tvých talentů z mysli. Upozorňuji, že každý další zákrok je obtížnější, a proto dražší."
      },
      "name": "Dink",
      "translationMetadata": {
