    "trTR": {
      "dialogue": {
        "5b425e347ae14c73a026": "Geleceğin belirsiz. Odaklan ve yeniden sor.",
        "697be9bfbdb13a262fbf": "Etrafında pusuda bekleyen bir huzursuzluk hissediyorum...",
        "8df9bdf3be1db87ab3d4": "Zihnin dağınık. Benden bir şey mi saklıyorsun?",
        "a1fcdde95a4d13159b7d": "Öğrenciye benzemiyorsun..."
