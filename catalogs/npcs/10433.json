    "itIT": {
      "dialogue": {
        "5b425e347ae14c73a026": "Il tuo futuro è offuscato. Concentrati e chiedi di nuovo.",
        "697be9bfbdb13a262fbf": "Percepisco un turbamento, in agguato intorno a te...",
        "8df9bdf3be1db87ab3d4": "La tua mente non è concentrata. Mi stai nascondendo qualcosa?",
        "a1fcdde95a4d13159b7d": "Non sembri uno studente..."
      },
      "name": "Marduk Blackpool",
