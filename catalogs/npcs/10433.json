    "deDE": {
      "dialogue": {
        "5b425e347ae14c73a026": "Eure Zukunft ist umschattet. Konzentriert Euch und fragt noch einmal.",
        "697be9bfbdb13a262fbf": "Ich spüre, wie Euch eine Unruhe umwabert...",
        "8df9bdf3be1db87ab3d4": "Euer Geist ist nicht konzentriert. Verbergt Ihr etwas vor mir?",
        "a1fcdde95a4d13159b7d": "Ihr seht nicht wie ein Schüler aus..."
      },
      "name": "Marduk Blackpool",
