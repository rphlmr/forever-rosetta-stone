    "hrHR": {
      "dialogue": {
        "5b425e347ae14c73a026": "Tvoja je budućnost zamagljena. Usredotoči se i pitaj ponovno.",
        "697be9bfbdb13a262fbf": "Osjećam uznemirujuću prisutnost koja vreba oko tebe...",
        "8df9bdf3be1db87ab3d4": "Misli su ti raspršene. Skrivaš li nešto od mene?",
        "a1fcdde95a4d13159b7d": "Ne izgledaš kao učenik..."
      },
      "name": "Marduk Blackpool",
