    "daDK": {
      "dialogue": {
        "5b425e347ae14c73a026": "Din fremtid er sløret. Koncentrer dig, og spørg igen.",
        "697be9bfbdb13a262fbf": "Jeg fornemmer en forstyrrelse, der lurer omkring dig...",
        "8df9bdf3be1db87ab3d4": "Dine tanker er ukoncentrerede. Skjuler du noget for mig?",
        "a1fcdde95a4d13159b7d": "Du ligner ikke en studerende..."
      },
      "name": "Marduk Blackpool",
      "translationMetadata": {
