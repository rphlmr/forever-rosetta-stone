    "ptBR": {
      "dialogue": {
        "5b425e347ae14c73a026": "Seu futuro está nebuloso... Concentre-se e pergunte novamente.",
        "697be9bfbdb13a262fbf": "Sinto um distúrbio... espreitando ao seu redor...",
        "8df9bdf3be1db87ab3d4": "Sua mente está distraída. Você está me escondendo alguma coisa?",
        "a1fcdde95a4d13159b7d": "Você não parece um aluno..."
      },
      "name": "Marduque Lagonero",
