    "enUS": {
      "dialogue": {
        "5b425e347ae14c73a026": "Your future is clouded.  Concentrate, and ask again.",
        "697be9bfbdb13a262fbf": "I sense a disturbance, lurking around you...",
        "8df9bdf3be1db87ab3d4": "Your mind is unfocused.  Are you hiding something from me?",
        "a1fcdde95a4d13159b7d": "You don't look like a student..."
      },
      "name": "Marduk Blackpool",
      "translationMetadata": {
