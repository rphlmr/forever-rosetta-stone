    "esES": {
      "dialogue": {
        "5b425e347ae14c73a026": "Tu futuro está nublado. Concéntrate y pregunta de nuevo.",
        "697be9bfbdb13a262fbf": "Siento que algo te perturba...",
        "8df9bdf3be1db87ab3d4": "Tu mente no está centrada. ¿Me estás ocultando algo?",
        "a1fcdde95a4d13159b7d": "No pareces un estudiante..."
      },
      "name": "Marduz Pozonegro",
