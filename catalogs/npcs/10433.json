    "frFR": {
      "dialogue": {
        "5b425e347ae14c73a026": "Votre futur est obscur. Concentrez-vous et demandez encore...",
        "697be9bfbdb13a262fbf": "Je sens une perturbation qui vous entoure...",
        "8df9bdf3be1db87ab3d4": "Vous ne vous concentrez pas. Seriez-vous en train de me cacher quelque chose ?",
        "a1fcdde95a4d13159b7d": "Vous ne ressemblez pas à un étudiant..."
      },
