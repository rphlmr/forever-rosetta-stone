    "plPL": {
      "dialogue": {
        "5b425e347ae14c73a026": "Twoja przyszłość jest zamglona. Skup się i zapytaj ponownie.",
        "697be9bfbdb13a262fbf": "Wyczuwam niepokojącą obecność, która czai się wokół ciebie...",
        "8df9bdf3be1db87ab3d4": "Twoje myśli są rozproszone. Czy coś przede mną ukrywasz?",
        "a1fcdde95a4d13159b7d": "Nie wyglądasz na ucznia..."
      },
      "name": "Marduk Blackpool",
