    "svSE": {
      "dialogue": {
        "5b425e347ae14c73a026": "Din framtid är höljd i dunkel. Koncentrera dig och fråga igen.",
        "697be9bfbdb13a262fbf": "Jag känner en störning som lurar omkring dig...",
        "8df9bdf3be1db87ab3d4": "Dina tankar är splittrade. Döljer du något för mig?",
        "a1fcdde95a4d13159b7d": "Du ser inte ut som en elev..."
      },
      "name": "Marduk Blackpool",
