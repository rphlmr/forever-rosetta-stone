  "locales": {
    "csCZ": {
      "dialogue": {
        "5b425e347ae14c73a026": "Tvá budoucnost je zahalená. Soustřeď se a zeptej se znovu.",
        "697be9bfbdb13a262fbf": "Cítím, že kolem tebe číhá cosi znepokojivého...",
        "8df9bdf3be1db87ab3d4": "Nesoustředíš se. Něco přede mnou skrýváš?",
        "a1fcdde95a4d13159b7d": "Nevypadáš jako student..."
      },
      "name": "Marduk Blackpool",
      "translationMetadata": {
