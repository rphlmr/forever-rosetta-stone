      "dialogue": {
        "2badca0a49bba69760cc": "Ældste Bladeswift vandrer ad Darnassus’ stier på toppen af Teldrassil.",
        "43c6f5006cbcbb1801b1": "Ældste Skygleam findes nær Ravencrest-monumentet i Azshara.",
