    "hrHR": {
      "dialogue": {
        "3f482876cf833e2eb1bc": "Iz razloga koje ne razumijem, starješina Thunderhorn otišao je u Slithering Scar u krateru Un’Goro.",
        "a1dbf3a0545e79c67fe9": "U Cenarion Holdu u Silithusu pronaći ćeš starješinu Bladesinga.",
        "b3f5565396e63e101e2f": "Sada je vrijeme kad je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kada se drevni bude."
      },
      "name": "Starješina Primestone",
