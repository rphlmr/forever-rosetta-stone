    "daDK": {
      "dialogue": {
        "3f482876cf833e2eb1bc": "Af grunde, jeg ikke forstår, er Elder Thunderhorn draget til Slithering Scar i Un’Goro Crater.",
        "a1dbf3a0545e79c67fe9": "Rejser du til Cenarion Hold i Silithus, finder du Elder Bladesing.",
        "b3f5565396e63e101e2f": "Nu er tiden, hvor året er nyt, og månen lyser klart.$B$BDet er vores tid... hvor de ældgamle vågner."
      },
      "name": "Ældste Primestone",
      "translationMetadata": {
        "fields": {
          "dialogue.3f482876cf833e2eb1bc": {
