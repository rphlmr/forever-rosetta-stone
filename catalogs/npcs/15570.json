  "locales": {
    "csCZ": {
      "dialogue": {
        "3f482876cf833e2eb1bc": "Z důvodů, kterým nerozumím, odešel starší Thunderhorn do Slithering Scar v kráteru Un’Goro.",
        "a1dbf3a0545e79c67fe9": "V Cenarion Hold v Silithu najdeš staršího Bladesinga.",
        "b3f5565396e63e101e2f": "Nastal čas, kdy je rok nový a měsíc jasně září.$B$BJe to náš čas... kdy se probouzejí prastaří."
      },
      "name": "Starší Primestone",
      "translationMetadata": {
