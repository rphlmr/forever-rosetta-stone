    "plPL": {
      "dialogue": {
        "45e83dc9d0251f62464f": "Poprzez rygorystyczne szkolenie musiałem oduczyć wielu uczniów wszystkiego, czego się wcześniej nauczyli, aby móc szkolić ich na nowo. Usługa, którą oferuję, staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne szkolenie jest droższe. Czy chcesz, abym oduczył cię poznanych talentów?",
        "52c3a824f85e97b2bfa2": "Przychodzę na szkolenie.",
        "66e92b71c6efe2feaff8": "Jeśli chcesz poznać taktykę i strategię polowania, jesteś we właściwym miejscu!",
        "97cd1adc3791a935454c": "Nie mogę ci pomóc w szkoleniu. Poszukaj nauczyciela dla klasy $c."
      },
      "name": "Olmin Burningbeard",
      "translationMetadata": {
        "fields": {
