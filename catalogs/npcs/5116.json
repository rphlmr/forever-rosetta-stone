  "locales": {
    "csCZ": {
      "dialogue": {
        "45e83dc9d0251f62464f": "Při náročném přeškolování jsem musel mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "52c3a824f85e97b2bfa2": "Jsem tu kvůli výcviku.",
        "66e92b71c6efe2feaff8": "Jsi-li tu, aby ses naučil taktiku a strategii lovu, jsi na správném místě!",
        "97cd1adc3791a935454c": "S výcvikem ti nepomůžu. Najdi si trenéra pro $c."
      },
      "name": "Olmin Burningbeard",
      "translationMetadata": {
        "fields": {
          "dialogue.45e83dc9d0251f62464f": {
            "origin": "ai",
