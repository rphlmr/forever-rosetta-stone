  "locales": {
    "csCZ": {
      "dialogue": {
        "b0918e8cda72cee7310f": "Viděl jsi znečištěné vodní elementály v našem jezeře, $n? Je to smutný pohled, ale nevím, odkud přicházejí.$B$BTvé jméno už zaznělo v dřívějších rozhovorech. Možná bys mi s tím mohl pomoci.$B$BNejprve musíme zjistit, kdo ty elementály ovládá."
      },
      "name": "Strážkyně Velene Starstrike",
      "translationMetadata": {
        "fields": {
          "dialogue.b0918e8cda72cee7310f": {
