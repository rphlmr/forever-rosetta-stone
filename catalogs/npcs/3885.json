    "enUS": {
      "dialogue": {
        "b0918e8cda72cee7310f": "Have you seen the befouled water elementals in our lake, $n? It is a sorry sight, but I do not know where they are coming from.$B$BYour name has been mentioned in conversations past, perhaps you could help me with this problem.$B$BThe first thing we must learn is who is in control of these elementals."
      },
      "name": "Sentinel Velene Starstrike",
      "translationMetadata": {
        "fields": {
