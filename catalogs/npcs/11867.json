    "enUS": {
      "dialogue": {
        "748373ecfd4285756898": "I'd like some weapon training",
        "b1cdd3675196ab6a1bf5": "Have you come seeking training in the ways of armed combat?",
        "d4658cfdeedac33447ad": "Buliwyf, the dwarven weapon master at the Timberline Arms in Ironforge, teaches fist weapons, guns, one and two-handed axes and one and two-handed maces.\n\nBixi Wobblebonk, the gnome weapon master at the Timberline Arms in Ironforge, teaches crossbow, daggers and throwing weapons.\n\nIlyenia Moonfire, the night elf weapon master, resides at the Warrior's Terrace in Darnassus where she teaches bow, daggers, fist weapons, staff and throwing weapons.",
        "zephras:200912b8d87d91f76795": "What can other weapon masters teach?"
      },
      "name": "Woo Ping",
      "subName": "Weapon Master",
