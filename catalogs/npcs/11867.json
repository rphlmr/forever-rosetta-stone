    "daDK": {
      "dialogue": {
        "748373ecfd4285756898": "Jeg vil gerne trænes i våben.",
        "b1cdd3675196ab6a1bf5": "Er du kommet for at lære væbnet kamp?",
        "d4658cfdeedac33447ad": "Buliwyf, dværgenes våbenmester hos Timberline Arms i Ironforge, underviser i knytnævevåben, geværer samt en- og tohåndsøkser og køller.\n\nBixi Wobblebonk, gnomenes våbenmester samme sted, underviser i armbrøster, dolke og kastevåben.\n\nIlyenia Moonfire, natelvernes våbenmester på Krigerterrassen i Darnassus, underviser i buer, dolke, knytnævevåben, stave og kastevåben.",
        "zephras:200912b8d87d91f76795": "Hvad kan andre våbenmestre lære mig?"
      },
      "name": "Woo Ping",
      "translationMetadata": {
