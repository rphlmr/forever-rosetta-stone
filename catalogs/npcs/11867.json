    "hrHR": {
      "dialogue": {
        "748373ecfd4285756898": "Želim obuku za oružje.",
        "b1cdd3675196ab6a1bf5": "Jesi li došao učiti borbu oružjem?",
        "d4658cfdeedac33447ad": "Buliwyf, patuljasti majstor oružja u Timberline Armsu u Ironforgeu, podučava šačna oružja, puške, jednoručne i dvoručne sjekire i buzdovane.\n\nBixi Wobblebonk, gnomska majstorica oružja na istom mjestu, podučava samostrele, bodeže i bacačko oružje.\n\nIlyenia Moonfire, noćna vilenjakinja na Terasi ratnika u Darnassusu, podučava lukove, bodeže, šačna oružja, štapove i bacačko oružje.",
        "zephras:200912b8d87d91f76795": "Što me drugi majstori oružja mogu naučiti?"
      },
      "name": "Woo Ping",
      "translationMetadata": {
