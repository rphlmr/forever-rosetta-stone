    "deDE": {
      "dialogue": {
        "07ef3c64efa75b200259": "Seht Ihr nicht, dass ich beschäftigt bin? Hoffentlich ist das wichtig...",
        "47ce787cd4f2d4c80967": "Bildet mich aus.",
        "5cc237f9cb37548de68d": "Seid Ihr komplett meschugge? Das ist keine Waffe, das ist ein Frühstücksmesser. Ich gebe mich nicht mit Anfängern ab."
      },
      "name": "Borgus Steelhand",
      "subName": "Waffenmacher",
