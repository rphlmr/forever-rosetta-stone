      "dialogue": {
        "07ef3c64efa75b200259": "Can't ye see I'm busy? This had better be good.",
        "47ce787cd4f2d4c80967": "Train me.",
        "5cc237f9cb37548de68d": "What are ye daft? That's not a weapon, that's a dinner knife. I don't train amateurs."
