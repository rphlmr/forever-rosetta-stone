    "csCZ": {
      "dialogue": {
        "07ef3c64efa75b200259": "Nevidíš, že mám práci? Ať to stojí za to.",
        "47ce787cd4f2d4c80967": "Vycvičte mě.",
        "5cc237f9cb37548de68d": "Ty ses zbláznil? To není zbraň, ale příborový nůž. Amatéry necvičím."
      },
      "name": "Borgus Steelhand",
      "translationMetadata": {
