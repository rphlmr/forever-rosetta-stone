    "daDK": {
      "dialogue": {
        "07ef3c64efa75b200259": "Kan du ikke se, jeg har travlt? Det må hellere være vigtigt.",
        "47ce787cd4f2d4c80967": "Træn mig.",
        "5cc237f9cb37548de68d": "Er du fra forstanden? Det er ikke et våben, men en bordkniv. Jeg træner ikke amatører."
      },
      "name": "Borgus Steelhand",
      "translationMetadata": {
