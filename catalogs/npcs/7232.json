    "svSE": {
      "dialogue": {
        "07ef3c64efa75b200259": "Ser du inte att jag är upptagen? Det här gör bäst i att vara viktigt.",
        "47ce787cd4f2d4c80967": "Träna mig.",
        "5cc237f9cb37548de68d": "Är du från vettet? Det där är inget vapen, det är en matkniv. Jag tränar inte amatörer."
      },
      "name": "Borgus Steelhand",
