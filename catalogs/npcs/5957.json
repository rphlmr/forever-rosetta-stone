    "hrHR": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Ne vjerujem da posjeduješ dovoljno oštar um da shvatiš prirodu magije portala.",
        "0d1439081d9837f7892e": "Molim te, poduči me.",
        "25bf1e43039891482efd": "Kao mag pripadaš odabranoj skupini koja može stvoriti portal natrag na ovo mjesto. Mogu te podučiti ako si spreman."
      },
      "name": "Birgitte Cranston",
