    },
    "deDE": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Ich glaube nicht, dass Ihr die geistige Schärfe besitzt, um die Natur der Portalmagie zu verstehen.",
        "0d1439081d9837f7892e": "Bitte unterrichtet mich.",
        "25bf1e43039891482efd": "Als Magier gehört Ihr zu einer auserwählten Gruppe, die ein Portal herbeizaubern kann, das Euch zurück zu diesem Ort transportiert. Ich kann Euch unterrichten, wenn Ihr bereit seid."
      },
      "name": "Birgitte Cranston",
      "subName": "Portallehrerin",
      "translationMetadata": {
