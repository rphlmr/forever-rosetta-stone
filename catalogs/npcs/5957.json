    "trTR": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Geçit büyüsünün doğasını kavrayacak zihinsel keskinliğe sahip olduğuna inanmıyorum.",
        "0d1439081d9837f7892e": "Lütfen bana öğret.",
        "25bf1e43039891482efd": "Bir büyücü olarak seni tam da buraya geri getirecek bir geçit açabilen seçkin bir gruptansın. Hazırsan sana öğretebilirim."
      },
      "name": "Birgitte Cranston",
