    "enUS": {
      "dialogue": {
        "04e9fd3c493c835bb710": "I do not believe you possess the mental acuity to grasp the nature of portal magic.",
        "0d1439081d9837f7892e": "Please teach me.",
        "25bf1e43039891482efd": "As a mage, you are one of a select group that can conjure a portal to transport you back to this very place.  I can teach you if you are ready."
      },
      "name": "Birgitte Cranston",
      "subName": "Portal Trainer",
      "translationMetadata": {
