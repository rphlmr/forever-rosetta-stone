    "frFR": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Je ne pense pas que vous possédiez la finesse mentale requise pour comprendre la nature de la magie des portails.",
        "0d1439081d9837f7892e": "Veuillez m'apprendre.",
        "25bf1e43039891482efd": "En tant que mage, vous faites partie d'une élite qui peut invoquer un portail capable de vous ramener ici même. Je peux vous apprendre comment si vous avez les compétences requises."
      },
      "name": "Birgitte Cranston",
      "subName": "Maître des portails",
