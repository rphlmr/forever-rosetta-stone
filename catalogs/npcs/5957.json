    "ptBR": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Creio que você não possua a acuidade mental para compreender os mistérios da magia dos portais.",
        "0d1439081d9837f7892e": "Por favor, ensine-me.",
        "25bf1e43039891482efd": "Como um mago, você pertence ao seleto grupo que consegue conjurar um portal que lhe transportará de volta a este mesmo local. Posso lhe ensinar como, se você estiver pronto."
      },
      "name": "Brígida Cranston",
