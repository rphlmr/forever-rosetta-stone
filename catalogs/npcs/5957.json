  "locales": {
    "csCZ": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Nevěřím, že máš dost bystrou mysl na to, abys pochopil podstatu portálové magie.",
        "0d1439081d9837f7892e": "Prosím, učte mě.",
        "25bf1e43039891482efd": "Jako mág patříš k vybrané skupině, která dokáže vyčarovat portál zpět právě na toto místo. Jsi-li připraven, mohu tě to naučit."
      },
      "name": "Birgitte Cranston",
      "translationMetadata": {
        "fields": {
          "dialogue.04e9fd3c493c835bb710": {
