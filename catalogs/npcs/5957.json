      }
    },
    "daDK": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Jeg tror ikke, du har den mentale skarphed til at forstå portalmagiens natur.",
        "0d1439081d9837f7892e": "Lær mig det, tak.",
        "25bf1e43039891482efd": "Som magiker tilhører du en udvalgt gruppe, der kan fremmane en portal tilbage til netop dette sted. Jeg kan lære dig det, hvis du er klar."
      },
      "name": "Birgitte Cranston",
      "translationMetadata": {
        "fields": {
          "dialogue.04e9fd3c493c835bb710": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
