    "plPL": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Nie sądzę, by twój umysł był dość bystry, by pojąć naturę magii portali.",
        "0d1439081d9837f7892e": "Proszę, naucz mnie.",
        "25bf1e43039891482efd": "Jako mag należysz do wybranej grupy, która potrafi wyczarować portal z powrotem do tego miejsca. Mogę cię nauczyć, jeśli jesteś gotów."
      },
      "name": "Birgitte Cranston",
      "translationMetadata": {
