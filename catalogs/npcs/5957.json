    "svSE": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Jag tror inte att du har den skärpa som krävs för att förstå portalmagins natur.",
        "0d1439081d9837f7892e": "Lär mig, tack.",
        "25bf1e43039891482efd": "Som magiker tillhör du en utvald grupp som kan frammana en portal tillbaka till just denna plats. Jag kan lära dig om du är redo."
      },
      "name": "Birgitte Cranston",
