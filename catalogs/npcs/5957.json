    "itIT": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Non credo che tu abbia l'acume necessario per comprendere la natura della magia dei portali.",
        "0d1439081d9837f7892e": "Ti prego, insegnami.",
        "25bf1e43039891482efd": "Come mago, appartieni a un gruppo scelto capace di evocare un portale che ti riporti proprio qui. Posso insegnarti, se sei pronto."
      },
      "name": "Birgitte Cranston",
