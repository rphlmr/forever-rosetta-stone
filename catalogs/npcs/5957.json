    "ltLT": {
      "dialogue": {
        "04e9fd3c493c835bb710": "Nemanau, kad tavo protas pakankamai aštrus suvokti portalų magijos prigimtį.",
        "0d1439081d9837f7892e": "Prašau mane išmokyti.",
        "25bf1e43039891482efd": "Būdamas magu, priklausai nedidelei grupei žmonių, galinčių sukurti portalą, kuris tave grąžintų į šią vietą. Galiu tave išmokyti, jei esi pasiruošęs."
      },
      "name": "Birgitte Cranston",
      "subName": "Portalų mokytoja",
