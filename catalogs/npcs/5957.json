    "esES": {
      "dialogue": {
        "04e9fd3c493c835bb710": "No puedo creerme que poseas la agudeza mental necesaria para comprender la naturaleza de la magia del portal.",
        "0d1439081d9837f7892e": "Por favor, enséñame.",
        "25bf1e43039891482efd": "Como mago, perteneces a un grupo selecto que puede conjurar un portal para transportarte de nuevo a este lugar. Puedo enseñarte si eres capaz de aprender."
      },
      "name": "Birgitte Cranston",
      "subName": "Instructora de portal",
