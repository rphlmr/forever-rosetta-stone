    "itIT": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Posso insegnarti le tecniche di Primo Soccorso.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein di Brackenwall Village, nel Dustwallow Marsh, vende un manuale che dovrai studiare per migliorare le tue abilità!",
        "6508139c52fb6b4dc2e7": "Ormai solo il celebre Dottor Gregory Victor può migliorare la tua abilità. Lo trovi negli Arathi Highlands, a Hammerfall.",
        "939b092c73da806e0634": "Addestrami."
      },
      "name": "Infermiera Neela",
