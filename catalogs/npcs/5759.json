    "daDK": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Jeg kan lære dig førstehjælp.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein i Brackenwall Village i Dustwallow Marsh sælger en håndbog, som du skal studere for at forbedre dine færdigheder!",
        "6508139c52fb6b4dc2e7": "Kun den berømte doktor Gregory Victor kan nu forbedre dine færdigheder. Han findes i Hammerfall i Arathi Highlands.",
        "939b092c73da806e0634": "Træn mig."
      },
      "name": "Sygeplejerske Neela",
