    "deDE": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein aus Brackenwall in den Marschen von Dustwallow verkauft ein Buch, das Ihr studieren solltet, um Eure Fähigkeiten zu verbessern!",
        "6508139c52fb6b4dc2e7": "Einzig der berühmte Doktor Gregory Victor kann Euch jetzt noch helfen, Eure Fertigkeiten zu verbessern. Ihr findet ihn im Arathihochland, in Hammerfall.",
        "939b092c73da806e0634": "Bildet mich aus."
      },
      "name": "Schwester Neela",
      "subName": "Lehrerin für Erste Hilfe",
