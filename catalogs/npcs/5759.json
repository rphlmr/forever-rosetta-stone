  "locales": {
    "csCZ": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Mohu tě naučit základy první pomoci.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein z vesnice Brackenwall v Dustwallow Marsh prodává příručku, kterou si musíš prostudovat, abys své dovednosti zdokonalil!",
        "6508139c52fb6b4dc2e7": "Nyní může tvé dovednosti zlepšit pouze proslulý doktor Gregory Victor. Najdeš ho v Hammerfallu v Arathi Highlands.",
        "939b092c73da806e0634": "Vycvičte mě."
      },
      "name": "Ošetřovatelka Neela",
      "translationMetadata": {
