    "plPL": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Mogę nauczyć cię pierwszej pomocy.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein z wioski Brackenwall na bagnach Dustwallow sprzedaje podręcznik, który musisz przestudiować, aby rozwinąć swoje umiejętności!",
        "6508139c52fb6b4dc2e7": "Tylko słynny doktor Gregory Victor może teraz rozwinąć twoje umiejętności. Znajdziesz go w Hammerfall na wyżynie Arathi.",
        "939b092c73da806e0634": "Wyszkol mnie."
      },
