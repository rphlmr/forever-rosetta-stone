    "hrHR": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Mogu te podučiti prvoj pomoći.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein iz sela Brackenwall u močvari Dustwallow prodaje priručnik koji moraš proučiti kako bi poboljšao svoje vještine!",
        "6508139c52fb6b4dc2e7": "Sada samo poznati doktor Gregory Victor može poboljšati tvoje vještine. Možeš ga pronaći u Hammerfallu u Arathi Highlandsu.",
        "939b092c73da806e0634": "Podučite me."
      },
      "name": "Bolničarka Neela",
