    "enUS": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "I can train you in First Aid techniques.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein of Brackenwall Village in Dustwallow Marsh sells a manual that you will need to study in order to improve your skills!",
        "6508139c52fb6b4dc2e7": "Only the renowned Doctor Gregory Victor can improve your skill now.  He can be found in Arathi Highlands at Hammerfall.",
        "939b092c73da806e0634": "Train me."
      },
      "name": "Nurse Neela",
      "subName": "First Aid Trainer",
