    "ptBR": {
      "dialogue": {
        "42618b78ef1ddbbbf7b4": "Eu posso lhe ensinar as técnicas de Primeiros Socorros.",
        "52f287dc50c8fd1f0c48": "Balai Lok'Wein, da Aldeia Muralha Verde, que fica no Pântano Vadeoso, vende um manual que vai ajudá-lo a aperfeiçoar suas habilidades.",
        "6508139c52fb6b4dc2e7": "Somente o renomado Doutor Victor Zerbini será capaz de aperfeiçoar as suas habilidades agora. Ele fica no Planalto Arathi, na Ruína do Martelo.",
        "939b092c73da806e0634": "Treine-me."
      },
      "name": "Enfermeira Nila",
      "subName": "Treinamento de Primeiros Socorros",
