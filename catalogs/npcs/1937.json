    "hrHR": {
      "dialogue": {
        "30bfd77586518adb8dc8": "Mračna Gospa postavila je izazov. Sada je na Kraljevskom apotekarskom društvu da razvije novu kugu. Bacit ćemo Arthasa i njegovu bijednu vojsku na koljena.",
        "69c02a936c3c638f16c8": "Podučite me.",
        "e70facc4e47a2661cc4c": "Želim pogledati vašu robu."
