    "plPL": {
      "dialogue": {
        "30bfd77586518adb8dc8": "Mroczna Pani rzuciła nam wyzwanie. Teraz Królewskie Towarzystwo Aptekarskie musi opracować nową plagę. Rzucimy Arthasa i jego nędzną armię na kolana.",
        "69c02a936c3c638f16c8": "Wyszkol mnie.",
