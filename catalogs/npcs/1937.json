      }
    },
    "daDK": {
      "dialogue": {
        "30bfd77586518adb8dc8": "Den Mørke Frue har stillet os en opgave. Nu er det op til Det Kongelige Apotekerselskab at udvikle en ny pest. Vi vil tvinge Arthas og hans usle hær i knæ.",
        "69c02a936c3c638f16c8": "Træn mig.",
        "e70facc4e47a2661cc4c": "Jeg vil gerne se dine varer."
      },
      "name": "Apoteker Renferrel",
      "translationMetadata": {
        "fields": {
