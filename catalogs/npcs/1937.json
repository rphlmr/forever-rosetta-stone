    "ltLT": {
      "dialogue": {
        "30bfd77586518adb8dc8": "Tamsioji Valdovė iškėlė mums užduotį. Dabar Karališkoji vaistininkų draugija turi sukurti naują marą. Mes parklupdysime Arthasą ir jo apgailėtiną armiją.",
        "69c02a936c3c638f16c8": "Išmokyk mane.",
        "e70facc4e47a2661cc4c": "Noriu apžiūrėti tavo prekes."
