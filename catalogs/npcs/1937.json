  "locales": {
    "csCZ": {
      "dialogue": {
        "30bfd77586518adb8dc8": "Temná paní nám uložila úkol. Nyní je na Královské lékárnické společnosti, aby vyvinula nový mor. Srazíme Arthase a jeho odpornou armádu na kolena.",
        "69c02a936c3c638f16c8": "Vycvičte mě.",
        "e70facc4e47a2661cc4c": "Chci si prohlédnout vaše zboží."
      },
      "name": "Lékárník Renferrel",
      "translationMetadata": {
        "fields": {
          "dialogue.30bfd77586518adb8dc8": {
