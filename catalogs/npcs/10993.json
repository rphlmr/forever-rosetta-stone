    "daDK": {
      "dialogue": {
        "59ee59e31808db80869d": "Ja, jeg viser dig et par ting. Vi får se, hvordan det går, måske overrasker du mig!",
        "68d6626a8a9dce595e0a": "Træn mig.",
        "6e1cda55284fdddeae1d": "Jeg kan ikke hjælpe dig! Du er klar til en, der har gjort det længere end mig! Lad mig se... du er fra Alliancen, så du skal tale med Lilliam Sparkspindle i Stormwind.",
        "6e34361d3755933ed2f1": "(Snøft, snøft) Kan du lugte det? ELSKER du ikke bare lugten af smørefedt?",
        "c87a076b2c7c9259a4e7": "Jeg er bange for, at du er for dygtig til mig, ven! Du bør opsøge Nogg i Orgrimmar, han kan føre dig videre!"
      },
      "name": "Twizwick Sprocketgrind",
      "translationMetadata": {
        "fields": {
