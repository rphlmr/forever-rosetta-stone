    "enUS": {
      "dialogue": {
        "59ee59e31808db80869d": "Yeah, I'll show you a few things. We'll see how you do, maybe you'll surprise me!",
        "68d6626a8a9dce595e0a": "Train me.",
        "6e1cda55284fdddeae1d": "I can't help ya'! You're ready to see someone who's been at it longer than I have! Let's see... you're an Alliance type, so you need to talk to Lilliam Sparkspindle in Stormwind.",
        "6e34361d3755933ed2f1": "(Sniff, sniff) You smell that? Don't you just LOVE the smell of grease?",
        "c87a076b2c7c9259a4e7": "I'm afraid you're out of my league, friend! You should go see Nogg in Orgrimmar, he'll take you to the next level!"
      },
      "name": "Twizwick Sprocketgrind",
      "subName": "Journeyman Engineer",
