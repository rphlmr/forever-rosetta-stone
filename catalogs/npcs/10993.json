  "locales": {
    "csCZ": {
      "dialogue": {
        "59ee59e31808db80869d": "Jasně, pár věcí ti ukážu. Uvidíme, jak ti to půjde, třeba mě překvapíš!",
        "68d6626a8a9dce595e0a": "Vycvičte mě.",
        "6e1cda55284fdddeae1d": "Nemohu ti pomoci! Je čas vyhledat někoho, kdo to dělá déle než já! Podívejme... patříš k Alianci, takže musíš promluvit s Lilliam Sparkspindle ve Stormwindu.",
        "6e34361d3755933ed2f1": "(Čich, čich) Cítíš to? NEMILUJEŠ prostě vůni maziva?",
        "c87a076b2c7c9259a4e7": "Obávám se, že jsi nad mé síly, příteli! Měl bys zajít za Noggem do Orgrimmaru, ten tě posune na další úroveň!"
      },
      "name": "Twizwick Sprocketgrind",
      "translationMetadata": {
        "fields": {
