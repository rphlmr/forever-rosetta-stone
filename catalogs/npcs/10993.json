    "ltLT": {
      "dialogue": {
        "59ee59e31808db80869d": "Taip, parodysiu tau keletą dalykų. Pažiūrėsim, kaip tau seksis, gal net mane nustebinsi!",
        "68d6626a8a9dce595e0a": "Išmokyk mane.",
        "6e1cda55284fdddeae1d": "Negaliu tau padėti! Tau jau laikas kreiptis į žmogų, kuris tuo užsiima ilgiau nei aš! Pažiūrėkim... priklausai Aljansui, tad tau reikia pasikalbėti su Lilliam Sparkspindle Stormwind mieste.",
        "6e34361d3755933ed2f1": "(Uosto) Jauti tą kvapą? Argi tau nepatinka tepalo kvapas?",
        "c87a076b2c7c9259a4e7": "Bijau, kad mane jau pranokai, bičiuli! Nueik pas Nogg Orgrimmar mieste, jis padės tau pakilti į kitą lygį!"
      },
      "name": "Twizwick Sprocketgrind",
      "subName": "Patyręs inžinierius",
      "translationMetadata": {
