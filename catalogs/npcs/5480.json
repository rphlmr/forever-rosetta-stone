    "plPL": {
      "dialogue": {
        "264353d0252c7f040d7c": "Po samej postawie widzę, że nie jesteś wojownikiem.$B$BMoże zajmij się czymś bezpiecznym, na przykład czytaniem?",
        "7ea9a305360d3ba59885": "Stormwind jest filarem ludzkiej rasy, utrzymywanym siłą woli i ostrzem mocnego miecza.",
        "b453a60f1a92bb729259": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by uczyć ich na nowo. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz zapomnieć wyuczone talenty?",
        "deb1feb5808b79855e8c": "Potrzebuję szkolenia wojownika."
      },
      "name": "Ilsa Corbin",
      "translationMetadata": {
        "fields": {
          "dialogue.264353d0252c7f040d7c": {
