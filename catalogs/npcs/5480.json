  "locales": {
    "csCZ": {
      "dialogue": {
        "264353d0252c7f040d7c": "Už podle postoje poznám, že nejsi válečník.$B$BProč si raději nepřečteš knihu?",
        "7ea9a305360d3ba59885": "Stormwind je pilířem lidské rasy, který drží síla vůle a ostří pevné čepele.",
        "b453a60f1a92bb729259": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl vyučit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto i dražší. Přeješ si zapomenout naučené talenty?",
        "deb1feb5808b79855e8c": "Potřebuji výcvik válečníka."
      },
      "name": "Ilsa Corbin",
      "translationMetadata": {
        "fields": {
          "dialogue.264353d0252c7f040d7c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
