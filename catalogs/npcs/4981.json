    "enUS": {
      "dialogue": {
        "478105a9faafde73eed2": "Just browsing my wares or is there something specific I can help you find today?",
        "5b73c5fd8ecf5831dee5": "Best deals in all of Stormwind my friend, won't find any better. Now, what can I help you with?",
        "5bdf16b4de831e589b40": "I want to browse your goods."
      },
      "name": "Ben Trias",
      "subName": "Apprentice of Cheese",
