    "hrHR": {
      "dialogue": {
        "478105a9faafde73eed2": "Samo razgledavaš moju robu ili ti danas mogu pomoći pronaći nešto određeno?",
        "5b73c5fd8ecf5831dee5": "Najbolje ponude u cijelom Stormwindu, prijatelju, nećeš naći bolje. Kako ti mogu pomoći?",
        "5bdf16b4de831e589b40": "Želim pogledati vašu robu."
      },
      "name": "Ben Trias",
