  "locales": {
    "csCZ": {
      "dialogue": {
        "478105a9faafde73eed2": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "5b73c5fd8ecf5831dee5": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?",
        "5bdf16b4de831e589b40": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Ben Trias",
      "translationMetadata": {
