    "daDK": {
      "dialogue": {
        "478105a9faafde73eed2": "Kigger du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?",
        "5b73c5fd8ecf5831dee5": "De bedste tilbud i hele Stormwind, min ven. Du finder ingen bedre. Hvad kan jeg hjælpe dig med?",
        "5bdf16b4de831e589b40": "Jeg vil gerne se dine varer."
      },
      "name": "Ben Trias",
      "translationMetadata": {
