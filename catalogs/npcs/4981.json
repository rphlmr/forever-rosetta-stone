    "svSE": {
      "dialogue": {
        "478105a9faafde73eed2": "Tittar du bara på mina varor, eller kan jag hjälpa dig att hitta något särskilt i dag?",
        "5b73c5fd8ecf5831dee5": "De bästa erbjudandena i hela Stormwind, min vän. Du hittar inga bättre. Vad kan jag hjälpa dig med?",
        "5bdf16b4de831e589b40": "Jag vill se dina varor."
