    "plPL": {
      "dialogue": {
        "478105a9faafde73eed2": "Tylko oglądasz moje towary, czy mogę pomóc ci dziś znaleźć coś konkretnego?",
        "5b73c5fd8ecf5831dee5": "Najlepsze okazje w całym Stormwind, przyjacielu, lepszych nie znajdziesz. W czym mogę pomóc?",
