    "deDE": {
      "dialogue": {
        "478105a9faafde73eed2": "Seht Ihr Euch nur um oder kann ich Euch irgendwie helfen?",
        "5b73c5fd8ecf5831dee5": "Die besten Preise in ganz Stormwind, was Besseres werdet Ihr nicht finden. Womit kann ich Euch denn nun dienen?",
        "5bdf16b4de831e589b40": "Ich möchte Eure Waren ansehen."
      },
      "name": "Ben Trias",
      "subName": "Käsereilehrling",
