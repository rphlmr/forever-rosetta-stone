    "trTR": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Yalnızca sınırlı bir süre için, çıtır kurbağa sadece burada, Darkmoon Panayırı'nda.",
        "74a653ccee9baf4cc802": "Sizde para, bizde yemek var. Ne bekliyorsunuz?!",
        "8a0b9d6ae647e7f7479a": "Mmm... yemek.",
        "e857d70d54925e5c3162": "Yaklaşın! Sıcacık kanatlar tam burada!",
        "fb3309545ab5a53b7280": "Darkmoon sosisleri ızgaradan yeni çıktı. Sıcakken gelin alın!"
      },
      "name": "Stamp Thunderhorn",
