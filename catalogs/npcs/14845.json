  "locales": {
    "csCZ": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Jen po omezenou dobu, křupavá žába výhradně tady na Temném jarmarku.",
        "74a653ccee9baf4cc802": "Vy máte peníze a my máme jídlo. Na co čekáte?!",
        "8a0b9d6ae647e7f7479a": "Mmm... jídlo.",
        "e857d70d54925e5c3162": "Jen pojďte dál! Žhavá křidélka přímo tady!",
        "fb3309545ab5a53b7280": "Temnojarmareční párky přímo z grilu. Pojďte si pro ně, dokud jsou horké!"
      },
      "name": "Stamp Thunderhorn",
      "translationMetadata": {
