    "itIT": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Solo per un periodo limitato, rana croccante in esclusiva qui alla Fiera di Darkmoon.",
        "74a653ccee9baf4cc802": "Tu hai i soldi e noi abbiamo il cibo. Che aspetti?!",
        "8a0b9d6ae647e7f7479a": "Mmm... cibo.",
        "e857d70d54925e5c3162": "Avvicinati, avvicinati! Ali piccanti e bollenti, le trovi proprio qui!",
        "fb3309545ab5a53b7280": "Hot Dog Darkmoon appena tolti dalla griglia. Vieni a prenderli finché sono caldi!"
      },
      "name": "Stamp Thunderhorn",
