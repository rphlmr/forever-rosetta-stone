    "enUS": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "For a limited time only, crunchy frog available exclusively here at the Darkmoon Faire.",
        "74a653ccee9baf4cc802": "You've got money and we've got food.  What are you waiting for?!",
        "8a0b9d6ae647e7f7479a": "Mmm... food.",
        "e857d70d54925e5c3162": "Step right up!  Get your red hot wings right here!",
        "fb3309545ab5a53b7280": "Darkmoon Dogs fresh off the grill.  Come and get em while they're hot!"
      },
      "name": "Stamp Thunderhorn",
      "subName": "Darkmoon Faire Food Vendor",
