    "daDK": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Kun i en begrænset periode: sprød frø, udelukkende her på Darkmoon-markedet.",
        "74a653ccee9baf4cc802": "I har penge, og vi har mad. Hvad venter I på?!",
        "8a0b9d6ae647e7f7479a": "Mmm... mad.",
        "e857d70d54925e5c3162": "Kom nærmere! Få rygende varme vinger lige her!",
        "fb3309545ab5a53b7280": "Darkmoon-pølser direkte fra grillen. Kom og få dem, mens de er varme!"
      },
      "name": "Stamp Thunderhorn",
      "translationMetadata": {
        "fields": {
