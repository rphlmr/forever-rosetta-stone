    "ptBR": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Por tempo limitado! Rã crocante só aqui na Feira de Negraluna!",
        "74a653ccee9baf4cc802": "Moça bonita não paga, mas também não leva!",
        "8a0b9d6ae647e7f7479a": "Mmm... comida.",
        "e857d70d54925e5c3162": "Pode vir, camarada! Olha a asinha apimentada!",
        "fb3309545ab5a53b7280": "Salsichões de Negraluna saindo! Venham logo que tá quentinho!"
      },
      "name": "Pisão Chifre Troante",
      "subName": "Comidas de Negraluna",
