    "svSE": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Bara under en begränsad tid: knaprig groda, endast här på Darkmoon-marknaden.",
        "74a653ccee9baf4cc802": "Ni har pengar och vi har mat. Vad väntar ni på?!",
        "8a0b9d6ae647e7f7479a": "Mmm... mat.",
        "e857d70d54925e5c3162": "Kom närmare! Rykande heta vingar finns här!",
        "fb3309545ab5a53b7280": "Darkmoon-korvar direkt från grillen. Kom och hämta dem medan de är varma!"
      },
      "name": "Stamp Thunderhorn",
