    "plPL": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Tylko przez ograniczony czas, chrupiąca żaba wyłącznie tutaj, na Jarmarku Mrocznego Księżyca.",
        "74a653ccee9baf4cc802": "Wy macie pieniądze, a my jedzenie. Na co czekacie?!",
        "8a0b9d6ae647e7f7479a": "Mmm... jedzenie.",
        "e857d70d54925e5c3162": "Proszę bliżej! Gorące skrzydełka właśnie tutaj!",
        "fb3309545ab5a53b7280": "Kiełbaski Mrocznego Księżyca prosto z grilla. Chodźcie po nie, póki gorące!"
      },
      "name": "Stamp Thunderhorn",
