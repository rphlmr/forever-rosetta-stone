    "esES": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "¡Edición limitada! Rana crujiente solo aquí, en la Feria de la Luna Negra.",
        "74a653ccee9baf4cc802": "Tú tienes dinero y nosotros tenemos comida. ¿¿A qué esperas??",
        "8a0b9d6ae647e7f7479a": "Mmm... comida.",
        "e857d70d54925e5c3162": "¡Venid! ¡Alitas súper picantes aquí mismo!",
        "fb3309545ab5a53b7280": "Perros de la Luna Negra frescos, ¡recién sacados de la barbacoa! Venid a probarlos mientras están calientes."
      },
      "name": "Stamp Tronacuerno",
      "subName": "Vendedor de alimentos de la Feria de la Luna Negra",
