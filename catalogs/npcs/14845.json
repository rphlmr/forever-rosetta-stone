    "hrHR": {
      "dialogue": {
        "3cdd23ec582a7b98259f": "Samo ograničeno vrijeme, hrskave žabe isključivo ovdje na sajmu Darkmoon.",
        "74a653ccee9baf4cc802": "Vi imate novac, a mi hranu. Što čekate?!",
        "8a0b9d6ae647e7f7479a": "Mmm... hrana.",
        "e857d70d54925e5c3162": "Priđite! Vruća krilca čekaju vas ovdje!",
        "fb3309545ab5a53b7280": "Darkmoon hrenovke ravno s roštilja. Dođite po njih dok su vruće!"
      },
      "name": "Stamp Thunderhorn",
