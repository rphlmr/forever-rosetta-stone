    "hrHR": {
      "dialogue": {
        "1fe22ab4180b40be5865": "Starješina Dreamseer boravi u Gadgetzanu u pustinji Tanaris.",
        "263f8639083951813aa9": "U davna vremena živjeli smo za lov. Lovili smo za slavu, za čast...$B$BJe li danas toliko drukčije?",
        "b53d93b11369863c07f0": "Iz razloga koje ne razumijem, starješina Thunderhorn otišao je u Slithering Scar u krateru Un’Goro.",
        "d4c92c00183bac40925a": "Idi u Freewind Post u Thousand Needlesu i pronaći ćeš starješinu Skyseera.",
        "d88d982249478419f166": "Zul’Farrak u pustinji Tanaris dom je starješine Wildmanea."
      },
      "name": "Starješina Ragetotem",
