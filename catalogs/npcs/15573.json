    "plPL": {
      "dialogue": {
        "1fe22ab4180b40be5865": "Starszy Dreamseer przebywa w Gadgetzan na pustyni Tanaris.",
        "263f8639083951813aa9": "Dawno temu żyliśmy dla polowania. Polowaliśmy dla chwały i honoru...$B$BCzy dziś jest tak inaczej?",
        "b53d93b11369863c07f0": "Z powodów, których nie rozumiem, starszy Thunderhorn udał się do Slithering Scar w kraterze Un’Goro.",
        "d4c92c00183bac40925a": "Udaj się do Freewind Post w Thousand Needles, a znajdziesz starszego Skyseera.",
        "d88d982249478419f166": "Domem starszego Wildmane’a jest Zul’Farrak na pustyni Tanaris."
      },
      "name": "Starszy Ragetotem",
