    "daDK": {
      "dialogue": {
        "1fe22ab4180b40be5865": "Ældste Dreamseer bor i Gadgetzan i Tanarisørkenen.",
        "263f8639083951813aa9": "I gamle dage levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "b53d93b11369863c07f0": "Af grunde, jeg ikke forstår, er ældste Thunderhorn taget til Slithering Scar i Un’Goro-krateret.",
        "d4c92c00183bac40925a": "Tag til Freewind Post i Thousand Needles, så finder du ældste Skyseer.",
        "d88d982249478419f166": "Zul’Farrak i Tanarisørkenen er ældste Wildmanes hjem."
      },
      "name": "Ældste Ragetotem",
      "translationMetadata": {
