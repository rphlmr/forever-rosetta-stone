  "locales": {
    "csCZ": {
      "dialogue": {
        "1fe22ab4180b40be5865": "Stařešina Dreamseer sídlí v Gadgetzanu v poušti Tanaris.",
        "263f8639083951813aa9": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu a čest...$B$BJe to dnes tak jiné?",
        "b53d93b11369863c07f0": "Z důvodů, kterým nerozumím, se stařešina Thunderhorn vydal do Slithering Scar v kráteru Un’Goro.",
        "d4c92c00183bac40925a": "Vydej se do Freewind Post v Thousand Needles a najdeš stařešinu Skyseera.",
        "d88d982249478419f166": "Domovem stařešiny Wildmanea je Zul’Farrak v poušti Tanaris."
      },
      "name": "Starší Ragetotem",
