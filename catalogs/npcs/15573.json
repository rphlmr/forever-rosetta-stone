    "svSE": {
      "dialogue": {
        "1fe22ab4180b40be5865": "Äldste Dreamseer finns i Gadgetzan i Tanarisöknen.",
        "263f8639083951813aa9": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "b53d93b11369863c07f0": "Av skäl jag inte förstår har äldste Thunderhorn begett sig till Slithering Scar i Un’Gorokratern.",
        "d4c92c00183bac40925a": "Gå till Freewind Post i Thousand Needles så finner du äldste Skyseer.",
        "d88d982249478419f166": "Zul’Farrak i Tanarisöknen är äldste Wildmanes hem."
      },
      "name": "Äldste Ragetotem",
