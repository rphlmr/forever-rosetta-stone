    "trTR": {
      "dialogue": {
        "1fe22ab4180b40be5865": "İhtiyar Dreamseer, Tanaris Çölü’ndeki Gadgetzan’da yaşıyor.",
        "263f8639083951813aa9": "Çok eski günlerde av için yaşardık. Şan ve onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "b53d93b11369863c07f0": "Anlayamadığım nedenlerle İhtiyar Thunderhorn, Un’Goro Krateri’ndeki Slithering Scar’a gitti.",
        "d4c92c00183bac40925a": "Thousand Needles’taki Freewind Post’a git, İhtiyar Skyseer’ı orada bulursun.",
        "d88d982249478419f166": "Tanaris Çölü’ndeki Zul’Farrak, İhtiyar Wildmane’in evidir."
      },
      "name": "Ulu Ragetotem",
