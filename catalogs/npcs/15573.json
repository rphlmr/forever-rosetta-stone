    "enUS": {
      "dialogue": {
        "1fe22ab4180b40be5865": "Elder Dreamseer resides in Gadgetzan in Tanaris Desert.",
        "263f8639083951813aa9": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "b53d93b11369863c07f0": "For reasons I cannot understand, Elder Thunderhorn has gone to the Slithering Scar in Un'Goro Crater.",
        "d4c92c00183bac40925a": "Go to the Freewind Post in Thousand Needles and you will find Elder Skyseer.",
        "d88d982249478419f166": "Zul'Farrak in Tanaris Desert is Elder Wildmane's home."
      },
      "name": "Elder Ragetotem",
      "translationMetadata": {
