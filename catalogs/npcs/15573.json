    "itIT": {
      "dialogue": {
        "1fe22ab4180b40be5865": "L'Anziano Dreamseer risiede a Gadgetzan, nel Tanaris Desert.",
        "263f8639083951813aa9": "In tempi ormai lontani, vivevamo per la caccia. Cacciavamo per la gloria, per l'onore...\n\nÈ poi così diverso, adesso?",
        "b53d93b11369863c07f0": "Per motivi che non riesco a capire, l'Anziano Thunderhorn è andato all'Anfratto Brulicante, nell'Un'Goro Crater.",
        "d4c92c00183bac40925a": "Vai all'Avamposto di Freewind, a Thousand Needles, e troverai l'Anziano Skyseer.",
        "d88d982249478419f166": "Zul'Farrak, nel Tanaris Desert, è la dimora dell'Anziana Wildmane."
      },
      "name": "Anziano Ragetotem",
