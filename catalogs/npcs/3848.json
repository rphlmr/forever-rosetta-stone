    "deDE": {
      "dialogue": {
        "3525b7bf567bfbd4c714": "Bildet mich aus.",
        "b696bd40e7bfa35a6b1d": "Das Gleichgewicht der Natur ist empfindlich und gerät leicht ins Wanken.  Bist du mutig genug, die Dinge wieder in Ordnung zu bringen?",
        "ca3be0afd2fc8548fb81": "Ich möchte Eure Waren ansehen."
      },
      "name": "Kayneth Stillwind",
      "translationMetadata": {
