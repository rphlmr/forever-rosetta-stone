    "daDK": {
      "dialogue": {
        "3525b7bf567bfbd4c714": "Træn mig.",
        "b696bd40e7bfa35a6b1d": "Naturens balance er skrøbelig og let at forstyrre. Er du modig nok til at rette op på det?",
        "ca3be0afd2fc8548fb81": "Jeg vil gerne se dine varer."
      },
      "name": "Kayneth Stillwind",
      "translationMetadata": {
