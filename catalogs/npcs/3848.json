      "dialogue": {
        "3525b7bf567bfbd4c714": "Train me.",
        "b696bd40e7bfa35a6b1d": "The balance of nature is a delicate one, and easily tipped.  Are you brave enough to make things right?",
        "ca3be0afd2fc8548fb81": "I want to browse your goods."
      },
      "name": "Kayneth Stillwind",
