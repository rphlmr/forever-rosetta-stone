      "dialogue": {
        "3525b7bf567bfbd4c714": "Vycvičte mě.",
        "b696bd40e7bfa35a6b1d": "Rovnováha přírody je křehká a snadno se naruší. Máš odvahu vše napravit?",
        "ca3be0afd2fc8548fb81": "Rád bych si prohlédl vaše zboží."
