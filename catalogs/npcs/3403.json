    "plPL": {
      "dialogue": {
        "27b22c197dc63adb9991": "Naucz mnie ścieżek duchów.",
        "2d5ceed3e616c0f4f021": "Duchy są z tobą silnie związane, przyjacielu. Co ten troll może dla ciebie zrobić?",
        "3a6fc6a4c72cc42caa34": "Dzięki rygorystycznemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by uczyć ich na nowo. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz zapomnieć wyuczone talenty?",
        "4ea55324421675c262dd": "Niech duchy cię chronią, przyjacielu."
      },
      "name": "Sian'tsu",
