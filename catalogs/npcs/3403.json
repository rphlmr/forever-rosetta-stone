    "daDK": {
      "dialogue": {
        "27b22c197dc63adb9991": "Lær mig åndernes veje.",
        "2d5ceed3e616c0f4f021": "Ånderne står stærkt hos dig, ven. Hvad kan denne trold gøre for dig?",
        "3a6fc6a4c72cc42caa34": "Ved grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Det bliver sværere hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "4ea55324421675c262dd": "Må ånderne beskytte dig, ven."
      },
      "name": "Sian'tsu",
      "translationMetadata": {
