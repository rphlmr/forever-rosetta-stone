    "trTR": {
      "dialogue": {
        "27b22c197dc63adb9991": "Bana ruhların yollarını öğret.",
        "2d5ceed3e616c0f4f021": "Ruhlar seninle güçlü, dostum. Bu trol senin için ne yapabilir?",
        "3a6fc6a4c72cc42caa34": "Sıkı bir yeniden eğitimle birçok öğrencime öğrendikleri her şeyi unutturup onları baştan eğitmem gerekti. Bu işlem her tekrarlandığında zorlaşır ve bu yüzden pahalılaşır. Öğrendiğin yetenekleri unutmanı ister misin?",
        "4ea55324421675c262dd": "Ruhlar seni korusun, dostum."
      },
      "name": "Sian'tsu",
