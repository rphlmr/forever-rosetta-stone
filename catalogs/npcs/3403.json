    "enUS": {
      "dialogue": {
        "27b22c197dc63adb9991": "Teach me the ways of the spirits.",
        "2d5ceed3e616c0f4f021": "Da spirits be strong wit you, mon. What kin dis troll do for ya?",
        "3a6fc6a4c72cc42caa34": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "4ea55324421675c262dd": "May da spirits protect you mon."
      },
      "name": "Sian'tsu",
      "subName": "Shaman Trainer",
      "translationMetadata": {
        "fields": {
