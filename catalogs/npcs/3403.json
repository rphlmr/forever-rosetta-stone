    "hrHR": {
      "dialogue": {
        "27b22c197dc63adb9991": "Nauči me putovima duhova.",
        "2d5ceed3e616c0f4f021": "Duhovi su snažni s tobom, prijatelju. Što ovaj trol može učiniti za tebe?",
        "3a6fc6a4c72cc42caa34": "Strogom prekvalifikacijom morao sam mnoge učenike odviknuti od svega što su naučili kako bih ih mogao ponovno podučiti. Svaka sljedeća prekvalifikacija sve je teža, pa zato i skuplja. Želiš li da zaboraviš naučene talente?",
        "4ea55324421675c262dd": "Neka te duhovi štite, prijatelju."
      },
      "name": "Sian'tsu",
