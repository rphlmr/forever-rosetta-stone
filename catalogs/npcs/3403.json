  "locales": {
    "csCZ": {
      "dialogue": {
        "27b22c197dc63adb9991": "Nauč mě cestám duchů.",
        "2d5ceed3e616c0f4f021": "Duchové jsou s tebou silní, kámo. Co pro tebe může tenhle troll udělat?",
        "3a6fc6a4c72cc42caa34": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co dříve znali, abych je mohl vyučit znovu. Tato služba je při každém dalším přeškolení náročnější, a proto i dražší. Přeješ si zapomenout naučené talenty?",
        "4ea55324421675c262dd": "Ať tě duchové chrání, kámo."
      },
      "name": "Sian'tsu",
      "translationMetadata": {
        "fields": {
          "dialogue.27b22c197dc63adb9991": {
