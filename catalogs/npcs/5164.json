  "factionTemplateId": 55,
  "locales": {
    "csCZ": {
      "dialogue": {
        "3d88cbb84f3ee44b9474": "Kvůli tomu mě obtěžuješ? Lepší by bylo přivázat si na záda mrtvého králíka a proběhnout trolím doupětem než nosit tenhle krám.",
        "7e18fe0a4517a99cd726": "$n, že? To je opravdu pěkný kus práce, který máš u sebe. Vezmu tě do učení a naučím tě vyrábět zbroj hodnou samotného krále Magniho.",
        "84e9f3287f4eece7dd5a": "Vítej zpět ve Velké kovárně, $n. Přišel jsi navštívit starého trpaslíka, nebo si myslíš, že jsi připraven na další krok ve výcviku?",
        "9cd5dc9051535b78ab60": "Vycvičte mě."
      },
      "name": "Grumnus Steelshaper",
      "translationMetadata": {
        "fields": {
          "dialogue.3d88cbb84f3ee44b9474": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.7e18fe0a4517a99cd726": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.84e9f3287f4eece7dd5a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.9cd5dc9051535b78ab60": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
