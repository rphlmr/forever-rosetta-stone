            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "3d88cbb84f3ee44b9474": "Forstyrrer du mig for det? Du ville være bedre stillet med en død kanin bundet på ryggen, mens du løber gennem en troldehule, end med det stykke skrammel på.",
        "7e18fe0a4517a99cd726": "$n, var det? Det er et mægtigt fint stykke arbejde, du har der. Jeg tager dig i lære og lærer dig at lave rustninger, der er kong Magni selv værdige.",
        "84e9f3287f4eece7dd5a": "Velkommen tilbage til Den Store Esse, $n. Er du kommet for at besøge en gammel dværg, eller tror du, at du er klar til næste trin i din træning?",
        "9cd5dc9051535b78ab60": "Træn mig."
      },
      "name": "Grumnus Steelshaper",
      "translationMetadata": {
        "fields": {
          "dialogue.3d88cbb84f3ee44b9474": {
            "origin": "ai",
