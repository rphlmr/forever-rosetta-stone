    "ltLT": {
      "dialogue": {
        "3d88cbb84f3ee44b9474": "Dėl to mane sutrukdei? Jau geriau prisirišk negyvą triušį prie nugaros ir perbėk per trolių landynę, nei dėvėk tą šlamštą.",
        "7e18fe0a4517a99cd726": "$n, taip? Puikus dirbinys tavo rankose. Priimsiu tave mokytis ir išmokysiu kalti šarvus, vertus paties karaliaus Magni.",
        "84e9f3287f4eece7dd5a": "Sveikas sugrįžęs į Didžiąją kalvę, $n. Atėjai aplankyti seno nykštuko, o gal manai, kad esi pasirengęs kitam mokymosi etapui?",
        "9cd5dc9051535b78ab60": "Mokyk mane."
      },
      "name": "Grumnus Steelshaper",
      "subName": "Šarvų kalvis",
      "translationMetadata": {
        "fields": {
          "dialogue.3d88cbb84f3ee44b9474": {
