    "ltLT": {
      "dialogue": {
        "094eff609a22c98b8644": "Atėjai pasimokyti iš meistro, ką?",
        "6a1ddc3d54ea929a1482": "Ar atrodau tau kaip $c? Dabar nešdinkis, kol neužsimaniau sutepti savo geležtės... tavo krauju.",
        "aeda30b68031db6edc60": "Taip, atėjau. Mokyk mane.",
        "b5a82e225cc57d98ec05": "Griežtai perkvalifikuodamas turėjau priversti daugelį mokinių atsisakyti visko, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo.  Šią paslaugą kaskart suteikti darosi vis sunkiau.  Todėl kiekvienas perkvalifikavimas kainuoja vis daugiau.  Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?"
      },
      "name": "Fahrad",
      "subName": "Didysis nesąžiningos kovos meistras",
      "translationMetadata": {
