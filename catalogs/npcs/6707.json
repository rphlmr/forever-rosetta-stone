  "locales": {
    "csCZ": {
      "dialogue": {
        "094eff609a22c98b8644": "Přišel ses učit od mistra, co?",
        "6a1ddc3d54ea929a1482": "Vypadám snad jako $c? Teď zmiz, než dostanu chuť naolejovat svou čepel... tvou krví.",
        "aeda30b68031db6edc60": "Ano, mám. Uč mě.",
        "b5a82e225cc57d98ec05": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení náročnější. Proto je každé další přeškolení také dražší. Chceš, abych tě odnaučil talenty, které ses naučil?"
      },
      "name": "Fahrad",
      "translationMetadata": {
        "fields": {
          "dialogue.094eff609a22c98b8644": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.6a1ddc3d54ea929a1482": {
