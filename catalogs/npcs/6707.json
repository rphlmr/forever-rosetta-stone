    "hrHR": {
      "dialogue": {
        "094eff609a22c98b8644": "Došao učiti od majstora, ha?",
        "6a1ddc3d54ea929a1482": "Izgledam li ti kao $c? Gubi se prije nego što poželim nauljiti oštricu... tvojom krvlju.",
        "aeda30b68031db6edc60": "Da, jesam. Poduči me.",
        "b5a82e225cc57d98ec05": "Strogim prekvalificiranjem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao ponovno podučavati. Tu je uslugu sve teže pružiti svaki put kada se ponovi. Zato je svako sljedeće prekvalificiranje sve skuplje. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Fahrad",
