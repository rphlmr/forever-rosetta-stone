        }
      }
    },
    "daDK": {
      "dialogue": {
        "094eff609a22c98b8644": "Kommet for at lære af mesteren, hva'?",
        "6a1ddc3d54ea929a1482": "Ligner jeg en $c? Forsvind nu, før jeg får lyst til at smøre min klinge... med dit blod.",
        "aeda30b68031db6edc60": "Ja, det har jeg. Lær mig.",
        "b5a82e225cc57d98ec05": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang, den udføres. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Fahrad",
      "translationMetadata": {
        "fields": {
          "dialogue.094eff609a22c98b8644": {
            "origin": "ai",
