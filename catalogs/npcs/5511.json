    "enUS": {
      "dialogue": {
        "377c1367ad09103bda2e": "So ye want to be a Blacksmith eh? Grab an apron and a hammer $g lad : lass;, let's see what ye've got.",
        "8e378f3378b16b2bc3d8": "Ye have some skill about ye with hammer and anvil, but not enough. Go speak to Dane Lindgren, he'll get ye ready to learn what I have to teach ye.",
        "a06340d27153d97371d6": "Train me.",
        "c7dad538c8c88f6b452a": "So ye want to be a Blacksmith eh? Grab an apron and a hammer $g lad : lass;, let's see what ye've got."
      },
      "name": "Therum Deepforge",
      "subName": "Expert Blacksmith",
