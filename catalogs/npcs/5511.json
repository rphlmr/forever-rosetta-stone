  "locales": {
    "csCZ": {
      "dialogue": {
        "377c1367ad09103bda2e": "Takže chceš být kovářem? Popadni zástěru a kladivo, $g chlapče : děvče;, a ukaž, co umíš.",
        "8e378f3378b16b2bc3d8": "S kladivem a kovadlinou už něco umíš, ale nestačí to. Promluv si s Danem Lindgrenem, připraví tě na to, co tě mohu naučit.",
        "a06340d27153d97371d6": "Vycvičte mě.",
        "c7dad538c8c88f6b452a": "Takže chceš být kovářem? Popadni zástěru a kladivo, $g chlapče : děvče;, a ukaž, co umíš."
      },
      "name": "Therum Deepforge",
