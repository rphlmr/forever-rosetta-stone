    "enUS": {
      "dialogue": {
        "1adc2dcc047672fdbf89": "It is wise that you humble yourself before me $N in your desire for more warlock knowledge.",
        "ad7663c95654140d34bb": "I have no time to waste on the likes of you $c.",
        "cde4dc501004e7a121b4": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "f91c541e23072b4d3a7b": "I submit myself for further training my master."
      },
      "name": "Maximillion",
      "subName": "Warlock Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.1adc2dcc047672fdbf89": {
