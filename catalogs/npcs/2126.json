          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "1adc2dcc047672fdbf89": "Det er klogt af dig at ydmyge dig for mig, $N, i dit ønske om større troldmandskundskab.",
        "ad7663c95654140d34bb": "Jeg har ikke tid at spilde på folk som dig, $c.",
        "cde4dc501004e7a121b4": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre, hver gang den bruges. Derfor bliver hver omskoling dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "f91c541e23072b4d3a7b": "Jeg stiller mig til rådighed for videre træning, mester."
      },
      "name": "Maximillion",
      "translationMetadata": {
        "fields": {
          "dialogue.1adc2dcc047672fdbf89": {
