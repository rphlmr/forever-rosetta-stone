    "plPL": {
      "dialogue": {
        "3896d17541b776dfe364": "Moja mądrość i wiedza są do twojej dyspozycji. Co mogę dla ciebie zrobić, $n?",
        "6b6563a315189f4b069d": "Poprzez rygorystyczne szkolenie musiałam oduczyć wielu uczniów wszystkiego, czego się wcześniej nauczyli, aby móc szkolić ich na nowo. Usługa, którą oferuję, staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne szkolenie jest droższe. Czy chcesz, abym oduczyła cię poznanych talentów?",
        "8cf4ec5baf74507aa840": "Niech Elune będzie z tobą, $c.",
        "f766ef0222106659f561": "Szukam dalszego szkolenia w sztuce kapłańskiej."
      },
      "name": "Nara Meideros",
      "translationMetadata": {
        "fields": {
