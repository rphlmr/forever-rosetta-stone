    "daDK": {
      "dialogue": {
        "3896d17541b776dfe364": "Min visdom og min viden står til din rådighed. Hvad kan jeg gøre for dig, $n?",
        "6b6563a315189f4b069d": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre, hver gang den bruges. Derfor bliver hver omskoling dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "8cf4ec5baf74507aa840": "Elune være med dig, $c.",
        "f766ef0222106659f561": "Jeg søger mere træning i præsternes kunst."
      },
      "name": "Nara Meideros",
      "translationMetadata": {
        "fields": {
          "dialogue.3896d17541b776dfe364": {
            "origin": "ai",
