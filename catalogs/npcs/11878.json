    "hrHR": {
      "dialogue": {
        "75df9d7118369db52951": "Nema sumnje da si još jedna nesposobna budala koju je Mračna Gospa poslala da uči od njezina prvaka.$B$B<Nathanos uzdahne.>$B$BSvakoga od vas poslao sam joj natrag u komadima i ne vidim zašto bi ovaj put bilo drugačije.$B$BAli moje nije da pitam zašto, nego da činim što Mračna Gospa zapovijeda."
      },
      "name": "Nathanos Blightcaller",
      "translationMetadata": {
        "fields": {
