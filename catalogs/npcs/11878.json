        }
      }
    },
    "itIT": {
      "dialogue": {
        "75df9d7118369db52951": "Senza dubbio sei un altro incapace mandato dalla Signora Oscura ad addestrarsi con il suo campione.$B$B<Nathanos sospira.>$B$BVi ho rimandati tutti da lei a pezzi, e non vedo perché questa volta dovrebbe andare diversamente.$B$BMa non spetta a me chiedermi il perché: devo solo fare ciò che la Signora Oscura ordina."
      },
      "name": "Nathanos Blightcaller",
      "translationMetadata": {
        "fields": {
