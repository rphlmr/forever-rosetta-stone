  "locales": {
    "csCZ": {
      "dialogue": {
        "75df9d7118369db52951": "Nepochybně jsi další neschopný hlupák, kterého Temná paní poslala, aby se učil od jejího šampiona.$B$B<Nathanos si povzdechne.>$B$BVšechny před tebou jsem jí poslal zpátky po kusech. Nevidím důvod, proč by to tentokrát mělo být jiné.$B$BMým úkolem však není ptát se proč, ale dělat, co Temná paní přikáže."
      },
      "name": "Nathanos Blightcaller",
      "translationMetadata": {
        "fields": {
