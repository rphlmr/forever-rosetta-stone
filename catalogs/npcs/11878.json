    "ltLT": {
      "dialogue": {
        "75df9d7118369db52951": "Be abejo, esi dar vienas nevykęs kvailys, kurį Dark Lady atsiuntė mokytis pas savo čempioną.$B$B<Nathanos atsidūsta.>$B$BKiekvieną iš jūsų išsiunčiau jai atgal gabalais ir nematau, kodėl šįkart turėtų būti kitaip.$B$BTačiau mano pareiga ne klausti kodėl, o vykdyti Dark Lady įsakymus."
      },
      "name": "Nathanos Blightcaller",
      "subName": "Banshee Queen čempionas",
      "translationMetadata": {
