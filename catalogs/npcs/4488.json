          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Beantwortet mir folgende Frage, $n:\nWas für eine Kreatur war der Lichkönig, bevor er die Seuche über Lordaeron brachte?",
        "82acce113d8c87f15b06": "Es ist immer nett, wenn jemand mit mir sprechen möchte. Wie laufen die Dinge bei Euch, $C?"
      },
      "name": "Parqual Fintallas",
      "translationMetadata": {
        "fields": {
          "dialogue.5727b381b94c0edf83b7": {
