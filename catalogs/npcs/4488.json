    "ptBR": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Agora me responda uma coisa, $n\nQue criatura se tornou o Lich Rei antes de espalhar a peste por Lordaeron?",
        "82acce113d8c87f15b06": "É sempre bom quando alguém deseja falar comigo. Como andam as coisas, $c?",
        "zephras:40dd7ab3b48639572657": "Minha resposta é Ner’zhul.",
        "zephras:8a2eef8ebaf9da7490d7": "Minha resposta é Kel'Thuzad.",
        "zephras:a87816b26b69bf7a969a": "Minha resposta é Gul'dan.",
        "zephras:b791f1710ae18660daf9": "Minha resposta é Kil'jaeden."
      },
