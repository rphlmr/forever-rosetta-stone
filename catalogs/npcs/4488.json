    "plPL": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Odpowiedz mi, $n:$BJaka istota została Królem Liszem, zanim rozprzestrzeniła plagę po Lordaeronie?",
        "82acce113d8c87f15b06": "Zawsze miło, gdy ktoś chce ze mną porozmawiać. Jak się masz, $c?",
        "zephras:40dd7ab3b48639572657": "Moją odpowiedzią jest Ner’zhul.",
        "zephras:8a2eef8ebaf9da7490d7": "Moją odpowiedzią jest Kel'Thuzad.",
        "zephras:a87816b26b69bf7a969a": "Moją odpowiedzią jest Gul'dan.",
        "zephras:b791f1710ae18660daf9": "Moją odpowiedzią jest Kil'jaeden."
      },
