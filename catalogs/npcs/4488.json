    "trTR": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Şimdi cevap ver, $n:$BHangi yaratık vebayı Lordaeron’a yaymadan önce Lich King oldu?",
        "82acce113d8c87f15b06": "Birinin benimle konuşmak istemesi her zaman hoşuma gider. Nasılsın, $c?",
        "zephras:40dd7ab3b48639572657": "Cevabım Ner’zhul.",
        "zephras:8a2eef8ebaf9da7490d7": "Cevabım Kel'Thuzad.",
        "zephras:a87816b26b69bf7a969a": "Cevabım Gul'dan.",
        "zephras:b791f1710ae18660daf9": "Cevabım Kil'jaeden."
