    "enUS": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Now, answer me this, $n:$BWhich creature became the Lich King before spreading the plague across Lordaeron?",
        "82acce113d8c87f15b06": "It's always nice when someone wishes to speak to me. How are things with you, $c?",
        "zephras:40dd7ab3b48639572657": "Ner'zhul is my answer.",
        "zephras:8a2eef8ebaf9da7490d7": "Kel'Thuzad is my answer.",
        "zephras:a87816b26b69bf7a969a": "Gul'dan is my answer.",
        "zephras:b791f1710ae18660daf9": "Kil'jaeden is my answer."
