          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Svar mig så, $n:$BHvilket væsen blev til Lich King, før det spredte pesten over Lordaeron?",
        "82acce113d8c87f15b06": "Det er altid rart, når nogen ønsker at tale med mig. Hvordan går det, $c?"
      },
      "name": "Parqual Fintallas",
      "translationMetadata": {
        "fields": {
          "dialogue.5727b381b94c0edf83b7": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
