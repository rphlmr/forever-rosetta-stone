  "locales": {
    "csCZ": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Teď mi odpověz, $n:$BKterá bytost se stala Králem lichů, než rozšířila mor po Lordaeronu?",
        "82acce113d8c87f15b06": "Vždycky mě potěší, když si se mnou někdo chce promluvit. Jak se ti daří, $c?",
        "zephras:40dd7ab3b48639572657": "Moje odpověď je Ner’zhul.",
        "zephras:8a2eef8ebaf9da7490d7": "Má odpověď je Kel'Thuzad.",
        "zephras:a87816b26b69bf7a969a": "Gul'dan je má odpověď.",
        "zephras:b791f1710ae18660daf9": "Mou odpovědí je Kil'jaeden."
      },
      "name": "Parqual Fintallas",
