    "frFR": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Maintenant répondez à ceci, $N :\nQuelle créature devint le roi-liche avant de répandre la peste sur Lordaeron ?",
        "82acce113d8c87f15b06": "C'est toujours un plaisir de voir quelqu'un qui désire me parler. Comment allez-vous, $c ?"
      },
      "name": "Parqual Fintallas",
