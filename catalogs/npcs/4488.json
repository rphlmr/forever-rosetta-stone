    "trTR": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Şimdi cevap ver, $n:$BHangi yaratık vebayı Lordaeron’a yaymadan önce Lich King oldu?",
        "82acce113d8c87f15b06": "Birinin benimle konuşmak istemesi her zaman hoşuma gider. Nasılsın, $c?"
      },
      "name": "Parqual Fintallas",
      "translationMetadata": {
