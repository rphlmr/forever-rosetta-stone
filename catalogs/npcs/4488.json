    "esES": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Ahora, respóndeme a esto, $n.\n¿Qué criatura se convirtió en el Rey Exánime antes de extender la Peste por Lordaeron?",
        "82acce113d8c87f15b06": "Siempre es agradable que alguien quiera hablar conmigo. ¿Cómo te va todo, $c?"
      },
      "name": "Parqual Fintallas",
