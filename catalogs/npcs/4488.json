    "hrHR": {
      "dialogue": {
        "5727b381b94c0edf83b7": "Odgovori mi, $n:$BKoje je stvorenje postalo Kralj lich prije nego što je proširilo kugu Lordaeronom?",
        "82acce113d8c87f15b06": "Uvijek mi je drago kad netko želi razgovarati sa mnom. Kako si, $c?"
      },
      "name": "Parqual Fintallas",
      "translationMetadata": {
