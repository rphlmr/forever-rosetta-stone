    "frFR": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Entraînez-moi.",
        "bb6e57e9f3cb763b70b8": "Un travail d'expert ! Nous pouvons poursuivre votre éducation...",
        "eb79eabbeed88a16d4f2": "Bienvenue dans ma tente. En quoi puis-je vouis aider ?",
        "f4958ed8b22da51fd5dc": "Vos connaissances sont remarquables. Vous devez chercher des maîtres plus instruits que moi. On dit le plus grand bien de la sagesse de Josef Gregorian. Vous le trouverez à Undercity."
      },
      "name": "Mahani",
      "subName": "Tailleur - Expert",
