    "esES": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Entréname.",
        "bb6e57e9f3cb763b70b8": "¡Lo has hecho excelentemente bien! Ahora, continuemos con tu educación...",
        "eb79eabbeed88a16d4f2": "Te doy la bienvenida a nuestra tienda. ¿Puedo ayudarte?",
        "f4958ed8b22da51fd5dc": "Tienes un gran conocimiento, viajero. Debes aprender de alguien más sabio que yo. Se han contado muchas historias sobre la sabiduría de Josef Gregorian. Puedes encontrarle en Entrañas."
      },
      "name": "Mahani",
      "subName": "Experta sastre",
