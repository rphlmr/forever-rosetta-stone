    "daDK": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Træn mig.",
        "bb6e57e9f3cb763b70b8": "Mesterligt udført! Lad os nu fortsætte din uddannelse...",
        "eb79eabbeed88a16d4f2": "Velkommen til vores telt. Kan jeg hjælpe dig?",
        "f4958ed8b22da51fd5dc": "Din viden er stor, rejsende. Du må lære af en, der er visere end jeg. Der fortælles mange historier om Josef Gregorians visdom. Du kan finde ham i Undercity."
      },
      "name": "Mahani",
      "translationMetadata": {
        "fields": {
