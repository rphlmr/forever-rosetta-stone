  "locales": {
    "csCZ": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Vycvičte mě.",
        "bb6e57e9f3cb763b70b8": "Mistrovsky provedeno! Nyní pokračujme ve tvém vzdělávání...",
        "eb79eabbeed88a16d4f2": "Vítej v našem stanu. Mohu ti pomoci?",
        "f4958ed8b22da51fd5dc": "Tvé znalosti jsou rozsáhlé, poutníku. Musíš se učit od někoho moudřejšího, než jsem já. O moudrosti Josefa Gregoriana se vypráví mnoho příběhů. Najdeš ho v Undercity."
      },
      "name": "Mahani",
      "translationMetadata": {
        "fields": {
          "dialogue.8536c0419c1fc413cb5b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
