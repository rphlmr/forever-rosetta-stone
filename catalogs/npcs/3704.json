    "svSE": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Träna mig.",
        "bb6e57e9f3cb763b70b8": "Mästerligt utfört! Låt oss nu fortsätta din utbildning...",
        "eb79eabbeed88a16d4f2": "Välkommen till vårt tält. Kan jag hjälpa dig?",
        "f4958ed8b22da51fd5dc": "Din kunskap är stor, resenär. Du måste lära av någon som är visare än jag. Många berättelser har berättats om Josef Gregorians visdom. Du kan finna honom i Undercity."
      },
      "name": "Mahani",
