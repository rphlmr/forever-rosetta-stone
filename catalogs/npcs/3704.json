    "hrHR": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Podučite me.",
        "bb6e57e9f3cb763b70b8": "Majstorski obavljeno! Nastavimo sada tvoje obrazovanje...",
        "eb79eabbeed88a16d4f2": "Dobro došao u naš šator. Mogu li ti pomoći?",
        "f4958ed8b22da51fd5dc": "Tvoje je znanje veliko, putniče. Moraš učiti od nekoga mudrijeg od mene. Mnoge se priče pričaju o mudrosti Josefa Gregoriana. Možeš ga pronaći u Undercityju."
      },
      "name": "Mahani",
