    "itIT": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Addestrami.",
        "bb6e57e9f3cb763b70b8": "Eseguito con maestria! Ora continuiamo con la tua istruzione...",
        "eb79eabbeed88a16d4f2": "Benvenuto nella nostra tenda. Posso aiutarti?",
        "f4958ed8b22da51fd5dc": "Il tuo sapere è grande, viandante. Devi imparare da qualcuno più saggio di me. Sulla saggezza di Josef Gregorian si raccontano molte storie. Lo trovi a Undercity."
      },
      "name": "Mahani",
      "translationMetadata": {
