    "plPL": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Wyszkol mnie.",
        "bb6e57e9f3cb763b70b8": "Po mistrzowsku! Kontynuujmy teraz twoją naukę...",
        "eb79eabbeed88a16d4f2": "Witaj w naszym namiocie. Czy mogę ci pomóc?",
        "f4958ed8b22da51fd5dc": "Twoja wiedza jest wielka, podróżniku. Musisz uczyć się od kogoś mądrzejszego ode mnie. Wiele opowieści krąży o mądrości Josefa Gregoriana. Znajdziesz go w Undercity."
      },
      "name": "Mahani",
