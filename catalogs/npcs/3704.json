    "enUS": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Train me.",
        "bb6e57e9f3cb763b70b8": "Expertly accomplished! Now, let us continue your education...",
        "eb79eabbeed88a16d4f2": "Welcome to our tent. May I assist you?",
        "f4958ed8b22da51fd5dc": "Your knowledge is great, traveler. You must learn from one who is wiser than I. Many tales have been told of the wisdom of Josef Gregorian. You may find him in Undercity."
      },
      "name": "Mahani",
      "subName": "Expert Tailor",
