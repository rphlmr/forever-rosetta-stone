    "deDE": {
      "dialogue": {
        "8536c0419c1fc413cb5b": "Bildet mich aus.",
        "bb6e57e9f3cb763b70b8": "Hervorragende Leistung! Setzen wir jetzt also Eure Ausbildung fort...",
        "eb79eabbeed88a16d4f2": "Willkommen in unserem Zelt. Kann ich Euch helfen?",
        "f4958ed8b22da51fd5dc": "Euer Wissen ist groß. Ihr müsst von jemandem lernen, der weiser ist als ich. Es werden viele Geschichten über die Weisheit von Josef Gregorian erzählt. Ihr findet ihn in Undercity."
      },
      "name": "Mahani",
      "subName": "Schneiderexpertin",
      "translationMetadata": {
