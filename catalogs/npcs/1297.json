    "daDK": {
      "dialogue": {
        "ad90e711bf424b6548b0": "Ser du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?",
        "d262eda2e6e0c6ee98cf": "Jeg vil gerne se dine varer.",
        "d408f9fa31e52c8f72ac": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe med?"
      },
      "name": "Lina Stover",
