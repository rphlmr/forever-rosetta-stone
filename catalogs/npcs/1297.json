    "svSE": {
      "dialogue": {
        "ad90e711bf424b6548b0": "Tittar du bara på mina varor, eller kan jag hjälpa dig att hitta något särskilt i dag?",
        "d262eda2e6e0c6ee98cf": "Jag vill se dina varor.",
        "d408f9fa31e52c8f72ac": "De bästa erbjudandena i hela Stormwind, min vän. Du hittar inga bättre. Vad kan jag hjälpa dig med?"
