    "csCZ": {
      "dialogue": {
        "ad90e711bf424b6548b0": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "d262eda2e6e0c6ee98cf": "Rád bych si prohlédl vaše zboží.",
        "d408f9fa31e52c8f72ac": "Nejlepší ceny v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?"
      },
      "name": "Lina Stover",
