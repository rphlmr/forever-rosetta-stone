  "locales": {
    "csCZ": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Vycvičte mě.",
        "8c431c5e97eafa7b7bbd": "Mohu tě naučit rybařit.",
        "d4ce0ab11c87b3ea5c95": "Pokud se chceš zdokonalit ještě víc, musíš najít Nata Pagla v Dustwallow Marsh.",
        "d6088f7d20f168cbbe68": "Tvá dovednost převyšuje mou, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti určitě pomůže se zlepšit."
      },
      "name": "Uthan Stillwater",
      "translationMetadata": {
