    "plPL": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Wyszkol mnie.",
        "8c431c5e97eafa7b7bbd": "Mogę nauczyć cię łowienia ryb.",
        "d4ce0ab11c87b3ea5c95": "Musisz odnaleźć Nata Pagle’a w Dustwallow Marsh, jeśli chcesz doskonalić swoje umiejętności.",
        "d6088f7d20f168cbbe68": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci się rozwinąć."
      },
      "name": "Uthan Stillwater",
