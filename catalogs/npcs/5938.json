    "hrHR": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Podučite me.",
        "8c431c5e97eafa7b7bbd": "Mogu te naučiti ribarskim vještinama.",
        "d4ce0ab11c87b3ea5c95": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako želiš postati bolji nego što si sada.",
        "d6088f7d20f168cbbe68": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige \"Grgeč i ti\". Ona će ti sigurno pomoći da se usavršiš."
      },
      "name": "Uthan Stillwater",
