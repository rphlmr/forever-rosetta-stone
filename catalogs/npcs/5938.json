    "itIT": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Addestrami.",
        "8c431c5e97eafa7b7bbd": "Posso insegnarti l'arte della pesca.",
        "d4ce0ab11c87b3ea5c95": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "d6088f7d20f168cbbe68": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità."
      },
      "name": "Uthan Stillwater",
