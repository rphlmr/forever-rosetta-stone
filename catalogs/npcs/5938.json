    "daDK": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Træn mig.",
        "8c431c5e97eafa7b7bbd": "Jeg kan lære dig at fiske.",
        "d4ce0ab11c87b3ea5c95": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu.",
        "d6088f7d20f168cbbe68": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"Aborren og dig\". Den vil helt sikkert hjælpe dig med at blive bedre."
      },
      "name": "Uthan Stillwater",
      "translationMetadata": {
        "fields": {
