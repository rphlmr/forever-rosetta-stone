    "deDE": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Bildet mich aus.",
        "8c431c5e97eafa7b7bbd": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "d4ce0ab11c87b3ea5c95": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "d6088f7d20f168cbbe68": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern."
      },
      "name": "Uthan Stillwater",
      "subName": "Angler",
      "translationMetadata": {
