    "trTR": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Beni eğit.",
        "8c431c5e97eafa7b7bbd": "Sana balıkçılık öğretebilirim.",
        "d4ce0ab11c87b3ea5c95": "Şu an olduğundan daha iyi olmak için Dustwallow Marsh’ta Nat Pagle’ı bulmalısın.",
        "d6088f7d20f168cbbe68": "Becerin benimkini aşıyor, ama Booty Bay’deki Yaşlı Heming’in \"Levrek ve Sen\" kitabından nüshaları olduğunu duydum. Bu, becerini geliştirmen için sana kesinlikle yardımcı olacaktır."
      },
      "name": "Uthan Stillwater",
