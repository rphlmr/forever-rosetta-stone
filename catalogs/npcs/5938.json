    "frFR": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Entraînez-moi.",
        "8c431c5e97eafa7b7bbd": "Je peux vous apprendre à pêcher.",
        "d4ce0ab11c87b3ea5c95": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "d6088f7d20f168cbbe68": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser."
      },
      "name": "Uthan Stillwater",
      "subName": "Pêcheur",
