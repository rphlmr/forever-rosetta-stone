    "esES": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Entréname.",
        "8c431c5e97eafa7b7bbd": "Puedo enseñarte a pescar.",
        "d4ce0ab11c87b3ea5c95": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "d6088f7d20f168cbbe68": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad."
      },
      "name": "Uthan Aguaserena",
      "subName": "Pescador",
