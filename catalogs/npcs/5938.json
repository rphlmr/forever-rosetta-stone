    "ltLT": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Išmokyk mane.",
        "8c431c5e97eafa7b7bbd": "Galiu išmokyti tave žvejoti.",
        "d4ce0ab11c87b3ea5c95": "Jei nori toliau tobulinti savo įgūdžius, turėsi susirasti Nat Pagle Dustwallow pelkėje.",
        "d6088f7d20f168cbbe68": "Tavo įgūdžiai pranoksta manuosius, tačiau girdėjau, kad senis Heming Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau patobulinti savo įgūdžius."
      },
      "name": "Uthan Stillwater",
      "subName": "Žvejys",
