    "svSE": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Träna mig.",
        "8c431c5e97eafa7b7bbd": "Jag kan lära dig att fiska.",
        "d4ce0ab11c87b3ea5c95": "Du måste hitta Nat Pagle i Dustwallow Marsh för att bli bättre än du är nu.",
        "d6088f7d20f168cbbe68": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av \"Abborren och du\". Den hjälper dig säkert att bli skickligare."
      },
      "name": "Uthan Stillwater",
