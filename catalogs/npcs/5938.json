    "ptBR": {
      "dialogue": {
        "7c829c8669527bae4b3b": "Treine-me.",
        "8c431c5e97eafa7b7bbd": "Eu posso te ensinar técnicas de pesca.",
        "d4ce0ab11c87b3ea5c95": "Você só será capaz de melhorar sua técnica se encontrar o Nat Pagle no Pântano Vadeoso.",
        "d6088f7d20f168cbbe68": "Você é bem mais habilidoso do que eu. Ouvi dizer que o Velho Heming tem cópias de \"O Bagre e Você\" lá na Angra do Butim. Se você ler o livro, vai ficar melhor ainda."
      },
      "name": "Uthan Águas Calmas",
      "subName": "Pescador",
