    "ptBR": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Tempos sombrios chegaram, $c... Em breve demais perderemos tudo... Quando a Luz abandonar todos, exceto aqueles que realmente caminham sob ela.",
        "d119a708041ab52e5279": "Quero ver suas mercadorias.",
        "e13179de508cd8dac75d": "Treine-me."
      },
      "name": "Elaine Carevino",
