  "locales": {
    "csCZ": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Nastaly temné časy, $c... Příliš brzy ztratíme všechno... Až Světlo opustí všechny kromě těch, kteří skutečně kráčejí v jeho záři.",
        "d119a708041ab52e5279": "Rád bych si prohlédl vaše zboží.",
        "e13179de508cd8dac75d": "Vycvičte mě."
      },
      "name": "Elaine Carevin",
      "translationMetadata": {
        "fields": {
          "dialogue.33af8b18e1a33d733e87": {
            "origin": "ai",
