    "enUS": {
      "dialogue": {
        "33af8b18e1a33d733e87": "It's dark times that have come, $c... All too soon will we lose everything... When the Light will forsake all but those who truly walk under the Light.",
        "d119a708041ab52e5279": "I want to browse your goods.",
        "e13179de508cd8dac75d": "Train me."
      },
      "name": "Elaine Carevin",
