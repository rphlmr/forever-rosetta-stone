    "ruRU": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Пришли темные времена, $c... Скоро мы все потеряем... Свет покинет всех.",
        "d119a708041ab52e5279": "Я хочу посмотреть ваши товары.",
        "e13179de508cd8dac75d": "Обучите меня."
      },
      "name": "Илана Карвин",
