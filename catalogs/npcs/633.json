    "hrHR": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Došla su mračna vremena, $c... Prebrzo ćemo izgubiti sve... Kad Svjetlost napusti sve osim onih koji istinski koračaju pod njom.",
        "d119a708041ab52e5279": "Želim pogledati vašu robu.",
        "e13179de508cd8dac75d": "Podučite me."
      },
      "name": "Elaine Carevin",
