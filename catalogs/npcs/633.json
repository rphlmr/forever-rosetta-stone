    "esES": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Han llegado tiempos oscuros, $c... Muy pronto lo perderemos todo... Cuando la Luz abandone a todos menos a aquellos que verdaderamente caminan bajo la Luz.",
        "d119a708041ab52e5279": "Quiero ver tus mercancías.",
        "e13179de508cd8dac75d": "Entréname."
      },
      "name": "Elaine Carevin",
