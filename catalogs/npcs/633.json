    "itIT": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Sono venuti tempi bui, $C... Fin troppo presto perderemo tutto... Quando la Luce abbandonerà tutti tranne chi cammina davvero sotto la Luce.",
        "d119a708041ab52e5279": "Vorrei vedere la tua merce.",
        "e13179de508cd8dac75d": "Addestrami."
      },
      "name": "Elaine Carevin",
