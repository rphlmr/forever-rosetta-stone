    },
    "daDK": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Mørke tider er kommet, $c... Alt for snart mister vi alt... Når Lyset svigter alle undtagen dem, der virkelig vandrer i Lyset.",
        "d119a708041ab52e5279": "Jeg vil gerne se dine varer.",
        "e13179de508cd8dac75d": "Træn mig."
      },
      "name": "Elaine Carevin",
      "translationMetadata": {
        "fields": {
          "dialogue.33af8b18e1a33d733e87": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
