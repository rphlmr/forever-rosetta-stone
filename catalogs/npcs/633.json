    "plPL": {
      "dialogue": {
        "33af8b18e1a33d733e87": "Nadeszły mroczne czasy, $c... Zbyt szybko stracimy wszystko... Gdy Światłość opuści wszystkich prócz tych, którzy naprawdę kroczą w jej blasku.",
        "d119a708041ab52e5279": "Chcę przejrzeć twoje towary.",
        "e13179de508cd8dac75d": "Wyszkol mnie."
      },
      "name": "Elaine Carevin",
