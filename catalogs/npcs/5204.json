    "deDE": {
      "dialogue": {
        "446bf2fd55011494c56a": "Wenn wir unseren Platz in dieser Welt finden wollen, dann tun wir dies durch Studium und durch den Willen, unsere schwindenden menschlichen Instinkte zu ignorieren.",
        "e627de7facb4b80da198": "Bildet mich aus.",
        "f48c2bd65e138aaf3404": "Ich möchte Eure Waren ansehen."
      },
