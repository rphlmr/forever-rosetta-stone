    "daDK": {
      "dialogue": {
        "446bf2fd55011494c56a": "Hvis vi skal finde vores plads i denne verden, må det ske gennem studier og viljen til at ignorere vores svindende menneskelige instinkter.",
        "e627de7facb4b80da198": "Træn mig.",
        "f48c2bd65e138aaf3404": "Jeg vil gerne se dine varer."
      },
      "name": "Apoteker Zinge",
      "translationMetadata": {
