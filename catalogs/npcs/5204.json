  "locales": {
    "csCZ": {
      "dialogue": {
        "446bf2fd55011494c56a": "Máme-li si najít své místo v tomto světě, dokážeme to studiem a vůlí potlačit naše slábnoucí lidské instinkty.",
        "e627de7facb4b80da198": "Vycvičte mě.",
        "f48c2bd65e138aaf3404": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Lékárnice Zinge",
      "translationMetadata": {
