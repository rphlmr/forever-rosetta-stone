    "enUS": {
      "dialogue": {
        "5f279d4467ea0b50204c": "Train me.",
        "6f03e240bb808ae4bd2a": "You are unfit to train with me, stranger. Spend some time with my assistant Jhag over there. ",
        "747caa5f4be39c00b395": "Your skills are out of my league, stranger.Talk to Hgarth at the Sun Rock Retreat in the Stonetalon Mountains. He will provide you with more knowledge than I can. ",
        "7f353dd5de26e7fce193": "Well done! You have that spark in your eye... I know it well, it's the same spark I had when I was but a pup! Now, let's see if I can't teach you something.",
        "98d877b385a5f483014c": "You may have what it takes. Let's find out!",
        "f1cafc46ae32d98f8a91": "Some adventurers think enchanting doesn't work. I find that when I challenge them to battle they change their tune!"
      },
      "name": "Godan",
      "subName": "Expert Enchanter",
