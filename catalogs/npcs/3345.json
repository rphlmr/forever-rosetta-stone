  "locales": {
    "csCZ": {
      "dialogue": {
        "5f279d4467ea0b50204c": "Vycvičte mě.",
        "6f03e240bb808ae4bd2a": "Nejsi způsobilý ke cvičení se mnou, cizinče. Věnuj se zatím mému pomocníkovi Jhagovi. ",
        "747caa5f4be39c00b395": "Tvé schopnosti přesahují mé možnosti, cizinče. Promluv si s Hgarthem v Sun Rock Retreat ve Stonetalon Mountains. Naučí tě víc než já. ",
        "7f353dd5de26e7fce193": "Výborně! Máš v očích jiskru... Tu dobře znám, měl jsem ji jako štěně také! Podíváme se, co tě mohu naučit.",
        "98d877b385a5f483014c": "Možná na to máš. Zjistíme to!",
        "f1cafc46ae32d98f8a91": "Někteří dobrodruzi si myslí, že očarování nefunguje. Když je vyzvu na souboj, rychle změní názor!"
      },
      "name": "Godan",
      "translationMetadata": {
        "fields": {
          "dialogue.5f279d4467ea0b50204c": {
