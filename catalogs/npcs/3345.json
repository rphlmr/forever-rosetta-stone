    "daDK": {
      "dialogue": {
        "5f279d4467ea0b50204c": "Træn mig.",
        "6f03e240bb808ae4bd2a": "Du er ikke klar til at træne hos mig, fremmede. Tal med min assistent Jhag derovre. ",
        "747caa5f4be39c00b395": "Dine evner overgår mine, fremmede. Tal med Hgarth i Sun Rock Retreat i Stonetalon Mountains. Han kan lære dig mere end jeg. ",
        "7f353dd5de26e7fce193": "Godt klaret! Du har en gnist i øjet... Den kender jeg, jeg havde den selv som unge! Lad os se, hvad jeg kan lære dig.",
        "98d877b385a5f483014c": "Måske har du det, der skal til. Lad os finde ud af det!",
        "f1cafc46ae32d98f8a91": "Nogle eventyrere tror ikke, at fortryllelse virker. Når jeg udfordrer dem til kamp, skifter de hurtigt mening!"
      },
      "name": "Godan",
      "translationMetadata": {
        "fields": {
