    "svSE": {
      "dialogue": {
        "2e73f0b7682a2058871e": "Av skäl jag inte förstår har äldste Thunderhorn begett sig till Slithering Scar i Un'Goro-kratern.",
        "48afda61a5bc18549f46": "Äldste Ragetotem tillbringar sina dagar i Väktarnas dal i Tanarisöknen.",
        "5f64bd90979d57237df7": "Äldste Dreamseer bor i Gadgetzan i Tanarisöknen.",
        "9376bdcc5056230033ce": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "c5fab311e7b05d806f60": "Res till Freewind Post i Thousand Needles så hittar du äldste Skyseer."
      },
      "name": "Äldste Wildmane",
