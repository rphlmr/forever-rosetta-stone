    "enUS": {
      "dialogue": {
        "2e73f0b7682a2058871e": "For reasons I cannot understand, Elder Thunderhorn has gone to the Slithering Scar in Un'Goro Crater.",
        "48afda61a5bc18549f46": "Elder Ragetotem spends her days at the Valley of the Watchers in Tanaris Desert.",
        "5f64bd90979d57237df7": "Elder Dreamseer resides in Gadgetzan in Tanaris Desert.",
        "9376bdcc5056230033ce": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "c5fab311e7b05d806f60": "Go to the Freewind Post in Thousand Needles and you will find Elder Skyseer."
      },
      "name": "Elder Wildmane",
      "translationMetadata": {
        "fields": {
