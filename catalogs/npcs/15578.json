  "locales": {
    "csCZ": {
      "dialogue": {
        "2e73f0b7682a2058871e": "Z důvodů, kterým nerozumím, odešel stařešina Thunderhorn do Slithering Scar v kráteru Un'Goro.",
        "48afda61a5bc18549f46": "Stařešina Ragetotem tráví své dny v Údolí strážců v poušti Tanaris.",
        "5f64bd90979d57237df7": "Stařešina Dreamseer sídlí v Gadgetzanu v poušti Tanaris.",
        "9376bdcc5056230033ce": "Kdysi dávno jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "c5fab311e7b05d806f60": "Vydej se do Freewind Post v Thousand Needles a najdeš stařešinu Skyseera."
      },
      "name": "Starší Wildmane",
      "translationMetadata": {
