    "daDK": {
      "dialogue": {
        "2e73f0b7682a2058871e": "Af grunde, jeg ikke forstår, er ældste Thunderhorn draget til Slithering Scar i Un'Goro-krateret.",
        "48afda61a5bc18549f46": "Ældste Ragetotem tilbringer sine dage i Vogternes Dal i Tanarisørkenen.",
        "5f64bd90979d57237df7": "Ældste Dreamseer bor i Gadgetzan i Tanarisørkenen.",
        "9376bdcc5056230033ce": "For længe siden levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "c5fab311e7b05d806f60": "Tag til Freewind Post i Thousand Needles, så finder du ældste Skyseer."
      },
      "name": "Ældste Wildmane",
      "translationMetadata": {
