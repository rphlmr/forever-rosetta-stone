    "hrHR": {
      "dialogue": {
        "2e73f0b7682a2058871e": "Iz meni nepoznatih razloga starješina Thunderhorn otišao je u Slithering Scar u krateru Un'Goro.",
        "48afda61a5bc18549f46": "Starješina Ragetotem provodi dane u Dolini čuvara u pustinji Tanaris.",
        "5f64bd90979d57237df7": "Starješina Dreamseer živi u Gadgetzanu u pustinji Tanaris.",
        "9376bdcc5056230033ce": "U davna vremena živjeli smo za lov. Lovili smo za slavu, za čast...$B$BZar je sada toliko drukčije?",
        "c5fab311e7b05d806f60": "Pođi u Freewind Post u Thousand Needlesu i pronaći ćeš starješinu Skyseera."
      },
      "name": "Starješina Wildmane",
