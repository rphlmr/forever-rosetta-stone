    "trTR": {
      "dialogue": {
        "2e73f0b7682a2058871e": "Anlayamadığım nedenlerle Yaşlı Thunderhorn, Un'Goro Krateri'ndeki Slithering Scar'a gitti.",
        "48afda61a5bc18549f46": "Yaşlı Ragetotem günlerini Tanaris Çölü'ndeki Gözcüler Vadisi'nde geçiriyor.",
        "5f64bd90979d57237df7": "Yaşlı Dreamseer, Tanaris Çölü'ndeki Gadgetzan'da yaşıyor.",
        "9376bdcc5056230033ce": "Çok eski günlerde av için yaşardık. Şan için, onur için avlanırdık...$B$BŞimdi çok mu farklı?",
        "c5fab311e7b05d806f60": "Thousand Needles'taki Freewind Post'a git, Yaşlı Skyseer'ı orada bulacaksın."
      },
      "name": "Ulu Wildmane",
