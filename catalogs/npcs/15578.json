    "plPL": {
      "dialogue": {
        "2e73f0b7682a2058871e": "Z powodów, których nie rozumiem, starszy Thunderhorn udał się do Slithering Scar w kraterze Un'Goro.",
        "48afda61a5bc18549f46": "Starsza Ragetotem spędza dni w Dolinie Strażników na pustyni Tanaris.",
        "5f64bd90979d57237df7": "Starszy Dreamseer mieszka w Gadgetzan na pustyni Tanaris.",
        "9376bdcc5056230033ce": "Dawno temu żyliśmy dla łowów. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest tak inaczej?",
        "c5fab311e7b05d806f60": "Udaj się do Freewind Post w Thousand Needles, a znajdziesz starszego Skyseera."
      },
      "name": "Starszy Wildmane",
