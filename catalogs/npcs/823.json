    "trTR": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Beni eğit.",
        "937207827dba6ae6d8ef": "Merhaba, $c. Normalde devriye gezip Stormwind halkını korurdum, ama muhafızların çoğu başka diyarlarda savaşıyor. Ben de burada vekil tayin edilmiş halde ödüller dağıtıyorum; oysa devriyede olmayı tercih ederdim...",
        "d7e1aedc89d7fa4f19a7": "Mallarına bakmak istiyorum."
      },
      "name": "Şerif Yardımcısı Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
