    "svSE": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Träna mig.",
        "937207827dba6ae6d8ef": "Hej där, $c. Vanligtvis skulle jag patrullera och se efter folket i Stormwind, men många av stadens vakter strider i andra länder. Så här står jag, förordnad att erbjuda belöningar när jag hellre skulle patrullera...",
        "d7e1aedc89d7fa4f19a7": "Jag vill se dina varor."
      },
      "name": "Vicefogde Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
