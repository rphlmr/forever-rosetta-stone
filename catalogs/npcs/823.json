    },
    "plPL": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Wyszkol mnie.",
        "937207827dba6ae6d8ef": "Witaj, $c. Zwykle patrolowałbym miasto i dbał o mieszkańców Stormwind, ale wielu strażników walczy w innych krainach. Więc jestem tutaj, mianowany zastępcą i oferuję nagrody, choć wolałbym być na patrolu...",
        "d7e1aedc89d7fa4f19a7": "Chcę przejrzeć twoje towary."
      },
      "name": "Zastępca Willem",
      "translationMetadata": {
        "fields": {
