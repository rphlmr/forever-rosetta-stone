    "hrHR": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Podučite me.",
        "937207827dba6ae6d8ef": "Pozdrav, $c. Obično bih patrolirao i pazio na stanovnike Stormwinda, ali mnogi stražari bore se u drugim zemljama. Zato sam ovdje, imenovan zamjenikom i nudim nagrade, iako bih radije bio u ophodnji...",
        "d7e1aedc89d7fa4f19a7": "Želim pogledati vašu robu."
      },
      "name": "Zamjenik Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
