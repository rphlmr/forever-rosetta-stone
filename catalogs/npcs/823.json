    "ptBR": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Treine-me.",
        "937207827dba6ae6d8ef": "Olá, $c. Normalmente eu estaria patrulhando e cuidando do povo de Ventobravo, mas muitos guardas da cidade estão lutando em outras terras. Então aqui estou, nomeado ajudante e oferecendo recompensas, quando preferia estar patrulhando...",
        "d7e1aedc89d7fa4f19a7": "Quero ver suas mercadorias."
      },
      "name": "Cabo Vilém",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
            "origin": "ai",
