    "itIT": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Addestrami.",
        "937207827dba6ae6d8ef": "Salve, $C. Di solito sarei fuori di ronda a badare alla gente di Stormwind, ma molte guardie di Stormwind stanno combattendo in altre terre. E così eccomi qui, nominato vice, a offrire taglie quando preferirei essere di pattuglia...",
        "d7e1aedc89d7fa4f19a7": "Vorrei vedere la tua merce."
      },
      "name": "Vice Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
            "origin": "ai",
