      }
    },
    "daDK": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Træn mig.",
        "937207827dba6ae6d8ef": "Goddag, $c. Normalt ville jeg patruljere og passe på Stormwinds borgere, men mange af byens vagter kæmper i andre lande. Så her står jeg, udpeget til at udlove dusører, selv om jeg hellere ville være på patrulje...",
        "d7e1aedc89d7fa4f19a7": "Jeg vil gerne se dine varer."
      },
      "name": "Stedfortræder Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
