  "locales": {
    "csCZ": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Vycvičte mě.",
        "937207827dba6ae6d8ef": "Zdravím tě, $c. Normálně bych obcházel město a staral se o obyvatele Stormwindu, ale mnoho strážných bojuje v jiných zemích. A tak jsem tady, pověřený vypisováním odměn, i když bych raději hlídkoval...",
        "d7e1aedc89d7fa4f19a7": "Chci si prohlédnout vaše zboží."
      },
      "name": "Zástupce Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
