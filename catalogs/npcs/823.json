    "enUS": {
      "dialogue": {
        "431eb1476ee8b8c328d0": "Train me.",
        "937207827dba6ae6d8ef": "Hello there, $c.  Normally I'd be out on the beat looking after the folk of Stormwind, but a lot of the Stormwind guards are fighting in other lands.  So here I am, deputized and offering bounties when I'd rather be on patrol...",
        "d7e1aedc89d7fa4f19a7": "I want to browse your goods."
      },
      "name": "Deputy Willem",
      "translationMetadata": {
        "fields": {
          "dialogue.431eb1476ee8b8c328d0": {
            "origin": "community",
            "source": "VMaNGOS",
            "sourceLocale": "enUS"
          },
