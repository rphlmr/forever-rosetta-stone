    "enUS": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Elder Bronzebeard can be found in the ancestral home of the Bronzebeards, Ironforge.",
        "3248cf81b62128df8c9e": "Elder Ironband lives in Blackchar Cave in Searing Gorge.",
        "a1f819841c05bce79553": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "e863980f8f423437e9d4": "Elder Silvervein can be found near Thelsamar in Loch Modan."
      },
      "name": "Elder Goldwell",
