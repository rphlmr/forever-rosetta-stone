    "trTR": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Yaşlı Bronzebeard’ı Bronzebeardların ata yurdu Ironforge’da bulabilirsin.",
        "3248cf81b62128df8c9e": "Yaşlı Ironband, Searing Gorge’daki Blackchar Mağarası’nda yaşar.",
        "a1f819841c05bce79553": "Şimdi yılın yeni olduğu, ayın parlak parladığı zaman.$B$BBu bizim zamanımız... kadimler uyandığında.",
        "e863980f8f423437e9d4": "Yaşlı Silvervein’ı Loch Modan’daki Thelsamar yakınlarında bulabilirsin."
      },
      "name": "Ulu Goldwell",
