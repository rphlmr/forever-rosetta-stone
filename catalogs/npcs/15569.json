    "svSE": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Äldste Bronzebeard finns i Bronzebeardernas förfäders hem, Ironforge.",
        "3248cf81b62128df8c9e": "Äldste Ironband bor i Blackchar Cave i Searing Gorge.",
        "a1f819841c05bce79553": "Nu är året nytt och månen lyser klart.$B$BDet är vår tid... när de uråldriga vaknar.",
        "e863980f8f423437e9d4": "Äldste Silvervein finns nära Thelsamar i Loch Modan."
      },
      "name": "Äldste Goldwell",
