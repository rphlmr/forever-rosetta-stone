  "locales": {
    "csCZ": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Staršího Bronzebearda najdeš v pradávném domově rodu Bronzebeardů, v Ironforge.",
        "3248cf81b62128df8c9e": "Starší Ironband žije v jeskyni Blackchar v Searing Gorge.",
        "a1f819841c05bce79553": "Nastal čas nového roku, kdy měsíc jasně září.$B$BJe to náš čas... čas, kdy se probouzejí prastaří.",
        "e863980f8f423437e9d4": "Staršího Silverveina najdeš poblíž Thelsamaru v Loch Modan."
      },
      "name": "Starší Goldwell",
      "translationMetadata": {
