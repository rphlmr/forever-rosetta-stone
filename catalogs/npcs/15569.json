    "plPL": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Starszego Bronzebearda znajdziesz w Ironforge, ojczyźnie przodków rodu Bronzebeard.",
        "3248cf81b62128df8c9e": "Starszy Ironband mieszka w jaskini Blackchar w Searing Gorge.",
        "a1f819841c05bce79553": "Nadszedł czas nowego roku, gdy księżyc jasno świeci.$B$BTo nasz czas... gdy budzą się pradawni.",
        "e863980f8f423437e9d4": "Starszego Silverveina można znaleźć niedaleko Thelsamar w Loch Modan."
      },
      "name": "Starszy Goldwell",
