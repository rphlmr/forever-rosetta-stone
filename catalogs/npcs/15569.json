    "deDE": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Urahne Bronzebeard kann im Zuhause der Ahnen der Bronzebeards angetroffen werden, also in Ironforge.",
        "3248cf81b62128df8c9e": "Urahne Ironband lebt in der Blackcharhöhle in der sengenden Schlucht.",
        "a1f819841c05bce79553": "Die Zeit ist gekommen, nun da das neue Jahr angebrochen ist und der Mond hell scheint.\n\nEs ist nun unsere Zeit... wenn die Alten erwachen.",
        "e863980f8f423437e9d4": "Urahne Silvervein ist in der Nähe von Thelsamar, in Loch Modan."
      },
      "name": "Urahne Goldwell",
      "translationMetadata": {
