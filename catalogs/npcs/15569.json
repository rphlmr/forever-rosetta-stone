    "ltLT": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Senolį Bronzebeard rasi protėvių Bronzebeardų namuose, Ironforge mieste.",
        "3248cf81b62128df8c9e": "Senolis Ironband gyvena Blackchar Cave, Searing Gorge krašte.",
        "a1f819841c05bce79553": "Dabar metas, kai metai dar nauji, o mėnulis ryškiai šviečia.$B$BTai mūsų metas... kai senovės dvasios pabunda.",
        "e863980f8f423437e9d4": "Senolį Silvervein rasi netoli Thelsamar, Loch Modan krašte."
      },
      "name": "Senolis Goldwell",
