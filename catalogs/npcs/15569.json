    "daDK": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Ældste Bronzebeard findes i Bronzebeardernes fædrene hjem, Ironforge.",
        "3248cf81b62128df8c9e": "Ældste Ironband bor i Blackchar Cave i Searing Gorge.",
        "a1f819841c05bce79553": "Nu er året nyt, og månen skinner klart.$B$BDet er vores tid... når de ældgamle vågner.",
        "e863980f8f423437e9d4": "Ældste Silvervein kan findes nær Thelsamar i Loch Modan."
      },
      "name": "Ældste Goldwell",
