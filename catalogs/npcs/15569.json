    "hrHR": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Starješinu Bronzebearda možeš pronaći u pradomovini Bronzebeardovih, Ironforgeu.",
        "3248cf81b62128df8c9e": "Starješina Ironband živi u špilji Blackchar u Searing Gorgeu.",
        "a1f819841c05bce79553": "Sada je vrijeme kad je godina nova, a mjesec sjajno sja.$B$BTo je naše vrijeme... kad se drevni bude.",
        "e863980f8f423437e9d4": "Starješinu Silverveina možeš pronaći blizu Thelsamara u Loch Modanu."
      },
      "name": "Starješina Goldwell",
