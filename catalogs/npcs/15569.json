    "esES": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "Puedes encontrar al ancestro Barbabronce en Forjaz, hogar ancestral de los Barbabronce.",
        "3248cf81b62128df8c9e": "El ancestro Vetaferro vive en la Cueva Tizonegro en La Garganta de Fuego.",
        "a1f819841c05bce79553": "Ha llegado la hora de un nuevo año y la luna brilla con fuerza.\n\nHa llegado la hora... de que los ancestros se despierten.",
        "e863980f8f423437e9d4": "El ancestro Venaplata se encuentra cerca de Thelsamar en Loch Modan."
      },
      "name": "Ancestro Pozo de Oro",
