    "ptBR": {
      "dialogue": {
        "0e45ce4caf066ce0a2ec": "O ancião Barbabronze se encontra no lar ancestral dos Barbabronze, em Altaforja.",
        "3248cf81b62128df8c9e": "O ancião Bandaferro mora na Caverna Calcinar, em Garganta Abrasadora.",
        "a1f819841c05bce79553": "Agora é a hora em que o ano ainda é jovem e a lua brilha forte.\n\nÉ a nossa hora... a hora em que despertam os ancestrais.",
        "e863980f8f423437e9d4": "O ancião Venaprata se encontra perto de Thelsamar, em Loch Modan."
      },
      "name": "Ancião Poçodouro",
