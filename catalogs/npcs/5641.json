    "enUS": {
      "dialogue": {
        "3300d0dfd95ee9337866": "The main threat Thrall wishes dealt with is the Burning Blade--members of the Horde that have given their loyalty to the demons. They seek to practice their dark magic and care little for Thrall's vision of the Horde's future here in Kalimdor.",
        "8291a22dad4ab5160f63": "I want to browse your goods.",
        "fbdd2b915cf0ca05f845": "Train me."
      },
      "name": "Takata Steelblade",
      "translationMetadata": {
