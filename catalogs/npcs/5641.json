  "locales": {
    "csCZ": {
      "dialogue": {
        "3300d0dfd95ee9337866": "Hlavní hrozbou, kterou si Thrall přeje odstranit, je Hořící čepel: členové Hordy, kteří se zapřísáhli démonům. Snaží se provozovat svou temnou magii a na Thrallově vizi budoucnosti Hordy v Kalimdoru jim příliš nezáleží.",
        "8291a22dad4ab5160f63": "Rád bych si prohlédl vaše zboží.",
        "fbdd2b915cf0ca05f845": "Vycvičte mě."
      },
      "name": "Takata Steelblade",
      "translationMetadata": {
        "fields": {
