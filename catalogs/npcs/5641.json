    "plPL": {
      "dialogue": {
        "3300d0dfd95ee9337866": "Głównym zagrożeniem, z którym Thrall chce się rozprawić, jest Płonące Ostrze: członkowie Hordy, którzy przysięgli wierność demonom. Pragną uprawiać mroczną magię i niewiele obchodzi ich wizja przyszłości Hordy w Kalimdorze, którą roztacza Thrall.",
        "8291a22dad4ab5160f63": "Chcę przejrzeć twoje towary.",
        "fbdd2b915cf0ca05f845": "Wyszkol mnie."
      },
      "name": "Takata Steelblade",
