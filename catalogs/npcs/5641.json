    "hrHR": {
      "dialogue": {
        "3300d0dfd95ee9337866": "Glavna prijetnja koju Thrall želi ukloniti jest Burning Blade: pripadnici Horde koji su odanost poklonili demonima. Žele prakticirati svoju mračnu magiju i malo mare za Thrallovu viziju budućnosti Horde ovdje u Kalimdoru.",
        "8291a22dad4ab5160f63": "Želim pogledati vašu robu.",
        "fbdd2b915cf0ca05f845": "Podučite me."
      },
      "name": "Takata Steelblade",
