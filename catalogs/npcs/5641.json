    "ptBR": {
      "dialogue": {
        "3300d0dfd95ee9337866": "A principal ameaça que Thrall quer eliminar é a Lâmina Ardente: membros da Horda que juraram lealdade aos demônios. Eles querem praticar sua magia sombria e pouco se importam com a visão de Thrall para o futuro da Horda em Kalimdor.",
        "8291a22dad4ab5160f63": "Quero ver suas mercadorias.",
        "fbdd2b915cf0ca05f845": "Treine-me."
      },
      "name": "Takta Laminaço",
