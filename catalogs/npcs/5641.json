    "daDK": {
      "dialogue": {
        "3300d0dfd95ee9337866": "Den største trussel, Thrall ønsker fjernet, er Burning Blade: medlemmer af Horden, som har svoret dæmonerne troskab. De vil udøve deres mørke magi og bekymrer sig ikke om Thralls vision for Hordens fremtid her i Kalimdor.",
        "8291a22dad4ab5160f63": "Jeg vil gerne se dine varer.",
        "fbdd2b915cf0ca05f845": "Træn mig."
      },
      "name": "Takata Steelblade",
      "translationMetadata": {
        "fields": {
