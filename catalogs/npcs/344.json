    "enUS": {
      "dialogue": {
        "32e83b672eb822b419e3": "I want to browse your goods.",
        "5ab325b06484ac69619f": "Who is this $c who goes before the Court of Lakshire in the Kingdom of Stormwind?  State your business within this township, $R.  The orc threat to the Kingdom is far too great to squander time in idle conversation.",
        "99eebe321743b061d3d1": "Train me."
      },
      "name": "Magistrate Solomon",
