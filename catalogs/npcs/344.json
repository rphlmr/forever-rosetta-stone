    "ruRU": {
      "dialogue": {
        "32e83b672eb822b419e3": "Я хочу посмотреть ваши товары.",
        "5ab325b06484ac69619f": "Красногорье погружено в хаос!",
        "99eebe321743b061d3d1": "Обучите меня."
      },
