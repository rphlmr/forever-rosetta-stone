    "hrHR": {
      "dialogue": {
        "32e83b672eb822b419e3": "Želim pogledati vašu robu.",
        "5ab325b06484ac69619f": "Tko je ovaj $c koji stupa pred sud Lakeshirea u kraljevstvu Stormwinda? Reci što te dovodi u naš grad, $R. Prijetnja orka kraljevstvu prevelika je da bismo tratili vrijeme na isprazne razgovore.",
        "99eebe321743b061d3d1": "Podučite me."
      },
      "name": "Sudac Solomon",
