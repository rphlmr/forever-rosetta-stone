  "locales": {
    "csCZ": {
      "dialogue": {
        "32e83b672eb822b419e3": "Rád bych si prohlédl vaše zboží.",
        "5ab325b06484ac69619f": "Kdo je tento $c, jenž předstupuje před soud v Lakeshire v království Stormwind? Udej, co tě přivádí do tohoto města, $R. Hrozba orků pro království je příliš velká na to, abychom ztráceli čas planými řečmi.",
        "99eebe321743b061d3d1": "Vycvičte mě."
      },
      "name": "Rychtář Solomon",
      "translationMetadata": {
        "fields": {
          "dialogue.32e83b672eb822b419e3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
