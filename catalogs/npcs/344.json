    "plPL": {
      "dialogue": {
        "32e83b672eb822b419e3": "Chcę przejrzeć twoje towary.",
        "5ab325b06484ac69619f": "Kim jest ten $c, który staje przed sądem Lakeshire w królestwie Stormwindu? Wyjaw, co cię sprowadza do tego miasta, $R. Zagrożenie ze strony orków jest zbyt wielkie, by tracić czas na czcze rozmowy.",
        "99eebe321743b061d3d1": "Wyszkol mnie."
      },
