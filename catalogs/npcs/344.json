      }
    },
    "daDK": {
      "dialogue": {
        "32e83b672eb822b419e3": "Jeg vil gerne se dine varer.",
        "5ab325b06484ac69619f": "Hvem er denne $c, der træder frem for retten i Lakeshire i kongeriget Stormwind? Fortæl, hvad dit ærinde er i denne by, $R. Orkernes trussel mod kongeriget er alt for stor til, at vi kan spilde tiden på tom snak.",
        "99eebe321743b061d3d1": "Træn mig."
      },
      "name": "Magistrat Solomon",
      "translationMetadata": {
        "fields": {
          "dialogue.32e83b672eb822b419e3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
