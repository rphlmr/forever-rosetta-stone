    "enUS": {
      "dialogue": {
        "6c861bfca09ab4c78065": "I want to browse your goods.",
        "8c96219cb3bb245e3283": "Many tests await a paladin of the Light, $N. Be assured, our paths will cross many times in the future if you remain passionate and hold to those virtues that we praise.",
        "e21936be9cd6f8eb4cd4": "Train me."
      },
      "name": "Tiza Battleforge",
