    "svSE": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Jag vill se dina varor.",
        "8c96219cb3bb245e3283": "Många prövningar väntar en ljusets paladin, $N. Var säker på att våra vägar kommer att korsas många gånger i framtiden om du bevarar din glöd och håller fast vid de dygder vi hyllar.",
        "e21936be9cd6f8eb4cd4": "Träna mig."
      },
