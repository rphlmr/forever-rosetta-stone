    "plPL": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Chcę przejrzeć twoje towary.",
        "8c96219cb3bb245e3283": "Paladyna Światłości czeka wiele prób, $N. Zapewniam cię, że nasze drogi jeszcze nieraz się skrzyżują, jeśli zachowasz zapał i pozostaniesz wierny cnotom, które cenimy.",
        "e21936be9cd6f8eb4cd4": "Wyszkol mnie."
      },
      "name": "Tiza Battleforge",
