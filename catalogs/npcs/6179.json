    "ptBR": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Quero ver suas mercadorias.",
        "8c96219cb3bb245e3283": "Muitas provações aguardam um paladino da Luz, $N. Saiba que nossos caminhos se cruzarão muitas vezes no futuro se você mantiver sua paixão e seguir as virtudes que prezamos.",
        "e21936be9cd6f8eb4cd4": "Treine-me."
      },
