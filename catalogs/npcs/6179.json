    "hrHR": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Želim pogledati vašu robu.",
        "8c96219cb3bb245e3283": "Paladina Svjetlosti čekaju mnoge kušnje, $N. Budi siguran da će nam se putevi još mnogo puta ukrstiti ako ostaneš predan i držiš se vrlina koje cijenimo.",
        "e21936be9cd6f8eb4cd4": "Podučite me."
      },
      "name": "Tiza Battleforge",
