    "deDE": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Ich möchte Eure Waren ansehen.",
        "8c96219cb3bb245e3283": "Viele Prüfungen warten auf einen Paladin des Lichts, $N. Sei versichert, dass sich unsere Wege in der Zukunft noch viele Male kreuzen werden, wenn du leidenschaftlich bleibst und an den Tugenden festhältst, die wir preisen.",
        "e21936be9cd6f8eb4cd4": "Bildet mich aus."
      },
      "name": "Tiza Battleforge",
      "translationMetadata": {
        "fields": {
