    "trTR": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Mallarına bakmak istiyorum.",
        "8c96219cb3bb245e3283": "Işık'ın bir paladinini pek çok sınav bekler, $N. Tutkunu korur ve yücelttiğimiz erdemlere bağlı kalırsan yollarımızın gelecekte pek çok kez kesişeceğinden emin olabilirsin.",
        "e21936be9cd6f8eb4cd4": "Beni eğit."
      },
      "name": "Tiza Battleforge",
