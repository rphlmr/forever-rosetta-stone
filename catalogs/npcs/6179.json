    "daDK": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Jeg vil gerne se dine varer.",
        "8c96219cb3bb245e3283": "Mange prøvelser venter en lysets paladin, $N. Vær sikker på, at vores veje vil krydses mange gange i fremtiden, hvis du bevarer din iver og holder fast ved de dyder, vi hylder.",
        "e21936be9cd6f8eb4cd4": "Træn mig."
      },
      "name": "Tiza Battleforge",
      "translationMetadata": {
        "fields": {
