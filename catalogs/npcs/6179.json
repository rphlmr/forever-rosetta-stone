    "ltLT": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Noriu apžiūrėti tavo prekes.",
        "8c96219cb3bb245e3283": "Šviesos paladino laukia daugybė išbandymų, $N. Būk tikras, kad mūsų keliai ateityje dar ne kartą susikirs, jei išsaugosi savo užsidegimą ir laikysiesi mūsų aukštinamų dorybių.",
        "e21936be9cd6f8eb4cd4": "Pamokyk mane."
      },
      "name": "Tiza Battleforge",
