  "locales": {
    "csCZ": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Chci si prohlédnout vaše zboží.",
        "8c96219cb3bb245e3283": "Paladina Světla čeká mnoho zkoušek, $N. Buď si jist, že se naše cesty v budoucnu mnohokrát protnou, pokud zůstaneš zapálený a věrný ctnostem, které ctíme.",
        "e21936be9cd6f8eb4cd4": "Vycvičte mě."
      },
      "name": "Tiza Battleforge",
      "translationMetadata": {
        "fields": {
          "dialogue.6c861bfca09ab4c78065": {
            "origin": "ai",
