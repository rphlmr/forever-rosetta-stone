    "itIT": {
      "dialogue": {
        "6c861bfca09ab4c78065": "Vorrei vedere la tua merce.",
        "8c96219cb3bb245e3283": "Molte prove attendono un paladino della Luce, $N. Sappi che le nostre strade si incroceranno molte volte in futuro, se manterrai il tuo fervore e resterai fedele alle virtù che onoriamo.",
        "e21936be9cd6f8eb4cd4": "Addestrami."
      },
      "name": "Tiza Battleforge",
