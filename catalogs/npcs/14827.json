  "locales": {
    "csCZ": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Jestli se snažíš být přátelský, šetři dechem. Ještě lépe, přestaň dýchat úplně.",
        "c84d6cdff3ab98f18de7": "Kdo si zahrává se Silasem, zahrává si se mnou. Hezký den.",
        "e40a921ae6df91c61313": "Tohle není atrakce, hlupáku. Zmiz.",
        "f38a8d3ab317dc600c14": "Běž dál, venkovane.",
        "fee3f85513595eabdfe8": "Jestli to nebylo jasné, nejsem tu kvůli vztahům se zákazníky."
      },
      "name": "Burth",
      "translationMetadata": {
        "fields": {
