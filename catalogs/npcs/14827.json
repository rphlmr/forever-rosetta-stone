    "ptBR": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Se está tentando ser amigável, poupe o fôlego. Melhor ainda, pare de respirar de uma vez.",
        "c84d6cdff3ab98f18de7": "Mexeu com Silas, mexeu comigo. Tenha um bom dia.",
        "e40a921ae6df91c61313": "Isto não é um brinquedo, caipira. Cai fora.",
        "f38a8d3ab317dc600c14": "Circulando, matuto.",
        "fee3f85513595eabdfe8": "Caso não tenha ficado óbvio, não estou aqui para atender clientes."
      },
      "name": "Burt",
