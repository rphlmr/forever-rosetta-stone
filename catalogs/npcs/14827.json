    "daDK": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Hvis du prøver at være venlig, så spar på vejret. Endnu bedre, hold helt op med at trække vejret.",
        "c84d6cdff3ab98f18de7": "Rører du Silas, rører du mig. Hav en god dag.",
        "e40a921ae6df91c61313": "Det her er ikke en forlystelse, klovn. Forsvind.",
        "f38a8d3ab317dc600c14": "Kom videre, bonderøv.",
        "fee3f85513595eabdfe8": "Hvis det ikke var indlysende, er jeg ikke her for at pleje kunderelationer."
      },
      "name": "Burth",
      "translationMetadata": {
        "fields": {
