    "plPL": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Jeśli próbujesz być miły, oszczędź oddech. A jeszcze lepiej przestań oddychać.",
        "c84d6cdff3ab98f18de7": "Kto zadziera z Silasem, zadziera ze mną. Miłego dnia.",
        "e40a921ae6df91c61313": "To nie przejażdżka, głupku. Zmykaj.",
        "f38a8d3ab317dc600c14": "Idź dalej, wieśniaku.",
        "fee3f85513595eabdfe8": "Gdyby nie było to oczywiste, nie jestem tu od obsługi klientów."
      },
      "name": "Burth",
      "translationMetadata": {
