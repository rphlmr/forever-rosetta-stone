    "trTR": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Dostça davranmaya çalışıyorsan nefesini boşa harcama. Hatta nefes almayı tamamen bırak.",
        "c84d6cdff3ab98f18de7": "Silas’la uğraşırsan benimle uğraşırsın. İyi günler.",
        "e40a921ae6df91c61313": "Bu bir eğlence treni değil, budala. Defol.",
        "f38a8d3ab317dc600c14": "Yürü git, köylü.",
        "fee3f85513595eabdfe8": "Belli olmadıysa söyleyeyim, burada müşteri ilişkileri için bulunmuyorum."
      },
      "name": "Burth",
