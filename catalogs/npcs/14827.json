    "ltLT": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Jei bandai būti draugiškas, netuščiažodžiauk. O dar geriau – visai nustok kvėpuoti.",
        "c84d6cdff3ab98f18de7": "Jei kabinėjiesi prie Silas, kabinėjiesi ir prie manęs. Geros dienos.",
        "e40a921ae6df91c61313": "Čia ne atrakcionas, naivuoli. Nešdinkis.",
        "f38a8d3ab317dc600c14": "Eik sau, kaimieti.",
        "fee3f85513595eabdfe8": "Jei dar nesupratai, aš čia ne klientų aptarnauti."
      },
      "name": "Burth",
      "translationMetadata": {
        "fields": {
