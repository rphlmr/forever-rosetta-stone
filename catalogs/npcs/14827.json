    "esMX": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Si estás intentando ganarme con tu simpatía, no gastes saliva. O mejor, trágatela toda a ver si te ahogas...",
        "c84d6cdff3ab98f18de7": "Si te metes con Silas, te metes conmigo. Que tengas un buen día.",
        "e40a921ae6df91c61313": "Esto no es una atracción, paleto. Lárgate.",
        "f38a8d3ab317dc600c14": "Vete de aquí, palurdo.",
        "fee3f85513595eabdfe8": "Por si no ha quedado claro, no estoy aquí de relaciones públicas."
      },
      "name": "Burth",
