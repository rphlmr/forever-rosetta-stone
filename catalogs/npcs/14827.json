    "hrHR": {
      "dialogue": {
        "5037e66d896c9504dfc9": "Ako pokušavaš biti prijateljski nastrojen, štedi dah. Još bolje, prestani disati.",
        "c84d6cdff3ab98f18de7": "Tko dira Silasa, dira i mene. Ugodan dan.",
        "e40a921ae6df91c61313": "Ovo nije vožnja, budalo. Gubi se.",
        "f38a8d3ab317dc600c14": "Produži, seljačino.",
        "fee3f85513595eabdfe8": "Ako nije očito, nisam ovdje radi odnosa s mušterijama."
      },
      "name": "Burth",
