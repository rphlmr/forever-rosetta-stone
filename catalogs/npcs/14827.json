    "enUS": {
      "dialogue": {
        "5037e66d896c9504dfc9": "If you're trying to be friendly, save your breath.  Better yet, just stop breathing all together.",
        "c84d6cdff3ab98f18de7": "You mess with Silas, you mess with me.  Have a nice day.",
        "e40a921ae6df91c61313": "This ain't a ride, clem.  Beat it.",
        "f38a8d3ab317dc600c14": "Move along, rube.",
        "fee3f85513595eabdfe8": "In case it wasn't obvious, I'm not here for customer relations."
      },
      "name": "Burth",
      "translationMetadata": {
        "fields": {
