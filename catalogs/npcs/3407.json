    "trTR": {
      "dialogue": {
        "37251c3ba14828cbd076": "Eğitim almak istiyorum.",
        "b44ac6ec5668c36d4ec7": "Gel, avcının yolunu öğren. Gurur, onur ve gelenek.",
        "beddec026620c542b7cb": "Birçok öğrenciyi yeniden eğitebilmek için sıkı bir çalışmayla daha önce öğrendikleri her şeyi unutturmam gerekti. Sunduğum bu hizmeti gerçekleştirmek her seferinde zorlaşıyor. Bu nedenle her yeniden eğitimde daha pahalıya mal oluyor. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?"
      },
      "name": "Sian'dur",
      "translationMetadata": {
        "fields": {
          "dialogue.37251c3ba14828cbd076": {
