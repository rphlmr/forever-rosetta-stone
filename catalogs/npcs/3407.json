  "locales": {
    "csCZ": {
      "dialogue": {
        "37251c3ba14828cbd076": "Chci trénovat.",
        "b44ac6ec5668c36d4ec7": "Pojď se naučit cestě lovce. Hrdosti, cti a tradici.",
        "beddec026620c542b7cb": "Přísným přeškolením jsem musel mnoho žáků odnaučit všemu, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým opakováním obtížnější, a proto také dražší. Přeješ si, abych tě odnaučil talenty, které sis osvojil?"
      },
      "name": "Sian'dur",
      "translationMetadata": {
        "fields": {
          "dialogue.37251c3ba14828cbd076": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
