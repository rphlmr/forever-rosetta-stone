    "hrHR": {
      "dialogue": {
        "37251c3ba14828cbd076": "Želim trenirati.",
        "b44ac6ec5668c36d4ec7": "Dođi naučiti put lovca. Ponos, čast i tradicija.",
        "beddec026620c542b7cb": "Strogom preobukom morao sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Uslugu koju nudim sve je teže obaviti svaki put, pa je zato i sve skuplja sa svakom preobukom. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Sian'dur",
      "translationMetadata": {
