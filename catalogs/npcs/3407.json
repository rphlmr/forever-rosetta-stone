            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.beddec026620c542b7cb": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "37251c3ba14828cbd076": "Jeg vil gerne trænes.",
        "b44ac6ec5668c36d4ec7": "Kom og lær jægerens vej. Stolthed, ære og tradition.",
        "beddec026620c542b7cb": "Gennem grundig omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg aflærer dig de talenter, du har lært?"
      },
      "name": "Sian'dur",
      "translationMetadata": {
        "fields": {
          "dialogue.37251c3ba14828cbd076": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
