    "svSE": {
      "dialogue": {
        "37251c3ba14828cbd076": "Jag vill träna.",
        "b44ac6ec5668c36d4ec7": "Kom och lär dig jägarens väg. Stolthet, ära och tradition.",
        "beddec026620c542b7cb": "Genom grundlig omskolning har jag fått elever att glömma allt de tidigare lärt sig, så att jag kunnat lära dem på nytt. Tjänsten jag erbjuder blir svårare att utföra för varje gång. Därför blir den också dyrare vid varje omskolning. Vill du att jag hjälper dig att glömma de talanger du har lärt dig?"
      },
      "name": "Sian'dur",
      "translationMetadata": {
        "fields": {
          "dialogue.37251c3ba14828cbd076": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
