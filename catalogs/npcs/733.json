    "csCZ": {
      "dialogue": {
        "076b778bedd96f17851d": "Vycvičte mě.",
        "9995365d53bb5fcee82d": "Dávej si tu pozor, kam šlapeš, $Gchlapče:děvče;. Možná nepatříš k naší jednotce, ale to neznamená, že tě nevezmu holí, jestli vystoupíš z řady!",
        "ad8a70ba173a9764aec7": "Dávej si tu pozor, kam šlapeš, $Gchlapče:děvče;. Možná nepatříš k naší jednotce, ale to neznamená, že tě nevezmu holí, jestli vystoupíš z řady!",
        "e951b13871630fbff895": "Rád bych si prohlédl vaše zboží."
      },
