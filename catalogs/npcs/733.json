    "enUS": {
      "dialogue": {
        "076b778bedd96f17851d": "Train me.",
        "9995365d53bb5fcee82d": "You watch where you step around here, $Gson:lass;.  You might not be a part of our outfit, but that doesn't mean I won't take a cane to you if you fall out of line!",
        "ad8a70ba173a9764aec7": "You watch where you step around here, $Gson:lass;.  You might not be a part of our outfit, but that doesn't mean I won't take a cane to you if you fall out of line!",
        "e951b13871630fbff895": "I want to browse your goods."
      },
      "name": "Sergeant Yohwa",
