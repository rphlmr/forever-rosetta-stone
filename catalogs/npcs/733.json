    "daDK": {
      "dialogue": {
        "076b778bedd96f17851d": "Træn mig.",
        "9995365d53bb5fcee82d": "Se dig for her, $Gknægt:pige;. Du er måske ikke en del af vores enhed, men det betyder ikke, at jeg ikke giver dig stokkeslag, hvis du træder ved siden af!",
        "ad8a70ba173a9764aec7": "Se dig for her, $Gknægt:pige;. Du er måske ikke en del af vores enhed, men det betyder ikke, at jeg ikke giver dig stokkeslag, hvis du træder ved siden af!",
        "e951b13871630fbff895": "Jeg vil gerne se dine varer."
      },
