    "esES": {
      "dialogue": {
        "076b778bedd96f17851d": "Entréname.",
        "9995365d53bb5fcee82d": "Ten cuidado donde pisas por aquí, hijo.  Puede que no formes parte de nuestro equipo, ¡pero eso no significa que no vaya a darte un bastonazo si te pasas de la raya!",
        "ad8a70ba173a9764aec7": "Ten cuidado donde pisas por aquí, muchacha.  Puede que no formes parte de nuestro equipo, ¡pero eso no significa que no vaya a darte un bastonazo si te pasas de la raya!",
        "e951b13871630fbff895": "Quiero ver tus mercancías."
      },
