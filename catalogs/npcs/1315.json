            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "Jeg sælger kun det fineste magiske udstyr, fremstillet af håndværkere og magikere her i Stormwind.",
        "479c6dc99e62bb7a5241": "Siden Dalarans fald og ødelæggelsen af Quel'Thalas har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere har gjort et fremragende arbejde med at fylde vores ordrer med kvalitetsvarer.",
        "d05b3ab7611eaf5ab81d": "Jeg vil gerne se dine varer."
      },
      "name": "Allan Hafgan",
      "translationMetadata": {
        "fields": {
          "dialogue.2cdc5c85e1880bb9d2ee": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
