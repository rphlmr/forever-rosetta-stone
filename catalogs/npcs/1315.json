            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "Ich verkaufe nur die beste arkane Ausrüstung, gemacht von den Handwerkern und Magiern hier in Stormwind.",
        "479c6dc99e62bb7a5241": "Seit dem Fall von Dalaran und der Zerstörung von Quel'Thalas sind solche Waren schwer zu bekommen. Aber Lucan Cordell und einige andere unserer Handwerker haben es geschafft, für unsere Bestellungen erstklassige Handelsware zu besorgen.",
        "d05b3ab7611eaf5ab81d": "Ich möchte Eure Waren ansehen."
      },
      "name": "Allan Hafgan",
      "subName": "Stabhändler",
      "translationMetadata": {
        "fields": {
          "dialogue.2cdc5c85e1880bb9d2ee": {
