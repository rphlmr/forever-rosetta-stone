    "ptBR": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "Eu só vendo equipamento arcano da melhor qualidade, feito pelos artesãos e magos aqui de Ventobravo.",
        "479c6dc99e62bb7a5241": "Desde a queda de Dalaran e a destruição de Quel'thalas, tem sido difícil encontrar mercadorias desse tipo. Mas Lucas Cordel e alguns dos outros mercadores têm atendido muito bem os nossos pedidos, com mercadorias de qualidade.",
        "d05b3ab7611eaf5ab81d": "Quero ver suas mercadorias."
      },
      "name": "Alan Montezzi",
      "subName": "Cajados",
      "translationMetadata": {
        "fields": {
          "dialogue.2cdc5c85e1880bb9d2ee": {
