  "locales": {
    "csCZ": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "Prodávám jen tu nejlepší magickou výbavu, kterou vyrábějí řemeslníci a mágové zde ve Stormwindu.",
        "479c6dc99e62bb7a5241": "Od pádu Dalaranu a zničení Quel'Thalasu se takové zboží těžko shání. Lucan Cordell a někteří další naši řemeslníci však odvádějí skvělou práci a plní naše objednávky kvalitním zbožím.",
        "d05b3ab7611eaf5ab81d": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Allan Hafgan",
      "translationMetadata": {
        "fields": {
          "dialogue.2cdc5c85e1880bb9d2ee": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.479c6dc99e62bb7a5241": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d05b3ab7611eaf5ab81d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
