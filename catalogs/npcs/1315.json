    "hrHR": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "Prodajem samo najbolju magijsku opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu.",
        "479c6dc99e62bb7a5241": "Od pada Dalarana i uništenja Quel'Thalasa teško je nabaviti takvu robu. Ali Lucan Cordell i neki drugi naši obrtnici izvrsno obavljaju posao, ispunjavajući naše narudžbe kvalitetnom robom.",
        "d05b3ab7611eaf5ab81d": "Želim pogledati vašu robu."
      },
      "name": "Allan Hafgan",
      "translationMetadata": {
        "fields": {
