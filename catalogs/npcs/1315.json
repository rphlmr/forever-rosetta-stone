    "ltLT": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "Parduodu tik geriausią magišką įrangą, pagamintą čia, Stormwind mieste, mūsų amatininkų ir magų.",
        "479c6dc99e62bb7a5241": "Po Dalarano žlugimo ir Quel'Thalas sunaikinimo tokių prekių sunku gauti. Tačiau Lucan Cordell ir kai kurie kiti mūsų amatininkai puikiai vykdo užsakymus, tiekdami kokybiškas prekes.",
        "d05b3ab7611eaf5ab81d": "Noriu apžiūrėti jūsų prekes."
      },
      "name": "Allan Hafgan",
      "subName": "Lazdų prekeivis",
      "translationMetadata": {
        "fields": {
          "dialogue.2cdc5c85e1880bb9d2ee": {
