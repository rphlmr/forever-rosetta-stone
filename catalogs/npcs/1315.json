    "enUS": {
      "dialogue": {
        "2cdc5c85e1880bb9d2ee": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "479c6dc99e62bb7a5241": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise.",
        "d05b3ab7611eaf5ab81d": "I want to browse your goods."
      },
      "name": "Allan Hafgan",
      "subName": "Staves Merchant",
      "translationMetadata": {
        "fields": {
          "dialogue.2cdc5c85e1880bb9d2ee": {
