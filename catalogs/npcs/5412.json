    "ptBR": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Treine-me.",
        "3d35be95fae03553455d": "Os clãs de centauros dominam os ermos de Desolação. Se estivessem unidos, seriam uma força terrível. Ainda bem que não estão, preferindo discutir e guerrear entre si.",
        "9d5852a73651f552931c": "Quero ver suas mercadorias."
      },
      "name": "Gurda Juba Agreste",
      "translationMetadata": {
