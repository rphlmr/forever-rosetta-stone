    "hrHR": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Podučite me.",
        "3d35be95fae03553455d": "Kentaur­ski klanovi vladaju pustopoljinama Desolacea. Kad bi bili ujedinjeni, predstavljali bi strašnu silu. Srećom, nisu ujedinjeni, nego se svađaju i ratuju međusobno.",
        "9d5852a73651f552931c": "Želim pogledati vašu robu."
      },
      "name": "Gurda Wildmane",
      "translationMetadata": {
