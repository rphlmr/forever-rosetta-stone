    "trTR": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Beni eğit.",
        "3d35be95fae03553455d": "Sentor klanları Desolace'ın çorak topraklarına hükmeder. Birleşseler korkunç bir güç olurlardı. Neyse ki birleşmiş değiller; bunun yerine birbirleriyle çekişip savaşıyorlar.",
        "9d5852a73651f552931c": "Mallarına bakmak istiyorum."
      },
      "name": "Gurda Wildmane",
      "translationMetadata": {
