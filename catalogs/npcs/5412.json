    "enUS": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Train me.",
        "3d35be95fae03553455d": "The centaur clans rule the wastes of Desolace.  If united, they would be a terrible force.  It is then good that the centaur clans are not united but instead bicker and war amongst themselves.",
        "9d5852a73651f552931c": "I want to browse your goods."
      },
      "name": "Gurda Wildmane",
      "translationMetadata": {
