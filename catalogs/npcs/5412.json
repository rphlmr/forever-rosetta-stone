    "itIT": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Addestrami.",
        "3d35be95fae03553455d": "I clan dei centauri dominano le lande di Desolace. Se fossero uniti, sarebbero una forza terribile. È un bene, dunque, che i clan dei centauri non siano uniti e invece litighino e si facciano guerra tra loro.",
        "9d5852a73651f552931c": "Vorrei vedere la tua merce."
      },
      "name": "Gurda Wildmane",
