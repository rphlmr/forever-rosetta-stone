    "esES": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Entréname.",
        "3d35be95fae03553455d": "Los clanes de centauros dominan los páramos de Desolace.  Si estuvieran unidos, serían una fuerza terrible.  Por eso es bueno que los clanes de centauros no estén unidos, sino que discutan y guerreen entre ellos.",
        "9d5852a73651f552931c": "Quiero ver tus mercancías."
      },
      "name": "Gurda Bravacrín",
      "translationMetadata": {
