  "locales": {
    "csCZ": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Vycvičte mě.",
        "3d35be95fae03553455d": "Pustinám Desolace vládnou klany kentaurů. Kdyby se sjednotily, představovaly by strašlivou sílu. Je tedy dobře, že sjednocené nejsou a místo toho se mezi sebou hašteří a válčí.",
        "9d5852a73651f552931c": "Chci si prohlédnout vaše zboží."
      },
      "name": "Gurda Wildmane",
      "translationMetadata": {
        "fields": {
