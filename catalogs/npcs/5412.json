    "plPL": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Wyszkol mnie.",
        "3d35be95fae03553455d": "Klany centaurów władają pustkowiami Desolace. Gdyby się zjednoczyły, stanowiłyby straszliwą siłę. Na szczęście nie są zjednoczone, lecz kłócą się i walczą między sobą.",
        "9d5852a73651f552931c": "Chcę przejrzeć twoje towary."
      },
      "name": "Gurda Wildmane",
      "translationMetadata": {
