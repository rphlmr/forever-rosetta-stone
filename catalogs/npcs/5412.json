    "svSE": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Träna mig.",
        "3d35be95fae03553455d": "Kentaurklanerna härskar över Desolaces ödemarker. Om de var enade skulle de vara en fruktansvärd styrka. Lyckligtvis är de inte enade, utan grälar och krigar med varandra.",
        "9d5852a73651f552931c": "Jag vill se dina varor."
      },
