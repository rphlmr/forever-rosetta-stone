      }
    },
    "daDK": {
      "dialogue": {
        "1cd085ec94c7ac2e59f0": "Træn mig.",
        "3d35be95fae03553455d": "Kentaurklanerne hersker over Desolaces ødemarker. Hvis de stod sammen, ville de være en frygtelig styrke. Heldigvis er de ikke forenede, men strides og bekriger i stedet hinanden.",
        "9d5852a73651f552931c": "Jeg vil gerne se dine varer."
      },
      "name": "Gurda Wildmane",
      "translationMetadata": {
        "fields": {
          "dialogue.1cd085ec94c7ac2e59f0": {
            "origin": "ai",
