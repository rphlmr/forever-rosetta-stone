    "enUS": {
      "dialogue": {
        "c05a23a83675421bda17": "This kodo sure looks nothing like the beast I originally lured!  I wonder if the kombobulator can be used on me.",
        "fe00aa2835c8386be6d3": "Why is it that small creatures such as goblins are always fascinated with larger creatures?"
      },
      "name": "Aged Kodo",
      "translationMetadata": {
        "fields": {
          "dialogue.c05a23a83675421bda17": {
