    "ltLT": {
      "dialogue": {
        "c05a23a83675421bda17": "Šis kodo visai nepanašus į žvėrį, kurį iš pradžių prisiviliojau!  Įdomu, ar kombobuliatorių galima panaudoti man.",
        "fe00aa2835c8386be6d3": "Kodėl tokias mažas būtybes kaip goblinai visada taip žavi didesni padarai?"
      },
      "name": "Senas kodo",
