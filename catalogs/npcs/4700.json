    "trTR": {
      "dialogue": {
        "c05a23a83675421bda17": "Bu kodo ilk cezbettiğim yaratığa hiç benzemiyor! Acaba kombobülatör bende de işe yarar mı?",
        "fe00aa2835c8386be6d3": "Goblinler gibi küçük yaratıklar neden hep daha büyük yaratıklara hayran olur?"
      },
      "name": "Yaşlanmış Kodo",
