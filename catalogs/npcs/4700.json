          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "c05a23a83675421bda17": "Dieser Kodo sieht kein bisschen aus wie das Tier, das ich ursprünglich angelockt habe! Ich frage mich, ob ich den Kombobulator wohl auch auf mich selbst anwenden könnte...",
        "fe00aa2835c8386be6d3": "Warum sind kleine Kreaturen wie Goblins nur immer so fasziniert von größeren Kreaturen?"
      },
      "name": "Gealterter Kodo",
      "translationMetadata": {
        "fields": {
          "dialogue.c05a23a83675421bda17": {
