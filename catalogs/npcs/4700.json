  "locales": {
    "csCZ": {
      "dialogue": {
        "c05a23a83675421bda17": "Tenhle kodo vůbec nevypadá jako zvíře, které jsem původně nalákal! Zajímalo by mě, jestli kombobulátor funguje i na mě.",
        "fe00aa2835c8386be6d3": "Proč malé bytosti jako goblini vždy fascinují větší tvorové?"
      },
      "name": "Letitý kodo",
      "translationMetadata": {
        "fields": {
          "dialogue.c05a23a83675421bda17": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.fe00aa2835c8386be6d3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "c05a23a83675421bda17": "Denne kodo ligner slet ikke det dyr, jeg oprindeligt lokkede til! Mon kombobulatoren også virker på mig?",
        "fe00aa2835c8386be6d3": "Hvorfor er små væsner som gobliner altid fascineret af større væsner?"
      },
      "name": "Gammel kodo",
      "translationMetadata": {
        "fields": {
          "dialogue.c05a23a83675421bda17": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.fe00aa2835c8386be6d3": {
