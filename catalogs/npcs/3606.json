    "ltLT": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune turi daug paslapčių, bet jomis nesidalijama su bet kuo. ",
        "7f91f535a0f44a32a6b8": "Tavo kerėjimo žinios išties įspūdingos. Jei nori, gali dar daug ko išmokti. Pasikalbėk su Taladan Amatininkų terasoje, Darnassus mieste.",
        "867cff1ef68b5b974cbd": "Pamokyk mane.",
        "99f917b9095e97d41a59": "Atverk savo protą, klajūne, ir pradėsime."
      },
      "name": "Alanna Raveneye",
      "subName": "Kerėtoja, pameistrė",
