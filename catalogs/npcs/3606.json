    "esES": {
      "dialogue": {
        "560acd60100a6aefa688": "Son muchos los secretos de Elune, pero no pueden compartirse con cualquiera.",
        "7f91f535a0f44a32a6b8": "Realmente has progresado mucho en tu saber sobre encantamiento. Pero aún hay mucho que aprender si lo deseas. Habla con Taladan, en el Bancal del Artesano de Darnassus.",
        "867cff1ef68b5b974cbd": "Entréname.",
        "99f917b9095e97d41a59": "Abre tu mente, trotamundos, y comenzaremos."
      },
      "name": "Alanna Cuervojo",
      "subName": "Oficial encantador",
