    "svSE": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune har många hemligheter, men de delas inte med vem som helst.",
        "7f91f535a0f44a32a6b8": "Du har verkligen utmärkt dig i dina kunskaper om förtrollning. Det finns mycket mer att lära, om du vill. Tala med Taladan på hantverkarnas terrass i Darnassus.",
        "867cff1ef68b5b974cbd": "Träna mig.",
        "99f917b9095e97d41a59": "Öppna ditt sinne, vandrare, så börjar vi."
      },
      "name": "Alanna Raveneye",
      "translationMetadata": {
