    "hrHR": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune ima mnoge tajne, ali ne dijelimo ih s bilo kim.",
        "7f91f535a0f44a32a6b8": "Doista si se istaknuo znanjem o začaravanju. Možeš naučiti još mnogo toga, ako želiš. Razgovaraj s Taladanom na Obrtničkoj terasi u Darnassusu.",
        "867cff1ef68b5b974cbd": "Podučite me.",
        "99f917b9095e97d41a59": "Otvori svoj um, putniče, pa ćemo početi."
      },
      "name": "Alanna Raveneye",
