    "itIT": {
      "dialogue": {
        "560acd60100a6aefa688": "I segreti di Elune sono molti, ma non vanno condivisi con chiunque.",
        "7f91f535a0f44a32a6b8": "Hai davvero eccelso nella conoscenza dell'incantamento. C'è ancora molto da imparare, se lo desideri. Parla con Taladan alla Terrazza degli Artigiani a Darnassus.",
        "867cff1ef68b5b974cbd": "Addestrami.",
        "99f917b9095e97d41a59": "Apri la tua mente, viandante, e cominceremo."
      },
      "name": "Alanna Raveneye",
