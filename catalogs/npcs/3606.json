    "ptBR": {
      "dialogue": {
        "560acd60100a6aefa688": "Muitos são os segredos de Eluna, mas não se deve compartilhá-los com qualquer um.",
        "7f91f535a0f44a32a6b8": "Você realmente se destacou em seu conhecimento sobre encantamentos. Há muito mais a aprender se você desejar. Fale com Taladan no Terraço dos Artesãos em Darnassus",
        "867cff1ef68b5b974cbd": "Treine-me.",
        "99f917b9095e97d41a59": "Abra sua mente, viajante, e daremos início."
      },
      "name": "Aline Corvolhar",
      "subName": "Encantadora Profissional",
