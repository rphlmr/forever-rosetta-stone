    "plPL": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune skrywa wiele tajemnic, ale nie dzieli się nimi z byle kim.",
        "7f91f535a0f44a32a6b8": "Twoja wiedza o zaklinaniu jest naprawdę imponująca. Jeśli chcesz, możesz nauczyć się znacznie więcej. Porozmawiaj z Taladanem na Tarasie Rzemieślników w Darnassus.",
        "867cff1ef68b5b974cbd": "Wyszkol mnie.",
        "99f917b9095e97d41a59": "Otwórz umysł, wędrowcze, a zaczniemy."
      },
      "name": "Alanna Raveneye",
      "translationMetadata": {
