    "daDK": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune har mange hemmeligheder, men de deles ikke med hvem som helst.",
        "7f91f535a0f44a32a6b8": "Du har virkelig udmærket dig i din viden om fortryllelse. Der er meget mere at lære, hvis du vil. Tal med Taladan på håndværkernes terrasse i Darnassus.",
        "867cff1ef68b5b974cbd": "Træn mig.",
        "99f917b9095e97d41a59": "Åbn dit sind, vandrer, så begynder vi."
      },
      "name": "Alanna Raveneye",
      "translationMetadata": {
