  "locales": {
    "csCZ": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune má mnoho tajemství, ale nesvěřujeme je jen tak někomu.",
        "7f91f535a0f44a32a6b8": "Ve znalostech očarovávání jsi skutečně vynikl. Pokud budeš chtít, můžeš se naučit mnohem víc. Promluv si s Taladanem na Terase řemeslníků v Darnassu.",
        "867cff1ef68b5b974cbd": "Vycvičte mě.",
        "99f917b9095e97d41a59": "Otevři svou mysl, poutníku, a začneme."
      },
      "name": "Alanna Raveneye",
      "translationMetadata": {
        "fields": {
