    "enUS": {
      "dialogue": {
        "560acd60100a6aefa688": "Elune's secrets are many, but they are not to be shared with just anyone. ",
        "7f91f535a0f44a32a6b8": "You have truly excelled in your knowledge of enchanting. There is much more to learn, if you are willing. Speak to Taladan, in the Craftsmen's Terrace in Darnassus.",
        "867cff1ef68b5b974cbd": "Train me.",
        "99f917b9095e97d41a59": "Open your mind, wanderer, and we shall begin."
      },
      "name": "Alanna Raveneye",
      "subName": "Journeyman Enchanter",
      "translationMetadata": {
        "fields": {
