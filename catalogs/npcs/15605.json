    "esES": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Puedes encontrar al ancestro Tejestrellas en la villa costera de Auberdine en Costa Oscura.",
        "7beb76fefd3b0aa84081": "Las estrellas de nuestro tiempo están cambiando su trayectoria, faros de esperanza y fortaleza para los años venideros.",
        "828268bfa59b3af0b08f": "El ancestro Relucielo se encuentra cerca del Monumento Cresta Cuervo en Azshara.",
        "84539015405b1f21085e": "El ancestro Nochebrisa pasa los días en el santuario de Jaedenar en Frondavil.",
        "874eb3997c58c8745398": "Lo último que supe es que el ancestro Picopiedra estaba en Vista Eterna en Cuna del Invierno."
      },
      "name": "Ancestro Riosona",
