    "plPL": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Starszego Starweave'a znajdziesz w nadmorskiej wiosce Auberdine w Darkshore.",
        "7beb76fefd3b0aa84081": "Gwiazdy naszych czasów podążają nowymi ścieżkami, niczym latarnie nadziei i siły dla nadchodzących wieków.",
        "828268bfa59b3af0b08f": "Starszego Skygleama znajdziesz w pobliżu pomnika Ravencresta w Azsharze.",
        "84539015405b1f21085e": "Starszy Nightwind spędza dni przy kapliczce w Jaedenarze w Felwoodzie.",
        "874eb3997c58c8745398": "O ile wiem, starszy Stonespire był w Everlook w Winterspringu."
      },
      "name": "Starsza Riversong",
      "translationMetadata": {
