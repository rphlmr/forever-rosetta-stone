    "enUS": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Elder Starweave can be found at the coastal village of Auberdine in Darkshore.",
        "7beb76fefd3b0aa84081": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "828268bfa59b3af0b08f": "Elder Skygleam can be found near the Ravencrest Monument in Azshara.",
        "84539015405b1f21085e": "Elder Nightwind passes the days at the shrine in Jaedenar in Felwood.",
        "874eb3997c58c8745398": "Last I knew, Elder Stonespire was at Everlook in Winterspring."
      },
      "name": "Elder Riversong",
      "translationMetadata": {
