    "trTR": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Yaşlı Starweave'i Darkshore'daki sahil köyü Auberdine'de bulabilirsin.",
        "7beb76fefd3b0aa84081": "Bu çağın yıldızları yeni yollara yöneliyor; gelecek çağlar için umut ve güç ışıkları oluyorlar.",
        "828268bfa59b3af0b08f": "Yaşlı Skygleam'i Azshara'daki Ravencrest Anıtı yakınlarında bulabilirsin.",
        "84539015405b1f21085e": "Yaşlı Nightwind günlerini Felwood'daki Jaedenar tapınağında geçiriyor.",
        "874eb3997c58c8745398": "Son duyduğuma göre Yaşlı Stonespire Winterspring'deki Everlook'taydı."
      },
      "name": "Ulu Riversong",
