    "svSE": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Äldste Starweave finns i kustbyn Auberdine i Darkshore.",
        "7beb76fefd3b0aa84081": "Denna tids stjärnor följer nya banor, fyrar av hopp och styrka för kommande tidsåldrar.",
        "828268bfa59b3af0b08f": "Äldste Skygleam finns nära Ravencrestmonumentet i Azshara.",
        "84539015405b1f21085e": "Äldste Nightwind tillbringar dagarna vid helgedomen i Jaedenar i Felwood.",
        "874eb3997c58c8745398": "Senast jag hörde var äldste Stonespire i Everlook i Winterspring."
      },
      "name": "Äldste Riversong",
