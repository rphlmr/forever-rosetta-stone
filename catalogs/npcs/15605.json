    "hrHR": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Starješinu Starweavea možeš pronaći u obalnom selu Auberdine u Darkshoreu.",
        "7beb76fefd3b0aa84081": "Zvijezde ovog vremena kreću novim putanjama, svjetionici nade i snage za nadolazeća doba.",
        "828268bfa59b3af0b08f": "Starješinu Skygleama možeš pronaći blizu spomenika Ravencrestu u Azshari.",
        "84539015405b1f21085e": "Starješina Nightwind provodi dane kod svetišta u Jaedenaru u Felwoodu.",
        "874eb3997c58c8745398": "Koliko znam, starješina Stonespire bio je u Everlooku u Winterspringu."
      },
      "name": "Starješina Riversong",
