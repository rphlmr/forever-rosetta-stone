    "frFR": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "L'Ancienne Starweave se trouve dans le village côtier d'Auberdine, à Sombrivage.",
        "7beb76fefd3b0aa84081": "Les étoiles de ce temps suivent des chemins nouveaux, et leurs lueurs seront des foyers d’espoir et de force pour les âges qui s’annoncent.",
        "828268bfa59b3af0b08f": "L'Ancien Skygleam se trouve près du monument de Ravencrest, en Azshara.",
        "84539015405b1f21085e": "L'Ancien Nightwind regarde s'écouler les jours au sanctuaire de Jaedenar, à Gangrebois.",
        "874eb3997c58c8745398": "Aux dernières nouvelles, l'Ancien Stonespire se trouvait à Long-guet, au Berceau-de-l'Hiver."
      },
      "name": "Ancienne Riversong",
