    "deDE": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Urahnin Moonstrike kann in der Küstenstadt Auberdine an der Dunkelküste angetroffen werden.",
        "7beb76fefd3b0aa84081": "Die Sterne bewegen sich nun auf neuen Bahnen fort. Fortan scheinen sie als Zeichen der Hoffnung und der Stärke für kommende Zeiten.",
        "828268bfa59b3af0b08f": "Urahne Skygleam kann nahe des Ravencrest-Monuments in Azshara angetroffen werden.",
        "84539015405b1f21085e": "Urahne Nightwind verbringt seine Zeit in dem Schrein in Jaedenar im Teufelswald.",
        "874eb3997c58c8745398": "Soweit ich weiß, hält sich Urahne Stonespire in Everlook in Winterspring auf."
      },
      "name": "Urahnin Riversong",
