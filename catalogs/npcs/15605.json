  "locales": {
    "csCZ": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Staršího Starweavea najdeš v pobřežní vesnici Auberdine v Darkshore.",
        "7beb76fefd3b0aa84081": "Hvězdy této doby se ubírají novými cestami, jako majáky naděje a síly pro nadcházející věky.",
        "828268bfa59b3af0b08f": "Staršího Skygleama najdeš poblíž Ravencrestova památníku v Azshaře.",
        "84539015405b1f21085e": "Starší Nightwind tráví dny ve svatyni v Jaedenaru ve Felwoodu.",
        "874eb3997c58c8745398": "Pokud vím, starší Stonespire byl v Everlooku ve Winterspringu."
      },
      "name": "Starší Riversong",
