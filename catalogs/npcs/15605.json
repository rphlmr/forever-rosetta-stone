    "daDK": {
      "dialogue": {
        "4753c37fbb74b7ddd5b0": "Ældste Starweave findes i kystlandsbyen Auberdine i Darkshore.",
        "7beb76fefd3b0aa84081": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "828268bfa59b3af0b08f": "Ældste Skygleam findes nær Ravencrest-monumentet i Azshara.",
        "84539015405b1f21085e": "Ældste Nightwind tilbringer dagene ved helligdommen i Jaedenar i Felwood.",
        "874eb3997c58c8745398": "Sidst jeg hørte, var ældste Stonespire i Everlook i Winterspring."
      },
      "name": "Ældste Riversong",
      "translationMetadata": {
