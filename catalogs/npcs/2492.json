    "ltLT": {
      "dialogue": {
        "17010d0b821b7d6e1dd7": "Kaip magas, priklausai nedidelei grupei tų, kurie gali iškviesti portalą ir grįžti tiesiai į šią vietą. Galiu tave išmokyti, jei esi pasirengęs.",
        "3c14c53f915c1eedfa51": "Netikiu, kad esi pakankamai įžvalgus suprasti portalų magijos prigimtį.",
        "ca2165c9d39758492cab": "Prašau mane išmokyti."
      },
      "name": "Lexington Mortaim",
      "subName": "Portalų mokytojas",
      "translationMetadata": {
