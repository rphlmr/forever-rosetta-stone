    "hrHR": {
      "dialogue": {
        "17010d0b821b7d6e1dd7": "Kao mag, pripadaš odabranoj skupini koja može prizvati portal za povratak upravo ovamo. Mogu te podučiti ako si spreman.",
        "3c14c53f915c1eedfa51": "Ne vjerujem da posjeduješ dovoljno bistar um da shvatiš prirodu magije portala.",
        "ca2165c9d39758492cab": "Molim te, poduči me."
      },
      "name": "Lexington Mortaim",
      "translationMetadata": {
