  "locales": {
    "csCZ": {
      "dialogue": {
        "17010d0b821b7d6e1dd7": "Jako mág patříš k vyvoleným, kteří dokážou vyvolat portál zpět přímo sem. Pokud jsi připraven, mohu tě to naučit.",
        "3c14c53f915c1eedfa51": "Nevěřím, že máš dost bystrou mysl, abys pochopil podstatu portálové magie.",
        "ca2165c9d39758492cab": "Prosím, učte mě."
      },
      "name": "Lexington Mortaim",
      "translationMetadata": {
        "fields": {
          "dialogue.17010d0b821b7d6e1dd7": {
            "origin": "ai",
