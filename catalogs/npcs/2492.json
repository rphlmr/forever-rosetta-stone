    "esES": {
      "dialogue": {
        "17010d0b821b7d6e1dd7": "Como mago, perteneces a un grupo selecto que puede conjurar un portal para transportarte de nuevo a este lugar. Puedo enseñarte si eres capaz de aprender.",
        "3c14c53f915c1eedfa51": "No puedo creerme que poseas la agudeza mental necesaria para comprender la naturaleza de la magia del portal.",
        "ca2165c9d39758492cab": "Por favor, enséñame."
      },
      "name": "Lexington Tanafín",
      "subName": "Instructor de portal",
