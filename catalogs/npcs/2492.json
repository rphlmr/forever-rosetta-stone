    "enUS": {
      "dialogue": {
        "17010d0b821b7d6e1dd7": "As a mage, you are one of a select group that can conjure a portal to transport you back to this very place.  I can teach you if you are ready.",
        "3c14c53f915c1eedfa51": "I do not believe you possess the mental acuity to grasp the nature of portal magic.",
        "ca2165c9d39758492cab": "Please teach me."
      },
      "name": "Lexington Mortaim",
      "subName": "Portal Trainer",
      "translationMetadata": {
        "fields": {
