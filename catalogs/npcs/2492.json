    "daDK": {
      "dialogue": {
        "17010d0b821b7d6e1dd7": "Som magiker er du blandt de få udvalgte, der kan fremmane en portal tilbage til netop dette sted. Jeg kan lære dig det, hvis du er klar.",
        "3c14c53f915c1eedfa51": "Jeg tror ikke, du har den fornødne skarphed til at forstå portalmagiens natur.",
        "ca2165c9d39758492cab": "Lær mig det, tak."
      },
      "name": "Lexington Mortaim",
      "translationMetadata": {
        "fields": {
          "dialogue.17010d0b821b7d6e1dd7": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
