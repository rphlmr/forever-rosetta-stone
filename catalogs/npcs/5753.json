    "enUS": {
      "dialogue": {
        "20d2fbdf897ea9d1a520": "You're no warlock and I've no time for you.  Begone!",
        "beadd0a0ecc3dd6641e7": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place.",
        "e17afaed665241462164": "Show me your selection of grimoires."
      },
      "name": "Martha Strain",
      "subName": "Demon Trainer",
