    "hrHR": {
      "dialogue": {
        "20d2fbdf897ea9d1a520": "Nisi vještac i nemam vremena za tebe. Gubi se!",
        "beadd0a0ecc3dd6641e7": "Želiš ojačati svoje demone? To će te stajati, ali došao si na pravo mjesto.",
        "e17afaed665241462164": "Pokažite mi svoj izbor grimoara."
      },
      "name": "Martha Strain",
