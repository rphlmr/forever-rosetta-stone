    "daDK": {
      "dialogue": {
        "20d2fbdf897ea9d1a520": "Du er ikke troldmand, og jeg har ikke tid til dig. Forsvind!",
        "beadd0a0ecc3dd6641e7": "Vil du gøre dine dæmoner stærkere? Det koster dig, men du er kommet til det rette sted.",
        "e17afaed665241462164": "Vis mig dit udvalg af grimoirer."
      },
      "name": "Martha Strain",
      "translationMetadata": {
