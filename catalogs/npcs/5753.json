    "deDE": {
      "dialogue": {
        "20d2fbdf897ea9d1a520": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "beadd0a0ecc3dd6641e7": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig.",
        "e17afaed665241462164": "Zeigt mir Eure Auswahl an Grimoires."
      },
      "name": "Martha Strain",
      "subName": "Dämonenausbilderin",
