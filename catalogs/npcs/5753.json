    "plPL": {
      "dialogue": {
        "20d2fbdf897ea9d1a520": "Nie jesteś czarnoksiężnikiem, a ja nie mam dla ciebie czasu. Precz!",
        "beadd0a0ecc3dd6641e7": "Chcesz wzmocnić swoje demony? To będzie kosztować, ale dobrze trafiłeś.",
        "e17afaed665241462164": "Pokaż mi swoją ofertę grymuarów."
