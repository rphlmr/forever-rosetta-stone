  "locales": {
    "csCZ": {
      "dialogue": {
        "20d2fbdf897ea9d1a520": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "beadd0a0ecc3dd6641e7": "Chceš své démony posílit? Něco tě to bude stát, ale jsi na správném místě.",
        "e17afaed665241462164": "Ukažte mi svou nabídku grimoárů."
      },
      "name": "Martha Strain",
      "translationMetadata": {
        "fields": {
          "dialogue.20d2fbdf897ea9d1a520": {
