    },
    "hrHR": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Ako želimo dobiti ovaj rat, ne možemo sjediti skrštenih ruku i dopustiti da nas plima odnese. Moramo udariti snažno i brzo ili Arathi više nikad neće biti naš."
      },
      "name": "Narednik Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
