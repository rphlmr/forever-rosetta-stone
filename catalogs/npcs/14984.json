    },
    "plPL": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Jeśli chcemy wygrać tę wojnę, nie możemy siedzieć bezczynnie i dać się porwać falom. Musimy uderzyć mocno i szybko, inaczej Arathi nigdy już nie będzie nasze."
      },
      "name": "Sierżant Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Se quisermos vencer a guerra, não podemos esperar sentados enquanto a maré nos engole. Temos que atacar rápido e com toda força, ou jamais recuperaremos Arathi."
      },
      "name": "Sargento Martina",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "community",
