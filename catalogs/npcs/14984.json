            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Om vi ska vinna det här kriget kan vi inte sitta overksamma och låta vågorna svepa bort oss. Vi måste slå till hårt och snabbt, annars blir Arathi aldrig vårt igen."
      },
      "name": "Sergeant Maclear",
      "translationMetadata": {
        "fields": {
