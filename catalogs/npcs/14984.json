  "locales": {
    "csCZ": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Chceme-li tuto válku vyhrát, nemůžeme nečinně přihlížet a nechat se smést přílivem. Musíme udeřit tvrdě a rychle, jinak už Arathi nikdy nebude naše."
      },
      "name": "Seržant Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Hvis vi skal vinde denne krig, kan vi ikke sidde stille og lade bølgerne skylle os væk. Vi må slå hårdt og hurtigt til, ellers bliver Arathi aldrig vores igen."
      },
      "name": "Sergent Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Um diesen Kampf zu gewinnen, können wir nicht tatenlos herumsitzen und einfach warten, dass der Sturm uns erfasst. Wir müssen zuschlagen, hart und schnell oder Arathi wird nie wieder unser sein."
      },
      "name": "Sergeant Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
            "sourceSha256": "c1cd1597ee8ef61b8859daf63d724a5ec28d311078335b8014ae4d85c11777ac"
          },
          "name": {
