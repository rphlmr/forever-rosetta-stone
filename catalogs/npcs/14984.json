            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Per vincere questa guerra non possiamo starcene con le mani in mano e lasciarci travolgere dalla marea. Dobbiamo colpire, forte e in fretta, o Arathi non sarà mai più nostra."
      },
      "name": "Sergente Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
