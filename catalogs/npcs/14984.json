          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "To win this war, we can't sit idle and let the tides sweep us over.  We must strike, hard and fast, or Arathi will never again be ours."
      },
      "name": "Sergeant Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
