    "frFR": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Si nous voulons gagner cette guerre, nous ne devons pas rester assis sans rien faire. Nous devons frapper, vite et fort, ou nous ne reprendrons jamais Arathi."
      },
      "name": "Sergent Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
            "origin": "community",
