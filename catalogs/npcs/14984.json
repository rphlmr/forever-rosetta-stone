            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "f8144e5e4a75690b4c47": "Para ganar esta guerra, no podemos quedarnos sentados esperando a que las mareas nos lleven. Debemos atacar, dura y rápidamente, o Arathi nunca volverá a pertenecernos."
      },
      "name": "Sargento Maclear",
      "translationMetadata": {
        "fields": {
          "dialogue.f8144e5e4a75690b4c47": {
