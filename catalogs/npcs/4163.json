    "plPL": {
      "dialogue": {
        "04d475021a35cf3e3971": "Jesteśmy jedynie ciemnością i cieniem. Wieczni. Niewidzialni.",
        "3c910ad21e30f6a40f44": "Szukam szkolenia.",
        "47aa35ea048080f59ec0": "Wiele zamkniętych skrzyń z zaopatrzeniem przepadło, gdy nagi opanowały Wybrzeże Zoram w Ashenvale.",
        "9bcadd6b788c31acb9f5": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "b6974a67050985b2e2a9": "Witaj, młody łotrze. Czego szukasz?",
        "d7b8c54389b198a89904": "Posłańcy z Ravenholdt dostarczyli mi dziś rano ten list. Jest zaadresowany do ciebie, $n."
      },
      "name": "Syurna",
      "translationMetadata": {
