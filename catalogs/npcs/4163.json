    "hrHR": {
      "dialogue": {
        "04d475021a35cf3e3971": "Mi smo samo tama i sjene. Vječni. Nevidljivi.",
        "3c910ad21e30f6a40f44": "Tražim poduku.",
        "47aa35ea048080f59ec0": "Mnoge zaključane sanduke sa zalihama izgubili smo kad su nage preplavile obalu Zoram u Ashenvaleu.",
        "9bcadd6b788c31acb9f5": "Strogom sam preobukom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Svaka sljedeća preobuka sve je teža, pa je zato i skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "b6974a67050985b2e2a9": "Pozdrav, mladi odmetniče. Što tražiš?",
        "d7b8c54389b198a89904": "Glasnici iz Ravenholdta jutros su mi donijeli ovo pismo. Upućeno je tebi, $n."
      },
      "name": "Syurna",
