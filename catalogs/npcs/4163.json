    "trTR": {
      "dialogue": {
        "04d475021a35cf3e3971": "Biz yalnızca karanlık ve gölgeleriz. Ebedi. Görünmez.",
        "3c910ad21e30f6a40f44": "Eğitim arıyorum.",
        "47aa35ea048080f59ec0": "Nagalar Ashenvale'deki Zoram Sahili'ni istila ettiğinde birçok kilitli erzak sandığı kayboldu.",
        "9bcadd6b788c31acb9f5": "Sıkı bir yeniden eğitimle pek çok öğrencime daha önce öğrendiklerini unutturup onları baştan eğittim. Bu hizmet her tekrarlandığında zorlaşır ve bu yüzden pahalılaşır. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?",
        "b6974a67050985b2e2a9": "Selamlar genç haydut. Ne arıyorsun?",
        "d7b8c54389b198a89904": "Ravenholdt’tan gelen haberciler bu sabah bana bu mektubu getirdi. Sana hitaben yazılmış, $n."
      },
      "name": "Syurna",
      "translationMetadata": {
        "fields": {
