    "daDK": {
      "dialogue": {
        "04d475021a35cf3e3971": "Vi er kun mørke og skygger. Evige. Usynlige.",
        "3c910ad21e30f6a40f44": "Jeg søger træning.",
        "47aa35ea048080f59ec0": "Mange aflåste forsyningskasser gik tabt, da nagaerne løb Zoram Strand i Ashenvale over ende.",
        "9bcadd6b788c31acb9f5": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "b6974a67050985b2e2a9": "Hilsen, unge slyngel. Hvad søger du?",
        "d7b8c54389b198a89904": "Sendebud fra Ravenholdt gav mig dette brev i morges. Det er adresseret til dig, $n."
      },
      "name": "Syurna",
      "translationMetadata": {
        "fields": {
          "dialogue.04d475021a35cf3e3971": {
