    "hrHR": {
      "dialogue": {
        "2fad82349665b4a172c4": "Bi li radije povjerio svoje stvari goblinu?",
        "bae2d9f4e57e6ab55d37": "Osim stražara vani, moja braća i ja borili smo se u bitci za Hyjal. Svatko tko pokuša opljačkati banku prvo mora proći nas.",
        "fb2a650422d743e0f803": "Za sigurnost ove banke jamčim vlastitom krvlju. Je li ti to dovoljno?",
        "zephras:54fef075e1b4e38f411e": "Želim pogledati svoj bankovni sef."
      },
      "name": "Soran",
