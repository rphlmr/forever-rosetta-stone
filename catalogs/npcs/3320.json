    "esES": {
      "dialogue": {
        "2fad82349665b4a172c4": "¿Preferirías confiar tus cosas a un goblin?",
        "bae2d9f4e57e6ab55d37": "Además de los Brutos, mis hermanos y yo luchamos en la batalla de Hyjal. Y el que intente robar el banco tendrá que vérselas primero con nosotros.",
        "fb2a650422d743e0f803": "Protejo la seguridad de este banco con mi propia sangre, ¿es eso suficiente para ti?",
        "zephras:54fef075e1b4e38f411e": "Desearía revisar mi caja fuerte."
      },
      "name": "Soran",
      "subName": "Banquero",
