  "locales": {
    "csCZ": {
      "dialogue": {
        "2fad82349665b4a172c4": "Raději bys svěřil své věci goblinovi?",
        "bae2d9f4e57e6ab55d37": "Stejně jako vojáci venku jsme i moji bratři a já bojovali v bitvě o Hyjal. Každý, kdo by chtěl banku vykrást, musí nejprve projít přes nás.",
        "fb2a650422d743e0f803": "Za bezpečnost této banky ručím vlastní krví. Stačí ti to?",
        "zephras:54fef075e1b4e38f411e": "Chtěl bych se podívat do své bezpečnostní schránky."
      },
      "name": "Soran",
      "translationMetadata": {
        "fields": {
          "dialogue.2fad82349665b4a172c4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
