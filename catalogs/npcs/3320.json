    "ptBR": {
      "dialogue": {
        "2fad82349665b4a172c4": "Você prefere deixar seus bens com um goblin?",
        "bae2d9f4e57e6ab55d37": "Além da presença dos Brutos lá fora, meus irmãos e eu lutamos na batalha de Hyjal. Qualquer um que queira assaltar o banco vai ter que nos enfrentar antes.",
        "fb2a650422d743e0f803": "Garanto a segurança deste banco com meu próprio sangue, para você basta?",
        "zephras:54fef075e1b4e38f411e": "Gostaria de conferir meu cofre."
      },
      "name": "Soran",
      "subName": "Caixa do Banco",
