    "plPL": {
      "dialogue": {
        "2fad82349665b4a172c4": "Wolisz powierzyć swój dobytek goblinowi?",
        "bae2d9f4e57e6ab55d37": "Podobnie jak żołnierze na zewnątrz, moi bracia i ja walczyliśmy pod Hyjal. Każdy, kto zechce okraść bank, najpierw będzie musiał zmierzyć się z nami.",
        "fb2a650422d743e0f803": "Ręczę własną krwią za bezpieczeństwo tego banku. Czy to ci wystarczy?",
        "zephras:54fef075e1b4e38f411e": "Chcę zajrzeć do swojej skrytki bankowej."
      },
      "name": "Soran",
      "translationMetadata": {
