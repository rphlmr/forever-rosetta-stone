          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "2fad82349665b4a172c4": "Vil du hellere betro dine ejendele til en goblin?",
        "bae2d9f4e57e6ab55d37": "Ligesom soldaterne udenfor kæmpede mine brødre og jeg i slaget ved Hyjal. Enhver, der vil stjæle fra banken, må først forbi os.",
        "fb2a650422d743e0f803": "Jeg garanterer denne banks sikkerhed med mit eget blod. Er det godt nok for dig?",
        "zephras:54fef075e1b4e38f411e": "Jeg vil gerne se i min bankboks."
      },
      "name": "Soran",
      "translationMetadata": {
        "fields": {
          "dialogue.2fad82349665b4a172c4": {
            "origin": "ai",
