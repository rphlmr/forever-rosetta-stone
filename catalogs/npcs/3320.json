    "enUS": {
      "dialogue": {
        "2fad82349665b4a172c4": "Would you rather trust your goods with a goblin?",
        "bae2d9f4e57e6ab55d37": "Besides the Grunts outside, my brothers and I fought at the battle of Hyjal. Any who seek to steal from the bank must face us first.",
        "fb2a650422d743e0f803": "I guarantee this bank's security with my own blood, is that good enough for you?",
        "zephras:54fef075e1b4e38f411e": "I would like to check my deposit box."
      },
      "name": "Soran",
      "subName": "Banker",
      "translationMetadata": {
