    "itIT": {
      "dialogue": {
        "2fad82349665b4a172c4": "Preferiresti affidare i tuoi averi a un goblin?",
        "bae2d9f4e57e6ab55d37": "Oltre ai Grunt là fuori, io e i miei fratelli abbiamo combattuto nella battaglia di Hyjal. Chiunque provi a derubare la banca dovrà prima vedersela con noi.",
        "fb2a650422d743e0f803": "Garantisco la sicurezza di questa banca con il mio stesso sangue, ti basta?",
        "zephras:54fef075e1b4e38f411e": "Vorrei controllare la mia cassetta di sicurezza."
      },
      "name": "Soran",
      "translationMetadata": {
        "fields": {
