    "ltLT": {
      "dialogue": {
        "2fad82349665b4a172c4": "Ar mieliau patikėtum savo turtą goblinui?",
        "bae2d9f4e57e6ab55d37": "Kaip ir lauke stovintys kariai, mudu su broliais kovojome Hyjal mūšyje. Kiekvienam, kas mėgins apiplėšti banką, pirmiausia teks susidurti su mumis.",
        "fb2a650422d743e0f803": "Šio banko saugumą garantuoju savo krauju. Ar tau to gana?",
        "zephras:54fef075e1b4e38f411e": "Norėčiau patikrinti savo seifo dėžutę."
      },
      "name": "Soran",
      "subName": "Bankininkas",
