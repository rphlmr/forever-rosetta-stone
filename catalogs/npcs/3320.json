        }
      }
    },
    "deDE": {
      "dialogue": {
        "2fad82349665b4a172c4": "Würdet Ihr Eure Waren lieber einem Goblin anvertrauen?",
        "bae2d9f4e57e6ab55d37": "Außer gegen die Grunzer da draußen kämpften meine Brüder und ich in der Schlacht von Hyjal. Alle, die die Bank bestehlen wollen, bekommen es zuerst mit uns zu tun.",
        "fb2a650422d743e0f803": "Ich garantiere mit meinem Blut für die Sicherheit dieser Bank, genügt Euch das?",
        "zephras:54fef075e1b4e38f411e": "Ich möchte einen Blick in mein Schließfach werfen."
      },
      "name": "Soran",
      "subName": "Bankier",
