    "svSE": {
      "dialogue": {
        "2fad82349665b4a172c4": "Skulle du hellre anförtro dina ägodelar åt en goblin?",
        "bae2d9f4e57e6ab55d37": "Precis som soldaterna utanför kämpade mina bröder och jag i slaget vid Hyjal. Den som försöker stjäla från banken måste först möta oss.",
        "fb2a650422d743e0f803": "Jag garanterar bankens säkerhet med mitt eget blod. Räcker det för dig?",
        "zephras:54fef075e1b4e38f411e": "Jag skulle vilja titta i mitt bankfack."
      },
      "name": "Soran",
