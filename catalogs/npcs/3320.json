    "trTR": {
      "dialogue": {
        "2fad82349665b4a172c4": "Eşyalarını bir gobline emanet etmeyi mi tercih edersin?",
        "bae2d9f4e57e6ab55d37": "Dışarıdaki askerler gibi kardeşlerim ve ben de Hyjal Savaşı'nda çarpıştık. Bankadan çalmaya kalkışan herkes önce bizimle yüzleşmek zorunda.",
        "fb2a650422d743e0f803": "Bu bankanın güvenliğini kendi kanımla garanti ediyorum. Senin için yeterli mi?",
        "zephras:54fef075e1b4e38f411e": "Kasamı kontrol etmek istiyorum."
      },
      "name": "Soran",
