    "frFR": {
      "dialogue": {
        "2fad82349665b4a172c4": "Vous préférez confier vos biens à un gobelin ?",
        "bae2d9f4e57e6ab55d37": "En plus des grunts, dehors, mes frères et moi avons combattu à la bataille de Hyjal. Quiconque cherche à voler la banque devra d'abord nous affronter.",
        "fb2a650422d743e0f803": "Je garantis la sécurité de cette banque avec mon propre sang. Ça vous suffit ?",
        "zephras:54fef075e1b4e38f411e": "J'aimerais regarder le contenu de mon coffre."
      },
      "name": "Soran",
      "subName": "Banquier",
