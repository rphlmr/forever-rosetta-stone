        }
      }
    },
    "trTR": {
      "dialogue": {
        "78da01a4df197228ba00": "Kardeşim bu ticaret yolundan çok para kazanabileceğimizi söyledi ama bu tarafta yaşayacak kişinin ben olacağını söylemedi. Zeplinle buraya geri gelirsen bana yiyecek bir şey getirir misin? Orgrimmar'da çok güzel etler satılıyor; hareket etmeyi bırakmadan haftalar önce ölmemiş bir şeyler yesem iyi olurdu."
      },
      "name": "Zapetta",
      "translationMetadata": {
        "fields": {
          "dialogue.78da01a4df197228ba00": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
