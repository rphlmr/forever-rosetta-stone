    "hrHR": {
      "dialogue": {
        "78da01a4df197228ba00": "Brat je rekao da na ovoj trgovačkoj ruti možemo dobro zaraditi, ali nije mi rekao da ću ja živjeti na ovoj strani. Ako se vratiš cepelinom, možeš li mi donijeti nešto za jelo? U Orgrimmaru prodaju izvrsno meso, a dobro bi mi došlo nešto što nije umrlo tjednima prije nego što se prestalo micati."
      },
      "name": "Zapetta",
      "translationMetadata": {
        "fields": {
          "dialogue.78da01a4df197228ba00": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
