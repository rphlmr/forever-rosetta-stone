    "enUS": {
      "dialogue": {
        "78da01a4df197228ba00": "My brother said we could make great money with this trade route, but he didn't tell me I would be the one living on this side. If you come back this way on the Zeppelin, could you bring me something to eat? They sell some of the finest meat in Orgrimmar, and I sure could use something that didn't die weeks before it stopped moving."
      },
      "name": "Zapetta",
      "subName": "Zeppelin Master",
      "translationMetadata": {
        "fields": {
          "dialogue.78da01a4df197228ba00": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
          },
          "name": {
            "origin": "original",
