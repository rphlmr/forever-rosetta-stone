            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "78da01a4df197228ba00": "Брат казав, що на цьому торговому шляху ми добре заробимо, але не сказав, що саме мені доведеться жити на цьому боці. Якщо повертатимешся сюди дирижаблем, принесеш мені щось поїсти? В Орґріммарі продають чудове м'ясо, а мені б не завадило щось таке, що не померло за кілька тижнів до того, як перестало рухатися."
      },
      "name": "Запетта",
      "translationMetadata": {
        "fields": {
          "dialogue.78da01a4df197228ba00": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
