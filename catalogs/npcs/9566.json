            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "78da01a4df197228ba00": "Meu irmão me disse que a gente ia ganhar um dinheirão com esta rota, mas ele não me disse que seria eu o otário vivendo do lado de cá. Se você voltar pra cá no zepelim, dava pra me trazer comida? Eles vendem carne de primeira em Orgrimmar. Como seria bom comer carne que não morreu semanas antes de parar de se mexer."
      },
      "name": "Zapetta",
      "subName": "Mestre de Zepelins",
      "translationMetadata": {
        "fields": {
