    "enUS": {
      "dialogue": {
        "0e82ddf42b79585a326a": "Train me.",
        "250c0f1d2a6a55705368": "So you would like to learn a few things? I would be happy to get you started!",
        "6a18dc3202f3a8972e2d": "I can tell that your wardrobe is in dire need of care.",
        "d9a34f17fbd852938f11": "I'm a simple man who knows a few things about tailoring, but you need more assistance than I can provide. I have heard of a Night Elf who is quite an accomplished tailor. He resides in Stormwind, in the Magic District. "
      },
      "name": "Eldrin",
      "subName": "Journeyman Tailor",
      "translationMetadata": {
