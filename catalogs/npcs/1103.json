    },
    "daDK": {
      "dialogue": {
        "0e82ddf42b79585a326a": "Træn mig.",
        "250c0f1d2a6a55705368": "Så du vil gerne lære et par ting? Jeg hjælper dig gerne i gang!",
        "6a18dc3202f3a8972e2d": "Jeg kan se, at din garderobe trænger hårdt til pleje.",
        "d9a34f17fbd852938f11": "Jeg er en simpel mand, der ved lidt om skrædderi, men du har brug for mere hjælp, end jeg kan give. Jeg har hørt om en natelver, der er en dygtig skrædder. Han bor i Stormwinds magikvarter."
      },
      "name": "Eldrin",
      "translationMetadata": {
        "fields": {
          "dialogue.0e82ddf42b79585a326a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
