  "locales": {
    "csCZ": {
      "dialogue": {
        "0e82ddf42b79585a326a": "Vycvičte mě.",
        "250c0f1d2a6a55705368": "Chceš se tedy něčemu přiučit? Rád ti pomohu začít!",
        "6a18dc3202f3a8972e2d": "Vidím, že tvůj šatník zoufale potřebuje péči.",
        "d9a34f17fbd852938f11": "Jsem prostý člověk, který něco málo ví o krejčovství, ale potřebuješ víc pomoci, než ti mohu poskytnout. Slyšel jsem o nočním elfovi, který je velmi schopným krejčím. Žije ve Stormwindu v Magické čtvrti."
      },
      "name": "Eldrin",
      "translationMetadata": {
        "fields": {
          "dialogue.0e82ddf42b79585a326a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
