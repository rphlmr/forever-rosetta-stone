    "daDK": {
      "dialogue": {
        "14881b22fadc6d8c75c7": "Nu er det tid, hvor året er nyt, og månen skinner klart.$B$BDet er vores tid... når de gamle vågner.",
        "2b7ca7617c18f2509319": "Ældste Bladeswift vandrer ad Darnassus’ stier på toppen af Teldrassil.",
        "9a179fceb2230669621a": "Ældste Stormbrow er sandsynligvis i landsbyen Goldshire i Elwynn Forest.",
        "de95b4ae34c3360a9fac": "Ældste Rumblerock tilbringer årene i en hule på toppen af Dreadmaul Rock i Burning Steppes.",
        "f32702f018c64a69cf0f": "Ældste Bronzebeard findes i Bronzebeard-slægtens gamle hjem, Ironforge."
      },
      "name": "Ældste Hammershout",
      "translationMetadata": {
