    "plPL": {
      "dialogue": {
        "14881b22fadc6d8c75c7": "Nadszedł czas, gdy rok jest nowy, a księżyc jasno świeci.$B$BTo nasz czas... gdy pradawni się budzą.",
        "2b7ca7617c18f2509319": "Starszy Bladeswift przemierza ścieżki Darnassus na szczycie Teldrassilu.",
        "9a179fceb2230669621a": "Starszy Stormbrow przebywa najpewniej w wiosce Goldshire w Elwynn Forest.",
        "de95b4ae34c3360a9fac": "Starszy Rumblerock spędza lata w jaskini na szczycie Dreadmaul Rock w Burning Steppes.",
        "f32702f018c64a69cf0f": "Starszego Bronzebearda znajdziesz w rodowej siedzibie Bronzebeardów, Ironforge."
      },
      "name": "Starszy Hammershout",
