    "enUS": {
      "dialogue": {
        "14881b22fadc6d8c75c7": "Now is the time when the year is new and the moon shines bright.$B$BIt is our time... when the ancients awake.",
        "2b7ca7617c18f2509319": "Elder Bladeswift wanders the paths of Darnassus atop Teldrassil.",
        "9a179fceb2230669621a": "Elder Stormbrow is most likely at the village of Goldshire in Elwynn Forest.",
        "de95b4ae34c3360a9fac": "Elder Rumblerock passes the years in a cave atop Dreadmaul Rock in the Burning Steppes.",
        "f32702f018c64a69cf0f": "Elder Bronzebeard can be found in the ancestral home of the Bronzebeards, Ironforge."
      },
      "name": "Elder Hammershout",
      "translationMetadata": {
