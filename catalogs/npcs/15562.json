  "locales": {
    "csCZ": {
      "dialogue": {
        "14881b22fadc6d8c75c7": "Nastal čas nového roku, kdy měsíc jasně září.$B$BJe to náš čas... kdy se prastarci probouzejí.",
        "2b7ca7617c18f2509319": "Stařešina Bladeswift putuje po stezkách Darnassu na vrcholku Teldrassilu.",
        "9a179fceb2230669621a": "Stařešina Stormbrow je nejspíš ve vesnici Goldshire v Elwynn Forest.",
        "de95b4ae34c3360a9fac": "Stařešina Rumblerock tráví roky v jeskyni na vrcholku Dreadmaul Rock v Burning Steppes.",
        "f32702f018c64a69cf0f": "Stařešinu Bronzebearda najdeš v domově předků Bronzebeardů, v Ironforge."
      },
      "name": "Starší Hammershout",
