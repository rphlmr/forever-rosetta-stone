    "hrHR": {
      "dialogue": {
        "3149f6d1d8f438ad51e4": "Zanima me poduka u umijeću vještaca.",
        "3b02d4a0ba0102159a0c": "Tama te ne grli, $c. Prestani brbljati i makni mi se s očiju! Odlazi!",
        "8eb0feb5b6dfa91e3c83": "Arkanska magija kvari samo slabe. Nastavi s obukom ili bi te mogla zadesiti slična sudbina.",
        "97b4d0dfa2954d8ac38f": "Strogim ponovnim obučavanjem morala sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogla podučavati iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako ponovno obučavanje postaje skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "b7f63028dfe039ef4af0": "Zanima me poduka u umijeću vještaca."
      },
      "name": "Demisette Cloyce",
