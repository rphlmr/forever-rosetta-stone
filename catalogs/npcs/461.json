    "svSE": {
      "dialogue": {
        "3149f6d1d8f438ad51e4": "Jag är intresserad av träning som svartkonstnär.",
        "3b02d4a0ba0102159a0c": "Mörkret omfamnar dig inte, $c. Sluta pladdra och försvinn ur min åsyn! Ge dig av!",
        "8eb0feb5b6dfa91e3c83": "Den arkana magin korrumperar bara de svaga. Fortsätt din träning, annars kan samma öde drabba dig.",
        "97b4d0dfa2954d8ac38f": "Genom grundlig omskolning har jag fått många elever att lägga allt de tidigare lärt sig åt sidan, så att jag kunnat lära dem på nytt. Den tjänsten blir svårare att utföra varje gång den upprepas. Därför blir varje omskolning också dyrare. Vill du att jag hjälper dig att glömma de talanger du har lärt dig?",
        "b7f63028dfe039ef4af0": "Jag är intresserad av träning som svartkonstnär."
      },
      "name": "Demisette Cloyce",
