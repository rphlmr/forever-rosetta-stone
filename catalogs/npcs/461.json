    "daDK": {
      "dialogue": {
        "3149f6d1d8f438ad51e4": "Jeg er interesseret i træning som troldmand.",
        "3b02d4a0ba0102159a0c": "Mørket omfavner dig ikke, $c. Hold op med at plapre og forsvind fra mit åsyn! Ud!",
        "8eb0feb5b6dfa91e3c83": "Den arkane magi fordærver kun de svage. Hold din træning ved lige, ellers kan samme skæbne ramme dig.",
        "97b4d0dfa2954d8ac38f": "Gennem grundig omskoling har jeg måttet få mange elever til at aflære alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre, hver gang den gentages. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at aflære de talenter, du har lært?",
        "b7f63028dfe039ef4af0": "Jeg er interesseret i træning som troldmand."
      },
      "name": "Demisette Cloyce",
      "translationMetadata": {
        "fields": {
