    "daDK": {
      "dialogue": {
        "c745e6c09192edbac62d": "Din krop ser slidt ud og din ånd træt. Hvil dig under vores tag, og lad Elune vejlede dine drømme.",
        "e1a3c589727155b45998": "Er du interesseret i at udforske en af disse dungeons?"
