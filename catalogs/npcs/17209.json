    "frFR": {
      "dialogue": {
        "b6753306034c473c6787": "Ne vous inquiétez pas... même si mes gryphons ne sont pas complètement achevés, ils vous porteront sans problème jusqu’à votre destination. Dites-moi, quelle tour cherchez-vous ?"
      },
      "name": "William Kielar",
      "subName": "Maître des gryphons spectraux",
