    "hrHR": {
      "dialogue": {
        "b6753306034c473c6787": "Ne brini... moji grifoni možda nisu sasvim čitavi, ali ipak će te vjerno odnijeti na odredište. Reci mi... koju kulu tražiš?"
      },
      "name": "William Kielar",
      "translationMetadata": {
