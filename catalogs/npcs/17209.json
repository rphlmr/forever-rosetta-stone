          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "b6753306034c473c6787": "Keine Sorge... meine Greifen sind vielleicht nicht mehr so sattelfest, aber sie werden Euch noch immer getreu an Euer Ziel bringen. Also... zu welchem Turm möchtet Ihr?"
      },
      "name": "William Kielar",
      "subName": "Spektraler Greifenmeister",
      "translationMetadata": {
        "fields": {
          "dialogue.b6753306034c473c6787": {
