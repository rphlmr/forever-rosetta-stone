    "trTR": {
      "dialogue": {
        "b6753306034c473c6787": "Korkma... grifonlarım tamamen sağlam olmayabilir ama seni yine de sadakatle hedefine ulaştırırlar. Söyle bakalım... hangi kuleyi arıyorsun?"
      },
      "name": "William Kielar",
      "translationMetadata": {
        "fields": {
