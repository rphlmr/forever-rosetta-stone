    "plPL": {
      "dialogue": {
        "b6753306034c473c6787": "Nie lękaj się... moje gryfy może nie są całkiem w jednym kawałku, ale i tak wiernie doniosą cię do celu. Powiedz mi... której wieży szukasz?"
      },
      "name": "William Kielar",
      "translationMetadata": {
