            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "b6753306034c473c6787": "Bliv ikke forskrækket... mine griffer er måske ikke helt hele, men de vil stadig trofast bringe dig frem til dit mål. Sig mig... hvilket tårn søger du?"
      },
      "name": "William Kielar",
      "translationMetadata": {
        "fields": {
          "dialogue.b6753306034c473c6787": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
