    "itIT": {
      "dialogue": {
        "b6753306034c473c6787": "Non allarmarti... anche se i miei grifoni non sono proprio tutti interi, ti porteranno comunque fedelmente a destinazione. Dimmi... quale torre cerchi?"
      },
      "name": "William Kielar",
      "translationMetadata": {
