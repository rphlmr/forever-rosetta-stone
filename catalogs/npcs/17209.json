    "enUS": {
      "dialogue": {
        "b6753306034c473c6787": "Don't be alarmed... while my gryphons may not be entirely whole, they will still carry you faithfully to your destination. Tell me... which tower do you seek?"
      },
      "name": "William Kielar",
      "subName": "Spectral Gryphon Master",
