  "locales": {
    "csCZ": {
      "dialogue": {
        "b6753306034c473c6787": "Nelekejte se... mí gryfové sice možná nejsou úplně vcelku, ale do cíle vás přesto věrně donesou. Povězte mi... kterou věž hledáte?"
      },
      "name": "William Kielar",
      "translationMetadata": {
        "fields": {
          "dialogue.b6753306034c473c6787": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
