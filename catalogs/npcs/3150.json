  "locales": {
    "csCZ": {
      "dialogue": {
        "9eec1afda825c277ffb9": "Tohle je ten nejlepší a nejmodernější dopravní prostředek, jaký lze za peníze postavit. Cože? Deeprun Tram? Gnómové? Poslyš, kamaráde, jestli těm nesmyslům věříš, mám na prodej sochu ve Stranglethornu. Tak co, půjdeš do Grom'Golu pěšky, nebo poletíš stylově v tomhle skvělém létajícím stroji? Je to na tobě."
      },
      "name": "Hin Denburg",
      "translationMetadata": {
        "fields": {
          "dialogue.9eec1afda825c277ffb9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
