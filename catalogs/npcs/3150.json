    "enUS": {
      "dialogue": {
        "9eec1afda825c277ffb9": "This here is the finest, most state of the art mode of transportation money can build. What? Deeprun Tram? Gnomes? Listen pal, If you believe that garbage then I've got a statue down in Stranglethorn to sell ya. Now, are you walking to Grom'Gol or are you gonna ride in style in this fine flying machine? Your choice."
      },
      "name": "Hin Denburg",
      "subName": "Zeppelin Master",
      "translationMetadata": {
        "fields": {
          "dialogue.9eec1afda825c277ffb9": {
            "origin": "community",
