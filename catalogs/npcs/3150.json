            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "9eec1afda825c277ffb9": "Det her er det fineste og mest avancerede transportmiddel, penge kan bygge. Hvad? Deeprun Tram? Gnomer? Hør her, ven, hvis du tror på det vrøvl, har jeg en statue i Stranglethorn, jeg gerne vil sælge dig. Så vil du gå til Grom'Gol, eller vil du rejse med stil i denne fine flyvemaskine? Du bestemmer."
      },
      "name": "Hin Denburg",
      "translationMetadata": {
        "fields": {
          "dialogue.9eec1afda825c277ffb9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
