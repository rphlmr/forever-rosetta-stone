    "plPL": {
      "dialogue": {
        "4021410830bf4c2c2987": "Duchy przywiodły cię do mnie. Jak mogę pomóc?",
        "9f633e52217e23853c61": "Naucz mnie ścieżek duchów.",
        "db4db5f6ebcd87dae205": "Niech duchy będą z tobą.",
        "e0e3942ff78f551bc128": "Dzięki rygorystycznemu przekwalifikowaniu musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc uczyć ich od nowa. Z każdym razem ta usługa staje się trudniejsza, a przez to droższa. Czy chcesz, bym pomógł ci zapomnieć poznane talenty?"
      },
      "name": "Swart",
      "translationMetadata": {
