  "locales": {
    "csCZ": {
      "dialogue": {
        "4021410830bf4c2c2987": "Duchové tě přivedli ke mně. Jak ti mohu posloužit?",
        "9f633e52217e23853c61": "Nauč mě cestám duchů.",
        "db4db5f6ebcd87dae205": "Ať jsou duchové s tebou.",
        "e0e3942ff78f551bc128": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl vyučit znovu. Tuto službu je pokaždé těžší provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučil tvým talentům?"
      },
      "name": "Swart",
      "translationMetadata": {
        "fields": {
          "dialogue.4021410830bf4c2c2987": {
            "origin": "ai",
