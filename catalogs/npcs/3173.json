    "trTR": {
      "dialogue": {
        "4021410830bf4c2c2987": "Ruhlar seni bana yönlendirdi. Sana nasıl yardımcı olabilirim?",
        "9f633e52217e23853c61": "Bana ruhların yollarını öğret.",
        "db4db5f6ebcd87dae205": "Ruhlar seninle olsun.",
        "e0e3942ff78f551bc128": "Birçok öğrenciyi yeniden eğitmek için sıkı bir çalışmayla daha önce öğrendikleri her şeyi unutturmam gerekti. Sunduğum bu hizmet her uygulandığında zorlaşıyor. Bu nedenle her yeniden eğitimde daha pahalıya mal oluyor. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?"
      },
      "name": "Swart",
