    "ltLT": {
      "dialogue": {
        "4021410830bf4c2c2987": "Dvasios atvedė tave pas mane. Kuo galiu padėti?",
        "9f633e52217e23853c61": "Išmokyk mane dvasių kelio.",
        "db4db5f6ebcd87dae205": "Tegul dvasios būna su tavimi.",
        "e0e3942ff78f551bc128": "Griežtai permokydamas turėjau padėti daugeliui mokinių atsisakyti visko, ko jie buvo išmokę, kad galėčiau mokyti juos iš naujo. Kaskart ši paslauga tampa vis sunkesnė, todėl ir jos kaina kaskart didėja. Ar nori, kad padėčiau tau atsisakyti išmoktų talentų?"
      },
      "name": "Swart",
      "subName": "Šamanų mokytojas",
