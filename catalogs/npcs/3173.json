    "daDK": {
      "dialogue": {
        "4021410830bf4c2c2987": "Ånderne har ført dig til mig. Hvordan kan jeg hjælpe?",
        "9f633e52217e23853c61": "Lær mig åndernes veje.",
        "db4db5f6ebcd87dae205": "Må ånderne være med dig.",
        "e0e3942ff78f551bc128": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?"
      },
      "name": "Swart",
      "translationMetadata": {
        "fields": {
          "dialogue.4021410830bf4c2c2987": {
            "origin": "ai",
