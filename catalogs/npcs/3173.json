    "hrHR": {
      "dialogue": {
        "4021410830bf4c2c2987": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "9f633e52217e23853c61": "Nauči me putovima duhova.",
        "db4db5f6ebcd87dae205": "Neka duhovi budu s tobom.",
        "e0e3942ff78f551bc128": "Strogom sam preobukom mnoge učenike morao odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Tu je uslugu svaki put sve teže pružiti, pa je zato svakom preobukom sve skuplja. Želiš li da te odviknem od naučenih talenata?"
      },
      "name": "Swart",
