    "svSE": {
      "dialogue": {
        "4021410830bf4c2c2987": "Andarna har lett dig till mig. Hur kan jag stå till tjänst?",
        "9f633e52217e23853c61": "Lär mig andarnas vägar.",
        "db4db5f6ebcd87dae205": "Må andarna vara med dig.",
        "e0e3942ff78f551bc128": "Genom sträng omskolning har jag fått många elever att glömma allt de tidigare lärt sig så att jag kan undervisa dem på nytt. Tjänsten blir svårare att utföra varje gång och därför också dyrare. Vill du att jag får dig att glömma dina inlärda talanger?"
      },
      "name": "Swart",
