    "plPL": {
      "dialogue": {
        "5fc586b4433e7f4bca14": "Moja rodzina pracowała w tartaku Northridge na terenach dzisiejszych Zachodnich Ziem Plagi. Byli oddani rodzinie Dumah, a teraz Szkarłatna Krucjata przejęła tartak i całe Hearthglen!$B$BNie spocznę, dopóki ci fanatycy nie znikną z Azeroth."
      },
      "name": "Mickey Levine",
      "translationMetadata": {
