  "locales": {
    "csCZ": {
      "dialogue": {
        "5fc586b4433e7f4bca14": "Má rodina pracovala v pile Northridge na území dnešních Západních morových zemí. Byli oddáni rodině Dumahových, ale teď pilu spolu s celým Hearthglenem zabrala Šarlatová křížová výprava!$B$BNeodpočinu si, dokud ti fanatici nebudou z Azerothu vyhlazeni."
      },
      "name": "Mickey Levine",
      "translationMetadata": {
        "fields": {
          "dialogue.5fc586b4433e7f4bca14": {
