    },
    "daDK": {
      "dialogue": {
        "5fc586b4433e7f4bca14": "Min familie arbejdede på Northridge-savværket i det, der nu er Western Plaguelands. De var tro mod familien Dumah, men nu har Scarlet Crusade overtaget savværket og hele Hearthglen!$B$BJeg hviler ikke, før de fanatikere er udryddet fra Azeroth."
      },
      "name": "Mickey Levine",
      "translationMetadata": {
        "fields": {
          "dialogue.5fc586b4433e7f4bca14": {
