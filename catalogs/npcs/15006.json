    "ltLT": {
      "dialogue": {
        "15ca5111c5034d06749f": "Atsiprašau, $c, bet turi tapti galingesnis, kad galėčiau leisti tau įžengti į Arathi Basin.",
        "aaebd419ce4915d659ab": "Žmonės ir jų vadinamoji League of Arathor mano galintys išstumti mus iš Arathi Basin.  Aš taip nemanau, $c!  Ar esi pasirengęs keliauti ten ir parodyti, kad netrukus iš čia pasitrauks jie, o ne The Defilers?",
        "b8b5614eb5feea92be38": "Leisk apžiūrėti tavo prekes."
      },
      "name": "Deze Snowbane",
      "subName": "Arathi Basin kovų meistras",
