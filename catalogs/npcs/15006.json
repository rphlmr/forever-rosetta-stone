    "hrHR": {
      "dialogue": {
        "15ca5111c5034d06749f": "Žao mi je, $c, ali moraš biti snažniji prije nego što ti dopustim ulazak u Arathi Basin.",
        "aaebd419ce4915d659ab": "Ljudi i njihova takozvana Liga Arathora misle nas istjerati iz Arathi Basina. Neće moći, $c! Jesi li spreman otići tamo i pokazati im da će uskoro otići oni, a ne Skrnavitelji?",
        "b8b5614eb5feea92be38": "Dopustite mi da pogledam vašu robu."
      },
      "name": "Deze Snowbane",
      "translationMetadata": {
