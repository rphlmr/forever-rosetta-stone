    "enUS": {
      "dialogue": {
        "15ca5111c5034d06749f": "I am sorry $c, but you need to be more powerful before I can allow you to enter Arathi Basin.",
        "aaebd419ce4915d659ab": "The humans and their so-called League of Arathor think to push us out of Arathi Basin.  I think not $c!  Are you ready to be sent there and demonstrate that it is they, and not The Defilers, that will be leaving soon?",
        "b8b5614eb5feea92be38": "Let me browse your goods."
      },
      "name": "Deze Snowbane",
      "subName": "Arathi Basin Battlemaster",
      "translationMetadata": {
        "fields": {
