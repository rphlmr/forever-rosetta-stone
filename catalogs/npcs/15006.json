  "locales": {
    "csCZ": {
      "dialogue": {
        "15ca5111c5034d06749f": "Je mi líto, $c, ale musíš být silnější, než ti dovolím vstoupit do Arathijské pánve.",
        "aaebd419ce4915d659ab": "Lidé a jejich takzvaná Liga Arathoru si myslí, že nás vytlačí z Arathijské pánve. To tedy ne, $c! Jsi připraven vydat se tam a ukázat jim, že brzy odejdou oni, a ne Znesvětitelé?",
        "b8b5614eb5feea92be38": "Dovolte mi prohlédnout si vaše zboží."
      },
      "name": "Deze Snowbane",
      "translationMetadata": {
        "fields": {
          "dialogue.15ca5111c5034d06749f": {
