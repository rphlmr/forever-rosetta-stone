          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "15ca5111c5034d06749f": "Beklager, $c, men du skal være stærkere, før jeg kan lade dig komme ind i Arathi Basin.",
        "aaebd419ce4915d659ab": "Menneskene og deres såkaldte League of Arathor tror, at de kan drive os ud af Arathi Basin. Det tror jeg ikke, $c! Er du klar til at blive sendt derhen og vise dem, at det er dem, ikke Defilers, der snart må forlade stedet?",
        "b8b5614eb5feea92be38": "Lad mig se dine varer."
      },
      "name": "Deze Snowbane",
      "translationMetadata": {
        "fields": {
          "dialogue.15ca5111c5034d06749f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
