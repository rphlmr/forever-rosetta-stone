    "csCZ": {
      "dialogue": {
        "5d727be96f0c4e5e5ada": "Bitva o Arathi Basin je bitvou o zdroje. Dřevo, ruda, jídlo... to vše je potřeba k vedení pořádné války.$B$BKdyž nepřátele připravíme o zásoby, bude to stejně účinné, jako je zabít na bojišti."
      },
      "name": "Lovec smrti Mortis",
      "translationMetadata": {
