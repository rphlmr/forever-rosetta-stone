    "daDK": {
      "dialogue": {
        "5d727be96f0c4e5e5ada": "Slaget om Arathi Basin er en kamp om ressourcer. Tømmer, malm, mad... alt dette er nødvendigt for at føre en ordentlig krig.$B$BAt nægte vores fjender forsyninger er lige så godt som at dræbe dem på slagmarken."
      },
      "name": "Dødsforfølger Mortis",
      "translationMetadata": {
        "fields": {
