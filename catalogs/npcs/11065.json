    "esMX": {
      "dialogue": {
        "2a4d11f56c38205416b8": "Entréname.",
        "365587171ae1e843d67a": "¡Eres un buen encantador, no hay duda! Es hora de que sigas tu camino. Quiero que hables con Gimble Cardopelusa, en el piso de arriba. Tiene bastante carácter, ¡pero a partir de ahora te mostrará el camino correcto!",
        "acdbf886409afa75312a": "Hay otras formas de reforzar el acero además del martillo y la forja, joven trotamundos. ¿Quieres saber más?",
        "dae21b6964fd1700f372": "Ah, ¿eres muy curioso eh? ¡Excelente! Presta mucha atención, ¡esto puedo salvarte el pellejo si las cosas se ponen feas!"
      },
