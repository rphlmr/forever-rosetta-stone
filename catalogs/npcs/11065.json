    "enUS": {
      "dialogue": {
        "2a4d11f56c38205416b8": "Train me.",
        "365587171ae1e843d67a": "Ye're a fine enchanter indeed! Now it's time fer ye to move on. I want ye to talk to Gimble Thistlefuzz, upstairs. He's a bit of a character, but he'll steer ye in the right direction from here on out!",
        "acdbf886409afa75312a": "There are ways to strengthen steel beyond the hammer and forge, young wanderer. Care to learn more?",
        "dae21b6964fd1700f372": "Ah, ye're an inquisitive one, are ye'? Excellent! Pay close attention, this just might save yer skin when the goin' gets rough!"
      },
      "name": "Thonys Pillarstone",
      "subName": "Journeyman Enchanter",
