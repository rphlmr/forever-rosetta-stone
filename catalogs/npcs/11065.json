    "ltLT": {
      "dialogue": {
        "2a4d11f56c38205416b8": "Pamokyk mane.",
        "365587171ae1e843d67a": "Tikrai esi puikus kerėtojas! Dabar laikas tau žengti toliau. Noriu, kad pasikalbėtum su Gimble Thistlefuzz viršuje. Jis kiek keistokas, bet parodys tau tolesnį kelią!",
        "acdbf886409afa75312a": "Yra būdų sutvirtinti plieną ne vien kūju ir kalve, jaunasis klajūne. Nori sužinoti daugiau?",
        "dae21b6964fd1700f372": "Ak, smalsumo tau netrūksta, ar ne? Puiku! Atidžiai klausykis, tai gali išgelbėti tavo kailį, kai pasidarys riesta!"
      },
      "name": "Thonys Pillarstone",
      "subName": "Kerėtojas pameistrys",
