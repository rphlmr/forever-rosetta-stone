  "locales": {
    "csCZ": {
      "dialogue": {
        "2a4d11f56c38205416b8": "Vycvičte mě.",
        "365587171ae1e843d67a": "Jsi opravdu zdatný kouzelník! Teď je čas jít dál. Promluv si nahoře s Gimblem Thistlefuzzem. Je to trochu podivín, ale dál už tě nasměruje správně!",
        "acdbf886409afa75312a": "Ocel lze zpevnit i jinak než kladivem a výhní, mladý poutníku. Chceš se dozvědět víc?",
        "dae21b6964fd1700f372": "Á, ty jsi zvědavý, viď? Výborně! Dávej dobrý pozor, až půjde do tuhého, mohlo by ti to zachránit kůži!"
      },
      "name": "Thonys Pillarstone",
      "translationMetadata": {
        "fields": {
          "dialogue.2a4d11f56c38205416b8": {
