    "plPL": {
      "dialogue": {
        "2a4d11f56c38205416b8": "Wyszkol mnie.",
        "365587171ae1e843d67a": "Znakomity z ciebie zaklinacz! Pora ruszać dalej. Porozmawiaj z Gimblem Thistlefuzzem na piętrze. To osobliwy typ, ale wskaże ci właściwą drogę!",
        "acdbf886409afa75312a": "Istnieją sposoby wzmacniania stali inne niż młot i kuźnia, młody wędrowcze. Chcesz dowiedzieć się więcej?",
        "dae21b6964fd1700f372": "Ach, ciekawska z ciebie osoba, co? Wspaniale! Słuchaj uważnie, to może uratować ci skórę, gdy zrobi się niebezpiecznie!"
      },
      "name": "Thonys Pillarstone",
      "translationMetadata": {
