    "ptBR": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Ensine-me os caminhos da fera.",
        "9e7ee68c2fd6ef1b146a": "Sinto muito, meu amigo. Eu só ajudo caçadores e as feras deles.",
        "a36c59dc197c91c2f777": "Você veio adquirir treinamento para as suas feras?",
        "zephras:a95be7bf314367c5a9af": "Quero que meu mascote esqueça suas habilidades."
      },
      "name": "Karrina Mekenda",
      "subName": "Adestramento",
