    "daDK": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Lær mig dyrets veje.",
        "9e7ee68c2fd6ef1b146a": "Åh, ven, jeg hjælper kun jægere og deres kæledyr.",
        "a36c59dc197c91c2f777": "Er du kommet for at lære, så du kan lære dine kæledyr det samme?",
        "zephras:a95be7bf314367c5a9af": "Jeg ønsker, at mit kæledyr skal glemme sine færdigheder."
      },
      "name": "Karrina Mekenda",
      "translationMetadata": {
