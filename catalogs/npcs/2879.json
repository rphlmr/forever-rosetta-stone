      "dialogue": {
        "2c3c27ae7b2485afc035": "Naucz mnie dróg bestii.",
        "9e7ee68c2fd6ef1b146a": "Ach, przyjacielu, pomagam tylko łowcom i ich zwierzętom.",
        "a36c59dc197c91c2f777": "Przybywasz na szkolenie, by przekazać wiedzę swoim zwierzętom?",
        "zephras:a95be7bf314367c5a9af": "Chcę, aby mój zwierzak zapomniał swoich umiejętności."
      },
