    "frFR": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Apprenez-moi les voies de la bête.",
        "9e7ee68c2fd6ef1b146a": "Ah ! Je n'aide que les chasseurs et leurs familiers.",
        "a36c59dc197c91c2f777": "Vous êtes là pour une formation qui vous permettrait de fortifier vos familiers ?",
        "zephras:a95be7bf314367c5a9af": "Je veux que mon familier oublie ses compétences."
      },
      "name": "Karrina Mekenda",
      "subName": "Maître des familiers",
