    "enUS": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Train me in the ways of the beast.",
        "9e7ee68c2fd6ef1b146a": "Ah friend, I only help hunters and their pets.",
        "a36c59dc197c91c2f777": "You've come for training in order to pass it on to your pets?",
        "zephras:a95be7bf314367c5a9af": "I wish to untrain my pet."
      },
      "name": "Karrina Mekenda",
      "subName": "Pet Trainer",
