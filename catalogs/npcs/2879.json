    "itIT": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Insegnami le vie della bestia.",
        "9e7ee68c2fd6ef1b146a": "Ah, amico, aiuto solo i cacciatori e i loro famigli.",
        "a36c59dc197c91c2f777": "Sei venuto ad addestrarti per poi insegnare ai tuoi famigli?",
        "zephras:a95be7bf314367c5a9af": "Desidero che il mio famiglio dimentichi le sue abilità."
      },
      "name": "Karrina Mekenda",
