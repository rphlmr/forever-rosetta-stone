    "hrHR": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Nauči me putevima zvijeri.",
        "9e7ee68c2fd6ef1b146a": "Ah, prijatelju, pomažem samo lovcima i njihovim ljubimcima.",
        "a36c59dc197c91c2f777": "Došao si na obuku kako bi naučeno prenio svojim ljubimcima?",
        "zephras:a95be7bf314367c5a9af": "Želim da moj ljubimac zaboravi svoje vještine."
      },
      "name": "Karrina Mekenda",
