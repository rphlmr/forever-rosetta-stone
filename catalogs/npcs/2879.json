    "deDE": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Lehrt mich die Wege des Wildtiers.",
        "9e7ee68c2fd6ef1b146a": "Ah, ich helfe nur Jägern und ihren Tieren.",
        "a36c59dc197c91c2f777": "Ihr seid zur Ausbildung hergekommen, um sie an Eure Tiere weiterzugeben?",
        "zephras:a95be7bf314367c5a9af": "Ich möchte, dass mein Begleiter alles verlernt."
      },
      "name": "Karrina Mekenda",
      "subName": "Tierausbilderin",
