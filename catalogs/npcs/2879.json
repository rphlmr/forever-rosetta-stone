  "locales": {
    "csCZ": {
      "dialogue": {
        "2c3c27ae7b2485afc035": "Nauč mě cestám šelmy.",
        "9e7ee68c2fd6ef1b146a": "Ach, příteli, pomáhám jen lovcům a jejich mazlíčkům.",
        "a36c59dc197c91c2f777": "Přišel ses vycvičit, abys pak mohl učit své mazlíčky?",
        "zephras:a95be7bf314367c5a9af": "Chci, aby můj mazlíček zapomněl své schopnosti."
      },
      "name": "Karrina Mekenda",
