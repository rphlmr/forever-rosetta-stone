  "locales": {
    "csCZ": {
      "dialogue": {
        "1660a3a28eb8f6b38d98": "Vycvičte mě.",
        "8633964ab897db1676a3": "Než ti budu moci pomoci, musíš se naučit základy. Promluv si s mým učedníkem Vhanem. Je laskavý a trpělivý a naučí tě vše potřebné.",
        "a2ce80c8daaf8ccb14aa": "Mé znalosti jsou omezené, ačkoli se stále učím. Je čas jít dál, poutníku. Najdi Josefa Gregoriana v Undercity a řekni mu, že jsi připraven.",
        "b279e7b7ec4ed22e0aec": "Nejsou ty vzory krásné? Každý promlouvá vlastním hlasem.",
        "ccd8559669421b954663": "Jsi skutečně odhodlaný student. Rád tě budu učit!"
      },
      "name": "Tepa",
      "translationMetadata": {
        "fields": {
          "dialogue.1660a3a28eb8f6b38d98": {
