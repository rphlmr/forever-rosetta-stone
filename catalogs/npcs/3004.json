    "hrHR": {
      "dialogue": {
        "1660a3a28eb8f6b38d98": "Podučite me.",
        "8633964ab897db1676a3": "Moraš naučiti osnove prije nego što ti mogu pomoći. Razgovaraj s mojim učenikom Vhanom. Ljubazan je i strpljiv te će te naučiti što trebaš znati.",
        "a2ce80c8daaf8ccb14aa": "Moje je znanje ograničeno, iako još učim. Vrijeme je da kreneš dalje, putniče. Pronađi Josefa Gregoriana u Undercityju i reci mu da si spreman.",
        "b279e7b7ec4ed22e0aec": "Nisu li uzorci prekrasni? Svaki govori svojim glasom.",
        "ccd8559669421b954663": "Ti si doista odlučan učenik. Rado ću te podučavati!"
      },
      "name": "Tepa",
      "translationMetadata": {
