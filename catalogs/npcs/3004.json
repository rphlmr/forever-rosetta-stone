    "daDK": {
      "dialogue": {
        "1660a3a28eb8f6b38d98": "Træn mig.",
        "8633964ab897db1676a3": "Du må lære de grundlæggende ting, før jeg kan hjælpe dig. Tal med min lærling Vhan. Han er venlig og tålmodig og vil lære dig det nødvendige.",
        "a2ce80c8daaf8ccb14aa": "Min viden er begrænset, selv om jeg stadig lærer. Det er tid til at komme videre, rejsende. Find Josef Gregorian i Undercity og fortæl ham, at du er klar.",
        "b279e7b7ec4ed22e0aec": "Er mønstrene ikke smukke? Hvert af dem taler med sin egen stemme.",
        "ccd8559669421b954663": "Du er en virkelig beslutsom elev. Jeg vil med glæde undervise dig!"
      },
      "name": "Tepa",
      "translationMetadata": {
        "fields": {
          "dialogue.1660a3a28eb8f6b38d98": {
