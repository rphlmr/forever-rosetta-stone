    "enUS": {
      "dialogue": {
        "1660a3a28eb8f6b38d98": "Train me.",
        "8633964ab897db1676a3": "There are fundamental things you must learn before I can aid you. Speak to my apprentice, Vhan. He is kind and patient and will teach you what you need to know.",
        "a2ce80c8daaf8ccb14aa": "My knowledge is limited, though I am still learning. It is time for you to move on, traveler. Find Josef Gregorian in Undercity and tell him you are ready.",
        "b279e7b7ec4ed22e0aec": "Aren't the patterns beautiful? Each one speaks with its own voice.",
        "ccd8559669421b954663": "You are truly a determined student. I will be happy to provide you with instruction!"
      },
      "name": "Tepa",
      "subName": "Expert Tailor",
      "translationMetadata": {
