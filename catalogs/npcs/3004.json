    "ltLT": {
      "dialogue": {
        "1660a3a28eb8f6b38d98": "Pamokyk mane.",
        "8633964ab897db1676a3": "Prieš man galint tau padėti, turi išmokti pagrindų. Pasikalbėk su mano mokiniu Vhan. Jis geras ir kantrus, išmokys tave visko, ką reikia žinoti.",
        "a2ce80c8daaf8ccb14aa": "Mano žinios ribotos, nors vis dar mokausi. Tau metas keliauti toliau, keliautojau. Surask Josef Gregorian Undercity mieste ir pasakyk jam, kad esi pasirengęs.",
        "b279e7b7ec4ed22e0aec": "Argi šie raštai ne nuostabūs? Kiekvienas jų kalba savu balsu.",
        "ccd8559669421b954663": "Tu išties ryžtingas mokinys. Su džiaugsmu tave pamokysiu!"
      },
      "name": "Tepa",
      "subName": "Siuvimo ekspertas",
      "translationMetadata": {
