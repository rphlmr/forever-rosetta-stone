    "esES": {
      "dialogue": {
        "1660a3a28eb8f6b38d98": "Entréname.",
        "8633964ab897db1676a3": "Debes aprender las cosas fundamentales antes de que pueda enseñarte. Ve a hablar con mi aprendiz, Vhan. Es amable y paciente, y te enseñará todo lo que necesitas saber.",
        "a2ce80c8daaf8ccb14aa": "Mi conocimiento es limitado, sigo aprendiendo. Es hora de que sigas adelante. Busca a Josef Gregorian en Entrañas y dile que ya estás preparado.",
        "b279e7b7ec4ed22e0aec": "¿No son preciosos los diseños? Cada uno de ellos habla con su propia voz.",
        "ccd8559669421b954663": "Tienes mucha determinación. ¡Estaré encantada de instruirte!"
      },
      "name": "Tepa",
      "subName": "Experto sastre",
