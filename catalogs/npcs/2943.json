    },
    "daDK": {
      "dialogue": {
        "3247abbe0156aa0dec83": "Vær hilset, $c. Så jeg dig ikke for nylig til en eksklusiv sammenkomst? Du ser bekendt ud, men byen er jo et travlt sted.$B$BHvis du deltog, fik du sikkert en hemmelig kode. Fortæl mig den, så giver jeg dig en særlig præmie."
      },
      "name": "Ransin Donner",
      "translationMetadata": {
        "fields": {
          "dialogue.3247abbe0156aa0dec83": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
