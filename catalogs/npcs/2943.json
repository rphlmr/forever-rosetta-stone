            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "3247abbe0156aa0dec83": "Hail $c. Didn't I see you recently at an exclusive gathering? You look familiar, but then again this city is a busy place.$B$BIf you attended that convention, then surely you were given a secret code. Tell me your code and I will give you a special prize in return."
      },
      "name": "Ransin Donner",
      "translationMetadata": {
        "fields": {
          "dialogue.3247abbe0156aa0dec83": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
