    "ltLT": {
      "dialogue": {
        "3247abbe0156aa0dec83": "Sveikas, $c. Ar neseniai tavęs nemačiau uždarame susibūrime? Atrodai pažįstamai, bet šiame mieste visada daug žmonių.$B$BJei dalyvavai tame renginyje, tau tikrai davė slaptą kodą. Pasakyk man savo kodą ir už tai gausi ypatingą prizą."
      },
      "name": "Ransin Donner",
      "translationMetadata": {
