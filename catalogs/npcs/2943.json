            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "3247abbe0156aa0dec83": "Grüße, $C. Habe ich Euch nicht neulich auf einer exklusiven Veranstaltung gesehen? Ihr kommt mir bekannt vor, aber nun ja, in dieser Stadt tummeln sich ja etliche Reisende.\n\nSolltet Ihr auf dieser Veranstaltung gewesen sein, dann hat man Euch sicherlich einen geheimen Code gegeben. Verratet mir Euren Code und ich werde Euch dafür einen besonderen Preis geben."
      },
      "name": "Ransin Donner",
      "translationMetadata": {
        "fields": {
          "dialogue.3247abbe0156aa0dec83": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
