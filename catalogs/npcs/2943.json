  "locales": {
    "csCZ": {
      "dialogue": {
        "3247abbe0156aa0dec83": "Zdravím, $c. Neviděli jsme se nedávno na exkluzivním setkání? Připadáš mi povědomě, ale ve městě je rušno.$B$BPokud ses toho srazu zúčastnil, určitě jsi dostal tajný kód. Řekni mi ho a já ti dám zvláštní cenu."
      },
      "name": "Ransin Donner",
      "translationMetadata": {
        "fields": {
          "dialogue.3247abbe0156aa0dec83": {
