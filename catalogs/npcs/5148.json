  "locales": {
    "csCZ": {
      "dialogue": {
        "7f5aa9a118a7ccb26d6e": "Možná nenásleduješ cesty Světla jako rytíř Stříbrné ruky, ale vždy nás můžeš požádat o pomoc.",
        "af363da3b9e764e73459": "Světlo s tebou, $c. Jak ti mohu pomoci?",
        "c0cc080e656b97839319": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "edeb15e9c5cf8e5273cb": "Důkladným přeškolením jsem musel mnohé žáky odnaučit vše, co se předtím naučili, abych je mohl učit znovu. Tato služba je s každým opakováním obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvé talenty?"
      },
      "name": "Beldruk Doombrow",
      "translationMetadata": {
        "fields": {
          "dialogue.7f5aa9a118a7ccb26d6e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
