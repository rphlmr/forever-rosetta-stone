    "daDK": {
      "dialogue": {
        "c42ee14f2c1feb206c69": "Kildrath har en tendens til at overdramatisere situationen. For eksempel er „Garona: Et studie i snigen og forræderi“ blevet stjålet over 400 gange.$B$BAthenaeums mærke beskytter bøgerne og forhindrer uautoriseret læsning."
      },
      "name": "Vismand Mykos",
      "translationMetadata": {
        "fields": {
