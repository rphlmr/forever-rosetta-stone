    "csCZ": {
      "dialogue": {
        "c42ee14f2c1feb206c69": "Kildrath má sklon situaci přehánět. Například „Garona: Studie o plížení a zradě“ byla ukradena už více než 400krát.$B$BZnamení Athenaea chrání svazky a brání neoprávněnému nahlížení."
      },
      "name": "Strážce vědění Mykos",
      "translationMetadata": {
