    "csCZ": {
      "dialogue": {
        "51eeef934c946f982135": "Vycvičte mě.",
        "9668a439676a1ada0ab1": "Zdravím, $c. Jestli jsi přítel plukovníka Kurzena, nechám tě na místě skolit! Jestli jsi nám ale přišel pomoci, poslouchej...",
        "dccbfbdcb73ed06252e9": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Poručík Doren",
