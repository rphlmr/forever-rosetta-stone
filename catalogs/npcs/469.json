    "deDE": {
      "dialogue": {
        "51eeef934c946f982135": "Bildet mich aus.",
        "9668a439676a1ada0ab1": "Sei gegrüßt, $c.  Wenn du ein Freund von Oberst Kurzen bist, werde ich dich auf der Stelle abmurksen lassen, aber wenn du gekommen bist, um uns zu helfen, dann höre mir zu ...",
        "dccbfbdcb73ed06252e9": "Ich möchte Eure Waren ansehen."
      },
      "name": "Lieutenant Doren",
