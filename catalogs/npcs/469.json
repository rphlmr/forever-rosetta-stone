    "daDK": {
      "dialogue": {
        "51eeef934c946f982135": "Træn mig.",
        "9668a439676a1ada0ab1": "Hilsner, $c. Hvis du er ven af oberst Kurzen, lader jeg dig hugge ned på stedet! Men hvis du er kommet for at hjælpe os, så lyt...",
        "dccbfbdcb73ed06252e9": "Jeg vil gerne se dine varer."
      },
      "name": "Løjtnant Doren",
      "translationMetadata": {
        "fields": {
