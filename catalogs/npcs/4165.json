    "plPL": {
      "dialogue": {
        "1ac52dc928d841742086": "Nie sądzę, by twój umysł był dość bystry, aby pojąć naturę magii portali.",
        "486ebc61fcb7c96140ca": "Jako mag należysz do wybranej grupy, która potrafi wyczarować portal przenoszący właśnie w to miejsce. Mogę cię tego nauczyć, jeśli jesteś gotów.",
        "a235367d2f50536d0995": "Proszę, naucz mnie.",
        "c318b9baaa1eed48c36a": "Chcę obejrzeć twoje towary."
      },
      "name": "Elissa Dumas",
