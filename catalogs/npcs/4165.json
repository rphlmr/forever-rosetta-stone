    "ltLT": {
      "dialogue": {
        "1ac52dc928d841742086": "Nemanau, kad tavo protas pakankamai aštrus, kad suvoktum portalų magijos prigimtį.",
        "486ebc61fcb7c96140ca": "Kaip magas, priklausai nedidelei grupei, galinčiai sukurti portalą, kuris pargabentų tave į šią vietą.  Galiu tave išmokyti, jei esi pasiruošęs.",
        "a235367d2f50536d0995": "Prašau mane išmokyti.",
        "c318b9baaa1eed48c36a": "Leisk apžiūrėti tavo prekes."
      },
      "name": "Elissa Dumas",
      "subName": "Portalų mokytoja",
