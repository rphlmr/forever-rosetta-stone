    "daDK": {
      "dialogue": {
        "1ac52dc928d841742086": "Jeg tror ikke, du har den fornødne skarpsindighed til at forstå portalmagiens natur.",
        "486ebc61fcb7c96140ca": "Som magiker tilhører du en udvalgt gruppe, der kan fremmane en portal tilbage til netop dette sted. Jeg kan lære dig det, hvis du er klar.",
        "a235367d2f50536d0995": "Lær mig det, tak.",
        "c318b9baaa1eed48c36a": "Lad mig se dine varer."
      },
      "name": "Elissa Dumas",
      "translationMetadata": {
        "fields": {
