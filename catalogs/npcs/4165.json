    "hrHR": {
      "dialogue": {
        "1ac52dc928d841742086": "Ne vjerujem da si dovoljno bistar da shvatiš prirodu magije portala.",
        "486ebc61fcb7c96140ca": "Kao mag pripadaš odabranoj skupini koja može stvoriti portal za povratak upravo na ovo mjesto. Mogu te poučiti ako si spreman.",
        "a235367d2f50536d0995": "Molim te, poduči me.",
        "c318b9baaa1eed48c36a": "Dopustite mi da pogledam vašu robu."
      },
      "name": "Elissa Dumas",
      "translationMetadata": {
