    "esES": {
      "dialogue": {
        "1ac52dc928d841742086": "No puedo creerme que poseas la agudeza mental necesaria para comprender la naturaleza de la magia del portal.",
        "486ebc61fcb7c96140ca": "Como mago, perteneces a un grupo selecto que puede conjurar un portal para transportarte de nuevo a este lugar. Puedo enseñarte si eres capaz de aprender.",
        "a235367d2f50536d0995": "Por favor, enséñame.",
        "c318b9baaa1eed48c36a": "Déjame ver tus mercancías."
      },
      "name": "Elissa Dumas",
      "subName": "Instructor de portal",
