    "deDE": {
      "dialogue": {
        "1ac52dc928d841742086": "Ich glaube nicht, dass Ihr die geistige Schärfe besitzt, um die Natur der Portalmagie zu verstehen.",
        "486ebc61fcb7c96140ca": "Als Magier gehört Ihr zu einer auserwählten Gruppe, die ein Portal herbeizaubern kann, das Euch zurück zu diesem Ort transportiert. Ich kann Euch unterrichten, wenn Ihr bereit seid.",
        "a235367d2f50536d0995": "Bitte unterrichtet mich.",
        "c318b9baaa1eed48c36a": "Lasst mich Eure Waren ansehen."
      },
      "name": "Elissa Dumas",
      "subName": "Portallehrerin",
