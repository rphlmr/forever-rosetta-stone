  "locales": {
    "csCZ": {
      "dialogue": {
        "1ac52dc928d841742086": "Nevěřím, že máš dostatečně bystrou mysl, abys pochopil podstatu portálové magie.",
        "486ebc61fcb7c96140ca": "Jako mág patříš k vyvolené skupině, která dokáže vyčarovat portál zpět na toto místo. Jsi-li připraven, mohu tě to naučit.",
        "a235367d2f50536d0995": "Prosím, učte mě.",
        "c318b9baaa1eed48c36a": "Dovolte mi prohlédnout si vaše zboží."
      },
      "name": "Elissa Dumas",
      "translationMetadata": {
        "fields": {
          "dialogue.1ac52dc928d841742086": {
