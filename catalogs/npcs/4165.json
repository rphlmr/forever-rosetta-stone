    "itIT": {
      "dialogue": {
        "1ac52dc928d841742086": "Non credo che tu abbia l'acume necessario per comprendere la natura della magia dei portali.",
        "486ebc61fcb7c96140ca": "Come mago, fai parte di un gruppo selezionato capace di evocare un portale che ti riporti proprio qui. Posso insegnarti, se sei pronto.",
        "a235367d2f50536d0995": "Ti prego, insegnami.",
        "c318b9baaa1eed48c36a": "Lascia che dia un’occhiata alla tua merce."
      },
      "name": "Elissa Dumas",
