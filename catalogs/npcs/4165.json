    "ptBR": {
      "dialogue": {
        "1ac52dc928d841742086": "Creio que você não possua a acuidade mental para compreender os mistérios da magia dos portais.",
        "486ebc61fcb7c96140ca": "Como um mago, você pertence ao seleto grupo que consegue conjurar um portal que lhe transportará de volta a este mesmo local. Posso lhe ensinar como, se você estiver pronto.",
        "a235367d2f50536d0995": "Por favor, ensine-me.",
        "c318b9baaa1eed48c36a": "Deixe-me ver suas mercadorias."
      },
      "name": "Elissa Dumas",
      "subName": "Treinamento de Portais",
