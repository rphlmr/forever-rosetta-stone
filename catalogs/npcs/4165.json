    "enUS": {
      "dialogue": {
        "1ac52dc928d841742086": "I do not believe you possess the mental acuity to grasp the nature of portal magic.",
        "486ebc61fcb7c96140ca": "As a mage, you are one of a select group that can conjure a portal to transport you back to this very place.  I can teach you if you are ready.",
        "a235367d2f50536d0995": "Please teach me.",
        "c318b9baaa1eed48c36a": "Let me browse your goods."
      },
      "name": "Elissa Dumas",
      "subName": "Portal Trainer",
      "translationMetadata": {
