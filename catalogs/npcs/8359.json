    "deDE": {
      "dialogue": {
        "bea3d81a1c7cbd634663": "Seid gegrüßt. Wenn Ihr wegen Lederwaren hier seid, werdet Ihr feststellen, dass meine Waren gut gearbeitet sind.",
        "c6bdad1340f2aaa1705f": "Ich möchte Eure Waren ansehen.",
        "zephras:3e639a0d436530c2ffb0": "Lasst mich Eure Waren ansehen."
      },
      "name": "Ahanu",
      "subName": "Lederrüstungshändler",
