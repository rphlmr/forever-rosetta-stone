    "daDK": {
      "dialogue": {
        "bea3d81a1c7cbd634663": "Vær hilset. Hvis du søger lædervarer, vil du opdage, at mine varer er godt forarbejdede.",
        "c6bdad1340f2aaa1705f": "Jeg vil gerne se dine varer.",
        "zephras:3e639a0d436530c2ffb0": "Lad mig se dine varer."
      },
      "name": "Ahanu",
      "translationMetadata": {
