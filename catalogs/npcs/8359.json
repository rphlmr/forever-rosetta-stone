    "csCZ": {
      "dialogue": {
        "bea3d81a1c7cbd634663": "Zdravím tě. Pokud hledáš kožené zboží, zjistíš, že mé výrobky jsou dobře zhotovené.",
        "c6bdad1340f2aaa1705f": "Chci si prohlédnout vaše zboží.",
        "zephras:3e639a0d436530c2ffb0": "Dovol mi prohlédnout si tvé zboží."
      },
      "name": "Ahanu",
