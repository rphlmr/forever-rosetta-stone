    "hrHR": {
      "dialogue": {
        "3234a6d6787f3885ef8e": "Zul'Farrak u pustinji Tanaris dom je starješine Wildmane.",
        "5b02559092471de42e1e": "Starješina Ragetotem provodi dane u Dolini čuvara u pustinji Tanaris.",
        "7aaeea5ffca950044f95": "U davna vremena živjeli smo za lov. Lovili smo za slavu, za čast...$B$BZar je danas toliko drukčije?",
        "c43996bc9f837c1e19ac": "Starješina Dreamseer boravi u Gadgetzanu u pustinji Tanaris.",
        "f5574943d3b5456302a4": "Starješina Morningdew promatra vrevu na trkalištu Mirage u Thousand Needlesu."
      },
      "name": "Starješina Skyseer",
