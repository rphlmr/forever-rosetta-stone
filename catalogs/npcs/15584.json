  "locales": {
    "csCZ": {
      "dialogue": {
        "3234a6d6787f3885ef8e": "Domovem starší Wildmane je Zul'Farrak v poušti Tanaris.",
        "5b02559092471de42e1e": "Starší Ragetotem tráví své dny v Údolí strážců v poušti Tanaris.",
        "7aaeea5ffca950044f95": "V dávných dobách jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?",
        "c43996bc9f837c1e19ac": "Starší Dreamseer sídlí v Gadgetzanu v poušti Tanaris.",
        "f5574943d3b5456302a4": "Starší Morningdew sleduje ruch na závodišti Mirage v Thousand Needles."
      },
      "name": "Starší Skyseer",
