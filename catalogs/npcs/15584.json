    "plPL": {
      "dialogue": {
        "3234a6d6787f3885ef8e": "Zul'Farrak na pustyni Tanaris jest domem starszej Wildmane.",
        "5b02559092471de42e1e": "Starsza Ragetotem spędza dni w Dolinie Strażników na pustyni Tanaris.",
        "7aaeea5ffca950044f95": "W dawnych czasach żyliśmy dla łowów. Polowaliśmy dla chwały, dla honoru...$B$BCzy dziś jest tak inaczej?",
        "c43996bc9f837c1e19ac": "Starszy Dreamseer przebywa w Gadgetzan na pustyni Tanaris.",
        "f5574943d3b5456302a4": "Starsza Morningdew obserwuje zamieszanie na torze Mirage w Thousand Needles."
      },
      "name": "Starszy Skyseer",
