    "daDK": {
      "dialogue": {
        "3234a6d6787f3885ef8e": "Zul'Farrak i Tanarisørkenen er ældste Wildmanes hjem.",
        "5b02559092471de42e1e": "Ældste Ragetotem tilbringer dagene i Vogternes Dal i Tanarisørkenen.",
        "7aaeea5ffca950044f95": "For længe siden levede vi for jagten. Vi jagede for berømmelse, for ære...$B$BEr det så anderledes nu?",
        "c43996bc9f837c1e19ac": "Ældste Dreamseer bor i Gadgetzan i Tanarisørkenen.",
        "f5574943d3b5456302a4": "Ældste Morningdew holder øje med tumulten ved Mirage Raceway i Thousand Needles."
      },
      "name": "Ældste Skyseer",
      "translationMetadata": {
