    "enUS": {
      "dialogue": {
        "3234a6d6787f3885ef8e": "Zul'Farrak in Tanaris Desert is Elder Wildmane's home.",
        "5b02559092471de42e1e": "Elder Ragetotem spends her days at the Valley of the Watchers in Tanaris Desert.",
        "7aaeea5ffca950044f95": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "c43996bc9f837c1e19ac": "Elder Dreamseer resides in Gadgetzan in Tanaris Desert.",
        "f5574943d3b5456302a4": "Elder Morningdew has taken to watching the commotion at the Mirage Raceway in Thousand Needles."
      },
      "name": "Elder Skyseer",
