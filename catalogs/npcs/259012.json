        }
      }
    },
    "daDK": {
      "dialogue": {
        "422d57463530abeb9b96": "Alle de svævende øer blev ustabile og begyndte at drive fra hinanden for nogle år siden. Som om det ikke var slemt nok, er store stykker af Zephras nu begyndt at falde af. Det er svært at forestille sig sit hjem falde ned i himlen, men det er min virkelighed nu."
      },
      "name": "Ealaane Nimbuswalker",
      "translationMetadata": {
        "fields": {
          "dialogue.422d57463530abeb9b96": {
