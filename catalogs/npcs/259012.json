    "enUS": {
      "dialogue": {
        "422d57463530abeb9b96": "All of the skyborne islands became destabilized and began to move apart a few years ago. If that wasn't bad enough, now large pieces of Zephras are beginning to fall away. It's hard to imagine your home falling into the sky, but that is my reality now."
      },
      "name": "Ealaane Nimbuswalker",
      "subName": "Ban'aethal Refugee",
      "translationMetadata": {
        "fields": {
          "dialogue.422d57463530abeb9b96": {
