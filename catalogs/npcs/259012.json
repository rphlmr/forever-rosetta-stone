  "locales": {
    "csCZ": {
      "dialogue": {
        "422d57463530abeb9b96": "Všechny ostrovy v oblacích ztratily před několika lety stabilitu a začaly se od sebe vzdalovat. Jako by to nestačilo, teď se ze Zephrasu začínají odlamovat velké kusy. Je těžké si představit, že tvůj domov padá do nebe, ale to je teď moje skutečnost."
      },
      "name": "Ealaane Nimbuswalker",
      "translationMetadata": {
        "fields": {
