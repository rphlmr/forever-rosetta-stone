    "hrHR": {
      "dialogue": {
        "422d57463530abeb9b96": "Svi nebeski otoci postali su nestabilni i počeli se udaljavati prije nekoliko godina. Kao da to nije dovoljno loše, sada se od Zephrasa počinju odlamati veliki komadi. Teško je zamisliti da tvoj dom pada u nebo, ali to je sada moja stvarnost."
      },
      "name": "Ealaane Nimbuswalker",
      "translationMetadata": {
        "fields": {
