    "plPL": {
      "dialogue": {
        "422d57463530abeb9b96": "Kilka lat temu wszystkie podniebne wyspy straciły stabilność i zaczęły się od siebie oddalać. Jakby tego było mało, od Zephrasu zaczynają teraz odpadać wielkie fragmenty. Trudno sobie wyobrazić, że twój dom spada w niebo, ale taka jest teraz moja rzeczywistość."
      },
      "name": "Ealaane Nimbuswalker",
      "translationMetadata": {
        "fields": {
          "dialogue.422d57463530abeb9b96": {
