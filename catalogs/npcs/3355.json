  "locales": {
    "csCZ": {
      "dialogue": {
        "4af57035aec0fe20f428": "Co hledáš v mé kovárně? Výcvik? Snad tajemství oceli? Záhady kovářství? Mluv, vojáku!",
        "e1086da5049152fc48f7": "Vycvičte mě.",
        "e48d2d3a09e1e9a43342": "Tohle není hra pro mladíky! Běž a promluv si venku se Snarlem. Možná je to had v mém doupěti, ale u kovadliny se vyzná.",
        "f8d3df13afc519aeef57": "Vítej v mé kovárně, kováři. Prozradím ti malé tajemství. Nikomu, nikomu na světě nemůžeš věřit. Ani mužům, ani ženám, ani zvířatům... věřit můžeš oceli."
      },
      "name": "Saru Steelfury",
      "translationMetadata": {
        "fields": {
          "dialogue.4af57035aec0fe20f428": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.e1086da5049152fc48f7": {
