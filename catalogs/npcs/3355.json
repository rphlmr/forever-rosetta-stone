            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "4af57035aec0fe20f428": "Hvad søger du ved min esse? Træning? Søger du stålets hemmeligheder? Essens mysterier? Tal, soldat!",
        "e1086da5049152fc48f7": "Træn mig.",
        "e48d2d3a09e1e9a43342": "Dette er ikke en leg, unge! Gå ud og tal med Snarl. Han er måske en slange i min hule, men han kender sin ambolt.",
        "f8d3df13afc519aeef57": "Velkommen til min smedje, smed. Lad mig dele en lille hemmelighed. Du kan ikke stole på nogen, ingen i hele verden. Ikke mænd, ikke kvinder, ikke dyr... men dette kan du stole på: stål."
      },
      "name": "Saru Steelfury",
      "translationMetadata": {
        "fields": {
