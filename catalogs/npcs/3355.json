    "enUS": {
      "dialogue": {
        "4af57035aec0fe20f428": "What is it you seek at my forge? Is it training? Do you perhaps seek the secrets of steel? The mysteries of the forge? Speak up Grunt!",
        "e1086da5049152fc48f7": "Train me.",
        "e48d2d3a09e1e9a43342": "This isn't a game you toy with youngling! Go, speak with Snarl outside. He may be a serpent in my lair but he does know his way around an anvil.",
        "f8d3df13afc519aeef57": "Welcome to my forge, Blacksmith. Let me share with you a little secret. No one, no one in the world can you trust. Not men, not women, not beasts ... this you can trust, Steel."
      },
      "name": "Saru Steelfury",
      "subName": "Artisan Blacksmith",
      "translationMetadata": {
        "fields": {
          "dialogue.4af57035aec0fe20f428": {
