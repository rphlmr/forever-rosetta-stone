  "locales": {
    "csCZ": {
      "dialogue": {
        "3e60fe4f4306fd628ac4": "Tady v přístavu vídám přicházet a odcházet všelijaké zajímavé postavy. Dávej na sebe pozor, $n. Při všech těch pochybných obchodech člověk nikdy neví, komu věřit..."
      },
      "name": "Správce přístaviště Lozgil",
