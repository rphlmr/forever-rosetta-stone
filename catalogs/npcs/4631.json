    "hrHR": {
      "dialogue": {
        "3e60fe4f4306fd628ac4": "Viđam svakakve zanimljive likove kako dolaze i odlaze iz luke. Čuvaj se, $n. Uz sve sumnjive poslove ovdje nikad nije jasno kome se može vjerovati..."
      },
      "name": "Upravitelj pristaništa Lozgil",
