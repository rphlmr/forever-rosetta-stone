    "plPL": {
      "dialogue": {
        "3e60fe4f4306fd628ac4": "Widuję tu w porcie rozmaite ciekawe postacie. Uważaj na siebie, $n. Przy tych wszystkich podejrzanych interesach nigdy nie wiadomo, komu można zaufać..."
      },
      "name": "Kapitan nabrzeża Lozgil",
