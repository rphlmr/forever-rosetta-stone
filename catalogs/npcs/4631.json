    "ltLT": {
      "dialogue": {
        "3e60fe4f4306fd628ac4": "Čia, uoste, matau ateinant ir išeinant visokių įdomių veikėjų. Saugokis, $n. Kai aplink vyksta tiek daug įtartinų reikalų, niekada nežinai, kuo galima pasitikėti..."
      },
      "name": "Prieplaukos viršininkas Lozgilas",
