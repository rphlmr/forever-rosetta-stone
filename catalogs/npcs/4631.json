    },
    "daDK": {
      "dialogue": {
        "3e60fe4f4306fd628ac4": "Jeg ser nogle interessante typer komme og gå her i havnen. Pas på dig selv, $n. Med al den lyssky aktivitet her ved man aldrig, hvem man kan stole på..."
      },
      "name": "Havnemester Lozgil",
      "translationMetadata": {
        "fields": {
