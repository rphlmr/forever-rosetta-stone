    "deDE": {
      "dialogue": {
        "4d342424d917c4288986": "Überall in Azeroth verschwinden unsere Lieferungen. Wenn Ihr welche findet, wäre ich Euch dankbar, wenn Ihr sie mir zurückbringen würdet."
      },
      "name": "Tamelyn Aldridge",
      "subName": "Supply Officer",
      "translationMetadata": {
