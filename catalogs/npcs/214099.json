    "daDK": {
      "dialogue": {
        "4d342424d917c4288986": "Vi har haft problemer med forsendelser, der forsvinder rundt omkring i Azeroth. Hvis du finder nogen, vil jeg sætte pris på, at du bringer dem tilbage til mig."
      },
      "name": "Tamelyn Aldridge",
      "translationMetadata": {
        "fields": {
