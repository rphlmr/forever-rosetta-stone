      "dialogue": {
        "6d1ebb2806bd2aa3ea8c": "Er du interesseret i at udforske et af disse fangehuller?",
        "zephras:3e639a0d436530c2ffb0": "Lad mig se dine varer.",
        "zephras:4e43153037ea566fa6d6": "Fortæl mig om fangekældre, jeg kan udforske.",
        "zephras:6243735f28102ba91b31": "Gør denne kro til dit hjem."
      },
      "name": "Krovært Toka",
