    "csCZ": {
      "dialogue": {
        "6d1ebb2806bd2aa3ea8c": "Máš zájem prozkoumat některý z těchto dungeonů?",
        "zephras:3e639a0d436530c2ffb0": "Dovol mi prohlédnout si tvé zboží.",
        "zephras:4e43153037ea566fa6d6": "Povězte mi o podzemích, která bych mohl prozkoumat.",
        "zephras:6243735f28102ba91b31": "Učiňte tento hostinec svým domovem."
      },
      "name": "Hostinská Toka",
      "translationMetadata": {
        "fields": {
