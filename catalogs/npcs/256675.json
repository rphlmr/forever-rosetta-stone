    "ruRU": {
      "dialogue": {
        "6d1ebb2806bd2aa3ea8c": "Не хочешь исследовать какое-нибудь подземелье?",
        "zephras:3e639a0d436530c2ffb0": "Покажите мне ваши товары.",
        "zephras:4e43153037ea566fa6d6": "Расскажите мне о подземельях, которые я могу исследовать.",
        "zephras:6243735f28102ba91b31": "Я хочу остановиться здесь."
      },
