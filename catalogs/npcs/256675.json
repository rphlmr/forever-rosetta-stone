    "deDE": {
      "dialogue": {
        "6d1ebb2806bd2aa3ea8c": "Würdet Ihr gerne einen dieser Dungeons erkunden?",
        "zephras:3e639a0d436530c2ffb0": "Lasst mich Eure Waren ansehen.",
        "zephras:4e43153037ea566fa6d6": "Erzählt mir von Dungeons, die ich erkunden könnte.",
        "zephras:6243735f28102ba91b31": "Ich möchte dieses Gasthaus zu meinem Heimatort machen."
      },
      "name": "Gastwirtin Toka",
      "subName": "Innkeeper",
