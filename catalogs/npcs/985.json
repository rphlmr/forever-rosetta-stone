    },
    "daDK": {
      "dialogue": {
        "158b21cd211cf4020875": "Er du her for træning? Eller er du her bare for at spilde en krigers tid?",
        "842bef740d14a5a426ae": "Gennem hård omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne lære dem det på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine tillærte talenter?",
        "e89ece9d91ae27d07cc8": "Jeg træner ikke din slags, $c. Find din egen træner, før du gør mig vred.",
        "f2bf6eaa91061996b966": "Jeg har brug for krigertræning."
      },
      "name": "Malosh",
      "translationMetadata": {
        "fields": {
          "dialogue.158b21cd211cf4020875": {
            "origin": "ai",
