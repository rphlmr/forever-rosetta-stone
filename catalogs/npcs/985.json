  "locales": {
    "csCZ": {
      "dialogue": {
        "158b21cd211cf4020875": "Jsi tu kvůli výcviku? Nebo jen ztrácíš čas válečníka?",
        "842bef740d14a5a426ae": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto je také dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "e89ece9d91ae27d07cc8": "Tvůj druh necvičím, $c. Najdi si vlastního učitele, než mě rozzlobíš.",
        "f2bf6eaa91061996b966": "Potřebuji výcvik válečníka."
      },
      "name": "Malosh",
      "translationMetadata": {
        "fields": {
          "dialogue.158b21cd211cf4020875": {
            "origin": "ai",
