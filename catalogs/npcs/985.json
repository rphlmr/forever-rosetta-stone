    "enUS": {
      "dialogue": {
        "158b21cd211cf4020875": "Are you here for training?  Or are you just here to waste a warrior's time.",
        "842bef740d14a5a426ae": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "e89ece9d91ae27d07cc8": "I don't train your kind $c.  Find your own trainer before you anger me.",
        "f2bf6eaa91061996b966": "I require warrior training."
      },
      "name": "Malosh",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
