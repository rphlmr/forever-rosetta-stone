    "hrHR": {
      "dialogue": {
        "158b21cd211cf4020875": "Jesi li ovdje radi obuke? Ili samo gubiš ratnikovo vrijeme?",
        "842bef740d14a5a426ae": "Strogom sam preobukom mnoge učenike morao odviknuti od svega što su ranije naučili kako bih ih mogao poučiti iznova. Ta usluga postaje sve teža svaki put, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "e89ece9d91ae27d07cc8": "Ne obučavam tvoju vrstu, $c. Pronađi svog učitelja prije nego što me razljutiš.",
        "f2bf6eaa91061996b966": "Trebam ratničku obuku."
      },
      "name": "Malosh",
