    },
    "plPL": {
      "dialogue": {
        "158b21cd211cf4020875": "Jesteś tu na szkolenie? A może tylko marnujesz czas wojownika?",
        "842bef740d14a5a426ae": "Poprzez rygorowne przeszkolenie musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by móc uczyć ich od nowa. Usługa ta staje się coraz trudniejsza z każdym razem, dlatego też jest coraz droższa. Czy chcesz, abym oduczył cię poznanych talentów?",
        "e89ece9d91ae27d07cc8": "Nie szkolę takich jak ty, $c. Znajdź własnego trenera, zanim mnie rozgniewasz.",
        "f2bf6eaa91061996b966": "Potrzebuję szkolenia wojownika."
      },
      "name": "Malosh",
