    "enUS": {
      "dialogue": {
        "a3a579e216e09e1a2008": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "d82de9c33b4f8106680b": "What can this insignificant servant do for you, $n? Training perhaps?",
        "e8367cca70ee31357c7d": "I seek more training in the priestly ways.",
        "ea5c0386a3ddad58055d": "Yes, $c?"
      },
      "name": "Father Cobb",
      "subName": "Priest Trainer",
      "translationMetadata": {
        "fields": {
