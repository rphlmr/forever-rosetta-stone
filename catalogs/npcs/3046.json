  "locales": {
    "csCZ": {
      "dialogue": {
        "a3a579e216e09e1a2008": "Důkladným přeškolením jsem musel mnohé žáky odnaučit vše, co se předtím naučili, abych je mohl učit znovu. Tato služba je s každým opakováním obtížnější. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "d82de9c33b4f8106680b": "Co pro tebe může tento nepatrný služebník udělat, $n? Snad výcvik?",
        "e8367cca70ee31357c7d": "Hledám další výcvik v kněžském umění.",
        "ea5c0386a3ddad58055d": "Ano, $c?"
      },
      "name": "Otec Cobb",
      "translationMetadata": {
        "fields": {
          "dialogue.a3a579e216e09e1a2008": {
