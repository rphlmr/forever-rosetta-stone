    "hrHR": {
      "dialogue": {
        "a3a579e216e09e1a2008": "Temeljitim sam preobučavanjem morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao iznova poučiti. Uslugu koju nudim sve je teže izvesti svaki put. Zato svako preobučavanje postaje skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "d82de9c33b4f8106680b": "Što ovaj neznatni sluga može učiniti za tebe, $n? Obuka možda?",
        "e8367cca70ee31357c7d": "Tražim daljnju poduku u svećeničkom umijeću.",
        "ea5c0386a3ddad58055d": "Da, $c?"
      },
      "name": "Otac Cobb",
