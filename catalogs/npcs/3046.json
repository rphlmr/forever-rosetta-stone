    "plPL": {
      "dialogue": {
        "a3a579e216e09e1a2008": "Dzięki rygorystycznemu przeszkoleniu musiałem sprawić, by wielu uczniów zapomniało wszystko, czego wcześniej się nauczyli, abym mógł nauczyć ich od nowa. Usługa ta staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne przeszkolenie jest droższe. Czy chcesz, abym sprawił, że zapomnisz wyuczone talenty?",
        "d82de9c33b4f8106680b": "Co ten nieznaczący sługa może dla ciebie zrobić, $n? Może szkolenie?",
        "e8367cca70ee31357c7d": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "ea5c0386a3ddad58055d": "Tak, $c?"
      },
      "name": "Ojciec Cobb",
