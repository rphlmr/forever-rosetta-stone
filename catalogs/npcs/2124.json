  "locales": {
    "csCZ": {
      "dialogue": {
        "1026df7d81a94de48567": "Mám zájem o výcvik mága.",
        "3939dba90ef50a44fcc3": "Mám zájem o výcvik mága.",
        "43228426501c3b134fa9": "Zdravím. Jsem nemrtvá učitelka mágů a ty jsi mág.",
        "ae3a58feb59b6cf052d1": "Buď zdráv, $c. Má rada zní: Při cestách světem se měj na pozoru před magií, neboť nevycvičené spálí.",
        "e606a387731c181859e6": "Při důkladném přeškolování jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto také dražší. Přeješ si, abych tě odnaučila talenty, které ses naučil?"
      },
      "name": "Isabella",
      "translationMetadata": {
        "fields": {
          "dialogue.1026df7d81a94de48567": {
