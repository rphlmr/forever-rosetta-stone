    "ltLT": {
      "dialogue": {
        "1026df7d81a94de48567": "Norėčiau mokytis magijos.",
        "3939dba90ef50a44fcc3": "Norėčiau mokytis magijos.",
        "43228426501c3b134fa9": "Sveiki. Esu nemirėlė magų mokytoja, o tu esi magas.",
        "ae3a58feb59b6cf052d1": "Sveikas, $c. Štai mano patarimas: keliaudamas po pasaulį saugokis magijos, nes neišmokusius ji nudegina.",
        "e606a387731c181859e6": "Griežtai perkvalifikuodamas turėjau priversti daugelį mokinių pamiršti viską, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart suteikti šią paslaugą tampa vis sunkiau. Todėl su kiekvienu perkvalifikavimu ji vis brangsta. Ar nori, kad priversčiau tave pamiršti išmoktus talentus?"
      },
      "name": "Isabella",
      "subName": "Magų mokytojas",
