    "daDK": {
      "dialogue": {
        "1026df7d81a94de48567": "Jeg er interesseret i magikertræning.",
        "3939dba90ef50a44fcc3": "Jeg er interesseret i magikertræning.",
        "43228426501c3b134fa9": "Goddag. Jeg er en udød magitræner, og du er magiker.",
        "ae3a58feb59b6cf052d1": "Vel mødt, $c. Mit råd er dette: Når du rejser i verden, så vær på vagt over for magi, for den brænder de utrænede.",
        "e606a387731c181859e6": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Isabella",
      "translationMetadata": {
        "fields": {
          "dialogue.1026df7d81a94de48567": {
