    "trTR": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Beni eğit.",
        "43661a46fa114d22d52c": "Sana balık tutmayı öğretebilirim.",
        "5781b644a7eee30a8191": "Daha fazla gelişmek için Dustwallow Marsh’ta Nat Pagle’ı bulmalısın.",
        "e3241ab4ee8129a6a3fa": "Becerin benimkini aşıyor, ama Booty Bay’deki İhtiyar Heming’in „Levrek ve Sen“ kitabından nüshaları olduğunu duydum. Bu, becerini geliştirmene kesinlikle yardımcı olacaktır."
      },
