    "plPL": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Wyszkol mnie.",
        "43661a46fa114d22d52c": "Mogę nauczyć cię łowić ryby.",
        "5781b644a7eee30a8191": "Jeśli chcesz się dalej rozwijać, musisz znaleźć Nata Pagle’a w Dustwallow Marsh.",
        "e3241ab4ee8129a6a3fa": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci się doskonalić."
      },
      "name": "Harold Riggs",
