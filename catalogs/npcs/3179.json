    "deDE": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Bildet mich aus.",
        "43661a46fa114d22d52c": "Ihr könnt bei mir Eure Angelfertigkeit verbessern.",
        "5781b644a7eee30a8191": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "e3241ab4ee8129a6a3fa": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern."
      },
      "name": "Harold Riggs",
      "subName": "Angellehrer",
      "translationMetadata": {
        "fields": {
