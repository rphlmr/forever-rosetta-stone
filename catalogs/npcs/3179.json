    "daDK": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Træn mig.",
        "43661a46fa114d22d52c": "Jeg kan lære dig at fiske.",
        "5781b644a7eee30a8191": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre.",
        "e3241ab4ee8129a6a3fa": "Du er dygtigere end mig, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af „Aborren og dig“. Den vil helt sikkert hjælpe dig med at blive bedre."
      },
      "name": "Harold Riggs",
      "translationMetadata": {
