    "itIT": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Addestrami.",
        "43661a46fa114d22d52c": "Posso insegnarti l'arte della pesca.",
        "5781b644a7eee30a8191": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "e3241ab4ee8129a6a3fa": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità."
      },
      "name": "Harold Riggs",
