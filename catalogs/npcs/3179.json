    "esES": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Entréname.",
        "43661a46fa114d22d52c": "Puedo enseñarte a pescar.",
        "5781b644a7eee30a8191": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "e3241ab4ee8129a6a3fa": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad."
      },
      "name": "Harold Riggs",
      "subName": "Instructor de pesca",
