    "frFR": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Entraînez-moi.",
        "43661a46fa114d22d52c": "Je peux vous apprendre à pêcher.",
        "5781b644a7eee30a8191": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "e3241ab4ee8129a6a3fa": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser."
      },
      "name": "Harold Riggs",
      "subName": "Maître des pêcheurs",
