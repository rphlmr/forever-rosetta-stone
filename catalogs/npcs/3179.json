    "svSE": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Träna mig.",
        "43661a46fa114d22d52c": "Jag kan lära dig att fiska.",
        "5781b644a7eee30a8191": "Du måste hitta Nat Pagle i Dustwallow Marsh om du vill bli bättre.",
        "e3241ab4ee8129a6a3fa": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av „Abborren och du“. Den hjälper dig säkert att bli skickligare."
      },
      "name": "Harold Riggs",
