  "locales": {
    "csCZ": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Vycvičte mě.",
        "43661a46fa114d22d52c": "Mohu tě naučit rybařit.",
        "5781b644a7eee30a8191": "Chceš-li se zlepšit, musíš najít Nata Pagla v Dustwallow Marsh.",
        "e3241ab4ee8129a6a3fa": "Tvá dovednost převyšuje mou, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti jistě pomůže se zlepšit."
      },
      "name": "Harold Riggs",
      "translationMetadata": {
