    "hrHR": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Podučite me.",
        "43661a46fa114d22d52c": "Mogu te naučiti pecati.",
        "5781b644a7eee30a8191": "Ako želiš napredovati, moraš pronaći Nata Paglea u Dustwallow Marshu.",
        "e3241ab4ee8129a6a3fa": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige „Grgeč i ti“. Ona će ti sigurno pomoći da napreduješ."
      },
      "name": "Harold Riggs",
