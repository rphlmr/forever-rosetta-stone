    "enUS": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Train me.",
        "43661a46fa114d22d52c": "I can teach you fishing skills.",
        "5781b644a7eee30a8191": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "e3241ab4ee8129a6a3fa": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill."
      },
      "name": "Harold Riggs",
      "subName": "Fishing Trainer",
