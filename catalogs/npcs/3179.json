    "ptBR": {
      "dialogue": {
        "055e5f9f91238e29ee4e": "Treine-me.",
        "43661a46fa114d22d52c": "Eu posso te ensinar técnicas de pesca.",
        "5781b644a7eee30a8191": "Você só será capaz de melhorar sua técnica se encontrar o Nat Pagle no Pântano Vadeoso.",
        "e3241ab4ee8129a6a3fa": "Você é bem mais habilidoso do que eu. Ouvi dizer que o Velho Heming tem cópias de \"O Bagre e Você\" lá na Angra do Butim. Se você ler o livro, vai ficar melhor ainda."
      },
      "name": "Haroldo Reis",
      "subName": "Treinamento de Pesca",
