    "plPL": {
      "dialogue": {
        "35510baca69a571dfc07": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, aby móc uczyć ich od nowa. Ta usługa staje się za każdym razem trudniejsza, a przez to droższa. Czy chcesz, abym oduczył cię poznanych talentów?",
        "6e64fa810aabf31c28a4": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "7259c18c21441e634202": "Uważaj na siebie, $c. Szanuj nasze zwyczaje, albo klątwa spadnie na ciebie i twoich bliskich.",
        "a82fe89b3dbae2753e26": "Zrobię, co mogę, by nauczyć cię kapłańskich dróg, jeśli po to tu jesteś."
      },
      "name": "Zayus",
      "translationMetadata": {
        "fields": {
