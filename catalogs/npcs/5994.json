  "locales": {
    "csCZ": {
      "dialogue": {
        "35510baca69a571dfc07": "Přísným přeškolováním jsem musel mnoho studentů zbavit všeho, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto také dražší. Přeješ si, abych tě zbavil talentů, které ses naučil?",
        "6e64fa810aabf31c28a4": "Hledám další výcvik v kněžském umění.",
        "7259c18c21441e634202": "Dávej si pozor, $c. Respektuj naše zvyky, nebo na tebe a tvé blízké padne kletba.",
        "a82fe89b3dbae2753e26": "Udělám, co budu moci, abych tě naučil kněžským způsobům, pokud jsi tu kvůli tomu."
      },
      "name": "Zayus",
      "translationMetadata": {
        "fields": {
          "dialogue.35510baca69a571dfc07": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
