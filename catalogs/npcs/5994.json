    "hrHR": {
      "dialogue": {
        "35510baca69a571dfc07": "Strogim preodgajanjem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao poučiti iznova. Ta je usluga svakim ponavljanjem teža, a zato i skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "6e64fa810aabf31c28a4": "Tražim daljnju poduku u svećeničkom umijeću.",
        "7259c18c21441e634202": "Pazi se, $c. Poštuj naše običaje ili će kletva pasti na tebe i tvoje.",
        "a82fe89b3dbae2753e26": "Učinit ću što mogu da te poučim svećeničkim običajima, ako si zato ovdje."
      },
      "name": "Zayus",
