        }
      }
    },
    "daDK": {
      "dialogue": {
        "78955aa3d29009b8b3e3": "Nu hvor krigen er i fuld gang, mangler vi ikke kampdygtige krigere fra Horden og Alliancen.$B$BHvis bare vi kunne forhindre dem i at fare i flæsket på hinanden..."
      },
      "name": "Vindkalder Kaldon",
      "translationMetadata": {
        "fields": {
          "dialogue.78955aa3d29009b8b3e3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
