    "enUS": {
      "dialogue": {
        "78955aa3d29009b8b3e3": "Now that the war is in full swing, we've had no shortage of able-bodied combatants from the Horde and Alliance.$B$BIf only we could keep them off of each other's throats..."
      },
      "name": "Windcaller Kaldon",
      "translationMetadata": {
        "fields": {
          "dialogue.78955aa3d29009b8b3e3": {
            "origin": "community",
