    "plPL": {
      "dialogue": {
        "78955aa3d29009b8b3e3": "Teraz, gdy wojna trwa w najlepsze, nie brakuje nam zdolnych do walki wojowników Hordy i Przymierza.$B$BGdyby tylko udało się powstrzymać ich przed skoczeniem sobie do gardeł..."
      },
      "name": "Przywoływacz wiatru Kaldon",
      "translationMetadata": {
        "fields": {
          "dialogue.78955aa3d29009b8b3e3": {
