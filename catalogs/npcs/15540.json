  "locales": {
    "csCZ": {
      "dialogue": {
        "78955aa3d29009b8b3e3": "Teď, když válka zuří naplno, nemáme nouzi o bojeschopné bojovníky Hordy a Aliance.$B$BKéž bychom jim jen dokázali zabránit, aby si šli po krku..."
      },
      "name": "Vyvolávač větru Kaldon",
      "translationMetadata": {
        "fields": {
