    "svSE": {
      "dialogue": {
        "78955aa3d29009b8b3e3": "Nu när kriget är i full gång har vi gott om stridsdugliga kämpar från Horden och Alliansen.$B$BOm vi bara kunde hindra dem från att ryka ihop..."
      },
      "name": "Vindkallare Kaldon",
