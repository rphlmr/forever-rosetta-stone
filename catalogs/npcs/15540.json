    "hrHR": {
      "dialogue": {
        "78955aa3d29009b8b3e3": "Sada kad je rat u punom jeku, ne nedostaje nam sposobnih boraca iz Horde i Saveza.$B$BKad bismo ih barem mogli spriječiti da jedni drugima skoče za vrat..."
      },
      "name": "Prizivač vjetra Kaldon",
