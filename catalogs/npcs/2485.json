    "esES": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "No puedo creerme que poseas la agudeza mental necesaria para comprender la naturaleza de la magia del portal.",
        "4292c8d66abefa985160": "Como mago, perteneces a un grupo selecto que puede conjurar un portal para transportarte de nuevo a este lugar. Puedo enseñarte si eres capaz de aprender.",
        "daadaf7a49a89bc6ff54": "Por favor, enséñame."
      },
      "name": "Larimaine Purdue",
      "subName": "Instructor de portal",
