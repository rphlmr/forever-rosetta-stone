    "ltLT": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Nemanau, kad tavo protas pakankamai aštrus portalų magijos prigimčiai suprasti.",
        "4292c8d66abefa985160": "Kaip magas, priklausai nedidelei grupei, gebančiai sukurti portalą, kuris grąžintų tave į šią vietą. Jei esi pasiruošęs, galiu tave išmokyti.",
        "daadaf7a49a89bc6ff54": "Prašau mane išmokyti."
      },
      "name": "Larimaine Purdue",
      "subName": "Portalų mokytoja",
      "translationMetadata": {
