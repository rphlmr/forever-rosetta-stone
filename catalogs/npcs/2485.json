    "hrHR": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Ne vjerujem da imaš dovoljno bistar um da shvatiš prirodu magije portala.",
        "4292c8d66abefa985160": "Kao mag pripadaš odabranoj skupini koja može dočarati portal da te vrati upravo na ovo mjesto. Mogu te podučiti ako se osjećaš spremno.",
        "daadaf7a49a89bc6ff54": "Molim te, poduči me."
      },
      "name": "Larimaine Purdue",
