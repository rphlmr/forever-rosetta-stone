  "locales": {
    "csCZ": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Nemyslím si, že máš dost bystrou mysl na pochopení podstaty portálové magie.",
        "4292c8d66abefa985160": "Jako mág patříš k nemnoha vyvoleným, kteří dokážou vyčarovat portál a vrátit se jím právě sem. Mohu tě to naučit, pokud se na to cítíš.",
        "daadaf7a49a89bc6ff54": "Prosím, učte mě."
      },
      "name": "Larimaine Purdue",
      "translationMetadata": {
        "fields": {
          "dialogue.1ce4d816d1c0d4102e53": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.4292c8d66abefa985160": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.daadaf7a49a89bc6ff54": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Jeg tror ikke, du har den mentale skarphed, der skal til for at forstå portalmagiens natur.",
        "4292c8d66abefa985160": "Som magiker tilhører du en udvalgt gruppe, der kan fremmane en portal, som fører dig tilbage til netop dette sted. Jeg kan lære dig det, hvis du er klar.",
        "daadaf7a49a89bc6ff54": "Lær mig det, tak."
      },
      "name": "Larimaine Purdue",
      "translationMetadata": {
        "fields": {
          "dialogue.1ce4d816d1c0d4102e53": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
