    "ptBR": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Creio que você não possua a acuidade mental para compreender os mistérios da magia dos portais.",
        "4292c8d66abefa985160": "Como um mago, você pertence ao seleto grupo que consegue conjurar um portal que lhe transportará de volta a este mesmo local. Posso lhe ensinar como, se você estiver pronto.",
        "daadaf7a49a89bc6ff54": "Por favor, ensine-me."
      },
      "name": "Larimaine Purdue",
      "subName": "Treinamento de Portais",
