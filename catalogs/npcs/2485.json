    "plPL": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Nie sądzę, by twój umysł był wystarczająco bystry, aby pojąć naturę magii portali.",
        "4292c8d66abefa985160": "Jako mag należysz do wybranej grupy osób, które potrafią wyczarować portal przenoszący je z powrotem w to właśnie miejsce. Mogę cię tego nauczyć, jeśli masz gotowość do nauki.",
        "daadaf7a49a89bc6ff54": "Proszę, naucz mnie."
      },
      "name": "Larimaine Purdue",
