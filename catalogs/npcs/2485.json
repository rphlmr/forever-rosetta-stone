            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Ich glaube nicht, dass Ihr die geistige Schärfe besitzt, um die Natur der Portalmagie zu verstehen.",
        "4292c8d66abefa985160": "Als Magier gehört Ihr zu einer auserwählten Gruppe, die ein Portal herbeizaubern kann, das Euch zurück zu diesem Ort transportiert. Ich kann Euch unterrichten, wenn Ihr bereit seid.",
        "daadaf7a49a89bc6ff54": "Bitte unterrichtet mich."
      },
      "name": "Larimaine Purdue",
      "subName": "Portallehrerin",
      "translationMetadata": {
        "fields": {
