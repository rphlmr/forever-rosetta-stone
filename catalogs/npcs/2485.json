    "trTR": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Geçit büyüsünün doğasını kavrayacak zihinsel keskinliğe sahip olduğunu sanmıyorum.",
        "4292c8d66abefa985160": "Bir büyücü olarak, seni tam da buraya geri taşıyacak bir geçit açabilen seçkin bir grubun üyesisin. Hazırsan sana öğretebilirim.",
        "daadaf7a49a89bc6ff54": "Lütfen bana öğret."
      },
      "name": "Larimaine Purdue",
