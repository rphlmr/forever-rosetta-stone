    "enUS": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "I do not believe you possess the mental acuity to grasp the nature of portal magic.",
        "4292c8d66abefa985160": "As a mage, you are one of a select group that can conjure a portal to transport you back to this very place.  I can teach you if you are ready.",
        "daadaf7a49a89bc6ff54": "Please teach me."
      },
      "name": "Larimaine Purdue",
      "subName": "Portal Trainer",
      "translationMetadata": {
        "fields": {
