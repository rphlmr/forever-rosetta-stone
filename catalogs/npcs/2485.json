    "frFR": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Je ne pense pas que vous possédiez la finesse mentale requise pour comprendre la nature de la magie des portails.",
        "4292c8d66abefa985160": "En tant que mage, vous faites partie d'une élite qui peut invoquer un portail capable de vous ramener ici même. Je peux vous apprendre comment si vous avez les compétences requises.",
        "daadaf7a49a89bc6ff54": "Veuillez m'apprendre."
      },
      "name": "Larimaine Purdue",
      "subName": "Maître des portails",
