    "svSE": {
      "dialogue": {
        "1ce4d816d1c0d4102e53": "Jag tror inte att du har den skärpa som krävs för att förstå portalmagins natur.",
        "4292c8d66abefa985160": "Som magiker tillhör du en utvald skara som kan frammana en portal som för dig tillbaka till just den här platsen. Jag kan lära dig om du är redo.",
        "daadaf7a49a89bc6ff54": "Lär mig, tack."
      },
      "name": "Larimaine Purdue",
