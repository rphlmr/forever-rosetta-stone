    "frFR": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Entraînez-moi.",
        "81c63fd6b512b8bc38f1": "J'ai beaucoup à faire ici à Desolace, $N. Roetten veut que nous allions chercher des réactifs pour l'un de nos clients ainsi que des objets perdus.\n\nPuisque vous êtes là pour nous aider, pourquoi ne pas commencer ?",
        "f3ad1de7678dcdb8681e": "Je voudrais regarder vos articles."
      },
