    "daDK": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Træn mig.",
        "81c63fd6b512b8bc38f1": "Jeg har nok at se til herude i Desolace, $N. Roetten vil have os til at hente reagenser til en klient og finde nogle af de tabte genstande.$B$BNu hvor du er her for at hjælpe, skal vi så komme i gang?",
        "f3ad1de7678dcdb8681e": "Jeg vil gerne se dine varer."
      },
      "name": "Kreldig Ungor",
      "translationMetadata": {
        "fields": {
