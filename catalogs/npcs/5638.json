    "itIT": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Addestrami.",
        "81c63fd6b512b8bc38f1": "Ho un sacco da fare qui a Desolace, $N. Roetten vuole che procuriamo dei reagenti a uno dei nostri clienti, e pure che recuperiamo alcuni di questi oggetti perduti.\n\nVisto che sei qui per dare una mano, perché non cominciamo?",
        "f3ad1de7678dcdb8681e": "Vorrei vedere la tua merce."
      },
      "name": "Kreldig Ungor",
      "translationMetadata": {
