    "plPL": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Wyszkol mnie.",
        "81c63fd6b512b8bc38f1": "Mam tu w Desolace mnóstwo zajęć, $N. Roetten chce, żebyśmy zdobyli odczynniki dla jednego z klientów oraz odzyskali kilka zaginionych przedmiotów.$B$BSkoro jesteś tu, by pomóc, może zaczniemy?",
        "f3ad1de7678dcdb8681e": "Chcę przejrzeć twoje towary."
      },
      "name": "Kreldig Ungor",
