      "dialogue": {
        "62bd220ee60e55bc30c0": "Entréname.",
        "81c63fd6b512b8bc38f1": "Tengo mucho que hacer aquí en Desolace, $N. Roetten quiere que recojamos algunos reactivos para uno de nuestros clientes, así como algunos de estos objetos perdidos.",
        "f3ad1de7678dcdb8681e": "Quiero ver tus mercancías."
