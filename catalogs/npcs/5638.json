    "ltLT": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Išmokyk mane.",
        "81c63fd6b512b8bc38f1": "Čia, Desolace, turiu daug reikalų, $N. Roetten nori, kad parinktume reagentų vienam iš mūsų klientų ir surastume kai kuriuos iš šių prarastų daiktų.$B$BKadangi atėjai padėti, gal pradėkime?",
        "f3ad1de7678dcdb8681e": "Noriu apžiūrėti tavo prekes."
      },
      "name": "Kreldig Ungor",
      "subName": "Susigrąžinimo bendrovė",
