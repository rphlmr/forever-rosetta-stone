    "hrHR": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Podučite me.",
        "81c63fd6b512b8bc38f1": "Imam pune ruke posla ovdje u Desolaceu, $N. Roetten želi da nabavimo reagense za jednog klijenta i dohvatimo neke izgubljene predmete.$B$BKad si već ovdje da pomogneš, zašto ne bismo počeli?",
        "f3ad1de7678dcdb8681e": "Želim pogledati vašu robu."
      },
      "name": "Kreldig Ungor",
