    "csCZ": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Vycvičte mě.",
        "81c63fd6b512b8bc38f1": "Tady v Desolace mám spoustu práce, $N. Roetten chce, abychom pro jednoho klienta sehnali nějaké reagencie a také několik ztracených předmětů.$B$BKdyž už jsi tady, abys pomohl, co kdybychom začali?",
        "f3ad1de7678dcdb8681e": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Kreldig Ungor",
      "translationMetadata": {
        "fields": {
