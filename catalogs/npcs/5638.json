    "enUS": {
      "dialogue": {
        "62bd220ee60e55bc30c0": "Train me.",
        "81c63fd6b512b8bc38f1": "I've got a lot going on out here in Desolace, $N. Roetten wants us to pick up some reagents for one of our clients as well as fetch some of these lost items.$B$BSeein' as you're here to help out, why don't we get started?",
        "f3ad1de7678dcdb8681e": "I want to browse your goods."
      },
      "name": "Kreldig Ungor",
      "subName": "Reclaimers Inc.",
