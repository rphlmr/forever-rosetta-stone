    "daDK": {
      "dialogue": {
        "359225cfcfd5ae2b943d": "Jeg er interesseret i magikertræning.",
        "89d39059ccd97bf14770": "Godt mødt, $c. Vil du have et råd? Bliv ven med en magiker! Vi har et par tricks i ærmet...",
        "8db77b2d2ece2576d306": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre, hver gang den bruges. Derfor bliver hver omskoling dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "ddc63b0a57c58f6b5d3f": "Hilsner. Jeg er gnomisk magikertræner, og du er magiker.",
        "e45fc80a6b967ab59a79": "Jeg er interesseret i magikertræning."
      },
      "name": "Marryk Nurribit",
      "translationMetadata": {
