    "hrHR": {
      "dialogue": {
        "359225cfcfd5ae2b943d": "Zanima me obuka za maga.",
        "89d39059ccd97bf14770": "Pozdrav, $c. Želiš savjet? Sprijatelji se s magom! Imamo mi nekoliko trikova u rukavu...",
        "8db77b2d2ece2576d306": "Strogom preobukom morala sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla ponovno podučiti. Usluga koju nudim svakim je ponavljanjem sve teža. Zato je svaka preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "ddc63b0a57c58f6b5d3f": "Pozdrav. Ja sam gnomska učiteljica magova, a ti si mag.",
        "e45fc80a6b967ab59a79": "Zanima me obuka za maga."
      },
      "name": "Marryk Nurribit",
