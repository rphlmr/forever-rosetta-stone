    "deDE": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Würdet Ihr Eure Waren lieber einem Goblin anvertrauen?",
        "67d3ddc2e6c7980c431c": "Ich garantiere mit meinem Blut für die Sicherheit dieser Bank, genügt Euch das?",
        "a741948c4bf260ad88f8": "Außer gegen die Grunzer da draußen kämpften meine Brüder und ich in der Schlacht von Hyjal. Alle, die die Bank bestehlen wollen, bekommen es zuerst mit uns zu tun."
      },
      "name": "Koma",
      "subName": "Bankier",
