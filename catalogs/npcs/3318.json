    "svSE": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Vill du hellre anförtro dina ägodelar åt en goblin?",
        "67d3ddc2e6c7980c431c": "Jag garanterar bankens säkerhet med mitt eget blod. Duger det åt dig?",
        "a741948c4bf260ad88f8": "Förutom vakterna utanför stred mina bröder och jag i slaget vid Hyjal. Den som försöker stjäla från banken måste först möta oss."
      },
      "name": "Koma",
