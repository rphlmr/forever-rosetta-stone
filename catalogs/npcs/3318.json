    "plPL": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Wolisz powierzyć swoje dobra goblinowi?",
        "67d3ddc2e6c7980c431c": "Ręczę własną krwią za bezpieczeństwo tego banku. Czy to wystarczy?",
        "a741948c4bf260ad88f8": "Oprócz strażników na zewnątrz, moi bracia i ja walczyliśmy w bitwie o Hyjal. Każdy, kto spróbuje okraść bank, najpierw zmierzy się z nami."
      },
