    "enUS": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Would you rather trust your goods with a goblin?",
        "67d3ddc2e6c7980c431c": "I guarantee this bank's security with my own blood, is that good enough for you?",
        "a741948c4bf260ad88f8": "Besides the Grunts outside, my brothers and I fought at the battle of Hyjal. Any who seek to steal from the bank must face us first."
      },
      "name": "Koma",
      "subName": "Banker",
      "translationMetadata": {
        "fields": {
