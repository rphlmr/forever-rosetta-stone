    "ptBR": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Você prefere deixar seus bens com um goblin?",
        "67d3ddc2e6c7980c431c": "Garanto a segurança deste banco com meu próprio sangue, para você basta?",
        "a741948c4bf260ad88f8": "Além da presença dos Brutos lá fora, meus irmãos e eu lutamos na batalha de Hyjal. Qualquer um que queira assaltar o banco vai ter que nos enfrentar antes."
      },
      "name": "Krona",
      "subName": "Caixa do Banco",
