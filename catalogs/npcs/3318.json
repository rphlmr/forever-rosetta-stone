    "hrHR": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Zar svoju robu radije želiš povjeriti goblinu?",
        "67d3ddc2e6c7980c431c": "Za sigurnost ove banke jamčim vlastitom krvlju. Je li ti to dovoljno?",
        "a741948c4bf260ad88f8": "Osim stražara vani, moja braća i ja borili smo se u bitci za Hyjal. Tko god želi opljačkati banku, prvo će se morati suočiti s nama."
      },
      "name": "Koma",
      "translationMetadata": {
