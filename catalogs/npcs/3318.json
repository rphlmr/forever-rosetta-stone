    "daDK": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Vil du hellere betro dine ejendele til en goblin?",
        "67d3ddc2e6c7980c431c": "Jeg garanterer denne banks sikkerhed med mit eget blod. Er det godt nok for dig?",
        "a741948c4bf260ad88f8": "Ud over vagterne udenfor kæmpede mine brødre og jeg i slaget ved Hyjal. Enhver, der vil stjæle fra banken, må først møde os."
      },
      "name": "Koma",
      "translationMetadata": {
        "fields": {
          "dialogue.10fd36aa5c551d447c76": {
