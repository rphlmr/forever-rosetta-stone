    "itIT": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Preferiresti affidare i tuoi averi a un goblin?",
        "67d3ddc2e6c7980c431c": "Garantisco la sicurezza di questa banca con il mio stesso sangue, ti basta?",
        "a741948c4bf260ad88f8": "Oltre ai Grunt là fuori, io e i miei fratelli abbiamo combattuto nella battaglia di Hyjal. Chiunque provi a derubare la banca dovrà prima vedersela con noi."
      },
      "name": "Koma",
      "translationMetadata": {
