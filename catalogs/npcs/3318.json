    "esES": {
      "dialogue": {
        "10fd36aa5c551d447c76": "¿Preferirías confiar tus cosas a un goblin?",
        "67d3ddc2e6c7980c431c": "Protejo la seguridad de este banco con mi propia sangre, ¿es eso suficiente para ti?",
        "a741948c4bf260ad88f8": "Además de los Brutos, mis hermanos y yo luchamos en la batalla de Hyjal. Y el que intente robar el banco tendrá que vérselas primero con nosotros."
      },
      "name": "Koma",
      "subName": "Banquero",
