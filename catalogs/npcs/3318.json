    "frFR": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Vous préférez confier vos biens à un gobelin ?",
        "67d3ddc2e6c7980c431c": "Je garantis la sécurité de cette banque avec mon propre sang. Ça vous suffit ?",
        "a741948c4bf260ad88f8": "En plus des grunts, dehors, mes frères et moi avons combattu à la bataille de Hyjal. Quiconque cherche à voler la banque devra d'abord nous affronter."
      },
      "name": "Koma",
      "subName": "Banquier",
