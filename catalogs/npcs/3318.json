  "locales": {
    "csCZ": {
      "dialogue": {
        "10fd36aa5c551d447c76": "Raději své zboží svěříš goblinovi?",
        "67d3ddc2e6c7980c431c": "Za bezpečnost této banky ručím vlastní krví. To ti nestačí?",
        "a741948c4bf260ad88f8": "Kromě strážných venku jsme já a mí bratři bojovali v bitvě u Hyjalu. Kdo chce banku okrást, musí se nejprve postavit nám."
      },
      "name": "Koma",
      "translationMetadata": {
        "fields": {
          "dialogue.10fd36aa5c551d447c76": {
