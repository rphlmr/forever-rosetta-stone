  "locales": {
    "csCZ": {
      "dialogue": {
        "61a9f0b140bfb505db9d": "V Teldrassilu můžeš navštívit mnoho míst. Řekni mi, co hledáš.",
        "63dcedaa19d638ef3719": "Nemohu učit někoho jako ty, $c.",
        "ca694e4fb4061e889290": "Potřebuji výcvik.",
        "d79e12c80aff4b17766d": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým opakováním těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil talenty, které sis osvojil?"
      },
      "name": "Dazalar",
      "translationMetadata": {
        "fields": {
          "dialogue.61a9f0b140bfb505db9d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
