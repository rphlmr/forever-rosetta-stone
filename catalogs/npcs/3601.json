    },
    "daDK": {
      "dialogue": {
        "61a9f0b140bfb505db9d": "Der er mange steder at besøge i Teldrassil. Fortæl mig, hvad du søger.",
        "63dcedaa19d638ef3719": "Jeg kan ikke træne en $c som dig.",
        "ca694e4fb4061e889290": "Jeg har brug for træning.",
        "d79e12c80aff4b17766d": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre for hver gang. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?"
      },
      "name": "Dazalar",
      "translationMetadata": {
        "fields": {
          "dialogue.61a9f0b140bfb505db9d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
