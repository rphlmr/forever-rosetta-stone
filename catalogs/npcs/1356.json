    "csCZ": {
      "dialogue": {
        "492f581798e01d0599ea": "Vycvičte mě.",
        "72eefcb706ba8b9b9fcc": "Právě se věnuji velmi důležitému úkolu. Práce prospektora. Pokud nemáš na srdci něco stejně důležitého, o čemž pochybuji, budeš mě muset omluvit.",
        "b05a1c28989a32fe9c06": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Prospektor Stormpike",
      "translationMetadata": {
        "fields": {
