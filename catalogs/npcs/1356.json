    "trTR": {
      "dialogue": {
        "492f581798e01d0599ea": "Beni eğit.",
        "72eefcb706ba8b9b9fcc": "Çok önemli bir işin ortasındayım. Kâşif işi. Aynı derecede önemli bir şey söylemeyeceksen, ki bundan şüpheliyim, beni mazur görmelisin.",
        "b05a1c28989a32fe9c06": "Mallarına bakmak istiyorum."
      },
      "name": "Maden Arayıcısı Stormpike",
