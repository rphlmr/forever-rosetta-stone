      }
    },
    "daDK": {
      "dialogue": {
        "492f581798e01d0599ea": "Træn mig.",
        "72eefcb706ba8b9b9fcc": "Jeg er midt i en meget vigtig opgave. Prospektørarbejde. Medmindre du har noget lige så vigtigt at sige, hvilket jeg tvivler på, må du undskylde mig.",
        "b05a1c28989a32fe9c06": "Jeg vil gerne se dine varer."
      },
      "name": "Prospektør Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.492f581798e01d0599ea": {
