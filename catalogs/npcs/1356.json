    "hrHR": {
      "dialogue": {
        "492f581798e01d0599ea": "Podučite me.",
        "72eefcb706ba8b9b9fcc": "Usred sam vrlo važnog zadatka. Posao istraživača. Osim ako nemaš nešto jednako važno za reći, u što sumnjam, morat ćeš me ispričati.",
        "b05a1c28989a32fe9c06": "Želim pogledati vašu robu."
      },
      "name": "Tragač Stormpike",
