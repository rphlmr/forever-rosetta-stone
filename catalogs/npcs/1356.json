    "deDE": {
      "dialogue": {
        "492f581798e01d0599ea": "Bildet mich aus.",
        "72eefcb706ba8b9b9fcc": "Ich stecke gerade mitten in einer sehr wichtigen Aufgabe.  Prospector-Angelegenheiten.  Wenn Sie nicht etwas ebenso Wichtiges zu sagen haben, was ich bezweifle, dann müssen Sie mich entschuldigen.",
        "b05a1c28989a32fe9c06": "Ich möchte Eure Waren ansehen."
      },
      "name": "Ausgrabungsleiter Stormpike",
