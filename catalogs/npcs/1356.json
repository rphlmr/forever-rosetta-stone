    "itIT": {
      "dialogue": {
        "492f581798e01d0599ea": "Addestrami.",
        "72eefcb706ba8b9b9fcc": "Sono nel bel mezzo di un compito molto importante. Faccende da Prospettore. A meno che tu non abbia qualcosa di altrettanto importante da dire, cosa di cui dubito, dovrai scusarmi.",
        "b05a1c28989a32fe9c06": "Vorrei vedere la tua merce."
      },
      "name": "Prospettore Stormpike",
