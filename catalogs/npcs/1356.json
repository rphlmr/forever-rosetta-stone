    "ptBR": {
      "dialogue": {
        "492f581798e01d0599ea": "Treine-me.",
        "72eefcb706ba8b9b9fcc": "Estou no meio de uma tarefa muito importante. Assuntos de prospector. A menos que tenha algo igualmente importante a dizer, o que duvido, terá que me dar licença.",
        "b05a1c28989a32fe9c06": "Quero ver suas mercadorias."
      },
      "name": "Prospector Lançatroz",
