    "frFR": {
      "dialogue": {
        "492f581798e01d0599ea": "Entraînez-moi.",
        "72eefcb706ba8b9b9fcc": "Je suis au milieu d'une tâche très importante.  Une affaire de prospecteur.  À moins que vous n'ayez quelque chose d'aussi important à dire, ce dont je doute, vous devrez m'excuser.",
        "b05a1c28989a32fe9c06": "Je voudrais regarder vos articles."
      },
      "name": "Prospecteur Foudrepique",
