    "enUS": {
      "dialogue": {
        "492f581798e01d0599ea": "Train me.",
        "72eefcb706ba8b9b9fcc": "I'm in the middle of a very important task.  Prospector business.  Unless you have something equally important to say, which I doubt, then you'll have to excuse me.",
        "b05a1c28989a32fe9c06": "I want to browse your goods."
      },
      "name": "Prospector Stormpike",
