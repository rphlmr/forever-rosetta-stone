    "plPL": {
      "dialogue": {
        "492f581798e01d0599ea": "Wyszkol mnie.",
        "72eefcb706ba8b9b9fcc": "Jestem w trakcie bardzo ważnego zadania. Sprawy poszukiwaczy. Jeśli nie masz do powiedzenia czegoś równie ważnego, w co wątpię, musisz mi wybaczyć.",
        "b05a1c28989a32fe9c06": "Chcę przejrzeć twoje towary."
