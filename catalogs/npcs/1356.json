    "svSE": {
      "dialogue": {
        "492f581798e01d0599ea": "Träna mig.",
        "72eefcb706ba8b9b9fcc": "Jag är mitt uppe i ett mycket viktigt uppdrag. Prospektörsarbete. Om du inte har något lika viktigt att säga, vilket jag tvivlar på, får du ursäkta mig.",
        "b05a1c28989a32fe9c06": "Jag vill se dina varor."
      },
      "name": "Prospektör Stormpike",
