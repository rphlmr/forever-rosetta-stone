    "daDK": {
      "dialogue": {
        "8a706f009628547fb773": "Lær mig åndernes veje.",
        "a0ccc71c78ee0c681272": "Ånderne har ført dig til mig. Hvordan kan jeg hjælpe?",
        "ad4f14f44832f1e4c271": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "cffdb28cc12ad0a10ee3": "Må ånderne være med dig."
      },
      "name": "Kardris Dreamseeker",
      "translationMetadata": {
