    "deDE": {
      "dialogue": {
        "8a706f009628547fb773": "Lehrt mich die Wege der Geister.",
        "a0ccc71c78ee0c681272": "Die Geister haben Euch zu mir geführt. Wie kann ich Euch zu Diensten sein?",
        "ad4f14f44832f1e4c271": "Durch rigoroses Abtrainieren musste ich vielen Schülern das abgewöhnen, was sie bisher gelernt hatten, damit ich sie von neuem unterrichten konnte. Der Dienst, den ich anbiete, ist jedes Mal schwieriger durchzuführen. Aus diesem Grunde wird er mit jeder Umschulung teurer. Wünscht Ihr, dass ich Euch die Talente nehme, die Ihr erlernt habt?",
        "cffdb28cc12ad0a10ee3": "Mögen die Geister mit Euch sein."
      },
      "name": "Kardris Dreamseeker",
      "subName": "Schamanenlehrerin",
      "translationMetadata": {
