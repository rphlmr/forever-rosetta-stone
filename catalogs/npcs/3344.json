    "trTR": {
      "dialogue": {
        "8a706f009628547fb773": "Bana ruhların yollarını öğret.",
        "a0ccc71c78ee0c681272": "Ruhlar seni bana yönlendirdi. Sana nasıl yardımcı olabilirim?",
        "ad4f14f44832f1e4c271": "Sıkı bir yeniden eğitimle pek çok öğrencime daha önce öğrendiklerini unutturup onları baştan eğittim. Bu hizmet her tekrarlandığında zorlaşır ve bu yüzden pahalılaşır. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?",
        "cffdb28cc12ad0a10ee3": "Ruhlar seninle olsun."
      },
      "name": "Kardris Dreamseeker",
