    "plPL": {
      "dialogue": {
        "8a706f009628547fb773": "Naucz mnie ścieżek duchów.",
        "a0ccc71c78ee0c681272": "Duchy przywiodły cię do mnie. Jak mogę pomóc?",
        "ad4f14f44832f1e4c271": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "cffdb28cc12ad0a10ee3": "Niech duchy będą z tobą."
      },
      "name": "Kardris Dreamseeker",
