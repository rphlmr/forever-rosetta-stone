    "hrHR": {
      "dialogue": {
        "8a706f009628547fb773": "Nauči me putovima duhova.",
        "a0ccc71c78ee0c681272": "Duhovi su te doveli k meni. Kako ti mogu pomoći?",
        "ad4f14f44832f1e4c271": "Strogom sam preobukom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Svaka sljedeća preobuka sve je teža, pa je zato i skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "cffdb28cc12ad0a10ee3": "Neka duhovi budu s tobom."
      },
      "name": "Kardris Dreamseeker",
