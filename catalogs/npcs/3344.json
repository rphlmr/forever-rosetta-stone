    "ltLT": {
      "dialogue": {
        "8a706f009628547fb773": "Išmokyk mane dvasių kelio.",
        "a0ccc71c78ee0c681272": "Dvasios atvedė tave pas mane. Kuo galiu padėti?",
        "ad4f14f44832f1e4c271": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti viską, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart teikti šią paslaugą darosi vis sunkiau, todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "cffdb28cc12ad0a10ee3": "Tebūnie dvasios su tavimi."
      },
      "name": "Kardris Dreamseeker",
      "subName": "Šamanų mokytojas",
