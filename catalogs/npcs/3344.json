  "locales": {
    "csCZ": {
      "dialogue": {
        "8a706f009628547fb773": "Nauč mě cestám duchů.",
        "a0ccc71c78ee0c681272": "Duchové tě přivedli ke mně. Jak ti mohu posloužit?",
        "ad4f14f44832f1e4c271": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "cffdb28cc12ad0a10ee3": "Ať tě duchové provázejí."
      },
      "name": "Kardris Dreamseeker",
      "translationMetadata": {
        "fields": {
