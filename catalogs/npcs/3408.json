  "locales": {
    "csCZ": {
      "dialogue": {
        "4ee1a67ba6ff66ef778f": "Co pro tebe můžu udělat, kámo?",
        "54c6817c8dc977165a4b": "Přísným přeškolením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je s každým dalším přeškolením těžší provést. Proto je také pokaždé dražší. Přeješ si, abych tě odnaučil tvé talenty?",
        "a8d189b5bfd0eca16b9c": "Potřebuji výcvik válečníka.",
        "c1c0728b9b9ea6b9407c": "Klid, kámo. Cvičím jen válečníky."
      },
      "name": "Zel'mak",
      "translationMetadata": {
        "fields": {
          "dialogue.4ee1a67ba6ff66ef778f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
