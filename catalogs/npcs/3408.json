    "enUS": {
      "dialogue": {
        "4ee1a67ba6ff66ef778f": "What kin I do for ya, mon?",
        "54c6817c8dc977165a4b": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "a8d189b5bfd0eca16b9c": "I require warrior training.",
        "c1c0728b9b9ea6b9407c": "Take it easy, mon. I only train da warriors."
      },
      "name": "Zel'mak",
      "subName": "Warrior Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.4ee1a67ba6ff66ef778f": {
