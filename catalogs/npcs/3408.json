    "plPL": {
      "dialogue": {
        "4ee1a67ba6ff66ef778f": "Co mogę dla ciebie zrobić, mon?",
        "54c6817c8dc977165a4b": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, co wcześniej poznali, by móc uczyć ich od nowa. Z każdym kolejnym razem ta usługa staje się trudniejsza, a przez to także droższa. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "a8d189b5bfd0eca16b9c": "Potrzebuję szkolenia wojownika.",
        "c1c0728b9b9ea6b9407c": "Spokojnie, mon. Szkolę tylko wojowników."
      },
      "name": "Zel'mak",
      "translationMetadata": {
