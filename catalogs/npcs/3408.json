    "ptBR": {
      "dialogue": {
        "4ee1a67ba6ff66ef778f": "Que que eu posso fazer pra tu, mano?",
        "54c6817c8dc977165a4b": "Com um retreinamento rigoroso eu tiro da cabeça dos meus alunos tudo que haviam aprendido antes, para poder lhes ensinar coisas novas. O serviço que presto torna-se mais difícil cada vez que é refeito. Portanto, cada novo retreino fica mais caro. Você deseja que eu tire da sua cabeça o que você aprendeu?",
        "a8d189b5bfd0eca16b9c": "Preciso de treinamento de guerreiro.",
        "c1c0728b9b9ea6b9407c": "Calminha aí, mano. Só treino os guerreiros."
      },
      "name": "Zel'mak",
      "subName": "Treinamento de Guerreiros",
