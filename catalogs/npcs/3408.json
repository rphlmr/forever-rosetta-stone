    "daDK": {
      "dialogue": {
        "4ee1a67ba6ff66ef778f": "Hvad kan jeg gøre for dig, mon?",
        "54c6817c8dc977165a4b": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre, hver gang den gentages. Derfor bliver den også dyrere for hver omskoling. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?",
        "a8d189b5bfd0eca16b9c": "Jeg har brug for krigertræning.",
        "c1c0728b9b9ea6b9407c": "Tag det roligt, mon. Jeg træner kun krigere."
      },
      "name": "Zel'mak",
      "translationMetadata": {
        "fields": {
