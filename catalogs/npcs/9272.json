    "hrHR": {
      "dialogue": {
        "5bf53169aa2234a149d0": "Da, da, znam da Dadanga ne voli dim. No po mirisu se čini da se Dadanga ne voli ni kupati.",
        "e46c3499f8571cff8309": "Za ljubav svega svetog i dragog, molim te reci da si nas došao izbaviti iz ove zaboravljene zemlje. Iako sam u Marshalovoj ekspediciji, dao bih ti zlatne zube iz usta samo da se zavučem u tvoj ruksak i odem odavde."
      },
      "name": "Spark Nilminer",
      "translationMetadata": {
        "fields": {
          "dialogue.5bf53169aa2234a149d0": {
