  "factionTemplateId": 35,
  "locales": {
    "csCZ": {
      "dialogue": {
        "5bf53169aa2234a149d0": "Jo, jo, vím, že Dadanga nemá ráda kouř. Podle toho zápachu se ale zdá, že nemá ráda ani koupání.",
        "e46c3499f8571cff8309": "Pro všechno svaté a drahé, prosím, řekni mi, že jsi nás přišel vysvobodit z této zapomenuté země. I když patřím k Marshalově expedici, dal bych ti i zlaté zuby, jen abych mohl vlézt do tvého batohu a odsud odejít."
      },
      "name": "Spark Nilminer",
      "translationMetadata": {
        "fields": {
          "dialogue.5bf53169aa2234a149d0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.e46c3499f8571cff8309": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "5bf53169aa2234a149d0": "Ja ja, jeg ved godt, at Dadanga ikke kan lide røg. Men efter lugten at dømme kan Dadanga heller ikke lide at bade.",
        "e46c3499f8571cff8309": "For alt, hvad der er helligt og kært, sig, at du er kommet for at befri os fra dette forladte land. Selvom jeg er med i Marshals ekspedition, ville jeg give dig mine guldtænder for at kravle ned i din rygsæk og komme væk herfra."
      },
      "name": "Spark Nilminer",
      "translationMetadata": {
        "fields": {
          "dialogue.5bf53169aa2234a149d0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.e46c3499f8571cff8309": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "5bf53169aa2234a149d0": "Ja, ja, ich weiß, dass Dadanga keinen Rauch mag. Seinem Geruch nach zu urteilen, mag er offenbar auch keine Bäder.",
        "e46c3499f8571cff8309": "Bei allem, was Euch lieb und teuer ist, sagt mir bitte, dass Ihr uns aus diesem verlassenen Land wegbringen wollt. Ich bin zwar mit 'Marshals Expeditionen' hier, aber ich würde Euch jeden Goldzahn in meinem Mund geben, um in Euren Rucksack klettern und diesen Ort verlassen zu dürfen."
      },
      "name": "Spark Nilminer",
      "translationMetadata": {
        "fields": {
          "dialogue.5bf53169aa2234a149d0": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
