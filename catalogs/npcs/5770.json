    "daDK": {
      "dialogue": {
        "6163dd1a6f814717c718": "Træn mig.",
        "c65ca511d417a93d0f16": "Jeg vil gerne se dine varer.",
        "d9f13d9dbdf3acf7c7b3": "Hvis vi skal beskytte naturen, må vi tage dens styrke til os. Og vi må vise denne styrke til dem, der vil skade landet."
      },
      "name": "Nara Wildmane",
      "translationMetadata": {
        "fields": {
