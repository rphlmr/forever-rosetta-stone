    "deDE": {
      "dialogue": {
        "6163dd1a6f814717c718": "Bildet mich aus.",
        "c65ca511d417a93d0f16": "Ich möchte Eure Waren ansehen.",
        "d9f13d9dbdf3acf7c7b3": "Wenn wir die Natur schützen wollen, müssen wir uns ihre Stärke zu eigen machen.  Und wir müssen diese Stärke denen entgegenbringen, die dem Land schaden wollen."
      },
      "name": "Nara Wildmane",
      "translationMetadata": {
