  "locales": {
    "csCZ": {
      "dialogue": {
        "6163dd1a6f814717c718": "Vycvičte mě.",
        "c65ca511d417a93d0f16": "Rád bych si prohlédl vaše zboží.",
        "d9f13d9dbdf3acf7c7b3": "Chceme-li chránit přírodu, musíme přijmout její sílu. A musíme ji ukázat těm, kdo by této zemi ublížili."
      },
      "name": "Nara Wildmane",
      "translationMetadata": {
