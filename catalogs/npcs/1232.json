    "daDK": {
      "dialogue": {
        "528f9f2cf358fd3c2278": "Lyset være med dig, $c. Hvordan kan jeg hjælpe dig?",
        "9157b025ebe64214a517": "Du følger måske ikke Lysets vej som en ridder af Sølvhånden, men du kan altid bede os om hjælp.",
        "eac4d23f19d66d3856b4": "Gennem grundig genoptræning har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem op på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre for hver gang. Derfor bliver den også dyrere ved hver genoptræning. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?",
        "feda0e587b8996f5b0b1": "Jeg vil gerne videreuddanne mig i Lysets veje."
      },
      "name": "Azar Stronghammer",
      "translationMetadata": {
        "fields": {
