    "daDK": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Opsøg Shandrina i Silverwind Refuge. Hun kan sælge dig „Kogebogen for eksperter“.",
        "0bcef4828bc8b422fc20": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme lidenskab!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave i Gadgetzan er en mester i kogekunst. Du må opsøge ham for at blive bedre.",
        "3b7ab70ebfe689988972": "Træn mig.",
        "d4f9f3ba74e7b935234e": "Jeg kan lære dig at lave mad!"
      },
      "name": "Crystal Boughman",
      "translationMetadata": {
        "fields": {
