    "ptBR": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Encontre Shandrina no Refúgio Brisaprata. Ela pode lhe vender o \"Livro de Receitas do Perito\".",
        "0bcef4828bc8b422fc20": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "152b1427842f2be1cfc7": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "3b7ab70ebfe689988972": "Treine-me.",
        "d4f9f3ba74e7b935234e": "Eu posso ensinar você a cozinhar!"
      },
      "name": "Christiane Justa",
      "subName": "Treinamento de Culinária",
