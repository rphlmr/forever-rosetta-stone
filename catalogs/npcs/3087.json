    "hrHR": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Potraži Shandrinu u Silverwind Refugeu. Može ti prodati „Stručnu kuharicu“.",
        "0bcef4828bc8b422fc20": "Kuhanje je životni poziv i vidim da dijelimo istu strast!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave iz Gadgetzana majstor je kulinarske umjetnosti. Moraš ga potražiti želiš li napredovati.",
        "3b7ab70ebfe689988972": "Podučite me.",
        "d4f9f3ba74e7b935234e": "Mogu te naučiti kuhati!"
      },
