    "plPL": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Odszukaj Shandrinę w Silverwind Refuge. Może sprzedać ci „Ekspercką książkę kucharską”.",
        "0bcef4828bc8b422fc20": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave z Gadgetzanu jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odszukać.",
        "3b7ab70ebfe689988972": "Wyszkol mnie.",
        "d4f9f3ba74e7b935234e": "Mogę nauczyć cię gotować!"
      },
      "name": "Crystal Boughman",
