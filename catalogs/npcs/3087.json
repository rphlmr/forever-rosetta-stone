    "enUS": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Seek out Shandrina in Silverwind Refuge.  She can sell you the \"Expert Cookbook\".",
        "0bcef4828bc8b422fc20": "Cooking is a life long pursuit and I see we share the same passion!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out.",
        "3b7ab70ebfe689988972": "Train me.",
        "d4f9f3ba74e7b935234e": "I can teach you how to cook!"
      },
      "name": "Crystal Boughman",
      "subName": "Cooking Trainer",
