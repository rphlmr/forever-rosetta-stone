    "esES": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Busca a Shandrina en el Refugio Brisa de Plata. Te puede vender el \"Recetario para expertos\".",
        "0bcef4828bc8b422fc20": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión.",
        "152b1427842f2be1cfc7": "Dirge Hojágil de Gadgetzan es un maestro de las artes culinarias. Búscale si quieres que tu habilidad mejore.",
        "3b7ab70ebfe689988972": "Entréname.",
        "d4f9f3ba74e7b935234e": "Puedo enseñarte a cocinar."
      },
      "name": "Ramacho de cristal",
      "subName": "Instructor de cocina",
