    "svSE": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Sök upp Shandrina i Silverwind Refuge. Hon kan sälja dig ”Expertkokboken”.",
        "0bcef4828bc8b422fc20": "Matlagning är en livslång syssla och jag ser att vi delar samma passion!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave i Gadgetzan är en mästare på kokkonst. För att bli bättre måste du söka upp honom.",
        "3b7ab70ebfe689988972": "Träna mig.",
        "d4f9f3ba74e7b935234e": "Jag kan lära dig att laga mat!"
      },
      "name": "Crystal Boughman",
