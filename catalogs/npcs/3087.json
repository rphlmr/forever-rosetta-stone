    "frFR": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Allez voir Shandrina au refuge de Vent-argent. Elle pourra vous vendre un livre de cuisine pour experts.",
        "0bcef4828bc8b422fc20": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "152b1427842f2be1cfc7": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner.",
        "3b7ab70ebfe689988972": "Entraînez-moi.",
        "d4f9f3ba74e7b935234e": "Je peux vous apprendre à cuisiner !"
      },
      "name": "Crystal Boughman",
      "subName": "Maître des cuisiniers",
