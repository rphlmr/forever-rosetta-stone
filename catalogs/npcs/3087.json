    "trTR": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Silverwind Refuge'daki Shandrina'yı bul. Sana \"Uzman Yemek Kitabı\"nı satabilir.",
        "0bcef4828bc8b422fc20": "Yemek pişirmek ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "152b1427842f2be1cfc7": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarında bir ustadır. Kendini geliştirmek için onu bulmalısın.",
        "3b7ab70ebfe689988972": "Beni eğit.",
        "d4f9f3ba74e7b935234e": "Sana yemek pişirmeyi öğretebilirim!"
      },
