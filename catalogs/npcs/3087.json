  "locales": {
    "csCZ": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Vyhledej Shandrinu v Silverwind Refuge. Může ti prodat „Kuchařku pro pokročilé“.",
        "0bcef4828bc8b422fc20": "Vaření je celoživotní poslání a vidím, že sdílíme stejnou vášeň!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave z Gadgetzanu je mistrem kuchařského umění. Pokud se chceš zdokonalit, musíš ho vyhledat.",
        "3b7ab70ebfe689988972": "Vycvičte mě.",
        "d4f9f3ba74e7b935234e": "Mohu tě naučit vařit!"
      },
      "name": "Crystal Boughman",
      "translationMetadata": {
