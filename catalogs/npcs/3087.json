    "itIT": {
      "dialogue": {
        "03e8652cba65bb5a941b": "Cerca Shandrina al Rifugio di Silverwind. Può venderti il \"Ricettario per Esperti\".",
        "0bcef4828bc8b422fc20": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "152b1427842f2be1cfc7": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo.",
        "3b7ab70ebfe689988972": "Addestrami.",
        "d4f9f3ba74e7b935234e": "Posso insegnarti a cucinare!"
      },
      "name": "Crystal Boughman",
