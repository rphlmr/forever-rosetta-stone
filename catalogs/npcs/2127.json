    "daDK": {
      "dialogue": {
        "0f35e42996e8cab9a96f": "Jeg stiller mig til rådighed for videre træning, mester.",
        "348a474733858dab8f0b": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver vanskeligere for hver gang og derfor også dyrere ved hver omskoling. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "67d75f66d674a590885a": "Det er klogt, at du ydmyger dig for mig, $N, i dit ønske om mere viden om trolddom.",
        "9415284b1c57544538d8": "Jeg har ikke tid at spilde på din slags, $c."
      },
      "name": "Rupert Boch",
      "translationMetadata": {
        "fields": {
