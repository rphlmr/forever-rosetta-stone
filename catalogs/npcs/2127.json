    "ltLT": {
      "dialogue": {
        "0f35e42996e8cab9a96f": "Esu pasirengęs toliau mokytis, mokytojau.",
        "348a474733858dab8f0b": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti viską, ko jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kaskart tai padaryti tampa vis sunkiau, todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad priverščiau tave pamiršti išmoktus talentus?",
        "67d75f66d674a590885a": "Išmintingai elgiesi nusižemindamas prieš mane, $N, ir siekdamas daugiau kerėtojo žinių.",
        "9415284b1c57544538d8": "Neturiu laiko gaišti su tokiais kaip tu, $c."
      },
      "name": "Rupert Boch",
      "subName": "Kerėtojų mokytojas",
