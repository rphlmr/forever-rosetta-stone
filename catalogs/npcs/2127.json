    "enUS": {
      "dialogue": {
        "0f35e42996e8cab9a96f": "I submit myself for further training my master.",
        "348a474733858dab8f0b": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "67d75f66d674a590885a": "It is wise that you humble yourself before me $N in your desire for more warlock knowledge.",
        "9415284b1c57544538d8": "I have no time to waste on the likes of you $c."
      },
      "name": "Rupert Boch",
      "subName": "Warlock Trainer",
      "translationMetadata": {
