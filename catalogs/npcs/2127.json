  "locales": {
    "csCZ": {
      "dialogue": {
        "0f35e42996e8cab9a96f": "Přicházím na další výcvik, mistře.",
        "348a474733858dab8f0b": "Přísným přecvičením jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přecvičení dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "67d75f66d674a590885a": "Je moudré, že se přede mnou pokořuješ, $N, když toužíš po dalších znalostech černokněžníka.",
        "9415284b1c57544538d8": "Nemám čas ztrácet ho s takovými, jako jsi ty, $c."
      },
      "name": "Rupert Boch",
      "translationMetadata": {
        "fields": {
          "dialogue.0f35e42996e8cab9a96f": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
