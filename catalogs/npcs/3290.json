    "enUS": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Where's my spinner? I just had it here somewhere...",
        "aaaf6ff0d5d14a242de9": "I would be delighted to aid you in the commencement of your pursuit! Let me grab my spinner and we'll get started...",
        "ce1395e77f4822f5c341": "Train me.",
        "d42fdc65aa222da415c4": "Your current aptitude exceeds my instructional capabilities. You should enquire further with my fellow Gnome Trixie Quickswitch in Ironforge!"
      },
      "name": "Deek Fizzlebizz",
      "subName": "Journeyman Engineer",
      "translationMetadata": {
