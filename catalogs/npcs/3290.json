    "ltLT": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Kur mano suktuvas? Ką tik jį čia kažkur turėjau...",
        "aaaf6ff0d5d14a242de9": "Su malonumu padėsiu tau žengti pirmuosius žingsnius! Tik pasiimsiu savo suktuvą ir galėsime pradėti...",
        "ce1395e77f4822f5c341": "Išmokyk mane.",
        "d42fdc65aa222da415c4": "Tavo dabartiniai gebėjimai viršija tai, ko galiu tave išmokyti. Kreipkis į mano tautietę gnomę Trixie Quickswitch Geležkalvėje!"
      },
      "name": "Deek Fizzlebizz",
      "subName": "Patyręs inžinierius",
