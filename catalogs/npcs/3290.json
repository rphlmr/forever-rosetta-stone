    "ptBR": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Onde está meu centrifugador? Deixei aqui em algum lugar...",
        "aaaf6ff0d5d14a242de9": "Seria um prazer ajudá-lo no início de sua busca. Só vou pegar meu centrifugador para podermos começar...",
        "ce1395e77f4822f5c341": "Treine-me.",
        "d42fdc65aa222da415c4": "Tua aptidão atual excede minhas capacidades instrucionais. Tu deve buscar mais instruções com minha camarada gnomida Trixie Trocarrápida em Altaforja!"
      },
      "name": "Deek Crepitante",
      "subName": "Engenheiro Profissional",
