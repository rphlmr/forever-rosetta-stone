    "frFR": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Où est mon battoir ? Il était quelque part par là...",
        "aaaf6ff0d5d14a242de9": "Ce sera un honneur de guider vos débuts. Laissez-moi prendre mon battoir et commençons...",
        "ce1395e77f4822f5c341": "Entraînez-moi.",
        "d42fdc65aa222da415c4": "Votre aptitude excède mes propres capacités. Tâchez de progresser en allant voir ma collègue gnome Trixie Quickswitch, à Ironforge !"
      },
      "name": "Deek Fizzlebizz",
      "subName": "Ingénieur - Compagnon",
