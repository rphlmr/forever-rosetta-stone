    "plPL": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Gdzie jest mój kołowrotek? Przed chwilą gdzieś tu był...",
        "aaaf6ff0d5d14a242de9": "Z przyjemnością pomogę ci rozpocząć naukę! Wezmę tylko kołowrotek i zaczniemy...",
        "ce1395e77f4822f5c341": "Wyszkol mnie.",
        "d42fdc65aa222da415c4": "Twoje obecne umiejętności przekraczają moje możliwości nauczania. Zapytaj moją znajomą gnomkę, Trixie Quickswitch, w Ironforge!"
      },
      "name": "Deek Fizzlebizz",
