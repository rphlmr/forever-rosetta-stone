    "itIT": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Dov'è il mio frullino? Ce l'avevo qui da qualche parte...",
        "aaaf6ff0d5d14a242de9": "Sarei lietissimo di assisterti nell'avvio della tua impresa! Prendo il mio frullino e cominciamo...",
        "ce1395e77f4822f5c341": "Addestrami.",
        "d42fdc65aa222da415c4": "Le tue capacità attuali superano quello che posso insegnarti. Dovresti rivolgerti alla mia collega Gnoma Trixie Quickswitch, a Ironforge!"
      },
      "name": "Deek Fizzlebizz",
