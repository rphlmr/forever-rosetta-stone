    "esES": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "¿Dónde está mi centrifugador? Estaba por algún sitio...",
        "aaaf6ff0d5d14a242de9": "¡Estaría encantado de ayudarte a comenzar tu tarea! Déjame coger mi centrifugador y nos pondremos en marcha...",
        "ce1395e77f4822f5c341": "Entréname.",
        "d42fdc65aa222da415c4": "Tus aptitudes superan mi capacidad para instruirte. ¡Deberías preguntar a mi compañero gnomo Trixie Chispaveloz de Forjaz!"
      },
      "name": "Deek Malnegocio",
      "subName": "Oficial de ingeniería",
