    "trTR": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Çıkrığım nerede? Az önce buralardaydı...",
        "aaaf6ff0d5d14a242de9": "Öğrenmeye başlamana seve seve yardım ederim! Çıkrığımı alayım da başlayalım...",
        "ce1395e77f4822f5c341": "Beni eğit.",
        "d42fdc65aa222da415c4": "Şu anki yeteneğin sana öğretebileceklerimi aşıyor. Ironforge’daki gnom dostum Trixie Quickswitch’e danışmalısın!"
      },
