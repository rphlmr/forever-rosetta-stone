    "hrHR": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Gdje mi je kolovrat? Maloprije je bio negdje ovdje...",
        "aaaf6ff0d5d14a242de9": "Rado ću ti pomoći započeti! Samo da uzmem kolovrat pa možemo krenuti...",
        "ce1395e77f4822f5c341": "Podučite me.",
        "d42fdc65aa222da415c4": "Tvoje sadašnje sposobnosti nadilaze ono čemu te mogu naučiti. Obrati se mojoj kolegici gnomici Trixie Quickswitch u Ironforgeu!"
      },
      "name": "Deek Fizzlebizz",
