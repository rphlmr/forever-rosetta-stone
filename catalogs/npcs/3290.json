    "daDK": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Hvor er min spinderok? Jeg havde den lige her et sted...",
        "aaaf6ff0d5d14a242de9": "Jeg hjælper dig gerne med at komme i gang! Lad mig hente min spinderok, så begynder vi...",
        "ce1395e77f4822f5c341": "Træn mig.",
        "d42fdc65aa222da415c4": "Dine evner overstiger, hvad jeg kan lære dig. Spørg min gnomkollega Trixie Quickswitch i Ironforge!"
      },
      "name": "Deek Fizzlebizz",
      "translationMetadata": {
        "fields": {
