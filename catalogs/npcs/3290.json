    "svSE": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Var är min spinnrock? Jag hade den ju här någonstans...",
        "aaaf6ff0d5d14a242de9": "Jag hjälper dig gärna att komma igång! Låt mig hämta min spinnrock så börjar vi...",
        "ce1395e77f4822f5c341": "Träna mig.",
        "d42fdc65aa222da415c4": "Din nuvarande skicklighet överstiger vad jag kan lära dig. Fråga min gnomkollega Trixie Quickswitch i Ironforge!"
      },
