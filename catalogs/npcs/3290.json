  "locales": {
    "csCZ": {
      "dialogue": {
        "a6d66fbc35abd402d4aa": "Kde mám kolovrátek? Ještě před chvílí tu někde byl...",
        "aaaf6ff0d5d14a242de9": "Rád ti pomohu začít se studiem! Vezmu svůj kolovrátek a můžeme začít...",
        "ce1395e77f4822f5c341": "Vycvičte mě.",
        "d42fdc65aa222da415c4": "Tvé současné schopnosti přesahují mé učitelské možnosti. Obrať se na mou kolegyni, gnómku Trixie Quickswitch v Ironforge!"
      },
      "name": "Deek Fizzlebizz",
      "translationMetadata": {
