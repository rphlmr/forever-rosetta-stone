    "hrHR": {
      "dialogue": {
        "0c9e31efbcfeee20bf65": "Pazi na sebe u pustinji, $c.",
        "ff46ae04405e23cf8dfa": "Ah, ti si pronašao pismo. Hvala ti na... vijestima o mojoj obitelji, valjda. Posluži se hranom i pićem koje ti mogu ponuditi."
      },
      "name": "Garon Hutchins",
