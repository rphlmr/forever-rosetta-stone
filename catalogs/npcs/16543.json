    "trTR": {
      "dialogue": {
        "0c9e31efbcfeee20bf65": "Çölde dikkatli ol, $c.",
        "ff46ae04405e23cf8dfa": "Demek mektubu bulan sensin. Ailem hakkındaki... haberler için teşekkür ederim, sanırım. Sunabileceğim yiyecek ve içeceklerden alabilirsin."
      },
      "name": "Garon Hutchins",
      "translationMetadata": {
