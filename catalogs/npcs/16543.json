    "daDK": {
      "dialogue": {
        "0c9e31efbcfeee20bf65": "Pas på derude i ørkenen, $c.",
        "ff46ae04405e23cf8dfa": "Nå, det var dig, der fandt brevet. Tak for... nyt om min familie, må jeg vel sige. Du er velkommen til den mad og drikke, jeg kan tilbyde."
      },
      "name": "Garon Hutchins",
      "translationMetadata": {
        "fields": {
          "dialogue.0c9e31efbcfeee20bf65": {
