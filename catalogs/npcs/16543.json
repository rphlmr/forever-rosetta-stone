    "csCZ": {
      "dialogue": {
        "0c9e31efbcfeee20bf65": "V poušti buď opatrný, $c.",
        "ff46ae04405e23cf8dfa": "Ach, tys našel ten dopis. Děkuji za ty... zprávy o mé rodině, řekněme. Posluž si jídlem a pitím, které ti mohu nabídnout."
      },
      "name": "Garon Hutchins",
      "translationMetadata": {
