    "enUS": {
      "dialogue": {
        "0c9e31efbcfeee20bf65": "Be careful out in the desert, $c.",
        "ff46ae04405e23cf8dfa": "Ah, you're the one who found the letter. Thank you for the... news, I suppose, about my family. You're welcome to what food and drink I can offer."
      },
      "name": "Garon Hutchins",
      "translationMetadata": {
