          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Splintertree Post’a gelen giden kervanları ve tüccarları öğrenmek istiyorsan neyse ki aradığın ork benim. Ne yazık ki ben insanları sevmem.$B$BBir şey istiyorsan çabuk söyle."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
