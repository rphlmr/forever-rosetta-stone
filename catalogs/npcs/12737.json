          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "deDE",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "enUS": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "If you want to know about the comings and goings of caravans and merchants here in Splintertree Post, then I am fortunately the orc you are looking for.  Unfortunately for you though, I don't like people.$B$BIf you want something, make it quick."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "enUS",
            "sourceSha256": "c4e067459948eab40a43d8b6c28acaea77bf01eac085e389dce1fa5d57e9f8fd"
          },
          "name": {
            "origin": "original",
            "source": "egLink",
            "sourceBuild": "1.60.1.70938",
            "sourceLocale": "enUS",
            "sourceRevision": "6ff5612b54191f297eb77ca8eda81de029d9d6f0"
          }
        }
      }
    },
    "esES": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Si te interesa la ida y venida de las caravanas y los mercaderes aquí, en el Puesto del Hachazo, entonces has tenido suerte, soy el orco que estás buscando. Sin embargo, mala suerte, no me gustan las personas.\n\nSi quieres algo, dilo rápidamente."
      },
      "name": "Mastok Sibilante",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
