  "locales": {
    "csCZ": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Pokud chceš vědět o příchodech a odchodech karavan a obchodníků tady ve Splintertree Post, pak jsem naštěstí ork, kterého hledáš. Bohužel pro tebe nemám rád lidi.$B$BJestli něco chceš, mluv rychle."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Hvis du vil vide noget om karavanernes og handelsfolkenes kommen og gåen her i Splintertree Post, er jeg heldigvis den ork, du leder efter. Desværre for dig bryder jeg mig ikke om folk.$B$BHvis du vil noget, så gør det hurtigt."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Wenn Ihr etwas über das Kommen und Gehen der Karawanen und Händler hier im Splintertreeposten wissen wollt, dann bin ich zu Eurem Glück der Orc, nach dem Ihr sucht. Aber zu Eurem Unglück mag ich keine Menschen.\n\nWenn Ihr also etwas wollt, dann macht es schnell."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "deDE",
