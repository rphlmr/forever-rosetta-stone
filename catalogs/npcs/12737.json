    "hrHR": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Ako želiš znati o dolascima i odlascima karavana i trgovaca ovdje u Splintertree Postu, onda sam srećom ork kojeg tražiš. Na tvoju žalost, ne volim ljude.$B$BAko nešto želiš, budi brz."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
