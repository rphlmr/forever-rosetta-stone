            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Якщо хочеш знати, які каравани й торговці прибувають до Splintertree Post і вирушають звідси, то тобі пощастило: я саме той орк, якого ти шукаєш. На жаль для тебе, я не люблю людей.$B$BЯкщо тобі щось потрібно, кажи швидко."
      },
      "name": "Масток Хитрошип",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
