            "sourceLocale": "ptBR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Если тебя интересует расписание появления торговцев и караванов на заставе Расщепленного Древа, ты обратился по адресу. К сожалению, я не слишком люблю общаться.\n\nТак что если тебе что-то нужно, давай побыстрее."
      },
      "name": "Масток Райльшип",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
            "origin": "community",
