            "sourceLocale": "ruRU",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Om du vill veta vilka karavaner och handelsmän som kommer och går här i Splintertree Post, är jag lyckligtvis orchen du söker. Olyckligtvis för dig tycker jag inte om folk.$B$BOm du vill något, fatta dig kort."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
