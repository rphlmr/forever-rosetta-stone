          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "59b2561e5fb7b23a3ea0": "Se vuoi sapere del viavai di carovane e mercanti qui all'Avamposto di Splintertree, per fortuna sono l'orco che cerchi. Per tua sfortuna, però, la gente non mi piace.\n\nSe vuoi qualcosa, sbrigati."
      },
      "name": "Mastok Wrilehiss",
      "translationMetadata": {
        "fields": {
          "dialogue.59b2561e5fb7b23a3ea0": {
            "origin": "community",
