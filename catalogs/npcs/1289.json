  "locales": {
    "csCZ": {
      "dialogue": {
        "1fa835ea06f8077f744e": "Nejlepší nabídky v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?",
        "3183279871b9f9e37768": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "e57e00d40ac5783ea943": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Gunther Weller",
