    "svSE": {
      "dialogue": {
        "1fa835ea06f8077f744e": "De bästa erbjudandena i hela Stormwind, min vän. Du hittar inga bättre. Vad kan jag hjälpa dig med?",
        "3183279871b9f9e37768": "Tittar du bara på mina varor, eller kan jag hjälpa dig att hitta något särskilt i dag?",
        "e57e00d40ac5783ea943": "Jag vill se dina varor."
      },
