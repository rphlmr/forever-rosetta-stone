    "enUS": {
      "dialogue": {
        "1fa835ea06f8077f744e": "Best deals in all of Stormwind my friend, won't find any better. Now, what can I help you with?",
        "3183279871b9f9e37768": "Just browsing my wares or is there something specific I can help you find today?",
        "e57e00d40ac5783ea943": "I want to browse your goods."
      },
      "name": "Gunther Weller",
      "subName": "Weapons Merchant",
