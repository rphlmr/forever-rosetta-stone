    "daDK": {
      "dialogue": {
        "1fa835ea06f8077f744e": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe med?",
        "3183279871b9f9e37768": "Kigger du bare på mine varer, eller kan jeg hjælpe dig med at finde noget bestemt i dag?",
        "e57e00d40ac5783ea943": "Jeg vil gerne se dine varer."
      },
      "name": "Gunther Weller",
      "translationMetadata": {
