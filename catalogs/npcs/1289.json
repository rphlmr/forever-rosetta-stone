    "hrHR": {
      "dialogue": {
        "1fa835ea06f8077f744e": "Najbolje ponude u cijelom Stormwindu, prijatelju, bolje nećeš naći. Kako ti mogu pomoći?",
        "3183279871b9f9e37768": "Samo razgledavaš moju robu ili ti mogu pomoći pronaći nešto određeno?",
        "e57e00d40ac5783ea943": "Želim pogledati vašu robu."
      },
      "name": "Gunther Weller",
