    "deDE": {
      "dialogue": {
        "1fa835ea06f8077f744e": "Die besten Preise in ganz Stormwind, was Besseres werdet Ihr nicht finden. Womit kann ich Euch denn nun dienen?",
        "3183279871b9f9e37768": "Seht Ihr Euch nur um oder kann ich Euch irgendwie helfen?",
        "e57e00d40ac5783ea943": "Ich möchte Eure Waren ansehen."
      },
      "name": "Gunther Weller",
      "subName": "Waffenhändler",
