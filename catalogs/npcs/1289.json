    "plPL": {
      "dialogue": {
        "1fa835ea06f8077f744e": "Najlepsze oferty w całym Stormwind, przyjacielu, lepszych nie znajdziesz. W czym mogę pomóc?",
        "3183279871b9f9e37768": "Tylko oglądasz mój towar, czy mogę pomóc ci znaleźć dziś coś konkretnego?",
        "e57e00d40ac5783ea943": "Chcę przejrzeć twoje towary."
      },
      "name": "Gunther Weller",
