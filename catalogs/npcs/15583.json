    "itIT": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "L'Anziano Dreamseer risiede a Gadgetzan, nel Tanaris Desert.",
        "5801d16d81c6179e203a": "Se ti rechi a Cenarion Hold, in Silithus, troverai l'Anziana Bladesing.",
        "84ae5d33dd2bedcfc8ed": "L'Anziana Ragetotem passa le sue giornate nella Valle dei Guardiani, nel Tanaris Desert.",
        "a2ca7e25ed7350a7e348": "L'Anziano Primestone ha passato molti anni nella Valle di Cristallo, in Silithus.",
        "ba48187cfb36975a04a9": "Zul'Farrak, nel Tanaris Desert, è la dimora dell'Anziana Wildmane.",
        "e5aa0c11c59591c1bbed": "In tempi ormai lontani, vivevamo per la caccia. Cacciavamo per la gloria, per l'onore...\n\nÈ poi così diverso, adesso?"
      },
      "name": "Anziano Thunderhorn",
      "translationMetadata": {
