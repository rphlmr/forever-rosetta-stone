    "hrHR": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Starješina Dreamseer boravi u Gadgetzanu u pustinji Tanaris.",
        "5801d16d81c6179e203a": "U Cenarion Holdu u Silithusu pronaći ćeš starješinu Bladesinga.",
        "84ae5d33dd2bedcfc8ed": "Starješina Ragetotem provodi dane u Dolini čuvara u pustinji Tanaris.",
        "a2ca7e25ed7350a7e348": "Starješina Primestone proveo je mnogo godina u Kristalnoj dolini u Silithusu.",
        "ba48187cfb36975a04a9": "Zul'Farrak u pustinji Tanaris dom je starješine Wildmanea.",
        "e5aa0c11c59591c1bbed": "U davnim smo danima živjeli za lov. Lovili smo za slavu, za čast...$B$BJe li sada toliko drukčije?"
