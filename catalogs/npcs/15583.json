    "trTR": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Yaşlı Dreamseer, Tanaris Çölü’ndeki Gadgetzan’da yaşar.",
        "5801d16d81c6179e203a": "Silithus’taki Cenarion Hold’a gidersen Elder Bladesing’i bulursun.",
        "84ae5d33dd2bedcfc8ed": "Yaşlı Ragetotem günlerini Tanaris Çölü’ndeki Gözcüler Vadisi’nde geçirir.",
        "a2ca7e25ed7350a7e348": "Yaşlı Primestone, Silithus'taki Kristal Vadi'de uzun yıllar geçirdi.",
        "ba48187cfb36975a04a9": "Yaşlı Wildmane'in evi Tanaris Çölü'ndeki Zul'Farrak'tır.",
        "e5aa0c11c59591c1bbed": "Çok eskiden av için yaşardık. Şan için, onur için avlanırdık...$B$BŞimdi çok mu farklı?"
      },
      "name": "Ulu Thunderhorn",
