    "plPL": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Starszy Dreamseer mieszka w Gadgetzan na pustyni Tanaris.",
        "5801d16d81c6179e203a": "W Cenarion Hold w Silithus znajdziesz starszego Bladesinga.",
        "84ae5d33dd2bedcfc8ed": "Starsza Ragetotem spędza dni w Dolinie Strażników na pustyni Tanaris.",
        "a2ca7e25ed7350a7e348": "Starszy Primestone spędził wiele lat w Kryształowej Dolinie w Silithus.",
        "ba48187cfb36975a04a9": "Domem starszego Wildmane’a jest Zul'Farrak na pustyni Tanaris.",
        "e5aa0c11c59591c1bbed": "W dawnych czasach żyliśmy dla polowania. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest tak inaczej?"
      },
      "name": "Starszy Thunderhorn",
