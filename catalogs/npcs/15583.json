    "deDE": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Urahne Dreamseer wohnt in Gadgetzan in der Tanariswüste.",
        "5801d16d81c6179e203a": "Wenn Ihr zur Burg Cenarius in Silithus reist, werdet Ihr Urahnin Bladesing finden.",
        "84ae5d33dd2bedcfc8ed": "Urahnin Ragetotem verbringt Ihre Tage im Tal der Behüter in der Tanariswüste.",
        "a2ca7e25ed7350a7e348": "Urahne Primestone hat viele Jahre im Kristalltal in Silithus verbracht.",
        "ba48187cfb36975a04a9": "Zul'Farrak, in der Tanariswüste, ist die Heimat von Urahnin Wildmane.",
        "e5aa0c11c59591c1bbed": "In längst vergangenen Tagen lebten wir für die Jagd. Wir jagten nach Ruhm, nach Ehre…\n\nIst jetzt alles anders?"
      },
      "name": "Urahne Thunderhorn",
      "translationMetadata": {
