    "svSE": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Äldste Dreamseer bor i Gadgetzan i Tanarisöknen.",
        "5801d16d81c6179e203a": "Om du reser till Cenarion Hold i Silithus hittar du Elder Bladesing.",
        "84ae5d33dd2bedcfc8ed": "Äldste Ragetotem tillbringar dagarna i Valley of the Watchers i Tanarisöknen.",
        "a2ca7e25ed7350a7e348": "Äldste Primestone har tillbringat många år i Kristalldalen i Silithus.",
        "ba48187cfb36975a04a9": "Zul'Farrak i Tanarisöknen är äldste Wildmanes hem.",
        "e5aa0c11c59591c1bbed": "I svunna tider levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?"
      },
      "name": "Äldste Thunderhorn",
