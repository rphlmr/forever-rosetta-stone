    "daDK": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Ældste Dreamseer bor i Gadgetzan i Tanarisørkenen.",
        "5801d16d81c6179e203a": "Rejser du til Cenarion Hold i Silithus, finder du Elder Bladesing.",
        "84ae5d33dd2bedcfc8ed": "Ældste Ragetotem tilbringer dagene i Vogternes Dal i Tanarisørkenen.",
        "a2ca7e25ed7350a7e348": "Ældste Primestone har tilbragt mange år i Krystaldalen i Silithus.",
        "ba48187cfb36975a04a9": "Zul'Farrak i Tanarisørkenen er ældste Wildmanes hjem.",
        "e5aa0c11c59591c1bbed": "I svundne tider levede vi for jagten. Vi jagede for hæder og ære...$B$BEr det så anderledes nu?"
      },
      "name": "Ældste Thunderhorn",
      "translationMetadata": {
