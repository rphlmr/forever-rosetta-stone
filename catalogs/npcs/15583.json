    "esES": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "El ancestro Visionírico reside en Gadgetzan en el Desierto de Tanaris.",
        "5801d16d81c6179e203a": "Si viajas hasta el Fuerte Cenarion en Silithus, encontrarás al ancestro Cantofilo.",
        "84ae5d33dd2bedcfc8ed": "El ancestro Furiatótem pasa sus días en el Valle de los Vigías en el Desierto de Tanaris.",
        "a2ca7e25ed7350a7e348": "El ancestro Primapiedra lleva muchos años en La Vega de Cristal en Silithus.",
        "ba48187cfb36975a04a9": "Zul'Farrak en el Desierto de Tanaris es el hogar del ancestro Bravacrín.",
        "e5aa0c11c59591c1bbed": "En tiempos remotos, vivíamos para la caza. La caza de gloria, de honor... \n\n¿Es que ahora es tan diferente?"
      },
      "name": "Ancestro Astatrueno",
