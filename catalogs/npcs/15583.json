  "locales": {
    "csCZ": {
      "dialogue": {
        "52d1cbc9e98a730cd29a": "Starší Dreamseer sídlí v Gadgetzanu v poušti Tanaris.",
        "5801d16d81c6179e203a": "V Cenarion Hold v Silithu najdeš staršího Bladesinga.",
        "84ae5d33dd2bedcfc8ed": "Starší Ragetotem tráví dny v Údolí strážců v poušti Tanaris.",
        "a2ca7e25ed7350a7e348": "Stařešina Primestone strávil mnoho let v Křišťálovém údolí v Silithu.",
        "ba48187cfb36975a04a9": "Domovem staršího Wildmanea je Zul'Farrak v poušti Tanaris.",
        "e5aa0c11c59591c1bbed": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu, pro čest...$B$BJe to dnes tak jiné?"
      },
      "name": "Starší Thunderhorn",
      "translationMetadata": {
