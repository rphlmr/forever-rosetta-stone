    "svSE": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Du måste hitta Nat Pagle i Dustwallow Marsh om du vill bli skickligare.",
        "8e121a4ebc9b4ee99c57": "Jag behöver träning, Grimnur.",
        "9e4ef9958b0a1cd21851": "Din skicklighet överträffar min, men jag har hört att gamle Heming i Booty Bay har exemplar av ”Abborren och du”. Den lär säkert hjälpa dig att bli skickligare.",
        "d319b885d07f047fdf1f": "Japp, jag kan lära dig att fiska."
      },
      "name": "Grimnur Stonebrand",
