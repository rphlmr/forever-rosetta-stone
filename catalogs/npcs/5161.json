    "hrHR": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Moraš pronaći Nata Paglea u Dustwallow Marshu ako želiš postati bolji.",
        "8e121a4ebc9b4ee99c57": "Trebam obuku, Grimnure.",
        "9e4ef9958b0a1cd21851": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige „Grgeč i ti“. Sigurno će ti pomoći da poboljšaš svoju vještinu.",
        "d319b885d07f047fdf1f": "Da, mogu te naučiti pecati."
      },
      "name": "Grimnur Stonebrand",
