    "esES": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "8e121a4ebc9b4ee99c57": "Necesito instrucción, Grimnur.",
        "9e4ef9958b0a1cd21851": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "d319b885d07f047fdf1f": "Sí, puedo enseñarte a pescar."
      },
      "name": "Grimnur Marcapedra",
      "subName": "Instructor de pesca",
