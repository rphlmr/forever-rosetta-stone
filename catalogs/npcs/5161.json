    "daDK": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive dygtigere.",
        "8e121a4ebc9b4ee99c57": "Jeg har brug for træning, Grimnur.",
        "9e4ef9958b0a1cd21851": "Du er dygtigere end mig, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af „Aborren og dig“. Den vil helt sikkert hjælpe dig med at forbedre dine færdigheder.",
        "d319b885d07f047fdf1f": "Jep, jeg kan lære dig at fiske."
      },
      "name": "Grimnur Stonebrand",
      "translationMetadata": {
        "fields": {
