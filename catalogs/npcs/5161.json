    "frFR": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "8e121a4ebc9b4ee99c57": "J'ai besoin d'une formation, Grimnur.",
        "9e4ef9958b0a1cd21851": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "d319b885d07f047fdf1f": "Ouais, je peux vous apprendre à pêcher."
      },
      "name": "Grimnur Stonebrand",
      "subName": "Maître des pêcheurs",
