    "plPL": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Jeśli chcesz dalej rozwijać swoje umiejętności, musisz znaleźć Nata Pagle’a w Dustwallow Marsh.",
        "8e121a4ebc9b4ee99c57": "Potrzebuję szkolenia, Grimnurze.",
        "9e4ef9958b0a1cd21851": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze książki „Okoń i ty”. Z pewnością pomoże ci rozwinąć umiejętności.",
        "d319b885d07f047fdf1f": "Ano, mogę nauczyć cię łowić ryby."
      },
      "name": "Grimnur Stonebrand",
      "translationMetadata": {
