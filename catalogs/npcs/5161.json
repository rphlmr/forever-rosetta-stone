  "locales": {
    "csCZ": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Pokud se chceš dále zlepšovat, musíš najít Nata Paglea v Dustwallow Marsh.",
        "8e121a4ebc9b4ee99c57": "Potřebuji výcvik, Grimnure.",
        "9e4ef9958b0a1cd21851": "Tvé dovednosti předčí mé, ale slyšel jsem, že starý Heming v Booty Bay má výtisky knihy „Okoun a ty“. Ta ti určitě pomůže se zlepšit.",
        "d319b885d07f047fdf1f": "Jo, můžu tě naučit rybařit."
      },
      "name": "Grimnur Stonebrand",
      "translationMetadata": {
        "fields": {
