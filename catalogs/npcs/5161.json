    "enUS": {
      "dialogue": {
        "8809661a7c48ce57c18a": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "8e121a4ebc9b4ee99c57": "I require training, Grimnur.",
        "9e4ef9958b0a1cd21851": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "d319b885d07f047fdf1f": "Yap, I can teach ye to fish."
      },
      "name": "Grimnur Stonebrand",
      "subName": "Fishing Trainer",
