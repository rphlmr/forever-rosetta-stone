    "itIT": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Per migliorare ancora dovrai trovare Nat Pagle a Dustwallow Marsh.",
        "8e121a4ebc9b4ee99c57": "Ho bisogno di addestramento, Grimnur.",
        "9e4ef9958b0a1cd21851": "La tua abilità supera la mia, ma ho sentito che il Vecchio Heming, a Booty Bay, ha delle copie di \"Conosci il Tuo Branzino\". Ti aiuterà di sicuro a migliorare la tua abilità.",
        "d319b885d07f047fdf1f": "Eh sì, ti posso insegnare a pescare."
      },
      "name": "Grimnur Stonebrand",
