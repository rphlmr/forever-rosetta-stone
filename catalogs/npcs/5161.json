    "ltLT": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Jei nori toliau tobulėti, turėsi susirasti Nat Pagle Dustwallow Marsh pelkėje.",
        "8e121a4ebc9b4ee99c57": "Man reikia mokymų, Grimnur.",
        "9e4ef9958b0a1cd21851": "Tavo įgūdžiai pranoksta manuosius, tačiau girdėjau, kad senasis Heming Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau patobulėti.",
        "d319b885d07f047fdf1f": "Aha, galiu išmokyti tave žvejoti."
      },
      "name": "Grimnur Stonebrand",
      "subName": "Žvejybos mokytojas",
      "translationMetadata": {
        "fields": {
          "dialogue.8809661a7c48ce57c18a": {
