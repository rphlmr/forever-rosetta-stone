    "trTR": {
      "dialogue": {
        "8809661a7c48ce57c18a": "Daha da gelişmek için Dustwallow Marsh’ta Nat Pagle’ı bulmalısın.",
        "8e121a4ebc9b4ee99c57": "Eğitime ihtiyacım var, Grimnur.",
        "9e4ef9958b0a1cd21851": "Becerin benimkini aşıyor, ama Booty Bay’deki İhtiyar Heming’in „Levrek ve Sen“ kitabından kopyaları olduğunu duydum. Bu, becerini geliştirmene kesinlikle yardımcı olur.",
        "d319b885d07f047fdf1f": "Evet, sana balık tutmayı öğretebilirim."
      },
      "name": "Grimnur Stonebrand",
