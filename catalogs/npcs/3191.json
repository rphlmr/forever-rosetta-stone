    "esES": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Quiero ver tus mercancías.",
        "7a9c0cb4879f2d3785cd": "Puedo enseñarte a cocinar.",
        "9265dc6e46812b23ad52": "Cocinar es algo para toda la vida, y veo que compartimos la misma pasión.",
        "af203fa1cee5eedab4c2": "Wulan, en la Aldea Cazasombras, puede venderte el \"Recetario para expertos\". Lo necesitarás si quieres mejorar.",
        "b2f75e76ee7ba9af18c3": "Entréname."
      },
      "name": "Cocinero Torka",
