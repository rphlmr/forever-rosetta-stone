    "ltLT": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Noriu apžiūrėti tavo prekes.",
        "1af4d7212f8919e03109": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meno meistras. Jei nori tobulėti, turėsi jį susirasti.",
        "7a9c0cb4879f2d3785cd": "Galiu išmokyti tave gaminti maistą!",
        "9265dc6e46812b23ad52": "Maisto gaminimas yra viso gyvenimo užsiėmimas, ir matau, kad mus sieja ta pati aistra!",
        "af203fa1cee5eedab4c2": "Wulan iš Shadowprey Village gali tau parduoti „Eksperto receptų knygą“. Jos prireiks, jei nori tobulėti.",
        "b2f75e76ee7ba9af18c3": "Išmokyk mane."
      },
      "name": "Virėja Torka",
      "translationMetadata": {
