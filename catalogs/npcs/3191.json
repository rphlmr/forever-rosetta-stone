    "enUS": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "I want to browse your goods.",
        "7a9c0cb4879f2d3785cd": "I can teach you how to cook!",
        "9265dc6e46812b23ad52": "Cooking is a life long pursuit and I see we share the same passion!",
        "af203fa1cee5eedab4c2": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself.",
        "b2f75e76ee7ba9af18c3": "Train me."
      },
      "name": "Cook Torka",
