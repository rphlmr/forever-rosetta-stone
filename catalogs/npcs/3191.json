    "trTR": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Mallarına bakmak istiyorum.",
        "7a9c0cb4879f2d3785cd": "Sana yemek yapmayı öğretebilirim!",
        "9265dc6e46812b23ad52": "Yemek yapmak ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "af203fa1cee5eedab4c2": "Shadowprey Village’daki Wulan sana \"Expert Cookbook\" satabilir. Kendini geliştirmek istiyorsan ona ihtiyacın olacak.",
        "b2f75e76ee7ba9af18c3": "Beni eğit."
