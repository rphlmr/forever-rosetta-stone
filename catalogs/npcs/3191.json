    "frFR": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Je voudrais regarder vos articles.",
        "7a9c0cb4879f2d3785cd": "Je peux vous apprendre à cuisiner !",
        "9265dc6e46812b23ad52": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "af203fa1cee5eedab4c2": "Wuland du village de Proie-de-l'Ombre peut vous vendre un livre de cuisine pour experts. Il vous faudra bien ça si vous voulez vous améliorer.",
        "b2f75e76ee7ba9af18c3": "Entraînez-moi."
      },
      "name": "Cuisinier Torka",
