    "deDE": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Ich möchte Eure Waren ansehen.",
        "7a9c0cb4879f2d3785cd": "Ich kann Euch das Kochen beibringen!",
        "9265dc6e46812b23ad52": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "af203fa1cee5eedab4c2": "Wulan in Shadowprey kann Euch das \"Expertenkochbuch\" verkaufen. Ihr werdet es brauchen, wenn Ihr Euch verbessern wollt.",
        "b2f75e76ee7ba9af18c3": "Bildet mich aus."
      },
      "name": "Koch Torka",
