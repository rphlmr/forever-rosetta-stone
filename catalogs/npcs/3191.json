    "hrHR": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Želim pogledati vašu robu.",
        "1af4d7212f8919e03109": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Ako želiš usavršiti svoje vještine, morat ćeš ga potražiti.",
        "7a9c0cb4879f2d3785cd": "Mogu te naučiti kuhati!",
        "9265dc6e46812b23ad52": "Kuhanje je cjeloživotni poziv i vidim da dijelimo istu strast!",
        "af203fa1cee5eedab4c2": "Wulan u Shadowprey Villageu može ti prodati „Expert Cookbook”. Trebat će ti ako se želiš usavršiti.",
        "b2f75e76ee7ba9af18c3": "Podučite me."
      },
