    "ptBR": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Quero ver suas mercadorias.",
        "1af4d7212f8919e03109": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o.",
        "7a9c0cb4879f2d3785cd": "Eu posso ensinar você a cozinhar!",
        "9265dc6e46812b23ad52": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "af203fa1cee5eedab4c2": "Wulan, da Aldeia Pescassombra, pode lhe vender o \"Livro de Receitas do Perito\". Se você quiser se aperfeiçoar, terá de ler esse livro.",
        "b2f75e76ee7ba9af18c3": "Treine-me."
      },
      "name": "Cozinheiro Torka",
