    "svSE": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Jag vill se dina varor.",
        "7a9c0cb4879f2d3785cd": "Jag kan lära dig att laga mat!",
        "9265dc6e46812b23ad52": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!",
        "af203fa1cee5eedab4c2": "Wulan i Shadowprey Village kan sälja dig \"Expert Cookbook\". Du behöver den om du vill bli bättre.",
        "b2f75e76ee7ba9af18c3": "Träna mig."
      },
