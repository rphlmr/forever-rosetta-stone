  "locales": {
    "csCZ": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Chci si prohlédnout vaše zboží.",
        "1af4d7212f8919e03109": "Dirge Quikcleave z Gadgetzanu je mistrem kulinářského umění. Pokud se chceš zdokonalit, budeš ho muset vyhledat.",
        "7a9c0cb4879f2d3785cd": "Mohu tě naučit vařit!",
        "9265dc6e46812b23ad52": "Vaření je celoživotní záliba a vidím, že sdílíme stejnou vášeň!",
        "af203fa1cee5eedab4c2": "Wulan ve Shadowprey Village ti může prodat „Expert Cookbook“. Budeš ji potřebovat, pokud se chceš zlepšit.",
        "b2f75e76ee7ba9af18c3": "Vycvičte mě."
      },
      "name": "Kuchař Torka",
      "translationMetadata": {
        "fields": {
