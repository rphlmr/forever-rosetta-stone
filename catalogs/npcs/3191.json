    "daDK": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Jeg vil gerne se dine varer.",
        "7a9c0cb4879f2d3785cd": "Jeg kan lære dig at lave mad!",
        "9265dc6e46812b23ad52": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme passion!",
        "af203fa1cee5eedab4c2": "Wulan i Shadowprey Village kan sælge dig \"Expert Cookbook\". Du får brug for den, hvis du vil blive bedre.",
        "b2f75e76ee7ba9af18c3": "Træn mig."
      },
      "name": "Kok Torka",
      "translationMetadata": {
        "fields": {
