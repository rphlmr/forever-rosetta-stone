    "plPL": {
      "dialogue": {
        "028aa98d1c006f8a8e0b": "Chcę przejrzeć twoje towary.",
        "1af4d7212f8919e03109": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz doskonalić swoje umiejętności, musisz go odszukać.",
        "7a9c0cb4879f2d3785cd": "Mogę nauczyć cię gotować!",
        "9265dc6e46812b23ad52": "Gotowanie to zajęcie na całe życie i widzę, że podzielamy tę samą pasję!",
        "af203fa1cee5eedab4c2": "Wulan w Shadowprey Village może ci sprzedać „Expert Cookbook”. Będziesz jej potrzebować, by się doskonalić.",
        "b2f75e76ee7ba9af18c3": "Wyszkol mnie."
      },
      "name": "Kucharz Torka",
