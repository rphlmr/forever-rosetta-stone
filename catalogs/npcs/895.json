  "locales": {
    "csCZ": {
      "dialogue": {
        "00990bd3768a016ffc3a": "Hledám výcvik v umění lovce.",
        "21ae61ecfd8490b98ad6": "Copak pro tebe můžu udělat?",
        "bad128945d0a4c363bb8": "Přísným přeučováním jsem musel mnohé žáky odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je s každým opakováním náročnější. Proto je každé další přeučení dražší. Přeješ si, abych tě odnaučil talentům, které sis osvojil?",
        "d13a488f6301f349c7ef": "S výcvikem ti nemůžu pomoct. Měl bys najít trenéra pro $c."
      },
      "name": "Thorgas Grimson",
      "translationMetadata": {
        "fields": {
          "dialogue.00990bd3768a016ffc3a": {
