    "enUS": {
      "dialogue": {
        "00990bd3768a016ffc3a": "I seek training in the ways of the Hunter.",
        "21ae61ecfd8490b98ad6": "Wot kin I do fer ye?",
        "bad128945d0a4c363bb8": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "d13a488f6301f349c7ef": "I kinnae help ye with trainin'. Ye should look fer a $c trainer."
      },
      "name": "Thorgas Grimson",
      "subName": "Hunter Trainer",
      "translationMetadata": {
