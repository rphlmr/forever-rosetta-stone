    "trTR": {
      "dialogue": {
        "00990bd3768a016ffc3a": "Avcılığın yollarını öğrenmek istiyorum.",
        "21ae61ecfd8490b98ad6": "Senin için ne yapabilirim?",
        "bad128945d0a4c363bb8": "Sıkı bir yeniden eğitimle birçok öğrenciye daha önce öğrendiklerini unutturmak zorunda kaldım ki onlara yeniden öğretebileyim. Sunduğum hizmet her tekrarlandığında daha zor hale geliyor. Bu yüzden her yeniden eğitim daha pahalı oluyor. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?",
        "d13a488f6301f349c7ef": "Eğitim konusunda sana yardım edemem. Bir $c eğitmeni aramalısın."
      },
      "name": "Thorgas Grimson",
