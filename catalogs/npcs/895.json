    "daDK": {
      "dialogue": {
        "00990bd3768a016ffc3a": "Jeg søger træning i jægerens kunst.",
        "21ae61ecfd8490b98ad6": "Hvad kan jeg gøre for dig?",
        "bad128945d0a4c363bb8": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere for hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "d13a488f6301f349c7ef": "Jeg kan ikke hjælpe dig med træning. Du bør finde en træner for $c."
      },
      "name": "Thorgas Grimson",
      "translationMetadata": {
        "fields": {
