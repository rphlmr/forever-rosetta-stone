    "ltLT": {
      "dialogue": {
        "00990bd3768a016ffc3a": "Noriu išmokti medžiotojo amato.",
        "21ae61ecfd8490b98ad6": "Kuo galiu tau padėti?",
        "bad128945d0a4c363bb8": "Kad galėčiau mokinius mokyti iš naujo, man ne kartą teko griežtai atpratinti juos nuo visko, ką jie buvo išmokę anksčiau. Kaskart tai padaryti darosi vis sunkiau, todėl ir kaina po kiekvieno permokymo auga. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "d13a488f6301f349c7ef": "Negaliu tavęs mokyti. Tau reikėtų susirasti $c mokytoją."
      },
      "name": "Thorgas Grimson",
      "subName": "Medžiotojų mokytojas",
