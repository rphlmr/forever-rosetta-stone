    "hrHR": {
      "dialogue": {
        "00990bd3768a016ffc3a": "Tražim obuku u lovačkim vještinama.",
        "21ae61ecfd8490b98ad6": "Što mogu učiniti za tebe?",
        "bad128945d0a4c363bb8": "Strogom sam preobukom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao poučiti iznova. Uslugu koju nudim sve je teže izvesti svaki sljedeći put. Zato je svaka preobuka sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "d13a488f6301f349c7ef": "Ne mogu ti pomoći s obukom. Potraži učitelja za $c."
      },
      "name": "Thorgas Grimson",
