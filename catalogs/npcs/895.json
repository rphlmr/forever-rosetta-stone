    "plPL": {
      "dialogue": {
        "00990bd3768a016ffc3a": "Szukam szkolenia w sztuce łowcy.",
        "21ae61ecfd8490b98ad6": "Cóż mogę dla ciebie zrobić?",
        "bad128945d0a4c363bb8": "Poprzez rygorystyczne przeszkolenie musiałem oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mógł uczyć ich od nowa. Usługa, którą oferuję, staje się coraz trudniejsza za każdym razem. Dlatego każde kolejne przeszkolenie jest droższe. Czy chcesz, abym oduczył cię poznanych talentów?",
        "d13a488f6301f349c7ef": "Nie mogę pomóc ci w szkoleniu. Poszukaj trenera dla $c."
      },
      "name": "Thorgas Grimson",
      "translationMetadata": {
