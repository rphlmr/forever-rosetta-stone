          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "2b93c916214bede6bb08": "Jeg træner ikke din slags, $c. Find din egen træner, før du gør mig vred.",
        "3fb8779f7c1adfbf09db": "Er du her for at træne? Eller er du blot kommet for at spilde en krigers tid?",
        "7524c9534864c6107bdf": "Gennem grundig genoptræning har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne lære dem op på ny. Den tjeneste, jeg tilbyder, bliver sværere at udføre for hver gang. Derfor bliver den også dyrere ved hver genoptræning. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?",
        "bcd5ee9f301f1c225d51": "Jeg har brug for krigertræning."
      },
      "name": "Tarshaw Jaggedscar",
      "translationMetadata": {
        "fields": {
          "dialogue.2b93c916214bede6bb08": {
