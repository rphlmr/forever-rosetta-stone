    "ltLT": {
      "dialogue": {
        "2b93c916214bede6bb08": "Aš nemokau tokių kaip tu, $c. Susirask sau tinkamą mokytoją, kol manęs nesupykdei.",
        "3fb8779f7c1adfbf09db": "Atėjai mokytis? O gal tik gaišti kario laiką?",
        "7524c9534864c6107bdf": "Griežtai perauklėdamas ne vieną mokinį turėjau išmokyti pamiršti viską, ką jie buvo išmokę, kad galėčiau mokyti juos iš naujo. Kaskart atlikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "bcd5ee9f301f1c225d51": "Noriu mokytis kario įgūdžių."
      },
      "name": "Tarshaw Jaggedscar",
      "subName": "Karių mokytojas",
      "translationMetadata": {
        "fields": {
          "dialogue.2b93c916214bede6bb08": {
