    "enUS": {
      "dialogue": {
        "6a042672c462f972ae1f": "You're no warlock and I've no time for you.  Begone!",
        "9e6932383b1ef9957719": "Show me your selection of grimoires.",
        "d59a399fae6f5bb25c51": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place."
      },
      "name": "Hraug",
      "subName": "Demon Trainer",
