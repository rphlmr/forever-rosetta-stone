    "daDK": {
      "dialogue": {
        "6a042672c462f972ae1f": "Du er ikke dæmonolog, og jeg har ikke tid til dig. Forsvind!",
        "9e6932383b1ef9957719": "Vis mig dit udvalg af grimoirer.",
        "d59a399fae6f5bb25c51": "Vil du gøre dine dæmoner stærkere? Det koster, men du er kommet til det rette sted."
      },
      "name": "Hraug",
      "translationMetadata": {
