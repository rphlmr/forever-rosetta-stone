    "deDE": {
      "dialogue": {
        "6a042672c462f972ae1f": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "9e6932383b1ef9957719": "Zeigt mir Eure Auswahl an Grimoires.",
        "d59a399fae6f5bb25c51": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig."
      },
      "name": "Hraug",
      "subName": "Dämonenausbilder",
