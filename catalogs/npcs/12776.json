  "locales": {
    "csCZ": {
      "dialogue": {
        "6a042672c462f972ae1f": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "9e6932383b1ef9957719": "Ukažte mi svou nabídku grimoárů.",
        "d59a399fae6f5bb25c51": "Chceš posílit své démony? Něco tě to bude stát, ale jsi na správném místě."
      },
      "name": "Hraug",
      "translationMetadata": {
        "fields": {
