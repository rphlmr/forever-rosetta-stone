    "trTR": {
      "dialogue": {
        "6a042672c462f972ae1f": "Sen bir büyücü değilsin ve sana ayıracak vaktim yok. Defol!",
        "9e6932383b1ef9957719": "Bana büyü kitabı seçkini göster.",
        "d59a399fae6f5bb25c51": "İblislerini güçlendirmek mi istiyorsun? Sana pahalıya patlar ama doğru yerdesin."
      },
      "name": "Hraug",
