    "hrHR": {
      "dialogue": {
        "a777006e5fa50b26fc8d": "Trebam ratničku obuku.",
        "ac8ef57d607311a91a12": "Strogim preodgojem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao poučiti iznova. Ta je usluga svakim ponavljanjem teža, pa stoga i skuplja. Želiš li da te odviknem od naučenih talenata?",
        "b3ef2a534b898636ed0e": "Ne obučavam tvoju vrstu, $c. Pronađi svog učitelja prije nego što me razljutiš.",
        "f6e4208a3312ae599da1": "Jesi li došao na obuku ili samo gubiš ratnikovo vrijeme?"
      },
      "name": "Sorek",
