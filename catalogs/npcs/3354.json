    "enUS": {
      "dialogue": {
        "a777006e5fa50b26fc8d": "I require warrior training.",
        "ac8ef57d607311a91a12": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "b3ef2a534b898636ed0e": "I don't train your kind $c.  Find your own trainer before you anger me.",
        "f6e4208a3312ae599da1": "Are you here for training?  Or are you just here to waste a warrior's time."
      },
      "name": "Sorek",
      "subName": "Warrior Trainer",
      "translationMetadata": {
