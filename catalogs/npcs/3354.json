  "locales": {
    "csCZ": {
      "dialogue": {
        "a777006e5fa50b26fc8d": "Potřebuji výcvik válečníka.",
        "ac8ef57d607311a91a12": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučil osvojeným talentům?",
        "b3ef2a534b898636ed0e": "Tvůj druh necvičím, $c. Najdi si vlastního učitele, než mě rozzlobíš.",
        "f6e4208a3312ae599da1": "Přišel jsi na výcvik, nebo jen ztrácet válečníkův čas?"
      },
      "name": "Sorek",
      "translationMetadata": {
        "fields": {
          "dialogue.a777006e5fa50b26fc8d": {
