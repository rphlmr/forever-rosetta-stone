    "plPL": {
      "dialogue": {
        "a777006e5fa50b26fc8d": "Potrzebuję szkolenia wojownika.",
        "ac8ef57d607311a91a12": "Dzięki surowemu przeszkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, by móc uczyć ich od nowa. Ta usługa staje się coraz trudniejsza, a więc i droższa przy każdym kolejnym przeszkoleniu. Czy chcesz, abym oduczył cię poznanych talentów?",
        "b3ef2a534b898636ed0e": "Nie szkolę twojego rodzaju, $c. Znajdź własnego nauczyciela, zanim mnie rozgniewasz.",
        "f6e4208a3312ae599da1": "Przychodzisz na szkolenie czy tylko marnujesz czas wojownika?"
      },
      "name": "Sorek",
