    "daDK": {
      "dialogue": {
        "a777006e5fa50b26fc8d": "Jeg har brug for krigertræning.",
        "ac8ef57d607311a91a12": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine indlærte talenter?",
        "b3ef2a534b898636ed0e": "Jeg træner ikke din slags, $c. Find din egen træner, før du gør mig vred.",
        "f6e4208a3312ae599da1": "Er du her for at træne, eller spilder du bare en krigers tid?"
      },
      "name": "Sorek",
      "translationMetadata": {
        "fields": {
