    "svSE": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Denna tids stjärnor följer nya banor, fyrbåkar av hopp och styrka för kommande tidsåldrar.",
        "764c4303c4f3c0aaee97": "Elder Moonstrike finns i Scholomance i Western Plaguelands.",
        "9ef7ae7869be785ea56e": "Elder Snowcrown finns vid Light's Hope Chapel i Eastern Plaguelands.",
        "c94009d0b97a351a46e3": "Elder Farwhisper vandrar längs Stratholmes gator.",
        "d1cabb56d1b5576e026a": "Jag såg senast Elder Meadowrun vid Weeping Cave i Western Plaguelands."
      },
      "name": "Äldste Windrun",
