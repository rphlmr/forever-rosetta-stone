    "trTR": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Bu zamanın yıldızları yeni yollara yöneliyor, gelecek çağlar için umut ve güç ışıkları oluyor.",
        "764c4303c4f3c0aaee97": "Kadim Moonstrike, Western Plaguelands'deki Scholomance'ta bulunabilir.",
        "9ef7ae7869be785ea56e": "Kadim Snowcrown, Eastern Plaguelands'deki Light's Hope Şapeli'nde bulunabilir.",
        "c94009d0b97a351a46e3": "Kadim Farwhisper'ı Stratholme sokaklarında dolaşırken bulabilirsin.",
        "d1cabb56d1b5576e026a": "Kadim Meadowrun'ı en son Western Plaguelands'deki Weeping Cave'de gördüm."
      },
      "name": "Ulu Windrun",
