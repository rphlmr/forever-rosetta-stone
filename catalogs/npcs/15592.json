    "plPL": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Gwiazdy tego czasu podążają nowymi ścieżkami, będąc światłami nadziei i siły dla nadchodzących epok.",
        "764c4303c4f3c0aaee97": "Starszą Moonstrike znajdziesz w Scholomance w Zachodnich Ziemiach Plagi.",
        "9ef7ae7869be785ea56e": "Starszego Snowcrowna znajdziesz w Kaplicy Nadziei Światła we Wschodnich Ziemiach Plagi.",
        "c94009d0b97a351a46e3": "Starszego Farwhispera znajdziesz wędrującego ulicami Stratholme.",
        "d1cabb56d1b5576e026a": "Starszą Meadowrun widziałem ostatnio przy Płaczącej Jaskini w Zachodnich Ziemiach Plagi."
      },
      "name": "Starsza Windrun",
