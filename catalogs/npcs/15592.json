    "daDK": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "764c4303c4f3c0aaee97": "Elder Moonstrike findes i Scholomance i Western Plaguelands.",
        "9ef7ae7869be785ea56e": "Elder Snowcrown findes ved Light's Hope Chapel i Eastern Plaguelands.",
        "c94009d0b97a351a46e3": "Elder Farwhisper vandrer rundt i Stratholmes gader.",
        "d1cabb56d1b5576e026a": "Jeg så sidst Elder Meadowrun ved Weeping Cave i Western Plaguelands."
      },
      "name": "Ældste Windrun",
      "translationMetadata": {
