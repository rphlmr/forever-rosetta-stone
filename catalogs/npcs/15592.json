  "locales": {
    "csCZ": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Hvězdy tohoto času se ubírají novými cestami, jako majáky naděje a síly pro nadcházející věky.",
        "764c4303c4f3c0aaee97": "Prastarou Moonstrike najdeš ve Scholomanci v Západních morových zemích.",
        "9ef7ae7869be785ea56e": "Prastarého Snowcrowna najdeš v kapli Naděje Světla ve Východních morových zemích.",
        "c94009d0b97a351a46e3": "Prastarého Farwhispera můžeš najít, jak se potuluje ulicemi Stratholmu.",
        "d1cabb56d1b5576e026a": "Prastarou Meadowrun jsem naposledy viděl u Plačící jeskyně v Západních morových zemích."
      },
      "name": "Starší Windrun",
