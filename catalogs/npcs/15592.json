    "ltLT": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Šių laikų žvaigždės pasuko naujais keliais, tapdamos vilties ir stiprybės švyturiais ateinantiems amžiams.",
        "764c4303c4f3c0aaee97": "Vyresnįjį Moonstrike gali rasti Scholomance, Western Plaguelands krašte.",
        "9ef7ae7869be785ea56e": "Vyresnįjį Snowcrown gali rasti Light's Hope Chapel, Eastern Plaguelands krašte.",
        "c94009d0b97a351a46e3": "Vyresnįjį Farwhisper gali rasti klaidžiojantį Stratholme gatvėmis.",
        "d1cabb56d1b5576e026a": "Paskutinį kartą vyresnįjį Meadowrun mačiau prie Weeping Cave, Western Plaguelands krašte."
      },
      "name": "Vyresnysis Windrun",
