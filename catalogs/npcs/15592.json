    "enUS": {
      "dialogue": {
        "406fafcb76ed93d80c36": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "764c4303c4f3c0aaee97": "Elder Moonstrike can be found in the Scholomance in the Western Plaguelands.",
        "9ef7ae7869be785ea56e": "Elder Snowcrown can be found in Light's Hope Chapel in the Eastern Plaguelands.",
        "c94009d0b97a351a46e3": "Elder Farwhisper can be found wandering the streets of Stratholme.",
        "d1cabb56d1b5576e026a": "I last saw Elder Meadowrun at the Weeping Cave in the Western Plaguelands."
      },
      "name": "Elder Windrun",
      "translationMetadata": {
