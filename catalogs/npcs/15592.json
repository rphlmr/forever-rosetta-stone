    "hrHR": {
      "dialogue": {
        "406fafcb76ed93d80c36": "Zvijezde ovog doba kreću novim stazama, svjetionici nade i snage za nadolazeća vremena.",
        "764c4303c4f3c0aaee97": "Starješinu Moonstrike možeš pronaći u Scholomanceu u Western Plaguelandsu.",
        "9ef7ae7869be785ea56e": "Starješinu Snowcrown možeš pronaći u kapeli Light's Hope u Eastern Plaguelandsu.",
        "c94009d0b97a351a46e3": "Starješinu Farwhisper možeš pronaći kako luta ulicama Stratholmea.",
        "d1cabb56d1b5576e026a": "Starješinu Meadowrun posljednji sam put vidio kod špilje Weeping Cave u Western Plaguelandsu."
      },
      "name": "Starješina Windrun",
