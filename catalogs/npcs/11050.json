    "deDE": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Es gibt keine bessere Methode, um den Kopf frei zu bekommen, als zu weben.",
        "5abef740bcd46e38e45e": "Meine Kenntnisse werden immer noch erweitert und Euer Wissen übersteigt das meine. Wenn Ihr mehr lernen wollt, müsst Ihr mit Me'lynn sprechen. Sie wird Euch leiten.",
        "80a9e41d7e1be5f1e57a": "Bildet mich aus.",
        "e166cd35a31e88230584": "Ihr werdet nicht enttäuscht sein. In der Schneiderei kann man viel Freude finden."
      },
      "name": "Trianna",
      "subName": "Schneidergesellin",
      "translationMetadata": {
