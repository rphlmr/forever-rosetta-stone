  "locales": {
    "csCZ": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Nic nepročistí mysl lépe než tkaní.",
        "5abef740bcd46e38e45e": "Stále se učím a tvé znalosti předčí mé. Chceš-li se dozvědět více, musíš promluvit s Me’lynn. Ona tě povede.",
        "80a9e41d7e1be5f1e57a": "Vycvičte mě.",
        "e166cd35a31e88230584": "Nebudeš zklamán, poutníku. Krejčovství je radostná činnost."
      },
      "name": "Trianna",
      "translationMetadata": {
