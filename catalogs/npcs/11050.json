    "enUS": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "There is no greater way to clear the mind than to weave.",
        "5abef740bcd46e38e45e": "My education is ongoing, and your knowledge surpasses mine. If you wish to learn more you must speak to Me'lynn. She will guide you.",
        "80a9e41d7e1be5f1e57a": "Train me.",
        "e166cd35a31e88230584": "You will not be disappointed, traveler. Tailoring is a joyous endeavor."
      },
      "name": "Trianna",
      "subName": "Journeyman Tailor",
      "translationMetadata": {
        "fields": {
          "dialogue.16188fa75ab81bd2e7d7": {
