    "svSE": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Det finns inget bättre sätt att rensa tankarna än att väva.",
        "5abef740bcd46e38e45e": "Jag håller fortfarande på att lära mig, och dina kunskaper överträffar mina. Vill du lära dig mer måste du tala med Me’lynn. Hon kommer att vägleda dig.",
        "80a9e41d7e1be5f1e57a": "Träna mig.",
        "e166cd35a31e88230584": "Du kommer inte att bli besviken, resenär. Skrädderi är en glädjefylld syssla."
      },
      "name": "Trianna",
      "translationMetadata": {
