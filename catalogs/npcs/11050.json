    "ptBR": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Não há coisa melhor do que tecer para clarear a mente.",
        "5abef740bcd46e38e45e": "Minha educação está em curso e o seu conhecimento superou o meu. Se você deseja aprender mais, deve falar com Me'lynn. Ela irá lhe orientar.",
        "80a9e41d7e1be5f1e57a": "Treine-me.",
        "e166cd35a31e88230584": "Você não vai se desapontar, viajante. Alfaiataria é um empreendimento prazeroso."
      },
      "name": "Trianna",
      "subName": "Alfaiate Profissional",
