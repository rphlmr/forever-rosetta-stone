    "daDK": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Der findes ingen bedre måde at klare tankerne på end at væve.",
        "5abef740bcd46e38e45e": "Jeg er stadig under oplæring, og din viden overgår min. Hvis du vil lære mere, må du tale med Me’lynn. Hun vil vejlede dig.",
        "80a9e41d7e1be5f1e57a": "Træn mig.",
        "e166cd35a31e88230584": "Du bliver ikke skuffet, rejsende. Skrædderi er en glædelig beskæftigelse."
      },
      "name": "Trianna",
      "translationMetadata": {
        "fields": {
          "dialogue.16188fa75ab81bd2e7d7": {
