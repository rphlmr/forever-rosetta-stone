    "hrHR": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Ništa ne razbistri um bolje od tkanja.",
        "5abef740bcd46e38e45e": "Još uvijek učim, a tvoje znanje nadmašuje moje. Ako želiš naučiti više, razgovaraj s Me’lynn. Ona će te uputiti.",
        "80a9e41d7e1be5f1e57a": "Podučite me.",
        "e166cd35a31e88230584": "Nećeš se razočarati, putniče. Krojenje je radostan posao."
      },
      "name": "Trianna",
      "translationMetadata": {
