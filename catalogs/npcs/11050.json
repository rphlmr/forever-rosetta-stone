    "plPL": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Nic tak nie oczyszcza umysłu jak tkanie.",
        "5abef740bcd46e38e45e": "Wciąż się uczę, a twoja wiedza przewyższa moją. Jeśli chcesz dowiedzieć się więcej, porozmawiaj z Me’lynn. Ona cię poprowadzi.",
        "80a9e41d7e1be5f1e57a": "Wyszkol mnie.",
        "e166cd35a31e88230584": "Nie zawiedziesz się, wędrowcze. Krawiectwo to radosne zajęcie."
      },
      "name": "Trianna",
