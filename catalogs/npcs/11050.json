    "trTR": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Zihni boşaltmanın dokumaktan daha iyi bir yolu yoktur.",
        "5abef740bcd46e38e45e": "Eğitimim hâlâ sürüyor ve bilgin benimkini aşıyor. Daha fazlasını öğrenmek istiyorsan Me’lynn ile konuşmalısın. Sana yol gösterecektir.",
        "80a9e41d7e1be5f1e57a": "Beni eğit.",
        "e166cd35a31e88230584": "Hayal kırıklığına uğramayacaksın, gezgin. Terzilik keyifli bir uğraştır."
      },
      "name": "Trianna",
      "translationMetadata": {
