    "esES": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "No hay mejor forma de despejar la mente que tejer.",
        "5abef740bcd46e38e45e": "Yo todavía estoy aprendiendo y tu conocimiento supera al mío. Si quieres aprender más, debes hablar con Me'lynn. Ella te guiará.",
        "80a9e41d7e1be5f1e57a": "Entréname.",
        "e166cd35a31e88230584": "No te defraudaré, viajero. La sastrería es una profesión que te llenará de júbilo."
      },
      "name": "Trianna",
      "subName": "Oficial de sastrería",
      "translationMetadata": {
