    "frFR": {
      "dialogue": {
        "16188fa75ab81bd2e7d7": "Tisser est le meilleur moyen de se libérer l'esprit.",
        "5abef740bcd46e38e45e": "Mon éducation se poursuit et votre savoir dépasse le mien. Si vous voulez en apprendre plus, parlez à Me'lynn. Elle vous guidera.",
        "80a9e41d7e1be5f1e57a": "Entraînez-moi.",
        "e166cd35a31e88230584": "Vous ne le regretterez pas. Tailler est une activité exaltante."
      },
      "name": "Trianna",
      "subName": "Tailleur - Compagnon",
