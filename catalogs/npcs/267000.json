    "hrHR": {
      "dialogue": {
        "b48b29189957f663eef8": "Prodajem samo najbolju opremu, provjerenu i pouzdanu. Cijene su fiksne, pa ako se želiš cjenkati, pronađi goblina.",
        "cf5efa5af79c453af07e": "Kuhanje je životni poziv i vidim da dijelimo istu strast!"
