      }
    },
    "daDK": {
      "dialogue": {
        "b48b29189957f663eef8": "Jeg sælger kun det bedste udstyr, afprøvet og pålideligt. Priserne er faste, så hvis du vil prutte om dem, må du finde en goblin.",
        "cf5efa5af79c453af07e": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler samme passion!"
      },
      "name": "Paige",
      "translationMetadata": {
        "fields": {
          "dialogue.b48b29189957f663eef8": {
