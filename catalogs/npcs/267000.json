  "locales": {
    "csCZ": {
      "dialogue": {
        "b48b29189957f663eef8": "Prodávám jen tu nejlepší, prověřenou výstroj. Ceny jsou pevné, takže jestli chceš smlouvat, najdi si goblina.",
        "cf5efa5af79c453af07e": "Vaření je celoživotní poslání a vidím, že sdílíme stejnou vášeň!"
      },
      "name": "Paige",
      "translationMetadata": {
        "fields": {
