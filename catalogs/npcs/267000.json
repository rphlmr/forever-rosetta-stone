    "plPL": {
      "dialogue": {
        "b48b29189957f663eef8": "Sprzedaję tylko najlepszy, sprawdzony sprzęt. Ceny są stałe, więc jeśli chcesz się targować, poszukaj goblina.",
        "cf5efa5af79c453af07e": "Gotowanie to zajęcie na całe życie i widzę, że dzielimy tę samą pasję!"
      },
      "name": "Paige",
