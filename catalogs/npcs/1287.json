    "svSE": {
      "dialogue": {
        "23b750129cc3ea7c5f78": "Tittar du bara på mina varor, eller finns det något särskilt jag kan hjälpa dig att hitta i dag?",
        "761bd2100406768dd9be": "Jag vill se dina varor.",
        "e6e3614bf45712b40760": "De bästa erbjudandena i hela Stormwind, min vän. Bättre hittar du inte. Vad kan jag hjälpa dig med?"
      },
      "name": "Marda Weller",
