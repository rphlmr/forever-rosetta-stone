    "daDK": {
      "dialogue": {
        "23b750129cc3ea7c5f78": "Kigger du bare på mine varer, eller er der noget bestemt, jeg kan hjælpe dig med at finde i dag?",
        "761bd2100406768dd9be": "Jeg vil gerne se dine varer.",
        "e6e3614bf45712b40760": "De bedste tilbud i hele Stormwind, min ven. Du finder ikke bedre. Hvad kan jeg hjælpe dig med?"
      },
      "name": "Marda Weller",
      "translationMetadata": {
