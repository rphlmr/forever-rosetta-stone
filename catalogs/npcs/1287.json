    "trTR": {
      "dialogue": {
        "23b750129cc3ea7c5f78": "Mallarıma şöyle bir bakıyor musun, yoksa bugün bulmana yardım edebileceğim özel bir şey var mı?",
        "761bd2100406768dd9be": "Mallarına bakmak istiyorum.",
        "e6e3614bf45712b40760": "Tüm Stormwind’deki en iyi fırsatlar burada dostum, daha iyisini bulamazsın. Sana nasıl yardımcı olabilirim?"
      },
      "name": "Marda Weller",
