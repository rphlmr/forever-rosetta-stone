    "csCZ": {
      "dialogue": {
        "23b750129cc3ea7c5f78": "Jen si prohlížíš mé zboží, nebo ti dnes mohu pomoci najít něco konkrétního?",
        "761bd2100406768dd9be": "Rád bych si prohlédl vaše zboží.",
        "e6e3614bf45712b40760": "Nejlepší ceny v celém Stormwindu, příteli, lepší nenajdeš. S čím ti mohu pomoci?"
      },
      "name": "Marda Weller",
