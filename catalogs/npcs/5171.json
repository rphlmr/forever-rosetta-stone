    "plPL": {
      "dialogue": {
        "29b6b742c40667f1c15e": "Obawiam się, że poziom twojej mroczności jest zbyt niski, bym dalej zawracał sobie tobą głowę. Idź proszę dalej.",
        "33105520568b6a97dc28": "Moc tajemna deprawuje tylko słabych. Trenuj dalej, bo inaczej może cię spotkać podobny los.",
        "4500d101d710aa675d98": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "75d7a8e09ae97ca0d4c7": "Interesuje mnie szkolenie w sztuce czarnoksiężników.",
        "d8a0e3f4a28fef1782f4": "Dzięki rygorystycznemu szkoleniu musiałem oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, by móc uczyć ich od nowa. Usługa ta staje się coraz trudniejsza za każdym razem, gdy ją wykonuję. Dlatego każde kolejne szkolenie kosztuje więcej. Czy pragniesz, abym oduczył cię poznanych talentów?"
      },
      "name": "Thistleheart",
      "translationMetadata": {
        "fields": {
          "dialogue.29b6b742c40667f1c15e": {
