    "enUS": {
      "dialogue": {
        "29b6b742c40667f1c15e": "I'm afraid your darkness quotient isn't sufficient enough for me to bother talking to you any further.  Move along please.",
        "33105520568b6a97dc28": "The arcane only corrupts those who are weak. Keep up on your training, or you may find a similar fate.",
        "4500d101d710aa675d98": "I am interested in warlock training.",
        "75d7a8e09ae97ca0d4c7": "I am interested in warlock training.",
        "d8a0e3f4a28fef1782f4": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Thistleheart",
      "subName": "Warlock Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.29b6b742c40667f1c15e": {
