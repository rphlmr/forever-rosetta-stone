    "itIT": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Posso insegnarti a cucinare!",
        "270a8da1bbe5b02b6723": "Alla cucina ci si dedica per tutta la vita, e vedo che abbiamo la stessa passione!",
        "cc306bea62eef60462de": "Addestrami.",
        "d75ade47b1ce9bcb8005": "Wulan, a Shadowprey Village, può venderti il \"Ricettario dell'Esperto\". Ti servirà, se vuoi migliorarti.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave di Gadgetzan è un maestro delle arti culinarie. Per migliorarti dovrai andare a cercarlo."
      },
      "name": "Pyall Silentstride",
