    "frFR": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Je peux vous apprendre à cuisiner !",
        "270a8da1bbe5b02b6723": "La cuisine est une activité qui peut vous occuper toute votre vie. Je vois que nous partageons la même passion !",
        "cc306bea62eef60462de": "Entraînez-moi.",
        "d75ade47b1ce9bcb8005": "Wuland du village de Proie-de-l'Ombre peut vous vendre un livre de cuisine pour experts. Il vous faudra bien ça si vous voulez vous améliorer.",
        "f71f9876c9f60b36827e": "Dirge Quickcleave de Gadgetzan est un maître des arts culinaires. Vous devriez aller le voir pour vous perfectionner."
      },
      "name": "Pyall Silentstride",
      "subName": "Cuisinier",
