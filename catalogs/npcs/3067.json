    "trTR": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Sana yemek yapmayı öğretebilirim!",
        "270a8da1bbe5b02b6723": "Aşçılık ömür boyu süren bir uğraştır ve görüyorum ki aynı tutkuyu paylaşıyoruz!",
        "cc306bea62eef60462de": "Beni eğit.",
        "d75ade47b1ce9bcb8005": "Shadowprey Köyü'ndeki Wulan sana 'Expert Cookbook' satabilir. Kendini geliştirmek istiyorsan ona ihtiyacın olacak.",
        "f71f9876c9f60b36827e": "Gadgetzanlı Dirge Quikcleave mutfak sanatlarında ustadır. Kendini geliştirmek için onu bulmalısın."
      },
      "name": "Pyall Silentstride",
