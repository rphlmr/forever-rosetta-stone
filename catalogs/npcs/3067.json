  "locales": {
    "csCZ": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Mohu tě naučit vařit!",
        "270a8da1bbe5b02b6723": "Vaření je celoživotní záliba a vidím, že sdílíme stejnou vášeň!",
        "cc306bea62eef60462de": "Vycvičte mě.",
        "d75ade47b1ce9bcb8005": "Wulan ve vesnici Shadowprey ti může prodat „Kuchařku pro experty“. Budeš ji potřebovat, chceš-li se zlepšit.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave z Gadgetzanu je mistrem kuchařského umění. Chceš-li se zlepšit, musíš ho vyhledat."
      },
      "name": "Pyall Silentstride",
      "translationMetadata": {
        "fields": {
