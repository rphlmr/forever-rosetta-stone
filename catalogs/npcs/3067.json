    "plPL": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Mogę nauczyć cię gotować!",
        "270a8da1bbe5b02b6723": "Gotowanie to zajęcie na całe życie i widzę, że łączy nas ta sama pasja!",
        "cc306bea62eef60462de": "Wyszkol mnie.",
        "d75ade47b1ce9bcb8005": "Wulan w Shadowprey Village może sprzedać ci „Expert Cookbook”. Potrzebujesz jej, by rozwijać swoje umiejętności.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave z Gadgetzan jest mistrzem sztuki kulinarnej. Jeśli chcesz się doskonalić, musisz go odszukać."
      },
      "name": "Pyall Silentstride",
      "translationMetadata": {
