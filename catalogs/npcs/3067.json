    "enUS": {
      "dialogue": {
        "11acd99a2c07a9a33000": "I can teach you how to cook!",
        "270a8da1bbe5b02b6723": "Cooking is a life long pursuit and I see we share the same passion!",
        "cc306bea62eef60462de": "Train me.",
        "d75ade47b1ce9bcb8005": "Wulan in Shadowprey Village can sell you the \"Expert Cookbook\".  You will need that if you are to better yourself.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave of Gadgetzan is a master of the culinary arts.  To better yourself you will need to seek him out."
      },
      "name": "Pyall Silentstride",
      "subName": "Cook",
