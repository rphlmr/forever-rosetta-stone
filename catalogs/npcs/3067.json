    "hrHR": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Mogu te naučiti kuhati!",
        "270a8da1bbe5b02b6723": "Kuhanje je cjeloživotni poziv i vidim da dijelimo istu strast!",
        "cc306bea62eef60462de": "Podučite me.",
        "d75ade47b1ce9bcb8005": "Wulan u selu Shadowprey može ti prodati 'Expert Cookbook'. Trebat će ti želiš li se usavršiti.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave iz Gadgetzana majstor je kulinarstva. Ako se želiš usavršiti, morat ćeš ga potražiti."
      },
      "name": "Pyall Silentstride",
