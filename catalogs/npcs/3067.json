    "deDE": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Ich kann Euch das Kochen beibringen!",
        "270a8da1bbe5b02b6723": "Kochen ist etwas, das man sein Leben lang verfolgt. Ich sehe, wir teilen die gleiche Leidenschaft!",
        "cc306bea62eef60462de": "Bildet mich aus.",
        "d75ade47b1ce9bcb8005": "Wulan in Shadowprey kann Euch das \"Expertenkochbuch\" verkaufen. Ihr werdet es brauchen, wenn Ihr Euch verbessern wollt.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave von Gadgetzan ist ein Meister der Kochkunst. Um Euch verbessern zu können, werdet Ihr ihn ausfindig machen müssen."
      },
      "name": "Pyall Silentstride",
      "subName": "Koch",
