    "ptBR": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Eu posso ensinar você a cozinhar!",
        "270a8da1bbe5b02b6723": "A culinária é uma atividade para toda a vida. Vejo que compartilhamos a mesma paixão!",
        "cc306bea62eef60462de": "Treine-me.",
        "d75ade47b1ce9bcb8005": "Wulan, da Aldeia Pescassombra, pode lhe vender o \"Livro de Receitas do Perito\". Se você quiser se aperfeiçoar, terá de ler esse livro.",
        "f71f9876c9f60b36827e": "Funesto Marrão, de Geringontzan, é um mestre das artes culinárias. Se você quiser aperfeiçoar sua técnica, procure-o."
      },
      "name": "Pyall Passo Tranquilo",
      "subName": "Cozinheiro",
