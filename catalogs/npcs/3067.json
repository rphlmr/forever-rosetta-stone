    "svSE": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Jag kan lära dig laga mat!",
        "270a8da1bbe5b02b6723": "Matlagning är en livslång sysselsättning och jag ser att vi delar samma passion!",
        "cc306bea62eef60462de": "Träna mig.",
        "d75ade47b1ce9bcb8005": "Wulan i Shadowprey Village kan sälja dig 'Expert Cookbook'. Du behöver den om du vill utvecklas vidare.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave i Gadgetzan är en mästare på matlagning. Du måste söka upp honom om du vill utvecklas."
      },
      "name": "Pyall Silentstride",
