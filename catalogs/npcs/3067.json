    "ltLT": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Galiu išmokyti tave gaminti valgį!",
        "270a8da1bbe5b02b6723": "Maisto gamyba yra viso gyvenimo užsiėmimas, ir matau, kad mus sieja ta pati aistra!",
        "cc306bea62eef60462de": "Pamokyk mane.",
        "d75ade47b1ce9bcb8005": "Wulan iš Shadowprey Village gali tau parduoti „Expert Cookbook“.  Jos prireiks, jei nori tobulėti.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave iš Gadgetzan yra kulinarijos meistras.  Jei nori tobulėti, turėsi jį susirasti."
      },
      "name": "Pyall Silentstride",
      "subName": "Virėjas",
