    "daDK": {
      "dialogue": {
        "11acd99a2c07a9a33000": "Jeg kan lære dig at lave mad!",
        "270a8da1bbe5b02b6723": "Madlavning er en livslang beskæftigelse, og jeg kan se, at vi deler den samme passion!",
        "cc306bea62eef60462de": "Træn mig.",
        "d75ade47b1ce9bcb8005": "Wulan i Shadowprey Village kan sælge dig 'Expert Cookbook'. Den får du brug for, hvis du vil blive bedre.",
        "f71f9876c9f60b36827e": "Dirge Quikcleave fra Gadgetzan er en mester i kogekunsten. Du må opsøge ham, hvis du vil blive bedre."
      },
      "name": "Pyall Silentstride",
      "translationMetadata": {
        "fields": {
