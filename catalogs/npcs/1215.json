    "daDK": {
      "dialogue": {
        "21b73cb0490403dedb1f": "Træn mig.",
        "39089b572c296d73b6cb": "Du er begyndt godt, men du har stadig meget at lære, $n.",
        "6d1f22ff9582a39a69ba": "Du har allerede lært alt, hvad jeg kan lære dig, $n. Tal med natelveren Lilyssia Nightbreeze i Stormwinds magikerkvarter, hvis du vil fortsætte dine studier. Jeg hører, hun er en god lærer.",
        "9cccc2b626f9efdfe331": "Goddag, $gmin herre:frue;. Jeg ville give hånd, men som De ser, er jeg optaget. Kan jeg hjælpe?",
        "ebe46b0ef0c98fb26542": "Goddag, $gmin herre:frue;. Jeg ville give hånd, men som De ser, er jeg optaget. Kan jeg hjælpe?"
      },
