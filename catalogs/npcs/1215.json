    "frFR": {
      "dialogue": {
        "21b73cb0490403dedb1f": "Entraînez-moi.",
        "39089b572c296d73b6cb": "C'est un bon début, mais vous avez encore beaucoup à apprendre, $n.",
        "6d1f22ff9582a39a69ba": "Vous savez déjà tout ce que je suis susceptible de vous apprendre, $N. Parlez à Lilyssia Nightbreeze, l'elfe de la nuit, dans le quartier des mages de Stormwind, si vous voulez continuer vos études. Il paraît que c'est un bon professeur.",
        "9cccc2b626f9efdfe331": "Bonjour, madame. Je vous serrerais volontiers la main, mais je suis en plein travail. Je peux vous aider ?",
        "ebe46b0ef0c98fb26542": "Bonjour, monseigneur. Je vous serrerais volontiers la main, mais je suis en plein travail. Je peux vous aider ?"
      },
