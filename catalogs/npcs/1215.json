    "enUS": {
      "dialogue": {
        "21b73cb0490403dedb1f": "Train me.",
        "39089b572c296d73b6cb": "You've made a good start, but you still have a great deal to learn, $n.",
        "6d1f22ff9582a39a69ba": "You've already learned everything I can teach you, $n. Talk to the night elf Lilyssia Nightbreeze in the Mage Quarter of Stormwind if you want to continue your studies. I hear she's a good teacher.",
        "9cccc2b626f9efdfe331": "Good day, $gsir:ma'am;. I'd shake your hand, but as you see, I'm in the middle of something. May I be of assistance?",
        "ebe46b0ef0c98fb26542": "Good day, $gsir:ma'am;. I'd shake your hand, but as you see, I'm in the middle of something. May I be of assistance?"
      },
