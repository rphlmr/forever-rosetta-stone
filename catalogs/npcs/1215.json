  "locales": {
    "csCZ": {
      "dialogue": {
        "21b73cb0490403dedb1f": "Vycvičte mě.",
        "39089b572c296d73b6cb": "Začal jsi dobře, ale ještě se toho musíš hodně naučit, $n.",
        "6d1f22ff9582a39a69ba": "Už ses naučil všechno, co tě mohu naučit, $n. Pokud chceš pokračovat ve studiu, promluv si s noční elfkou Lilyssií Nightbreeze v Mágské čtvrti Stormwindu. Slyšel jsem, že je dobrá učitelka.",
        "9cccc2b626f9efdfe331": "Dobrý den, $gpane:paní;. Podal bych vám ruku, ale jak vidíte, mám právě práci. Mohu vám pomoci?",
        "ebe46b0ef0c98fb26542": "Dobrý den, $gpane:paní;. Podal bych vám ruku, ale jak vidíte, mám právě práci. Mohu vám pomoci?"
      },
      "name": "Alchymista Mallory",
