    "esES": {
      "dialogue": {
        "21b73cb0490403dedb1f": "Entréname.",
        "39089b572c296d73b6cb": "Has empezado bien, pero todavía tienes mucho que aprender, $n.",
        "6d1f22ff9582a39a69ba": "Ya has aprendido todo lo que puedo enseñarte, $n. Si quieres continuar tus estudios habla con la elfa de la noche Lilyssia Brisa Nocturna, en el Barrio de los Magos de Ventormenta. He oído que es una buena instructora.",
        "9cccc2b626f9efdfe331": "Buenos días, señora. Te daría la mano, pero como ves, estoy ocupado. ¿Puedo serte de ayuda?",
        "ebe46b0ef0c98fb26542": "Buenos días, señor. Te daría la mano, pero como ves, estoy ocupado. ¿Puedo serte de ayuda?"
      },
