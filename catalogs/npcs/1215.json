    "plPL": {
      "dialogue": {
        "21b73cb0490403dedb1f": "Wyszkol mnie.",
        "39089b572c296d73b6cb": "Dobrze zaczynasz, ale wciąż musisz się wiele nauczyć, $n.",
        "6d1f22ff9582a39a69ba": "Wiesz już wszystko, czego mogę cię nauczyć, $n. Jeśli chcesz kontynuować naukę, porozmawiaj z nocną elfką Lilyssią Nightbreeze w Dzielnicy Magów w Stormwindzie. Słyszałem, że jest dobrą nauczycielką.",
        "9cccc2b626f9efdfe331": "Dzień dobry, $gpanie:pani;. Podałbym rękę, ale jak widać, jestem zajęty. Czy mogę pomóc?",
        "ebe46b0ef0c98fb26542": "Dzień dobry, $gpanie:pani;. Podałbym rękę, ale jak widać, jestem zajęty. Czy mogę pomóc?"
      },
