    "daDK": {
      "dialogue": {
        "0502debfcf0103ae31ff": "Træn mig.",
        "0c41bd31321011f0bde9": "Mathias fandt mig i Barrens, hvor Venture Co. havde efterladt mig for at dø. Uden ham var jeg blevet føde for rovdyrene.",
        "9fd5c8dbbe2f48570cd7": "Jeg vil gerne se dine varer."
      },
      "name": "Renzik \"The Shiv\"",
