    "ptBR": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Eu sei, eu sei, estou aqui no meio do nada!\n\nNa verdade, eu moro na Vila Catraca, mas depois que caí aqui com meu zepelim, achei melhor dar início a pesquisa que vim fazer!"
      },
      "name": "Marlon Catarrebite",
