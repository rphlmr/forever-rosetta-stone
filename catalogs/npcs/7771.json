    "plPL": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Wiem, wiem, jestem tu na końcu świata!$B$BTak naprawdę mieszkam w Ratchet, ale gdy rozbiłem tu swój sterowiec, pomyślałem, że równie dobrze mogę rozpocząć badania, dla których tu przybyłem!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
