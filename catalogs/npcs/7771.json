        }
      }
    },
    "deDE": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Ich weiß, ich weiß, ich befinde mich hier am Ende der Welt!\n\nEigentlich stamme ich ja aus Ratchet, aber nachdem ich hier mit meinem Zeppelin abgestürzt war, dachte ich, ich könnte auch gleich mit den Forschungen beginnen, deretwegen ich hergekommen bin."
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
        "fields": {
