  "locales": {
    "csCZ": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Já vím, já vím, jsem tady uprostřed ničeho!$B$BVe skutečnosti bydlím v Ratchetu, ale když už jsem tu se svým zeppelinem havaroval, řekl jsem si, že rovnou začnu s výzkumem, kvůli kterému jsem sem přijel!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
        "fields": {
