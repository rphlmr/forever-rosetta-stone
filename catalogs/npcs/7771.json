    "hrHR": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Znam, znam, ovdje sam usred ničega!$B$BZapravo živim u Ratchetu, ali nakon što sam ovdje srušio svoj cepelin, pomislio sam da bih mogao započeti istraživanje zbog kojeg sam i došao!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
