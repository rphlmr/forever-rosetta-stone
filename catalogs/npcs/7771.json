    "trTR": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Biliyorum, biliyorum, burada hiçliğin ortasındayım!$B$BAslında Ratchet’ta yaşıyorum ama zeplinim burada düştükten sonra buraya yapmak için geldiğim araştırmaya başlasam iyi olur diye düşündüm!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
