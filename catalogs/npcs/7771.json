    "daDK": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Jeg ved det, jeg ved det, jeg er herude midt i ingenting!$B$BJeg bor faktisk i Ratchet, men efter at være styrtet ned her med min zeppeliner tænkte jeg, at jeg lige så godt kunne begynde den forskning, jeg kom for at udføre!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
        "fields": {
