    "ltLT": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Žinau, žinau, esu čia, vidury niekur!$B$BIš tikrųjų gyvenu Ratchet mieste, bet sudaužęs čia savo cepeliną pamaniau, kad galėčiau pradėti tyrimus, dėl kurių čia ir atvykau!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
