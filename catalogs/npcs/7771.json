    "svSE": {
      "dialogue": {
        "5ca45a068805cfb868bd": "Jag vet, jag vet, jag är här mitt ute i ingenstans!$B$BJag bor faktiskt i Ratchet, men efter att ha kraschat min zeppelinare här tänkte jag att jag lika gärna kunde påbörja forskningen jag kom hit för att göra!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
