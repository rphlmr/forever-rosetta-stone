    },
    "enUS": {
      "dialogue": {
        "5ca45a068805cfb868bd": "I know, I know, I'm out here in the middle of nowhere!$B$BMy home is actually in Ratchet, but after crashing my zeppelin here, I thought I might as well start the research I came here to do!"
      },
      "name": "Marvon Rivetseeker",
      "translationMetadata": {
        "fields": {
          "dialogue.5ca45a068805cfb868bd": {
            "origin": "community",
