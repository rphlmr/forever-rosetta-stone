    "trTR": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Teldrassil'in tepesindeki Dolanaar köyü Bilge Bladeleaf'in evidir.",
        "5ccc8dc8c4a90148f0a5": "Bilge Skygleam, Azshara'daki Ravencrest Anıtı yakınlarında bulunabilir.",
        "855f4adf6ed895e5b0a3": "Bu çağın yıldızları yeni yollara yöneliyor; gelecek çağlar için umut ve güç işaretleri oluyor.",
        "8ccf0c7f54d3c04b1b26": "Bilge Starweave, Darkshore'daki kıyı köyü Auberdine'de bulunabilir.",
        "bec27aaa1b07dc92b5be": "Bilge Hammershout, Stormwind surlarının içinde bulunabilir.",
        "ec8a278e44a68e1abb2b": "Bilge Bronzebeard, Bronzebeardların ata yurdu Ironforge'da bulunabilir."
      },
      "name": "Ulu Bladeswift",
