  "locales": {
    "csCZ": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Vesnice Dolanaar na Teldrassilu je domovem staršího Bladeleafa.",
        "5ccc8dc8c4a90148f0a5": "Staršího Skygleama najdeš poblíž památníku Ravencresta v Azshaře.",
        "855f4adf6ed895e5b0a3": "Hvězdy této doby se vydávají novými cestami, majáky naděje a síly pro příští věky.",
        "8ccf0c7f54d3c04b1b26": "Staršího Starweavea najdeš v pobřežní vesnici Auberdine na Temném pobřeží.",
        "bec27aaa1b07dc92b5be": "Staršího Hammershouta najdeš za hradbami Bouřného větru.",
        "ec8a278e44a68e1abb2b": "Staršího Bronzebearda najdeš v pradávném domově Bronzebeardů, Ironforge."
      },
      "name": "Starší Bladeswift",
      "translationMetadata": {
