    "daDK": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Landsbyen Dolanaar på Teldrassil er hjemsted for ældste Bladeleaf.",
        "5ccc8dc8c4a90148f0a5": "Ældste Skygleam findes nær Ravencrest-monumentet i Azshara.",
        "855f4adf6ed895e5b0a3": "Denne tids stjerner følger nye baner, fyrtårne af håb og styrke for de kommende tidsaldre.",
        "8ccf0c7f54d3c04b1b26": "Ældste Starweave findes i kystlandsbyen Auberdine i Darkshore.",
        "bec27aaa1b07dc92b5be": "Ældste Hammershout findes inden for Stormwinds mure.",
        "ec8a278e44a68e1abb2b": "Ældste Bronzebeard findes i Bronzebeard-slægtens gamle hjem, Ironforge."
      },
      "name": "Ældste Bladeswift",
      "translationMetadata": {
