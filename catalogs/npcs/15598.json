    "frFR": {
      "dialogue": {
        "193fae65faa9c21e6a19": "L'Ancien Bladeleaf réside dans le village de Dolanaar, au sommet de Teldrassil.",
        "5ccc8dc8c4a90148f0a5": "L'Ancien Skygleam se trouve près du monument de Ravencrest, en Azshara.",
        "855f4adf6ed895e5b0a3": "Les étoiles de ce temps suivent des chemins nouveaux, et leurs lueurs seront des foyers d’espoir et de force pour les âges qui s’annoncent.",
        "8ccf0c7f54d3c04b1b26": "L'Ancienne Starweave se trouve dans le village côtier d'Auberdine, à Sombrivage.",
        "bec27aaa1b07dc92b5be": "L'Ancien Hammershout se trouve quelque part dans Stormwind.",
        "ec8a278e44a68e1abb2b": "L’Ancien Bronzebeard réside dans le domaine ancestral des Bronzebeard, Ironforge."
      },
      "name": "Ancien Bladeswift",
