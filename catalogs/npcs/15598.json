    "svSE": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Byn Dolanaar på Teldrassil är den äldre Bladeleafs hem.",
        "5ccc8dc8c4a90148f0a5": "Den äldre Skygleam finns nära Ravencrestmonumentet i Azshara.",
        "855f4adf6ed895e5b0a3": "Denna tids stjärnor följer nya banor, fyrar av hopp och styrka för kommande tidsåldrar.",
        "8ccf0c7f54d3c04b1b26": "Den äldre Starweave finns i kustbyn Auberdine i Darkshore.",
        "bec27aaa1b07dc92b5be": "Den äldre Hammershout finns innanför Stormwinds murar.",
        "ec8a278e44a68e1abb2b": "Den äldre Bronzebeard finns i Bronzebeardernas uråldriga hem, Ironforge."
      },
