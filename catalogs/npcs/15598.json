    "deDE": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Das Dorf Dolanaar auf Teldrassil ist das Zuhause des Urahnen Bladeleaf.",
        "5ccc8dc8c4a90148f0a5": "Urahne Skygleam kann nahe des Ravencrest-Monuments in Azshara angetroffen werden.",
        "855f4adf6ed895e5b0a3": "Die Sterne bewegen sich nun auf neuen Bahnen fort. Fortan scheinen sie als Zeichen der Hoffnung und der Stärke für kommende Zeiten.",
        "8ccf0c7f54d3c04b1b26": "Urahnin Moonstrike kann in der Küstenstadt Auberdine an der Dunkelküste angetroffen werden.",
        "bec27aaa1b07dc92b5be": "Urahne Hammershout hält sich innerhalb der Mauern von Stormwind auf.",
        "ec8a278e44a68e1abb2b": "Urahne Bronzebeard kann im Zuhause der Ahnen der Bronzebeards angetroffen werden, also in Ironforge."
      },
      "name": "Urahne Bladeswift",
