    "ltLT": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Senolis Bladeleaf gyvena Dolanaar kaime, Teldrassil viršūnėje.",
        "5ccc8dc8c4a90148f0a5": "Senolį Skygleam galima rasti netoli Ravencrest paminklo Azshara krašte.",
        "855f4adf6ed895e5b0a3": "Šio meto žvaigždės suka naujais keliais, nušviesdamos ateinančius amžius viltimi ir stiprybe.",
        "8ccf0c7f54d3c04b1b26": "Senolį Starweave galima rasti pakrantės kaime Auberdine, Darkshore krašte.",
        "bec27aaa1b07dc92b5be": "Senolį Hammershout galima rasti už Stormwind sienų.",
        "ec8a278e44a68e1abb2b": "Senolį Bronzebeard galima rasti protėvių Bronzebeardų namuose, Ironforge mieste."
