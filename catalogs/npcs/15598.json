    "ptBR": {
      "dialogue": {
        "193fae65faa9c21e6a19": "O ancião Folhâmina fez da vila Dolanaar, no topo de Teldrassil, sua morada.",
        "5ccc8dc8c4a90148f0a5": "O ancião Brilhacéu se encontra perto do Monumento a Cristacorvo, em Azshara.",
        "855f4adf6ed895e5b0a3": "As estrelas desta época iluminam outros caminhos – raios de força e esperança para as eras vindouras.",
        "8ccf0c7f54d3c04b1b26": "A Anciã Tecestrela se encontra cidade litorânea de Auberdine, na Costa Negra.",
        "bec27aaa1b07dc92b5be": "O Ancião Malhogrito se encontra dentro da muralha de Ventobravo.",
        "ec8a278e44a68e1abb2b": "O ancião Barbabronze se encontra no lar ancestral dos Barbabronze, em Altaforja."
      },
      "name": "Ancião Açolesto",
