    "hrHR": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Selo Dolanaar na Teldrassilu dom je starješine Bladeleafa.",
        "5ccc8dc8c4a90148f0a5": "Starješinu Skygleama možeš pronaći blizu spomenika Ravencrestu u Azshari.",
        "855f4adf6ed895e5b0a3": "Zvijezde ovoga doba kreću novim putovima, svjetionici nade i snage za nadolazeća doba.",
        "8ccf0c7f54d3c04b1b26": "Starješinu Starweavea možeš pronaći u obalnom selu Auberdine u Darkshoreu.",
        "bec27aaa1b07dc92b5be": "Starješinu Hammershouta možeš pronaći unutar zidina Stormwinda.",
        "ec8a278e44a68e1abb2b": "Starješinu Bronzebearda možeš pronaći u pradomovini Bronzebeardovih, Ironforgeu."
