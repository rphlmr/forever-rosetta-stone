    "plPL": {
      "dialogue": {
        "193fae65faa9c21e6a19": "Wioska Dolanaar na Teldrassilu jest domem starszego Bladeleafa.",
        "5ccc8dc8c4a90148f0a5": "Starszego Skygleama znajdziesz w pobliżu pomnika Ravencresta w Azsharze.",
        "855f4adf6ed895e5b0a3": "Gwiazdy tych czasów zmierzają nowymi drogami, zwiastując nadzieję i siłę nadchodzącym epokom.",
        "8ccf0c7f54d3c04b1b26": "Starszego Starweave'a znajdziesz w nadmorskiej wiosce Auberdine w Darkshore.",
        "bec27aaa1b07dc92b5be": "Starszego Hammershouta znajdziesz za murami Stormwind.",
        "ec8a278e44a68e1abb2b": "Starszego Bronzebearda znajdziesz w rodowej siedzibie Bronzebeardów, Ironforge."
