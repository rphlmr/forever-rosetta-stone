    "esES": {
      "dialogue": {
        "193fae65faa9c21e6a19": "La aldea de Dolanaar en lo alto de Teldrassil es el hogar del ancestro Filohoja.",
        "5ccc8dc8c4a90148f0a5": "El ancestro Relucielo se encuentra cerca del Monumento Cresta Cuervo en Azshara.",
        "855f4adf6ed895e5b0a3": "Las estrellas de nuestro tiempo están cambiando su trayectoria, faros de esperanza y fortaleza para los años venideros.",
        "8ccf0c7f54d3c04b1b26": "Puedes encontrar al ancestro Tejestrellas en la villa costera de Auberdine en Costa Oscura.",
        "bec27aaa1b07dc92b5be": "Puedes encontrar al ancestro Rugidomazo dentro de las murallas de Ventormenta.",
        "ec8a278e44a68e1abb2b": "Puedes encontrar al ancestro Barbabronce en Forjaz, hogar ancestral de los Barbabronce."
      },
      "name": "Ancestro Filoveloz",
