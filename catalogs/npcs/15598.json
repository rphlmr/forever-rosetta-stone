    "enUS": {
      "dialogue": {
        "193fae65faa9c21e6a19": "The village of Dolanaar atop Teldrassil is home to Elder Bladeleaf.",
        "5ccc8dc8c4a90148f0a5": "Elder Skygleam can be found near the Ravencrest Monument in Azshara.",
        "855f4adf6ed895e5b0a3": "The stars of this time are bent on new paths, beacons of hope and strength for the coming ages.",
        "8ccf0c7f54d3c04b1b26": "Elder Starweave can be found at the coastal village of Auberdine in Darkshore.",
        "bec27aaa1b07dc92b5be": "Elder Hammershout can be found within the walls of Stormwind.",
        "ec8a278e44a68e1abb2b": "Elder Bronzebeard can be found in the ancestral home of the Bronzebeards, Ironforge."
      },
      "name": "Elder Bladeswift",
