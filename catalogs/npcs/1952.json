    "daDK": {
      "dialogue": {
        "7d222e905e4551a3780e": "Træn mig.",
        "b97937d2e463ef39b2a5": "Jeg vil gerne se dine varer.",
        "de75e1c19d2a29ec9047": "Hej, $C. Er du her, ved du nok, at Silverpine vrimler med vores fjender. De Forsagte må drive dem tilbage for at overleve!"
      },
      "name": "Overeksekutor Hadrec",
      "translationMetadata": {
