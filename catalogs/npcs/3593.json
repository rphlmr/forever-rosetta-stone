  "locales": {
    "csCZ": {
      "dialogue": {
        "40e36b56094641b11790": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé obtížnější provést, a proto je s každým přeškolením dražší. Přeješ si, abych tě odnaučila talentům, které ses naučil?",
        "8039d6554dcd4c197e89": "Zdravím. Hledáš výuku válečného umění?",
        "a6a564f5bd9e66bc8680": "Potřebuji výcvik válečníka.",
        "df7d769174316956a0dc": "Nevidím v tobě ducha bojovníka, dítě. Nemám co naučit někoho jako $c."
      },
      "name": "Alyissia",
      "translationMetadata": {
        "fields": {
          "dialogue.40e36b56094641b11790": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
