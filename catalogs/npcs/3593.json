    "plPL": {
      "dialogue": {
        "40e36b56094641b11790": "Dzięki rygorystycznemu szkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Usługa ta staje się coraz trudniejsza przy każdym kolejnym szkoleniu, dlatego też jej cena wzrasta. Czy pragniesz, abym oduczyła cię poznanych talentów?",
        "8039d6554dcd4c197e89": "Witaj. Czy szukasz nauki sztuki wojennej?",
        "a6a564f5bd9e66bc8680": "Potrzebuję szkolenia wojownika.",
        "df7d769174316956a0dc": "Nie widzę w tobie ducha wojownika, dziecko. Nie mam nauk, które przydałyby się komuś takiemu jak $c."
      },
      "name": "Alyissia",
      "translationMetadata": {
