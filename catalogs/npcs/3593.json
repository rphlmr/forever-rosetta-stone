      }
    },
    "daDK": {
      "dialogue": {
        "40e36b56094641b11790": "Gennem streng omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Min tjeneste bliver sværere at udføre hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "8039d6554dcd4c197e89": "Hilsner. Søger du undervisning i krigens kunst?",
        "a6a564f5bd9e66bc8680": "Jeg har brug for krigertræning.",
        "df7d769174316956a0dc": "Jeg ser ikke krigerens ånd i dig, barn. Jeg har intet at lære en $c som dig."
      },
      "name": "Alyissia",
      "translationMetadata": {
        "fields": {
