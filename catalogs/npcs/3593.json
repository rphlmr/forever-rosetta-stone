    "ltLT": {
      "dialogue": {
        "40e36b56094641b11790": "Griežtai permokydama turėjau priversti daugelį mokinių pamiršti viską, ką jie buvo išmokę, kad galėčiau juos mokyti iš naujo. Kiekvieną kartą suteikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "8039d6554dcd4c197e89": "Sveikas. Ar ieškai karo meno pamokų?",
        "a6a564f5bd9e66bc8680": "Noriu mokytis kario įgūdžių.",
        "df7d769174316956a0dc": "Nematau tavyje kario dvasios, vaikeli. Neturiu pamokų, kurios būtų naudingos tokiai klasei kaip $c."
      },
      "name": "Alyissia",
      "subName": "Karių mokytoja",
