    "hrHR": {
      "dialogue": {
        "40e36b56094641b11790": "Strogom sam preobukom mnoge učenike morala odviknuti od svega što su prethodno naučili kako bih ih mogla poučiti iznova. Uslugu koju nudim svaki je put sve teže izvršiti, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "8039d6554dcd4c197e89": "Pozdrav. Tražiš li poduku u ratnom umijeću?",
        "a6a564f5bd9e66bc8680": "Trebam ratničku obuku.",
        "df7d769174316956a0dc": "Ne vidim ratnički duh u tebi, dijete. Nemam poduke koja bi koristila nekome poput tebe, $c."
      },
      "name": "Alyissia",
