    "daDK": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "Ånderne har ført dig til mig. Hvordan kan jeg hjælpe?",
        "ba97c30bdc7052b4dbcb": "Ud over træning kan jeg, hvis du ønsker det, slette kendskabet til dine talenter fra dit sind. Vær advaret: Hver gang du gennemgår denne procedure, bliver den sværere og derfor dyrere."
      },
      "name": "Ingrid Dunwald",
      "translationMetadata": {
        "fields": {
