  "locales": {
    "csCZ": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "Duchové tě přivedli ke mně. Jak mohu pomoci?",
        "ba97c30bdc7052b4dbcb": "Kromě výcviku mám moc vymazat z tvé mysli znalost tvých talentů, pokud si to přeješ. Varuji tě, že pokaždé je tento postup obtížnější, a proto také dražší."
      },
      "name": "Ingrid Dunwald",
      "translationMetadata": {
