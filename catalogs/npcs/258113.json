    "enUS": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "The spirits have guided you to me. How may I be of service?",
        "ba97c30bdc7052b4dbcb": "If you desire, in addition to training, I have it within my power to erase the knowledge of your talents from your mind.  Be warned that every time you undergo this procedure the more difficult it is to perform, and therefore the more expensive it becomes."
      },
      "name": "Ingrid Dunwald",
      "subName": "Shaman Trainer",
      "translationMetadata": {
