    "hrHR": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "Duhovi su te doveli do mene. Kako ti mogu pomoći?",
        "ba97c30bdc7052b4dbcb": "Ako želiš, osim poduke mogu iz tvog uma izbrisati znanje o tvojim talentima. Upozoravam te da je postupak svaki put sve teže izvesti pa stoga postaje sve skuplji."
      },
      "name": "Ingrid Dunwald",
