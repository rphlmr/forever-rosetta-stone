    "ltLT": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "Dvasios atvedė tave pas mane. Kuo galiu tau padėti?",
        "ba97c30bdc7052b4dbcb": "Jei pageidauji, galiu ne tik tave mokyti, bet ir ištrinti žinias apie tavo talentus iš tavo atminties.  Įspėju, kad kaskart atliekant šią procedūrą ji darosi vis sudėtingesnė, todėl ir brangesnė."
      },
      "name": "Ingrid Dunwald",
