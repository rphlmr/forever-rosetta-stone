    "svSE": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "Andarna har lett dig till mig. Hur kan jag hjälpa dig?",
        "ba97c30bdc7052b4dbcb": "Om du vill kan jag, utöver träning, radera kunskapen om dina talanger ur ditt sinne. Var medveten om att ingreppet blir svårare och därmed dyrare varje gång det utförs."
      },
      "name": "Ingrid Dunwald",
