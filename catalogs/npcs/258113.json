    "plPL": {
      "dialogue": {
        "8a174ea5e521c9d6c77d": "Duchy przyprowadziły cię do mnie. Jak mogę pomóc?",
        "ba97c30bdc7052b4dbcb": "Jeśli chcesz, poza szkoleniem mogę wymazać z twojego umysłu wiedzę o twoich talentach. Ostrzegam, że za każdym razem zabieg jest trudniejszy, a przez to droższy."
      },
      "name": "Ingrid Dunwald",
