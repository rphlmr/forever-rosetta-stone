    "enUS": {
      "dialogue": {
        "a3f16b533fbe83d549b4": "Why is it that small creatures such as goblins are always fascinated with larger creatures?",
        "db463e5c0b6516425cb4": "This kodo sure looks nothing like the beast I originally lured!  I wonder if the kombobulator can be used on me."
      },
      "name": "Dying Kodo",
