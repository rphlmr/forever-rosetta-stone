    "csCZ": {
      "dialogue": {
        "a3f16b533fbe83d549b4": "Proč jsou malí tvorové jako goblini vždy fascinováni většími tvory?",
        "db463e5c0b6516425cb4": "Tohle kodo se vůbec nepodobá šelmě, kterou jsem původně nalákal! Zajímalo by mě, jestli lze kombobulátor použít i na mě."
      },
      "name": "Umírající kodo",
