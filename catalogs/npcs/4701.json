    "daDK": {
      "dialogue": {
        "a3f16b533fbe83d549b4": "Hvorfor er små væsner som gobliner altid fascinerede af større væsner?",
        "db463e5c0b6516425cb4": "Denne kodo ligner slet ikke det dyr, jeg lokkede til mig! Mon kombobulatoren kan bruges på mig?"
      },
      "name": "Døende kodo",
