  "locales": {
    "csCZ": {
      "dialogue": {
        "8e1a6c256b62878e9c56": "Prodávám jen to nejlepší arkánní vybavení, které vyrábějí řemeslníci a mágové zde ve Stormwindu.",
        "b135038d9e3ba4ef32cf": "Rád bych si prohlédl vaše zboží.",
        "d4e2d6bee3b9c2c538d5": "Od pádu Dalaranu a zničení Quel’Thalasu je těžké takové zboží sehnat. Ale Lucan Cordell a někteří naši další řemeslníci odvádějí skvělou práci a plní naše objednávky kvalitním zbožím."
      },
      "name": "Wynne Larson",
      "translationMetadata": {
        "fields": {
          "dialogue.8e1a6c256b62878e9c56": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
