            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "8e1a6c256b62878e9c56": "Yalnızca Stormwind’deki zanaatkârların ve büyücülerin yaptığı en kaliteli arkana eşyalarını satıyorum.",
        "b135038d9e3ba4ef32cf": "Mallarına bakmak istiyorum.",
        "d4e2d6bee3b9c2c538d5": "Dalaran’ın düşüşünden ve Quel’Thalas’ın yıkılışından beri bu tür malları bulmak zorlaştı. Ama Lucan Cordell ve diğer bazı zanaatkârlarımız siparişlerimizi kaliteli mallarla karşılamakta harika iş çıkarıyor."
      },
      "name": "Wynne Larson",
      "translationMetadata": {
        "fields": {
