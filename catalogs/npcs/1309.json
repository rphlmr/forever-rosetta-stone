          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "8e1a6c256b62878e9c56": "Jeg sælger kun det fineste arkane udstyr, fremstillet af håndværkerne og magikerne her i Stormwind.",
        "b135038d9e3ba4ef32cf": "Jeg vil gerne se dine varer.",
        "d4e2d6bee3b9c2c538d5": "Siden Dalarans fald og ødelæggelsen af Quel’Thalas har varer af denne slags været svære at skaffe. Men Lucan Cordell og nogle af vores andre håndværkere gør et flot stykke arbejde med at fylde vores ordrer med kvalitetsvarer."
      },
      "name": "Wynne Larson",
      "translationMetadata": {
        "fields": {
          "dialogue.8e1a6c256b62878e9c56": {
