    "svSE": {
      "dialogue": {
        "8e1a6c256b62878e9c56": "Jag säljer bara den finaste arkana utrustningen, tillverkad av hantverkarna och magikerna här i Stormwind.",
        "b135038d9e3ba4ef32cf": "Jag vill se dina varor.",
        "d4e2d6bee3b9c2c538d5": "Sedan Dalarans fall och förstörelsen av Quel’Thalas har varor av det här slaget varit svåra att få tag på. Men Lucan Cordell och några av våra andra hantverkare gör ett utmärkt arbete med att fylla våra beställningar med kvalitetsvaror."
      },
      "name": "Wynne Larson",
      "translationMetadata": {
        "fields": {
          "dialogue.8e1a6c256b62878e9c56": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.b135038d9e3ba4ef32cf": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.d4e2d6bee3b9c2c538d5": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
