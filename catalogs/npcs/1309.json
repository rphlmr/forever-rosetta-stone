    "enUS": {
      "dialogue": {
        "8e1a6c256b62878e9c56": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "b135038d9e3ba4ef32cf": "I want to browse your goods.",
        "d4e2d6bee3b9c2c538d5": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise."
      },
      "name": "Wynne Larson",
      "subName": "Robe Merchant",
      "translationMetadata": {
        "fields": {
