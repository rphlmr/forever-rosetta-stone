    "hrHR": {
      "dialogue": {
        "8e1a6c256b62878e9c56": "Prodajem samo najbolju arkansku opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu.",
        "b135038d9e3ba4ef32cf": "Želim pogledati vašu robu.",
        "d4e2d6bee3b9c2c538d5": "Od pada Dalarana i uništenja Quel’Thalasa teško je nabaviti takvu robu. Ali Lucan Cordell i neki drugi naši obrtnici izvrsno ispunjavaju naše narudžbe kvalitetnom robom."
      },
      "name": "Wynne Larson",
      "translationMetadata": {
