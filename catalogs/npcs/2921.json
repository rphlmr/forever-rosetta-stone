    "daDK": {
      "dialogue": {
        "1eaf2a3e6949bb181e59": "Jeg vil gerne se dine varer.",
        "8d9762b55eda90043837": "Træn mig.",
        "e3c6a758b1457c2878ec": "Hvor belejligt, at du kom forbi, $c.$B$BJeg hedder Lotwil Veriatus, stiftende medlem af den Oplyste Forsamling for Arkanologi, Alkymi og Ingeniørvidenskab. Vi søger at samle Azeroths videnskaber i én omfattende skole."
      },
      "name": "Lotwil Veriatus",
      "translationMetadata": {
        "fields": {
