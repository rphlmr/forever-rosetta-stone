  "locales": {
    "csCZ": {
      "dialogue": {
        "1eaf2a3e6949bb181e59": "Rád bych si prohlédl vaše zboží.",
        "8d9762b55eda90043837": "Vycvičte mě.",
        "e3c6a758b1457c2878ec": "Jak příhodné, že jsi přišel, $c.$B$BJmenuji se Lotwil Veriatus, zakládající člen Osvíceného shromáždění arkánních, alchymistických a inženýrských věd. Snažíme se spojit vědy Azerothu do jediné všeobjímající školy."
      },
      "name": "Lotwil Veriatus",
      "translationMetadata": {
        "fields": {
