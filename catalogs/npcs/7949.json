  "locales": {
    "csCZ": {
      "dialogue": {
        "2f27af25366bcc59e66e": "Znám mnoho věcí, cizinče, ale tvé znalosti se vyrovnají mým. Zaklínači, kteří chtějí dále zdokonalovat své umění, cestují do Azoriny věže, kde sídlí mistryně Kitta Firewind.",
        "95154ec3d7485c5f0ba0": "Co kdybychom zjistili, čeho jsi schopen? Pokud úkol splníš, ráda tě budu dále učit!",
        "9897c8cfa6762e23ac78": "Vycvičte mě.",
        "f195819d0f42907abd58": "Hledáš-li skutečně obohacující povolání, život zaklínače je pro tebe!"
      },
      "name": "Xylinnia Starshine",
      "translationMetadata": {
        "fields": {
