    "enUS": {
      "dialogue": {
        "2f27af25366bcc59e66e": "I know many things, stranger, but your knowledge rivals my own. Enchanters who wish to hone their skills further are known to travel to the Tower of Azora, where an artisan named Kitta Firewind resides.",
        "95154ec3d7485c5f0ba0": "Why don't we see just what you're capable of? If you complete the task I shall be happy to further your training! ",
        "9897c8cfa6762e23ac78": "Train me.",
        "f195819d0f42907abd58": "If you are seeking a truly rewarding pursuit, then a life of enchanting is for you!"
      },
      "name": "Xylinnia Starshine",
      "subName": "Expert Enchanter",
      "translationMetadata": {
        "fields": {
