    "hrHR": {
      "dialogue": {
        "2f27af25366bcc59e66e": "Mnogo znam, stranče, ali tvoje je znanje ravno mojemu. Očaratelji koji žele dodatno usavršiti vještine putuju u Azorin toranj, gdje boravi majstorica Kitta Firewind.",
        "95154ec3d7485c5f0ba0": "Zašto ne bismo vidjeli što možeš? Ako izvršiš zadatak, rado ću nastaviti tvoju obuku!",
        "9897c8cfa6762e23ac78": "Podučite me.",
        "f195819d0f42907abd58": "Ako tražiš doista ispunjavajuće zanimanje, život očaratelja je za tebe!"
      },
      "name": "Xylinnia Starshine",
