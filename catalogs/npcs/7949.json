    "ltLT": {
      "dialogue": {
        "2f27af25366bcc59e66e": "Daug ką žinau, nepažįstamasis, bet tavo žinios prilygsta manosioms. Kerėtojai, norintys dar labiau ištobulinti savo įgūdžius, keliauja į Azoros bokštą, kuriame gyvena meistrė Kitta Firewind.",
        "95154ec3d7485c5f0ba0": "Pažiūrėkime, ką sugebi. Jei atliksi užduotį, mielai mokysiu tave toliau! ",
        "9897c8cfa6762e23ac78": "Mokyk mane.",
        "f195819d0f42907abd58": "Jei ieškai išties naudingo užsiėmimo, kerėjimas kaip tik tau!"
      },
      "name": "Xylinnia Starshine",
      "subName": "Kerėjimo ekspertė",
      "translationMetadata": {
