    "plPL": {
      "dialogue": {
        "2f27af25366bcc59e66e": "Wiem wiele, nieznajomy, ale twoja wiedza dorównuje mojej. Zaklinacze pragnący dalej doskonalić umiejętności udają się do Wieży Azory, gdzie mieszka mistrzyni Kitta Firewind.",
        "95154ec3d7485c5f0ba0": "Może sprawdzimy, na co cię stać? Jeśli wykonasz zadanie, z przyjemnością będę dalej cię szkolić!",
        "9897c8cfa6762e23ac78": "Wyszkol mnie.",
        "f195819d0f42907abd58": "Jeśli szukasz naprawdę satysfakcjonującego zajęcia, życie zaklinacza jest dla ciebie!"
      },
      "name": "Xylinnia Starshine",
      "translationMetadata": {
