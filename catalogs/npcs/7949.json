    },
    "daDK": {
      "dialogue": {
        "2f27af25366bcc59e66e": "Jeg ved meget, fremmede, men din viden kan måle sig med min. Fortryllere, der ønsker at forfine deres evner, rejser ofte til Azoras tårn, hvor håndværkeren Kitta Firewind holder til.",
        "95154ec3d7485c5f0ba0": "Skal vi ikke se, hvad du er i stand til? Klarer du opgaven, vil jeg gerne fortsætte din uddannelse!",
        "9897c8cfa6762e23ac78": "Træn mig.",
        "f195819d0f42907abd58": "Søger du en virkelig givende beskæftigelse, er et liv som fortryller noget for dig!"
      },
      "name": "Xylinnia Starshine",
      "translationMetadata": {
        "fields": {
          "dialogue.2f27af25366bcc59e66e": {
