    "hrHR": {
      "dialogue": {
        "18ee06d21170ef32cfeb": "Temeljitom sam prekvalifikacijom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao ponovno podučiti. Ta je usluga svaki put sve teža, pa je zato i sve skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "84925789d0b43edae99d": "Možda ne slijediš putove Svjetlosti poput viteza Srebrne ruke, ali uvijek nam se možeš obratiti za pomoć.",
        "9c1aab78695df19d918d": "Neka te Svjetlost danas štiti.",
        "f420d4b558a9698b8c43": "Želio bih nastaviti obuku na putevima Svjetlosti.",
        "zephras:6768cd663d9bf29f26f0": "Želim zaboraviti svoje klasne ili naslijeđene talente."
      },
      "name": "Brandur Ironhammer",
      "translationMetadata": {
