  "locales": {
    "csCZ": {
      "dialogue": {
        "18ee06d21170ef32cfeb": "Při důkladném přeškolování jsem musel mnoho žáků odnaučit vše, co se dříve naučili, abych je mohl učit znovu. Tato služba je při každém dalším provedení obtížnější, a proto také dražší. Přeješ si, abych tě odnaučil talenty, které ses naučil?",
        "84925789d0b43edae99d": "Možná se neřídíš cestami Světla jako rytíř Stříbrné ruky, ale vždy nás můžeš požádat o pomoc.",
        "9c1aab78695df19d918d": "Ať tě dnes Světlo chrání.",
        "f420d4b558a9698b8c43": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "zephras:6768cd663d9bf29f26f0": "Chci zapomenout své třídní nebo starší talenty."
      },
      "name": "Brandur Ironhammer",
      "translationMetadata": {
        "fields": {
          "dialogue.18ee06d21170ef32cfeb": {
