    "enUS": {
      "dialogue": {
        "18ee06d21170ef32cfeb": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "84925789d0b43edae99d": "Ya may not follow the ways of the Light like a Knight of the Silver Hand, but ya can always ask us for aid.",
        "9c1aab78695df19d918d": "May the Light protect you this day.",
        "f420d4b558a9698b8c43": "I would like to train further in the ways of the Light.",
        "zephras:6768cd663d9bf29f26f0": "I wish to unlearn my class or legacy talents."
      },
      "name": "Brandur Ironhammer",
      "subName": "Paladin Trainer",
      "translationMetadata": {
