    "hrHR": {
      "dialogue": {
        "32815bb52f9f1fe84747": "Želio bih nastaviti obuku na putevima Svjetlosti.",
        "73ac424573b48f46b1b5": "Neka te Svjetlost danas štiti.",
        "f4d1909c4bd7d13cf475": "Strogom prekvalifikacijom morala sam mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogla poučiti iznova. Usluga koju nudim svaki je put sve teža, pa je zato i svaka sljedeća prekvalifikacija skuplja. Želiš li da te odviknem od talenata koje si naučio?"
      },
      "name": "Čista Katherine",
      "translationMetadata": {
