    "plPL": {
      "dialogue": {
        "32815bb52f9f1fe84747": "Chcę dalej szkolić się na ścieżkach Światłości.",
        "73ac424573b48f46b1b5": "Niech Światło cię dziś chroni.",
        "f4d1909c4bd7d13cf475": "Poprzez rygorystyczne przeszkolenie musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, abym mogła uczyć ich od nowa. Usługa ta staje się coraz trudniejsza przy każdym kolejnym razie. Dlatego każde przeszkolenie kosztuje coraz więcej. Czy chcesz, abym pomogła ci zapomnieć wyuczone talenty?"
      },
      "name": "Katherine Czysta",
