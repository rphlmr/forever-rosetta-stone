  "locales": {
    "csCZ": {
      "dialogue": {
        "32815bb52f9f1fe84747": "Chtěl bych se dále zdokonalovat v cestách Světla.",
        "73ac424573b48f46b1b5": "Kéž tě dnes Světlo chrání.",
        "f4d1909c4bd7d13cf475": "Přísným přeškolením jsem musela mnoho žáků odnaučit všemu, co se dříve naučili, abych je mohla učit znovu. Tato služba je pokaždé obtížnější, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talenty, které ses naučil?"
      },
      "name": "Katherine Čistá",
      "translationMetadata": {
        "fields": {
          "dialogue.32815bb52f9f1fe84747": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.73ac424573b48f46b1b5": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.f4d1909c4bd7d13cf475": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "32815bb52f9f1fe84747": "Jeg vil gerne videreuddanne mig i Lysets veje.",
        "73ac424573b48f46b1b5": "Må Lyset beskytte dig i dag.",
        "f4d1909c4bd7d13cf475": "Gennem streng omskoling har jeg måttet aflære mange elever alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Den tjeneste, jeg tilbyder, bliver sværere for hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg aflærer dig de talenter, du har lært?"
      },
      "name": "Katherine den rene",
      "translationMetadata": {
        "fields": {
          "dialogue.32815bb52f9f1fe84747": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
