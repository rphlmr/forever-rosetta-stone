    "svSE": {
      "dialogue": {
        "32815bb52f9f1fe84747": "Jag vill fortsätta min träning i Ljusets vägar.",
        "73ac424573b48f46b1b5": "Må Ljuset beskydda dig denna dag.",
        "f4d1909c4bd7d13cf475": "Genom rigorös omskolning har jag fått hjälpa många elever att glömma allt de tidigare lärt sig så att jag kan undervisa dem på nytt. Tjänsten jag erbjuder blir svårare varje gång den utförs. Därför blir varje omskolning också dyrare. Vill du att jag hjälper dig att glömma de talanger du har lärt dig?"
      },
      "name": "Katherine den rena",
      "translationMetadata": {
        "fields": {
          "dialogue.32815bb52f9f1fe84747": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
