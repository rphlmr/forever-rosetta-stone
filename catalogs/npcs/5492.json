    "enUS": {
      "dialogue": {
        "32815bb52f9f1fe84747": "I would like to train further in the ways of the Light.",
        "73ac424573b48f46b1b5": "May the Light protect you this day.",
        "f4d1909c4bd7d13cf475": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?"
      },
      "name": "Katherine the Pure",
      "subName": "Church of the Holy Light",
      "translationMetadata": {
        "fields": {
          "dialogue.32815bb52f9f1fe84747": {
