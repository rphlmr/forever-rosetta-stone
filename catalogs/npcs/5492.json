    },
    "trTR": {
      "dialogue": {
        "32815bb52f9f1fe84747": "Işık’ın yollarında eğitimime devam etmek istiyorum.",
        "73ac424573b48f46b1b5": "Işık bugün seni korusun.",
        "f4d1909c4bd7d13cf475": "Onlara yeniden öğretebilmek için sıkı bir yeniden eğitimle pek çok öğrencime daha önce öğrendikleri her şeyi unutturmak zorunda kaldım. Sunduğum bu hizmet her tekrarlandığında daha zor hale geliyor. Bu yüzden her yeniden eğitimde ücreti de artıyor. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?"
      },
      "name": "Saf Katherine",
      "translationMetadata": {
        "fields": {
          "dialogue.32815bb52f9f1fe84747": {
