    "plPL": {
      "dialogue": {
        "0807c8d5eb248e7debe7": "Cóż, dotarłeś aż tutaj... idź do Lavinii Crowe przy tamtym drugim regale. Jeśli niczego u niej nie zepsujesz, może nauczysz się czegoś więcej.",
        "ace5688387f4a3768af7": "Nie wyglądasz na kogoś szczególnego, ale kto wie, może gdzieś w środku kryje się zaklinacz!",
        "b2bb14e02e0a49810e1c": "Wyszkol mnie.",
        "f78499b2e6527da404b4": "Nie mam czasu do stracenia, nieznajomy. Mów, po co tu jesteś, albo znikaj!"
      },
      "name": "Malcomb Wynn",
      "translationMetadata": {
