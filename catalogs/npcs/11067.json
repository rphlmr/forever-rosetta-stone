    "daDK": {
      "dialogue": {
        "0807c8d5eb248e7debe7": "Nå, du er kommet så langt... gå hen til Lavinia Crowe ved den anden bogreol derovre. Hvis du ikke ødelægger det hos hende, kan du måske lære mere.",
        "ace5688387f4a3768af7": "Du ser ikke ud af meget, men hvem ved, måske gemmer der sig en fortryller et sted derinde!",
        "b2bb14e02e0a49810e1c": "Træn mig.",
        "f78499b2e6527da404b4": "Jeg har ikke tid at spilde, fremmede. Sig dit ærinde, eller gå!"
      },
      "name": "Malcomb Wynn",
      "translationMetadata": {
        "fields": {
          "dialogue.0807c8d5eb248e7debe7": {
