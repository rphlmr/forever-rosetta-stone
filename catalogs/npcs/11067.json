    "hrHR": {
      "dialogue": {
        "0807c8d5eb248e7debe7": "Pa, dogurao si dovde... idi do Lavinije Crowe kraj one druge police za knjige. Ako kod nje ne zabrljaš, možda ćeš naučiti još nešto.",
        "ace5688387f4a3768af7": "Ne izgledaš mi posebno, ali tko zna, možda se negdje u tebi krije očaravatelj!",
        "b2bb14e02e0a49810e1c": "Podučite me.",
        "f78499b2e6527da404b4": "Nemam vremena za gubljenje, stranče. Reci što želiš ili odlazi!"
      },
      "name": "Malcomb Wynn",
      "translationMetadata": {
