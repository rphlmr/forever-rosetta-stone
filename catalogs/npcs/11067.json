    "enUS": {
      "dialogue": {
        "0807c8d5eb248e7debe7": "Eh, well you've made it this far... go see Lavinia Crowe by the other bookshelf there. If you don't mess things up with her, maybe you can learn some more.",
        "ace5688387f4a3768af7": "You don't look like much to me, but who knows, maybe there's an enchanter hidden in there somewhere!",
        "b2bb14e02e0a49810e1c": "Train me.",
        "f78499b2e6527da404b4": "I do not have time to waste, stranger. State your business or be off!"
      },
      "name": "Malcomb Wynn",
      "subName": "Journeyman Enchanter",
      "translationMetadata": {
        "fields": {
          "dialogue.0807c8d5eb248e7debe7": {
