    "esES": {
      "dialogue": {
        "0807c8d5eb248e7debe7": "Eh, bien, has llegado hasta aquí... ve a ver a Lavinia Crowe junto al otro estante. Si tienes cuidado y no echas a perder las cosas con ella, podrás aprender algo más.",
        "ace5688387f4a3768af7": "No te pareces mucho a mí, pero quién sabe, ¡quizás haya un encantador escondido ahí dentro!",
        "b2bb14e02e0a49810e1c": "Entréname.",
        "f78499b2e6527da404b4": "No puedo perder el tiempo, forastero. ¡Expón tus asuntos o lárgate!"
      },
      "name": "Malcomb Wynn",
      "subName": "Oficial encantador",
