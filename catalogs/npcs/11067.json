  "locales": {
    "csCZ": {
      "dialogue": {
        "0807c8d5eb248e7debe7": "Nu, dostal ses až sem... zajdi za Lavinií Croweovou k tamté knihovně. Když to u ní nepokazíš, možná se naučíš něco dalšího.",
        "ace5688387f4a3768af7": "Moc toho nepředvádíš, ale kdo ví, možná se v tobě někde skrývá zaklínač!",
        "b2bb14e02e0a49810e1c": "Vycvičte mě.",
        "f78499b2e6527da404b4": "Nemám čas nazbyt, cizinče. Řekni, co chceš, nebo jdi pryč!"
      },
      "name": "Malcomb Wynn",
      "translationMetadata": {
        "fields": {
          "dialogue.0807c8d5eb248e7debe7": {
