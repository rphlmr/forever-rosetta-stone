            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "9f3b63afadc7847bcb71": "Salve, amigo! Pode me dar um instantinho?\n\nTemos enfrentado muitas provações e tribulações para firmar Teldrassil. Como se a luta constante não bastasse, encontramo-nos em escassez de tecidos. Se tiver tecidos sobrando, por favor, doe-os. Ao nos ajudar, você estará conquistando a gratidão dos elfos noturnos de todo o mundo!"
      },
      "name": "Radeon Golpúsculo",
      "subName": "Intendente de Tecidos da Aliança",
      "translationMetadata": {
        "fields": {
          "dialogue.9f3b63afadc7847bcb71": {
