  "locales": {
    "csCZ": {
      "dialogue": {
        "0c0dde5a6d62d7653b1b": "Ukažte mi svou nabídku grimoárů.",
        "5cdfd81676215544109a": "Nejsi černokněžník a já na tebe nemám čas. Zmiz!",
        "b291f0544adb81a4fa98": "Chceš své démony posílit? Něco tě to bude stát, ale jsi na správném místě."
      },
      "name": "Cylina Darkheart",
      "translationMetadata": {
        "fields": {
          "dialogue.0c0dde5a6d62d7653b1b": {
