    "deDE": {
      "dialogue": {
        "0c0dde5a6d62d7653b1b": "Zeigt mir Eure Auswahl an Grimoires.",
        "5cdfd81676215544109a": "Ihr seid kein Hexenmeister und ich habe keine Zeit für Euch. Hebt Euch hinweg!",
        "b291f0544adb81a4fa98": "Ihr möchtet Eure Dämonen mächtiger machen? Das wird Euch einiges kosten, aber Ihr seid hier richtig."
      },
      "name": "Cylina Darkheart",
      "subName": "Dämonenausbilderin",
