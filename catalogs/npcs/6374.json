    },
    "daDK": {
      "dialogue": {
        "0c0dde5a6d62d7653b1b": "Vis mig dit udvalg af grimoirer.",
        "5cdfd81676215544109a": "Du er ikke troldmand, og jeg har ikke tid til dig. Forsvind!",
        "b291f0544adb81a4fa98": "Vil du gøre dine dæmoner stærkere? Det koster dig, men du er kommet til det rette sted."
      },
      "name": "Cylina Darkheart",
      "translationMetadata": {
        "fields": {
          "dialogue.0c0dde5a6d62d7653b1b": {
            "origin": "ai",
