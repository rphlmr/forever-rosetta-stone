    "enUS": {
      "dialogue": {
        "0c0dde5a6d62d7653b1b": "Show me your selection of grimoires.",
        "5cdfd81676215544109a": "You're no warlock and I've no time for you.  Begone!",
        "b291f0544adb81a4fa98": "Want to make your demons more powerful?  It'll cost you, but you've come to the right place."
      },
      "name": "Cylina Darkheart",
      "subName": "Demon Trainer",
