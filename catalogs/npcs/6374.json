    "svSE": {
      "dialogue": {
        "0c0dde5a6d62d7653b1b": "Visa mig ditt utbud av grimorier.",
        "5cdfd81676215544109a": "Du är ingen häxmästare och jag har inte tid med dig. Försvinn!",
        "b291f0544adb81a4fa98": "Vill du göra dina demoner starkare? Det kommer att kosta, men du har kommit till rätt ställe."
      },
