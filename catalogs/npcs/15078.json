    "daDK": {
      "dialogue": {
        "bdbac7a517228587b833": "Fiskemester Bassbait har udsat velsmagende fisk af høj kvalitet i vandene her, så han kan holde sin turnering.\n\nNår han har fundet sin vinder, giver jeg dig sølv for hver fem velsmagende fisk, du bringer mig!\n"
      },
      "name": "Jang",
      "translationMetadata": {
