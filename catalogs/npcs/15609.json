  "locales": {
    "csCZ": {
      "dialogue": {
        "1b985232266c41201ee5": "Brzy zbavíme Azeroth odporné přítomnosti silithidů. Jejich ničivý potenciál je mnohem větší, než co jsi viděl na vlastní oči, $n. Za jejich činností stojí mocnější a temnější síly."
      },
      "name": "Cenarionský zvěd Landion",
