    "plPL": {
      "dialogue": {
        "1b985232266c41201ee5": "Wkrótce uwolnimy Azeroth od odrażającej obecności silithidów. Ich niszczycielski potencjał jest znacznie większy niż to, co widzisz na własne oczy, $n. Za ich działaniami stoją większe, mroczniejsze siły."
      },
      "name": "Zwiadowca Cenarionu Landion",
