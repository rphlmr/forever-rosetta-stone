    "hrHR": {
      "dialogue": {
        "1b985232266c41201ee5": "Uskoro ćemo osloboditi Azeroth od mrske prisutnosti silithida. Njihova razorna moć mnogo je veća od onoga što si vidio vlastitim očima, $n. Iza njihovih postupaka stoje veće i mračnije sile."
      },
      "name": "Cenarionski izviđač Landion",
