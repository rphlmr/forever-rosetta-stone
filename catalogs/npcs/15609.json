    "enUS": {
      "dialogue": {
        "1b985232266c41201ee5": "Soon we shall rid Azeroth of the silithids' abominable presence.  Their potential for destruction is much greater than what you've seen firsthand, $n.  Greater, darker powers are behind their activities."
      },
      "name": "Cenarion Scout Landion",
      "translationMetadata": {
        "fields": {
