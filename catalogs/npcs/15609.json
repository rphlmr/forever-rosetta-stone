        }
      }
    },
    "daDK": {
      "dialogue": {
        "1b985232266c41201ee5": "Snart vil vi befri Azeroth for silithidernes afskyelige tilstedeværelse. Deres ødelæggende potentiale er langt større end det, du selv har set, $n. Større og mørkere kræfter står bag deres aktiviteter."
      },
      "name": "Cenarion-spejder Landion",
      "translationMetadata": {
        "fields": {
