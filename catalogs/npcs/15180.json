            "sourceLocale": "frFR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "hrHR": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Pogledaj iza sebe, $r. Košnica se budi dok se zemlja oko nas trese i podrhtava.$B$BDošlo je vrijeme da ispunim obećanje koje sam dao prije tisuću godina. Pijesak se ponovno miče dok Qiraji spremaju rat."
      },
      "name": "Baristolth iz pokretnog pijeska",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "itIT": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Guarda dietro di te, $R. L'alveare si agita, mentre la terra che ci circonda freme e trema.\n\nÈ giunto per me il momento di mantenere una promessa che feci mille anni fa. Le sabbie si muovono ancora una volta, mentre i Qiraji preparano la guerra."
      },
      "name": "Baristolth of the Shifting Sands",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "itIT",
