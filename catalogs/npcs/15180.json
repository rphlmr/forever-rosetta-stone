            "sourceLocale": "koKR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "plPL": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Spójrz za siebie, $r. Rój się budzi, a otaczająca nas ziemia drży i trzęsie się.$B$BNadszedł czas, abym spełnił obietnicę sprzed tysiąca lat. Piaski znów się przesuwają, a Qiraji szykują się do wojny."
      },
      "name": "Baristolth z Ruchomych Piasków",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "ptBR": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Olhe atrás de você, $r. A colmeia se inquieta e as terras à nossa volta estremecem e se agitam.\n\nChegou a hora de cumprir uma promessa que fiz mil anos atrás. As areias se movem uma vez mais: os qirajis se preparam para a guerra."
      },
      "name": "Baristolth das Areias Cambiantes",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ptBR",
            "sourceSha256": "4499628c4271be05580bea7136b76bd490255ac29eb596a9bcd0e879a7e1bf5d"
          },
          "name": {
