            "source": "questie",
            "sourceLocale": "ptBR",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Оглянитесь, $r. Рой неспокоен, а земля вокруг улья трясется и дрожит.\n\nПора мне выполнить обещание, которое я принес тысячу лет назад. Когда пески сместятся еще раз, кираи начнут войну."
      },
      "name": "Баристолф из Зыбучих Песков",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ruRU",
            "sourceSha256": "6c631198f2820ad1638d95d5c2405c11c90019cbf3afeca9541bb2b70432f7ff"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "ruRU",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "svSE": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Se bakom dig, $r. Kupan vaknar medan landet omkring oss darrar och skälver.$B$BTiden har kommit för mig att uppfylla ett löfte jag gav för tusen år sedan. Sanden rör sig åter när qirajierna planerar krig."
      },
      "name": "Baristolth från de skiftande sandarna",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          }
        }
      }
    },
    "trTR": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Arkana bak, $r. Çevremizdeki toprak sarsılıp titrerken kovan uyanıyor.$B$BBin yıl önce verdiğim bir sözü yerine getirme zamanı geldi. Qirajiler savaş planları yaparken kumlar bir kez daha yer değiştiriyor."
      },
      "name": "Baristolth of the Shifting Sands",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "ukUA": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "Озирнися, $r. Вулик пробуджується, а земля навколо нас здригається й тремтить.$B$BНастав час виконати обіцянку, яку я дав тисячу років тому. Піски знову рухаються, поки кіражі готуються до війни."
      },
      "name": "Барістольт Мінливих Пісків",
      "translationMetadata": {
        "fields": {
          "dialogue.fe692cd1fbbfdbd5a065": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
