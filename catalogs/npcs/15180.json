            "origin": "community",
            "source": "classicUA",
            "sourceLocale": "ukUA",
            "sourceRevision": "d9bf29572a85957fd69085be0cec28262cba0c87"
          }
        }
      }
    },
    "zhCN": {
      "dialogue": {
        "fe692cd1fbbfdbd5a065": "看看你身后，$R。虫巢中的异动使我们周围的土地震动起来。\n\n现在是我们实现一千年前许下的诺言的时候了。沙土飞扬，似乎其拉虫人是在计划开战了。"
      },
      "name": "流沙守望者巴里斯托尔斯",
      "translationMetadata": {
        "fields": {
