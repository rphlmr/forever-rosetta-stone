    "esMX": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Entréname.",
        "44db8985711c12acb51f": "Te diré que ha sido toda una escapada, $c. Estábamos agarrando todo lo que no estaba clavado o podía quitarse rápidamente. Por eso andamos cortos de suministros.",
        "50678bc20a44f177939b": "Quiero ver tus mercancías."
      },
      "name": "Sigrun Extracero",
      "translationMetadata": {
        "fields": {
