    "hrHR": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Podučite me.",
        "44db8985711c12acb51f": "Bio je to pravi odlazak, vjeruj mi, $c. Grabili smo sve što nije bilo pribijeno ili se moglo brzo odnijeti. Zato nam malo nedostaje zaliha.",
        "50678bc20a44f177939b": "Želim pogledati vašu robu."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
          "dialogue.2ce7a15bec5d7955d572": {
