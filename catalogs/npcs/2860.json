          }
        }
      }
    },
    "ruRU": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Обучите меня.",
        "44db8985711c12acb51f": "Это было довольно неплохое отступление я вам скажу, $c. Мы хватали все, что можно было унести, и от этого наши запасы не так велики.",
        "50678bc20a44f177939b": "Я хочу посмотреть ваши товары."
      },
      "name": "Сигрун Рудотес",
      "translationMetadata": {
        "fields": {
