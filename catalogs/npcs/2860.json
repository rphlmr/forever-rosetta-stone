    "frFR": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Entraînez-moi.",
        "44db8985711c12acb51f": "C'était un peu différent, permettez-moi de vous le dire, $c. Nous prenions tout ce qui n'était pas cloué ou qui pouvait être enlevé rapidement. Nous sommes un peu à l'étroit dans nos réserves à cause de cela.",
        "50678bc20a44f177939b": "Je voudrais regarder vos articles."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
