    "svSE": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Träna mig.",
        "44db8985711c12acb51f": "Det var en avfärd utan like, ska du veta, $c. Vi tog allt som inte satt fastspikat eller kunde tas loss snabbt. Därför har vi lite ont om förnödenheter.",
        "50678bc20a44f177939b": "Jag vill se dina varor."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
