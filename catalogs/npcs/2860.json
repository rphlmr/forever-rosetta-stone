          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Bildet mich aus.",
        "44db8985711c12acb51f": "Das war eine ziemliche Umstellung, das kann ich dir sagen, $c. Wir haben uns alles geschnappt, was nicht niet- und nagelfest war oder schnell entfernt werden konnte. Deshalb sind wir mit den Vorräten etwas sparsam umgegangen.",
        "50678bc20a44f177939b": "Ich möchte Eure Waren ansehen."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
          "dialogue.2ce7a15bec5d7955d572": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
