    "zhCN": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "训练我。",
        "44db8985711c12acb51f": "让我告诉你，这是个相当大的变化，C美元。我们正在抓取任何没有被钉住的东西，或者可以快速移除的东西。正因为如此，我们在物资上有点多余。",
        "50678bc20a44f177939b": "我想看看你的货物。"
      },
      "name": "西格鲁·铁斧",
      "translationMetadata": {
        "fields": {
          "dialogue.2ce7a15bec5d7955d572": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.44db8985711c12acb51f": {
            "origin": "community",
