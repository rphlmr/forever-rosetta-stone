    "plPL": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Wyszkol mnie.",
        "44db8985711c12acb51f": "Ależ to był wyjazd, mówię ci, $c. Zabieraliśmy wszystko, co nie było przybite albo dało się szybko wynieść. Przez to mamy trochę mało zapasów.",
        "50678bc20a44f177939b": "Chcę przejrzeć twoje towary."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
          "dialogue.2ce7a15bec5d7955d572": {
