  "locales": {
    "csCZ": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Vycvičte mě.",
        "44db8985711c12acb51f": "To byl tedy odchod, to ti povím, $c. Brali jsme všechno, co nebylo přibité nebo šlo rychle odnést. Proto máme teď trochu málo zásob.",
        "50678bc20a44f177939b": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
          "dialogue.2ce7a15bec5d7955d572": {
