      }
    },
    "itIT": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Addestrami.",
        "44db8985711c12acb51f": "È stata una partenza mica da ridere, te lo dico io, $C. Arraffavamo tutto quello che non era inchiodato o che si poteva portar via in fretta. Per questo siamo un po' a corto di scorte.",
        "50678bc20a44f177939b": "Vorrei vedere la tua merce."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
