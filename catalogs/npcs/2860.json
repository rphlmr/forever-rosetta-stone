    "daDK": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Træn mig.",
        "44db8985711c12acb51f": "Det var noget af en afrejse, skal jeg sige dig, $c. Vi tog alt, hvad der ikke var naglet fast eller hurtigt kunne fjernes. Derfor har vi lidt knapt med forsyninger.",
        "50678bc20a44f177939b": "Jeg vil gerne se dine varer."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
        "fields": {
          "dialogue.2ce7a15bec5d7955d572": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
