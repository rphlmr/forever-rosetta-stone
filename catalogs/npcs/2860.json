      }
    },
    "ptBR": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Treine-me.",
        "44db8985711c12acb51f": "Foi uma partida e tanto, vou lhe dizer, $c. Pegamos tudo que não estava pregado ou que pudesse ser retirado rapidamente. Por isso estamos com poucos suprimentos.",
        "50678bc20a44f177939b": "Quero ver suas mercadorias."
      },
      "name": "Sigrun Derrubaferro",
      "translationMetadata": {
        "fields": {
