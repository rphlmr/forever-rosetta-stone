    "trTR": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Beni eğit.",
        "44db8985711c12acb51f": "Nasıl ayrıldık bir bilsen, $c. Çivilenmemiş ya da hızla sökülebilecek ne varsa kaptık. Bu yüzden erzakımız biraz az.",
        "50678bc20a44f177939b": "Mallarına bakmak istiyorum."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
