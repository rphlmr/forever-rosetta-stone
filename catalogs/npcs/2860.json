    "esES": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Entréname.",
        "44db8985711c12acb51f": "Fue todo un cambio, déjame decirte, $c. Cogíamos todo lo que no estuviera clavado o pudiera quitarse rápidamente. Estamos un poco escasos de suministros debido a ello.",
        "50678bc20a44f177939b": "Quiero ver tus mercancías."
      },
      "name": "Sigrun Extracero",
      "translationMetadata": {
        "fields": {
