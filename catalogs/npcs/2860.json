    "enUS": {
      "dialogue": {
        "2ce7a15bec5d7955d572": "Train me.",
        "44db8985711c12acb51f": "It was quite a departure, let me tell you, $c. We were grabbing whatever wasn't nailed down or could be removed quickly. We're a little spare on supplies because of it.",
        "50678bc20a44f177939b": "I want to browse your goods."
      },
      "name": "Sigrun Ironhew",
      "translationMetadata": {
