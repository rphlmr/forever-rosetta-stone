  "locales": {
    "csCZ": {
      "dialogue": {
        "53bdee97d4cb12a75136": "Ashenvale je bujný les překypující životem. Je potěšením procházet jeho skrytými stezkami a hledat byliny, ale člověk musí být opatrný. Les skrývá i nebezpečí.",
        "5c108a014bf1f83adb06": "Chci si prohlédnout vaše zboží.",
        "8194ba020f6848ea77f0": "Vycvičte mě."
      },
      "name": "Orendil Broadleaf",
