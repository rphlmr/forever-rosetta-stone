    "enUS": {
      "dialogue": {
        "53bdee97d4cb12a75136": "Ashenvale is a lush forest, brimming with life. It is a pleasure to walk down its secret paths in search of herbs, but one must take care. The forest is not without its dangers.",
        "5c108a014bf1f83adb06": "I want to browse your goods.",
        "8194ba020f6848ea77f0": "Train me."
      },
