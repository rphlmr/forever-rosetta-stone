    "esES": {
      "dialogue": {
        "53bdee97d4cb12a75136": "Ashenvale es un bosque exuberante, rebosante de vida. Es un placer caminar por sus senderos secretos en busca de hierbas, pero hay que tener cuidado. El bosque no está exento de peligros.",
        "5c108a014bf1f83adb06": "Quiero ver tus mercancías.",
        "8194ba020f6848ea77f0": "Entréname."
