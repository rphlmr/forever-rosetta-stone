    "hrHR": {
      "dialogue": {
        "53bdee97d4cb12a75136": "Ashenvale je bujna šuma puna života. Užitak je hodati njezinim tajnim stazama u potrazi za biljem, ali treba biti oprezan. Šuma krije i opasnosti.",
        "5c108a014bf1f83adb06": "Želim pogledati vašu robu.",
        "8194ba020f6848ea77f0": "Podučite me."
