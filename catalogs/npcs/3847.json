    "ptBR": {
      "dialogue": {
        "53bdee97d4cb12a75136": "A Floresta Gris é uma floresta exuberante, cheia de vida. É um prazer caminhar por suas trilhas secretas em busca de ervas, mas é preciso ter cuidado. A floresta também abriga perigos.",
        "5c108a014bf1f83adb06": "Quero ver suas mercadorias.",
        "8194ba020f6848ea77f0": "Treine-me."
      },
