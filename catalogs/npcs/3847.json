    "ltLT": {
      "dialogue": {
        "53bdee97d4cb12a75136": "Ashenvale yra vešlus, gyvybės kupinas miškas. Malonu vaikščioti slaptais jo takais ieškant žolelių, bet reikia būti atsargiems. Miške tyko pavojai.",
        "5c108a014bf1f83adb06": "Noriu apžiūrėti tavo prekes.",
        "8194ba020f6848ea77f0": "Išmokyk mane."
