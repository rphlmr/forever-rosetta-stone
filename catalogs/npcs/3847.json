    "daDK": {
      "dialogue": {
        "53bdee97d4cb12a75136": "Ashenvale er en frodig skov, der vrimler med liv. Det er en fornøjelse at vandre ad dens hemmelige stier på jagt efter urter, men man må passe på. Skoven er ikke uden farer.",
        "5c108a014bf1f83adb06": "Jeg vil gerne se dine varer.",
        "8194ba020f6848ea77f0": "Træn mig."
      },
      "name": "Orendil Broadleaf",
