    "ltLT": {
      "dialogue": {
        "6d378cbf66b64afd8266": "Silithus turime ne vieną priešą, $N.$B$BKai visų dėmesys sutelktas į silitidus, mudu su vyresniuoju broliu atidžiai stebime Twilight's Hammer bepročius.\n\n"
      },
      "name": "Bor Wildmane",
