    "plPL": {
      "dialogue": {
        "6d378cbf66b64afd8266": "W Silithus mamy więcej niż jednego wroga, $N.$B$BKiedy wszyscy skupiają uwagę na silithidach, mój starszy brat i ja bacznie obserwujemy szaleńców z Młota Zmierzchu.\n\n"
      },
      "name": "Bor Wildmane",
      "translationMetadata": {
        "fields": {
