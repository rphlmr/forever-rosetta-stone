    "hrHR": {
      "dialogue": {
        "6d378cbf66b64afd8266": "U Silithusu imamo više od jednog neprijatelja, $N.$B$BDok su svi usredotočeni na silithide, moj stariji brat i ja pomno pratimo luđake iz Twilight's Hammera.\n\n"
      },
      "name": "Bor Wildmane",
      "translationMetadata": {
