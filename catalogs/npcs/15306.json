    "svSE": {
      "dialogue": {
        "6d378cbf66b64afd8266": "Vi har mer än en fiende i Silithus, $N.$B$BMedan alla fokuserar på silithiderna har min storebror och jag hållit noga uppsikt över galningarna i Twilight's Hammer.\n\n"
      },
      "name": "Bor Wildmane",
      "translationMetadata": {
