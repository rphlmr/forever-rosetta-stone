  "locales": {
    "csCZ": {
      "dialogue": {
        "6d378cbf66b64afd8266": "V Silithu máme víc než jednoho nepřítele, $N.$B$BZatímco se všichni soustředí na silithidy, můj starší bratr a já bedlivě sledujeme šílence z Kladiva soumraku.\n\n"
      },
      "name": "Bor Wildmane",
      "translationMetadata": {
        "fields": {
