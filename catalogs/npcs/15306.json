    },
    "trTR": {
      "dialogue": {
        "6d378cbf66b64afd8266": "Silithus'ta birden fazla düşmanımız var, $N.$B$BHerkes silithidlere odaklanmışken ağabeyimle ben Twilight's Hammer delilerini yakından izliyoruz.\n\n"
      },
      "name": "Bor Wildmane",
      "translationMetadata": {
