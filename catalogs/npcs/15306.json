    },
    "daDK": {
      "dialogue": {
        "6d378cbf66b64afd8266": "Vi har mere end én fjende i Silithus, $N.$B$BMens alle fokuserer på silithiderne, har min storebror og jeg holdt nøje øje med tosserne fra Twilight's Hammer.\n\n"
      },
      "name": "Bor Wildmane",
      "translationMetadata": {
        "fields": {
          "dialogue.6d378cbf66b64afd8266": {
