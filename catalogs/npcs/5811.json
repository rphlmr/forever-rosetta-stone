  "locales": {
    "csCZ": {
      "dialogue": {
        "68a97954f7886b1a36b3": "Už tě nemám co naučit. Chceš-li se dále zdokonalit v kožedělnictví, promluv si s Karolkem.",
        "751156140b580fec20a3": "Vycvičte mě.",
        "8f40a8a33fbe29368c4e": "Škoda, že nemůžeme stahovat lidi a jejich spojence z kůže. Všechna ta kůže přijde nazmar. Ale kdo by chtěl nosit tu chatrnou useň, která by z ní vznikla?",
        "e18f235c7c96638230d9": "Líbí se ti ta předložka? Tu bestii jsem zabil a stáhl sám. Kéž by všichni kentauři padli tak snadno."
      },
      "name": "Kamari",
      "translationMetadata": {
        "fields": {
          "dialogue.68a97954f7886b1a36b3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.751156140b580fec20a3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.8f40a8a33fbe29368c4e": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.e18f235c7c96638230d9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "name": {
            "origin": "community",
            "source": "questie",
            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "68a97954f7886b1a36b3": "Jeg har ikke mere at lære dig. Tal med Karolek, hvis du vil forbedre dine læderarbejdsevner.",
        "751156140b580fec20a3": "Træn mig.",
        "8f40a8a33fbe29368c4e": "Synd, at vi ikke kan flå menneskerne og deres allierede. Al den hud går til spilde. Men hvem ville dog gå med det tynde læder, man kunne lave af den?",
        "e18f235c7c96638230d9": "Kan du lide tæppet? Jeg dræbte og flåede selv bæstet. Gid alle kentaurer må falde lige så let."
      },
      "name": "Kamari",
      "translationMetadata": {
        "fields": {
          "dialogue.68a97954f7886b1a36b3": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
          "dialogue.751156140b580fec20a3": {
