    "enUS": {
      "dialogue": {
        "68a97954f7886b1a36b3": "I have nothing more to teach you. Talk to Karolek if you wish to further your leatherworking skills.",
        "751156140b580fec20a3": "Train me.",
        "8f40a8a33fbe29368c4e": "Too bad we can't skin the humans and their allies. All that skin is just going to waste. Still, who'd want to wear the flimsy leather you could make out of it?",
        "e18f235c7c96638230d9": "You like the rug? I killed and skinned the beast myself. May all the centaur fall as easily."
      },
      "name": "Kamari",
      "subName": "Journeyman Leatherworker",
      "translationMetadata": {
        "fields": {
