    "trTR": {
      "dialogue": {
        "703aece056f79feba444": "Kadim Ragetotem günlerini Tanaris Çölü’ndeki Gözcüler Vadisi’nde geçiriyor.",
        "872f16b0bc4cf0f020f9": "Thousand Needles’taki Freewind Post’a git, Kadim Skyseer’ı bulursun.",
        "8d10f408751b33dd809f": "Anlayamadığım sebeplerden Kadim Thunderhorn, Un’Goro Krateri’ndeki Slithering Scar’a gitti.",
        "b93d30beae14d6c04dd4": "Eskiden av için yaşardık. Şan ve şeref için avlanırdık...$B$BŞimdi çok mu farklı?",
        "ba8b2694b9916b369346": "Tanaris Çölü’ndeki Zul’Farrak, Kadim Wildmane’in evidir."
      },
      "name": "Ulu Dreamseer",
