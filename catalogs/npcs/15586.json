    "svSE": {
      "dialogue": {
        "703aece056f79feba444": "Äldste Ragetotem tillbringar dagarna i Watchers dal i Tanarisöknen.",
        "872f16b0bc4cf0f020f9": "Gå till Freewind Post i Thousand Needles så hittar du äldste Skyseer.",
        "8d10f408751b33dd809f": "Av skäl jag inte förstår har äldste Thunderhorn begett sig till Slithering Scar i Un’Gorokratern.",
        "b93d30beae14d6c04dd4": "För länge sedan levde vi för jakten. Vi jagade för ära och berömmelse...$B$BÄr det så annorlunda nu?",
        "ba8b2694b9916b369346": "Zul’Farrak i Tanarisöknen är äldste Wildmanes hem."
      },
      "name": "Äldste Dreamseer",
