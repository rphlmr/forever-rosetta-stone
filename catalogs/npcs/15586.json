    "daDK": {
      "dialogue": {
        "703aece056f79feba444": "Ældste Ragetotem tilbringer sine dage i Watchers-dalen i Tanarisørkenen.",
        "872f16b0bc4cf0f020f9": "Tag til Freewind Post i Thousand Needles, så finder du ældste Skyseer.",
        "8d10f408751b33dd809f": "Af grunde, jeg ikke forstår, er ældste Thunderhorn rejst til Slithering Scar i Un’Goro-krateret.",
        "b93d30beae14d6c04dd4": "For længe siden levede vi for jagten. Vi jagede for ære og berømmelse...$B$BEr det så anderledes nu?",
        "ba8b2694b9916b369346": "Zul’Farrak i Tanarisørkenen er ældste Wildmanes hjem."
      },
      "name": "Ældste Dreamseer",
      "translationMetadata": {
        "fields": {
