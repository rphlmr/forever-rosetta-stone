  "locales": {
    "csCZ": {
      "dialogue": {
        "703aece056f79feba444": "Starší Ragetotem tráví dny v Údolí Strážců v poušti Tanaris.",
        "872f16b0bc4cf0f020f9": "Jdi na Freewind Post v Thousand Needles a najdeš staršího Skyseera.",
        "8d10f408751b33dd809f": "Z důvodů, které nechápu, odešel starší Thunderhorn do Slithering Scar v kráteru Un’Goro.",
        "b93d30beae14d6c04dd4": "Za dávných časů jsme žili pro lov. Lovili jsme pro slávu a čest...$B$BJe to dnes tak jiné?",
        "ba8b2694b9916b369346": "Domovem starší Wildmane je Zul’Farrak v poušti Tanaris."
      },
      "name": "Starší Dreamseer",
      "translationMetadata": {
