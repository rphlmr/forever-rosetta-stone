    "plPL": {
      "dialogue": {
        "703aece056f79feba444": "Starsza Ragetotem spędza dni w Dolinie Strażników na pustyni Tanaris.",
        "872f16b0bc4cf0f020f9": "Udaj się do Freewind Post w Thousand Needles, a znajdziesz starszego Skyseera.",
        "8d10f408751b33dd809f": "Z nieznanych mi powodów starszy Thunderhorn udał się do Slithering Scar w kraterze Un’Goro.",
        "b93d30beae14d6c04dd4": "Dawno temu żyliśmy dla polowania. Polowaliśmy dla chwały i honoru...$B$BCzy teraz jest tak inaczej?",
        "ba8b2694b9916b369346": "Domem starszej Wildmane jest Zul’Farrak na pustyni Tanaris."
      },
      "name": "Starszy Dreamseer",
