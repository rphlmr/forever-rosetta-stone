    "ltLT": {
      "dialogue": {
        "703aece056f79feba444": "Vyresnioji Ragetotem leidžia dienas Valley of the Watchers slėnyje, Tanaris dykumoje.",
        "872f16b0bc4cf0f020f9": "Nukeliauk į Freewind Post, Thousand Needles krašte, ir rasi vyresnįjį Skyseer.",
        "8d10f408751b33dd809f": "Dėl man nesuprantamų priežasčių vyresnysis Thunderhorn iškeliavo į Slithering Scar, Un'Goro krateryje.",
        "b93d30beae14d6c04dd4": "Seniai seniai gyvenome medžiokle. Medžiojome dėl šlovės, dėl garbės...$B$BAr dabar taip jau kitaip?",
        "ba8b2694b9916b369346": "Vyresniojo Wildmane namai yra Zul'Farrak, Tanaris dykumoje."
      },
      "name": "Vyresnysis Dreamseer",
