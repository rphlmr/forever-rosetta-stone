    "enUS": {
      "dialogue": {
        "703aece056f79feba444": "Elder Ragetotem spends her days at the Valley of the Watchers in Tanaris Desert.",
        "872f16b0bc4cf0f020f9": "Go to the Freewind Post in Thousand Needles and you will find Elder Skyseer.",
        "8d10f408751b33dd809f": "For reasons I cannot understand, Elder Thunderhorn has gone to the Slithering Scar in Un'Goro Crater.",
        "b93d30beae14d6c04dd4": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "ba8b2694b9916b369346": "Zul'Farrak in Tanaris Desert is Elder Wildmane's home."
      },
      "name": "Elder Dreamseer",
      "translationMetadata": {
