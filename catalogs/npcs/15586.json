    "hrHR": {
      "dialogue": {
        "703aece056f79feba444": "Starješina Ragetotem provodi dane u Dolini stražara u pustinji Tanaris.",
        "872f16b0bc4cf0f020f9": "Idi u Freewind Post u Thousand Needlesu i pronaći ćeš starješinu Skyseera.",
        "8d10f408751b33dd809f": "Iz meni nepoznatih razloga starješina Thunderhorn otišao je u Slithering Scar u krateru Un’Goro.",
        "b93d30beae14d6c04dd4": "U davna vremena živjeli smo za lov. Lovili smo za slavu, za čast...$B$BJe li danas toliko drukčije?",
        "ba8b2694b9916b369346": "Zul’Farrak u pustinji Tanaris dom je starješine Wildmane."
      },
      "name": "Starješina Dreamseer",
