    "plPL": {
      "dialogue": {
        "66529c51cbfca1a6843e": "Dawno temu żyliśmy dla łowów. Polowaliśmy dla chwały, dla honoru...$B$BCzy teraz jest tak inaczej?",
        "9f57ef5908dc0b8d57ea": "Elder Rumblerock spędza lata w jaskini na szczycie Dreadmaul Rock w Burning Steppes."
      },
      "name": "Starszy Dawnstrider",
