    "enUS": {
      "dialogue": {
        "66529c51cbfca1a6843e": "In days long past, we lived for the hunt.  We hunted for glory, for honor...$B$BIs it so different now?",
        "9f57ef5908dc0b8d57ea": "Elder Rumblerock passes the years in a cave atop Dreadmaul Rock in the Burning Steppes."
      },
      "name": "Elder Dawnstrider",
