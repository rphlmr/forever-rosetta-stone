    "enUS": {
      "dialogue": {
        "5d19e043fbd9551099f6": "Only the renowned Doctor Gregory Victor can improve your skill now.  He can be found in Arathi Highlands at Hammerfall.",
        "6938c66b5ac58b06c446": "Balai Lok'Wein of Brackenwall Village in Dustwallow Marsh sells a manual that you will need to study in order to improve your skills!",
        "b26794f9283fae550f4a": "I can train you in First Aid techniques.",
        "c9de23f78f80d549efe0": "Train me."
      },
      "name": "Rawrk",
      "subName": "First Aid Trainer",
      "translationMetadata": {
