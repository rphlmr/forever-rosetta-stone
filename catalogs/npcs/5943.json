    "plPL": {
      "dialogue": {
        "5d19e043fbd9551099f6": "Tylko słynny doktor Gregory Victor może teraz rozwinąć twoje umiejętności. Znajdziesz go w Hammerfall w Arathi Highlands.",
        "6938c66b5ac58b06c446": "Balai Lok’Wein z Brackenwall Village w Dustwallow Marsh sprzedaje podręcznik, który musisz przestudiować, by rozwinąć swoje umiejętności!",
        "b26794f9283fae550f4a": "Mogę nauczyć cię udzielania pierwszej pomocy.",
        "c9de23f78f80d549efe0": "Wyszkol mnie."
      },
