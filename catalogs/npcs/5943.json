  "locales": {
    "csCZ": {
      "dialogue": {
        "5d19e043fbd9551099f6": "Tvé dovednosti nyní může zlepšit jen proslulý doktor Gregory Victor. Najdeš ho v Hammerfall v Arathi Highlands.",
        "6938c66b5ac58b06c446": "Balai Lok’Wein z Brackenwall Village v Dustwallow Marsh prodává příručku, kterou si musíš prostudovat, abys zlepšil své dovednosti!",
        "b26794f9283fae550f4a": "Mohu tě naučit techniky první pomoci.",
        "c9de23f78f80d549efe0": "Vycvičte mě."
      },
      "name": "Rawrk",
      "translationMetadata": {
