    "svSE": {
      "dialogue": {
        "5d19e043fbd9551099f6": "Bara den berömde doktor Gregory Victor kan förbättra din skicklighet nu. Du hittar honom i Hammerfall i Arathi Highlands.",
        "6938c66b5ac58b06c446": "Balai Lok’Wein i Brackenwall Village i Dustwallow Marsh säljer en handbok som du måste studera för att förbättra dina färdigheter!",
        "b26794f9283fae550f4a": "Jag kan lära dig första hjälpen.",
        "c9de23f78f80d549efe0": "Träna mig."
      },
      "name": "Rawrk",
