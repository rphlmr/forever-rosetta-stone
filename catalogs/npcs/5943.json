    "hrHR": {
      "dialogue": {
        "5d19e043fbd9551099f6": "Sada samo slavni doktor Gregory Victor može unaprijediti tvoju vještinu. Naći ćeš ga u Hammerfallu u Arathi Highlandsu.",
        "6938c66b5ac58b06c446": "Balai Lok’Wein iz Brackenwall Villagea u Dustwallow Marshu prodaje priručnik koji moraš proučiti kako bi unaprijedio svoje vještine!",
        "b26794f9283fae550f4a": "Mogu te podučiti tehnikama prve pomoći.",
        "c9de23f78f80d549efe0": "Podučite me."
      },
      "name": "Rawrk",
