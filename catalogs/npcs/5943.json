    "daDK": {
      "dialogue": {
        "5d19e043fbd9551099f6": "Kun den berømte doktor Gregory Victor kan forbedre dine færdigheder nu. Du finder ham i Hammerfall i Arathi Highlands.",
        "6938c66b5ac58b06c446": "Balai Lok’Wein i Brackenwall Village i Dustwallow Marsh sælger en håndbog, du skal studere for at forbedre dine færdigheder!",
        "b26794f9283fae550f4a": "Jeg kan lære dig førstehjælpsteknikker.",
        "c9de23f78f80d549efe0": "Træn mig."
      },
      "name": "Rawrk",
