    "daDK": {
      "dialogue": {
        "3c338663533c5526513e": "Slaget om Warsong-kløften er et slag, vi ikke må tabe. Vi kæmper for vores ære og vores land, og ingen ork eller vildledt allieret skal tage dem fra os!"
      },
      "name": "Vagtpost Farsong",
