    },
    "svSE": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Jag klarar mig tills vidare, oroa dig inte för mig. Jag hittar en väg ut när jag har utfört några reningsritualer i det här rummet. Ondskefull magi fördärvar denna plats, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
