    "hrHR": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Bit ću dobro zasad, ne brini za mene. Pronaći ću izlaz nakon što obavim nekoliko obreda pročišćenja u ovoj prostoriji. Ovo mjesto je okaljano podlom magijom, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
