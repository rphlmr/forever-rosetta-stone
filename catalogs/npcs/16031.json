    },
    "ptBR": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Eu vou ficar bem, não se preocupe comigo. Vou encontrar uma saída assim que eu terminar uns rituais de purificação aqui nesta sala. Há magia maligna aqui, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
