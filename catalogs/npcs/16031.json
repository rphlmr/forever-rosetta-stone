  "locales": {
    "csCZ": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Zatím budu v pořádku, neboj se o mě. Až v této místnosti provedu několik očistných rituálů, najdu cestu ven. Toto místo je poskvrněné odpornou magií, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
        "fields": {
          "dialogue.89ffe69e2d85ce30baa4": {
