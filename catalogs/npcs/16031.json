    },
    "daDK": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Jeg klarer mig indtil videre, du skal ikke bekymre dig om mig. Jeg finder en vej ud, når jeg har udført nogle renselsesritualer i dette rum. Ond magi besudler dette sted, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
        "fields": {
          "dialogue.89ffe69e2d85ce30baa4": {
