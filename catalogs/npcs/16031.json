    },
    "enUS": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "I'll be fine for now, don't worry about me.  I'll find a way out of here once I've performed some cleansing rituals in this room.  Foul magic taints this place, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
        "fields": {
          "dialogue.89ffe69e2d85ce30baa4": {
            "origin": "community",
            "source": "Spoken",
