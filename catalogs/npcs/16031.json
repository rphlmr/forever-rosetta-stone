    },
    "plPL": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Na razie nic mi nie będzie, nie martw się o mnie. Znajdę wyjście, gdy odprawię w tej komnacie kilka rytuałów oczyszczenia. Plugawa magia skaziła to miejsce, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
        "fields": {
