    },
    "esES": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Estaré bien, no te preocupes por mí. Saldré de aquí cuando haya realizado algunos rituales de purificación en esta habitación. Este lugar está contaminado con magia negativa, $n."
      },
      "name": "Ysida Harmon",
