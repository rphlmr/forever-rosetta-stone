    "trTR": {
      "dialogue": {
        "89ffe69e2d85ce30baa4": "Şimdilik iyi olacağım, benim için endişelenme. Bu odada birkaç arınma ritüeli gerçekleştirdikten sonra buradan çıkmanın bir yolunu bulacağım. Bu yere uğursuz bir büyü sinmiş, $n."
      },
      "name": "Ysida Harmon",
      "translationMetadata": {
