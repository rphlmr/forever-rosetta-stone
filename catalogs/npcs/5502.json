    "ptBR": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Treine-me.",
        "b6ab5ff7ea9578bb247f": "Outro Herborista, hmm. Duvido que sua habilidade seja tão grande quanto a minha, então, talvez, eu possa lhe ensinar algumas técnicas adequadas.",
        "bf39d8236e320ea5c526": "Espero que você tenha me interrompido por um bom motivo. Estava no meio de um trabalho importante."
      },
      "name": "Shylamiir",
      "subName": "Treinamento de Herborismo",
