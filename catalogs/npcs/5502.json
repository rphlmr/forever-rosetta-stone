  "locales": {
    "csCZ": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Vycvičte mě.",
        "b6ab5ff7ea9578bb247f": "Další bylinkář, hm. Pochybuji, že se tvé schopnosti vyrovnají mým, takže tě možná mohu naučit pár správných postupů.",
        "bf39d8236e320ea5c526": "Doufám, že mě vyrušuješ z dobrého důvodu. Právě jsem pracoval na něčem důležitém."
      },
      "name": "Shylamiir",
      "translationMetadata": {
        "fields": {
          "dialogue.b626ce88647f8d6140e9": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
