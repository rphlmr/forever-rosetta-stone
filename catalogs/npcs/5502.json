    "enUS": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Train me.",
        "b6ab5ff7ea9578bb247f": "Another Herbalist, hmm. I doubt your skill is as great as my own so perhaps I can train you in a few proper techniques.",
        "bf39d8236e320ea5c526": "I hope that your interruption is for a good cause, I was in the middle of some important work."
      },
      "name": "Shylamiir",
      "subName": "Herbalism Trainer",
