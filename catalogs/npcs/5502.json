    "ltLT": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Pamokyk mane.",
        "b6ab5ff7ea9578bb247f": "Dar vienas žolininkas, hmm. Abejoju, ar tavo įgūdžiai prilygsta maniesiems, tad galėčiau tave pamokyti kelių tinkamų būdų.",
        "bf39d8236e320ea5c526": "Tikiuosi, pertraukei mane dėl svarbios priežasties. Dirbau svarbų darbą."
      },
      "name": "Shylamiir",
      "subName": "Žolininkystės mokytoja",
