    },
    "daDK": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Træn mig.",
        "b6ab5ff7ea9578bb247f": "Endnu en urtekyndig, hmm. Jeg tvivler på, at dine evner er lige så gode som mine, så måske kan jeg lære dig et par ordentlige teknikker.",
        "bf39d8236e320ea5c526": "Jeg håber, du afbryder mig af en god grund. Jeg var midt i noget vigtigt arbejde."
      },
      "name": "Shylamiir",
      "translationMetadata": {
        "fields": {
          "dialogue.b626ce88647f8d6140e9": {
