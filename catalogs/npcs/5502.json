    "plPL": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Wyszkol mnie.",
        "b6ab5ff7ea9578bb247f": "Kolejny zielarz, hm. Wątpię, by twoje umiejętności dorównywały moim, więc może nauczę cię kilku właściwych technik.",
        "bf39d8236e320ea5c526": "Mam nadzieję, że przerywasz mi z ważnego powodu. Byłem w trakcie istotnej pracy."
      },
      "name": "Shylamiir",
