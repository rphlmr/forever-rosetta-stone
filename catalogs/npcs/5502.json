    "hrHR": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Podučite me.",
        "b6ab5ff7ea9578bb247f": "Još jedan travar, hm. Sumnjam da je tvoja vještina ravna mojoj pa te možda mogu naučiti nekoliko pravih tehnika.",
        "bf39d8236e320ea5c526": "Nadam se da me prekidaš s dobrim razlogom. Bio sam usred važnog posla."
      },
      "name": "Shylamiir",
      "translationMetadata": {
