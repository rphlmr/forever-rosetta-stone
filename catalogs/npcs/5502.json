    "itIT": {
      "dialogue": {
        "b626ce88647f8d6140e9": "Addestrami.",
        "b6ab5ff7ea9578bb247f": "Un altro erborista, hmm. Dubito che la tua abilità sia pari alla mia, quindi forse posso insegnarti qualche tecnica adeguata.",
        "bf39d8236e320ea5c526": "Spero che questa interruzione abbia un buon motivo, ero nel bel mezzo di un lavoro importante."
      },
      "name": "Shylamiir",
      "translationMetadata": {
