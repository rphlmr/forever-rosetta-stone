    "csCZ": {
      "dialogue": {
        "34612c20937b0023ccfe": "Je mi líto, $c, ale než přežiješ v Alterackém údolí, potřebuješ více zkušeností.",
        "ef5892ac68b10b47d6fd": "Naše síly v Alterackém údolí potřebují k vítězství moudrost, $c. Vypadáš jako ten pravý, kdo je povede."
      },
      "name": "Taim Ragetotem",
      "translationMetadata": {
