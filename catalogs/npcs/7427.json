    "daDK": {
      "dialogue": {
        "34612c20937b0023ccfe": "Jeg beklager, $c, men du må få mere erfaring, før du kan overleve i Alterac Valley.",
        "ef5892ac68b10b47d6fd": "Vores styrker i Alterac Valley har brug for visdom for at sejre, $c. Du ligner den rette til at lede dem."
      },
      "name": "Taim Ragetotem",
      "translationMetadata": {
