      "dialogue": {
        "34612c20937b0023ccfe": "I am sorry $c, but you need to be more experienced before you can survive in Alterac Valley.",
        "ef5892ac68b10b47d6fd": "Our forces in Alterac Valley need wisdom to achieve victory $c.  You look like the one to lead them."
      },
