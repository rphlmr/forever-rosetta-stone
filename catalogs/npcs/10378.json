    "svSE": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Även om Crossroads verkar vara centrum för allt som händer i Barrens, föredrar jag lugnet i Camp Taurajo. Vart ska jag skicka dig?",
        "aa16fc1aa2e77653e6be": "Jordmoderns vägar är många. Vart du än väljer att resa, må hon vaka över dig.",
        "cec2939ed6b55f40858d": "Behandla vindryttaren väl när den tar dig till ditt mål. Må dina förfäder vaka över dig, $n.",
        "fb494fb2114d1821a949": "Vart kan jag skicka dig i dag, $c?",
        "zephras:98797742440707d71822": "Jag behöver skjuts."
      },
      "name": "Omusa Thunderhorn",
      "translationMetadata": {
