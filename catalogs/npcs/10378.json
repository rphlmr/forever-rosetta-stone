    "ptBR": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Apesar da Encruzilhada ser o centro de atividades dos Sertões, prefiro a calma do Acampamento Taurajo. Aonde você deseja ir?",
        "aa16fc1aa2e77653e6be": "Muitos são os caminhos da Mãe Terra. Não importa onde estiver, que ela vele sempre por você.",
        "cec2939ed6b55f40858d": "Trate bem a mantícora, pois é ela que o leva ao seu destino. Que os seus ancestrais velem por você, $n.",
        "fb494fb2114d1821a949": "Aonde você quer ir hoje, $c?",
        "zephras:98797742440707d71822": "Preciso de transporte."
      },
      "name": "Omusa Chifre Troante",
      "subName": "Mestre de Mantícoras",
