    "daDK": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Selvom Crossroads lader til at være centrum for aktiviteten i Barrens, foretrækker jeg roen i Camp Taurajo. Hvor skal jeg sende dig hen?",
        "aa16fc1aa2e77653e6be": "Jordmoderens veje er mange. Hvor end du vælger at rejse hen, må hun våge over dig.",
        "cec2939ed6b55f40858d": "Behandl vindrytteren godt, mens den fører dig til dit mål. Må dine forfædre våge over dig, $n.",
        "fb494fb2114d1821a949": "Hvor kan jeg sende dig hen i dag, $c?",
        "zephras:98797742440707d71822": "Jeg har brug for et lift."
      },
      "name": "Omusa Thunderhorn",
      "translationMetadata": {
