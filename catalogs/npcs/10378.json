    "deDE": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Obwohl Crossroads das Zentrum aller Aktivität im Brachland ist, ziehe ich die Ruhe von Camp Taurajo vor. Wohin soll ich Euch schicken?",
        "aa16fc1aa2e77653e6be": "Vielfältig sind die Pfade der Erdenmutter. Wohin Ihr auch reisen werdet, möge sie über Euch wachen.",
        "cec2939ed6b55f40858d": "Behandelt den Windreiter gut, während er Euch an Euer Ziel bringt. Mögen Eure Vorfahren über Euch wachen, $n.",
        "fb494fb2114d1821a949": "Wohin kann ich Euch heute schicken, $C?",
        "zephras:98797742440707d71822": "Ich brauche einen Flug."
      },
      "name": "Omusa Thunderhorn",
      "subName": "Windreitermeister",
