    "hrHR": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Premda se čini da je Crossroads središte zbivanja u Barrensu, više volim mir Camp Tauraja. Kamo da te pošaljem?",
        "aa16fc1aa2e77653e6be": "Mnogi su putovi Majke Zemlje. Kamo god odlučiš putovati, neka ona bdije nad tobom.",
        "cec2939ed6b55f40858d": "Dobro postupaj s jahačem vjetra dok te nosi do odredišta. Neka tvoji preci bdiju nad tobom, $n.",
        "fb494fb2114d1821a949": "Kamo te danas mogu poslati, $c?",
        "zephras:98797742440707d71822": "Trebam prijevoz."
      },
      "name": "Omusa Thunderhorn",
      "translationMetadata": {
