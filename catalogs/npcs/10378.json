    "plPL": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Choć Crossroads wydaje się centrum wydarzeń w Barrens, wolę spokój Camp Taurajo. Dokąd mam cię wysłać?",
        "aa16fc1aa2e77653e6be": "Wiele jest ścieżek Matki Ziemi. Dokądkolwiek wyruszysz, niech nad tobą czuwa.",
        "cec2939ed6b55f40858d": "Dobrze traktuj wiatrowego jeźdźca, który zabierze cię do celu. Niech przodkowie nad tobą czuwają, $n.",
        "fb494fb2114d1821a949": "Dokąd mogę cię dziś wysłać, $c?",
        "zephras:98797742440707d71822": "Potrzebuję transportu."
      },
      "name": "Omusa Thunderhorn",
