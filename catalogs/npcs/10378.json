  "locales": {
    "csCZ": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Ačkoli se zdá, že Crossroads je centrem dění v Barrens, dávám přednost klidu Camp Taurajo. Kam tě mám poslat?",
        "aa16fc1aa2e77653e6be": "Cest Matky Země je mnoho. Ať se rozhodneš cestovat kamkoli, kéž nad tebou bdí.",
        "cec2939ed6b55f40858d": "Chovej se k větrnému jezdci dobře, až tě ponese do cíle. Kéž nad tebou bdí tvoji předkové, $n.",
        "fb494fb2114d1821a949": "Kam tě dnes mohu poslat, $c?",
        "zephras:98797742440707d71822": "Potřebuji odvoz."
      },
      "name": "Omusa Thunderhorn",
      "translationMetadata": {
        "fields": {
          "dialogue.37b2df98bd9db06c9279": {
