    "trTR": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Crossroads, Barrens’taki hareketliliğin merkezi gibi görünse de ben Camp Taurajo’nun sessizliğini tercih ederim. Seni nereye göndereyim?",
        "aa16fc1aa2e77653e6be": "Toprak Ana’nın yolları çoktur. Nereye gitmeyi seçersen seç, o seni gözetsin.",
        "cec2939ed6b55f40858d": "Seni gideceğin yere taşırken rüzgâr binicisine iyi davran. Ataların seni gözetsin, $n.",
        "fb494fb2114d1821a949": "Bugün seni nereye gönderebilirim, $c?",
        "zephras:98797742440707d71822": "Bir yere gitmem gerekiyor."
      },
      "name": "Omusa Thunderhorn",
      "translationMetadata": {
