    "esES": {
      "dialogue": {
        "37b2df98bd9db06c9279": "El Cruce parece ser el centro de actividad de Los Baldíos, yo prefiero la tranquilidad del Campamento Taurajo. ¿Dónde te voy a mandar?",
        "aa16fc1aa2e77653e6be": "Muchos son los caminos de la Madre Tierra. Decidas donde decidas ir, que ella te proteja.",
        "cec2939ed6b55f40858d": "Trata bien al jinete del viento, ya que te lleva a tu destino. Que tus ancestros te protejan, $n.",
        "fb494fb2114d1821a949": "¿Dónde te puedo mandar hoy, $c?",
        "zephras:98797742440707d71822": "¡Necesito un transporte!"
      },
      "name": "Omusa Tronacuerno",
      "subName": "Maestro de jinete del viento",
