    "ltLT": {
      "dialogue": {
        "37b2df98bd9db06c9279": "Nors atrodo, kad Crossroads yra viso The Barrens veiksmo centras, man labiau patinka Camp Taurajo ramybė. Kur tave nuskraidinti?",
        "aa16fc1aa2e77653e6be": "Žemės Motinos keliai nesuskaičiuojami. Kad ir kur nuspręstum keliauti, tegu ji tave globoja.",
        "cec2939ed6b55f40858d": "Gerai elkis su vėjo raiteliu, kuris nuskraidins tave į paskirties vietą. Tegu protėviai tave globoja, $n.",
        "fb494fb2114d1821a949": "Kur šiandien tave nuskraidinti, $c?",
        "zephras:98797742440707d71822": "Man reikia skrydžio."
      },
      "name": "Omusa Thunderhorn",
      "subName": "Vėjo raitelių meistrė",
