  "locales": {
    "csCZ": {
      "dialogue": {
        "1aaae700fd5137b92abf": "Nemůžu ti pomoct. O lektvarech víš víc než já. Navíc musím hlídat hrnce. Promluv si tamhle s Yelmakem. Ten toho o lektvarech ví hodně.",
        "bbba7793f39d52e87670": "Ve všech lahvích na stole jsou lektvary, které jsem dnes uvařil. A prý hlídaný hrnec nikdy nevře. Ha!",
        "dc3a6ed69a22277bae75": "Vycvičte mě.",
        "fb33e5054104bde8b784": "Říkali mi hlupák, ale já jim ukážu. Budu hlídat každý svůj hrnec a dokážu, že se v nich stejně může vařit. Jo, daří se mi! Kdo je teď hlupák, co? Co?!"
      },
      "name": "Whuut",
      "translationMetadata": {
        "fields": {
          "dialogue.1aaae700fd5137b92abf": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
