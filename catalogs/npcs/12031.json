          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Ich sollte mir einen Gehilfen suchen; ich mag es gar nicht, den ganzen Tag nur hier zu sitzen und Angelbedarf zu verkaufen. Ich würde viel lieber angeln gehen und anschließend Angelbedarf verkaufen.",
        "8074b36701ea4d0402ff": "Ich möchte Eure Waren ansehen."
      },
      "name": "Mail'Lahii",
      "subName": "Angelbedarf",
      "translationMetadata": {
