  "locales": {
    "csCZ": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Měl bych si najmout pomoc; nebaví mě tu celý den sedět a prodávat rybářské potřeby. Mnohem raději bych šel rybařit a potřeby prodával až potom.",
        "8074b36701ea4d0402ff": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
        "fields": {
