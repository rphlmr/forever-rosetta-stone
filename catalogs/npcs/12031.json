    },
    "ptBR": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Tenho que procurar ajuda. Não gosto de ficar sentada aqui o dia todo vendendo suprimentos de pescaria. Eu preferia ir pescar e depois vender os suprimentos.",
        "8074b36701ea4d0402ff": "Quero ver suas mercadorias."
      },
      "name": "Mai'Lahii",
      "subName": "Suprimentos de Pesca",
      "translationMetadata": {
