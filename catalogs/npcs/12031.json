    },
    "svSE": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Jag borde anställa någon; jag gillar inte att sitta här hela dagen och sälja fiskeutrustning. Jag skulle mycket hellre fiska och sedan sälja utrustning.",
        "8074b36701ea4d0402ff": "Jag vill se dina varor."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
