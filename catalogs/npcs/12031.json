    },
    "itIT": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Dovrei assumere qualcuno che mi aiuti; non mi piace starmene seduta qui tutto il giorno a vendere articoli da pesca. Preferirei di gran lunga andare a pescare, e poi vendere gli articoli.",
        "8074b36701ea4d0402ff": "Vorrei vedere la tua merce."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
