    "esES": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Debería contratar a alguien para que me ayude, no me gusta estar aquí sentada todo el día, vendiendo material de pesca. Me gusta mucho más ir a pescar, y luego, vender.",
        "8074b36701ea4d0402ff": "Quiero ver tus mercancías."
      },
      "name": "Mai'Lahii",
      "subName": "Suministros de pesca",
