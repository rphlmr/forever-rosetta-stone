    "plPL": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Powinienem zatrudnić pomocnika; nie lubię siedzieć tu przez cały dzień i sprzedawać sprzętu wędkarskiego. Wolałbym pójść na ryby, a dopiero potem sprzedawać sprzęt.",
        "8074b36701ea4d0402ff": "Chcę przejrzeć twoje towary."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
        "fields": {
          "dialogue.43a70f67730d9c0f9d2b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
