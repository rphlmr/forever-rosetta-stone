    "hrHR": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Trebao bih unajmiti pomoć; ne volim cijeli dan sjediti ovdje i prodavati ribolovni pribor. Radije bih otišao pecati, a onda prodavao pribor.",
        "8074b36701ea4d0402ff": "Želim pogledati vašu robu."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
