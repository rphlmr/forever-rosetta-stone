    },
    "daDK": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Jeg burde ansætte hjælp; jeg bryder mig ikke om at sidde her hele dagen og sælge fiskeudstyr. Jeg ville langt hellere fiske og så sælge udstyr bagefter.",
        "8074b36701ea4d0402ff": "Jeg vil gerne se dine varer."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
        "fields": {
          "dialogue.43a70f67730d9c0f9d2b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
