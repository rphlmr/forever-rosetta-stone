          }
        }
      }
    },
    "zhCN": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "我应该寻求某些帮助；我不喜欢整天坐在这儿卖鱼。我更愿意去钓鱼，然后再卖掉。",
        "8074b36701ea4d0402ff": "我想看看你的货物。"
      },
      "name": "麦拉斯",
      "subName": "渔具供应商",
