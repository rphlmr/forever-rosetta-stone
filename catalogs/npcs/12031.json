    "enUS": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "I should find some hired help; I don't like sitting here all day selling fish supplies. I'd much rather go fishing, and then sell supplies.",
        "8074b36701ea4d0402ff": "I want to browse your goods."
      },
      "name": "Mai'Lahii",
      "subName": "Fishing Supplies",
      "translationMetadata": {
        "fields": {
