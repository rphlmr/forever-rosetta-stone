    },
    "trTR": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Bir yardımcı tutmalıyım; bütün gün burada oturup balıkçılık malzemesi satmayı sevmiyorum. Balığa gidip malzemeleri sonra satmayı çok daha fazla isterdim.",
        "8074b36701ea4d0402ff": "Mallarına bakmak istiyorum."
      },
      "name": "Mai'Lahii",
      "translationMetadata": {
        "fields": {
          "dialogue.43a70f67730d9c0f9d2b": {
