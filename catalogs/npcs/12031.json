    "frFR": {
      "dialogue": {
        "43a70f67730d9c0f9d2b": "Il nous faudrait engager de l'aide. Je n'aime pas rester là toute la journée à vendre des accessoires de pêche. Je préférerais aller à la pêche moi-même, puis m'occuper de mon étal.",
        "8074b36701ea4d0402ff": "Je voudrais regarder vos articles."
      },
      "name": "Mai'Lahii",
      "subName": "Fournitures de pêche",
