    "hrHR": {
      "dialogue": {
        "5a19a690bc5e85a237e2": "Podučite me.",
        "67da9c20561c4c02b32e": "Bojim se da ti treba još obuke prije nego što s tobom podijelim svoje znanje. ",
        "8a6efdc1aba40ada9b6a": "Znam samo jednu osobu koja o krojačkom umijeću zna više od mene. Zadnje što sam čuo, mogao se naći na Theramore Isleu. Njega bi trebao potražiti.",
        "c423234a9ee14017d5fd": "Dobro! Vidim da moj trud neće biti uzaludan!",
        "ce03243ed8b7f755082c": "Da, već neko vrijeme vodim ovu trgovinu. Posao je u posljednje vrijeme prilično dobar. Prolazi mnogo novih pustolova..."
      },
      "name": "Georgio Bolero",
      "translationMetadata": {
