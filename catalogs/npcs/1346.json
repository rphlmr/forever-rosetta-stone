  "locales": {
    "csCZ": {
      "dialogue": {
        "5a19a690bc5e85a237e2": "Vycvičte mě.",
        "67da9c20561c4c02b32e": "Obávám se, že potřebuješ více výcviku, než se s tebou mohu podělit o své znalosti. ",
        "8a6efdc1aba40ada9b6a": "Znám jen jednoho člověka, který se v krejčovském umění vyzná lépe než já. Naposledy jsem slyšel, že je na Theramore Isle. Právě jeho bys měl vyhledat.",
        "c423234a9ee14017d5fd": "Dobře! Vidím, že mé úsilí nepřijde nazmar!",
        "ce03243ed8b7f755082c": "Ano, tento obchod vedu už nějakou dobu. Poslední dobou se daří docela dobře. Prochází tudy spousta nových dobrodruhů..."
      },
      "name": "Georgio Bolero",
      "translationMetadata": {
        "fields": {
          "dialogue.5a19a690bc5e85a237e2": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
