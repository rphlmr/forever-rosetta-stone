    "daDK": {
      "dialogue": {
        "5a19a690bc5e85a237e2": "Træn mig.",
        "67da9c20561c4c02b32e": "Du har brug for mere træning, før jeg kan dele min viden med dig, er jeg bange for. ",
        "8a6efdc1aba40ada9b6a": "Jeg kender kun én, der er mere lærd i skrædderkunsten end jeg. Sidst jeg hørte om ham, var han på Theramore Isle. Det er ham, du bør opsøge.",
        "c423234a9ee14017d5fd": "Godt! Jeg kan se, at min indsats ikke vil være spildt!",
        "ce03243ed8b7f755082c": "Ja, jeg har drevet denne butik i nogen tid nu. Forretningen er gået ret godt på det seneste. Mange nye eventyrere kommer forbi..."
      },
      "name": "Georgio Bolero",
      "translationMetadata": {
        "fields": {
          "dialogue.5a19a690bc5e85a237e2": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
