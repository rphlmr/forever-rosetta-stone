    "enUS": {
      "dialogue": {
        "5a19a690bc5e85a237e2": "Train me.",
        "67da9c20561c4c02b32e": "You'll need more training before I can share my knowledge with you, I'm afraid. ",
        "8a6efdc1aba40ada9b6a": "There's only one person I know of who is more learned in the art of tailoring than myself. Last I heard he could be found in Theramore Isle. He is the person you should seek.",
        "c423234a9ee14017d5fd": "Good! I can tell that my efforts will not be wasted!",
        "ce03243ed8b7f755082c": "Yes, I've been running this shop for some time now. Business has been pretty good lately. A lot of new adventurers coming through..."
      },
      "name": "Georgio Bolero",
      "subName": "Artisan Tailor",
      "translationMetadata": {
