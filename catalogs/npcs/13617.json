    "ltLT": {
      "dialogue": {
        "1219a315dcb566d99d12": "Vietiniai Alterac avinai yra gyvybiškai svarbūs mūsų kavalerijai!",
        "49f40bf7330bc14dde46": "Dar vos keli, ir mūsų arklidės bus pilnos jojamųjų gyvūnų. Perduok jį man, kary. Toliau aš pasirūpinsiu."
      },
      "name": "Stormpike arklininkas",
