    "plPL": {
      "dialogue": {
        "1219a315dcb566d99d12": "Miejscowe barany z Alteracu są niezbędne dla naszej kawalerii!",
        "49f40bf7330bc14dde46": "Jeszcze kilka, a nasze stajnie będą pełne wierzchowców. Oddaj go pod moją opiekę, żołnierzu. Dalej ja się nim zajmę."
      },
      "name": "Stajenny Stormpike",
