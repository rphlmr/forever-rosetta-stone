    "hrHR": {
      "dialogue": {
        "1219a315dcb566d99d12": "Domaći ovnovi Alteraca neophodni su za djelovanje našeg konjaništva!",
        "49f40bf7330bc14dde46": "Još samo nekoliko i naše će staje biti prepune jahaćih životinja. Predaj mi ga, vojniče. Ja ću se dalje pobrinuti za njega."
      },
      "name": "Gospodar staja Stormpikea",
