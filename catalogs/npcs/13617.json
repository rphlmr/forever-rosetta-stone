  "locales": {
    "csCZ": {
      "dialogue": {
        "1219a315dcb566d99d12": "Původní alteračtí berani jsou pro naši jízdu nepostradatelní!",
        "49f40bf7330bc14dde46": "Ještě pár a naše stáje budou přetékat jezdeckými zvířaty. Předej mi ho, vojáku. Dál už se o něj postarám."
      },
      "name": "Mistr stájí Stormpike",
      "translationMetadata": {
        "fields": {
          "dialogue.1219a315dcb566d99d12": {
