          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "1219a315dcb566d99d12": "Alteracs hjemmehørende væddere er afgørende for vores kavaleri!",
        "49f40bf7330bc14dde46": "Bare nogle få mere, så bugner vores stalde af ridedyr. Overlad den til mig, soldat. Jeg tager mig af den herfra."
      },
      "name": "Stormpike-staldmester",
      "translationMetadata": {
        "fields": {
          "dialogue.1219a315dcb566d99d12": {
