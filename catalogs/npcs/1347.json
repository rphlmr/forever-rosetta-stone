    "enUS": {
      "dialogue": {
        "5859178f026a5dc61f7d": "I sell only the finest arcane gear, made by the crafters and mages here in the city of Stormwind.",
        "7936bfa10635c826303d": "Since the fall of Dalaran and the destruction of Quel'Thalas, wares of this sort have been hard to come by. But Lucan Cordell and some of our other Tradesman have been doing a fine job of filling our orders with quality merchandise.",
        "dfd584c965d8b54fd026": "I want to browse your goods."
      },
      "name": "Alexandra Bolero",
      "subName": "Tailoring Supplies",
      "translationMetadata": {
        "fields": {
          "dialogue.5859178f026a5dc61f7d": {
