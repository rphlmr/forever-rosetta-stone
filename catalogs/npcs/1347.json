    "svSE": {
      "dialogue": {
        "5859178f026a5dc61f7d": "Jag säljer bara den finaste arkana utrustningen, tillverkad av hantverkare och magiker här i Stormwind.",
        "7936bfa10635c826303d": "Sedan Dalaran föll och Quel'Thalas förstördes har varor av det här slaget varit svåra att få tag på. Men Lucan Cordell och några av våra andra hantverkare har gjort ett utmärkt jobb med att fylla våra beställningar med kvalitetsvaror.",
        "dfd584c965d8b54fd026": "Jag vill se dina varor."
      },
      "name": "Alexandra Bolero",
      "translationMetadata": {
        "fields": {
          "dialogue.5859178f026a5dc61f7d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
