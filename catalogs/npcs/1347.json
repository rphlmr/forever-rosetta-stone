  "locales": {
    "csCZ": {
      "dialogue": {
        "5859178f026a5dc61f7d": "Prodávám jen to nejlepší magické vybavení, které vyrábějí řemeslníci a mágové zde ve Stormwindu.",
        "7936bfa10635c826303d": "Od pádu Dalaranu a zničení Quel'Thalasu je takové zboží těžké sehnat. Lucan Cordell a někteří další naši řemeslníci však skvěle plní naše objednávky kvalitním zbožím.",
        "dfd584c965d8b54fd026": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Alexandra Bolero",
      "translationMetadata": {
        "fields": {
          "dialogue.5859178f026a5dc61f7d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
