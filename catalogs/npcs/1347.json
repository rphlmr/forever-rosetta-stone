            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "5859178f026a5dc61f7d": "Ich verkaufe nur die beste arkane Ausrüstung, gemacht von den Handwerkern und Magiern hier in Stormwind.",
        "7936bfa10635c826303d": "Seit dem Fall von Dalaran und der Zerstörung von Quel'Thalas sind solche Waren schwer zu bekommen. Aber Lucan Cordell und einige andere unserer Handwerker haben es geschafft, für unsere Bestellungen erstklassige Handelsware zu besorgen.",
        "dfd584c965d8b54fd026": "Ich möchte Eure Waren ansehen."
      },
      "name": "Alexandra Bolero",
      "subName": "Schneiderbedarf",
      "translationMetadata": {
        "fields": {
          "dialogue.5859178f026a5dc61f7d": {
