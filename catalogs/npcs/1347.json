            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "5859178f026a5dc61f7d": "Jeg sælger kun det fineste arkane udstyr, fremstillet af håndværkere og magikere her i Stormwind.",
        "7936bfa10635c826303d": "Siden Dalarans fald og Quel'Thalas' ødelæggelse har varer af denne slags været svære at finde. Men Lucan Cordell og nogle af vores andre håndværkere gør et godt stykke arbejde med at fylde vores ordrer med kvalitetsvarer.",
        "dfd584c965d8b54fd026": "Jeg vil gerne se dine varer."
      },
      "name": "Alexandra Bolero",
      "translationMetadata": {
        "fields": {
          "dialogue.5859178f026a5dc61f7d": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
