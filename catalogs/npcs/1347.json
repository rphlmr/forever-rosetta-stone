    "hrHR": {
      "dialogue": {
        "5859178f026a5dc61f7d": "Prodajem samo najbolju magijsku opremu koju izrađuju obrtnici i magovi ovdje u Stormwindu.",
        "7936bfa10635c826303d": "Od pada Dalarana i uništenja Quel'Thalasa do takve je robe teško doći. Ali Lucan Cordell i neki drugi naši obrtnici odlično ispunjavaju naše narudžbe kvalitetnom robom.",
        "dfd584c965d8b54fd026": "Želim pogledati vašu robu."
      },
      "name": "Alexandra Bolero",
      "translationMetadata": {
