    "ruRU": {
      "dialogue": {
        "5859178f026a5dc61f7d": "Я продаю лучшие чародейские товары, созданные ремесленниками и магами Штормграда.",
        "7936bfa10635c826303d": "С тех пор как пал Даларан и был разрушен Кель'Талас, такие товары встречаются крайне редко. Но Лукан Корделл и еще несколько торговцев все еще могут выполнять наши заказы.",
        "dfd584c965d8b54fd026": "Я хочу посмотреть ваши товары."
      },
      "name": "Александра Болеро",
      "subName": "Товары для портных",
      "translationMetadata": {
        "fields": {
          "dialogue.5859178f026a5dc61f7d": {
            "origin": "community",
            "source": "Spoken",
            "sourceLocale": "ruRU",
