    "ltLT": {
      "dialogue": {
        "36100327dd8b9593a785": "Griežtai permokydamas turėjau priversti daugelį mokinių pamiršti viską, ko jie buvo išmokę, kad galėčiau mokyti juos iš naujo. Kaskart suteikti šią paslaugą darosi vis sunkiau. Todėl kiekvienas permokymas kainuoja vis daugiau. Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "b8fab837165d7d08381c": "Norėčiau pasimokyti.",
        "bd58d1eee732ef3cc13a": "Aš nemokau tokių kaip tu, $c.",
        "d023fe9a219e742588bd": "Sutriuškintoji ranka sugrąžins Ordai buvusią šlovę, nepaisydama karo vado bailumo.",
        "f92b2b725bb10bade929": "Šįryt pasiuntiniai iš Ravenholdt atnešė man šį laišką. Jis skirtas tau, $n."
      },
      "name": "Ormok",
      "subName": "Nenaudėlių mokytojas",
