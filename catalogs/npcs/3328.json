    "hrHR": {
      "dialogue": {
        "36100327dd8b9593a785": "Strogim ponovnim obučavanjem morao sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogao podučavati iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako ponovno obučavanje postaje skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "b8fab837165d7d08381c": "Želim obuku.",
        "bd58d1eee732ef3cc13a": "Ne obučavam tvoju vrstu, $c.",
        "d023fe9a219e742588bd": "Razbijena ruka vratit će Hordi nekadašnju slavu, bez obzira na plašljivost ratnog poglavara.",
        "f92b2b725bb10bade929": "Glasnici iz Ravenholdta jutros su mi dostavili ovo pismo. Adresirano je tebi, $n."
      },
      "name": "Ormok",
      "translationMetadata": {
