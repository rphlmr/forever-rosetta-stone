    "hrHR": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok’Wein iz sela Brackenwall u Dustwallow Marshu prodaje priručnik koji moraš proučiti da bi unaprijedio svoje vještine!",
        "bbfbd7da4e96cfc68f05": "Mogu te naučiti tehnikama prve pomoći.",
        "cc7d63d073d8ef150178": "Samo poznati doktor Gregory Victor sada može unaprijediti tvoju vještinu. Naći ćeš ga u Hammerfallu u visoravni Arathi.",
        "d8d0c672c814f89c949a": "Podučite me."
      },
      "name": "Vira Younghoof",
