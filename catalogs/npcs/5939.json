    "trTR": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Dustwallow Marshdaki Brackenwall Villageda yaşayan Balai Lok’Wein, becerilerini geliştirmek için okuman gereken bir kılavuz satıyor!",
        "bbfbd7da4e96cfc68f05": "Sana ilk yardım tekniklerini öğretebilirim.",
        "cc7d63d073d8ef150178": "Artık becerini yalnızca ünlü Doktor Gregory Victor geliştirebilir. Onu Arathi Highlandsdeki Hammerfallda bulabilirsin.",
        "d8d0c672c814f89c949a": "Beni eğit."
      },
