  "locales": {
    "csCZ": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok’Wein z vesnice Brackenwall v Dustwallow Marsh prodává příručku, kterou musíš prostudovat, aby ses zlepšil!",
        "bbfbd7da4e96cfc68f05": "Mohu tě naučit techniky první pomoci.",
        "cc7d63d073d8ef150178": "Teď už může tvé dovednosti zlepšit jen proslulý doktor Gregory Victor. Najdeš ho v Hammerfall v Arathijské vysočině.",
        "d8d0c672c814f89c949a": "Vycvičte mě."
      },
      "name": "Vira Younghoof",
      "translationMetadata": {
