    "deDE": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok'Wein aus Brackenwall in den Marschen von Dustwallow verkauft ein Buch, das Ihr studieren solltet, um Eure Fähigkeiten zu verbessern!",
        "bbfbd7da4e96cfc68f05": "Ich kann Euch in Techniken der Ersten Hilfe unterweisen.",
        "cc7d63d073d8ef150178": "Einzig der berühmte Doktor Gregory Victor kann Euch jetzt noch helfen, Eure Fertigkeiten zu verbessern. Ihr findet ihn im Arathihochland, in Hammerfall.",
        "d8d0c672c814f89c949a": "Bildet mich aus."
      },
      "name": "Vira Younghoof",
      "subName": "Lehrerin für Erste Hilfe",
