    "svSE": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok’Wein i Brackenwall Village i Dustwallow Marsh säljer en handbok som du måste studera för att förbättra dina färdigheter!",
        "bbfbd7da4e96cfc68f05": "Jag kan lära dig första hjälpen.",
        "cc7d63d073d8ef150178": "Endast den berömde doktor Gregory Victor kan förbättra din färdighet nu. Han finns i Hammerfall i Arathis högland.",
        "d8d0c672c814f89c949a": "Träna mig."
      },
      "name": "Vira Younghoof",
