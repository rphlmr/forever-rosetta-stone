    "plPL": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok’Wein z Brackenwall Village w Dustwallow Marsh sprzedaje podręcznik, który musisz przestudiować, by rozwinąć swoje umiejętności!",
        "bbfbd7da4e96cfc68f05": "Mogę nauczyć cię technik pierwszej pomocy.",
        "cc7d63d073d8ef150178": "Tylko słynny doktor Gregory Victor może teraz rozwinąć twoje umiejętności. Znajdziesz go w Hammerfall na Wyżynie Arathi.",
        "d8d0c672c814f89c949a": "Wyszkol mnie."
      },
      "name": "Vira Younghoof",
