    "daDK": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok’Wein i Brackenwall Village i Dustwallow Marsh sælger en håndbog, som du skal studere for at forbedre dine færdigheder!",
        "bbfbd7da4e96cfc68f05": "Jeg kan lære dig førstehjælpsteknikker.",
        "cc7d63d073d8ef150178": "Kun den berømte doktor Gregory Victor kan forbedre dine færdigheder nu. Han findes i Hammerfall i Arathi-højlandet.",
        "d8d0c672c814f89c949a": "Træn mig."
      },
      "name": "Vira Younghoof",
      "translationMetadata": {
