    "enUS": {
      "dialogue": {
        "01bb974dd694d7c2798f": "Balai Lok'Wein of Brackenwall Village in Dustwallow Marsh sells a manual that you will need to study in order to improve your skills!",
        "bbfbd7da4e96cfc68f05": "I can train you in First Aid techniques.",
        "cc7d63d073d8ef150178": "Only the renowned Doctor Gregory Victor can improve your skill now.  He can be found in Arathi Highlands at Hammerfall.",
        "d8d0c672c814f89c949a": "Train me."
      },
      "name": "Vira Younghoof",
      "subName": "First Aid Trainer",
