    "daDK": {
      "dialogue": {
        "35edb55b6e03737627a7": "Her er lidt træk... men hvad gør det mig? Jeg er død.",
        "65d283889920ebcb689e": "Jeg må indrømme, at du klarer dig rigtig godt med skrædderkunsten. Lad os nu se, hvor god du VIRKELIG er...",
        "af1c4e1ae8153c712ece": "Træn mig.",
        "f57874956947b05de947": "Hvem sendte dig herhen? Du er ikke klar til min undervisning endnu! Du får besked, når du er klar."
      },
      "name": "Daryl Stack",
      "translationMetadata": {
        "fields": {
