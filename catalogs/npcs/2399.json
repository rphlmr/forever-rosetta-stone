    "hrHR": {
      "dialogue": {
        "35edb55b6e03737627a7": "Ovdje malo puše... ali što me briga? Mrtav sam.",
        "65d283889920ebcb689e": "Moram priznati da ti krojački zanat ide vrlo dobro. A sada da vidimo koliko si DOISTA dobar...",
        "af1c4e1ae8153c712ece": "Podučite me.",
        "f57874956947b05de947": "Tko te poslao ovamo? Još nisi spreman za moju poduku! Reći će ti kad budeš spreman."
      },
      "name": "Daryl Stack",
      "translationMetadata": {
