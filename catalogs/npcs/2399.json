  "locales": {
    "csCZ": {
      "dialogue": {
        "35edb55b6e03737627a7": "Trochu tu táhne... ale co je mi po tom? Jsem mrtvý.",
        "65d283889920ebcb689e": "Musím uznat, že v krejčovském umění si vedeš velmi dobře. A teď se podívejme, jak dobrý SKUTEČNĚ jsi...",
        "af1c4e1ae8153c712ece": "Vycvičte mě.",
        "f57874956947b05de947": "Kdo tě sem poslal? Ještě nejsi připraven na mou výuku! Až budeš, řeknou ti to."
      },
      "name": "Daryl Stack",
      "translationMetadata": {
