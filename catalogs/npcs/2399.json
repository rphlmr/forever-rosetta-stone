    "enUS": {
      "dialogue": {
        "35edb55b6e03737627a7": "The place is a bit drafty... but what do I care? I'm dead.",
        "65d283889920ebcb689e": "You're doing very well in the art of tailoring, I must admit. Now, let's see how good you REALLY are...",
        "af1c4e1ae8153c712ece": "Train me.",
        "f57874956947b05de947": "Who sent you here? You're not ready for my instruction yet! You'll be told when you're ready."
      },
      "name": "Daryl Stack",
      "subName": "Master Tailor",
      "translationMetadata": {
        "fields": {
