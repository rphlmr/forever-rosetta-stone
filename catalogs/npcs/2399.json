    "ltLT": {
      "dialogue": {
        "35edb55b6e03737627a7": "Čia šiek tiek traukia skersvėjis... bet kas man darbo? Aš miręs.",
        "65d283889920ebcb689e": "Turiu pripažinti, siuvimo menas tau puikiai sekasi. O dabar pažiūrėkime, ką iš TIESŲ sugebi...",
        "af1c4e1ae8153c712ece": "Pamokyk mane.",
        "f57874956947b05de947": "Kas tave čia atsiuntė? Dar nesi pasirengęs mano pamokoms! Tau bus pranešta, kai būsi pasirengęs."
      },
      "name": "Daryl Stack",
      "subName": "Siuvimo meistras",
