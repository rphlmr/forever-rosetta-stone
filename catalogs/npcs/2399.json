    "plPL": {
      "dialogue": {
        "35edb55b6e03737627a7": "Trochę tu ciągnie... ale co mnie to obchodzi? Jestem martwy.",
        "65d283889920ebcb689e": "Muszę przyznać, że świetnie radzisz sobie z krawiectwem. Teraz zobaczmy, jak DOBRY jesteś naprawdę...",
        "af1c4e1ae8153c712ece": "Wyszkol mnie.",
        "f57874956947b05de947": "Kto cię tu przysłał? Nie jesteś jeszcze gotów na moje nauki! Dowiesz się, kiedy będziesz."
      },
      "name": "Daryl Stack",
