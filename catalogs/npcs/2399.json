    "esES": {
      "dialogue": {
        "35edb55b6e03737627a7": "En este lugar hay mucha corriente... ¿Pero qué me importa? Estoy muerto.",
        "65d283889920ebcb689e": "Debo admitir que lo estás haciendo muy bien en el arte de la sastrería. Y ahora, veamos lo REALMENTE capaz que eres...",
        "af1c4e1ae8153c712ece": "Entréname.",
        "f57874956947b05de947": "¿Quién te ha enviado aquí? ¡Todavía no puedes recibir mi instrucción! Te lo dirán cuando estés listo."
      },
      "name": "Daryl Stack",
      "subName": "Maestro sastre",
