  "locales": {
    "csCZ": {
      "dialogue": {
        "28368eaacef593ee2a7c": "Věřím, že je Světlo s tebou, $n. Mohu ti s něčím pomoci?",
        "4979983c8e98d97a49d3": "Hledám další výcvik v kněžském umění.",
        "bceb38497db1324d04eb": "Při důkladném přeškolování jsem musela mnohé žáky odnaučit všemu, co se dříve naučili, abych je mohla učit znovu. Tuto službu je s každým opakováním těžší provést. Proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talentům, které ses naučil?",
        "cd50d9e91d149f7750e1": "Neobracej se ke Světlu zády, $c, možná je to jediné, co tě jednoho dne zachrání."
      },
      "name": "Kněžka Josetta",
      "translationMetadata": {
        "fields": {
          "dialogue.28368eaacef593ee2a7c": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
