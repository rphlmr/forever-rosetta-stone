            "sourceLocale": "enUS"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "28368eaacef593ee2a7c": "Jeg stoler på, at Lyset er med dig, $n. Er der noget, jeg kan hjælpe dig med?",
        "4979983c8e98d97a49d3": "Jeg søger mere træning i præsternes kunst.",
        "bceb38497db1324d04eb": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere at udføre hver gang. Derfor bliver hver omskoling også dyrere. Ønsker du, at jeg fjerner de talenter, du har lært?",
        "cd50d9e91d149f7750e1": "Vend ikke Lyset ryggen, $c. Det kan være det eneste, der en dag redder dig."
      },
      "name": "Præstinde Josetta",
      "translationMetadata": {
        "fields": {
          "dialogue.28368eaacef593ee2a7c": {
            "origin": "ai",
