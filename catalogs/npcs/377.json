    "plPL": {
      "dialogue": {
        "28368eaacef593ee2a7c": "Ufam, że Światłość jest z tobą, $n. Czy mogę ci w czymś pomóc?",
        "4979983c8e98d97a49d3": "Szukam dalszego szkolenia w sztuce kapłańskiej.",
        "bceb38497db1324d04eb": "Dzięki rygorystycznemu szkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego nauczyli się wcześniej, by móc uczyć ich od nowa. Usługa ta staje się coraz trudniejsza za każdym razem, gdy ją wykonuję. Dlatego każde kolejne szkolenie kosztuje więcej. Czy pragniesz, abym oduczyła cię poznanych talentów?",
        "cd50d9e91d149f7750e1": "Nie odwracaj się od Światłości, $c. Może pewnego dnia to ona cię ocali."
      },
      "name": "Kapłanka Josetta",
      "translationMetadata": {
        "fields": {
