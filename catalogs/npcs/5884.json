    "plPL": {
      "dialogue": {
        "206d0cad48fca160e4d0": "Witaj, $c. Współczuję twojemu rodzajowi, gdyż tajemnice prawdziwej magii są poza waszym zasięgiem...",
        "2c0720d52b72153a3e90": "Interesuje mnie szkolenie maga.",
        "2c38dac6b830606851d1": "Interesuje mnie szkolenie maga.",
        "5145565d3a23fe8d4b96": "Dzięki surowemu przeszkoleniu musiałam oduczyć wielu uczniów wszystkiego, czego wcześniej się nauczyli, by móc szkolić ich na nowo. Za każdym razem wykonanie tej usługi staje się coraz trudniejsze. Dlatego też każde kolejne przeszkolenie kosztuje więcej. Czy chcesz, abym pomogła ci zapomnieć poznane talenty?",
        "573f0a262aa6c3354f2e": "Witaj, $c. Przybywasz uczyć się tajemnych sztuk?"
      },
      "name": "Mai'ah",
      "translationMetadata": {
