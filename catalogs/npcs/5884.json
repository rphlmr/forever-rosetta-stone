    "hrHR": {
      "dialogue": {
        "206d0cad48fca160e4d0": "Pozdrav, $c. Žalim tvoju vrstu, jer su vam tajne prave magije nedostižne...",
        "2c0720d52b72153a3e90": "Zanima me obuka za maga.",
        "2c38dac6b830606851d1": "Zanima me obuka za maga.",
        "5145565d3a23fe8d4b96": "Strogim preobučavanjem morala sam mnoge učenike odviknuti od svega što su ranije naučili kako bih ih mogla podučiti iznova. Tu je uslugu sve teže pružiti svaki put kad se ponovi. Zato svako preobučavanje stoji sve više. Želiš li da te odviknem od talenata koje si naučio?",
        "573f0a262aa6c3354f2e": "Pozdrav, $c. Jesi li došao učiti o skrivenim umijećima?"
      },
      "name": "Mai'ah",
      "translationMetadata": {
