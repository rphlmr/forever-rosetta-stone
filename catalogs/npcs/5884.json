  "locales": {
    "csCZ": {
      "dialogue": {
        "206d0cad48fca160e4d0": "Zdravím, $c. Lituji tvého druhu, neboť tajemství skutečné magie jsou vám nedostupná...",
        "2c0720d52b72153a3e90": "Mám zájem o výcvik mága.",
        "2c38dac6b830606851d1": "Mám zájem o výcvik mága.",
        "5145565d3a23fe8d4b96": "Přísným přeškolením jsem musela mnoho žáků odnaučit vše, co se dříve naučili, abych je mohla učit znovu. Tuto službu je pokaždé těžší provést, a proto je každé další přeškolení dražší. Přeješ si, abych tě odnaučila talenty, které sis osvojil?",
        "573f0a262aa6c3354f2e": "Zdravím, $c. Přišel ses učit skrytým uměním?"
      },
      "name": "Mai'ah",
      "translationMetadata": {
        "fields": {
