  "locales": {
    "csCZ": {
      "dialogue": {
        "18dc6458a34d1451aefb": "Víš toho víc než já, to je jistý. Ale víš co? Promluv si s mým tátou. Bude chtít, abys dokázal, co umíš, ale je to vážně dobrej učitel. Jmenuje se Rotgath a najdeš ho u kovadlin, jak zpracovává ocel pro starýho Benguse.",
        "37b249454576b9644073": "Něco už umíš. Dost na to, abych tě pár věcí naučil, řekl bych. Tak se podíváme, co ti můžu ukázat, ne?",
        "3ca60d825ba3089cd7e6": "Vycvičte mě.",
        "6e2b8cbc3dac58912380": "Cože? Nemám čas klábosit, táta chce, abych mu dokončil tuhle zakázku."
      },
      "name": "Groum Stonebeard",
      "translationMetadata": {
        "fields": {
          "dialogue.18dc6458a34d1451aefb": {
            "origin": "ai",
