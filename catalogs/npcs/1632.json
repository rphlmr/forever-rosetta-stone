  "locales": {
    "csCZ": {
      "dialogue": {
        "07b565315071754a21e0": "Od té doby, co můj manžel odešel na frontu, je mi Helene oporou. Její laskavé srdce a ostrý meč mi pomohly překonat mnoho těžkých chvil. Nevím, co bych si bez ní počala.",
        "53a34e176bc27c18a014": "Ach, promiň. Nemám tě už co nového naučit. Co kdyby sis promluvil se Simonem Tannerem ve Starém Městě ve Stormwindu? Je to člověk s velkými svaly a nádhernými zrzavými vlasy.",
        "60188faa62d54db9486f": "Vycvičte mě.",
        "9635f2d41b797ee0bf16": "Jak se daří? Miluji vůni kůže, a ty?"
      },
      "name": "Adele Fielder",
      "translationMetadata": {
        "fields": {
          "dialogue.07b565315071754a21e0": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
