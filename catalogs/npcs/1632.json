    "ltLT": {
      "dialogue": {
        "07b565315071754a21e0": "Nuo tada, kai mano vyras išvyko į frontą, Helene buvo mano stiprybės šaltinis. Jos gera širdis ir aštrus kardas padėjo man išgyventi daugybę sunkių akimirkų. Nežinau, ką būčiau be jos dariusi.",
        "53a34e176bc27c18a014": "Ak, atleisk. Neturiu ko naujo tavęs išmokyti. Gal nueitum pasikalbėti su Simon Tanner Stormwindo senamiestyje? Jis žmogus, labai raumeningas, kerinčiais rusvais plaukais.",
        "60188faa62d54db9486f": "Mokyk mane.",
        "9635f2d41b797ee0bf16": "Kaip sekasi? Man patinka odos kvapas, o tau?"
      },
      "name": "Adele Fielder",
      "subName": "Odininkystės pameistrė",
      "translationMetadata": {
        "fields": {
