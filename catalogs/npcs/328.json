    "plPL": {
      "dialogue": {
        "3697ccda798281241671": "Witaj, magu. Czy mam przybliżyć ci świat magii?",
        "69ab0a2c21acfee6fdff": "Interesuje mnie szkolenie maga.",
        "ae16dc15188a5dad474a": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "de5628104a66aad4a2d7": "Interesuje mnie szkolenie maga.",
        "e28c2c568babf653c4e4": "Witaj, $c. Radzę ci: podczas podróży po świecie wystrzegaj się magii, gdyż sparzy nieprzeszkolonych."
      },
      "name": "Zaldimar Wefhellt",
