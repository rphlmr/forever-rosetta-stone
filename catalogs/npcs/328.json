  "locales": {
    "csCZ": {
      "dialogue": {
        "3697ccda798281241671": "Zdravím tě, mágu. Mám ti dále přiblížit svět magie?",
        "69ab0a2c21acfee6fdff": "Mám zájem o výcvik mága.",
        "ae16dc15188a5dad474a": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "de5628104a66aad4a2d7": "Mám zájem o výcvik mága.",
        "e28c2c568babf653c4e4": "Vítej, $c. Poradím ti: na cestách světem si dávej pozor na magii, neboť nevycvičené popálí."
      },
      "name": "Zaldimar Wefhellt",
      "translationMetadata": {
        "fields": {
