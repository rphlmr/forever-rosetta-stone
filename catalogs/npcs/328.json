    "ltLT": {
      "dialogue": {
        "3697ccda798281241671": "Sveikas, mage.  Ar norėtum daugiau sužinoti apie magijos pasaulį?",
        "69ab0a2c21acfee6fdff": "Norėčiau mokytis magijos.",
        "ae16dc15188a5dad474a": "Griežtai permokydamas daugelį mokinių turėjau priversti pamiršti viską, ką jie buvo išmokę, kad galėčiau mokyti iš naujo.  Kaskart tai padaryti darosi vis sunkiau.  Todėl kiekvienas permokymas kainuoja vis brangiau.  Ar nori, kad padėčiau tau pamiršti išmoktus talentus?",
        "de5628104a66aad4a2d7": "Norėčiau mokytis magijos.",
        "e28c2c568babf653c4e4": "Sveikas, $c.  Patarsiu tau štai ką: keliaudamas po pasaulį saugokis magijos, nes neišmokusius ja naudotis ji nudegins."
      },
      "name": "Zaldimar Wefhellt",
      "subName": "Magų mokytojas",
