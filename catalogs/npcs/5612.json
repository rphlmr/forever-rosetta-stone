    "hrHR": {
      "dialogue": {
        "3e912e39493f088da8d5": "Zanima me poduka u umijeću vještaca.",
        "4e62e1a6ee90fb68fed7": "Strogim preobučavanjem morao sam mnoge učenike odviknuti od svega što su prethodno naučili kako bih ih mogao poučiti iznova. Ovu je uslugu svaki put sve teže pružiti. Zato je svako sljedeće preobučavanje skuplje. Želiš li da te odviknem od talenata koje si naučio?",
        "90e23e80b9ab1a0e0807": "Zanima me poduka u umijeću vještaca.",
        "f8fb4e221d75365c1ed6": "Tama te ne prihvaća, $c. Prestani brbljati i gubi mi se s očiju! Odlazi!",
        "fe24d5ceb9c51853fc41": "Tajanstvena magija kvari samo slabe. Nastavi s obukom ili bi te mogla zadesiti slična sudbina."
      },
      "name": "Gimrizz Shadowcog",
      "translationMetadata": {
