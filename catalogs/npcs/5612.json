    "enUS": {
      "dialogue": {
        "3e912e39493f088da8d5": "I am interested in warlock training.",
        "4e62e1a6ee90fb68fed7": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "90e23e80b9ab1a0e0807": "I am interested in warlock training.",
        "f8fb4e221d75365c1ed6": "The darkness does not embrace you, $c.  Cease your prattle and remove yourself from my sight!  Be gone!",
        "fe24d5ceb9c51853fc41": "The arcane only corrupts those who are weak. Keep up on your training, or you may find a similar fate."
      },
      "name": "Gimrizz Shadowcog",
      "subName": "Warlock Trainer",
