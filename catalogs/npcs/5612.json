    "daDK": {
      "dialogue": {
        "3e912e39493f088da8d5": "Jeg er interesseret i træning som troldmand.",
        "4e62e1a6ee90fb68fed7": "Gennem streng genoptræning har jeg måttet få mange elever til at glemme alt, hvad de tidligere havde lært, så jeg kunne undervise dem på ny. Denne tjeneste bliver sværere for hver gang. Derfor bliver hver genoptræning også dyrere. Ønsker du, at jeg får dig til at glemme de talenter, du har lært?",
        "90e23e80b9ab1a0e0807": "Jeg er interesseret i træning som troldmand.",
        "f8fb4e221d75365c1ed6": "Mørket omfavner dig ikke, $c. Hold op med din pludren og forsvind ud af mit syn! Væk!",
        "fe24d5ceb9c51853fc41": "Den arkane magi fordærver kun de svage. Fortsæt din træning, ellers kan du lide samme skæbne."
      },
      "name": "Gimrizz Shadowcog",
      "translationMetadata": {
