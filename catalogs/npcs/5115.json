    "plPL": {
      "dialogue": {
        "56e2018540ef56103a19": "Co mogę dla ciebie zrobić?",
        "749911b1c4313f1c6146": "Nie mogę ci pomóc w szkoleniu. Poszukaj nauczyciela dla klasy $c.",
        "b93f90d247ba3025b0c3": "Dzięki surowemu szkoleniu oduczyłem wielu uczniów wszystkiego, czego się wcześniej nauczyli, by móc uczyć ich od nowa. Każde kolejne przeszkolenie jest trudniejsze, a przez to droższe. Czy chcesz, abym pomógł ci zapomnieć wyuczone talenty?",
        "f8e6c6575587386bb8d3": "Szukam szkolenia w sztuce łowcy."
      },
