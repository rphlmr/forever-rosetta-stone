    "hrHR": {
      "dialogue": {
        "56e2018540ef56103a19": "Što mogu učiniti za tebe?",
        "749911b1c4313f1c6146": "Ne mogu ti pomoći s obukom. Potraži učitelja za $c.",
        "b93f90d247ba3025b0c3": "Strogom sam preobukom morao mnoge učenike odviknuti od svega što su prije naučili kako bih ih mogao podučiti iznova. Svaka sljedeća preobuka sve je teža, pa je zato i skuplja. Želiš li da te odviknem od talenata koje si naučio?",
        "f8e6c6575587386bb8d3": "Tražim obuku u lovačkim vještinama."
      },
      "name": "Daera Brightspear",
      "translationMetadata": {
