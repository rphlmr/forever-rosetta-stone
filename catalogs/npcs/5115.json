    "esES": {
      "dialogue": {
        "56e2018540ef56103a19": "¿Qué puedo hacer por ti?",
        "749911b1c4313f1c6146": "Bah, ayudar no puedo. Más te vale buscarte un entrenador de $c.",
        "b93f90d247ba3025b0c3": "He tenido que realizar una rigurosa reconversión con muchos estudiantes de todo lo que habían aprendido, para poder enseñarles desde cero. El servicio que ofrezco aumenta de dificultad cada vez que se hace. Por esa razón, también aumenta el precio de cada nueva instrucción. ¿Quieres que elimine todos los talentos que has aprendido?",
        "f8e6c6575587386bb8d3": "Busco entrenamiento en las artes del cazador."
      },
      "name": "Daera Relulanza",
      "subName": "Instructor de caza",
