    "trTR": {
      "dialogue": {
        "56e2018540ef56103a19": "Senin için ne yapabilirim?",
        "749911b1c4313f1c6146": "Eğitim konusunda sana yardım edemem. Bir $c eğitmeni bulmalısın.",
        "b93f90d247ba3025b0c3": "Sıkı bir yeniden eğitimle pek çok öğrencime daha önce öğrendiklerini unutturup onları baştan eğittim. Bu hizmet her tekrarlandığında zorlaşır ve bu yüzden pahalılaşır. Öğrendiğin yetenekleri sana unutturmamı istiyor musun?",
        "f8e6c6575587386bb8d3": "Avcılığın yollarını öğrenmek istiyorum."
      },
