    "daDK": {
      "dialogue": {
        "56e2018540ef56103a19": "Hvad kan jeg gøre for dig?",
        "749911b1c4313f1c6146": "Jeg kan ikke hjælpe med træning. Du bør finde en træner for $c.",
        "b93f90d247ba3025b0c3": "Gennem grundig omskoling har jeg måttet få mange elever til at glemme alt, de havde lært, så jeg kunne lære dem op på ny. Denne tjeneste bliver sværere for hver gang og derfor også dyrere. Ønsker du, at jeg får dig til at glemme dine talenter?",
        "f8e6c6575587386bb8d3": "Jeg søger træning i jægerens kunst."
      },
      "name": "Daera Brightspear",
      "translationMetadata": {
        "fields": {
