    "enUS": {
      "dialogue": {
        "56e2018540ef56103a19": "Wot kin I do fer ye?",
        "749911b1c4313f1c6146": "I kinnae help ye with trainin'. Ye should look fer a $c trainer.",
        "b93f90d247ba3025b0c3": "Through rigorous retraining I have had to break many students of all they had previously learned so that I might teach them anew.  The service I offer becomes increasingly difficult to perform each time it is done.  It is for that reason that it becomes increasingly expensive with each retraining.  Do you desire that I break you of the talents you have learned?",
        "f8e6c6575587386bb8d3": "I seek training in the ways of the Hunter."
      },
      "name": "Daera Brightspear",
      "subName": "Hunter Trainer",
      "translationMetadata": {
        "fields": {
          "dialogue.56e2018540ef56103a19": {
