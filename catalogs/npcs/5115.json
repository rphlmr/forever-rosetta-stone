  "locales": {
    "csCZ": {
      "dialogue": {
        "56e2018540ef56103a19": "Co pro tebe můžu udělat?",
        "749911b1c4313f1c6146": "S výcvikem ti nemůžu pomoci. Vyhledej trenéra pro $c.",
        "b93f90d247ba3025b0c3": "Přísným přeškolením jsem musel mnohé žáky odnaučit vše, co znali, abych je mohl učit znovu. S každým dalším přeškolením je tato služba náročnější, a proto i dražší. Chceš, abych tě odnaučil tvé talenty?",
        "f8e6c6575587386bb8d3": "Hledám výcvik v umění lovce."
      },
      "name": "Daera Brightspear",
      "translationMetadata": {
        "fields": {
          "dialogue.56e2018540ef56103a19": {
