    "frFR": {
      "dialogue": {
        "02cae219522d546a859a": "Ah, c'est que vous m'avez l'air solide ! Vous pourrez peut-être m'aider pour un détail ou deux. Je ne trouve guère d'aide ici, sauf auprès d'apprentis sans expérience, et ils ont d'autres chats à fouetter."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
        "fields": {
