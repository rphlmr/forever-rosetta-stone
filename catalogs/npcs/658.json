    "plPL": {
      "dialogue": {
        "02cae219522d546a859a": "O, wyglądasz na krzepką osobę! Może pomożesz mi w paru sprawach. Poza niedoświadczonymi uczniami nie ma tu zbyt wielu rąk do pracy, a oni mają inne zmartwienia."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
        "fields": {
          "dialogue.02cae219522d546a859a": {
