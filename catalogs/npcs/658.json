            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "deDE": {
      "dialogue": {
        "02cae219522d546a859a": "Hmmm, Ihr seht mir recht handfest aus. Vielleicht könnt Ihr mir bei ein, zwei Dingen zur Hand gehen. Außer ein paar Lehrlingen, die noch grün hinter den Ohren sind und anderes zu tun haben, gibt es hier nicht viel Hilfe."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
        "fields": {
          "dialogue.02cae219522d546a859a": {
            "origin": "community",
