        }
      }
    },
    "ptBR": {
      "dialogue": {
        "02cae219522d546a859a": "Mas olha se tu não é mais parrudo que carneiro na engorda! Talvez tu possa me ajudar com uma coisa ou outra. Capaz que essa aprendizada cheirando a leite vai dar conta... Não tem mais ninguém por aqui, e eles têm muito mais o que fazer."
      },
      "name": "Sten Braçoforte",
      "translationMetadata": {
        "fields": {
          "dialogue.02cae219522d546a859a": {
