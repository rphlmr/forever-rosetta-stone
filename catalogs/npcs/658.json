    },
    "ltLT": {
      "dialogue": {
        "02cae219522d546a859a": "Ak, atrodai tvirtai sudėtas! Galėtum man padėti šen bei ten. Čia nelabai kas gali padėti, išskyrus žalius mokinius, o jie turi kitų rūpesčių."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
