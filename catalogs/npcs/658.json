  "locales": {
    "csCZ": {
      "dialogue": {
        "02cae219522d546a859a": "Á, ty vypadáš jako pořádný silák! Možná bys mi mohl s něčím pomoci. Kromě nezkušených učňů tu moc pomoci není a ti mají jiné starosti."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
        "fields": {
          "dialogue.02cae219522d546a859a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
