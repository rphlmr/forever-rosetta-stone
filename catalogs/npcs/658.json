          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "02cae219522d546a859a": "Nå, du ser da robust ud! Måske kan du hjælpe mig med en ting eller to. Her er ikke megen hjælp at hente ud over grønne lærlinge, og de har andet at tænke på."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
        "fields": {
          "dialogue.02cae219522d546a859a": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
