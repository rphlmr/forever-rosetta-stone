    "hrHR": {
      "dialogue": {
        "02cae219522d546a859a": "O, izgledaš prilično snažno! Možda mi možeš pomoći s ponečim. Ovdje nema mnogo pomoći osim neiskusnih naučnika, a oni imaju drugih briga."
      },
      "name": "Sten Stoutarm",
      "translationMetadata": {
