    "daDK": {
      "dialogue": {
        "2dd5401de6523ea46cc7": "Hvis du søger oplysninger, som Cenarion Circle måske har arkiveret et sted, er det mig, du skal tale med. Men du må først vide, hvilke oplysninger du søger, før jeg kan hjælpe dig.$B$BKan du se, hvordan det fungerer? Genialt!"
      },
      "name": "Umber",
      "translationMetadata": {
        "fields": {
