    "csCZ": {
      "dialogue": {
        "2dd5401de6523ea46cc7": "Pokud hledáš informace, které má Cenarijský kruh někde v archivu, obrať se na mě. Nejdřív ale musíš vědět, jaké informace hledáš, abych ti mohl opravdu pomoci.$B$BChápeš, jak to funguje? Geniální!"
      },
      "name": "Umber",
      "translationMetadata": {
