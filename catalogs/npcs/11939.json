    "enUS": {
      "dialogue": {
        "2dd5401de6523ea46cc7": "If you're looking for information that the Cenarion Circle might have archived somewhere, then I'm the one to talk to.  Then again, you need to know what information you're looking for first before I can really help you.$B$BSee how that works?  Brilliant!"
      },
      "name": "Umber",
      "translationMetadata": {
