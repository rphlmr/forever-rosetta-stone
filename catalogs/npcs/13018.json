    },
    "ltLT": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Norėčiau apžiūrėti tavo prekes.",
        "a2d38eb57c3cd245a99e": "Atrodai taip, lyg tau praverstų darbas, panele. Sėsk į tramvajų ir aplankyk mano brolį Monty Ironforge Deeprun Tram stotyje. Esu tikras, kad jis tau ras darbo.",
        "f576d4da47d01f580ca7": "Visame Khaz Modan nerasi gardesnio žiurkių kebabo!"
      },
      "name": "Nipsy",
      "translationMetadata": {
