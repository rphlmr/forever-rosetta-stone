    "daDK": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Jeg vil gerne se dine varer.",
        "a2d38eb57c3cd245a99e": "Du ser ud, som om du kunne bruge noget arbejde, frue. Tag sporvognen og besøg min bror Monty ved Deeprun Tram-depotet i Ironforge. Jeg er sikker på, at han har noget, du kan lave.",
        "f576d4da47d01f580ca7": "Du finder ingen bedre rottekebab på denne side af Khaz Modan!"
      },
      "name": "Nipsy",
      "translationMetadata": {
        "fields": {
          "dialogue.9182a6a38da783aa9cbc": {
