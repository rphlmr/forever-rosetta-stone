    "svSE": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Jag vill se dina varor.",
        "a2d38eb57c3cd245a99e": "Du ser ut att kunna behöva arbete, frun. Ta spårvagnen och besök min bror Monty vid Deeprun Tram-depån i Ironforge. Jag är säker på att han har något du kan göra.",
        "f576d4da47d01f580ca7": "Du hittar ingen bättre råttkebab på den här sidan av Khaz Modan!"
      },
      "name": "Nipsy",
