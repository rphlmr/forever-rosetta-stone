    "enUS": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "I want to browse your goods.",
        "a2d38eb57c3cd245a99e": "You look like you could use some work, lady. You should board the tram and visit my brother, Monty, at the Ironforge Deeprun Tram depot. I'm sure he has something you could do.",
        "f576d4da47d01f580ca7": "You'll find no finer rat kabob this side of Khaz Modan!"
      },
      "name": "Nipsy",
      "translationMetadata": {
