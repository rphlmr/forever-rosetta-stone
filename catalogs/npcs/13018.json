    "itIT": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Vorrei vedere la tua merce.",
        "a2d38eb57c3cd245a99e": "Sembri una che ha bisogno di lavoro, signora. Dovresti salire sul tram e andare da mio fratello Monty, alla stazione del Deeprun Tram di Ironforge. Sono sicuro che ha qualcosa da farti fare.",
        "f576d4da47d01f580ca7": "Di qui a Khaz Modan non troverai uno spiedino di ratto migliore!"
      },
      "name": "Nipsy",
      "translationMetadata": {
