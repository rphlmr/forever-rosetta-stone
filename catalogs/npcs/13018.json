    "esES": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Quiero ver tus mercancías.",
        "a2d38eb57c3cd245a99e": "Parece que te vendría bien algo de trabajo, señora. Sube al tranvía y visita a mi hermano Monty en la estación del Tranvía Subterráneo de Forjaz. Seguro que tiene algo para ti.",
        "f576d4da47d01f580ca7": "¡No encontrarás mejores kebabs de rata a este lado de Khaz Modan!"
      },
      "name": "Niblis",
