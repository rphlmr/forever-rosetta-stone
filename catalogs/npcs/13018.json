    "hrHR": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Želim pogledati vašu robu.",
        "a2d38eb57c3cd245a99e": "Izgledate kao da biste mogli raditi, gospođo. Ukrcajte se na tramvaj i posjetite mojeg brata Montyja u skladištu Deeprun Trama u Ironforgeu. Siguran sam da ima nešto za vas.",
        "f576d4da47d01f580ca7": "Nećeš naći bolji štakorski kebab s ove strane Khaz Modana!"
      },
      "name": "Nipsy",
      "translationMetadata": {
