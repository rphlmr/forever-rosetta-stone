    },
    "deDE": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Ich möchte Eure Waren ansehen.",
        "a2d38eb57c3cd245a99e": "Ihr seht aus, als könntet Ihr Arbeit gebrauchen, werte Dame. Fahrt mit der Tiefenbahn zu meinem Bruder Monty an der Station in Eisenschmiede. Er hat bestimmt etwas für Euch zu tun.",
        "f576d4da47d01f580ca7": "Ihr findet keinen besseren Rattenkebab diesseits von Khaz Modan!"
      },
      "name": "Nipsy",
      "translationMetadata": {
        "fields": {
          "dialogue.9182a6a38da783aa9cbc": {
