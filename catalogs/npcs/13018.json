    "ptBR": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Quero ver suas mercadorias.",
        "a2d38eb57c3cd245a99e": "Parece que você está precisando de trabalho, moça. Pegue o metrô e visite meu irmão Monty na estação do Metrô Correfundo em Altaforja. Tenho certeza de que ele tem algo para você fazer.",
        "f576d4da47d01f580ca7": "Você não vai achar churrasquinho de rato mais delicioso que esse em lugar algum de Khaz Modan!"
      },
      "name": "Nipsy",
