    "plPL": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Chcę przejrzeć twoje towary.",
        "a2d38eb57c3cd245a99e": "Wygląda pani na osobę, której przydałaby się praca. Proszę wsiąść do tramwaju i odwiedzić mojego brata Monty’ego w zajezdni Deeprun Tram w Ironforge. Jestem pewien, że znajdzie dla pani zajęcie.",
        "f576d4da47d01f580ca7": "Nie znajdziesz lepszego szczurzego kebaba po tej stronie Khaz Modan!"
      },
      "name": "Nipsy",
      "translationMetadata": {
