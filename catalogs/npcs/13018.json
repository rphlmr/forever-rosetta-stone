  "locales": {
    "csCZ": {
      "dialogue": {
        "9182a6a38da783aa9cbc": "Rád bych si prohlédl vaše zboží.",
        "a2d38eb57c3cd245a99e": "Vypadáte, že by se vám hodila práce, paní. Nastupte do tramvaje a navštivte mého bratra Montyho v depu Deeprun Tram v Ironforge. Jistě pro vás něco má.",
        "f576d4da47d01f580ca7": "Na této straně Khaz Modanu lepší krysí kebab nenajdeš!"
      },
      "name": "Nipsy",
      "translationMetadata": {
        "fields": {
