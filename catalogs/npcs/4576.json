    "svSE": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Jag ska undervisa dig när tiden är inne... men det är den inte nu. Du har mycket mer att lära först!",
        "69403ff317016b7189d5": "Du behöver undervisning av en sann mästare! Gå till Daryl Stack i Tarren Mill och omfamna ditt öde!",
        "847f178d6de259982b6d": "Tyg duger. Personligen föredrar jag att arbeta med människohud.",
        "980cdb79bc756e96cd1a": "Träna mig.",
        "ecc53356d6a2d2c5b0b7": "Bra! Jag ser att mina ansträngningar inte kommer att vara förgäves!"
      },
      "name": "Josef Gregorian",
      "translationMetadata": {
