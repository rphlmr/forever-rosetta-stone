    "plPL": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Pouczę cię, gdy nadejdzie właściwy czas... lecz nie teraz. Najpierw musisz się jeszcze wiele nauczyć!",
        "69403ff317016b7189d5": "Potrzebujesz nauk prawdziwego mistrza! Idź do Daryla Stacka w Tarren Mill i przyjmij swoje przeznaczenie!",
        "847f178d6de259982b6d": "Tkanina jest w porządku. Osobiście wolę pracować z ludzką skórą.",
        "980cdb79bc756e96cd1a": "Wyszkol mnie.",
        "ecc53356d6a2d2c5b0b7": "Dobrze! Widzę, że moje wysiłki nie pójdą na marne!"
      },
      "name": "Josef Gregorian",
      "translationMetadata": {
