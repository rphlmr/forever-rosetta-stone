    "esES": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Te instruiré cuando llegue el momento preciso... y, ese momento, aún no ha llegado. ¡Todavía te queda mucho por aprender!",
        "69403ff317016b7189d5": "¡Necesitas la instrucción de un verdadero maestro! ¡Ve a ver a Daryl Stack en el Molino Tarren y acepta tu destino!",
        "847f178d6de259982b6d": "La tela está bien. Aunque, personalmente, prefiero trabajar con piel humana.",
        "980cdb79bc756e96cd1a": "Entréname.",
        "ecc53356d6a2d2c5b0b7": "¡Bien! ¡Puedo ver que mis esfuerzos no han sido en vano!"
      },
      "name": "Josef Gregorian",
      "subName": "Artesano sastre",
