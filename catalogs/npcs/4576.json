    "enUS": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "I will instruct you when the time is right... that time is not now. You have much more to learn first!",
        "69403ff317016b7189d5": "You require the instruction of a true master! Go to Daryl Stack in Tarren Mill and embrace your destiny!",
        "847f178d6de259982b6d": "Cloth is okay. Personally I prefer to work with human skin.",
        "980cdb79bc756e96cd1a": "Train me.",
        "ecc53356d6a2d2c5b0b7": "Good! I can tell that my efforts will not be wasted!"
      },
      "name": "Josef Gregorian",
      "subName": "Artisan Tailor",
      "translationMetadata": {
