    "daDK": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Jeg vil undervise dig, når tiden er inde... og det er den ikke nu. Du har meget mere at lære først!",
        "69403ff317016b7189d5": "Du har brug for undervisning af en sand mester! Gå til Daryl Stack i Tarren Mill og grib din skæbne!",
        "847f178d6de259982b6d": "Stof er udmærket. Personligt foretrækker jeg at arbejde med menneskehud.",
        "980cdb79bc756e96cd1a": "Træn mig.",
        "ecc53356d6a2d2c5b0b7": "Godt! Jeg kan se, at mine anstrengelser ikke vil være forgæves!"
      },
      "name": "Josef Gregorian",
      "translationMetadata": {
        "fields": {
          "dialogue.5b466ee02954d1a1aa97": {
