    "hrHR": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Podučit ću te kad dođe pravo vrijeme... a to nije sada. Prvo moraš još mnogo naučiti!",
        "69403ff317016b7189d5": "Treba ti poduka pravog majstora! Idi Darylu Stacku u Tarren Mill i prihvati svoju sudbinu!",
        "847f178d6de259982b6d": "Tkanina je u redu. Osobno radije radim s ljudskom kožom.",
        "980cdb79bc756e96cd1a": "Podučite me.",
        "ecc53356d6a2d2c5b0b7": "Dobro! Vidim da moj trud neće biti uzaludan!"
      },
      "name": "Josef Gregorian",
