    "ltLT": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Pamokysiu tave, kai ateis tinkamas metas... bet dabar jis dar neatėjo. Pirmiausia turi dar daug ko išmokti!",
        "69403ff317016b7189d5": "Tau reikia tikro meistro pamokų! Keliauk pas Daryl Stack į Tarren Mill ir pasitik savo likimą!",
        "847f178d6de259982b6d": "Audinys neblogai. Bet aš pats mieliau dirbu su žmogaus oda.",
        "980cdb79bc756e96cd1a": "Pamokyk mane.",
        "ecc53356d6a2d2c5b0b7": "Puiku! Matau, kad mano pastangos nenueis veltui!"
      },
      "name": "Josef Gregorian",
      "subName": "Siuvimo meistras",
      "translationMetadata": {
