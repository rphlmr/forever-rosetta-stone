    "ptBR": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Vou instruí-lo quando for o momento certo... ainda não é a hora. Você tem muito o que aprender antes!",
        "69403ff317016b7189d5": "Você necessita das instruções de um verdadeiro mestre! Fale com Dario Pilha na Serraria Tarren e abrace o seu destino!",
        "847f178d6de259982b6d": "Tecido é legal... mas, pessoalmente, prefiro trabalhar com pele humana.",
        "980cdb79bc756e96cd1a": "Treine-me.",
        "ecc53356d6a2d2c5b0b7": "Bárbaro! Posso dizer que meus esforços não serão desperdiçados!"
      },
      "name": "Josefo Gregório",
      "subName": "Alfaiate Artífice",
