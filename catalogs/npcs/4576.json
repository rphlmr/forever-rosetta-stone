    "itIT": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Ti istruirò quando sarà il momento giusto... quel momento non è adesso. Prima hai ancora molto da imparare!",
        "69403ff317016b7189d5": "Hai bisogno degli insegnamenti di un vero maestro! Va' da Daryl Stack a Tarren Mill e abbraccia il tuo destino!",
        "847f178d6de259982b6d": "La stoffa va bene. Personalmente preferisco lavorare con la pelle umana.",
        "980cdb79bc756e96cd1a": "Addestrami.",
        "ecc53356d6a2d2c5b0b7": "Bene! Vedo che i miei sforzi non andranno sprecati!"
      },
      "name": "Josef Gregorian",
