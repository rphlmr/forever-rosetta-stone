  "locales": {
    "csCZ": {
      "dialogue": {
        "5b466ee02954d1a1aa97": "Poučím tě, až nastane správný čas... a ten teď není. Nejprve se toho musíš ještě hodně naučit!",
        "69403ff317016b7189d5": "Potřebuješ výuku skutečného mistra! Jdi za Darylem Stackem do Tarren Millu a přijmi svůj osud!",
        "847f178d6de259982b6d": "Látka je v pořádku. Osobně dávám přednost práci s lidskou kůží.",
        "980cdb79bc756e96cd1a": "Vycvičte mě.",
        "ecc53356d6a2d2c5b0b7": "Dobře! Vidím, že mé úsilí nepřijde nazmar!"
      },
      "name": "Josef Gregorian",
      "translationMetadata": {
        "fields": {
          "dialogue.5b466ee02954d1a1aa97": {
