    "daDK": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Jeg træner ikke smede uden evner. Kom tilbage, når du har noget ordentligt at vise mig.",
        "1d18012d42aa59adb53b": "Træn mig.",
        "b9edaa5075c7213acb79": "Jeg ser potentiale i dig, $n. Tag nu en hammer og noget af skrottet, du har brug for meget øvelse."
      },
      "name": "Shayis Steelfury",
      "translationMetadata": {
        "fields": {
          "dialogue.10d4b2c56cc720a3849b": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
