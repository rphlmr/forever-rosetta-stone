    "enUS": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "I don't train smiths with no skill, come back when you have something decent to show me.",
        "1d18012d42aa59adb53b": "Train me.",
        "b9edaa5075c7213acb79": "I see potential in you $n. Now grab a hammer and some of those scraps, you need a lot of practice."
      },
      "name": "Shayis Steelfury",
      "subName": "Armor Crafter",
