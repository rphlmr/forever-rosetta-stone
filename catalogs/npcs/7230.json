    "plPL": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Nie szkolę kowali bez umiejętności. Wróć, kiedy będziesz mieć coś porządnego do pokazania.",
        "1d18012d42aa59adb53b": "Wyszkol mnie.",
        "b9edaa5075c7213acb79": "Widzę w tobie potencjał, $n. Chwyć młot i trochę złomu, potrzebujesz dużo ćwiczeń."
      },
