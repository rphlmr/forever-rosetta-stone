  "locales": {
    "csCZ": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Neškolím kováře bez dovedností. Vrať se, až mi budeš mít co pořádného ukázat.",
        "1d18012d42aa59adb53b": "Vycvičte mě.",
        "b9edaa5075c7213acb79": "Vidím v tobě potenciál, $n. Teď vezmi kladivo a trochu toho šrotu, potřebuješ hodně cvičit."
      },
      "name": "Shayis Steelfury",
      "translationMetadata": {
        "fields": {
