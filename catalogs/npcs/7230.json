    "hrHR": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Ne podučavam kovače bez vještine. Vrati se kad mi možeš pokazati nešto valjano.",
        "1d18012d42aa59adb53b": "Podučite me.",
        "b9edaa5075c7213acb79": "Vidim potencijal u tebi, $n. Sada uzmi čekić i nešto onog otpadnog metala, treba ti mnogo vježbe."
      },
      "name": "Shayis Steelfury",
