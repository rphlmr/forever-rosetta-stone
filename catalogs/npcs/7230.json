    "ptBR": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Eu não treino ferreiros desprovidos de habilidade, volte quando puder me mostrar alguma coisa decente.",
        "1d18012d42aa59adb53b": "Treine-me.",
        "b9edaa5075c7213acb79": "Vejo potencial em você, $n. Pegue um martelo e um pouco daquela sucata, você precisa de muito treino."
      },
      "name": "Shayis Furiácero",
