    "ltLT": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Nemokau kalvių, kurie nieko nemoka. Grįžk, kai turėsi ką nors padoraus man parodyti.",
        "1d18012d42aa59adb53b": "Pamokyk mane.",
        "b9edaa5075c7213acb79": "Matau tavyje potencialo, $n. Dabar čiupk plaktuką ir šiek tiek tų atraižų, tau reikia daug praktikuotis."
      },
      "name": "Shayis Steelfury",
      "subName": "Šarvų kalvis",
