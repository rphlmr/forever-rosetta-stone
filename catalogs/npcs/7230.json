    "itIT": {
      "dialogue": {
        "10d4b2c56cc720a3849b": "Non addestro fabbri senza un briciolo di abilità, torna quando avrai qualcosa di decente da farmi vedere.",
        "1d18012d42aa59adb53b": "Addestrami.",
        "b9edaa5075c7213acb79": "Vedo del potenziale in te, $N. Ora prendi un martello e un po' di quei rottami, ti serve un sacco di pratica."
      },
      "name": "Shayis Steelfury",
