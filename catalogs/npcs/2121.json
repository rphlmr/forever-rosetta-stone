      }
    },
    "daDK": {
      "dialogue": {
        "3c2298b95015b8d663e1": "Træn mig.",
        "6df27e4be7c5a68a51b0": "Information... Med vores spejdere og agenter styrer vi informationsstrømmen i Lordaeron. Svøbens bevægelser og besiddelser er under vores vågne øjne...",
        "70066ba5aab953c62d24": "Jeg vil gerne se dine varer."
      },
      "name": "Skyggepræst Allister",
      "translationMetadata": {
        "fields": {
          "dialogue.3c2298b95015b8d663e1": {
