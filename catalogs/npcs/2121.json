    "deDE": {
      "dialogue": {
        "3c2298b95015b8d663e1": "Bildet mich aus.",
        "6df27e4be7c5a68a51b0": "Informationen... Mit unseren Spähern und Agenten kontrollieren wir den Informationsfluss in Lordaeron. Die Bewegungen der Geißel, ihre Bestände, alles unter unseren wachsamen Augen...",
        "70066ba5aab953c62d24": "Ich möchte Eure Waren ansehen."
      },
      "name": "Schattenpriester Allister",
