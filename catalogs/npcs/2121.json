  "locales": {
    "csCZ": {
      "dialogue": {
        "3c2298b95015b8d663e1": "Vycvičte mě.",
        "6df27e4be7c5a68a51b0": "Informace... Díky našim zvědům a agentům řídíme tok informací v Lordaeronu. Pohyby Pohromy a její državy, to vše je pod naším dohledem...",
        "70066ba5aab953c62d24": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Stínový kněz Allister",
      "translationMetadata": {
        "fields": {
          "dialogue.3c2298b95015b8d663e1": {
