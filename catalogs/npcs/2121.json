    "enUS": {
      "dialogue": {
        "3c2298b95015b8d663e1": "Train me.",
        "6df27e4be7c5a68a51b0": "Information... With our scouts and agents, we control the flow of information in Lordaeron. Scourge movements, their holdings, all underneath our watchful eyes...",
        "70066ba5aab953c62d24": "I want to browse your goods."
      },
      "name": "Shadow Priest Allister",
