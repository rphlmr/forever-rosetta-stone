    "deDE": {
      "dialogue": {
        "16189c7dbe27b1f63efc": "Ich suche eine Ausbildung im Reiten.",
        "46fc2433917463843333": "Die Zwerge von Ironforge müssen Euch mit Ehrfurcht begegnen, bevor ich Euch eine Reitfertigkeit lehre, $C.",
        "5226841d127effcd9609": "Ich kann Euch die Feinheiten des Widderreitens beibringen, vorausgesetzt, Ihr habt das nötige Kleingeld, um die Stunde zu bezahlen!"
      },
      "name": "Ultham Ironhorn",
      "subName": "Widderreitlehrer",
