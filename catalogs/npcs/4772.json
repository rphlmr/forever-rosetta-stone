    "daDK": {
      "dialogue": {
        "16189c7dbe27b1f63efc": "Jeg søger undervisning i at ride på et ridedyr.",
        "46fc2433917463843333": "Du skal være ophøjet hos dværgene fra Ironforge, før jeg vil lære dig at ride, $c.",
        "5226841d127effcd9609": "Jeg kan lære dig kunsten at ride på væddere, hvis du har guld nok til undervisningen!"
      },
      "name": "Ultham Ironhorn",
      "translationMetadata": {
