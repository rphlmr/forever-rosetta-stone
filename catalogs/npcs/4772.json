    "enUS": {
      "dialogue": {
        "16189c7dbe27b1f63efc": "I seek training to ride a steed.",
        "46fc2433917463843333": "You need to be exalted with the dwarves of Ironforge before I will teach you a riding skill, $c.",
        "5226841d127effcd9609": "I can teach you the finer points of Ram Riding, provided you have enough gold to cover the lesson!"
      },
      "name": "Ultham Ironhorn",
      "subName": "Ram Riding Instructor",
