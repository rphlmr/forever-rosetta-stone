    "csCZ": {
      "dialogue": {
        "16189c7dbe27b1f63efc": "Hledám výcvik v jízdě na jezdeckém zvířeti.",
        "46fc2433917463843333": "Než tě naučím jezdit, musíš si získat úctu trpaslíků z Ironforge, $c.",
        "5226841d127effcd9609": "Mohu tě naučit jezdit na beranu, pokud máš dost zlata na zaplacení výuky!"
      },
      "name": "Ultham Ironhorn",
