    "hrHR": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Imaš li pauka ili kornjaša, $c? Brzo bježe, ali ako ih uspiješ stići, otkrit ćeš da su prava poslastica!",
        "e555e2caa60241793db8": "Gorzeeki, želim nešto kupiti."
      },
      "name": "Gorzeeki Wildeyes",
      "translationMetadata": {
