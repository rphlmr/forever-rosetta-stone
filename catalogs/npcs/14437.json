    "plPL": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Masz jakieś pająki albo chrząszcze, $c? Szybko uciekają, ale jeśli uda ci się je dogonić, przekonasz się, że są prawdziwym przysmakiem!",
        "e555e2caa60241793db8": "Gorzeeki, chcę coś kupić."
      },
      "name": "Gorzeeki Wildeyes",
      "translationMetadata": {
        "fields": {
