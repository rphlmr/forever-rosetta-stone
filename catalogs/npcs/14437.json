    "ptBR": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Você tem alguma aranha ou besouro, $c? Eles escapam tão rápido... se você conseguir ser mais rápido que eles, vai descobrir que eles são uma delícia!",
        "e555e2caa60241793db8": "Gorzeeki, quero comprar algo."
      },
      "name": "Gorzeeki Olholouco",
      "translationMetadata": {
