    "enUS": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Do you have any spiders or beetles, $c?  They scurry fast, but if you're faster then you'll find them quite a treat!",
        "e555e2caa60241793db8": "Gorzeeki, I wish to make a purchase."
      },
      "name": "Gorzeeki Wildeyes",
      "translationMetadata": {
        "fields": {
