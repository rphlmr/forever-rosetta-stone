    "trTR": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Örümceğin ya da böceğin var mı, $c? Hızlı koşarlar ama sen daha hızlıysan ne kadar lezzetli olduklarını görürsün!",
        "e555e2caa60241793db8": "Gorzeeki, bir şey satın almak istiyorum."
      },
      "name": "Gorzeeki Wildeyes",
