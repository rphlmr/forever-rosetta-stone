    "svSE": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Har du några spindlar eller skalbaggar, $c? De springer fort, men om du är snabbare upptäcker du att de är en riktig läckerbit!",
        "e555e2caa60241793db8": "Gorzeeki, jag vill köpa något."
      },
      "name": "Gorzeeki Wildeyes",
      "translationMetadata": {
        "fields": {
