  "locales": {
    "csCZ": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Máš nějaké pavouky nebo brouky, $c? Rychle utíkají, ale když budeš rychlejší, zjistíš, že jsou to skvělé pochoutky!",
        "e555e2caa60241793db8": "Gorzeeki, chci něco koupit."
      },
      "name": "Gorzeeki Wildeyes",
      "translationMetadata": {
        "fields": {
