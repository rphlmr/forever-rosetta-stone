    "daDK": {
      "dialogue": {
        "cb786e2a5afefca33d88": "Har du edderkopper eller biller, $c? De piler hurtigt af sted, men er du hurtigere, vil du opdage, at de er en lækkerbisken!",
        "e555e2caa60241793db8": "Gorzeeki, jeg vil gerne købe noget."
      },
      "name": "Gorzeeki Wildeyes",
      "translationMetadata": {
        "fields": {
