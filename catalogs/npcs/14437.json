    "esES": {
      "dialogue": {
        "cb786e2a5afefca33d88": "¿Tienes arañas o escarabajos, $C? Son muy escurridizos, pero si eres más rápido, ¡descubrirás que son todo un manjar!",
        "e555e2caa60241793db8": "Gorzeeki, quiero hacer una compra."
      },
      "name": "Gorzeeki Ojosalvajes",
      "translationMetadata": {
