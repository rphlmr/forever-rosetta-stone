    "hrHR": {
      "dialogue": {
        "097296a394dd8f5b7678": "Da vidimo... četrnaest plus sedam, dva dalje... oh, da?",
        "3ddadef7293f467b77c1": "Nisi me nimalo razočarao! Sad kad smo to riješili, tvoja poduka može početi!",
        "6d606ca1dde88d0b7bee": "Baš brzo napreduješ! Ne mogu te naučiti ničemu što već ne znaš, ali Springspindle Fizzlegear sigurno može! Možeš ga pronaći u Ironforgeu. Sretno!",
        "d744fc05ae7aa0586048": "Podučite me.",
        "f197648ac874af584d0e": "S vremenom možeš učiti od mene... ali još ne! Najprije razgovaraj sa Sprite Jumpsprocket, ovdje meni zdesna. Vrati mi se kad stekneš malo iskustva!"
      },
      "name": "Lilliam Sparkspindle",
      "translationMetadata": {
