    "ltLT": {
      "dialogue": {
        "097296a394dd8f5b7678": "Pažiūrėkime... keturiolika plius septyni, du mintyje... o, taip?",
        "3ddadef7293f467b77c1": "Tikrai nenuvylei! Dabar, kai tai sutvarkėme, galime pradėti mokslus!",
        "6d606ca1dde88d0b7bee": "Na ir sparčiai žengi pirmyn! Nebegaliu tavęs išmokyti nieko, ko dar nežinotum, bet Springspindle Fizzlegear tikrai gali! Springspindle rasi Ironforge. Sėkmės!",
        "d744fc05ae7aa0586048": "Išmokyk mane.",
        "f197648ac874af584d0e": "Ilgainiui galėsi iš manęs mokytis... bet dar ne dabar! Pirmiausia pasikalbėk su Sprite Jumpsprocket, stovinčia man iš dešinės. Kai šiek tiek pramoksi, sugrįžk pas mane!"
      },
      "name": "Lilliam Sparkspindle",
      "subName": "Patyręs inžinierius",
      "translationMetadata": {
