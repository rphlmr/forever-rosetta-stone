    "daDK": {
      "dialogue": {
        "097296a394dd8f5b7678": "Lad mig se... fjorten plus syv, to i mente... åh, ja?",
        "3ddadef7293f467b77c1": "Du skuffede bestemt ikke! Nu hvor vi har det overstået, kan din undervisning begynde!",
        "6d606ca1dde88d0b7bee": "Hold da op, du gør hurtige fremskridt! Jeg kan ikke lære dig noget, du ikke allerede ved, men det kan Springspindle Fizzlegear helt sikkert! Du finder Springspindle i Ironforge. Held og lykke!",
        "d744fc05ae7aa0586048": "Træn mig.",
        "f197648ac874af584d0e": "Med tiden kan du lære af mig... men ikke endnu! Start med at tale med Sprite Jumpsprocket her til højre for mig. Kom tilbage, når du har fået lidt erfaring!"
      },
      "name": "Lilliam Sparkspindle",
      "translationMetadata": {
        "fields": {
