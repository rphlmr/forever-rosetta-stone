    "esES": {
      "dialogue": {
        "097296a394dd8f5b7678": "Veamos... catorce más siete, me llevo dos... ¿sí?",
        "3ddadef7293f467b77c1": "¡No me has defraudado! ¡Ahora que te has quitado eso de en medio puede comenzar tu instrucción!",
        "6d606ca1dde88d0b7bee": "¡Bien, vas a toda velocidad! No puedo enseñarte nada que ya no sepas, ¡pero Muello Saltarín podrá! Lo encontrarás en Forjaz. ¡Buena suerte!",
        "d744fc05ae7aa0586048": "Entréname.",
        "f197648ac874af584d0e": "Seguro que podrás aprender de mí. ¡Pero todavía no! Deberías empezar hablando con Duendy Ruedadentada, a mi derecha. Cuando ya te hayas estrenado puedes volver a intentarlo conmigo."
      },
      "name": "Lilliam Chispeje",
      "subName": "Experto ingeniero",
