  "locales": {
    "csCZ": {
      "dialogue": {
        "097296a394dd8f5b7678": "Podívejme... čtrnáct plus sedm, dvě přenést... ach, ano?",
        "3ddadef7293f467b77c1": "Rozhodně jsi nezklamal! Když už to máme za sebou, může začít tvá výuka!",
        "6d606ca1dde88d0b7bee": "No, ty se ale ženeš kupředu! Nemohu tě naučit nic, co už neznáš, ale Springspindle Fizzlegear určitě ano! Najdeš ho v Ironforge. Hodně štěstí!",
        "d744fc05ae7aa0586048": "Vycvičte mě.",
        "f197648ac874af584d0e": "Časem se ode mě můžeš učit... ale ještě ne! Začni tím, že si promluvíš se Sprite Jumpsprocket tady po mé pravici. Až získáš první zkušenosti, vrať se za mnou!"
      },
      "name": "Lilliam Sparkspindle",
      "translationMetadata": {
        "fields": {
          "dialogue.097296a394dd8f5b7678": {
