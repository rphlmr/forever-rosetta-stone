    "plPL": {
      "dialogue": {
        "097296a394dd8f5b7678": "Zobaczmy... czternaście plus siedem, dwa w pamięci... och, tak?",
        "3ddadef7293f467b77c1": "Z pewnością nie zawiodłeś! Skoro mamy to za sobą, możemy rozpocząć naukę!",
        "6d606ca1dde88d0b7bee": "Ależ szybko robisz postępy! Nie mogę nauczyć cię niczego, czego już nie wiesz, ale Springspindle Fizzlegear na pewno może! Znajdziesz Springspindle'a w Ironforge. Powodzenia!",
        "d744fc05ae7aa0586048": "Wyszkol mnie.",
        "f197648ac874af584d0e": "Z czasem możesz uczyć się ode mnie... ale jeszcze nie teraz! Zacznij od rozmowy ze Sprite Jumpsprocket, tutaj po mojej prawej. Wróć do mnie, gdy zdobędziesz trochę doświadczenia!"
      },
      "name": "Lilliam Sparkspindle",
      "translationMetadata": {
