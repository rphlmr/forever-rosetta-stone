    "enUS": {
      "dialogue": {
        "9bc8ee4219e1f9c3ade4": "What goods have I earned the right to purchase from the League of Arathor?",
        "e39e5ff3859e34918496": "I am Samuel Hawke, the main supplier for the League of Arathor posted here at Arathi Basin.  As you improve your standing with us, I will make available to you a fine selection of goods that you might find useful.  Should you find yourself in need of item repair, I also provide those services."
      },
      "name": "Samuel Hawke",
      "subName": "League of Arathor Supply Officer",
