  "locales": {
    "csCZ": {
      "dialogue": {
        "9bc8ee4219e1f9c3ade4": "Jaké zboží si smím od Ligy Arathoru koupit?",
        "e39e5ff3859e34918496": "Jsem Samuel Hawke, hlavní zásobovač Ligy Arathoru zde v Arathi Basin. Jakmile si u nás zlepšíš pověst, zpřístupním ti výběr užitečného zboží. Pokud budeš potřebovat opravit výbavu, nabízím i tuto službu."
      },
      "name": "Samuel Hawke",
      "translationMetadata": {
