    "daDK": {
      "dialogue": {
        "9bc8ee4219e1f9c3ade4": "Hvilke varer har jeg gjort mig fortjent til at købe fra League of Arathor?",
        "e39e5ff3859e34918496": "Jeg er Samuel Hawke, hovedleverandør for League of Arathor her i Arathi Basin. Efterhånden som dit omdømme hos os forbedres, vil jeg tilbyde dig et udvalg af nyttige varer. Jeg tilbyder også reparation af udstyr, hvis du får brug for det."
      },
      "name": "Samuel Hawke",
      "translationMetadata": {
        "fields": {
