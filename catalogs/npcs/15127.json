    "hrHR": {
      "dialogue": {
        "9bc8ee4219e1f9c3ade4": "Koju robu imam pravo kupiti od Lige Arathora?",
        "e39e5ff3859e34918496": "Ja sam Samuel Hawke, glavni opskrbljivač Lige Arathora ovdje u Arathi Basinu. Kako bude rastao tvoj ugled među nama, ponudit ću ti izbor korisne robe. Ako trebaš popravak opreme, nudim i tu uslugu."
      },
      "name": "Samuel Hawke",
