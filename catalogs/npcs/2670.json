        }
      }
    },
    "daDK": {
      "dialogue": {
        "37d5bb70f90700c5d35a": "Jeg vil gerne se dine varer.",
        "3955ac2298cfd94302dc": "Velkommen til min butik, $c. Hvad kan brødrene Goodstitch gøre for dig?",
        "4ffda7e323b73ac5132f": "Ah, en af mine yndlingskunder. Du ligner en troldmand med stor magt, $n. Det glæder mig at møde dig. Hvis jeg kan gøre noget for dig, skal du bare spørge.$B$BMin bror og jeg tror, at din slags vil føre os ind i den næste store tidsalder. En med sådan magt... sådan kontrol... det er kun et spørgsmål om tid, før selv Legionen bøjer sig for din vilje.$B$BJeg er blot en smule misundelig."
      },
      "name": "Xizk Goodstitch",
      "translationMetadata": {
        "fields": {
