  "locales": {
    "csCZ": {
      "dialogue": {
        "37d5bb70f90700c5d35a": "Rád bych si prohlédl vaše zboží.",
        "3955ac2298cfd94302dc": "Vítej v mém obchodě, $c. Co pro tebe mohou bratři Goodstitchové udělat?",
        "4ffda7e323b73ac5132f": "Ach, jeden z mých oblíbených zákazníků. Vypadáš jako mocný černokněžník, $n. Těší mě. Pokud pro tebe mohu cokoli udělat, jen řekni.$B$BS bratrem věříme, že právě tvůj druh nás povede do dalšího velkého věku. Někdo s takovou mocí... takovým ovládáním... je jen otázkou času, kdy se i samotná Legie podvolí tvé vůli.$B$BTrochu ti závidím."
      },
      "name": "Xizk Goodstitch",
      "translationMetadata": {
        "fields": {
          "dialogue.37d5bb70f90700c5d35a": {
            "origin": "ai",
