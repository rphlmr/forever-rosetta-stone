    "hrHR": {
      "dialogue": {
        "14fed29884f7efc678e4": "Tkanje Shen’doreija skladno oponaša tečne, bezbrižne struje vjetra. Premda su nas duhovi napustili i ne znam kada ću ih ponovno vidjeti kako plešu... veliku utjehu pronalazim u svojoj umjetnosti, makar samo kao razonodu.\n\nMogu i tebe naučiti obrađivati tkaninu, ako želiš?"
      },
      "name": "Taleen Shimmerthread",
      "translationMetadata": {
        "fields": {
          "dialogue.14fed29884f7efc678e4": {
