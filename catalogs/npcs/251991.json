  "locales": {
    "csCZ": {
      "dialogue": {
        "14fed29884f7efc678e4": "Tkalcovské umění Shen’dorei je harmonickou nápodobou plynulých, bezstarostných proudů větru. Duchové nás sice opustili a já nevím, kdy je znovu uvidím tančit... ale v mém umění nacházím velkou útěchu, byť jen jako rozptýlení.\n\nMohu tě také naučit pracovat s látkou, pokud chceš?"
      },
      "name": "Taleen Shimmerthread",
      "translationMetadata": {
        "fields": {
          "dialogue.14fed29884f7efc678e4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
            "sourceLocale": "enUS"
          },
