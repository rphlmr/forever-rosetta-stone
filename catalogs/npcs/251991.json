            "sourceLocale": "enUS",
            "sourceRevision": "3a621efafce6aef99b0f106d22aa71ca980ee552"
          }
        }
      }
    },
    "daDK": {
      "dialogue": {
        "14fed29884f7efc678e4": "Shen’doreiernes tekstilhåndværk er en harmonisk efterligning af vindenes flydende, ubekymrede strømme. Selv om ånderne har forladt os, og jeg ikke ved, hvornår jeg igen får dem at se danse... finder jeg stor trøst i min kunst, om ikke andet som en afledning.\n\nJeg kan også lære dig at arbejde med stof, hvis du vil lære det?"
      },
      "name": "Taleen Shimmerthread",
      "translationMetadata": {
        "fields": {
          "dialogue.14fed29884f7efc678e4": {
            "origin": "ai",
            "source": "ForeverRosettaStoneAI",
