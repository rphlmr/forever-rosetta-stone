    "enUS": {
      "dialogue": {
        "72ea1043e5a8196f1e6f": "Why is it that small creatures such as goblins are always fascinated with larger creatures?",
        "bce4f15a54e807bb5c08": "This kodo sure looks nothing like the beast I originally lured!  I wonder if the kombobulator can be used on me."
      },
      "name": "Ancient Kodo",
