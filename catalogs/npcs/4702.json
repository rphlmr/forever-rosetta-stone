    "hrHR": {
      "dialogue": {
        "72ea1043e5a8196f1e6f": "Zašto su mala stvorenja poput goblina uvijek fascinirana većim stvorenjima?",
        "bce4f15a54e807bb5c08": "Ovaj kodo doista ne nalikuje prvotno namamljenoj zvijeri! Pitam se može li se kombobulator upotrijebiti i na meni."
