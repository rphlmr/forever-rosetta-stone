    "csCZ": {
      "dialogue": {
        "72ea1043e5a8196f1e6f": "Proč jsou malí tvorové jako goblini vždycky fascinováni většími tvory?",
        "bce4f15a54e807bb5c08": "Tohle kodo rozhodně nevypadá jako původně přilákané zvíře! Zajímalo by mě, jestli lze kombobulátor použít i na mě."
      },
      "name": "Prastarý kodo",
      "translationMetadata": {
