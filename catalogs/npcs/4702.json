    "daDK": {
      "dialogue": {
        "72ea1043e5a8196f1e6f": "Hvorfor er små væsner som gobliner altid fascinerede af større væsner?",
        "bce4f15a54e807bb5c08": "Denne kodo ligner bestemt ikke det dyr, jeg oprindeligt lokkede til! Gad vide, om kombobulatoren også kan bruges på mig."
      },
      "name": "Oldgammel kodo",
      "translationMetadata": {
