  "locales": {
    "csCZ": {
      "dialogue": {
        "64f6c7a6965ca555b57f": "Duchové mi řekli, že přijdeš a z nějakého důvodu mě vyhledáš, ale možná ani ty sám ten důvod neznáš. Víš tedy, proč jsi tady?"
      },
      "name": "Brumn Winterhoof",
      "translationMetadata": {
