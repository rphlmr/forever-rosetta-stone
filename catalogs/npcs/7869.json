    "enUS": {
      "dialogue": {
        "64f6c7a6965ca555b57f": "The spirits told me you would come, that you would seek me for some reason, but that even you may not know that reason. So, do you know why you are here?"
      },
      "name": "Brumn Winterhoof",
      "subName": "Master Elemental Leatherworker",
