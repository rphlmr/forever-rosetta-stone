    "daDK": {
      "dialogue": {
        "64f6c7a6965ca555b57f": "Ånderne fortalte mig, at du ville komme og opsøge mig af en eller anden grund, men at du måske ikke selv kender grunden. Ved du så, hvorfor du er her?"
      },
      "name": "Brumn Winterhoof",
      "translationMetadata": {
        "fields": {
          "dialogue.64f6c7a6965ca555b57f": {
