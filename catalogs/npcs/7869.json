    "plPL": {
      "dialogue": {
        "64f6c7a6965ca555b57f": "Duchy powiedziały mi, że przybędziesz i z jakiegoś powodu mnie odszukasz, ale być może nawet ty nie znasz tego powodu. Czy wiesz więc, dlaczego tu jesteś?"
      },
      "name": "Brumn Winterhoof",
