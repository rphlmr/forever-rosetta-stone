    "hrHR": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... pokazuješ nešto talenta, to priznajem. Dobro onda, gdje smo stali?",
        "267abb297ada1a2e598b": "Nemam vremena čuvati djecu! Razgovaraj s mojim pomoćnikom Uthrarom!",
        "71c02d615ddab856cefe": "Podučite me.",
        "8bde9e516354e4fdeea1": "Baš si pametnjaković, zar ne? Znaš više od mene, to ti mogu reći! Nemoj se uzoholiti, ali ako želiš nastaviti učiti, porazgovaraj s Georgiom Bolerom u Stormwindu. Kažu da zna svoj krojački zanat!",
        "a7995bc82cc4cb384543": "Ah, ova darnasska tkanina je najfinija!"
      },
      "name": "Jormund Stonebrow",
