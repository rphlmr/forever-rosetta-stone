    "svSE": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... du visar lite talang, det ska jag ge dig. Nå, var var vi?",
        "267abb297ada1a2e598b": "Jag har inte tid att vara barnvakt! Gå och tala med min assistent Uthrar!",
        "71c02d615ddab856cefe": "Träna mig.",
        "8bde9e516354e4fdeea1": "Jaså, du är en riktig förståsigpåare? Du vet mer än jag, det kan jag säga! Bli inte högfärdig, men om du vill fortsätta lära dig, prata med Georgio Bolero i Stormwind. De säger att han kan sitt skrädderi!",
        "a7995bc82cc4cb384543": "Ah, detta darnassiska tyg är det finaste!"
      },
      "name": "Jormund Stonebrow",
      "translationMetadata": {
