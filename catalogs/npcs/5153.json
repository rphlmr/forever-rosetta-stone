  "locales": {
    "csCZ": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... máš trochu talentu, to uznávám. Tak tedy, kde jsme skončili?",
        "267abb297ada1a2e598b": "Nemám čas hlídat děti! Promluv si s mým pomocníkem Uthrarem!",
        "71c02d615ddab856cefe": "Vycvičte mě.",
        "8bde9e516354e4fdeea1": "No ne, ty jsi ale chytrák! Víš víc než já, to ti řeknu! Jen ať ti to nestoupne do hlavy, a jestli se chceš učit dál, promluv si s Georgiem Bolerem ve Stormwindu. Prý se v krejčovství vyzná!",
        "a7995bc82cc4cb384543": "Ach, tato darnasská látka je nejjemnější!"
      },
      "name": "Jormund Stonebrow",
      "translationMetadata": {
        "fields": {
