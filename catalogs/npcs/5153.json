    "plPL": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... wykazujesz pewien talent, muszę przyznać. No dobrze, na czym stanęliśmy?",
        "267abb297ada1a2e598b": "Nie mam czasu niańczyć! Idź porozmawiać z moim pomocnikiem, Uthrarem!",
        "71c02d615ddab856cefe": "Wyszkol mnie.",
        "8bde9e516354e4fdeea1": "No proszę, jaki mądrala! Wiesz więcej ode mnie, to ci powiem! Niech ci się od tego nie przewróci w głowie, ale jeśli chcesz się dalej uczyć, porozmawiaj z Georgiem Bolero w Stormwind. Podobno zna się na krawiectwie!",
        "a7995bc82cc4cb384543": "Ach, ten darnasski materiał jest najwspanialszy!"
      },
      "name": "Jormund Stonebrow",
      "translationMetadata": {
