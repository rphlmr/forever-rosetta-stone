    "daDK": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... du viser lidt talent, det skal du have. Nå, hvor var vi?",
        "267abb297ada1a2e598b": "Jeg har ikke tid til at passe børn! Tal med min assistent, Uthrar!",
        "71c02d615ddab856cefe": "Træn mig.",
        "8bde9e516354e4fdeea1": "Nå, er du ikke en klog en? Du ved mere end mig, det kan jeg fortælle dig! Lad det ikke stige dig til hovedet, men vil du lære mere, så tal med Georgio Bolero i Stormwind. De siger, han kan sit skrædderhåndværk!",
        "a7995bc82cc4cb384543": "Ah, dette darnassiske stof er det fineste!"
      },
      "name": "Jormund Stonebrow",
      "translationMetadata": {
        "fields": {
