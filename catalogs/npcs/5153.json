    "enUS": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... you show a little promise, I'll give you that. Okay then, where were we?",
        "267abb297ada1a2e598b": "I don't have time to babysit! Go talk to me assistant, Uthrar! ",
        "71c02d615ddab856cefe": "Train me.",
        "8bde9e516354e4fdeea1": "Well, aren't you the smarty-pants? Ye know more than I do, I can tell ye that! Don't go getting' a big head, but if ye want to keep learnin', have a chat with Georgio Bolero in Stormwind. They say he knows his tailorin'!",
        "a7995bc82cc4cb384543": "Ah, this Darnassian fabric is the finest!"
      },
      "name": "Jormund Stonebrow",
      "subName": "Expert Tailor",
      "translationMetadata": {
