    "esES": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Mmm... parece que prometes, te concedo eso. ¿Y bien? ¿Dónde estábamos?",
        "267abb297ada1a2e598b": "¡No tengo tiempo para hacer de canguro! Vete a hablar con mi ayudante, Uthrar.",
        "71c02d615ddab856cefe": "Entréname.",
        "8bde9e516354e4fdeea1": "¡Uy! ¿No eres tú quien se las sabe todas? ¡Sabes más que yo, y te lo digo yo! No vayas por ahí en plan presumido... si quieres seguir aprendiendo, habla con Georgio Bolero en Ventormenta. ¡Dicen que es buen sastre, sí señor!",
        "a7995bc82cc4cb384543": "¡Ah, esta tela de Darnassus es la mejor!"
      },
      "name": "Jormund Petrocejas",
      "subName": "Experto sastre",
