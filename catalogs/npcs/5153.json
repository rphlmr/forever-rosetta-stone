    "ltLT": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... turi šiokį tokį talentą, pripažinsiu. Na gerai, kur mes baigėme?",
        "267abb297ada1a2e598b": "Neturiu laiko auklėmis dirbti! Eik pasikalbėti su mano padėjėju Uthrar! ",
        "71c02d615ddab856cefe": "Išmokyk mane.",
        "8bde9e516354e4fdeea1": "Na ir gudruolis! Žinai daugiau už mane, galiu tau pasakyti! Tik neužriesk nosies, bet jei nori mokytis toliau, pasikalbėk su Georgio Bolero Stormwind mieste. Sako, jis siuvimą išmano!",
        "a7995bc82cc4cb384543": "Ak, šis Darnassus audinys pats geriausias!"
      },
      "name": "Jormund Stonebrow",
      "subName": "Siuvimo ekspertas",
      "translationMetadata": {
