    "trTR": {
      "dialogue": {
        "0788419bf91cf6eafe88": "Hmm... biraz yetenek gösteriyorsun, hakkını yemeyeyim. Peki, nerede kalmıştık?",
        "267abb297ada1a2e598b": "Çocuk bakacak vaktim yok! Git yardımcım Uthrar’la konuş!",
        "71c02d615ddab856cefe": "Beni eğit.",
        "8bde9e516354e4fdeea1": "Vay canına, ne kadar da bilgiliymişsin! Benden fazla biliyorsun, bunu söyleyebilirim! Kendini beğenme ama öğrenmeye devam etmek istiyorsan Stormwind’deki Georgio Bolero’yla konuş. Terzilikten anladığını söylüyorlar!",
        "a7995bc82cc4cb384543": "Ah, bu Darnassus kumaşı en iyisi!"
      },
      "name": "Jormund Stonebrow",
      "translationMetadata": {
