    "enUS": {
      "dialogue": {
        "58ef058b7e1943c44900": "Train me.",
        "fd9a615caf858da5cf65": "The craft of the night elves ranges beyond the woods and its denizens.  We know much of the earth below, and of the metals within it.",
        "fff5f5f833e3a4042736": "I want to browse your goods."
      },
      "name": "Mathiel",
