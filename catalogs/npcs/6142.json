    "ptBR": {
      "dialogue": {
        "58ef058b7e1943c44900": "Treine-me.",
        "fd9a615caf858da5cf65": "O ofício dos elfos noturnos vai além das florestas e de seus habitantes. Sabemos muito sobre a terra sob nossos pés e os metais que ela guarda.",
        "fff5f5f833e3a4042736": "Quero ver suas mercadorias."
