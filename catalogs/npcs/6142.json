    "frFR": {
      "dialogue": {
        "58ef058b7e1943c44900": "Entraînez-moi.",
        "fd9a615caf858da5cf65": "L'artisanat des elfes de la nuit s'étend au-delà des bois et de leurs habitants. Nous connaissons une grande partie de la terre et des métaux qu’elle contient.",
        "fff5f5f833e3a4042736": "Je voudrais regarder vos articles."
      },
      "name": "Mathiel",
