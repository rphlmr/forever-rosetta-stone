    "csCZ": {
      "dialogue": {
        "58ef058b7e1943c44900": "Vycvičte mě.",
        "fd9a615caf858da5cf65": "Řemeslo nočních elfů sahá dál než k lesům a jejich obyvatelům. Víme mnoho o zemi pod námi a o kovech v ní.",
        "fff5f5f833e3a4042736": "Rád bych si prohlédl vaše zboží."
      },
      "name": "Mathiel",
      "translationMetadata": {
