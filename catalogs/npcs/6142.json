    "daDK": {
      "dialogue": {
        "58ef058b7e1943c44900": "Træn mig.",
        "fd9a615caf858da5cf65": "Natteelvernes håndværk rækker ud over skovene og deres beboere. Vi ved meget om jorden under os og metallerne i den.",
        "fff5f5f833e3a4042736": "Jeg vil gerne se dine varer."
      },
      "name": "Mathiel",
      "translationMetadata": {
