    "itIT": {
      "dialogue": {
        "58ef058b7e1943c44900": "Addestrami.",
        "fd9a615caf858da5cf65": "L'arte degli elfi della notte si spinge oltre i boschi e i loro abitanti. Sappiamo molto della terra sotto di noi, e dei metalli che racchiude.",
        "fff5f5f833e3a4042736": "Vorrei vedere la tua merce."
      },
      "name": "Mathiel",
