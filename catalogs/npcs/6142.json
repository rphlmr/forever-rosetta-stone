    "deDE": {
      "dialogue": {
        "58ef058b7e1943c44900": "Bildet mich aus.",
        "fd9a615caf858da5cf65": "Das Handwerk der Nachtelfen reicht über den Wald und seine Bewohner hinaus. Wir wissen viel über die Erde darunter und die Metalle darin.",
        "fff5f5f833e3a4042736": "Ich möchte Eure Waren ansehen."
      },
      "name": "Mathiel",
      "translationMetadata": {
