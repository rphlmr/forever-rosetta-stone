    "hrHR": {
      "dialogue": {
        "58ef058b7e1943c44900": "Podučite me.",
        "fd9a615caf858da5cf65": "Umijeće noćnih vilenjaka seže dalje od šuma i njihovih stanovnika. Mnogo znamo o zemlji pod nama i metalima u njoj.",
        "fff5f5f833e3a4042736": "Želim pogledati vašu robu."
      },
      "name": "Mathiel",
