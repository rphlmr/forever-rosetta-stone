    "frFR": {
      "dialogue": {
        "2165f78e980733feee09": "Entraînez-moi.",
        "69406d5284ad6cbe8db9": "Je n’ai plus rien à vous apprendre. J’ai entendu dire qu’à Baie-du-Butin, le Vieil Heming avait des exemplaires de « Vous et la perche ». Ça vous aidera sûrement à progresser.",
        "acd142210de45f194982": "Pour progresser, vous avez besoin de trouver Nat Pagle, qui vit dans le marécage d'Âprefange.",
        "b942368161c177a3346d": "Je peux vous apprendre à pêcher."
      },
      "name": "Kah Mistrunner",
      "subName": "Maître des pêcheurs",
