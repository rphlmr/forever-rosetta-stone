    "deDE": {
      "dialogue": {
        "2165f78e980733feee09": "Bildet mich aus.",
        "69406d5284ad6cbe8db9": "Ich kann Euch nichts mehr lehren. Ich hörte aber, dass Old Man Heming in Booty Bay ein Exemplar von \"Der Barsch und du\" vorrätig haben soll. Dieses Buch wird Eure Fertigkeiten sicherlich verbessern.",
        "acd142210de45f194982": "Ihr müsst Nat Pagle in den Marschen von Dustwallow finden, um Euch überhaupt verbessern zu können.",
        "b942368161c177a3346d": "Ihr könnt bei mir Eure Angelfertigkeit verbessern."
      },
      "name": "Kah Mistrunner",
      "subName": "Angellehrer",
      "translationMetadata": {
