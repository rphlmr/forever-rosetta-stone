    "plPL": {
      "dialogue": {
        "2165f78e980733feee09": "Wyszkol mnie.",
        "69406d5284ad6cbe8db9": "Twoje umiejętności przewyższają moje, ale słyszałem, że stary Heming w Booty Bay ma egzemplarze \"The Bass and You\". Ta książka z pewnością pomoże ci się rozwinąć.",
        "acd142210de45f194982": "Musisz znaleźć Nata Pagle'a w Dustwallow Marsh, jeśli chcesz dalej doskonalić swoje umiejętności.",
        "b942368161c177a3346d": "Mogę nauczyć cię łowić ryby."
      },
      "name": "Kah Mistrunner",
      "translationMetadata": {
