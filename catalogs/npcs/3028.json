    "esES": {
      "dialogue": {
        "2165f78e980733feee09": "Entréname.",
        "69406d5284ad6cbe8db9": "Tu habilidad supera a la mía, pero he oído que el Viejo Heming en la Bahía del Botín, tiene ejemplares de \"El Bajo y tú\". Seguro que te ayuda a mejorar tu habilidad.",
        "acd142210de45f194982": "Tendrás que encontrar a Nat Pagle en el Marjal Revolcafango para mejorar tus habilidades.",
        "b942368161c177a3346d": "Puedo enseñarte a pescar."
      },
      "name": "Kah Correbruma",
      "subName": "Instructor de pesca",
