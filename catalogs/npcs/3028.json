    "ltLT": {
      "dialogue": {
        "2165f78e980733feee09": "Išmokyk mane.",
        "69406d5284ad6cbe8db9": "Tavo įgūdžiai pranoksta manuosius, bet girdėjau, kad senis Heming iš Booty Bay turi knygos „Ešerys ir tu“ egzempliorių. Ji tikrai padės tau patobulinti savo įgūdžius.",
        "acd142210de45f194982": "Jei nori tobulėti toliau, turėsi susirasti Nat Pagle iš Dustwallow Marsh.",
        "b942368161c177a3346d": "Galiu tave išmokyti žvejybos."
      },
      "name": "Kah Mistrunner",
      "subName": "Žvejybos mokytojas",
