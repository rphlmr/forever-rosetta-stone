    "enUS": {
      "dialogue": {
        "2165f78e980733feee09": "Train me.",
        "69406d5284ad6cbe8db9": "Your skill exceeds mine, though  I've heard that Old Man Heming in Booty Bay has copies of \"The Bass and You\".  That is sure to help you increase your skill.",
        "acd142210de45f194982": "You will need to find Nat Pagle in Dustwallow Marsh to get any better than you are currently.",
        "b942368161c177a3346d": "I can teach you fishing skills."
      },
      "name": "Kah Mistrunner",
      "subName": "Fishing Trainer",
