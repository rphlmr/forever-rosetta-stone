    "hrHR": {
      "dialogue": {
        "2165f78e980733feee09": "Podučite me.",
        "69406d5284ad6cbe8db9": "Tvoja vještina nadmašuje moju, ali čuo sam da stari Heming u Booty Bayu ima primjerke knjige \"The Bass and You\". Ona će ti sigurno pomoći da se usavršiš.",
        "acd142210de45f194982": "Moraš pronaći Nata Paglea u Dustwallow Marshu želiš li se dalje usavršavati.",
        "b942368161c177a3346d": "Mogu te naučiti pecati."
      },
      "name": "Kah Mistrunner",
