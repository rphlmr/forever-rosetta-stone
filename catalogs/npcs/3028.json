    "daDK": {
      "dialogue": {
        "2165f78e980733feee09": "Træn mig.",
        "69406d5284ad6cbe8db9": "Dine evner overgår mine, men jeg har hørt, at gamle Heming i Booty Bay har eksemplarer af \"The Bass and You\". Den vil helt sikkert hjælpe dig med at blive bedre.",
        "acd142210de45f194982": "Du må finde Nat Pagle i Dustwallow Marsh, hvis du vil blive bedre, end du er nu.",
        "b942368161c177a3346d": "Jeg kan lære dig at fiske."
      },
      "name": "Kah Mistrunner",
      "translationMetadata": {
