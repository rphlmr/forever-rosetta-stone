    "trTR": {
      "dialogue": {
        "2165f78e980733feee09": "Beni eğit.",
        "69406d5284ad6cbe8db9": "Becerin benimkini aşıyor, ama Booty Bay'deki İhtiyar Heming'in \"The Bass and You\" kitabının kopyalarına sahip olduğunu duydum. Becerini artırmana mutlaka yardımcı olur.",
        "acd142210de45f194982": "Daha da ilerlemek için Dustwallow Marsh'ta Nat Pagle'ı bulmalısın.",
        "b942368161c177a3346d": "Sana balık tutmayı öğretebilirim."
      },
      "name": "Kah Mistrunner",
