  "locales": {
    "csCZ": {
      "dialogue": {
        "2165f78e980733feee09": "Vycvičte mě.",
        "69406d5284ad6cbe8db9": "Tvé dovednosti překonávají mé, ale slyšel jsem, že stařík Heming v Booty Bay má výtisky knihy \"The Bass and You\". Ta ti jistě pomůže se zlepšit.",
        "acd142210de45f194982": "Chceš-li se dále zlepšit, musíš najít Nata Pagla v Dustwallow Marsh.",
        "b942368161c177a3346d": "Mohu tě naučit rybařit."
      },
      "name": "Kah Mistrunner",
      "translationMetadata": {
