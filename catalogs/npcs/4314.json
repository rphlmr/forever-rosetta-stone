  "locales": {
    "csCZ": {
      "dialogue": {
        "2a0e1b852adb76423251": "Co pro tebe mohu udělat, $c?",
        "310f4678e9a2b808c091": "Zůstanu tady, dokud nechytím osmašedesátiliberního kanice! Ty se ale chceš někam proletět, mám pravdu?",
        "335bff7c5755733f8794": "Vyplašil jsi ryby! Co chceš?",
        "a2dc3f6c148e627b04b5": "Copak nevidíš, že tu rybařím!"
      },
      "name": "Gorkas",
