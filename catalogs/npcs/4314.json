    "frFR": {
      "dialogue": {
        "2a0e1b852adb76423251": "Que puis-je faire pour vous, $c ?",
        "310f4678e9a2b808c091": "Je resterai ici jusqu'à ce que je prenne un mérou de 31 kilos ! Mais vous, vous voulez sûrement voler quelque part, n'est-ce pas ?",
        "335bff7c5755733f8794": "Vous avez effrayé les poissons ! Qu'est-ce que vous voulez ?",
        "a2dc3f6c148e627b04b5": "Vous ne voyez pas que je pêche ici ?"
      },
      "name": "Gorkas",
      "subName": "Maître des Cavaliers célestes",
