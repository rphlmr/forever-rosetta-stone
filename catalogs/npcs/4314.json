    "ptBR": {
      "dialogue": {
        "2a0e1b852adb76423251": "Que posso fazer por você, $c?",
        "310f4678e9a2b808c091": "Eu vou ficar aqui até pescar uma Garoupa de 34 Quilos! Você, por outro lado, quer voar para algum lugar, não é mesmo?",
        "335bff7c5755733f8794": "Você afugentou os peixes! Que você quer?",
        "a2dc3f6c148e627b04b5": "Não está vendo que estou pescando?!"
