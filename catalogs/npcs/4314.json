    "itIT": {
      "dialogue": {
        "2a0e1b852adb76423251": "Cosa posso fare per te, $C?",
        "310f4678e9a2b808c091": "Io resto qui finché non pesco una Cernia da 68 Libbre! Tu invece vuoi volartene da qualche parte, dico bene?",
        "335bff7c5755733f8794": "Hai fatto scappare i pesci! Che cosa vuoi?",
        "a2dc3f6c148e627b04b5": "Non lo vedi che sto pescando!"
      },
      "name": "Gorkas",
