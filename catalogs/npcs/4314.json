    "esES": {
      "dialogue": {
        "2a0e1b852adb76423251": "¿Qué puedo hacer por ti, $c?",
        "310f4678e9a2b808c091": "¡No me muevo de aquí hasta que pesque un mero de 130 kilos! Pero creo que tú quieres largarte a otra parte, ¿tengo razón?",
        "335bff7c5755733f8794": "¡Has espantado a los peces! ¿Qué quieres?",
        "a2dc3f6c148e627b04b5": "¿No ves que estoy pescando aquí?"
      },
      "name": "Gorkas",
      "subName": "Maestro de jinete del viento",
