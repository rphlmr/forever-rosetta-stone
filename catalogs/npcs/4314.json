    "enUS": {
      "dialogue": {
        "2a0e1b852adb76423251": "What can I do for you $c?",
        "310f4678e9a2b808c091": "I'm going to stay here until I catch a 68 Pound Grouper!  You on the other hand want to fly off somewhere, am I right?",
        "335bff7c5755733f8794": "You scared the fish away!  What do you want?",
        "a2dc3f6c148e627b04b5": "Can't you see I'm fishing here!"
      },
      "name": "Gorkas",
      "subName": "Wind Rider Master",
