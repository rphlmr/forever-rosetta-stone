    "hrHR": {
      "dialogue": {
        "2a0e1b852adb76423251": "Što mogu učiniti za tebe, $c?",
        "310f4678e9a2b808c091": "Ostat ću ovdje dok ne ulovim kirnju od 68 funti! Ti, s druge strane, želiš nekamo odletjeti, zar ne?",
        "335bff7c5755733f8794": "Otjerao si ribe! Što želiš?",
        "a2dc3f6c148e627b04b5": "Zar ne vidiš da ovdje pecam!"
      },
      "name": "Gorkas",
