    "deDE": {
      "dialogue": {
        "2a0e1b852adb76423251": "Was kann ich für Euch tun, $C?",
        "310f4678e9a2b808c091": "Ich werde so lange hier bleiben, bis ich einen 68-pfündigen Zackenbarsch gefangen habe! Ihr habt scheinbar etwas anderes im Sinn, stimmt's?",
        "335bff7c5755733f8794": "Ihr habt den Fisch vertrieben! Was wollt Ihr?",
        "a2dc3f6c148e627b04b5": "Könnt Ihr nicht sehen, dass ich hier angle!"
      },
      "name": "Gorkas",
      "subName": "Windreitermeister",
