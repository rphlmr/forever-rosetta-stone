    "daDK": {
      "dialogue": {
        "2a0e1b852adb76423251": "Hvad kan jeg gøre for dig, $c?",
        "310f4678e9a2b808c091": "Jeg bliver her, indtil jeg fanger en grouper på 68 pund! Du vil derimod flyve et sted hen, har jeg ret?",
        "335bff7c5755733f8794": "Du skræmte fiskene væk! Hvad vil du?",
        "a2dc3f6c148e627b04b5": "Kan du ikke se, at jeg fisker her!"
      },
      "name": "Gorkas",
      "translationMetadata": {
