  "locales": {
    "csCZ": {
      "dialogue": {
        "35d0c84d42dd38820c73": "Co tě přivádí do věže?",
        "45161f38697029b1b3f5": "Téměř jsi dosáhl vrcholu svého výcviku. Abys dosáhl nejvyšší možné úrovně v očarovávání, musíš vyhledat ještě jednu učitelku. Jmenuje se Annora a najdeš ji v Uldamanu.",
        "f11dac34555b18cd9546": "Tvé schopnosti jsou už skutečně mimořádné. Teď pokračujme ve výcviku...",
        "f6fe1fc87198fa8dcc22": "Vycvičte mě.",
        "f79f225eb766b1d70b68": "Jsi dychtivý, a to je dobře. Ještě ale nejsi připraven učit se u někoho, jako jsem já."
      },
      "name": "Kitta Firewind",
      "translationMetadata": {
