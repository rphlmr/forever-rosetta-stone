    "enUS": {
      "dialogue": {
        "35d0c84d42dd38820c73": "What brings you to the Tower?",
        "45161f38697029b1b3f5": "You have nearly reached the pinnacle of your training. To become the greatest enchanter you can possibly be, you have one more instructor to seek out. Her name is Annora, and you may find her in Uldaman.",
        "f11dac34555b18cd9546": "Your skills are truly becoming extraordinary. Now, let us continue your training...",
        "f6fe1fc87198fa8dcc22": "Train me.",
        "f79f225eb766b1d70b68": "You are eager, that is good. However, you are not yet ready to train with the likes of me. "
      },
      "name": "Kitta Firewind",
      "subName": "Artisan Enchanter",
      "translationMetadata": {
