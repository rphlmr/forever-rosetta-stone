    "daDK": {
      "dialogue": {
        "35d0c84d42dd38820c73": "Hvad bringer dig til tårnet?",
        "45161f38697029b1b3f5": "Du har næsten nået toppen af din træning. For at blive den dygtigste fortryller, du kan være, skal du opsøge endnu en læremester. Hun hedder Annora, og du kan finde hende i Uldaman.",
        "f11dac34555b18cd9546": "Dine færdigheder er virkelig ved at blive enestående. Lad os nu fortsætte din træning...",
        "f6fe1fc87198fa8dcc22": "Træn mig.",
        "f79f225eb766b1d70b68": "Du er ivrig, og det er godt. Men du er endnu ikke klar til at træne hos en som mig."
      },
      "name": "Kitta Firewind",
      "translationMetadata": {
        "fields": {
