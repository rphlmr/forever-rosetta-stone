    "hrHR": {
      "dialogue": {
        "35d0c84d42dd38820c73": "Što te dovodi u toranj?",
        "45161f38697029b1b3f5": "Gotovo si dosegnuo vrhunac svoje obuke. Da postaneš najbolji mogući začaravatelj, moraš potražiti još jednu učiteljicu. Zove se Annora i možeš je pronaći u Uldamanu.",
        "f11dac34555b18cd9546": "Tvoje vještine doista postaju izvanredne. Sada nastavimo s obukom...",
        "f6fe1fc87198fa8dcc22": "Podučite me.",
        "f79f225eb766b1d70b68": "Željan si učenja, što je dobro. No još nisi spreman učiti od nekoga poput mene."
      },
      "name": "Kitta Firewind",
